# Entity: subscriber

main: kit: entity: subscriber: {

  alias: field: {}

  fields: {
    component_ids: {
      h: "Component Ids"
      n: "component_ids"
      r: false
      sh: "A list of component ids for which the subscriber should recieve updates for."
      t: "`$ARRAY`"
    }
    components: {
      h: "Components"
      n: "components"
      r: false
      sh: "The components for which the subscriber has elected to receive updates."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      t: "`$STRING`"
    }
    display_phone_number: {
      h: "Display Phone Number"
      n: "display_phone_number"
      r: false
      sh: "A formatted version of the phone_number and phone_country pair, nicely formatted for display."
      t: "`$STRING`"
    }
    email: {
      h: "Email"
      n: "email"
      r: false
      sh: "The email address to use to contact the subscriber."
      t: "`$STRING`"
    }
    endpoint: {
      h: "Endpoint"
      n: "endpoint"
      r: false
      sh: "The URL where a webhook subscriber elects to receive updates."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Subscriber Identifier"
      t: "`$STRING`"
    }
    mode: {
      h: "Mode"
      n: "mode"
      r: false
      sh: "The communication mode of the subscriber."
      t: "`$STRING`"
    }
    obfuscated_channel_name: {
      h: "Obfuscated Channel Name"
      n: "obfuscated_channel_name"
      r: false
      sh: "Obfuscated slack channel name"
      t: "`$STRING`"
    }
    page_access_user_id: {
      h: "Page Access User Id"
      n: "page_access_user_id"
      r: false
      sh: "The Page Access user this subscriber belongs to (only for audience-specific pages)."
      t: "`$STRING`"
    }
    phone_country: {
      h: "Phone Country"
      n: "phone_country"
      r: false
      sh: "The two-character country code representing the country of which the phone_number is a part."
      t: "`$STRING`"
    }
    phone_number: {
      h: "Phone Number"
      n: "phone_number"
      r: false
      sh: "The phone number used to contact an SMS subscriber"
      t: "`$STRING`"
    }
    purge_at: {
      fo: "date-time"
      h: "Purge At"
      n: "purge_at"
      r: false
      sh: "The timestamp when a quarantined subscriber will be purged (unsubscribed)."
      t: "`$STRING`"
    }
    quarantined_at: {
      fo: "date-time"
      h: "Quarantined At"
      n: "quarantined_at"
      r: false
      sh: "The timestamp when the subscriber was quarantined due to an issue reaching them."
      t: "`$STRING`"
    }
    skip_confirmation_notification: {
      h: "Skip Confirmation Notification"
      n: "skip_confirmation_notification"
      r: false
      sh: "If this is true, do not notify the user with changes to their subscription."
      t: "`$BOOLEAN`"
    }
    subscriber: {
      h: "Subscriber"
      n: "subscriber"
      r: false
      t: "`$OBJECT`"
    }
    workspace_name: {
      h: "Workspace Name"
      n: "workspace_name"
      r: false
      sh: "The workspace name of the slack subscriber."
      t: "`$STRING`"
    }
  }

