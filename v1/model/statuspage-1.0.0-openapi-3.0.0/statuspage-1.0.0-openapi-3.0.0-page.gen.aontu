# Entity: page

main: kit: entity: page: {

  alias: field: {}

  fields: [
    {
      name: "activity_score"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "allow_email_subscribers"
      req: false
      short: "Can your users choose to receive notifications via email"
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_incident_subscribers"
      req: false
      short: "Can your users subscribe to notifications for a single incident"
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_page_subscribers"
      req: false
      short: "Can your users subscribe to all notifications on the page"
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_rss_atom_feeds"
      req: false
      short: "Can your users choose to access incident feeds via RSS/Atom (not functional on Audience-Specific pages)"
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_sms_subscribers"
      req: false
      short: "Can your users choose to receive notifications via SMS"
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_webhook_subscribers"
      req: false
      short: "Can your users choose to receive notifications via Webhooks"
      type: "`$BOOLEAN`"
    }
    {
      name: "branding"
      req: false
      short: "The main template your statuspage will use"
      type: "`$STRING`"
    }
    {
      name: "city"
      req: false
      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      type: "`$STRING`"
    }
    {
      name: "created_at"
      req: false
      short: "Timestamp the record was created"
      type: "`$STRING`"
    }
    {
      name: "css_blues"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_body_background_color"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_border_color"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_font_color"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_graph_color"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_greens"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_light_font_color"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_link_color"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_no_data"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_oranges"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_reds"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "css_yellows"
      req: false
      short: "CSS Color"
      type: "`$STRING`"
    }
    {
      name: "domain"
      req: false
      short: "CNAME alias for your status page"
      type: "`$STRING`"
    }
    {
      name: "email_logo"
      req: false
      type: "`$STRING`"
    }
    {
      name: "favicon_logo"
      req: false
      type: "`$STRING`"
    }
    {
      name: "headline"
      req: false
      type: "`$STRING`"
    }
    {
      name: "hero_cover"
      req: false
      type: "`$STRING`"
    }
    {
      name: "hidden_from_search"
      req: false
      short: "Should your page hide itself from search engines"
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: false
      short: "Page identifier"
      type: "`$STRING`"
    }
    {
      name: "ip_restrictions"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of your page to be displayed"
      type: "`$STRING`"
    }
    {
      name: "notifications_email_footer"
      req: false
      short: "Allows you to customize the footer appearing on your notification emails."
      type: "`$STRING`"
    }
    {
      name: "notifications_from_email"
      req: false
      short: "Allows you to customize the email address your page notifications come from"
      type: "`$STRING`"
    }
    {
      name: "page"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "page_description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "state"
      req: false
      type: "`$STRING`"
    }
    {
      name: "subdomain"
      req: false
      short: "Subdomain at which to access your status page"
      type: "`$STRING`"
    }
    {
      name: "support_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "time_zone"
      req: false
      short: "Timezone configured for your page"
      type: "`$STRING`"
    }
    {
      name: "transactional_logo"
      req: false
      type: "`$STRING`"
    }
    {
      name: "twitter_logo"
      req: false
      type: "`$STRING`"
    }
    {
      name: "twitter_username"
      req: false
      type: "`$STRING`"
    }
    {
      name: "updated_at"
      req: false
      short: "Timestamp the record was last updated"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "Website of your page."
      type: "`$STRING`"
    }
    {
      name: "viewers_must_be_team_members"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "page"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/pages"
          segments: [
            {
              lit: "pages"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "page_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/pages/{page_id}"
          rename: {
            param: {
              page_id: "id"
            }
          }
          segments: [
            {
              lit: "pages"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    patch: {
      name: "patch"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "page_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/pages/{page_id}"
          rename: {
            param: {
              page_id: "id"
            }
          }
          segments: [
            {
              lit: "pages"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: {
              page: "`reqdata`"
            }
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "page_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PUT"
          orig: "/pages/{page_id}"
          rename: {
            param: {
              page_id: "id"
            }
          }
          segments: [
            {
              lit: "pages"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: {
              page: "`reqdata`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}