# Entity: project_entity

main: kit: entity: project_entity: {

  alias: field: {}

  fields: {
    bitbucket_server_project: {
      h: "Bitbucket Server Project"
      n: "bitbucket_server_project"
      r: true
      sh: "BitBucket Server Project Key"
      t: "`$STRING`"
    }
    bitbucket_server_repo: {
      h: "Bitbucket Server Repo"
      n: "bitbucket_server_repo"
      r: true
      sh: "BitBucket Server Repository Name"
      t: "`$STRING`"
    }
    bitbucket_server_url: {
      h: "Bitbucket Server Url"
      n: "bitbucket_server_url"
      r: true
      sh: "Bitbucket Server URL"
      t: "`$STRING`"
    }
    bitbucket_server_username: {
      h: "Bitbucket Server Username"
      n: "bitbucket_server_username"
      r: true
      sh: "BitBucket Server Username"
      t: "`$STRING`"
    }
    github_hostname: {
      h: "Github Hostname"
      n: "github_hostname"
      r: false
      sh: "Custom GitHub enterprise hostname."
      t: "`$STRING`"
    }
    new_name: {
      h: "New Name"
      n: "new_name"
      r: false
      sh: "New repo name"
      t: "`$STRING`"
    }
    new_namespace: {
      h: "New Namespace"
      n: "new_namespace"
      r: false
      sh: "Namespace to import repo into"
      t: "`$STRING`"
    }
    optional_stages: {
      h: "Optional Stages"
      n: "optional_stages"
      r: false
      sh: "Optional stages of import to be performed"
      t: "`$OBJECT`"
    }
    pagination_limit: {
      fo: "int32"
      h: "Pagination Limit"
      n: "pagination_limit"
      r: false
      sh: "Pagination limit"
      t: "`$INTEGER`"
    }
    personal_access_token: {
      h: "Personal Access Token"
      n: "personal_access_token"
      r: true
      sh: "BitBucket Server personal access token/password"
      t: "`$STRING`"
    }
    repo_id: {
      fo: "int32"
      h: "Repo Id"
      n: "repo_id"
      r: true
      sh: "GitHub repository ID"
      t: "`$INTEGER`"
    }
    target_namespace: {
      h: "Target Namespace"
      n: "target_namespace"
      r: true
      sh: "Namespace or group to import repository into"
      t: "`$STRING`"
    }
    timeout_strategy: {
      h: "Timeout Strategy"
      n: "timeout_strategy"
      r: false
      sh: "Strategy for behavior on timeouts"
      t: "`$STRING`"
    }
  }

  name: "project_entity"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "bitbucket_server_project"
            "bitbucket_server_repo"
            "bitbucket_server_url"
            "bitbucket_server_username"
            "new_name"
            "new_namespace"
            "personal_access_token"
            "timeout_strategy"
          ]
          co: {
            id: "POST /api/v4/import/bitbucket_server"
            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/api/v4/import/bitbucket_server"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "import"
            }
            {
              lit: "bitbucket_server"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "github_hostname"
            "new_name"
            "optional_stages"
            "pagination_limit"
            "personal_access_token"
            "repo_id"
            "target_namespace"
            "timeout_strategy"
          ]
          co: {
            id: "POST /api/v4/import/github"
            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/api/v4/import/github"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "import"
            }
            {
              lit: "github"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}