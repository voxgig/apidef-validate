# Entity: debian

main: kit: entity: debian: {

  alias: field: {}

  fields: {
    component: {
      h: "Component"
      n: "component"
      r: true
      sh: "The Debian Component"
      t: "`$STRING`"
    }
    distribution: {
      h: "Distribution"
      n: "distribution"
      r: false
      sh: "The Debian Codename or Suite"
      t: "`$STRING`"
    }
    file: {
      h: "File"
      n: "file"
      r: true
      sh: "The package file to be published (generated by Multipart middleware)"
      t: "Any"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "debian"
  op: {
    update: {
      name: "update"
      points: [
        {
          bf: [
            "component"
            "distribution"
          ]
          co: {
            id: "PUT /api/v4/projects/{id}/packages/debian/{file_name}/authorize"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                ex: "example_1.0.0~alpha2_amd64.deb"
                k: "param"
                n: "file_name"
                or: "file_name"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "project_id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PUT"
          o: "/api/v4/projects/{id}/packages/debian/{file_name}/authorize"
          q: {
            "$action": "authorize"
            exist: [
              "file_name"
              "project_id"
            ]
          }
          r: {
            param: {
              id: "project_id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "packages"
            }
            {
              lit: "debian"
            }
            {
              var: "file_name"
            }
            {
              lit: "authorize"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "component"
            "distribution"
            "file"
          ]
          co: {
            id: "PUT /api/v4/projects/{id}/packages/debian/{file_name}"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                ex: "example_1.0.0~alpha2_amd64.deb"
                k: "param"
                n: "id"
                or: "file_name"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "project_id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PUT"
          o: "/api/v4/projects/{id}/packages/debian/{file_name}"
          q: {
            exist: [
              "id"
              "project_id"
            ]
          }
          r: {
            param: {
              file_name: "id"
              id: "project_id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "packages"
            }
            {
              lit: "debian"
            }
