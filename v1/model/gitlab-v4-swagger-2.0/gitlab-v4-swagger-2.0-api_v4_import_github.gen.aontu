# Entity: api_v4_import_github

main: kit: entity: api_v4_import_github: {

  alias: field: {}

  fields: {
    github_hostname: {
      h: "Github Hostname"
      n: "github_hostname"
      r: false
      sh: "Custom GitHub enterprise hostname."
      t: "`$STRING`"
    }
    new_name: {
      h: "New Name"
      n: "new_name"
      r: false
      sh: "New repo name"
      t: "`$STRING`"
    }
    optional_stages: {
      h: "Optional Stages"
      n: "optional_stages"
      r: false
      sh: "Optional stages of import to be performed"
      t: "`$OBJECT`"
    }
    pagination_limit: {
      fo: "int32"
      h: "Pagination Limit"
      n: "pagination_limit"
      r: false
      sh: "Pagination limit"
      t: "`$INTEGER`"
    }
    personal_access_token: {
      h: "Personal Access Token"
      n: "personal_access_token"
      r: true
      sh: "GitHub personal access token"
      t: "`$STRING`"
    }
    repo_id: {
      fo: "int32"
      h: "Repo Id"
      n: "repo_id"
      r: true
      sh: "GitHub repository ID"
      t: "`$INTEGER`"
    }
    target_namespace: {
      h: "Target Namespace"
      n: "target_namespace"
      r: true
      sh: "Namespace or group to import repository into"
      t: "`$STRING`"
    }
    timeout_strategy: {
      h: "Timeout Strategy"
      n: "timeout_strategy"
      r: false
      sh: "Strategy for behavior on timeouts"
      t: "`$STRING`"
    }
  }

  name: "api_v4_import_github"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "github_hostname"
            "new_name"
            "optional_stages"
            "pagination_limit"
            "personal_access_token"
            "repo_id"
            "target_namespace"
            "timeout_strategy"
          ]
          co: {
            id: "POST /api/v4/import/github"
            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/api/v4/import/github"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "import"
            }
            {
              lit: "github"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "project_id"
          ]
          co: {
            id: "POST /api/v4/import/github/cancel"
            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/api/v4/import/github/cancel"
          q: {
            "$action": "cancel"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "import"
            }
            {
              lit: "github"
            }
            {
              lit: "cancel"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}