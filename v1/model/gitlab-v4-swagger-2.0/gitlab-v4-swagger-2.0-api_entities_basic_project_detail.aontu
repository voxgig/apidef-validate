          contract: {
            id: "GET /api/v4/users/{user_id}/projects"
            json: "{\"operationId\":\"getApiV4UsersUserIdProjects\",\"parameters\":[{\"description\":\"The ID or username of the user\",\"in\":\"path\",\"name\":\"user_id\",\"required\":true,\"type\":\"string\"},{\"default\":\"created_at\",\"description\":\"Return projects ordered by field. storage_size, repository_size, wiki_size, packages_size are only available to admins. Similarity is available when searching and is limited to projects the user has access to.\",\"enum\":[\"id\",\"name\",\"path\",\"created_at\",\"updated_at\",\"last_activity_at\",\"similarity\",\"star_count\",\"storage_size\",\"repository_size\",\"wiki_size\",\"packages_size\"],\"in\":\"query\",\"name\":\"order_by\",\"required\":false,\"type\":\"string\"},{\"default\":\"desc\",\"description\":\"Return projects sorted in ascending and descending order\",\"enum\":[\"asc\",\"desc\"],\"in\":\"query\",\"name\":\"sort\",\"required\":false,\"type\":\"string\"},{\"description\":\"Limit by archived status\",\"in\":\"query\",\"name\":\"archived\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Limit by visibility\",\"enum\":[\"private\",\"internal\",\"public\"],\"in\":\"query\",\"name\":\"visibility\",\"required\":false,\"type\":\"string\"},{\"description\":\"Return list of projects matching the search criteria\",\"in\":\"query\",\"name\":\"search\",\"required\":false,\"type\":\"string\"},{\"description\":\"Include ancestor namespaces when matching search criteria\",\"in\":\"query\",\"name\":\"search_namespaces\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Limit by owned by authenticated user\",\"in\":\"query\",\"name\":\"owned\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Limit by starred status\",\"in\":\"query\",\"name\":\"starred\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Limit by imported by authenticated user\",\"in\":\"query\",\"name\":\"imported\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Limit by projects that the current user is a member of\",\"in\":\"query\",\"name\":\"membership\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Limit by enabled issues feature\",\"in\":\"query\",\"name\":\"with_issues_enabled\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Limit by enabled merge requests feature\",\"in\":\"query\",\"name\":\"with_merge_requests_enabled\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Limit to repositories which use the given programming language\",\"in\":\"query\",\"name\":\"with_programming_language\",\"required\":false,\"type\":\"string\"},{\"description\":\"Limit by minimum access level of authenticated user\",\"enum\":[10,15,20,30,40,50],\"format\":\"int32\",\"in\":\"query\",\"name\":\"min_access_level\",\"required\":false,\"type\":\"integer\"},{\"description\":\"Limit results to projects with IDs greater than the specified ID\",\"format\":\"int32\",\"in\":\"query\",\"name\":\"id_after\",\"required\":false,\"type\":\"integer\"},{\"description\":\"Limit results to projects with IDs less than the specified ID\",\"format\":\"int32\",\"in\":\"query\",\"name\":\"id_before\",\"required\":false,\"type\":\"integer\"},{\"description\":\"Limit results to projects with last_activity after specified time. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ\",\"format\":\"date-time\",\"in\":\"query\",\"name\":\"last_activity_after\",\"required\":false,\"type\":\"string\"},{\"description\":\"Limit results to projects with last_activity before specified time. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ\",\"format\":\"date-time\",\"in\":\"query\",\"name\":\"last_activity_before\",\"required\":false,\"type\":\"string\"},{\"description\":\"Which storage shard the repository is on. Available only to admins\",\"in\":\"query\",\"name\":\"repository_storage\",\"required\":false,\"type\":\"string\"},{\"description\":\"Comma-separated list of topics. Limit results to projects having all topics\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"topic\",\"required\":false,\"type\":\"array\"},{\"description\":\"Limit results to projects with the assigned topic given by the topic ID\",\"format\":\"int32\",\"in\":\"query\",\"name\":\"topic_id\",\"required\":false,\"type\":\"integer\"},{\"description\":\"Return projects updated before the specified datetime. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ\",\"format\":\"date-time\",\"in\":\"query\",\"name\":\"updated_before\",\"required\":false,\"type\":\"string\"},{\"description\":\"Return projects updated after the specified datetime. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ\",\"format\":\"date-time\",\"in\":\"query\",\"name\":\"updated_after\",\"required\":false,\"type\":\"string\"},{\"description\":\"Include projects in pending delete state. Can only be set by admins\",\"in\":\"query\",\"name\":\"include_pending_delete\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Date when the project was marked for deletion\",\"format\":\"date\",\"in\":\"query\",\"name\":\"marked_for_deletion_on\",\"required\":false,\"type\":\"string\"},{\"description\":\"Limit by projects that are not archived and not marked for deletion\",\"in\":\"query\",\"name\":\"active\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Limit by projects where wiki checksum is failed\",\"in\":\"query\",\"name\":\"wiki_checksum_failed\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Limit by projects where repository checksum is failed\",\"in\":\"query\",\"name\":\"repository_checksum_failed\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Include hidden projects. Can only be set by admins\",\"in\":\"query\",\"name\":\"include_hidden\",\"required\":false,\"type\":\"boolean\"},{\"default\":1,\"description\":\"Current page number\",\"example\":1,\"format\":\"int32\",\"in\":\"query\",\"name\":\"page\",\"required\":false,\"type\":\"integer\"},{\"default\":20,\"description\":\"Number of items per page\",\"example\":20,\"format\":\"int32\",\"in\":\"query\",\"name\":\"per_page\",\"required\":false,\"type\":\"integer\"},{\"default\":false,\"description\":\"Return only the ID, URL, name, and path of each project\",\"in\":\"query\",\"name\":\"simple\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Include project statistics\",\"in\":\"query\",\"name\":\"statistics\",\"required\":false,\"type\":\"boolean\"},{\"default\":false,\"description\":\"Include custom attributes in the response\",\"in\":\"query\",\"name\":\"with_custom_attributes\",\"required\":false,\"type\":\"boolean\"}],\"produces\":[\"application/json\"],\"protocol\":\"http\",\"responses\":{\"200\":{\"description\":\"Get a user projects\",\"schema\":{\"items\":{\"description\":\"API_Entities_BasicProjectDetails model\",\"properties\":{\"avatar_url\":{\"example\":\"http://example.com/uploads/project/avatar/3/uploads/avatar.png\",\"type\":\"string\"},\"created_at\":{\"example\":\"2020-05-07T04:27:17.016Z\",\"format\":\"date-time\",\"type\":\"string\"},\"custom_attributes\":{\"description\":\"API_Entities_CustomAttribute model\",\"properties\":{\"key\":{\"example\":\"foo\",\"type\":\"string\"},\"value\":{\"example\":\"bar\",\"type\":\"string\"}},\"type\":\"object\"},\"default_branch\":{\"example\":\"main\",\"type\":\"string\"},\"description\":{\"example\":\"desc\",\"type\":\"string\"},\"forks_count\":{\"example\":1,\"format\":\"int32\",\"type\":\"integer\"},\"http_url_to_repo\":{\"example\":\"https://gitlab.example.com/gitlab/gitlab.git\",\"type\":\"string\"},\"id\":{\"example\":1,\"format\":\"int32\",\"type\":\"integer\"},\"last_activity_at\":{\"example\":\"2013-09-30T13:46:02Z\",\"format\":\"date-time\",\"type\":\"string\"},\"license\":{\"properties\":{\"html_url\":{\"example\":\"http://choosealicense.com/licenses/gpl-3.0\",\"type\":\"string\"},\"key\":{\"example\":\"gpl-3.0\",\"type\":\"st