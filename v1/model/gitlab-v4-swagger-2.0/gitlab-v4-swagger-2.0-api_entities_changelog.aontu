    }
    trailer: {
      h: "Trailer"
      n: "trailer"
      r: false
      sh: "The Git trailer to use for determining if commits are to be included in the changelog"
      t: "`$STRING`"
    }
    version: {
      h: "Version"
      n: "version"
      r: true
      sh: "The version of the release, using the semantic versioning format"
      t: "`$STRING`"
    }
  }

