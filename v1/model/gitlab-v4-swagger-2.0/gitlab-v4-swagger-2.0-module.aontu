              }
            ]
            query: [
              {
                explode: true
                k: "query"
                n: "terraform_get"
                or: "terraform-get"
                r: false
                style: "form"
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v4/projects/{id}/packages/terraform/modules/{module_name}/{module_system}"
          q: {
