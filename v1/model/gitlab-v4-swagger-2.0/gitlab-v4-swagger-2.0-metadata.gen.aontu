# Entity: metadata

main: kit: entity: metadata: {

  alias: field: {}

  fields: [
    {
      name: "enabled"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "externalK8sProxyUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "externalUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "version"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "metadata"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/v4/metadata"
          parts: [
            "api"
            "v4"
            "metadata"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.kas`"
          }
        }
        {
          method: "GET"
          orig: "/api/v4/version"
          parts: [
            "api"
            "v4"
            "version"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.kas`"
          }
        }
      ]
    }
  }



}