# Entity: api_v4_import_bitbucket

main: kit: entity: api_v4_import_bitbucket: {

  alias: field: {}

  fields: {
    bitbucket_app_password: {
      h: "Bitbucket App Password"
      n: "bitbucket_app_password"
      r: true
      sh: "BitBucket app password"
      t: "`$STRING`"
    }
    bitbucket_username: {
      h: "Bitbucket Username"
      n: "bitbucket_username"
      r: true
      sh: "BitBucket username"
      t: "`$STRING`"
    }
    new_name: {
      h: "New Name"
      n: "new_name"
      r: false
      sh: "New repository name"
      t: "`$STRING`"
    }
    repo_path: {
      h: "Repo Path"
      n: "repo_path"
      r: true
      sh: "Repository path"
      t: "`$STRING`"
    }
    target_namespace: {
      h: "Target Namespace"
      n: "target_namespace"
      r: true
      sh: "Target namespace"
      t: "`$STRING`"
    }
  }

  name: "api_v4_import_bitbucket"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "bitbucket_app_password"
            "bitbucket_username"
            "new_name"
            "repo_path"
            "target_namespace"
          ]
          co: {
            id: "POST /api/v4/import/bitbucket"
            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/api/v4/import/bitbucket"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "import"
            }
            {
              lit: "bitbucket"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}