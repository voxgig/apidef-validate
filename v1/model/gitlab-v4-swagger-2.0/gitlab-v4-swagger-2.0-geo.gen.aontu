            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/api/v4/geo/proxy_git_ssh/receive_pack"
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "geo"
            }
            {
              lit: "proxy_git_ssh"
            }
            {
              lit: "receive_pack"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /api/v4/geo/proxy_git_ssh/upload_pack"
            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/api/v4/geo/proxy_git_ssh/upload_pack"
          s: [
            {
