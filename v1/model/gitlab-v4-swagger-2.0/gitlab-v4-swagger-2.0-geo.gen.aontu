            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/v4/geo/retrieve/{replicable_name}/{replicable_id}"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "replicable_id"
                or: "replicable_id"
                r: true
                t: "`$INTEGER`"
              }
              {
                ex: "package_file"
                k: "param"
                n: "replicable_name"
                or: "replicable_name"
