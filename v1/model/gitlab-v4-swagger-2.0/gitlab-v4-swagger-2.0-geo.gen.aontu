# Entity: geo

main: kit: entity: geo: {

  alias: field: {}

  fields: {
    data: {
      h: "Data"
      n: "data"
      r: true
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    output: {
      h: "Output"
      n: "output"
      r: true
      sh: "Output from git-receive-pack"
      t: "`$STRING`"
    }
    secret_token: {
      h: "Secret Token"
      n: "secret_token"
      r: true
      sh: "Secret token to authenticate by gitlab shell"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
    parts: [
      "replicable_name"
      "replicable_id"
    ]
    sep: "/"
  }

  name: "geo"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /api/v4/geo/node_proxy/{id}/graphql"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "node_proxy_id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/api/v4/geo/node_proxy/{id}/graphql"
          q: {
            exist: [
              "node_proxy_id"
            ]
          }
          r: {
            param: {
              id: "node_proxy_id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "geo"
            }
            {
              lit: "node_proxy"
            }
            {
              var: "node_proxy_id"
            }
            {
              lit: "graphql"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /api/v4/geo/proxy_git_ssh/info_refs_receive_pack"
            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/api/v4/geo/proxy_git_ssh/info_refs_receive_pack"
