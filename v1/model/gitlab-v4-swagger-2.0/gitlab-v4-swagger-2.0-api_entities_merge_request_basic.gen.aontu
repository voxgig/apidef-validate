            {
              lit: "related_merge_requests"
            }
          ]
          select: {
            exist: [
              "issue_id"
              "project_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "group"
      ]
      [
        "project"
      ]
      [
        "project"
        "deployment"
      ]
      [
        "project"
        "issue"
      ]
      [
