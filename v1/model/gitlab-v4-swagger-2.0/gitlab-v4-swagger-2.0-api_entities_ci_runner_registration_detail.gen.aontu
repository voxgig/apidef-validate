# Entity: api_entities_ci_runner_registration_detail

main: kit: entity: api_entities_ci_runner_registration_detail: {

  alias: field: {}

  fields: {
    access_level: {
      h: "Access Level"
      n: "access_level"
      r: false
      sh: "The access level of the runner"
      t: "`$STRING`"
    }
    active: {
      h: "Active"
      n: "active"
      r: false
      sh: "Deprecated: Use `paused` instead."
      t: "`$BOOLEAN`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Description of the runner"
      t: "`$STRING`"
    }
    group_id: {
      fo: "int32"
      h: "Group Id"
      n: "group_id"
      r: true
      sh: "The ID of the group that the runner is created in"
      t: "`$INTEGER`"
    }
    info: {
      h: "Info"
      n: "info"
      r: false
      sh: "Runner's metadata"
      t: "`$OBJECT`"
    }
    locked: {
      h: "Locked"
      n: "locked"
      r: false
      sh: "Specifies if the runner should be locked for the current project"
      t: "`$BOOLEAN`"
    }
    maintainer_note: {
      h: "Maintainer Note"
      n: "maintainer_note"
      r: false
      sh: "Deprecated: see `maintenance_note`"
      t: "`$STRING`"
    }
    maintenance_note: {
      h: "Maintenance Note"
      n: "maintenance_note"
      r: false
      sh: "Free-form maintenance notes for the runner (1024 characters)"
      t: "`$STRING`"
    }
    maximum_timeout: {
      fo: "int32"
      h: "Maximum Timeout"
      n: "maximum_timeout"
      r: false
      sh: "Maximum timeout that limits the amount of time (in seconds) that runners can run jobs"
      t: "`$INTEGER`"
    }
    paused: {
      h: "Paused"
      n: "paused"
      r: false
      sh: "Specifies if the runner should ignore new jobs"
      t: "`$BOOLEAN`"
    }
    project_id: {
      fo: "int32"
      h: "Project Id"
      n: "project_id"
      r: true
      sh: "The ID of the project that the runner is created in"
      t: "`$INTEGER`"
    }
    run_untagged: {
      h: "Run Untagged"
      n: "run_untagged"
      r: false
      sh: "Specifies if the runner should handle untagged jobs"
      t: "`$BOOLEAN`"
    }
    runner_type: {
      h: "Runner Type"
      n: "runner_type"
      r: true
      sh: "Specifies the scope of the runner"
      t: "`$STRING`"
    }
    tag_list: {
      h: "Tag List"
      n: "tag_list"
      r: false
      sh: "A list of runner tags"
      t: "`$ARRAY`"
    }
    token: {
      h: "Token"
      n: "token"
      r: true
      sh: "Registration token"
      t: "`$STRING`"
    }
  }

  name: "api_entities_ci_runner_registration_detail"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /api/v4/runners"
            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/api/v4/runners"
          rs: {
