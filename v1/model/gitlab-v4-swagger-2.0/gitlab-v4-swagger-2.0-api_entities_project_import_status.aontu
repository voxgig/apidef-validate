          contract: {
            id: "POST /api/v4/projects/import"
            json: "{\"consumes\":[\"multipart/form-data\"],\"operationId\":\"postApiV4ProjectsImport\",\"parameters\":[{\"description\":\"The new project path and name\",\"in\":\"formData\",\"name\":\"path\",\"required\":true,\"type\":\"string\"},{\"description\":\"The project export file to be imported\",\"in\":\"formData\",\"name\":\"file\",\"required\":true,\"type\":\"file\"},{\"description\":\"The name of the project to be imported. Defaults to the path of the project if not provided.\",\"in\":\"formData\",\"name\":\"name\",\"required\":false,\"type\":\"string\"},{\"description\":\"The ID or name of the namespace that the project will be imported into. Defaults to the current user's namespace.\",\"in\":\"formData\",\"name\":\"namespace\",\"required\":false,\"type\":\"string\"},{\"default\":false,\"description\":\"If there is a project in the same namespace and with the same name overwrite it\",\"in\":\"formData\",\"name\":\"overwrite\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"The description of the project\",\"in\":\"formData\",\"name\":\"override_params[description]\",\"required\":false,\"type\":\"string\"},{\"description\":\"The Git strategy. Defaults to `fetch`\",\"enum\":[\"fetch\",\"clone\"],\"in\":\"formData\",\"name\":\"override_params[build_git_strategy]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Build timeout\",\"format\":\"int32\",\"in\":\"formData\",\"name\":\"override_params[build_timeout]\",\"required\":false,\"type\":\"integer\"},{\"description\":\"Auto-cancel pending pipelines\",\"enum\":[\"disabled\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[auto_cancel_pending_pipelines]\",\"required\":false,\"type\":\"string\"},{\"description\":\"The path to CI config file. Defaults to `.gitlab-ci.yml`\",\"in\":\"formData\",\"name\":\"override_params[ci_config_path]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Disable or enable the service desk\",\"in\":\"formData\",\"name\":\"override_params[service_desk_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if the issue tracker is enabled\",\"in\":\"formData\",\"name\":\"override_params[issues_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if merge requests are enabled\",\"in\":\"formData\",\"name\":\"override_params[merge_requests_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if the wiki is enabled\",\"in\":\"formData\",\"name\":\"override_params[wiki_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if jobs are enabled\",\"in\":\"formData\",\"name\":\"override_params[jobs_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if snippets are enabled\",\"in\":\"formData\",\"name\":\"override_params[snippets_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Issues access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[issues_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Repository access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[repository_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Merge requests access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[merge_requests_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Forks access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[forking_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Wiki access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[wiki_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Builds access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[builds_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Snippets access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[snippets_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Controls visibility of the package registry. One of `disabled`, `private`, `enabled` or `public`. `private` will make the package registry accessible only to project members (reporter role and above). `enabled` will make the package registry accessible to everyone who has access to the project. `public` will make the package registry accessible to everyone. `disabled` will disable the package registry\",\"enum\":[\"disabled\",\"private\",\"enabled\",\"public\"],\"in\":\"formData\",\"name\":\"override_params[package_registry_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Pages access level. One of `disabled`, `private`, `enabled` or `public`\",\"enum\":[\"disabled\",\"private\",\"enabled\",\"public\"],\"in\":\"formData\",\"name\":\"override_params[pages_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Analytics access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[analytics_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Controls visibility of the container registry. One of `disabled`, `private` or `enabled`. `private` will make the container registry accessible only to project members (reporter role and above). `enabled` will make the container registry accessible to everyone who has access to the project. `disabled` will disable the container registry\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[container_registry_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Security and compliance access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[security_and_compliance_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Releases access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[releases_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Environments access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[environments_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Feature flags access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[feature_flags_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Infrastructure access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[infrastructure_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Monitor access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[monitor_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Model experiments access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[model_experiments_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Model registry access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[model_registry_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Deprecated: Use emails_enabled instead.\",\"in\":\"formData\",\"name\":\"override_params[emails_disabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Enable email notifications\",\"in\":\"formData\",\"name\":\"override_params[emails_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Show default award emojis\",\"in\":\"formData\",\"name\":\"override_params[show_default_award_emojis]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Include the code diff preview in merge request notification emails\",\"in\":\"formData\",\"name\":\"override_params[show_diff_preview_in_email]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Warn about potentially unwanted characters\",\"in\":\"formData\",\"name\":\"override_params[warn_about_potentially_unwanted_characters]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Enforce auth check on uploads\",\"in\":\"formData\",\"name\":\"override_params[enforce_auth_checks_on_uploads]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if shared runners are enabled for that project\",\"in\":\"formData\",\"name\":\"override_params[shared_runners_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if group runners are enabled for that project\",\"in\":\"formData\",\"name\":\"override_params[group_runners_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"The process mode of the resource group\",\"enum\":[\"unordered\",\"oldest_first\",\"newest_first\",\"newest_ready_first\"],\"in\":\"formData\",\"name\":\"override_params[resource_group_default_process_mode]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Automatically resolve merge request diff threads on lines changed with a push\",\"in\":\"formData\",\"name\":\"override_params[resolve_outdated_diff_discussions]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Remove the source branch by default after merge\",\"in\":\"formData\",\"name\":\"override_params[remove_source_branch_after_merge]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Deprecated: Use :package_registry_access_level instead. Enable project packages feature\",\"in\":\"formData\",\"name\":\"override_params[packages_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Deprecated: Use :container_registry_access_level instead. Flag indication if the container registry is enabled for that project\",\"in\":\"formData\",\"name\":\"override_params[container_registry_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Container expiration policy cadence for recurring job\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][cadence]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Container expiration policy number of images to keep\",\"format\":\"int32\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][keep_n]\",\"required\":false,\"type\":\"integer\"},{\"description\":\"Container expiration policy remove images older than value\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][older_than]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Container expiration policy regex for image removal\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][name_regex]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Container expiration policy regex for image retention\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][name_regex_keep]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Flag indication if container expiration policy is enabled\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if Git LFS is enabled for that project\",\"in\":\"formData\",\"name\":\"override_params[lfs_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"The visibility of the project.\",\"enum\":[\"private\",\"internal\",\"public\"],\"in\":\"formData\",\"name\":\"override_params[visibility]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Deprecated: Use public_jobs instead.\",\"in\":\"formData\",\"name\":\"override_params[public_builds]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Perform public builds\",\"in\":\"formData\",\"name\":\"override_params[public_jobs]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Allow users to request member access\",\"in\":\"formData\",\"name\":\"override_params[request_access_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Only allow to merge if builds succeed\",\"in\":\"formData\",\"name\":\"override_params[only_allow_merge_if_pipeline_succeeds]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Allow to merge if pipeline is skipped\",\"in\":\"formData\",\"name\":\"override_params[allow_merge_on_skipped_pipeline]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Only allow to merge if all threads are resolved\",\"in\":\"formData\",\"name\":\"override_params[only_allow_merge_if_all_discussions_are_resolved]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Deprecated: Use :topics instead\",\"in\":\"formData\",\"items\":{\"type\":\"string\"},\"name\":\"override_params[tag_list]\",\"required\":false,\"type\":\"array\"},{\"description\":\"The list of topics for a project\",\"in\":\"formData\",\"items\":{\"type\":\"string\"},\"name\":\"override_params[topics]\",\"required\":false,\"type\":\"array\"},{\"description\":\"Avatar image for project\",\"in\":\"formData\",\"name\":\"override_params[avatar]\",\"required\":false,\"type\":\"file\"},{\"description\":\"Show link to create/view merge request when pushing from the command line\",\"in\":\"formData\",\"name\":\"override_params[printing_merge_request_link_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"The merge method used when merging merge requests\",\"enum\":[\"ff\",\"rebase_merge\",\"merge\"],\"in\":\"formData\",\"name\":\"override_params[merge_method]\",\"required\":false,\"type\":\"string\"},{\"description\":\"The commit message used to apply merge request suggestions\",\"in\":\"formData\",\"name\":\"override_params[suggestion_commit_message]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Template used to create merge commit message\",\"in\":\"formData\",\"name\":\"override_params[merge_commit_template]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Template used to create squash commit message\",\"in\":\"formData\",\"name\":\"override_params[squash_commit_template]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Template used to create a branch from an issue\",\"in\":\"formData\",\"name\":\"override_params[issue_branch_template]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Flag indication if Auto DevOps is enabled\",\"in\":\"formData\",\"name\":\"override_params[auto_devops_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Auto Deploy strategy\",\"enum\":[\"continuous\",\"manual\",\"timed_incremental\"],\"in\":\"formData\",\"name\":\"override_params[auto_devops_deploy_strategy]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Flag indication if referenced issues auto-closing is enabled\",\"in\":\"formData\",\"name\":\"override_params[autoclose_referenced_issues]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Which storage shard the repository is on. Available only to admins\",\"in\":\"formData\",\"name\":\"override_params[repository_storage]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Squash default for project. One of `never`, `always`, `default_on`, or `default_off`.\",\"enum\":[\"never\",\"always\",\"default_on\",\"default_off\"],\"in\":\"formData\",\"name\":\"override_params[squash_option]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Merge requests of this forked project targets itself by default\",\"in\":\"formData\",\"name\":\"override_params[mr_default_target_self]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"The regex the Merge Request must adhere to\",\"in\":\"formData\",\"name\":\"override_params[merge_request_title_regex]\",\"required\":false,\"type\":\"string\"},{\"description\":\"The description for the regex the Merge Request must adhere to\",\"in\":\"formData\",\"name\":\"override_params[merge_request_title_regex_description]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Blocks merge requests from merging unless all status checks have passed\",\"in\":\"formData\",\"name\":\"override_params[only_allow_merge_if_all_status_checks_passed]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"How many approvers should approve merge request by default\",\"format\":\"int32\",\"in\":\"formData\",\"name\":\"override_params[approvals_before_merge]\",\"required\":false,\"type\":\"integer\"},{\"description\":\"[Deprecated] Enables pull mirroring in a project\",\"in\":\"formData\",\"name\":\"override_params[mirror]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"[Deprecated] Pull mirroring triggers builds\",\"in\":\"formData\",\"name\":\"override_params[mirror_trigger_builds]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"The classification label for the project\",\"in\":\"formData\",\"name\":\"override_params[external_authorization_classification_label]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Requirements feature access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[requirements_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Require an associated issue from Jira\",\"in\":\"formData\",\"name\":\"override_params[prevent_merge_without_jira_issue]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Enable automatic reviews by GitLab Duo on merge requests\",\"in\":\"formData\",\"name\":\"override_params[auto_duo_code_review_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Enable GitLab Duo remote flows for this project\",\"in\":\"formData\",\"name\":\"override_params[duo_remote_flows_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Grant read-only access to security policy configurations for enforcement in linked CI/CD projects\",\"in\":\"formData\",\"name\":\"override_params[spp_repository_pipeline_access]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Path to locally stored body (generated by Workhorse)\",\"in\":\"formData\",\"name\":\"file.path\",\"required\":false,\"type\":\"string\"},{\"description\":\"Real filename as send in Content-Disposition (generated by Workhorse)\",\"in\":\"formData\",\"name\":\"file.name\",\"required\":false,\"type\":\"string\"},{\"description\":\"Real content type as send in Content-Type (generated by Workhorse)\",\"in\":\"formData\",\"name\":\"file.type\",\"required\":false,\"type\":\"string\"},{\"description\":\"Real size of file (generated by Workhorse)\",\"format\":\"int32\",\"in\":\"formData\",\"name\":\"file.size\",\"required\":false,\"type\":\"integer\"},{\"description\":\"MD5 checksum of the file (generated by Workhorse)\",\"in\":\"formData\",\"name\":\"file.md5\",\"required\":false,\"type\":\"string\"},{\"description\":\"SHA1 checksum of the file (generated by Workhorse)\",\"in\":\"formData\",\"name\":\"file.sha1\",\"required\":false,\"type\":\"string\"},{\"description\":\"SHA256 checksum of the file (generated by Workhorse)\",\"in\":\"formData\",\"name\":\"file.sha256\",\"required\":false,\"type\":\"string\"},{\"description\":\"Etag of the file (generated by Workhorse)\",\"in\":\"formData\",\"name\":\"file.etag\",\"required\":false,\"type\":\"string\"},{\"description\":\"Remote_id of the file (generated by Workhorse)\",\"in\":\"formData\",\"name\":\"file.remote_id\",\"required\":false,\"type\":\"string\"},{\"description\":\"Remote_url of the file (generated by Workhorse)\",\"in\":\"formData\",\"name\":\"file.remote_url\",\"required\":false,\"type\":\"string\"}],\"produces\":[\"application/json\"],\"protocol\":\"http\",\"responses\":{\"201\":{\"description\":\"Create a new project import\",\"schema\":{\"description\":\"API_Entities_ProjectImportStatus model\",\"properties\":{\"correlation_id\":{\"example\":\"dfcf583058ed4508e4c7c617bd7f0edd\",\"type\":\"string\"},\"created_at\":{\"example\":\"2020-05-07T04:27:17.016Z\",\"format\":\"date-time\",\"type\":\"string\"},\"description\":{\"example\":\"desc\",\"type\":\"string\"},\"failed_relations\":{\"items\":{\"properties\":{\"created_at\":{\"example\":\"2012-05-28T04:42:42-07:00\",\"format\":\"date-time\",\"type\":\"string\"},\"exception_class\":{\"example\":\"StandardError\",\"type\":\"string\"},\"exception_message\":{\"type\":\"string\"},\"id\":{\"example\":1,\"type\":\"string\"},\"line_number\":{\"example\":1,\"format\":\"int32\",\"type\":\"integer\"},\"relation_name\":{\"example\":\"issues\",\"type\":\"string\"},\"source\":{\"example\":\"ImportRepositoryWorker\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"id\":{\"example\":1,\"format\":\"int32\",\"type\":\"integer\"},\"import_error\":{\"example\":\"Error message\",\"type\":\"string\"},\"import_status\":{\"example\":\"scheduled\",\"type\":\"string\"},\"import_type\":{\"example\":\"gitlab_project\",\"type\":\"string\"},\"name\":{\"example\":\"project1\",\"type\":\"string\"},\"name_with_namespace\":{\"example\":\"John Doe / project1\",\"type\":\"string\"},\"path\":{\"example\":\"project1\",\"type\":\"string\"},\"path_with_namespace\":{\"example\":\"namespace1/project1\",\"type\":\"string\"},\"stats\":{\"type\":\"object\"}},\"type\":\"object\"}},\"400\":{\"description\":\"Bad request\"},\"401\":{\"description\":\"Unauthorized\"},\"403\":{\"description\":\"Forbidden\"},\"404\":{\"description\":\"Not found\"},\"503\":{\"description\":\"Service unavailable\"}},\"securitySchemes\":{\"access_token_header\":{\"in\":\"header\",\"name\":\"PRIVATE-TOKEN\",\"type\":\"apiKey\"},\"access_token_query\":{\"in\":\"query\",\"name\":\"private_token\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"
