          contract: {
            id: "POST /api/v4/projects/remote-import-s3"
            json: "{\"consumes\":[\"multipart/form-data\"],\"operationId\":\"postApiV4ProjectsRemoteImportS3\",\"parameters\":[{\"description\":\"AWS region\",\"in\":\"formData\",\"name\":\"region\",\"required\":true,\"type\":\"string\"},{\"description\":\"Bucket name\",\"in\":\"formData\",\"name\":\"bucket_name\",\"required\":true,\"type\":\"string\"},{\"description\":\"File key\",\"in\":\"formData\",\"name\":\"file_key\",\"required\":true,\"type\":\"string\"},{\"description\":\"Access key id\",\"in\":\"formData\",\"name\":\"access_key_id\",\"required\":true,\"type\":\"string\"},{\"description\":\"Secret access key\",\"in\":\"formData\",\"name\":\"secret_access_key\",\"required\":true,\"type\":\"string\"},{\"description\":\"The new project path and name\",\"in\":\"formData\",\"name\":\"path\",\"required\":true,\"type\":\"string\"},{\"description\":\"The name of the project to be imported. Defaults to the path of the project if not provided.\",\"in\":\"formData\",\"name\":\"name\",\"required\":false,\"type\":\"string\"},{\"description\":\"The ID or name of the namespace that the project will be imported into. Defaults to the current user's namespace.\",\"in\":\"formData\",\"name\":\"namespace\",\"required\":false,\"type\":\"string\"},{\"default\":false,\"description\":\"If there is a project in the same namespace and with the same name overwrite it\",\"in\":\"formData\",\"name\":\"overwrite\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"The description of the project\",\"in\":\"formData\",\"name\":\"override_params[description]\",\"required\":false,\"type\":\"string\"},{\"description\":\"The Git strategy. Defaults to `fetch`\",\"enum\":[\"fetch\",\"clone\"],\"in\":\"formData\",\"name\":\"override_params[build_git_strategy]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Build timeout\",\"format\":\"int32\",\"in\":\"formData\",\"name\":\"override_params[build_timeout]\",\"required\":false,\"type\":\"integer\"},{\"description\":\"Auto-cancel pending pipelines\",\"enum\":[\"disabled\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[auto_cancel_pending_pipelines]\",\"required\":false,\"type\":\"string\"},{\"description\":\"The path to CI config file. Defaults to `.gitlab-ci.yml`\",\"in\":\"formData\",\"name\":\"override_params[ci_config_path]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Disable or enable the service desk\",\"in\":\"formData\",\"name\":\"override_params[service_desk_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if the issue tracker is enabled\",\"in\":\"formData\",\"name\":\"override_params[issues_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if merge requests are enabled\",\"in\":\"formData\",\"name\":\"override_params[merge_requests_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if the wiki is enabled\",\"in\":\"formData\",\"name\":\"override_params[wiki_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if jobs are enabled\",\"in\":\"formData\",\"name\":\"override_params[jobs_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if snippets are enabled\",\"in\":\"formData\",\"name\":\"override_params[snippets_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Issues access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[issues_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Repository access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[repository_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Merge requests access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[merge_requests_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Forks access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[forking_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Wiki access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[wiki_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Builds access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[builds_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Snippets access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[snippets_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Controls visibility of the package registry. One of `disabled`, `private`, `enabled` or `public`. `private` will make the package registry accessible only to project members (reporter role and above). `enabled` will make the package registry accessible to everyone who has access to the project. `public` will make the package registry accessible to everyone. `disabled` will disable the package registry\",\"enum\":[\"disabled\",\"private\",\"enabled\",\"public\"],\"in\":\"formData\",\"name\":\"override_params[package_registry_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Pages access level. One of `disabled`, `private`, `enabled` or `public`\",\"enum\":[\"disabled\",\"private\",\"enabled\",\"public\"],\"in\":\"formData\",\"name\":\"override_params[pages_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Analytics access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[analytics_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Controls visibility of the container registry. One of `disabled`, `private` or `enabled`. `private` will make the container registry accessible only to project members (reporter role and above). `enabled` will make the container registry accessible to everyone who has access to the project. `disabled` will disable the container registry\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[container_registry_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Security and compliance access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[security_and_compliance_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Releases access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[releases_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Environments access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[environments_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Feature flags access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[feature_flags_access_level]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Infrastructure access level. One of `disabled`, `private` or `enabled`\",\"enum\":[\"disabled\",\"private\",\"enabled\"],\"in\":\"formData\",\"name\":\"override_params[infrastructure_access_level]\",\"require