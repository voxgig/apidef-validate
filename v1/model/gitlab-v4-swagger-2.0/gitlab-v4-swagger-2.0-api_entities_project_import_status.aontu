nners_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if group runners are enabled for that project\",\"in\":\"formData\",\"name\":\"override_params[group_runners_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"The process mode of the resource group\",\"enum\":[\"unordered\",\"oldest_first\",\"newest_first\",\"newest_ready_first\"],\"in\":\"formData\",\"name\":\"override_params[resource_group_default_process_mode]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Automatically resolve merge request diff threads on lines changed with a push\",\"in\":\"formData\",\"name\":\"override_params[resolve_outdated_diff_discussions]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Remove the source branch by default after merge\",\"in\":\"formData\",\"name\":\"override_params[remove_source_branch_after_merge]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Deprecated: Use :package_registry_access_level instead. Enable project packages feature\",\"in\":\"formData\",\"name\":\"override_params[packages_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Deprecated: Use :container_registry_access_level instead. Flag indication if the container registry is enabled for that project\",\"in\":\"formData\",\"name\":\"override_params[container_registry_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Container expiration policy cadence for recurring job\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][cadence]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Container expiration policy number of images to keep\",\"format\":\"int32\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][keep_n]\",\"required\":false,\"type\":\"integer\"},{\"description\":\"Container expiration policy remove images older than value\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][older_than]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Container expiration policy regex for image removal\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][name_regex]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Container expiration policy regex for image retention\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][name_regex_keep]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Flag indication if container expiration policy is enabled\",\"in\":\"formData\",\"name\":\"override_params[container_expiration_policy_attributes][enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Flag indication if Git LFS is enabled for that project\",\"in\":\"formData\",\"name\":\"override_params[lfs_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"The visibility of the project.\",\"enum\":[\"private\",\"internal\",\"public\"],\"in\":\"formData\",\"name\":\"override_params[visibility]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Deprecated: Use public_jobs instead.\",\"in\":\"formData\",\"name\":\"override_params[public_builds]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Perform public builds\",\"in\":\"formData\",\"name\":\"override_params[public_jobs]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Allow users to request member access\",\"in\":\"formData\",\"name\":\"override_params[request_access_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Only allow to merge if builds succeed\",\"in\":\"formData\",\"name\":\"override_params[only_allow_merge_if_pipeline_succeeds]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Allow to merge if pipeline is skipped\",\"in\":\"formData\",\"name\":\"override_params[allow_merge_on_skipped_pipeline]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Only allow to merge if all threads are resolved\",\"in\":\"formData\",\"name\":\"override_params[only_allow_merge_if_all_discussions_are_resolved]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"Deprecated: Use :topics instead\",\"in\":\"formData\",\"items\":{\"type\":\"string\"},\"name\":\"override_params[tag_list]\",\"required\":false,\"type\":\"array\"},{\"description\":\"The list of topics for a project\",\"in\":\"formData\",\"items\":{\"type\":\"string\"},\"name\":\"override_params[topics]\",\"required\":false,\"type\":\"array\"},{\"description\":\"Avatar image for project\",\"in\":\"formData\",\"name\":\"override_params[avatar]\",\"required\":false,\"type\":\"file\"},{\"description\":\"Show link to create/view merge request when pushing from the command line\",\"in\":\"formData\",\"name\":\"override_params[printing_merge_request_link_enabled]\",\"required\":false,\"type\":\"boolean\"},{\"description\":\"The merge method used when merging merge requests\",\"enum\":[\"ff\",\"rebase_merge\",\"merge\"],\"in\":\"formData\",\"name\":\"override_params[merge_method]\",\"required\":false,\"type\":\"string\"},{\"description\":\"The commit message used to apply merge request suggestions\",\"in\":\"formData\",\"name\":\"override_params[suggestion_commit_message]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Template used to create merge commit message\",\"in\":\"formData\",\"name\":\"override_params[merge_commit_template]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Template used to create squash commit message\",\"in\":\"formData\",\"name\":\"override_params[squash_commit_template]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Template used to create a branch from an issue\",\"in\":\"formData\",\"name\":\"override_params[issue_branch_template]\",\"required\":false,\"type\":\"string\"},{\"description\":\"Flag indication if Auto DevOps is enabled\",\"in\":\"formData\",\"name\":\"override_params[auto_devops_enabled]\",\"re