# Entity: api_entities_feature

main: kit: entity: api_entities_feature: {

  alias: field: {}

  fields: {
    definition: {
      h: "Definition"
      n: "definition"
      r: false
      sh: "API_Entities_Feature_Definition model"
      t: "`$OBJECT`"
    }
    feature_group: {
      h: "Feature Group"
      n: "feature_group"
      r: false
      sh: "A Feature group name"
      t: "`$STRING`"
    }
    force: {
      h: "Force"
      n: "force"
      r: false
      sh: "Skip feature flag validation checks, such as a YAML definition"
      t: "`$BOOLEAN`"
    }
    gates: {
      h: "Gates"
      n: "gates"
      r: false
      t: "`$OBJECT`"
    }
    group: {
      h: "Group"
      n: "group"
      r: false
      sh: "A GitLab group's path, for example `gitlab-org`, or comma-separated multiple group paths"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    key: {
      h: "Key"
      n: "key"
      r: false
      sh: "`percentage_of_actors` or `percentage_of_time` (default)"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      t: "`$STRING`"
    }
    namespace: {
      h: "Namespace"
      n: "namespace"
      r: false
      sh: "A GitLab group or user namespace's path, for example `john-doe`, or comma-separated multiple namespace paths."
      t: "`$STRING`"
    }
    project: {
      h: "Project"
      n: "project"
      r: false
      sh: "A projects path, for example `gitlab-org/gitlab-foss`, or comma-separated multiple project paths"
      t: "`$STRING`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "A repository path, for example `gitlab-org/gitlab-test.git`, `gitlab-org/gitlab-test.wiki.git`, `snippets/21.git`, to name a few."
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      sh: "A GitLab username or comma-separated multiple usernames"
      t: "`$STRING`"
    }
    value: {
      h: "Value"
      n: "value"
      r: true
      sh: "`true` or `false` to enable/disable, or an integer for percentage of time"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "api_entities_feature"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "feature_group"
            "force"
            "group"
            "key"
            "namespace"
            "project"
            "repository"
            "user"
            "value"
          ]
          co: {
            id: "POST /api/v4/features/{name}"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "name"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/api/v4/features/{name}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              name: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "features"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v4/features"
            source: "swagger2"
            version: 2
          }
          m: "GET"
          o: "/api/v4/features"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "features"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}