# Entity: api_entities_basic_success

main: kit: entity: api_entities_basic_success: {

  alias: field: {}

  fields: {
    jwt: {
      h: "Jwt"
      n: "jwt"
      r: true
      sh: "JWT token for authorization with the Jira Connect installation"
      t: "`$STRING`"
    }
    namespace_path: {
      h: "Namespace Path"
      n: "namespace_path"
      r: true
      sh: "Path for the namespace that should be subscribed"
      t: "`$STRING`"
    }
  }

  name: "api_entities_basic_success"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /api/v4/integrations/jira_connect/subscriptions"
            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/api/v4/integrations/jira_connect/subscriptions"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "integrations"
            }
            {
              lit: "jira_connect"
            }
            {
              lit: "subscriptions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.success`"
          }
        }
      ]
    }
  }



}