    initiativeTab: {
      h: "Initiative Tab"
      n: "initiativeTab"
      r: false
      sh: "The targeted tab of the initiative."
      t: "`$STRING`"
    }
    issue: {
      h: "Issue"
      n: "issue"
      r: false
      sh: "The favorited issue."
      t: "`$OBJECT`"
    }
    label: {
      h: "Label"
      n: "label"
      r: false
      sh: "The favorited label."
      t: "`$OBJECT`"
    }
    owner: {
      h: "Owner"
      n: "owner"
      r: false
      sh: "The user who owns this favorite."
      t: "`$OBJECT`"
    }
    parent: {
      h: "Parent"
