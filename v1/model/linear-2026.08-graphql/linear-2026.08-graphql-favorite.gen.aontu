  id: {
    field: "id"
    name: "id"
  }

  name: "favorite"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST favoriteCreate"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation FavoriteCreate($input: FavoriteCreateInput!) { favoriteCreate(input: $input) { favorite { ...FavoriteFields } success } } fragment FavoriteFields on Favorite { aiConversation { id } archivedAt color createdAt customView { id } customer { id } cycle { id } dashboard { id } detail document { id } facet { id } folderName icon id initiative { id } initiativeLabel { id } initiativeTab issue { id } label { id } owner { id } parent { id } pipelineTab predefinedViewTeam { id } predefinedViewType project { id } projectLabel { id } projectTab projectTeam { id } pullRequest { id } release { id } releaseNote { id } releasePipeline { id } sortOrder team { id } title type updatedAt url user { id } }"
            field: "favoriteCreate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "FavoriteCreateInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "favoriteCreate"
          t: {
            req: "`reqdata`"
            res: "`body.data.favoriteCreate.favorite`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "POST favorites"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "before"
                or: "before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "first"
                or: "first"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "include_archived"
                or: "include_archived"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "param"
                n: "last"
                or: "last"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "order_by"
                or: "order_by"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          gq: {
            doc: "query FavoriteList($after: String, $before: String, $first: Int, $includeArchived: Boolean, $last: Int, $orderBy: PaginationOrderBy) { favorites(after: $after, before: $before, first: $first, includeArchived: $includeArchived, last: $last, orderBy: $orderBy) { nodes { ...FavoriteFields } pageInfo { endCursor hasNextPage } } } fragment FavoriteFields on Favorite { aiConversation { id } archivedAt color createdAt customView { id } customer { id } cycle { id } dashboard { id } detail document { id } facet { id } folderName icon id initiative { id } initiativeLabel { id } initiativeTab issue { id } label { id } owner { id } parent { id } pipelineTab predefinedViewTeam { id } predefinedViewType project { id } projectLabel { id } projectTab projectTeam { id } pullRequest { id } release { id } releaseNote { id } releasePipeline { id } sortOrder team { id } title type updatedAt url user { id } }"
            field: "favorites"
            optype: "query"
            page: {
              cursor: "pageInfo.endCursor"
              more: "pageInfo.hasNextPage"
              nodes: "nodes"
              style: "relay"
            }
            vars: [
              {
                from: "after"
                gqltype: "String"
                name: "after"
              }
              {
                from: "before"
                gqltype: "String"
                name: "before"
              }
              {
                from: "first"
                gqltype: "Int"
                name: "first"
              }
              {
                from: "includeArchived"
                gqltype: "Boolean"
                name: "includeArchived"
              }
              {
                from: "last"
                gqltype: "Int"
                name: "last"
              }
              {
                from: "orderBy"
                gqltype: "PaginationOrderBy"
                name: "orderBy"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "favorites"
          t: {
            req: "`reqdata`"
            res: "`body.data.favorites.nodes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST favorite"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query FavoriteLoad($id: String!) { favorite(id: $id) { ...FavoriteFields } } fragment FavoriteFields on Favorite { aiConversation { id } archivedAt color createdAt customView { id } customer { id } cycle { id } dashboard { id } detail document { id } facet { id } folderName icon id initiative { id } initiativeLabel { id } initiativeTab issue { id } label { id } owner { id } parent { id } pipelineTab predefinedViewTeam { id } predefinedViewType project { id } projectLabel { id } projectTab projectTeam { id } pullRequest { id } release { id } releaseNote { id } releasePipeline { id } sortOrder team { id } title type updatedAt url user { id } }"
            field: "favorite"
            optype: "query"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "favorite"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.favorite`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "POST favoriteDelete"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "mutation FavoriteRemove($id: String!) { favoriteDelete(id: $id) { entityId lastSyncId success } }"
            field: "favoriteDelete"
            optype: "mutation"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "favoriteDelete"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.favoriteDelete`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST favoriteUpdate"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "mutation FavoriteUpdate($id: String!, $input: FavoriteUpdateInput!) { favoriteUpdate(id: $id, input: $input) { favorite { ...FavoriteFields } success } } fragment FavoriteFields on Favorite { aiConversation { id } archivedAt color createdAt customView { id } customer { id } cycle { id } dashboard { id } detail document { id } facet { id } folderName icon id initiative { id } initiativeLabel { id } initiativeTab issue { id } label { id } owner { id } parent { id } pipelineTab predefinedViewTeam { id } predefinedViewType project { id } projectLabel { id } projectTab projectTeam { id } pullRequest { id } release { id } releaseNote { id } releasePipeline { id } sortOrder team { id } title type updatedAt url user { id } }"
            field: "favoriteUpdate"
            optype: "mutation"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
              {
                from: ""
                gqltype: "FavoriteUpdateInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "favoriteUpdate"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.favoriteUpdate.favorite`"
          }
        }
      ]
    }
  }



