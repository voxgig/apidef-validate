      sh: "The targeted tab of the release pipeline."
      t: "`$STRING`"
    }
    predefinedViewTeam: {
      h: "Predefined View Team"
      n: "predefinedViewTeam"
      r: false
      sh: "The team of the favorited predefined view."
      t: "`$OBJECT`"
    }
    predefinedViewType: {
      h: "Predefined View Type"
      n: "predefinedViewType"
      r: false
      sh: "The type of favorited predefined view (e.g., 'allIssues', 'activeCycle', 'backlog', 'triage')."
      t: "`$STRING`"
    }
    project: {
      h: "Project"
      n: "project"
      r: false
      sh: "The favorited project."
