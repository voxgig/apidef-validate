      sh: "The time at which the entity was archived."
      t: "`$ANY`"
    }
    color: {
      h: "Color"
      n: "color"
      r: false
      sh: "[Internal] Returns the color of the favorite's icon."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "The time at which the entity was created."
      t: "`$ANY`"
    }
    customView: {
      h: "Custom View"
      n: "customView"
      r: false
      sh: "The favorited custom view."
      t: "`$OBJECT`"
