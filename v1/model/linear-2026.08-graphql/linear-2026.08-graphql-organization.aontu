# Entity: organization

main: kit: entity: organization: {

  alias: field: {}

  fields: [
    {
      name: "agentAutomationEnabled"
      req: true
      short: "[INTERNAL] Whether the workspace has enabled agent automation."
      type: "`$BOOLEAN`"
    }
    {
      name: "aiAddonEnabled"
      req: true
      short: "[INTERNAL] Whether the workspace has enabled the AI add-on (which at this point only includes triage suggestions)."
      type: "`$BOOLEAN`"
    }
    {
      name: "aiDiscussionSummariesEnabled"
      req: true
      short: "Whether the workspace has enabled AI discussion summaries for issues."
      type: "`$BOOLEAN`"
    }
    {
      name: "aiProviderConfiguration"
      req: false
      short: "[INTERNAL] Configure per-modality AI host providers and model families."
      type: "`$ANY`"
    }
    {
      name: "aiTelemetryEnabled"
      req: true
      short: "[INTERNAL] Whether the workspace has opted in to AI telemetry."
      type: "`$BOOLEAN`"
    }
    {
      name: "aiThreadSummariesEnabled"
      req: true
      short: "Whether the workspace has enabled resolved thread AI summaries."
      type: "`$BOOLEAN`"
    }
    {
      name: "allowedFileUploadContentTypes"
      req: false
      short: "Allowed file upload content types"
      type: "`$STRING`"
    }
    {
      name: "archivedAt"
      req: false
      short: "The time at which the entity was archived."
      type: "`$ANY`"
    }
    {
      name: "authSettings"
      req: true
      short: "Authentication settings for the workspace, including allowed auth providers, bypass rules, and organization visibility during signup."
      type: "`$ANY`"
    }
    {
      name: "codeIntelligenceEnabled"
      req: true
      short: "[INTERNAL] Whether code intelligence is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "codeIntelligenceRepository"
      req: false
      short: "[INTERNAL] GitHub repository in owner/repo format for code intelligence."
      type: "`$STRING`"
    }
    {
      name: "codingAgentEnabled"
      req: true
      short: "[INTERNAL] Whether the workspace has enabled Coding Sessions."
      type: "`$BOOLEAN`"
    }
    {
      name: "codingAgentSettings"
      req: true
      short: "[Internal] Settings for Coding Sessions features."
      type: "`$ANY`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the entity was created."
      type: "`$ANY`"
    }
    {
      name: "createdIssueCount"
      req: true
      short: "Approximate total number of issues created in the workspace, including archived ones."
      type: "`$INTEGER`"
    }
    {
      name: "customerCount"
      req: true
      short: "The number of active (non-archived) customers tracked in the workspace."
      type: "`$INTEGER`"
    }
    {
      name: "customersConfiguration"
      req: true
      short: "Configuration settings for the Customers feature, including revenue currency and other customer tracking preferences."
      type: "`$ANY`"
    }
    {
      name: "customersEnabled"
      req: true
      short: "Whether the Customers feature is enabled and accessible for the workspace based on the current plan."
      type: "`$BOOLEAN`"
    }
    {
      name: "defaultFeedSummarySchedule"
      req: false
      short: "Default schedule for how often feed summaries are generated."
      type: "`$STRING`"
    }
    {
      name: "defaultHomeView"
      req: false
      short: "The default home view for members of the workspace who have not chosen their own default."
      type: "`$STRING`"
    }
    {
      name: "defaultHomeViewTargetId"
      req: false
      short: "The id of the specific initiative, project, view, dashboard, or page tab used as the default home view."
      type: "`$STRING`"
    }
    {
      name: "deletionRequestedAt"
      req: false
      short: "The time at which deletion of the workspace was requested."
      type: "`$ANY`"
    }
    {
      name: "feedEnabled"
      req: true
      short: "Whether the activity feed feature is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "fiscalYearStartMonth"
      req: true
      short: "The zero-indexed month at which the fiscal year starts (0 = January, 11 = December)."
      type: "`$NUMBER`"
    }
    {
      name: "generatedUpdatesEnabled"
      req: true
      short: "[INTERNAL] Whether the workspace has enabled generated updates."
      type: "`$BOOLEAN`"
    }
    {
      name: "gitBranchFormat"
      req: false
      short: "The template format for Git branch names created from issues."
      type: "`$STRING`"
    }
    {
      name: "gitLinkbackDescriptionsEnabled"
      req: true
      short: "Whether issue descriptions should be included in the Git integration linkback messages posted to pull requests."
      type: "`$BOOLEAN`"
    }
    {
      name: "gitLinkbackMessagesEnabled"
      req: true
      short: "Whether the Git integration linkback messages should be posted as comments on pull requests in private repositories."
      type: "`$BOOLEAN`"
    }
    {
      name: "gitPublicLinkbackMessagesEnabled"
      req: true
      short: "Whether the Git integration linkback messages should be posted as comments on pull requests in public repositories."
      type: "`$BOOLEAN`"
    }
    {
      name: "hipaaComplianceEnabled"
      req: true
      short: "Whether HIPAA compliance is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the entity."
      type: "`$STRING`"
    }
    {
      name: "initiativeUpdateReminderFrequencyInWeeks"
      req: false
      short: "The frequency in weeks at which to prompt for initiative updates."
      type: "`$NUMBER`"
    }
    {
      name: "initiativeUpdateRemindersDay"
      req: true
      short: "The day of the week on which initiative update reminders are sent."
      type: "`$STRING`"
    }
    {
      name: "initiativeUpdateRemindersHour"
      req: true
      short: "The hour of the day (0-23) at which initiative update reminders are sent."
      type: "`$NUMBER`"
    }
    {
      name: "linearAgentEnabled"
      req: true
      short: "[Internal] Whether the workspace has enabled Linear Agent."
      type: "`$BOOLEAN`"
    }
    {
      name: "linearAgentSettings"
      req: true
      short: "[Internal] Settings for Linear Agent features."
      type: "`$ANY`"
    }
    {
      name: "logoUrl"
      req: false
      short: "The URL of the workspace's logo image."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The workspace's name."
      type: "`$STRING`"
    }
    {
      name: "periodUploadVolume"
      req: true
      short: "Rolling 30-day total file upload volume for the workspace, measured in megabytes."
      type: "`$NUMBER`"
    }
    {
      name: "previousUrlKeys"
      req: true
      short: "Previously used URL keys for the workspace."
      type: "`$STRING`"
    }
    {
      name: "projectUpdateReminderFrequencyInWeeks"
      req: false
      short: "The frequency in weeks at which to prompt for project updates."
      type: "`$NUMBER`"
    }
    {
      name: "projectUpdateRemindersDay"
      req: true
      short: "The day of the week on which project update reminders are sent."
      type: "`$STRING`"
    }
    {
      name: "projectUpdateRemindersHour"
      req: true
      short: "The hour of the day (0-23) at which project update reminders are sent."
      type: "`$NUMBER`"
    }
    {
      name: "pullRequestIssueMode"
      req: true
      short: "How Linear suggests and links issues for pull requests that have none linked: 'off', 'suggest', or 'autoOnMerge'."
      type: "`$STRING`"
    }
    {
      name: "pullRequestTourEnabled"
      req: true
      short: "Whether the workspace generates AI Pull Request guides for new pull requests."
      type: "`$BOOLEAN`"
    }
    {
      name: "releaseChannel"
      req: true
      short: "The feature release channel the workspace belongs to, which controls access to pre-release features."
      type: "`$STRING`"
    }
    {
      name: "releasesEnabled"
      req: true
      short: "Whether release management is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "restrictAgentInvocationToMembers"
      req: false
      short: "[Internal] Whether agent invocation is restricted to full workspace members."
      type: "`$BOOLEAN`"
    }
    {
      name: "roadmapEnabled"
      req: true
      short: "Whether the roadmap feature is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "samlEnabled"
      req: true
      short: "Whether SAML-based single sign-on authentication is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "samlSettings"
      req: false
      short: "[INTERNAL] SAML settings."
      type: "`$ANY`"
    }
    {
      name: "scimEnabled"
      req: true
      short: "Whether SCIM provisioning is enabled for the workspace, allowing automated user and team management from an identity provider."
      type: "`$BOOLEAN`"
    }
    {
      name: "scimSettings"
      req: false
      short: "[INTERNAL] SCIM settings."
      type: "`$ANY`"
    }
    {
      name: "securitySettings"
      req: true
      short: "Security settings for the workspace, including role-based restrictions for invitations, team creation, label management, and other sensitive operations."
      type: "`$ANY`"
    }
    {
      name: "slackAutoCreateProjectChannel"
      req: true
      short: "[Internal] Whether to automatically create a Slack channel when a new project is created."
      type: "`$BOOLEAN`"
    }
    {
      name: "slackProjectChannelIntegration"
      req: false
      short: "The Slack integration used for auto-creating project channels."
      type: "`$OBJECT`"
    }
    {
      name: "slackProjectChannelPrefix"
      req: true
      short: "The prefix used for auto-created Slack project channels."
      type: "`$STRING`"
    }
    {
      name: "slackProjectChannelsEnabled"
      req: true
      short: "[Internal] Whether the Slack project channels feature is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "subscription"
      req: false
      short: "The workspace's subscription to a paid plan."
      type: "`$OBJECT`"
    }
    {
      name: "themeSettings"
      req: false
      short: "[ALPHA] Theme settings for the workspace."
      type: "`$ANY`"
    }
    {
      name: "trialEndsAt"
      req: false
      short: "The time at which the current plan trial will end."
      type: "`$ANY`"
    }
    {
      name: "trialStartsAt"
      req: false
      short: "The time at which the current plan trial started."
      type: "`$ANY`"
    }
    {
      name: "updatedAt"
      req: true
      short: "The last time at which the entity was meaningfully updated."
      type: "`$ANY`"
    }
    {
      name: "urlKey"
      req: true
      short: "The workspace's unique URL key, used in URLs to identify the workspace."
      type: "`$STRING`"
    }
    {
      name: "userCount"
      req: true
      short: "The number of active (non-deactivated) users in the workspace."
      type: "`$INTEGER`"
    }
    {
      name: "workingDays"
      req: true
      short: "[Internal] The list of working days."
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "organization"
  op: {
    load: {
      name: "load"
      points: [
        {
          graphql: {
            doc: "query OrganizationLoad { organization { ...OrganizationFields } } fragment OrganizationFields on Organization { agentAutomationEnabled aiAddonEnabled aiDiscussionSummariesEnabled aiProviderConfiguration aiTelemetryEnabled aiThreadSummariesEnabled allowedFileUploadContentTypes archivedAt authSettings codeIntelligenceEnabled codeIntelligenceRepository codingAgentEnabled codingAgentSettings createdAt createdIssueCount customerCount customersConfiguration customersEnabled defaultFeedSummarySchedule defaultHomeView defaultHomeViewTargetId deletionRequestedAt feedEnabled fiscalYearStartMonth generatedUpdatesEnabled gitBranchFormat gitLinkbackDescriptionsEnabled gitLinkbackMessagesEnabled gitPublicLinkbackMessagesEnabled hipaaComplianceEnabled id initiativeUpdateReminderFrequencyInWeeks initiativeUpdateRemindersDay initiativeUpdateRemindersHour linearAgentEnabled linearAgentSettings logoUrl name periodUploadVolume previousUrlKeys projectUpdateReminderFrequencyInWeeks projectUpdateRemindersDay projectUpdateRemindersHour pullRequestIssueMode pullRequestTourEnabled releaseChannel releasesEnabled restrictAgentInvocationToMembers roadmapEnabled samlEnabled samlSettings scimEnabled scimSettings securitySettings slackAutoCreateProjectChannel slackProjectChannelIntegration { id } slackProjectChannelPrefix slackProjectChannelsEnabled subscription { id } themeSettings trialEndsAt trialStartsAt updatedAt urlKey userCount workingDays }"
            field: "organization"
            optype: "query"
          }
          kind: "graphql"
          method: "POST"
          orig: "organization"
          transform: {
            req: "`reqdata`"
            res: "`body.data.organization`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          graphql: {
            doc: "mutation OrganizationRemove($input: DeleteOrganizationInput!) { organizationDelete(input: $input) { success } }"
            field: "organizationDelete"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "DeleteOrganizationInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "organizationDelete"
          transform: {
            req: "`reqdata`"
            res: "`body.data.organizationDelete`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          graphql: {
            doc: "mutation OrganizationUpdate($input: OrganizationUpdateInput!) { organizationUpdate(input: $input) { organization { ...OrganizationFields } success } } fragment OrganizationFields on Organization { agentAutomationEnabled aiAddonEnabled aiDiscussionSummariesEnabled aiProviderConfiguration aiTelemetryEnabled aiThreadSummariesEnabled allowedFileUploadContentTypes archivedAt authSettings codeIntelligenceEnabled codeIntelligenceRepository codingAgentEnabled codingAgentSettings createdAt createdIssueCount customerCount customersConfiguration customersEnabled defaultFeedSummarySchedule defaultHomeView defaultHomeViewTargetId deletionRequestedAt feedEnabled fiscalYearStartMonth generatedUpdatesEnabled gitBranchFormat gitLinkbackDescriptionsEnabled gitLinkbackMessagesEnabled gitPublicLinkbackMessagesEnabled hipaaComplianceEnabled id initiativeUpdateReminderFrequencyInWeeks initiativeUpdateRemindersDay initiativeUpdateRemindersHour linearAgentEnabled linearAgentSettings logoUrl name periodUploadVolume previousUrlKeys projectUpdateReminderFrequencyInWeeks projectUpdateRemindersDay projectUpdateRemindersHour pullRequestIssueMode pullRequestTourEnabled releaseChannel releasesEnabled restrictAgentInvocationToMembers roadmapEnabled samlEnabled samlSettings scimEnabled scimSettings securitySettings slackAutoCreateProjectChannel slackProjectChannelIntegration { id } slackProjectChannelPrefix slackProjectChannelsEnabled subscription { id } themeSettings trialEndsAt trialStartsAt updatedAt urlKey userCount workingDays }"
            field: "organizationUpdate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "OrganizationUpdateInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "organizationUpdate"
          transform: {
            req: "`reqdata`"
            res: "`body.data.organizationUpdate.organization`"
          }
        }
      ]
    }
  }



