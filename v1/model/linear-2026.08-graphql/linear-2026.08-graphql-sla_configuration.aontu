# Entity: sla_configuration

main: kit: entity: sla_configuration: {

  alias: field: {}

  fields: [
    {
      name: "conditions"
      req: true
      short: "The workflow conditions that determine when this SLA rule applies."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The identifier of the SLA rule."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The name of the SLA rule."
      type: "`$STRING`"
    }
    {
      name: "removesSla"
      req: true
      short: "Whether the rule removes an SLA instead of setting one."
      type: "`$BOOLEAN`"
    }
    {
      name: "sla"
      req: false
      short: "The SLA value configured by the rule, expressed in milliseconds or business days depending on the day-count type."
      type: "`$NUMBER`"
    }
    {
      name: "slaType"
      req: false
      short: "The SLA type used when the rule sets an SLA."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "sla_configuration"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "team_id"
                orig: "team_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          graphql: {
            doc: "query SlaConfigurationList($teamId: String!) { slaConfigurations(teamId: $teamId) { ...SlaConfigurationFields } } fragment SlaConfigurationFields on SlaConfiguration { conditions id name removesSla sla slaType }"
            field: "slaConfigurations"
            optype: "query"
            vars: [
              {
                from: "teamId"
                gqltype: "String!"
                name: "teamId"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "slaConfigurations"
          select: {
            exist: [
              "team_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.slaConfigurations`"
          }
        }
      ]
    }
  }



}