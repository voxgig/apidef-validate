# Entity: project_update

main: kit: entity: project_update: {

  alias: field: {}

  fields: [
    {
      name: "archivedAt"
      req: false
      short: "The time at which the entity was archived."
      type: "`$ANY`"
    }
    {
      name: "body"
      req: true
      short: "The update content in markdown format."
      type: "`$STRING`"
    }
    {
      name: "bodyData"
      req: true
      short: "[Internal] The content of the update as a Prosemirror document."
      type: "`$STRING`"
    }
    {
      name: "commentCount"
      req: true
      short: "Number of comments associated with the project update."
      type: "`$INTEGER`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the entity was created."
      type: "`$ANY`"
    }
    {
      name: "diff"
      req: false
      short: "The diff between the current update and the previous one."
      type: "`$ANY`"
    }
    {
      name: "diffMarkdown"
      req: false
      short: "The diff between the current update and the previous one, formatted as markdown."
      type: "`$STRING`"
    }
    {
      name: "editedAt"
      req: false
      short: "The time the update was edited."
      type: "`$ANY`"
    }
    {
      name: "health"
      req: true
      short: "The health of the project at the time this update was posted."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the entity."
      type: "`$STRING`"
    }
    {
      name: "infoSnapshot"
      req: false
      short: "[Internal] A snapshot of project properties at the time the update was posted, including team, milestone, and issue statistics."
      type: "`$ANY`"
    }
    {
      name: "isDiffHidden"
      req: true
      short: "Whether the diff between this update and the previous one should be hidden in the UI."
      type: "`$BOOLEAN`"
    }
    {
      name: "isStale"
      req: true
      short: "Whether the project update is stale."
      type: "`$BOOLEAN`"
    }
    {
      name: "project"
      req: false
      short: "The project that this status update was posted to."
      type: "`$OBJECT`"
    }
    {
      name: "reactionData"
      req: true
      short: "Emoji reaction summary, grouped by emoji type."
      type: "`$ANY`"
    }
    {
      name: "slugId"
      req: true
      short: "The update's unique URL slug."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "The last time at which the entity was meaningfully updated."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The URL to the project update."
      type: "`$STRING`"
    }
    {
      name: "user"
      req: false
      short: "The user who wrote the update."
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

