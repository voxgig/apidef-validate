# Entity: email_intake_address

main: kit: entity: email_intake_address: {

  alias: field: {}

  fields: {
    address: {
      h: "Address"
      n: "address"
      r: true
      sh: "The unique local part (before the @) of the intake email address, used to route incoming emails to the correct intake handler."
      t: "`$STRING`"
    }
    archivedAt: {
      h: "Archived At"
      n: "archivedAt"
      r: false
      sh: "The time at which the entity was archived."
      t: "`$ANY`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "The time at which the entity was created."
      t: "`$ANY`"
    }
    creator: {
      h: "Creator"
      n: "creator"
      r: false
      sh: "The user who created the email intake address."
      t: "`$OBJECT`"
    }
    customerRequestsEnabled: {
      h: "Customer Requests Enabled"
      n: "customerRequestsEnabled"
      r: true
      sh: "Whether issues created from emails sent to this address are automatically converted into customer requests, linking the sender as a customer contact."
      t: "`$BOOLEAN`"
    }
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: true
      sh: "Whether the email address is enabled."
      t: "`$BOOLEAN`"
    }
    forwardingEmailAddress: {
      h: "Forwarding Email Address"
      n: "forwardingEmailAddress"
      r: false
      sh: "The email address used to forward emails to the intake address."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The unique identifier of the entity."
      t: "`$STRING`"
    }
    issueCanceledAutoReply: {
      h: "Issue Canceled Auto Reply"
      n: "issueCanceledAutoReply"
      r: false
      sh: "The auto-reply message for issue canceled."
      t: "`$STRING`"
    }
    issueCanceledAutoReplyEnabled: {
      h: "Issue Canceled Auto Reply Enabled"
      n: "issueCanceledAutoReplyEnabled"
      r: true
      sh: "Whether the auto-reply for issue canceled is enabled."
      t: "`$BOOLEAN`"
    }
    issueCompletedAutoReply: {
      h: "Issue Completed Auto Reply"
      n: "issueCompletedAutoReply"
      r: false
      sh: "The auto-reply message for issue completed."
      t: "`$STRING`"
    }
    issueCompletedAutoReplyEnabled: {
      h: "Issue Completed Auto Reply Enabled"
      n: "issueCompletedAutoReplyEnabled"
      r: true
      sh: "Whether the auto-reply for issue completed is enabled."
      t: "`$BOOLEAN`"
    }
    issueCreatedAutoReply: {
      h: "Issue Created Auto Reply"
      n: "issueCreatedAutoReply"
      r: false
      sh: "The auto-reply message for issue created."
      t: "`$STRING`"
    }
    issueCreatedAutoReplyEnabled: {
      h: "Issue Created Auto Reply Enabled"
      n: "issueCreatedAutoReplyEnabled"
      r: true
      sh: "Whether the auto-reply for issue created is enabled."
      t: "`$BOOLEAN`"
    }
    lastUsedAt: {
      h: "Last Used At"
      n: "lastUsedAt"
      r: false
      sh: "The last time an inbound email was successfully ingested for this address."
      t: "`$ANY`"
    }
    organization: {
      h: "Organization"
      n: "organization"
      r: false
      sh: "The workspace that the email address is associated with."
      t: "`$OBJECT`"
    }
    reopenOnReply: {
      h: "Reopen On Reply"
      n: "reopenOnReply"
      r: true
      sh: "Whether to reopen completed or canceled issues when a substantive email reply is received."
      t: "`$BOOLEAN`"
    }
    repliesEnabled: {
      h: "Replies Enabled"
      n: "repliesEnabled"
      r: true
      sh: "Whether email replies are enabled."
      t: "`$BOOLEAN`"
    }
    senderName: {
      h: "Sender Name"
      n: "senderName"
      r: false
      sh: "The name to be used for outgoing emails."
      t: "`$STRING`"
    }
    sesDomainIdentity: {
      h: "Ses Domain Identity"
      n: "sesDomainIdentity"
      r: false
      sh: "The SES domain identity that the email address is associated with."
      t: "`$OBJECT`"
    }
    team: {
      h: "Team"
      n: "team"
      r: false
      sh: "The team that the email address is associated with."
      t: "`$OBJECT`"
    }
    template: {
      h: "Template"
      n: "template"
      r: false
      sh: "The template that the email address is associated with."
      t: "`$OBJECT`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "The type of the email address."
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "The last time at which the entity was meaningfully updated."
      t: "`$ANY`"
    }
    useUserNamesInReplies: {
      h: "Use User Names In Replies"
      n: "useUserNamesInReplies"
      r: true
      sh: "Whether the commenter's name is included in the email replies."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "email_intake_address"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST emailIntakeAddressCreate"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation EmailIntakeAddressCreate($input: EmailIntakeAddressCreateInput!) { emailIntakeAddressCreate(input: $input) { emailIntakeAddress { ...EmailIntakeAddressFields } success } } fragment EmailIntakeAddressFields on EmailIntakeAddress { address archivedAt createdAt creator { id } customerRequestsEnabled enabled forwardingEmailAddress id issueCanceledAutoReply issueCanceledAutoReplyEnabled issueCompletedAutoReply issueCompletedAutoReplyEnabled issueCreatedAutoReply issueCreatedAutoReplyEnabled lastUsedAt organization { id } reopenOnReply repliesEnabled senderName sesDomainIdentity { id } team { id } template { id } type updatedAt useUserNamesInReplies }"
            field: "emailIntakeAddressCreate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "EmailIntakeAddressCreateInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "emailIntakeAddressCreate"
          t: {
            req: "`reqdata`"
            res: "`body.data.emailIntakeAddressCreate.emailIntakeAddress`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST emailIntakeAddress"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query EmailIntakeAddressLoad($id: String!) { emailIntakeAddress(id: $id) { ...EmailIntakeAddressFields } } fragment EmailIntakeAddressFields on EmailIntakeAddress { address archivedAt createdAt creator { id } customerRequestsEnabled enabled forwardingEmailAddress id issueCanceledAutoReply issueCanceledAutoReplyEnabled issueCompletedAutoReply issueCompletedAutoReplyEnabled issueCreatedAutoReply issueCreatedAutoReplyEnabled lastUsedAt organization { id } reopenOnReply repliesEnabled senderName sesDomainIdentity { id } team { id } template { id } type updatedAt useUserNamesInReplies }"
            field: "emailIntakeAddress"
            optype: "query"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "emailIntakeAddress"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.emailIntakeAddress`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "POST emailIntakeAddressDelete"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "mutation EmailIntakeAddressRemove($id: String!) { emailIntakeAddressDelete(id: $id) { entityId lastSyncId success } }"
            field: "emailIntakeAddressDelete"
            optype: "mutation"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "emailIntakeAddressDelete"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.emailIntakeAddressDelete`"
          }
        }
