# Entity: organization

main: kit: entity: organization: {

  alias: field: {}

  fields: [
    {
      name: "agentAutomationEnabled"
      req: true
      short: "[INTERNAL] Whether the workspace has enabled agent automation."
      type: "`$BOOLEAN`"
    }
    {
      name: "aiAddonEnabled"
      req: true
      short: "[INTERNAL] Whether the workspace has enabled the AI add-on (which at this point only includes triage suggestions)."
      type: "`$BOOLEAN`"
    }
    {
      name: "aiDiscussionSummariesEnabled"
      req: true
      short: "Whether the workspace has enabled AI discussion summaries for issues."
      type: "`$BOOLEAN`"
    }
    {
      name: "aiProviderConfiguration"
      req: false
      short: "[INTERNAL] Configure per-modality AI host providers and model families."
      type: "`$ANY`"
    }
    {
      name: "aiTelemetryEnabled"
      req: true
      short: "[INTERNAL] Whether the workspace has opted in to AI telemetry."
      type: "`$BOOLEAN`"
    }
    {
      name: "aiThreadSummariesEnabled"
      req: true
      short: "Whether the workspace has enabled resolved thread AI summaries."
      type: "`$BOOLEAN`"
    }
    {
      name: "allowedFileUploadContentTypes"
      req: false
      short: "Allowed file upload content types"
      type: "`$STRING`"
    }
    {
      name: "archivedAt"
      req: false
      short: "The time at which the entity was archived."
      type: "`$ANY`"
    }
    {
      name: "authSettings"
      req: true
      short: "Authentication settings for the workspace, including allowed auth providers, bypass rules, and organization visibility during signup."
      type: "`$ANY`"
    }
    {
      name: "codeIntelligenceEnabled"
      req: true
      short: "[INTERNAL] Whether code intelligence is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "codeIntelligenceRepository"
      req: false
      short: "[INTERNAL] GitHub repository in owner/repo format for code intelligence."
      type: "`$STRING`"
    }
    {
      name: "codingAgentEnabled"
      req: true
      short: "[INTERNAL] Whether the workspace has enabled Coding Sessions."
      type: "`$BOOLEAN`"
    }
    {
      name: "codingAgentSettings"
      req: true
      short: "[Internal] Settings for Coding Sessions features."
      type: "`$ANY`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the entity was created."
      type: "`$ANY`"
    }
    {
      name: "createdIssueCount"
      req: true
      short: "Approximate total number of issues created in the workspace, including archived ones."
      type: "`$INTEGER`"
    }
    {
      name: "customerCount"
      req: true
      short: "The number of active (non-archived) customers tracked in the workspace."
      type: "`$INTEGER`"
    }
    {
      name: "customersConfiguration"
      req: true
      short: "Configuration settings for the Customers feature, including revenue currency and other customer tracking preferences."
      type: "`$ANY`"
    }
    {
      name: "customersEnabled"
      req: true
      short: "Whether the Customers feature is enabled and accessible for the workspace based on the current plan."
      type: "`$BOOLEAN`"
    }
    {
      name: "defaultFeedSummarySchedule"
      req: false
      short: "Default schedule for how often feed summaries are generated."
      type: "`$STRING`"
    }
    {
      name: "defaultHomeView"
      req: false
      short: "The default home view for members of the workspace who have not chosen their own default."
      type: "`$STRING`"
    }
    {
      name: "defaultHomeViewTargetId"
      req: false
      short: "The id of the specific initiative, project, view, dashboard, or page tab used as the default home view."
      type: "`$STRING`"
    }
    {
      name: "deletionRequestedAt"
      req: false
      short: "The time at which deletion of the workspace was requested."
      type: "`$ANY`"
    }
    {
      name: "feedEnabled"
      req: true
      short: "Whether the activity feed feature is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "fiscalYearStartMonth"
      req: true
      short: "The zero-indexed month at which the fiscal year starts (0 = January, 11 = December)."
      type: "`$NUMBER`"
    }
    {
      name: "generatedUpdatesEnabled"
      req: true
      short: "[INTERNAL] Whether the workspace has enabled generated updates."
      type: "`$BOOLEAN`"
    }
    {
      name: "gitBranchFormat"
      req: false
      short: "The template format for Git branch names created from issues."
      type: "`$STRING`"
    }
    {
      name: "gitLinkbackDescriptionsEnabled"
      req: true
      short: "Whether issue descriptions should be included in the Git integration linkback messages posted to pull requests."
      type: "`$BOOLEAN`"
    }
    {
      name: "gitLinkbackMessagesEnabled"
      req: true
      short: "Whether the Git integration linkback messages should be posted as comments on pull requests in private repositories."
