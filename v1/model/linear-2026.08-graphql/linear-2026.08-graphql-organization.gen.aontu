    }
    {
      name: "projectUpdateRemindersDay"
      req: true
      short: "The day of the week on which project update reminders are sent."
      type: "`$STRING`"
    }
    {
      name: "projectUpdateRemindersHour"
      req: true
      short: "The hour of the day (0-23) at which project update reminders are sent."
      type: "`$NUMBER`"
    }
    {
      name: "pullRequestIssueMode"
      req: true
      short: "How Linear suggests and links issues for pull requests that have none linked: 'off', 'suggest', or 'autoOnMerge'."
      type: "`$STRING`"
    }
    {
      name: "pullRequestTourEnabled"
      req: true
      short: "Whether the workspace generates AI Pull Request guides for new pull requests."
      type: "`$BOOLEAN`"
    }
    {
      name: "releaseChannel"
      req: true
      short: "The feature release channel the workspace belongs to, which controls access to pre-release features."
      type: "`$STRING`"
    }
    {
      name: "releasesEnabled"
      req: true
      short: "Whether release management is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "restrictAgentInvocationToMembers"
      req: false
      short: "[Internal] Whether agent invocation is restricted to full workspace members."
      type: "`$BOOLEAN`"
    }
    {
      name: "roadmapEnabled"
      req: true
      short: "Whether the roadmap feature is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "samlEnabled"
      req: true
      short: "Whether SAML-based single sign-on authentication is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "samlSettings"
      req: false
      short: "[INTERNAL] SAML settings."
      type: "`$ANY`"
    }
    {
      name: "scimEnabled"
      req: true
      short: "Whether SCIM provisioning is enabled for the workspace, allowing automated user and team management from an identity provider."
      type: "`$BOOLEAN`"
    }
    {
      name: "scimSettings"
      req: false
      short: "[INTERNAL] SCIM settings."
      type: "`$ANY`"
    }
    {
      name: "securitySettings"
      req: true
      short: "Security settings for the workspace, including role-based restrictions for invitations, team creation, label management, and other sensitive operations."
      type: "`$ANY`"
    }
    {
      name: "slackAutoCreateProjectChannel"
      req: true
      short: "[Internal] Whether to automatically create a Slack channel when a new project is created."
      type: "`$BOOLEAN`"
    }
    {
      name: "slackProjectChannelIntegration"
      req: false
      short: "The Slack integration used for auto-creating project channels."
      type: "`$OBJECT`"
    }
    {
      name: "slackProjectChannelPrefix"
      req: true
      short: "The prefix used for auto-created Slack project channels."
