            json: "{\"field\":{\"args\":[{\"gqltype\":\"OrganizationUpdateInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"OrganizationUpdateInput\"}],\"deprecated\":false,\"desc\":\"Updates the user's workspace settings. Different settings require different permission levels; most require the workspaceSettings admin permission.\",\"gqltype\":\"OrganizationPayload!\",\"list\":false,\"name\":\"organizationUpdate\",\"reqd\":true,\"type\":\"OrganizationPayload\"},\"invocation\":{\"doc\":\"mutation OrganizationUpdate($input: OrganizationUpdateInput!) { organizationUpdate(input: $input) { organization { ...OrganizationFields } success } } fragment OrganizationFields on Organization { agentAutomationEnabled aiAddonEnabled aiDiscussionSummariesEnabled aiProviderConfiguration aiTelemetryEnabled aiThreadSummariesEnabled allowedFileUploadContentTypes archivedAt authSettings codeIntelligenceEnabled codeIntelligenceRepository codingAgentEnabled codingAgentSettings createdAt createdIssueCount customerCount customersConfiguration customersEnabled defaultFeedSummarySchedule defaultHomeView defaultHomeViewTargetId deletionRequestedAt feedEnabled fiscalYearStartMonth generatedUpdatesEnabled gitBranchFormat gitLinkbackDescriptionsEnabled gitLinkbackMessagesEnabled gitPublicLinkbackMessagesEnabled hipaaComplianceEnabled id initiativeUpdateReminderFrequencyInWeeks initiativeUpdateRemindersDay initiativeUpdateRemindersHour linearAgentEnabled linearAgentSettings logoUrl name periodUploadVolume previousUrlKeys projectUpdateReminderFrequencyInWeeks projectUpdateRemindersDay projectUpdateRemindersHour pullRequestIssueMode pullRequestTourEnabled releaseChannel releasesEnabled restrictAgentInvocationToMembers roadmapEnabled samlEnabled samlSettings scimEnabled scimSettings securitySettings slackAutoCreateProjectChannel slackProjectChannelIntegration { id } slackProjectChannelPrefix slackProjectChannelsEnabled subscription { id } themeSettings trialEndsAt trialStartsAt updatedAt urlKey userCount workingDays }\",\"field\":\"organizationUpdate\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"OrganizationUpdateInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"CustomersAttributesDataSourceConfigurationInput\":{\"desc\":\"[Internal] Configuration for the customer attributes data source.\",\"fields\":{\"allowManualEdits\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] Whether to allow manual edits to customer attributes when no source is configured.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"allowManualEdits\",\"reqd\":false,\"type\":\"Boolean\"},\"attributesErrors\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] Errors encountered while syncing customer attributes (set by sync workers).\",\"gqltype\":\"JSONObject\",\"list\":false,\"name\":\"attributesErrors\",\"reqd\":false,\"type\":\"JSONObject\"},\"attributesMapping\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] Mapping from customer attribute keys (owner, revenue, size, status, tier, externalId) to external field IDs.\",\"gqltype\":\"JSONObject\",\"list\":false,\"name\":\"attributesMapping\",\"reqd\":false,\"type\":\"JSONObject\"},\"integration\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] Integration details (when sourceType is 'integration').\",\"gqltype\":\"CustomersAttributesDataSourceIntegrationInput\",\"list\":false,\"name\":\"integration\",\"reqd\":false,\"type\":\"CustomersAttributesDataSourceIntegrationInput\"},\"sourceType\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] How customer attribute values are sourced: 'manual' or 'integration'.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"sourceType\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CustomersAttributesDataSourceConfigurationInput\"},\"CustomersAttributesDataSourceIntegrationInput\":{\"desc\":\"[Internal] Integration providing customer attribute data.\",\"fields\":{\"service\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] The integration service that manages customer attributes.\",\"gqltype\":\"IntegrationService!\",\"list\":false,\"name\":\"service\",\"reqd\":true,\"type\":\"IntegrationService\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CustomersAttributesDataSourceIntegrationInput\"},\"CustomersConfigurationInput\":{\"desc\":\"[Internal] Input for updating workspace Customers feature configuration.\",\"fields\":{\"attributesDataSourceConfiguration\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] Configuration for the customer attributes data source.\",\"gqltype\":\"CustomersAttributesDataSourceConfigurationInput\",\"list\":false,\"name\":\"attributesDataSourceConfiguration\",\"reqd\":false,\"type\":\"CustomersAttributesDataSourceConfigurationInput\"},\"defaultTeamId\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] The team to use to create default issues for new request items.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"defaultTeamId\",\"reqd\":false,\"type\":\"String\"},\"excludeList\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] Domains or email addresses excluded entirely from the Customers feature.\",\"gqltype\":\"[String!]\",\"list\":true,\"name\":\"excludeList\",\"reqd\":false,\"type\":\"String\"},\"ignoreList\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] Domains or email addresses ignored when matching to a customer.\",\"gqltype\":\"[String!]\",\"list\":true,\"name\":\"ignoreList\",\"reqd\":false,\"type\":\"String\"},\"revenueCurrencyCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] The currency code used for customer revenue.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"revenueCurrencyCode\",\"reqd\":false,\"type\":\"String\"},\"revenueDisplay\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] How customer revenue should be displayed.\",\"gqltyp