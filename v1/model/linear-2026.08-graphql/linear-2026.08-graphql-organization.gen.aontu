    }
    {
      name: "slackProjectChannelsEnabled"
      req: true
      short: "[Internal] Whether the Slack project channels feature is enabled for the workspace."
      type: "`$BOOLEAN`"
    }
    {
      name: "subscription"
      req: false
      short: "The workspace's subscription to a paid plan."
      type: "`$OBJECT`"
    }
    {
      name: "themeSettings"
      req: false
      short: "[ALPHA] Theme settings for the workspace."
      type: "`$ANY`"
    }
    {
      name: "trialEndsAt"
      req: false
      short: "The time at which the current plan trial will end."
