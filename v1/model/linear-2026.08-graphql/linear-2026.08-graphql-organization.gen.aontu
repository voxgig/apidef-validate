    }
    {
      name: "trialStartsAt"
      req: false
      short: "The time at which the current plan trial started."
      type: "`$ANY`"
    }
    {
      name: "updatedAt"
      req: true
      short: "The last time at which the entity was meaningfully updated."
      type: "`$ANY`"
    }
    {
      name: "urlKey"
      req: true
      short: "The workspace's unique URL key, used in URLs to identify the workspace."
      type: "`$STRING`"
    }
    {
      name: "userCount"
      req: true
      short: "The number of active (non-deactivated) users in the workspace."
      type: "`$INTEGER`"
    }
    {
      name: "workingDays"
      req: true
      short: "[Internal] The list of working days."
      type: "`$NUMBER`"
    }
  ]

