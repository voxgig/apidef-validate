      req: false
      short: "The frequency in weeks at which to prompt for initiative updates."
      type: "`$NUMBER`"
    }
    {
      name: "initiativeUpdateRemindersDay"
      req: true
      short: "The day of the week on which initiative update reminders are sent."
      type: "`$STRING`"
    }
    {
      name: "initiativeUpdateRemindersHour"
      req: true
      short: "The hour of the day (0-23) at which initiative update reminders are sent."
      type: "`$NUMBER`"
    }
    {
      name: "linearAgentEnabled"
      req: true
      short: "[Internal] Whether the workspace has enabled Linear Agent."
      type: "`$BOOLEAN`"
    }
    {
      name: "linearAgentSettings"
      req: true
      short: "[Internal] Settings for Linear Agent features."
