                name: "copySettingsFromTeamId"
              }
              {
                from: ""
                gqltype: "TeamCreateInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "teamCreate"
          t: {
            req: "`reqdata`"
            res: "`body.data.teamCreate.team`"
          }
        }
      ]
    }
