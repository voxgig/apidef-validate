# Entity: o_auth_application

main: kit: entity: o_auth_application: {

  alias: field: {}

  fields: {
    clientId: {
      h: "Client Id"
      n: "clientId"
      r: true
      sh: "The client ID used during OAuth authorization flows."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "The time at which the OAuth application was created."
      t: "`$ANY`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "User-facing description of the OAuth application."
      t: "`$STRING`"
    }
    developer: {
      h: "Developer"
      n: "developer"
      r: true
      sh: "Name of the developer or company that built the OAuth application."
      t: "`$STRING`"
    }
    developerUrl: {
      h: "Developer Url"
      n: "developerUrl"
      r: true
      sh: "URL of the developer's website, homepage, or documentation."
      t: "`$STRING`"
    }
    distribution: {
      h: "Distribution"
      n: "distribution"
      r: true
      sh: "Distribution setting for the OAuth application."
      t: "`$STRING`"
    }
    grantTypes: {
      h: "Grant Types"
      n: "grantTypes"
      r: true
      sh: "OAuth grant types supported by this application."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The unique identifier of the OAuth application."
      t: "`$STRING`"
    }
    imageUrl: {
      h: "Image Url"
      n: "imageUrl"
      r: false
      sh: "URL of the OAuth application's icon."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The human-readable name of the OAuth application."
      t: "`$STRING`"
    }
    redirectUris: {
      h: "Redirect Uris"
      n: "redirectUris"
      r: true
      sh: "Allowed redirect URIs for OAuth authorization flows."
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "The time at which the OAuth application was last updated."
      t: "`$ANY`"
    }
    webhookEnabled: {
      h: "Webhook Enabled"
      n: "webhookEnabled"
      r: true
      sh: "Whether webhook delivery is enabled for this OAuth application."
      t: "`$BOOLEAN`"
    }
    webhookResourceTypes: {
      h: "Webhook Resource Types"
      n: "webhookResourceTypes"
      r: true
      sh: "Resource types the OAuth application's webhooks subscribe to."
      t: "`$STRING`"
    }
    webhookUrl: {
      h: "Webhook Url"
      n: "webhookUrl"
      r: false
      sh: "Webhook URL used for delivering webhook payloads."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "o_auth_application"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST oauthApplicationCreate"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation OAuthApplicationCreate($input: OAuthApplicationCreateInput!) { oauthApplicationCreate(input: $input) { application { ...OAuthApplicationFields } success } } fragment OAuthApplicationFields on OAuthApplication { clientId createdAt description developer developerUrl distribution grantTypes id imageUrl name redirectUris updatedAt webhookEnabled webhookResourceTypes webhookUrl }"
            field: "oauthApplicationCreate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "OAuthApplicationCreateInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "oauthApplicationCreate"
          t: {
            req: "`reqdata`"
            res: "`body.data.oauthApplicationCreate.application`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "POST oauthApplications"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "query OAuthApplicationList { oauthApplications { ...OAuthApplicationFields } } fragment OAuthApplicationFields on OAuthApplication { clientId createdAt description developer developerUrl distribution grantTypes id imageUrl name redirectUris updatedAt webhookEnabled webhookResourceTypes webhookUrl }"
            field: "oauthApplications"
            optype: "query"
          }
          k: "graphql"
          m: "POST"
          o: "oauthApplications"
          t: {
            req: "`reqdata`"
            res: "`body.data.oauthApplications`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST oauthApplication"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query OAuthApplicationLoad($id: String!) { oauthApplication(id: $id) { ...OAuthApplicationFields } } fragment OAuthApplicationFields on OAuthApplication { clientId createdAt description developer developerUrl distribution grantTypes id imageUrl name redirectUris updatedAt webhookEnabled webhookResourceTypes webhookUrl }"
            field: "oauthApplication"
            optype: "query"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "oauthApplication"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.oauthApplication`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST oauthApplicationUpdate"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "mutation OAuthApplicationUpdate($id: String!, $input: OAuthApplicationUpdateInput!) { oauthApplicationUpdate(id: $id, input: $input) { application { ...OAuthApplicationFields } success } } fragment OAuthApplicationFields on OAuthApplication { clientId createdAt description developer developerUrl distribution grantTypes id imageUrl name redirectUris updatedAt webhookEnabled webhookResourceTypes webhookUrl }"
            field: "oauthApplicationUpdate"
            optype: "mutation"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
              {
                from: ""
                gqltype: "OAuthApplicationUpdateInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "oauthApplicationUpdate"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.oauthApplicationUpdate.application`"
          }
        }
      ]
    }
  }



}