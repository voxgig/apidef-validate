# Entity: o_auth_application

main: kit: entity: o_auth_application: {

  alias: field: {}

  fields: [
    {
      name: "clientId"
      req: true
      short: "The client ID used during OAuth authorization flows."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the OAuth application was created."
      type: "`$ANY`"
    }
    {
      name: "description"
      req: false
      short: "User-facing description of the OAuth application."
      type: "`$STRING`"
    }
    {
      name: "developer"
      req: true
      short: "Name of the developer or company that built the OAuth application."
      type: "`$STRING`"
    }
    {
      name: "developerUrl"
      req: true
      short: "URL of the developer's website, homepage, or documentation."
      type: "`$STRING`"
    }
    {
      name: "distribution"
      req: true
      short: "Distribution setting for the OAuth application."
      type: "`$STRING`"
    }
    {
      name: "grantTypes"
      req: true
      short: "OAuth grant types supported by this application."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the OAuth application."
      type: "`$STRING`"
    }
    {
      name: "imageUrl"
      req: false
      short: "URL of the OAuth application's icon."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The human-readable name of the OAuth application."
      type: "`$STRING`"
    }
    {
      name: "redirectUris"
      req: true
      short: "Allowed redirect URIs for OAuth authorization flows."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "The time at which the OAuth application was last updated."
      type: "`$ANY`"
    }
    {
      name: "webhookEnabled"
      req: true
      short: "Whether webhook delivery is enabled for this OAuth application."
      type: "`$BOOLEAN`"
    }
    {
      name: "webhookResourceTypes"
      req: true
      short: "Resource types the OAuth application's webhooks subscribe to."
      type: "`$STRING`"
    }
    {
      name: "webhookUrl"
      req: false
      short: "Webhook URL used for delivering webhook payloads."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

