# Entity: webhook_failure_event

main: kit: entity: webhook_failure_event: {

  alias: field: {}

  fields: {
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "The time at which the entity was created."
      t: "`$ANY`"
    }
    executionId: {
      h: "Execution Id"
      n: "executionId"
      r: true
      sh: "A stable identifier for the webhook delivery attempt."
      t: "`$STRING`"
    }
    httpStatus: {
      h: "Http Status"
      n: "httpStatus"
      r: false
      sh: "The HTTP status code returned by the webhook recipient."
      t: "`$NUMBER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The unique identifier of the entity."
      t: "`$STRING`"
    }
    responseOrError: {
      h: "Response Or Error"
      n: "responseOrError"
      r: false
      sh: "The HTTP response body returned by the recipient, or the error message if the request failed before receiving a response."
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The URL that the webhook was trying to push to."
      t: "`$STRING`"
    }
    webhook: {
      h: "Webhook"
      n: "webhook"
      r: false
      sh: "The webhook that this failure event is associated with."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "webhook_failure_event"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "oauth_client_id"
                orig: "oauth_client_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST failuresForOauthWebhooks"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "query WebhookFailureEventList($oauthClientId: String!) { failuresForOauthWebhooks(oauthClientId: $oauthClientId) { ...WebhookFailureEventFields } } fragment WebhookFailureEventFields on WebhookFailureEvent { createdAt executionId httpStatus id responseOrError url webhook { id } }"
            field: "failuresForOauthWebhooks"
            optype: "query"
            vars: [
              {
                from: "oauthClientId"
                gqltype: "String!"
                name: "oauthClientId"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "failuresForOauthWebhooks"
          select: {
            exist: [
              "oauth_client_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.failuresForOauthWebhooks`"
          }
        }
      ]
    }
  }



}