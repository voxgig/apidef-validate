# Entity: webhook_failure_event

main: kit: entity: webhook_failure_event: {

  alias: field: {}

  fields: [
    {
      name: "createdAt"
      req: true
      short: "The time at which the entity was created."
      type: "`$ANY`"
    }
    {
      name: "executionId"
      req: true
      short: "A stable identifier for the webhook delivery attempt."
      type: "`$STRING`"
    }
    {
      name: "httpStatus"
      req: false
      short: "The HTTP status code returned by the webhook recipient."
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the entity."
      type: "`$STRING`"
    }
    {
      name: "responseOrError"
      req: false
      short: "The HTTP response body returned by the recipient, or the error message if the request failed before receiving a response."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "The URL that the webhook was trying to push to."
      type: "`$STRING`"
    }
    {
      name: "webhook"
      req: false
      short: "The webhook that this failure event is associated with."
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "webhook_failure_event"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "oauth_client_id"
                orig: "oauth_client_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          graphql: {
            doc: "query WebhookFailureEventList($oauthClientId: String!) { failuresForOauthWebhooks(oauthClientId: $oauthClientId) { ...WebhookFailureEventFields } } fragment WebhookFailureEventFields on WebhookFailureEvent { createdAt executionId httpStatus id responseOrError url webhook { id } }"
            field: "failuresForOauthWebhooks"
            optype: "query"
            vars: [
              {
                from: "oauthClientId"
                gqltype: "String!"
                name: "oauthClientId"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "failuresForOauthWebhooks"
          select: {
            exist: [
              "oauth_client_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.failuresForOauthWebhooks`"
          }
        }
      ]
    }
  }



}