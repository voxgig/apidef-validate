                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST userSettingsUpdate"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"String!\",\"name\":\"id\",\"reqd\":true,\"type\":\"String\"},{\"gqltype\":\"UserSettingsUpdateInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"UserSettingsUpdateInput\"}],\"deprecated\":false,\"desc\":\"Updates the authenticated user's settings, including notification preferences, email subscriptions, theme, and other UI preferences.\",\"gqltype\":\"UserSettingsPayload!\",\"list\":false,\"name\":\"userSettingsUpdate\",\"reqd\":true,\"type\":\"UserSettingsPayload\"},\"invocation\":{\"doc\":\"mutation UserSettingUpdate($id: String!, $input: UserSettingsUpdateInput!) { userSettingsUpdate(id: $id, input: $input) { userSettings { ...UserSettingFields } success } } fragment UserSettingFields on UserSettings { archivedAt autoAssignToSelf calendarHash createdAt feedLastSeenTime feedSummarySchedule id showFullUserNames subscribedToChangelog subscribedToDPA subscribedToInviteAccepted subscribedToPrivacyLegalUpdates updatedAt user { id } }\",\"field\":\"userSettingsUpdate\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"id\",\"gqltype\":\"String!\",\"name\":\"id\"},{\"from\":\"\",\"gqltype\":\"UserSettingsUpdateInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"DateTime\":{\"desc\":\"Represents a date and time in ISO 8601 format. Accepts shortcuts like `2021` to represent midnight Fri Jan 01 2021. Also accepts ISO 8601 durations strings which are added to the current date to create the represented date (e.g '-P2W1D' represents the date that was two weeks and 1 day ago)\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"DateTime\"},\"FeedSummarySchedule\":{\"desc\":\"Cadence to generate feed summary\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"FeedSummarySchedule\",\"values\":[\"daily\",\"never\",\"weekly\"]},\"JSONObject\":{\"desc\":\"The `JSONObject` scalar type represents arbitrary values as *embedded* JSON\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"JSONObject\"},\"NotificationCategoryPreferencesInput\":{\"fields\":{\"appsAndIntegrations\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about apps and integrations.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"appsAndIntegrations\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"assignments\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about assignments.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"assignments\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"billing\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for billing notifications.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"billing\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"commentsAndReplies\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about comments and replies.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"commentsAndReplies\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"customers\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about customers.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"customers\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"documentChanges\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about document changes.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"documentChanges\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"feed\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about feed summaries.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"feed\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"loops\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about loops.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"loops\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"mentions\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about mentions.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"mentions\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"postsAndUpdates\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about posts and updates.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"postsAndUpdates\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"reactions\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about reactions.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"reactions\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"reminders\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about reminders.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"reminders\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"reviews\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about reviews.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"reviews\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"statusChanges\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about status changes.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"statusChanges\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"subscriptions\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about subscriptions.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"subscriptions\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"triage\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferences for notifications about triage.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"triage\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"NotificationCategoryPreferencesInput\"},\"NotificationDeliveryPreferencesChannelInput\":{\"fields\":{\"schedule\":{\"args\":[],\"deprecated\":false,\"desc\":\"The schedule for notifications on this channel.\",\"gqltype\":\"NotificationDeliveryPreferencesScheduleInput\",\"list\":false,\"name\":\"schedule\",\"reqd\":false,\"type\":\"NotificationDeliveryPreferencesScheduleInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"NotificationDeliveryPreferencesChannelInput\"},\"NotificationDeliveryPreferencesDayInput\":{\"fields\":{\"end\":{\"args\":[],\"deprecated\":false,\"desc\":\"The end time of the notification delivery window in HH:MM military time format (e.g., '18:00'). Must be later than 'start'.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"end\",\"reqd\":false,\"type\":\"String\"},\"start\":{\"args\":[],\"deprecated\":false,\"desc\":\"The start time of the notification delivery window in HH:MM military time format (e.g., '09:00'). Must be earlier than 'end'.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"start\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"NotificationDeliveryPreferencesDayInput\"},\"NotificationDeliveryPreferencesInput\":{\"fields\":{\"mobile\":{\"args\":[],\"deprecated\":false,\"desc\":\"The delivery preferences for the mobile channel.\",\"gqltype\":\"NotificationDeliveryPreferencesChannelInput\",\"list\":false,\"name\":\"mobile\",\"reqd\":false,\"type\":\"NotificationDeliveryPreferencesChannelInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"NotificationDeliveryPreferencesInput\"},\"NotificationDeliveryPreferencesScheduleInput\":{\"fields\":{\"disabled\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether the entire delivery schedule is disabled. When true, notifications are delivered at any time regardless of the per-day settings.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"disabled\",\"reqd\":false,\"type\":\"Boolean\"},\"friday\":{\"args\":[],\"deprecated\":false,\"desc\":\"Delivery preferences for Friday.\",\"gqltype\":\"NotificationDeliveryPreferencesDayInput!\",\"list\":false,\"name\":\"friday\",\"reqd\":true,\"type\":\"NotificationDeliveryPreferencesDayInput\"},\"monday\":{\"args\":[],\"deprecated\":false,\"desc\":\"Delivery preferences for Monday.\",\"gqltype\":\"NotificationDeliveryPreferencesDayInput!\",\"list\":false,\"name\":\"monday\",\"reqd\":true,\"type\":\"NotificationDeliveryPreferencesDayInput\"},\"saturday\":{\"args\":[],\"deprecated\":false,\"desc\":\"Delivery preferences for Saturday.\",\"gqltype\":\"NotificationDeliveryPreferencesDayInput!\",\"list\":false,\"name\":\"saturday\",\"reqd\":true,\"type\":\"NotificationDeliveryPreferencesDayInput\"},\"sunday\":{\"args\":[],\"deprecated\":false,\"desc\":\"Delivery preferences for Sunday.\",\"gqltype\":\"NotificationDeliveryPreferencesDayInput!\",\"list\":false,\"name\":\"sunday\",\"reqd\":true,\"type\":\"NotificationDeliveryPreferencesDayInput\"},\"thursday\":{\"args\":[],\"deprecated\":false,\"desc\":\"Delivery preferences for Thursday.\",\"gqltype\":\"NotificationDeliveryPreferencesDayInput!\",\"list\":false,\"name\":\"thursday\",\"reqd\":true,\"type\":\"NotificationDeliveryPreferencesDayInput\"},\"tuesday\":{\"args\":[],\"deprecated\":false,\"desc\":\"Delivery preferences for Tuesday.\",\"gqltype\":\"NotificationDeliveryPreferencesDayInput!\",\"list\":false,\"name\":\"tuesday\",\"reqd\":true,\"type\":\"NotificationDeliveryPreferencesDayInput\"},\"wednesday\":{\"args\":[],\"deprecated\":false,\"desc\":\"Delivery preferences for Wednesday.\",\"gqltype\":\"NotificationDeliveryPreferencesDayInput!\",\"list\":false,\"name\":\"wednesday\",\"reqd\":true,\"type\":\"NotificationDeliveryPreferencesDayInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"NotificationDeliveryPreferencesScheduleInput\"},\"PartialNotificationChannelPreferencesInput\":{\"fields\":{\"desktop\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether notifications are currently enabled for desktop.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"desktop\",\"reqd\":false,\"type\":\"Boolean\"},\"email\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether notifications are currently enabled for email.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"email\",\"reqd\":false,\"type\":\"Boolean\"},\"mobile\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether notifications are currently enabled for mobile.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"mobile\",\"reqd\":false,\"type\":\"Boolean\"},\"slack\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether notifications are currently enabled for Slack.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"slack\",\"reqd\":false,\"type\":\"Boolean\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"PartialNotificationChannelPreferencesInput\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"},\"UserSettingsUpdateInput\":{\"fields\":{\"feedLastSeenTime\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] The user's last seen time for the pulse feed.\",\"gqltype\":\"DateTime\",\"list\":false,\"name\":\"feedLastSeenTime\",\"reqd\":false,\"type\":\"DateTime\"},\"feedSummarySchedule\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] How often to generate a feed summary.\",\"gqltype\":\"FeedSummarySchedule\",\"list\":false,\"name\":\"feedSummarySchedule\",\"reqd\":false,\"type\":\"FeedSummarySchedule\"},\"notificationCategoryPreferences\":{\"args\":[],\"deprecated\":false,\"desc\":\"The user's notification category preferences.\",\"gqltype\":\"NotificationCategoryPreferencesInput\",\"list\":false,\"name\":\"notificationCategoryPreferences\",\"reqd\":false,\"type\":\"NotificationCategoryPreferencesInput\"},\"notificationChannelPreferences\":{\"args\":[],\"deprecated\":false,\"desc\":\"The user's notification channel preferences.\",\"gqltype\":\"PartialNotificationChannelPreferencesInput\",\"list\":false,\"name\":\"notificationChannelPreferences\",\"reqd\":false,\"type\":\"PartialNotificationChannelPreferencesInput\"},\"notificationDeliveryPreferences\":{\"args\":[],\"deprecated\":false,\"desc\":\"The user's notification delivery preferences.\",\"gqltype\":\"NotificationDeliveryPreferencesInput\",\"list\":false,\"name\":\"notificationDeliveryPreferences\",\"reqd\":false,\"type\":\"NotificationDeliveryPreferencesInput\"},\"settings\":{\"args\":[],\"deprecated\":false,\"desc\":\"The user's settings. Merged key by key into the existing settings: keys missing from the object are left unchanged, and a key set to null is removed.\",\"gqltype\":\"JSONObject\",\"list\":false,\"name\":\"settings\",\"reqd\":false,\"type\":\"JSONObject\"},\"subscribedToChangelog\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether this user is subscribed to changelog email or not.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"subscribedToChangelog\",\"reqd\":false,\"type\":\"Boolean\"},\"subscribedToDPA\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether this user is subscribed to DPA emails or not.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"subscribedToDPA\",\"reqd\":false,\"type\":\"Boolean\"},\"subscribedToGeneralMarketingCommunications\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether this user is subscribed to general marketing communications or not.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"subscribedToGeneralMarketingCommunications\",\"reqd\":false,\"type\":\"Boolean\"},\"subscribedToInviteAccepted\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether this user is subscribed to invite accepted emails or not.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"subscribedToInviteAccepted\",\"reqd\":false,\"type\":\"Boolean\"},\"subscribedToPrivacyLegalUpdates\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether this user is subscribed to privacy and legal update emails or not.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"subscribedToPrivacyLegalUpdates\",\"reqd\":false,\"type\":\"Boolean\"},\"usageWarningHistory\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] The user's usage warning history.\",\"gqltype\":\"JSONObject\",\"list\":false,\"name\":\"usageWarningHistory\",\"reqd\":false,\"type\":\"JSONObject\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"UserSettingsUpdateInput\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
