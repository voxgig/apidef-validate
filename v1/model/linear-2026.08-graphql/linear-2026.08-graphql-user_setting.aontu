# Entity: user_setting

main: kit: entity: user_setting: {

  alias: field: {}

  fields: [
    {
      name: "archivedAt"
      req: false
      short: "The time at which the entity was archived."
      type: "`$ANY`"
    }
    {
      name: "autoAssignToSelf"
      req: true
      short: "Whether to auto-assign newly created issues to the current user by default."
      type: "`$BOOLEAN`"
    }
    {
      name: "calendarHash"
      req: false
      short: "A unique hash for the user, used to construct secure calendar subscription URLs."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the entity was created."
      type: "`$ANY`"
    }
    {
      name: "feedLastSeenTime"
      req: false
      short: "The user's last seen time for the pulse feed."
      type: "`$ANY`"
    }
    {
      name: "feedSummarySchedule"
      req: false
      short: "The user's preferred schedule for receiving feed summary digests."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the entity."
      type: "`$STRING`"
    }
    {
      name: "showFullUserNames"
      req: true
      short: "Whether to show full user names instead of display names."
      type: "`$BOOLEAN`"
    }
    {
      name: "subscribedToChangelog"
      req: true
      short: "Whether this user is subscribed to receive changelog emails about Linear product updates."
      type: "`$BOOLEAN`"
    }
    {
      name: "subscribedToDPA"
      req: true
      short: "Whether this user is subscribed to receive Data Processing Agreement (DPA) related emails."
      type: "`$BOOLEAN`"
    }
    {
      name: "subscribedToInviteAccepted"
      req: true
      short: "Whether this user is subscribed to receive email notifications when their workspace invitations are accepted."
      type: "`$BOOLEAN`"
    }
    {
      name: "subscribedToPrivacyLegalUpdates"
      req: true
      short: "Whether this user is subscribed to receive emails about privacy policy and legal updates."
      type: "`$BOOLEAN`"
    }
    {
      name: "updatedAt"
      req: true
      short: "The last time at which the entity was meaningfully updated."
      type: "`$ANY`"
    }
    {
      name: "user"
      req: false
      short: "The user that these settings belong to."
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "user_setting"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "category"
                orig: "category"
                reqd: true
                type: "`$ANY`"
              }
              {
                kind: "param"
                name: "channel"
                orig: "channel"
                reqd: true
                type: "`$ANY`"
              }
              {
                kind: "param"
                name: "subscribe"
                orig: "subscribe"
                reqd: true
                type: "`$BOOLEAN`"
              }
            ]
          }
          graphql: {
            doc: "mutation UserSettingCreateNotificationCategoryChannelSubscriptionUpdate($category: NotificationCategory!, $channel: NotificationChannel!, $subscribe: Boolean!) { notificationCategoryChannelSubscriptionUpdate(category: $category, channel: $channel, subscribe: $subscribe) { userSettings { ...UserSettingFields } success } } fragment UserSettingFields on UserSettings { archivedAt autoAssignToSelf calendarHash createdAt feedLastSeenTime feedSummarySchedule id showFullUserNames subscribedToChangelog subscribedToDPA subscribedToInviteAccepted subscribedToPrivacyLegalUpdates updatedAt user { id } }"
            field: "notificationCategoryChannelSubscriptionUpdate"
            optype: "mutation"
            vars: [
              {
                from: "category"
                gqltype: "NotificationCategory!"
                name: "category"
              }
              {
                from: "channel"
                gqltype: "NotificationChannel!"
                name: "channel"
              }
              {
                from: "subscribe"
                gqltype: "Boolean!"
                name: "subscribe"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "notificationCategoryChannelSubscriptionUpdate"
          select: {
            "$action": "notification_category_channel_subscription_update"
            exist: [
              "category"
              "channel"
              "subscribe"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.notificationCategoryChannelSubscriptionUpdate.userSettings`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          graphql: {
            doc: "query UserSettingLoad { userSettings { ...UserSettingFields } } fragment UserSettingFields on UserSettings { archivedAt autoAssignToSelf calendarHash createdAt feedLastSeenTime feedSummarySchedule id showFullUserNames subscribedToChangelog subscribedToDPA subscribedToInviteAccepted subscribedToPrivacyLegalUpdates updatedAt user { id } }"
            field: "userSettings"
            optype: "query"
          }
          kind: "graphql"
          method: "POST"
          orig: "userSettings"
          transform: {
            req: "`reqdata`"
            res: "`body.data.userSettings`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          graphql: {
            doc: "mutation UserSettingUpdate($id: String!, $input: UserSettingsUpdateInput!) { userSettingsUpdate(id: $id, input: $input) { userSettings { ...UserSettingFields } success } } fragment UserSettingFields on UserSettings { archivedAt autoAssignToSelf calendarHash createdAt feedLastSeenTime feedSummarySchedule id showFullUserNames subscribedToChangelog subscribedToDPA subscribedToInviteAccepted subscribedToPrivacyLegalUpdates updatedAt user { id } }"
            field: "userSettingsUpdate"
            optype: "mutation"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
              {
                from: ""
                gqltype: "UserSettingsUpdateInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "userSettingsUpdate"
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.userSettingsUpdate.userSettings`"
          }
        }
      ]
    }
  }



}