# Entity: diff

main: kit: entity: diff: {

  alias: field: {}

  fields: {
    additions: {
      h: "Additions"
      n: "additions"
      r: true
      sh: "[Internal] The total number of added lines across the diff."
      t: "`$NUMBER`"
    }
    agentSession: {
      h: "Agent Session"
      n: "agentSession"
      r: false
      sh: "The agent session the diff belongs to."
      t: "`$OBJECT`"
    }
    archivedAt: {
      h: "Archived At"
      n: "archivedAt"
      r: false
      sh: "The time at which the entity was archived."
      t: "`$ANY`"
    }
    contentHash: {
      h: "Content Hash"
      n: "contentHash"
      r: true
      sh: "[Internal] The opaque content hash identifying the diff's content in code.storage."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "The time at which the entity was created."
      t: "`$ANY`"
    }
    creator: {
      h: "Creator"
      n: "creator"
      r: false
      sh: "The user responsible for the diff."
      t: "`$OBJECT`"
    }
    deletions: {
      h: "Deletions"
      n: "deletions"
      r: true
      sh: "[Internal] The total number of deleted lines across the diff."
      t: "`$NUMBER`"
    }
    fileCount: {
      h: "File Count"
      n: "fileCount"
      r: true
      sh: "[Internal] The number of changed files in the diff."
      t: "`$NUMBER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The unique identifier of the entity."
      t: "`$STRING`"
    }
    organization: {
      h: "Organization"
      n: "organization"
      r: false
      sh: "The workspace the diff belongs to."
      t: "`$OBJECT`"
    }
    pullRequest: {
      h: "Pull Request"
      n: "pullRequest"
      r: false
      sh: "The pull request the diff was promoted to when opened for review."
      t: "`$OBJECT`"
    }
    slugId: {
      h: "Slug Id"
      n: "slugId"
      r: true
      sh: "[Internal] The diff's unique URL slug."
      t: "`$STRING`"
    }
    truncated: {
      h: "Truncated"
      n: "truncated"
      r: true
      sh: "[Internal] Whether oversized files were omitted when the diff was computed."
      t: "`$BOOLEAN`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "The last time at which the entity was meaningfully updated."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "diff"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST diff"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query DiffLoad($id: String!) { diff(id: $id) { ...DiffFields } } fragment DiffFields on Diff { additions agentSession { id } archivedAt contentHash createdAt creator { id } deletions fileCount id organization { id } pullRequest { id } slugId truncated updatedAt }"
            field: "diff"
            optype: "query"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "diff"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.diff`"
          }
        }
      ]
    }
  }



}