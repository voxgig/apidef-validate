      h: "Actor Initials"
      n: "actorInitials"
      r: false
      sh: "[Internal] Notification actor initials if avatar is not available."
      t: "`$STRING`"
    }
    archivedAt: {
      h: "Archived At"
      n: "archivedAt"
      r: false
      sh: "The time at which the entity was archived."
      t: "`$ANY`"
    }
