# Entity: notification

main: kit: entity: notification: {

  alias: field: {}

  fields: {
    actor: {
      h: "Actor"
      n: "actor"
      r: false
      sh: "The user that caused the notification."
      t: "`$OBJECT`"
    }
    actorAvatarColor: {
      h: "Actor Avatar Color"
      n: "actorAvatarColor"
      r: true
      sh: "[Internal] Notification actor initials if avatar is not available."
      t: "`$STRING`"
    }
    actorAvatarUrl: {
      h: "Actor Avatar Url"
      n: "actorAvatarUrl"
      r: false
      sh: "[Internal] Notification avatar URL."
      t: "`$STRING`"
    }
