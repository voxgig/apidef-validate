    }
    groupingKey: {
      h: "Grouping Key"
      n: "groupingKey"
      r: true
      sh: "[Internal] Notifications with the same grouping key will be grouped together in the UI."
      t: "`$STRING`"
    }
    groupingPriority: {
      h: "Grouping Priority"
      n: "groupingPriority"
      r: true
      sh: "[Internal] Priority of the notification with the same grouping key."
      t: "`$NUMBER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The unique identifier of the entity."
      t: "`$STRING`"
    }
    inboxUrl: {
      h: "Inbox Url"
      n: "inboxUrl"
