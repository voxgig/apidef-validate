# Entity: access_key_release

main: kit: entity: access_key_release: {

  alias: field: {}

  fields: [
    {
      name: "archivedAt"
      req: false
      short: "The time at which the release was archived."
      type: "`$ANY`"
    }
    {
      name: "commitSha"
      req: false
      short: "The Git commit SHA associated with the release."
      type: "`$STRING`"
    }
    {
      name: "completedAt"
      req: false
      short: "The time at which the release was completed."
      type: "`$ANY`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the release was created."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the release."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The name of the release."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "The URL to the release page in the Linear app."
      type: "`$STRING`"
    }
    {
      name: "version"
      req: false
      short: "The version identifier for this release."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "access_key_release"
