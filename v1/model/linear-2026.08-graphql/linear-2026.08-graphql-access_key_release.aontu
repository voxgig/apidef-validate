      name: "create"
      points: [
        {
          contract: {
            id: "POST releaseCompleteByAccessKey"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"ReleaseCompleteInputBase!\",\"name\":\"input\",\"reqd\":true,\"type\":\"ReleaseCompleteInputBase\"}],\"deprecated\":false,\"desc\":\"Marks a release as completed using an access key. If version is provided, completes that specific release; otherwise completes the most recent started release. The pipeline is inferred from the access key.\",\"gqltype\":\"AccessKeyReleasePayload!\",\"list\":false,\"name\":\"releaseCompleteByAccessKey\",\"reqd\":true,\"type\":\"AccessKeyReleasePayload\"},\"invocation\":{\"doc\":\"mutation AccessKeyReleaseCreateReleaseCompleteByAccessKey($input: ReleaseCompleteInputBase!) { releaseCompleteByAccessKey(input: $input) { release { ...AccessKeyReleaseFields } success } } fragment AccessKeyReleaseFields on AccessKeyRelease { archivedAt commitSha completedAt createdAt id name url version }\",\"field\":\"releaseCompleteByAccessKey\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"ReleaseCompleteInputBase!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"ReleaseCompleteInputBase\":{\"desc\":\"Base input for completing a release. Contains the optional version and commit SHA. The pipeline ID is provided separately or inferred from the access key.\",\"fields\":{\"commitSha\":{\"args\":[],\"deprecated\":false,\"desc\":\"The commit SHA to store when moving a release to completed. With a version, an existing SHA is preserved. Without a version, this SHA replaces the started release's SHA and is used to detect retries.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"commitSha\",\"reqd\":false,\"type\":\"String\"},\"documents\":{\"args\":[],\"deprecated\":false,\"desc\":\"Documents to attach to the completed release. Existing documents with the same title are updated.\",\"gqltype\":\"[ReleaseDocumentInput!]\",\"list\":true,\"name\":\"documents\",\"reqd\":false,\"type\":\"ReleaseDocumentInput\"},\"links\":{\"args\":[],\"deprecated\":false,\"desc\":\"External links to attach to the completed release.\",\"gqltype\":\"[ReleaseLinkInput!]\",\"list\":true,\"name\":\"links\",\"reqd\":false,\"type\":\"ReleaseLinkInput\"},\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"Optional release name to apply when completing the release.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"name\",\"reqd\":false,\"type\":\"String\"},\"releaseNotes\":{\"args\":[],\"deprecated\":false,\"desc\":\"Release notes covering the completed release.\",\"gqltype\":\"ReleaseNoteInput\",\"list\":false,\"name\":\"releaseNotes\",\"reqd\":false,\"type\":\"ReleaseNoteInput\"},\"version\":{\"args\":[],\"deprecated\":false,\"desc\":\"The version of the release to complete. If not provided, the latest started release will be completed.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"version\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"ReleaseCompleteInputBase\"},\"ReleaseDocumentInput\":{\"desc\":\"A document to attach to the release. Existing documents on the release with the same title are updated in place. Bad rows (empty title, oversized title/body) are skipped with a warning rather than failing the release command.\",\"fields\":{\"content\":{\"args\":[],\"deprecated\":false,\"desc\":\"The document body as markdown.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"content\",\"reqd\":true,\"type\":\"String\"},\"title\":{\"args\":[],\"deprecated\":false,\"desc\":\"The title of the document. Used to match existing documents on the release for upsert.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"title\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"ReleaseDocumentInput\"},\"ReleaseLinkInput\":{\"desc\":\"An external link to attach to the release.\",\"fields\":{\"label\":{\"args\":[],\"deprecated\":false,\"desc\":\"Optional label for the link. If omitted, the API derives one from the URL.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"label\",\"reqd\":false,\"type\":\"String\"},\"url\":{\"args\":[],\"deprecated\":false,\"desc\":\"The URL of the link.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"url\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"ReleaseLinkInput\"},\"ReleaseNoteInput\":{\"desc\":\"Release notes to attach to the release. Upserts the existing release notes that cover only this release. Bad input (empty title, oversized title/body) is skipped with a warning rather than failing the release command.\",\"fields\":{\"content\":{\"args\":[],\"deprecated\":false,\"desc\":\"The release notes body as markdown.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"content\",\"reqd\":true,\"type\":\"String\"},\"title\":{\"args\":[],\"deprecated\":false,\"desc\":\"Optional title. If omitted, the UI derives one from the release range.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"title\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"ReleaseNoteInput\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
            doc: "mutation AccessKeyReleaseCreateReleaseCompleteByAccessKey($input: ReleaseCompleteInputBase!) { releaseCompleteByAccessKey(input: $input) { release { ...AccessKeyReleaseFields } success } } fragment AccessKeyReleaseFields on AccessKeyRelease { archivedAt commitSha completedAt createdAt id name url version }"
