            "$action": "release_complete_by_access_key"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.releaseCompleteByAccessKey.release`"
          }
        }
        {
          contract: {
            id: "POST releaseSyncByAccessKey"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"ReleaseSyncInputBase!\",\"name\":\"input\",\"reqd\":true,\"type\":\"ReleaseSyncInputBase\"}],\"deprecated\":false,\"desc\":\"Syncs release data using an access key for CI/CD integration. The pipeline is automatically inferred from the access key's configured resources, so no pipeline ID is needed in the input.\",\"gqltype\":\"AccessKeyReleasePayload!\",\"list\":false,\"name\":\"releaseSyncByAccessKey\",\"reqd\":true,\"type\":\"AccessKeyReleasePayload\"},\"invocation\":{\"doc\":\"mutation AccessKeyReleaseCreateReleaseSyncByAccessKey($input: ReleaseSyncInputBase!) { releaseSyncByAccessKey(input: $input) { release { ...AccessKeyReleaseFields } success } } fragment AccessKeyReleaseFields on AccessKeyRelease { archivedAt commitSha completedAt createdAt id name url version }\",\"field\":\"releaseSyncByAccessKey\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"ReleaseSyncInputBase!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"Int\":{\"desc\":\"The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Int\"},\"IssueReferenceInput\":{\"desc\":\"A reference to an issue discovered during release sync, linking the issue identifier to the commit SHA where the reference was found.\",\"fields\":{\"commitSha\":{\"args\":[],\"deprecated\":false,\"desc\":\"The commit SHA where this issue reference was found.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"commitSha\",\"reqd\":true,\"type\":\"String\"},\"identifier\":{\"args\":[],\"deprecated\":false,\"desc\":\"The issue identifier (e.g. ENG-123).\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"identifier\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"IssueReferenceInput\"},\"JSONObject\":{\"desc\":\"The `JSONObject` scalar type represents arbitrary values as *embedded* JSON\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"JSONObject\"},\"PullRequestReferenceInput\":{\"desc\":\"A reference to a pull request by its repository owner, name, and pull request number. Used during release sync to look up pull requests and associate their linked issues with the release.\",\"fields\":{\"number\":{\"args\":[],\"deprecated\":false,\"desc\":\"The pull request number.\",\"gqltype\":\"Int!\",\"list\":false,\"name\":\"number\",\"reqd\":true,\"type\":\"Int\"},\"repositoryName\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the repository.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"repositoryName\",\"reqd\":true,\"type\":\"String\"},\"repositoryOwner\":{\"args\":[],\"deprecated\":false,\"desc\":\"The owner of the repository (e.g., organization or user name).\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"repositoryOwner\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"PullRequestReferenceInput\"},\"ReleaseDebugSinkInput\":{\"desc\":\"Diagnostic data captured during release sync, including inspected commits, discovered issue references, and pull request metadata. Stored on the release for debugging release association issues.\",\"fields\":{\"includePaths\":{\"args\":[],\"deprecated\":false,\"desc\":\"List of paths applied during commit scanning.\",\"gqltype\":\"[String!]\",\"list\":true,\"name\":\"includePaths\",\"reqd\":false,\"type\":\"String\"},\"includeSubjects\":{\"args\":[],\"deprecated\":false,\"desc\":\"Regex used to filter commit subjects during scanning.\",\"gqltype\":\"[String!]\",\"list\":true,\"name\":\"includeSubjects\",\"reqd\":false,\"type\":\"String\"},\"inspectedShas\":{\"args\":[],\"deprecated\":false,\"desc\":\"List of commit SHAs that were inspected.\",\"gqltype\":\"[String!]!\",\"list\":true,\"name\":\"inspectedShas\",\"reqd\":true,\"type\":\"String\"},\"issuePattern\":{\"args\":[],\"deprecated\":false,\"desc\":\"Custom regex used to extract issue identifiers from commit subjects.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"issuePattern\",\"reqd\":false,\"type\":\"String\"},\"issues\":{\"args\":[],\"deprecated\":false,\"desc\":\"Map of issue identifiers to their source information.\",\"gqltype\":\"JSONObject!\",\"list\":false,\"name\":\"issues\",\"reqd\":true,\"type\":\"JSONObject\"},\"pullRequests\":{\"args\":[],\"deprecated\":false,\"desc\":\"Pull request debug information.\",\"gqltype\":\"[JSONObject!]!\",\"list\":true,\"name\":\"pullRequests\",\"reqd\":true,\"type\":\"JSONObject\"},\"revertedIssues\":{\"args\":[],\"deprecated\":false,\"desc\":\"Map of reverted issue identifiers to their source information.\",\"gqltype\":\"JSONObject\",\"list\":false,\"name\":\"revertedIssues\",\"reqd\":false,\"type\":\"JSONObject\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"ReleaseDebugSinkInput\"},\"ReleaseDocumentInput\":{\"desc\":\"A document to attach to the release. Existing documents on the release with the same title are updated in place. Bad rows (empty title, oversized title/body) are skipped with a warning rather than failing the release command.\",\"fields\":{\"content\":{\"args\":[],\"deprecated\":false,\"desc\":\"The document body as markdown.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"content\",\"reqd\":true,\"type\":\"String\"},\"title\":{\"args\":[],\"deprecated\":false,\"desc\":\"The title of the document. Used to match existing documents on the release for upsert.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"title\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"ReleaseDocumentInput\"},\"ReleaseLinkInput\":{\"desc\":\"An external link to attach to the release.\",\"fields\":{\"label\":{\"args\":[],\"deprecated\":false,\"desc\":\"Optional label for the link. If omitted, the API derives one from the URL.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"label\",\"reqd\":false,\"type\":\"String\"},\"url\":{\"args\":[],\"deprecated\":false,\"desc\":\"The URL of the link.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"url\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"ReleaseLinkInput\"},\"ReleaseNoteInput\":{\"desc\":\"Release notes to attach to the release. Upserts the existing release notes that cover only this release. Bad input (empty title, oversized title/body) is skipped with a warning rather than failing the release command.\",\"fields\":{\"content\":{\"args\":[],\"deprecated\":false,\"desc\":\"The release notes body as markdown.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"content\",\"reqd\":true,\"type\":\"String\"},\"title\":{\"args\":[],\"deprecated\":false,\"desc\":\"Optional title. If omitted, the UI derives one from the release range.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"title\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"ReleaseNoteInput\"},\"ReleaseSyncInputBase\":{\"desc\":\"Base input for syncing release data, containing the commit SHA, issue references, pull request references, and optional metadata. Does not include the pipeline ID, which is provided separately or inferred from the access key.\",\"fields\":{\"commitSha\":{\"args\":[],\"deprecated\":false,\"desc\":\"The commit SHA associated with this release.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"commitSha\",\"reqd\":true,\"type\":\"String\"},\"debugSink\":{\"args\":[],\"deprecated\":false,\"desc\":\"Debug information for release creation diagnostics.\",\"gqltype\":\"ReleaseDebugSinkInput\",\"list\":false,\"name\":\"debugSink\",\"reqd\":false,\"type\":\"ReleaseDebugSinkInput\"},\"documents\":{\"args\":[],\"deprecated\":false,\"desc\":\"Documents to attach to the release. Existing documents on the release with the same title are updated.\",\"gqltype\":\"[ReleaseDocumentInput!]\",\"list\":true,\"name\":\"documents\",\"reqd\":false,\"type\":\"ReleaseDocumentInput\"},\"issueReferences\":{\"args\":[],\"deprecated\":false,\"desc\":\"Issue references (e.g. ENG-123) to associate with this release.\",\"gqltype\":\"[IssueReferenceInput!]\",\"list\":true,\"name\":\"issueReferences\",\"reqd\":false,\"type\":\"IssueReferenceInput\"},\"links\":{\"args\":[],\"deprecated\":false,\"desc\":\"External links to attach to the release.\",\"gqltype\":\"[ReleaseLinkInput!]\",\"list\":true,\"name\":\"links\",\"reqd\":false,\"type\":\"ReleaseLinkInput\"},\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the release.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"name\",\"reqd\":false,\"type\":\"String\"},\"pullRequestReferences\":{\"args\":[],\"deprecated\":false,\"desc\":\"Pull request references to look up. Issues linked to found PRs will be associated with this release.\",\"gqltype\":\"[PullRequestReferenceInput!]\",\"list\":true,\"name\":\"pullRequestReferences\",\"reqd\":false,\"type\":\"PullRequestReferenceInput\"},\"releaseNotes\":{\"args\":[],\"deprecated\":false,\"desc\":\"Release notes covering this release. Upserts the existing release notes that cover only this release.\",\"gqltype\":\"ReleaseNoteInput\",\"list\":false,\"name\":\"releaseNotes\",\"reqd\":false,\"type\":\"ReleaseNoteInput\"},\"repository\":{\"args\":[],\"deprecated\":false,\"desc\":\"Information about the source repository.\",\"gqltype\":\"RepositoryDataInput\",\"list\":false,\"name\":\"repository\",\"reqd\":false,\"type\":\"RepositoryDataInput\"},\"revertedIssueReferences\":{\"args\":[],\"deprecated\":false,\"desc\":\"Issue references that were reverted and should be removed from the release.\",\"gqltype\":\"[IssueReferenceInput!]\",\"list\":true,\"name\":\"revertedIssueReferences\",\"reqd\":false,\"type\":\"IssueReferenceInput\"},\"version\":{\"args\":[],\"deprecated\":false,\"desc\":\"The version of the release.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"version\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"ReleaseSyncInputBase\"},\"RepositoryDataInput\":{\"desc\":\"Metadata about the source code repository from which a release is being synced, including the hosting provider and repository coordinates.\",\"fields\":{\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the repository.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"name\",\"reqd\":true,\"type\":\"String\"},\"owner\":{\"args\":[],\"deprecated\":false,\"desc\":\"The owner of the repository (e.g., organization or user name).\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"owner\",\"reqd\":true,\"type\":\"String\"},\"provider\":{\"args\":[],\"deprecated\":false,\"desc\":\"The VCS provider hosting the repository (e.g., 'github', 'gitlab', 'bitbucket').\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"provider\",\"reqd\":true,\"type\":\"String\"},\"url\":{\"args\":[],\"deprecated\":false,\"desc\":\"The base URL of the repository on the hosting provider (e.g., 'https://github.com/linear/linear-app').\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"url\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"RepositoryDataInput\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
