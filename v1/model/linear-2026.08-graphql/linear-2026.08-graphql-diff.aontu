# Entity: diff

main: kit: entity: diff: {

  alias: field: {}

  fields: [
    {
      name: "additions"
      req: true
      short: "[Internal] The total number of added lines across the diff."
      type: "`$NUMBER`"
    }
    {
      name: "agentSession"
      req: false
      short: "The agent session the diff belongs to."
      type: "`$OBJECT`"
    }
    {
      name: "archivedAt"
      req: false
      short: "The time at which the entity was archived."
      type: "`$ANY`"
    }
    {
      name: "contentHash"
      req: true
      short: "[Internal] The opaque content hash identifying the diff's content in code.storage."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the entity was created."
      type: "`$ANY`"
    }
    {
      name: "creator"
      req: false
      short: "The user responsible for the diff."
      type: "`$OBJECT`"
    }
    {
      name: "deletions"
      req: true
      short: "[Internal] The total number of deleted lines across the diff."
      type: "`$NUMBER`"
    }
    {
      name: "fileCount"
      req: true
      short: "[Internal] The number of changed files in the diff."
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the entity."
      type: "`$STRING`"
    }
    {
      name: "organization"
      req: false
      short: "The workspace the diff belongs to."
      type: "`$OBJECT`"
    }
    {
      name: "pullRequest"
      req: false
      short: "The pull request the diff was promoted to when opened for review."
      type: "`$OBJECT`"
    }
    {
      name: "slugId"
      req: true
      short: "[Internal] The diff's unique URL slug."
      type: "`$STRING`"
    }
    {
      name: "truncated"
      req: true
      short: "[Internal] Whether oversized files were omitted when the diff was computed."
      type: "`$BOOLEAN`"
    }
    {
      name: "updatedAt"
      req: true
      short: "The last time at which the entity was meaningfully updated."
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "diff"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          graphql: {
            doc: "query DiffLoad($id: String!) { diff(id: $id) { ...DiffFields } } fragment DiffFields on Diff { additions agentSession { id } archivedAt contentHash createdAt creator { id } deletions fileCount id organization { id } pullRequest { id } slugId truncated updatedAt }"
            field: "diff"
            optype: "query"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "diff"
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.diff`"
          }
        }
      ]
    }
  }



}