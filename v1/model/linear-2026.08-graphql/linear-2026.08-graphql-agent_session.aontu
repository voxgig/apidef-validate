# Entity: agent_session

main: kit: entity: agent_session: {

  alias: field: {}

  fields: [
    {
      name: "appUser"
      req: false
      short: "The agent user that is associated with this agent session."
      type: "`$OBJECT`"
    }
    {
      name: "archivedAt"
      req: false
      short: "The time at which the entity was archived."
      type: "`$ANY`"
    }
    {
      name: "codingHarnessModelLabel"
      req: false
      short: "[Internal] Compact display label for the coding harness model used by this session, derived from the latest associated sandbox."
      type: "`$STRING`"
    }
    {
      name: "comment"
      req: false
      short: "The comment this agent session is associated with."
      type: "`$OBJECT`"
    }
    {
      name: "context"
      req: true
      short: "The entity contexts this session is related to, such as issues or projects referenced in direct chat sessions."
      type: "`$ANY`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the entity was created."
      type: "`$ANY`"
    }
    {
      name: "creator"
      req: false
      short: "The human user responsible for the agent session."
      type: "`$OBJECT`"
    }
    {
      name: "dismissedAt"
      req: false
      short: "The time a user dismissed this agent session."
      type: "`$ANY`"
    }
    {
      name: "dismissedBy"
      req: false
      short: "The user who dismissed the agent session."
      type: "`$OBJECT`"
    }
    {
      name: "endedAt"
      req: false
      short: "The time the agent session completed."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the entity."
      type: "`$STRING`"
    }
    {
      name: "issue"
      req: false
      short: "The issue this agent session is associated with."
      type: "`$OBJECT`"
    }
    {
      name: "plan"
      req: false
      short: "A dynamically updated plan describing the agent's execution strategy, including steps to be taken and their current status."
      type: "`$ANY`"
    }
    {
      name: "pullRequest"
      req: false
      short: "The pull request this agent session is anchored to, when started from a pull request."
      type: "`$OBJECT`"
    }
    {
      name: "slugId"
      req: true
      short: "The agent session's unique URL slug."
      type: "`$STRING`"
    }
    {
      name: "sourceComment"
      req: false
      short: "The comment that this agent session was spawned from, if from a different thread."
      type: "`$OBJECT`"
    }
    {
      name: "sourceMetadata"
      req: false
      short: "Metadata about the external source that created this agent session."
      type: "`$ANY`"
    }
    {
      name: "startedAt"
      req: false
      short: "The time the agent session transitioned to active status and began work."
      type: "`$ANY`"
    }
    {
      name: "status"
      req: true
      short: "The current status of the agent session, such as pending, active, awaiting input, complete, error, or stale."
      type: "`$STRING`"
    }
    {
      name: "summary"
      req: false
      short: "A human-readable summary of the work performed in this session."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "The last time at which the entity was meaningfully updated."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: false
      short: "The URL to the agent session page in the Linear app."
      type: "`$STRING`"
    }
    {
      name: "workspaceDiff"
      req: false
      short: "[Internal] The coding agent's live working-tree diff metadata (changes not yet pushed to origin), reported by the sandbox."
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
