            ]
          }
          k: "graphql"
          m: "POST"
          o: "agentSessionCreateOnIssue"
          q: {
            "$action": "create_on_issue"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.agentSessionCreateOnIssue.agentSession`"
