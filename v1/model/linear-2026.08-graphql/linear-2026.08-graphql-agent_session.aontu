# Entity: agent_session

main: kit: entity: agent_session: {

  alias: field: {}

  fields: {
    appUser: {
      h: "App User"
      n: "appUser"
      r: false
      sh: "The agent user that is associated with this agent session."
      t: "`$OBJECT`"
    }
    archivedAt: {
      h: "Archived At"
      n: "archivedAt"
      r: false
      sh: "The time at which the entity was archived."
      t: "`$ANY`"
    }
    codingHarnessModelLabel: {
      h: "Coding Harness Model Label"
      n: "codingHarnessModelLabel"
      r: false
      sh: "[Internal] Compact display label for the coding harness model used by this session, derived from the latest associated sandbox."
      t: "`$STRING`"
    }
    comment: {
      h: "Comment"
      n: "comment"
      r: false
      sh: "The comment this agent session is associated with."
      t: "`$OBJECT`"
    }
    context: {
      h: "Context"
      n: "context"
      r: true
      sh: "The entity contexts this session is related to, such as issues or projects referenced in direct chat sessions."
      t: "`$ANY`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "The time at which the entity was created."
      t: "`$ANY`"
    }
    creator: {
      h: "Creator"
      n: "creator"
      r: false
      sh: "The human user responsible for the agent session."
      t: "`$OBJECT`"
    }
    dismissedAt: {
      h: "Dismissed At"
      n: "dismissedAt"
      r: false
      sh: "The time a user dismissed this agent session."
      t: "`$ANY`"
    }
    dismissedBy: {
      h: "Dismissed By"
      n: "dismissedBy"
      r: false
      sh: "The user who dismissed the agent session."
      t: "`$OBJECT`"
    }
    endedAt: {
      h: "Ended At"
      n: "endedAt"
      r: false
      sh: "The time the agent session completed."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The unique identifier of the entity."
      t: "`$STRING`"
    }
    issue: {
      h: "Issue"
      n: "issue"
      r: false
      sh: "The issue this agent session is associated with."
      t: "`$OBJECT`"
    }
    plan: {
      h: "Plan"
      n: "plan"
      r: false
      sh: "A dynamically updated plan describing the agent's execution strategy, including steps to be taken and their current status."
      t: "`$ANY`"
    }
    pullRequest: {
      h: "Pull Request"
      n: "pullRequest"
      r: false
      sh: "The pull request this agent session is anchored to, when started from a pull request."
      t: "`$OBJECT`"
    }
    slugId: {
      h: "Slug Id"
      n: "slugId"
      r: true
      sh: "The agent session's unique URL slug."
      t: "`$STRING`"
    }
    sourceComment: {
      h: "Source Comment"
      n: "sourceComment"
      r: false
      sh: "The comment that this agent session was spawned from, if from a different thread."
      t: "`$OBJECT`"
    }
    sourceMetadata: {
      h: "Source Metadata"
      n: "sourceMetadata"
      r: false
      sh: "Metadata about the external source that created this agent session."
      t: "`$ANY`"
    }
    startedAt: {
      h: "Started At"
      n: "startedAt"
      r: false
      sh: "The time the agent session transitioned to active status and began work."
      t: "`$ANY`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      sh: "The current status of the agent session, such as pending, active, awaiting input, complete, error, or stale."
      t: "`$STRING`"
    }
    summary: {
      h: "Summary"
      n: "summary"
      r: false
      sh: "A human-readable summary of the work performed in this session."
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "The last time at which the entity was meaningfully updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      sh: "The URL to the agent session page in the Linear app."
      t: "`$STRING`"
    }
    workspaceDiff: {
      h: "Workspace Diff"
      n: "workspaceDiff"
      r: false
      sh: "[Internal] The coding agent's live working-tree diff metadata (changes not yet pushed to origin), reported by the sandbox."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "agent_session"
  op: {
