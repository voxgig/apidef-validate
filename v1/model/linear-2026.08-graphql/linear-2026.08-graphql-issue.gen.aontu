      type: "`$ANY`"
    }
    {
      name: "creator"
      req: false
      short: "The user who created the issue."
      type: "`$OBJECT`"
    }
    {
      name: "customerTicketCount"
      req: true
      short: "Returns the number of Attachment resources which are created by customer support ticketing systems (e.g."
      type: "`$INTEGER`"
