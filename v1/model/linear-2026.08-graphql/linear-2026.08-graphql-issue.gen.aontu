    }
    {
      name: "priorityLabel"
      req: true
      short: "Label for the priority."
      type: "`$STRING`"
    }
    {
      name: "prioritySortOrder"
      req: true
      short: "The order of the item in relation to other items in the workspace, when ordered by priority."
      type: "`$NUMBER`"
    }
    {
      name: "project"
      req: false
      short: "The project that the issue is associated with."
      type: "`$OBJECT`"
    }
    {
      name: "projectMilestone"
      req: false
      short: "The project milestone that the issue is associated with."
      type: "`$OBJECT`"
    }
    {
      name: "reactionData"
      req: true
      short: "Emoji reaction summary for the issue, grouped by emoji type."
