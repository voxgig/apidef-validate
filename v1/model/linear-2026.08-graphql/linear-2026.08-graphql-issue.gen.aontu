      req: false
      short: "The date at which the issue is due."
      type: "`$ANY`"
    }
    {
      name: "estimate"
      req: false
      short: "The estimate of the complexity of the issue."
      type: "`$NUMBER`"
    }
    {
      name: "externalUserCreator"
      req: false
      short: "The external user who created the issue."
      type: "`$OBJECT`"
    }
    {
      name: "favorite"
      req: false
      short: "The users favorite associated with this issue."
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the entity."
      type: "`$STRING`"
    }
    {
      name: "identifier"
      req: true
      short: "Issue's human readable identifier (e.g."
      type: "`$STRING`"
    }
    {
      name: "inheritsSharedAccess"
      req: true
      short: "Whether this issue inherits shared access from its parent issue."
      type: "`$BOOLEAN`"
    }
    {
      name: "integrationSourceType"
      req: false
      short: "Integration type that created this issue, if applicable."
      type: "`$STRING`"
    }
    {
      name: "labelIds"
      req: true
      short: "Identifiers of the labels associated with this issue."
      type: "`$STRING`"
    }
    {
      name: "lastAppliedTemplate"
