    }
    {
      name: "addedToCycleAt"
      req: false
      short: "The time at which the issue was added to a cycle."
      type: "`$ANY`"
    }
    {
      name: "addedToProjectAt"
      req: false
      short: "The time at which the issue was added to a project."
      type: "`$ANY`"
    }
    {
      name: "addedToTeamAt"
      req: false
      short: "The time at which the issue was added to a team."
      type: "`$ANY`"
    }
    {
      name: "archivedAt"
      req: false
      short: "The time at which the entity was archived."
      type: "`$ANY`"
    }
    {
      name: "asksExternalUserRequester"
      req: false
      short: "The external user who requested creation of the Asks issue on behalf of the creator."
      type: "`$OBJECT`"
    }
    {
      name: "asksRequester"
      req: false
      short: "The internal user who requested creation of the Asks issue on behalf of the creator."
      type: "`$OBJECT`"
    }
    {
      name: "assignee"
      req: false
      short: "The user to whom the issue is assigned."
      type: "`$OBJECT`"
    }
    {
      name: "autoArchivedAt"
      req: false
      short: "The time at which the issue was automatically archived by the auto pruning process."
      type: "`$ANY`"
    }
    {
      name: "autoClosedAt"
      req: false
      short: "The time at which the issue was automatically closed by the auto pruning process."
      type: "`$ANY`"
    }
    {
      name: "botActor"
      req: false
      short: "The bot that created the issue, if applicable."
      type: "`$OBJECT`"
    }
    {
      name: "branchName"
      req: true
      short: "Suggested branch name for the issue."
      type: "`$STRING`"
    }
    {
      name: "canceledAt"
      req: false
      short: "The time at which the issue was moved into canceled state."
      type: "`$ANY`"
    }
    {
      name: "completedAt"
      req: false
      short: "The time at which the issue was moved into completed state."
