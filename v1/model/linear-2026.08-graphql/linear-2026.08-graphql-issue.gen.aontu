    }
    {
      name: "slaStartedAt"
      req: false
      short: "The time at which the issue's SLA began."
      type: "`$ANY`"
    }
    {
      name: "slaType"
      req: false
      short: "The type of SLA set on the issue."
      type: "`$STRING`"
    }
    {
      name: "snoozedBy"
      req: false
      short: "The user who snoozed the issue."
      type: "`$OBJECT`"
    }
    {
      name: "snoozedUntilAt"
      req: false
      short: "The time until an issue will be snoozed in Triage view."
      type: "`$ANY`"
    }
    {
      name: "sortOrder"
      req: true
      short: "The order of the item in relation to other items in the organization."
      type: "`$NUMBER`"
    }
    {
      name: "sourceComment"
      req: false
      short: "The comment that this issue was created from, when an issue is created from an existing comment."
      type: "`$OBJECT`"
    }
    {
      name: "startedAt"
      req: false
      short: "The time at which the issue was moved into started state."
      type: "`$ANY`"
    }
    {
      name: "startedTriageAt"
      req: false
      short: "The time at which the issue entered triage."
      type: "`$ANY`"
    }
    {
      name: "state"
      req: false
      short: "The workflow state (issue status) that the issue is currently in."
