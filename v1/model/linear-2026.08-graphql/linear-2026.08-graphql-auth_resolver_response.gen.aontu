          kind: "graphql"
          method: "POST"
          orig: "samlTokenUserAccountAuth"
          select: {
            "$action": "saml_token_user_account_auth"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.samlTokenUserAccountAuth`"
          }
