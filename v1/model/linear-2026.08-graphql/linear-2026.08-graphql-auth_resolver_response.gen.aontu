    }
    load: {
      name: "load"
      points: [
        {
          contract: {
            id: "POST availableUsers"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "query AuthResolverResponseLoad { availableUsers { ...AuthResolverResponseFields } } fragment AuthResolverResponseFields on AuthResolverResponse { allowDomainAccess email id lastUsedOrganizationId service }"
            field: "availableUsers"
            optype: "query"
