# Entity: auth_resolver_response

main: kit: entity: auth_resolver_response: {

  alias: field: {}

  fields: {
    allowDomainAccess: {
      h: "Allow Domain Access"
      n: "allowDomainAccess"
      r: false
      sh: "Should the signup flow allow access for the domain."
      t: "`$BOOLEAN`"
    }
    email: {
      h: "Email"
      n: "email"
      r: true
      sh: "Email for the authenticated account."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "User account ID."
      t: "`$STRING`"
    }
    lastUsedOrganizationId: {
      h: "Last Used Organization Id"
      n: "lastUsedOrganizationId"
      r: false
      sh: "ID of the organization last accessed by the user."
      t: "`$STRING`"
    }
    service: {
      h: "Service"
      n: "service"
      r: false
      sh: "The authentication service used for the current session (e.g., google, email, saml)."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "auth_resolver_response"
  op: {
    create: {
