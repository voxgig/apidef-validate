      sh: "The unique identifier of the entity."
      t: "`$STRING`"
    }
    inProgressScopeHistory: {
      h: "In Progress Scope History"
      n: "inProgressScopeHistory"
      r: true
      sh: "The number of in-progress estimation points after each day."
      t: "`$NUMBER`"
    }
    inheritedFrom: {
      h: "Inherited From"
      n: "inheritedFrom"
      r: false
      sh: "The parent cycle this cycle was inherited from."
      t: "`$OBJECT`"
    }
    isActive: {
      h: "Is Active"
      n: "isActive"
      r: true
      sh: "Whether the cycle is currently active."
      t: "`$BOOLEAN`"
    }
    isFuture: {
      h: "Is Future"
      n: "isFuture"
      r: true
      sh: "Whether the cycle has not yet started."
      t: "`$BOOLEAN`"
    }
    isNext: {
      h: "Is Next"
      n: "isNext"
      r: true
      sh: "Whether this cycle is the next upcoming (not yet started) cycle for the team."
      t: "`$BOOLEAN`"
    }
    isPast: {
      h: "Is Past"
      n: "isPast"
      r: true
      sh: "Whether the cycle's end date has passed."
      t: "`$BOOLEAN`"
    }
    isPrevious: {
      h: "Is Previous"
      n: "isPrevious"
      r: true
      sh: "Whether this cycle is the most recently completed cycle for the team."
      t: "`$BOOLEAN`"
    }
    issueCountHistory: {
      h: "Issue Count History"
      n: "issueCountHistory"
      r: true
      sh: "The total number of issues in the cycle after each day."
      t: "`$NUMBER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The custom name of the cycle."
      t: "`$STRING`"
    }
    number: {
      h: "Number"
      n: "number"
      r: true
      sh: "The auto-incrementing number of the cycle, unique within its team."
      t: "`$NUMBER`"
    }
    progress: {
      h: "Progress"
      n: "progress"
      r: true
      sh: "The overall progress of the cycle as a number between 0 and 1."
      t: "`$NUMBER`"
    }
    progressHistory: {
      h: "Progress History"
      n: "progressHistory"
      r: true
