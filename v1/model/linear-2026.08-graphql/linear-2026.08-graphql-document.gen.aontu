# Entity: document

main: kit: entity: document: {

  alias: field: {}

  fields: {
    archivedAt: {
      h: "Archived At"
      n: "archivedAt"
      r: false
      sh: "The time at which the entity was archived."
      t: "`$ANY`"
    }
    color: {
      h: "Color"
      n: "color"
      r: false
      sh: "The hex color of the document icon."
      t: "`$STRING`"
    }
    content: {
      h: "Content"
      n: "content"
      r: false
      sh: "The document's content in markdown format."
      t: "`$STRING`"
    }
    contentState: {
      h: "Content State"
      n: "contentState"
      r: false
      sh: "[Internal] The document's content as a base64-encoded Yjs state update."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "The time at which the entity was created."
      t: "`$ANY`"
    }
    creator: {
      h: "Creator"
      n: "creator"
      r: false
      sh: "The user who created the document."
      t: "`$OBJECT`"
    }
    cycle: {
      h: "Cycle"
      n: "cycle"
      r: false
      sh: "[Internal] The cycle that the document is associated with."
      t: "`$OBJECT`"
    }
    documentContentId: {
      h: "Document Content Id"
      n: "documentContentId"
      r: false
      sh: "The ID of the document content associated with the document."
      t: "`$STRING`"
    }
    hiddenAt: {
      h: "Hidden At"
      n: "hiddenAt"
      r: false
      sh: "The time at which the document was hidden from the default view."
      t: "`$ANY`"
    }
    icon: {
      h: "Icon"
      n: "icon"
      r: false
      sh: "The icon of the document, either a decorative icon type or an emoji string."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The unique identifier of the entity."
      t: "`$STRING`"
    }
    initiative: {
      h: "Initiative"
      n: "initiative"
      r: false
      sh: "The initiative that the document is associated with."
      t: "`$OBJECT`"
    }
    issue: {
      h: "Issue"
      n: "issue"
      r: false
      sh: "The issue that the document is associated with."
      t: "`$OBJECT`"
    }
    lastAppliedTemplate: {
      h: "Last Applied Template"
      n: "lastAppliedTemplate"
      r: false
      sh: "The last template that was applied to this document."
      t: "`$OBJECT`"
    }
    owner: {
      h: "Owner"
      n: "owner"
      r: false
      sh: "The owner of the document."
      t: "`$OBJECT`"
    }
    project: {
      h: "Project"
      n: "project"
      r: false
      sh: "The project that the document is associated with."
      t: "`$OBJECT`"
    }
    release: {
      h: "Release"
      n: "release"
      r: false
      sh: "The release that the document is associated with."
      t: "`$OBJECT`"
    }
    slugId: {
      h: "Slug Id"
      n: "slugId"
      r: true
      sh: "The document's unique URL slug, used to construct human-readable URLs."
      t: "`$STRING`"
    }
    sortOrder: {
      h: "Sort Order"
      n: "sortOrder"
      r: true
      sh: "The sort order of the document in its parent entity's resources list."
      t: "`$NUMBER`"
    }
    summary: {
      h: "Summary"
      n: "summary"
      r: false
      sh: "[Internal] A one-sentence AI-generated summary of the document content."
      t: "`$STRING`"
    }
    team: {
      h: "Team"
      n: "team"
      r: false
      sh: "[Internal] The team that the document is associated with."
      t: "`$OBJECT`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "The title of the document."
      t: "`$STRING`"
    }
    trashed: {
      h: "Trashed"
      n: "trashed"
      r: false
      sh: "A flag that indicates whether the document is in the trash bin."
      t: "`$BOOLEAN`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "The last time at which the entity was meaningfully updated."
      t: "`$ANY`"
    }
    updatedBy: {
      h: "Updated By"
      n: "updatedBy"
      r: false
      sh: "The user who last updated the document."
      t: "`$OBJECT`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The canonical url for the document."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "document"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST documentCreate"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation DocumentCreate($input: DocumentCreateInput!) { documentCreate(input: $input) { document { ...DocumentFields } success } } fragment DocumentFields on Document { archivedAt color content contentState createdAt creator { id } cycle { id } documentContentId hiddenAt icon id initiative { id } issue { id } lastAppliedTemplate { id } owner { id } project { id } release { id } slugId sortOrder summary team { id } title trashed updatedAt updatedBy { id } url }"
            field: "documentCreate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "DocumentCreateInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "documentCreate"
          t: {
            req: "`reqdata`"
            res: "`body.data.documentCreate.document`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "POST documents"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "before"
                or: "before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "first"
                or: "first"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "include_archived"
                or: "include_archived"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "param"
                n: "last"
                or: "last"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "order_by"
                or: "order_by"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          gq: {
            doc: "query DocumentList($after: String, $before: String, $filter: DocumentFilter, $first: Int, $includeArchived: Boolean, $last: Int, $orderBy: PaginationOrderBy, $sort: [DocumentSortInput!]) { documents(after: $after, before: $before, filter: $filter, first: $first, includeArchived: $includeArchived, last: $last, orderBy: $orderBy, sort: $sort) { nodes { ...DocumentFields } pageInfo { endCursor hasNextPage } } } fragment DocumentFields on Document { archivedAt color content contentState createdAt creator { id } cycle { id } documentContentId hiddenAt icon id initiative { id } issue { id } lastAppliedTemplate { id } owner { id } project { id } release { id } slugId sortOrder summary team { id } title trashed updatedAt updatedBy { id } url }"
            field: "documents"
            optype: "query"
            page: {
              cursor: "pageInfo.endCursor"
              more: "pageInfo.hasNextPage"
              nodes: "nodes"
              style: "relay"
            }
            vars: [
              {
                from: "after"
                gqltype: "String"
                name: "after"
              }
              {
                from: "before"
                gqltype: "String"
                name: "before"
              }
              {
                from: "filter"
                gqltype: "DocumentFilter"
                name: "filter"
              }
              {
                from: "first"
                gqltype: "Int"
                name: "first"
              }
              {
                from: "includeArchived"
                gqltype: "Boolean"
                name: "includeArchived"
              }
              {
                from: "last"
                gqltype: "Int"
                name: "last"
              }
              {
                from: "orderBy"
                gqltype: "PaginationOrderBy"
                name: "orderBy"
              }
              {
                from: "sort"
                gqltype: "[DocumentSortInput!]"
                name: "sort"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "documents"
          t: {
            req: "`reqdata`"
            res: "`body.data.documents.nodes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST document"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query DocumentLoad($id: String!) { document(id: $id) { ...DocumentFields } } fragment DocumentFields on Document { archivedAt color content contentState createdAt creator { id } cycle { id } documentContentId hiddenAt icon id initiative { id } issue { id } lastAppliedTemplate { id } owner { id } project { id } release { id } slugId sortOrder summary team { id } title trashed updatedAt updatedBy { id } url }"
            field: "document"
            optype: "query"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "document"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.document`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "POST documentDelete"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "mutation DocumentRemove($id: String!) { documentDelete(id: $id) { entity { ...DocumentFields } success } } fragment DocumentFields on Document { archivedAt color content contentState createdAt creator { id } cycle { id } documentContentId hiddenAt icon id initiative { id } issue { id } lastAppliedTemplate { id } owner { id } project { id } release { id } slugId sortOrder summary team { id } title trashed updatedAt updatedBy { id } url }"
            field: "documentDelete"
            optype: "mutation"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "documentDelete"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.documentDelete.entity`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST documentUnarchive"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "mutation DocumentUpdateUnarchive($id: String!) { documentUnarchive(id: $id) { entity { ...DocumentFields } success } } fragment DocumentFields on Document { archivedAt color content contentState createdAt creator { id } cycle { id } documentContentId hiddenAt icon id initiative { id } issue { id } lastAppliedTemplate { id } owner { id } project { id } release { id } slugId sortOrder summary team { id } title trashed updatedAt updatedBy { id } url }"
            field: "documentUnarchive"
            optype: "mutation"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "documentUnarchive"
          q: {
            "$action": "unarchive"
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.documentUnarchive.entity`"
          }
        }
        {
          co: {
            id: "POST documentUpdate"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "mutation DocumentUpdate($id: String!, $input: DocumentUpdateInput!) { documentUpdate(id: $id, input: $input) { document { ...DocumentFields } success } } fragment DocumentFields on Document { archivedAt color content contentState createdAt creator { id } cycle { id } documentContentId hiddenAt icon id initiative { id } issue { id } lastAppliedTemplate { id } owner { id } project { id } release { id } slugId sortOrder summary team { id } title trashed updatedAt updatedBy { id } url }"
            field: "documentUpdate"
            optype: "mutation"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
              {
                from: ""
                gqltype: "DocumentUpdateInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "documentUpdate"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.documentUpdate.document`"
          }
        }
