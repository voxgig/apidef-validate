aringEnabled\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether issue sharing is enabled for this team.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"issueSharingEnabled\",\"reqd\":false,\"type\":\"Boolean\"},\"key\":{\"args\":[],\"deprecated\":false,\"desc\":\"The key of the team. If not given, the key will be generated based on the name of the team.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"key\",\"reqd\":false,\"type\":\"String\"},\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the team.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"name\",\"reqd\":true,\"type\":\"String\"},\"parentId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The parent team ID.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"parentId\",\"reqd\":false,\"type\":\"String\"},\"private\":{\"args\":[],\"deprecated\":false,\"desc\":\"Internal. Whether the team is private or not.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"private\",\"reqd\":false,\"type\":\"Boolean\"},\"productIntelligenceScope\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] The scope of product intelligence suggestion data for the team.\",\"gqltype\":\"ProductIntelligenceScope\",\"list\":false,\"name\":\"productIntelligenceScope\",\"reqd\":false,\"type\":\"ProductIntelligenceScope\"},\"requirePriorityToLeaveTriage\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether an issue needs to have a priority set before leaving triage.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"requirePriorityToLeaveTriage\",\"reqd\":false,\"type\":\"Boolean\"},\"setIssueSortOrderOnStateChange\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether to move issues to bottom of the column when changing state.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"setIssueSortOrderOnStateChange\",\"reqd\":false,\"type\":\"String\"},\"slackAutoCreateProjectChannel\":{\"args\":[],\"deprecated\":false,\"desc\":\"[Internal] Whether to automatically create a Slack channel when a new project is c