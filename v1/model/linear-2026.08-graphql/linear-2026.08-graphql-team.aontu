    }
    {
      name: "color"
      req: false
      short: "The team's color."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the entity was created."
      type: "`$ANY`"
    }
    {
      name: "currentProgress"
      req: true
      short: "[Internal] The current progress of the team."
      type: "`$ANY`"
    }
    {
      name: "cycleCalenderUrl"
      req: true
      short: "Calendar feed URL (iCal) for cycles."
      type: "`$STRING`"
    }
    {
      name: "cycleCooldownTime"
      req: true
      short: "The cooldown time after each cycle in weeks."
      type: "`$NUMBER`"
    }
    {
      name: "cycleDuration"
      req: true
      short: "The duration of each cycle in weeks."
      type: "`$NUMBER`"
    }
    {
      name: "cycleIssueAutoAssignCompleted"
      req: true
      short: "Auto assign completed issues to current cycle."
      type: "`$BOOLEAN`"
    }
    {
      name: "cycleIssueAutoAssignStarted"
      req: true
      short: "Auto assign started issues to current cycle."
      type: "`$BOOLEAN`"
    }
    {
      name: "cycleLockToActive"
      req: true
      short: "Auto assign issues to current cycle if in active status."
      type: "`$BOOLEAN`"
    }
    {
      name: "cycleStartDay"
      req: true
      short: "The day of the week that a new cycle starts (0 = Sunday, 1 = Monday, ..., 6 = Saturday)."
      type: "`$NUMBER`"
    }
    {
      name: "cyclesEnabled"
      req: true
      short: "Whether the team uses cycles for sprint-style issue management."
      type: "`$BOOLEAN`"
    }
    {
      name: "defaultIssueEstimate"
      req: true
      short: "What to use as a default estimate for unestimated issues."
      type: "`$NUMBER`"
    }
    {
      name: "defaultIssueState"
      req: false
      short: "The default workflow state into which issues are set when they are opened by team members."
      type: "`$OBJECT`"
    }
    {
      name: "defaultProjectTemplate"
      req: false
      short: "The default template to use for new projects created for the team."
      type: "`$OBJECT`"
    }
    {
      name: "defaultTemplateForMembers"
      req: false
      short: "The default template to use for new issues created by members of the team."
      type: "`$OBJECT`"
    }
    {
      name: "defaultTemplateForNonMembers"
      req: false
      short: "The default template to use for new issues created by non-members of the team."
      type: "`$OBJECT`"
    }
    {
      name: "description"
      req: false
      short: "The team's description."
      type: "`$STRING`"
    }
    {
      name: "displayName"
      req: true
      short: "The name of the team including its parent team name if it has one."
      type: "`$STRING`"
    }
    {
      name: "groupIssueHistory"
      req: true
      short: "Whether to group recent issue history entries."
      type: "`$BOOLEAN`"
    }
    {
      name: "icon"
      req: false
      short: "The icon of the team."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the entity."
      type: "`$STRING`"
    }
    {
      name: "inheritIssueEstimation"
      req: true
      short: "Whether the team should inherit its estimation settings from its parent."
      type: "`$BOOLEAN`"
    }
    {
      name: "inheritSlackAutoCreateProjectChannel"
      req: true
      short: "[Internal] Whether the team should inherit its Slack auto-create project channel setting from its parent."
      type: "`$BOOLEAN`"
    }
    {
      name: "inheritWorkflowStatuses"
      req: true
      short: "Whether the team should inherit its workflow statuses from its parent."
      type: "`$BOOLEAN`"
    }
    {
      name: "initiativesEnabled"
      req: true
      short: "[ALPHA] Whether team initiatives are enabled and shown in the team's sidebar."
      type: "`$BOOLEAN`"
    }
    {
      name: "integrationsSettings"
      req: false
      short: "Settings for all integrations associated with that team."
      type: "`$OBJECT`"
    }
    {
      name: "issueCount"
      req: true
      short: "The total number of issues in the team."
