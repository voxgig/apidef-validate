# Entity: team

main: kit: entity: team: {

  alias: field: {}

  fields: [
    {
      name: "activeCycle"
      req: false
      short: "Team's currently active cycle."
      type: "`$OBJECT`"
    }
    {
      name: "aiDiscussionSummariesEnabled"
      req: true
      short: "Whether to enable AI discussion summaries for issues in this team."
      type: "`$BOOLEAN`"
    }
    {
      name: "aiThreadSummariesEnabled"
      req: true
      short: "Whether to enable resolved thread AI summaries."
      type: "`$BOOLEAN`"
    }
    {
      name: "allMembersCanJoin"
      req: false
      short: "Whether all members in the workspace can join the team."
      type: "`$BOOLEAN`"
    }
    {
      name: "archivedAt"
      req: false
      short: "The time at which the entity was archived."
      type: "`$ANY`"
    }
    {
      name: "autoArchivePeriod"
      req: true
      short: "Period after which automatically closed, completed, and duplicate issues are automatically archived in months."
      type: "`$NUMBER`"
    }
    {
      name: "autoCloseChildIssues"
      req: false
      short: "Whether child issues should automatically close when their parent issue is closed"
      type: "`$BOOLEAN`"
    }
    {
      name: "autoCloseParentIssues"
      req: false
      short: "Whether parent issues should automatically close when all child issues are closed"
      type: "`$BOOLEAN`"
    }
    {
      name: "autoClosePeriod"
      req: false
      short: "Period after which issues are automatically closed in months."
      type: "`$NUMBER`"
    }
    {
      name: "autoCloseStateId"
      req: false
      short: "The canceled workflow state which auto closed issues will be set to."
      type: "`$STRING`"
    }
    {
      name: "color"
      req: false
      short: "The team's color."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the entity was created."
      type: "`$ANY`"
    }
    {
      name: "currentProgress"
      req: true
      short: "[Internal] The current progress of the team."
      type: "`$ANY`"
    }
    {
      name: "cycleCalenderUrl"
      req: true
      short: "Calendar feed URL (iCal) for cycles."
      type: "`$STRING`"
    }
    {
      name: "cycleCooldownTime"
      req: true
      short: "The cooldown time after each cycle in weeks."
      type: "`$NUMBER`"
    }
    {
      name: "cycleDuration"
      req: true
      short: "The duration of each cycle in weeks."
      type: "`$NUMBER`"
    }
    {
      name: "cycleIssueAutoAssignCompleted"
      req: true
      short: "Auto assign completed issues to current cycle."
      type: "`$BOOLEAN`"
    }
    {
      name: "cycleIssueAutoAssignStarted"
      req: true
      short: "Auto assign started issues to current cycle."
      type: "`$BOOLEAN`"
    }
    {
      name: "cycleLockToActive"
      req: true
      short: "Auto assign issues to current cycle if in active status."
      type: "`$BOOLEAN`"
    }
    {
      name: "cycleStartDay"
      req: true
      short: "The day of the week that a new cycle starts (0 = Sunday, 1 = Monday, ..., 6 = Saturday)."
      type: "`$NUMBER`"
    }
    {
      name: "cyclesEnabled"
      req: true
      short: "Whether the team uses cycles for sprint-style issue management."
      type: "`$BOOLEAN`"
    }
    {
      name: "defaultIssueEstimate"
      req: true
      short: "What to use as a default estimate for unestimated issues."
      type: "`$NUMBER`"
    }
    {
      name: "defaultIssueState"
      req: false
      short: "The default workflow state into which issues are set when they are opened by team members."
      type: "`$OBJECT`"
    }
    {
      name: "defaultProjectTemplate"
      req: false
      short: "The default template to use for new projects created for the team."
      type: "`$OBJECT`"
    }
    {
      name: "defaultTemplateForMembers"
      req: false
      short: "The default template to use for new issues created by members of the team."
      type: "`$OBJECT`"
    }
    {
      name: "defaultTemplateForNonMembers"
      req: false
      short: "The default template to use for new issues created by non-members of the team."
      type: "`$OBJECT`"
    }
    {
      name: "description"
      req: false
      short: "The team's description."
      type: "`$STRING`"
    }
    {
      name: "displayName"
      req: true
      short: "The name of the team including its parent team name if it has one."
      type: "`$STRING`"
    }
    {
      name: "groupIssueHistory"
      req: true
      short: "Whether to group recent issue history entries."
      type: "`$BOOLEAN`"
    }
    {
      name: "icon"
      req: false
      short: "The icon of the team."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the entity."
      type: "`$STRING`"
    }
    {
      name: "inheritIssueEstimation"
      req: true
      short: "Whether the team should inherit its estimation settings from its parent."
      type: "`$BOOLEAN`"
    }
    {
      name: "inheritSlackAutoCreateProjectChannel"
      req: true
      short: "[Internal] Whether the team should inherit its Slack auto-create project channel setting from its parent."
      type: "`$BOOLEAN`"
    }
    {
      name: "inheritWorkflowStatuses"
      req: true
      short: "Whether the team should inherit its workflow statuses from its parent."
      type: "`$BOOLEAN`"
    }
    {
      name: "initiativesEnabled"
      req: true
      short: "[ALPHA] Whether team initiatives are enabled and shown in the team's sidebar."
      type: "`$BOOLEAN`"
    }
    {
      name: "integrationsSettings"
      req: false
      short: "Settings for all integrations associated with that team."
      type: "`$OBJECT`"
    }
    {
      name: "issueCount"
      req: true
      short: "The total number of issues in the team."
      type: "`$INTEGER`"
    }
    {
      name: "issueEstimationAllowZero"
      req: true
      short: "Whether to allow zeros in issues estimates."
      type: "`$BOOLEAN`"
    }
    {
      name: "issueEstimationExtended"
      req: true
      short: "Whether to add additional points to the estimate scale."
      type: "`$BOOLEAN`"
    }
    {
      name: "issueEstimationType"
      req: true
      short: "The issue estimation type to use."
      type: "`$STRING`"
    }
    {
      name: "joinByDefault"
      req: false
      short: "[Internal] Whether new users should join this team by default."
      type: "`$BOOLEAN`"
    }
    {
      name: "key"
      req: true
      short: "The team's unique key, used as a prefix in issue identifiers (e.g., 'ENG' in 'ENG-123') and in URLs."
      type: "`$STRING`"
    }
    {
      name: "ledInitiativeCount"
      req: true
      short: "The number of initiatives led by this team that would be deleted along with it."
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: true
      short: "The team's name."
      type: "`$STRING`"
    }
    {
      name: "organization"
      req: false
      short: "The workspace that the team belongs to."
      type: "`$OBJECT`"
    }
    {
      name: "parent"
      req: false
      short: "The team's parent team."
      type: "`$OBJECT`"
    }
    {
      name: "progressHistory"
      req: true
      short: "[Internal] The progress history of the team."
      type: "`$ANY`"
    }
    {
      name: "requirePriorityToLeaveTriage"
      req: true
      short: "Whether an issue needs to have a priority set before leaving triage."
      type: "`$BOOLEAN`"
    }
    {
      name: "restrictedBy"
      req: false
      short: "[Internal] For restricted teams, the enclosing private team that forms the visibility boundary."
      type: "`$OBJECT`"
    }
    {
      name: "restrictedById"
      req: false
      short: "[Internal] The identifier of the enclosing private team that forms the visibility boundary for restricted teams."
      type: "`$STRING`"
    }
    {
      name: "retiredAt"
      req: false
      short: "The time at which the team was retired."
      type: "`$ANY`"
    }
    {
      name: "scimGroupName"
      req: false
      short: "The SCIM group name for the team."
      type: "`$STRING`"
    }
    {
      name: "scimManaged"
      req: true
      short: "Whether the team is managed by a SCIM integration."
      type: "`$BOOLEAN`"
    }
    {
      name: "securitySettings"
      req: true
      short: "Security settings for the team, including role-based restrictions for issue sharing, label management, member management, template management, and agent skills."
