# Entity: email_intake_address

main: kit: entity: email_intake_address: {

  alias: field: {}

  fields: [
    {
      name: "address"
      req: true
      short: "The unique local part (before the @) of the intake email address, used to route incoming emails to the correct intake handler."
      type: "`$STRING`"
    }
    {
      name: "archivedAt"
      req: false
      short: "The time at which the entity was archived."
      type: "`$ANY`"
    }
    {
      name: "createdAt"
      req: true
      short: "The time at which the entity was created."
      type: "`$ANY`"
    }
    {
      name: "creator"
      req: false
      short: "The user who created the email intake address."
      type: "`$OBJECT`"
    }
    {
      name: "customerRequestsEnabled"
      req: true
      short: "Whether issues created from emails sent to this address are automatically converted into customer requests, linking the sender as a customer contact."
      type: "`$BOOLEAN`"
    }
    {
      name: "enabled"
      req: true
      short: "Whether the email address is enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "forwardingEmailAddress"
      req: false
      short: "The email address used to forward emails to the intake address."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the entity."
      type: "`$STRING`"
    }
    {
      name: "issueCanceledAutoReply"
      req: false
      short: "The auto-reply message for issue canceled."
      type: "`$STRING`"
    }
    {
      name: "issueCanceledAutoReplyEnabled"
      req: true
      short: "Whether the auto-reply for issue canceled is enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "issueCompletedAutoReply"
      req: false
      short: "The auto-reply message for issue completed."
      type: "`$STRING`"
    }
    {
      name: "issueCompletedAutoReplyEnabled"
      req: true
      short: "Whether the auto-reply for issue completed is enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "issueCreatedAutoReply"
      req: false
      short: "The auto-reply message for issue created."
      type: "`$STRING`"
    }
    {
      name: "issueCreatedAutoReplyEnabled"
      req: true
      short: "Whether the auto-reply for issue created is enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "lastUsedAt"
      req: false
      short: "The last time an inbound email was successfully ingested for this address."
      type: "`$ANY`"
    }
    {
      name: "organization"
      req: false
      short: "The workspace that the email address is associated with."
      type: "`$OBJECT`"
    }
    {
      name: "reopenOnReply"
      req: true
      short: "Whether to reopen completed or canceled issues when a substantive email reply is received."
      type: "`$BOOLEAN`"
    }
    {
      name: "repliesEnabled"
      req: true
      short: "Whether email replies are enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "senderName"
      req: false
      short: "The name to be used for outgoing emails."
      type: "`$STRING`"
    }
    {
      name: "sesDomainIdentity"
      req: false
      short: "The SES domain identity that the email address is associated with."
      type: "`$OBJECT`"
    }
    {
      name: "team"
      req: false
      short: "The team that the email address is associated with."
      type: "`$OBJECT`"
    }
    {
      name: "template"
      req: false
      short: "The template that the email address is associated with."
      type: "`$OBJECT`"
    }
    {
      name: "type"
      req: true
      short: "The type of the email address."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "The last time at which the entity was meaningfully updated."
      type: "`$ANY`"
    }
    {
      name: "useUserNamesInReplies"
      req: true
      short: "Whether the commenter's name is included in the email replies."
      type: "`$BOOLEAN`"
    }
  ]

