            json: "{\"field\":{\"args\":[{\"gqltype\":\"TemplateCreateInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"TemplateCreateInput\"}],\"deprecated\":false,\"desc\":\"Creates a new template.\",\"gqltype\":\"TemplatePayload!\",\"list\":false,\"name\":\"templateCreate\",\"reqd\":true,\"type\":\"TemplatePayload\"},\"invocation\":{\"doc\":\"mutation TemplateCreate($input: TemplateCreateInput!) { templateCreate(input: $input) { template { ...TemplateFields } success } } fragment TemplateFields on Template { archivedAt color createdAt creator { id } description hasFormFields icon id inheritedFrom { id } lastAppliedAt lastUpdatedBy { id } name organization { id } pipeline { id } sortOrder team { id } templateData type updatedAt }\",\"field\":\"templateCreate\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"TemplateCreateInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"Float\":{\"desc\":\"The `Float` scalar type represents signed double-precision fractional values as specified by [IEEE 754](https://en.wikipedia.org/wiki/IEEE_floating_point).\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Float\"},\"JSON\":{\"desc\":\"The `JSON` scalar type represents arbitrary values as *stringified* JSON\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"JSON\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"},\"TemplateCreateInput\":{\"desc\":\"Input for creating a new template. A name, type, and template data are required. If no team is specified, the template is shared across the workspace.\",\"fields\":{\"color\":{\"args\":[],\"deprecated\":false,\"desc\":\"The color of the template icon.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"color\",\"reqd\":false,\"type\":\"String\"},\"description\":{\"args\":[],\"deprecated\":false,\"