          contract: {
            id: "POST predictiveSearch"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"Int\",\"name\":\"limit\",\"reqd\":false,\"type\":\"Int\"},{\"gqltype\":\"PredictiveSearchLimitScope\",\"name\":\"limitScope\",\"reqd\":false,\"type\":\"PredictiveSearchLimitScope\"},{\"gqltype\":\"String!\",\"name\":\"query\",\"reqd\":true,\"type\":\"String\"},{\"gqltype\":\"[SearchableField!]\",\"name\":\"searchableFields\",\"reqd\":false,\"type\":\"SearchableField\"},{\"gqltype\":\"[PredictiveSearchType!]\",\"name\":\"types\",\"reqd\":false,\"type\":\"PredictiveSearchType\"},{\"gqltype\":\"SearchUnavailableProductsType\",\"name\":\"unavailableProducts\",\"reqd\":false,\"type\":\"SearchUnavailableProductsType\"}],\"deprecated\":false,\"desc\":\"Returns suggested results as customers type in a search field, enabling type-ahead search experiences. The query matches [products](https://shopify.dev/docs/api/storefront/current/objects/Product), [collections](https://shopify.dev/docs/api/storefront/current/objects/Collection), [pages](https://shopify.dev/docs/api/storefront/current/objects/Page), and [articles](https://shopify.dev/docs/api/storefront/current/objects/Article) based on partial search terms, and also provides [search query suggestions](https://shopify.dev/docs/api/storefront/current/objects/SearchQuerySuggestion) to help customers refine their search.\\n\\nYou can filter results by resource type and limit the quantity. The [`limitScope`](https://shopify.dev/docs/api/storefront/current/queries/predictiveSearch#arguments-limitScope) argument controls whether limits apply across all result types or per type. Use [`unavailableProducts`](https://shopify.dev/docs/api/storefront/current/queries/predictiveSearch#arguments-unavailableProducts) to control how out-of-stock products appear in results.\\n\",\"gqltype\":\"PredictiveSearchResult\",\"list\":false,\"name\":\"predictiveSearch\",\"reqd\":false,\"type\":\"PredictiveSearchResult\"},\"invocation\":{\"doc\":\"query PredictiveSearchResultLoad($limit: Int, $limitScope: PredictiveSearchLimitScope, $query: String!, $searchableFields: [SearchableField!], $types: [PredictiveSearchType!], $unavailableProducts: SearchUnavailableProductsType) { predictiveSearch(limit: $limit, limitScope: $limitScope, query: $query, searchableFields: $searchableFields, types: $types, unavailableProducts: $unavailableProducts) { id } }\",\"field\":\"predictiveSearch\",\"optype\":\"query\",\"vars\":[{\"from\":\"limit\",\"gqltype\":\"Int\",\"name\":\"limit\"},{\"from\":\"limitScope\",\"gqltype\":\"PredictiveSearchLimitScope\",\"name\":\"limitScope\"},{\"from\":\"query\",\"gqltype\":\"String!\",\"name\":\"query\"},{\"from\":\"searchableFields\",\"gqltype\":\"[SearchableField!]\",\"name\":\"searchableFields\"},{\"from\":\"types\",\"gqltype\":\"[PredictiveSearchType!]\",\"name\":\"types\"},{\"from\":\"unavailableProducts\",\"gqltype\":\"SearchUnavailableProductsType\",\"name\":\"unavailableProducts\"}]},\"protocol\":\"graphql\",\"types\":{\"Int\":{\"desc\":\"The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Int\"},\"PredictiveSearchLimitScope\":{\"desc\":\"Decides the distribution of results.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"PredictiveSearchLimitScope\",\"values\":[\"ALL\",\"EACH\"]},\"PredictiveSearchType\":{\"desc\":\"The types of search items to perform predictive search on.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"PredictiveSearchType\",\"values\":[\"ARTICLE\",\"COLLECTION\",\"PAGE\",\"PRODUCT\",\"QUERY\"]},\"SearchUnavailableProductsType\":{\"desc\":\"Specifies whether to display results for unavailable products.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"SearchUnavailableProductsType\",\"values\":[\"HIDE\",\"LAST\",\"SHOW\"]},\"SearchableField\":{\"desc\":\"Specifies the list of resource fields to search.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"SearchableField\",\"values\":[\"AUTHOR\",\"BODY\",\"PRODUCT_TYPE\",\"TAG\",\"TITLE\",\"VARIANTS_BARCODE\",\"VARIANTS_SKU\",\"VARIANTS_TITLE\",\"VENDOR\"]},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
            doc: "query PredictiveSearchResultLoad($limit: Int, $limitScope: PredictiveSearchLimitScope, $query: String!, $searchableFields: [SearchableField!], $types: [PredictiveSearchType!], $unavailableProducts: SearchUnavailableProductsType) { predictiveSearch(limit: $limit, limitScope: $limitScope, query: $query, searchableFields: $searchableFields, types: $types, unavailableProducts: $unavailableProducts) { id } }"
            field: "predictiveSearch"
