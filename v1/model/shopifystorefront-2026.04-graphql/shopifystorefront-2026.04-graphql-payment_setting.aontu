# Entity: payment_setting

main: kit: entity: payment_setting: {

  alias: field: {}

  fields: {
    acceptedCardBrands: {
      h: "Accepted Card Brands"
      n: "acceptedCardBrands"
      r: true
      sh: "List of the card brands which the business entity accepts."
      t: "`$STRING`"
    }
    cardVaultUrl: {
      h: "Card Vault Url"
      n: "cardVaultUrl"
      r: true
      sh: "The url pointing to the endpoint to vault credit cards."
      t: "`$ANY`"
    }
    countryCode: {
      h: "Country Code"
      n: "countryCode"
      r: true
      sh: "The country where the shop is located."
      t: "`$STRING`"
    }
    currencyCode: {
      h: "Currency Code"
      n: "currencyCode"
      r: true
      sh: "The three-letter code for the shop's primary currency."
      t: "`$STRING`"
    }
    enabledPresentmentCurrencies: {
      h: "Enabled Presentment Currencies"
      n: "enabledPresentmentCurrencies"
      r: true
      sh: "A list of enabled currencies (ISO 4217 format) that the shop accepts."
      t: "`$STRING`"
    }
    shopifyPaymentsAccountId: {
      h: "Shopify Payments Account Id"
      n: "shopifyPaymentsAccountId"
      r: false
      sh: "The shop’s Shopify Payments account ID."
      t: "`$STRING`"
    }
    supportedDigitalWallets: {
      h: "Supported Digital Wallets"
      n: "supportedDigitalWallets"
      r: true
      sh: "List of the digital wallets which the business entity supports."
      t: "`$STRING`"
    }
  }

  name: "payment_setting"
  op: {
    load: {
      name: "load"
      points: [
        {
          contract: {
            id: "POST paymentSettings"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "query PaymentSettingLoad { paymentSettings { ...PaymentSettingFields } } fragment PaymentSettingFields on PaymentSettings { acceptedCardBrands cardVaultUrl countryCode currencyCode enabledPresentmentCurrencies shopifyPaymentsAccountId supportedDigitalWallets }"
            field: "paymentSettings"
            optype: "query"
          }
          kind: "graphql"
          method: "POST"
          orig: "paymentSettings"
          transform: {
            req: "`reqdata`"
            res: "`body.data.paymentSettings`"
          }
        }
      ]
    }
  }



}