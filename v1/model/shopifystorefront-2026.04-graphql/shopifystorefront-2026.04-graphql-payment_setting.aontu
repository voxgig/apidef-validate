# Entity: payment_setting

main: kit: entity: payment_setting: {

  alias: field: {}

  fields: [
    {
      name: "acceptedCardBrands"
      req: true
      short: "List of the card brands which the business entity accepts."
      type: "`$STRING`"
    }
    {
      name: "cardVaultUrl"
      req: true
      short: "The url pointing to the endpoint to vault credit cards."
      type: "`$ANY`"
    }
    {
      name: "countryCode"
      req: true
      short: "The country where the shop is located."
      type: "`$STRING`"
    }
    {
      name: "currencyCode"
      req: true
      short: "The three-letter code for the shop's primary currency."
      type: "`$STRING`"
    }
    {
      name: "enabledPresentmentCurrencies"
      req: true
      short: "A list of enabled currencies (ISO 4217 format) that the shop accepts."
      type: "`$STRING`"
    }
    {
      name: "shopifyPaymentsAccountId"
      req: false
      short: "The shop’s Shopify Payments account ID."
      type: "`$STRING`"
    }
    {
      name: "supportedDigitalWallets"
      req: true
      short: "List of the digital wallets which the business entity supports."
      type: "`$STRING`"
    }
  ]

  name: "payment_setting"
  op: {
    load: {
      name: "load"
      points: [
        {
          graphql: {
            doc: "query PaymentSettingLoad { paymentSettings { ...PaymentSettingFields } } fragment PaymentSettingFields on PaymentSettings { acceptedCardBrands cardVaultUrl countryCode currencyCode enabledPresentmentCurrencies shopifyPaymentsAccountId supportedDigitalWallets }"
            field: "paymentSettings"
            optype: "query"
          }
          kind: "graphql"
          method: "POST"
          orig: "paymentSettings"
          transform: {
            req: "`reqdata`"
            res: "`body.data.paymentSettings`"
          }
        }
      ]
    }
  }



}