# Entity: product

main: kit: entity: product: {

  alias: field: {}

  fields: {
    availableForSale: {
      h: "Available For Sale"
      n: "availableForSale"
      r: true
      sh: "Indicates if at least one product variant is available for sale."
      t: "`$BOOLEAN`"
    }
    category: {
      h: "Category"
      n: "category"
      r: false
      sh: "The category of a product from [Shopify's Standard Product Taxonomy](https://shopify.github.io/product-taxonomy/releases/unstable/?categoryId=sg-4-17-2-17)."
      t: "`$OBJECT`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "The date and time when the product was created."
      t: "`$ANY`"
    }
    description: {
      h: "Description"
      n: "description"
      r: true
      sh: "A single-line description of the product, with [HTML tags](https://developer.mozilla.org/en-US/docs/Web/HTML) removed."
      t: "`$STRING`"
    }
    descriptionHtml: {
      h: "Description Html"
      n: "descriptionHtml"
      r: true
      sh: "The description of the product, with HTML tags."
      t: "`$ANY`"
    }
    encodedVariantAvailability: {
      h: "Encoded Variant Availability"
      n: "encodedVariantAvailability"
      r: false
      sh: "An encoded string containing all option value combinations with a corresponding variant that is currently available for sale."
      t: "`$STRING`"
    }
    encodedVariantExistence: {
      h: "Encoded Variant Existence"
      n: "encodedVariantExistence"
      r: false
      sh: "An encoded string containing all option value combinations with a corresponding variant."
      t: "`$STRING`"
    }
    featuredImage: {
      h: "Featured Image"
      n: "featuredImage"
      r: false
      sh: "The featured image for the product."
      t: "`$OBJECT`"
    }
    handle: {
      h: "Handle"
      n: "handle"
      r: true
      sh: "A unique, human-readable string of the product's title."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "A globally-unique ID."
      t: "`$STRING`"
    }
    isGiftCard: {
      h: "Is Gift Card"
      n: "isGiftCard"
      r: true
      sh: "Whether the product is a gift card."
      t: "`$BOOLEAN`"
    }
    onlineStoreUrl: {
      h: "Online Store Url"
      n: "onlineStoreUrl"
      r: false
      sh: "The product's URL on the online store."
      t: "`$ANY`"
    }
    productType: {
      h: "Product Type"
      n: "productType"
      r: true
      sh: "The [product type](https://help.shopify.com/manual/products/details/product-type) that merchants define."
      t: "`$STRING`"
    }
    publishedAt: {
      h: "Published At"
      n: "publishedAt"
      r: true
      sh: "The date and time when the product was published to the channel."
      t: "`$ANY`"
    }
    requiresSellingPlan: {
      h: "Requires Selling Plan"
      n: "requiresSellingPlan"
      r: true
      sh: "Whether the product can only be purchased with a [selling plan](/docs/apps/build/purchase-options/subscriptions/selling-plans)."
      t: "`$BOOLEAN`"
    }
    selectedOrFirstAvailableVariant: {
      h: "Selected Or First Available Variant"
      n: "selectedOrFirstAvailableVariant"
      r: false
      sh: "Find an active product variant based on selected options, availability or the first variant."
      t: "`$OBJECT`"
    }
    tags: {
      h: "Tags"
      n: "tags"
      r: true
      sh: "A comma-separated list of searchable keywords that are associated with the product."
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "The name for the product that displays to customers."
      t: "`$STRING`"
    }
    totalInventory: {
      h: "Total Inventory"
      n: "totalInventory"
      r: false
      sh: "The quantity of inventory that's in stock."
      t: "`$INTEGER`"
    }
    trackingParameters: {
      h: "Tracking Parameters"
      n: "trackingParameters"
      r: false
      sh: "URL parameters to be added to a page URL to track the origin of on-site search traffic for [analytics reporting](https://help.shopify.com/manual/reports-and-analytics/shopify-reports/report-types/default-reports/behaviour-reports)."
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "The date and time when the product was last modified."
      t: "`$ANY`"
    }
    vendor: {
      h: "Vendor"
      n: "vendor"
      r: true
      sh: "The name of the product's vendor."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "product"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "POST productRecommendations"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "intent"
                or: "intent"
                r: false
                t: "`$ANY`"
              }
              {
                k: "param"
                n: "product_handle"
                or: "product_handle"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "product_id"
                or: "product_id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query ProductList($intent: ProductRecommendationIntent, $productHandle: String, $productId: ID) { productRecommendations(intent: $intent, productHandle: $productHandle, productId: $productId) { ...ProductFields } } fragment ProductFields on Product { availableForSale category { id } createdAt description descriptionHtml encodedVariantAvailability encodedVariantExistence featuredImage { id } handle id isGiftCard onlineStoreUrl productType publishedAt requiresSellingPlan selectedOrFirstAvailableVariant { id } tags title totalInventory trackingParameters updatedAt vendor }"
            field: "productRecommendations"
            optype: "query"
            vars: [
              {
                from: "intent"
                gqltype: "ProductRecommendationIntent"
                name: "intent"
              }
              {
                from: "productHandle"
                gqltype: "String"
                name: "productHandle"
              }
              {
                from: "productId"
                gqltype: "ID"
                name: "productId"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "productRecommendations"
          t: {
            req: "`reqdata`"
            res: "`body.data.productRecommendations`"
          }
        }
        {
          co: {
            id: "POST products"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "before"
                or: "before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "first"
                or: "first"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "last"
                or: "last"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "query"
                or: "query"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "reverse"
                or: "reverse"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "param"
                n: "sort_key"
                or: "sort_key"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          gq: {
            doc: "query ProductList($after: String, $before: String, $first: Int, $last: Int, $query: String, $reverse: Boolean, $sortKey: ProductSortKeys) { products(after: $after, before: $before, first: $first, last: $last, query: $query, reverse: $reverse, sortKey: $sortKey) { nodes { ...ProductFields } pageInfo { endCursor hasNextPage } } } fragment ProductFields on Product { availableForSale category { id } createdAt description descriptionHtml encodedVariantAvailability encodedVariantExistence featuredImage { id } handle id isGiftCard onlineStoreUrl productType publishedAt requiresSellingPlan selectedOrFirstAvailableVariant { id } tags title totalInventory trackingParameters updatedAt vendor }"
            field: "products"
            optype: "query"
            page: {
              cursor: "pageInfo.endCursor"
              more: "pageInfo.hasNextPage"
              nodes: "nodes"
              style: "relay"
            }
            vars: [
              {
                from: "after"
                gqltype: "String"
                name: "after"
              }
              {
                from: "before"
                gqltype: "String"
                name: "before"
              }
              {
                from: "first"
                gqltype: "Int"
                name: "first"
              }
              {
                from: "last"
                gqltype: "Int"
                name: "last"
              }
              {
                from: "query"
                gqltype: "String"
                name: "query"
              }
              {
                from: "reverse"
                gqltype: "Boolean"
                name: "reverse"
              }
              {
                from: "sortKey"
                gqltype: "ProductSortKeys"
                name: "sortKey"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "products"
          t: {
            req: "`reqdata`"
            res: "`body.data.products.nodes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST productByHandle"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "handle"
                or: "handle"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query ProductLoad($handle: String!) { productByHandle(handle: $handle) { ...ProductFields } } fragment ProductFields on Product { availableForSale category { id } createdAt description descriptionHtml encodedVariantAvailability encodedVariantExistence featuredImage { id } handle id isGiftCard onlineStoreUrl productType publishedAt requiresSellingPlan selectedOrFirstAvailableVariant { id } tags title totalInventory trackingParameters updatedAt vendor }"
            field: "productByHandle"
            optype: "query"
            vars: [
              {
                from: "handle"
                gqltype: "String!"
                name: "handle"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "productByHandle"
          q: {
            exist: [
              "handle"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.productByHandle`"
          }
        }
        {
          co: {
            id: "POST product"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "handle"
                or: "handle"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "id"
                or: "id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query ProductLoad($handle: String, $id: ID) { product(handle: $handle, id: $id) { ...ProductFields } } fragment ProductFields on Product { availableForSale category { id } createdAt description descriptionHtml encodedVariantAvailability encodedVariantExistence featuredImage { id } handle id isGiftCard onlineStoreUrl productType publishedAt requiresSellingPlan selectedOrFirstAvailableVariant { id } tags title totalInventory trackingParameters updatedAt vendor }"
            field: "product"
            optype: "query"
            vars: [
              {
                from: "handle"
                gqltype: "String"
                name: "handle"
              }
              {
                from: "id"
                gqltype: "ID"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "product"
          t: {
            req: "`reqdata`"
            res: "`body.data.product`"
          }
        }
      ]
    }
  }



}