# Entity: menu

main: kit: entity: menu: {

  alias: field: {}

  fields: {
    handle: {
      h: "Handle"
      n: "handle"
      r: true
      sh: "The menu's handle."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "A globally-unique ID."
      t: "`$STRING`"
    }
    itemsCount: {
      h: "Items Count"
      n: "itemsCount"
      r: true
      sh: "The count of items on the menu."
      t: "`$INTEGER`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "The menu's title."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "menu"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST menu"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "handle"
                or: "handle"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query MenuLoad($handle: String!) { menu(handle: $handle) { ...MenuFields } } fragment MenuFields on Menu { handle id itemsCount title }"
            field: "menu"
            optype: "query"
            vars: [
              {
                from: "handle"
                gqltype: "String!"
                name: "handle"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "menu"
          q: {
            exist: [
              "handle"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.menu`"
          }
        }
      ]
    }
  }



}