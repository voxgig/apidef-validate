# Entity: mailing_address

main: kit: entity: mailing_address: {

  alias: field: {}

  fields: {
    address1: {
      h: "Address1"
      n: "address1"
      r: false
      sh: "The first line of the address."
      t: "`$STRING`"
    }
    address2: {
      h: "Address2"
      n: "address2"
      r: false
      sh: "The second line of the address."
      t: "`$STRING`"
    }
    city: {
      h: "City"
      n: "city"
      r: false
      sh: "The name of the city, district, village, or town."
      t: "`$STRING`"
    }
    company: {
      h: "Company"
      n: "company"
      r: false
      sh: "The name of the customer's company or organization."
      t: "`$STRING`"
    }
    country: {
      h: "Country"
      n: "country"
      r: false
      sh: "The name of the country."
      t: "`$STRING`"
    }
    countryCodeV2: {
      h: "Country Code V2"
      n: "countryCodeV2"
      r: false
      sh: "The two-letter code for the country of the address."
      t: "`$STRING`"
    }
    firstName: {
      h: "First Name"
      n: "firstName"
      r: false
      sh: "The first name of the customer."
      t: "`$STRING`"
    }
    formatted: {
      h: "Formatted"
      n: "formatted"
      r: true
      sh: "A formatted version of the address, customized by the provided arguments."
      t: "`$STRING`"
    }
    formattedArea: {
      h: "Formatted Area"
      n: "formattedArea"
      r: false
      sh: "A comma-separated list of the values for city, province, and country."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "A globally-unique ID."
      t: "`$STRING`"
    }
    lastName: {
      h: "Last Name"
      n: "lastName"
      r: false
      sh: "The last name of the customer."
      t: "`$STRING`"
    }
    latitude: {
      h: "Latitude"
      n: "latitude"
      r: false
      sh: "The latitude coordinate of the customer address."
      t: "`$NUMBER`"
    }
    longitude: {
      h: "Longitude"
      n: "longitude"
      r: false
      sh: "The longitude coordinate of the customer address."
      t: "`$NUMBER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The full name of the customer, based on firstName and lastName."
      t: "`$STRING`"
    }
    phone: {
      h: "Phone"
      n: "phone"
      r: false
      sh: "A unique phone number for the customer."
      t: "`$STRING`"
    }
    province: {
      h: "Province"
      n: "province"
      r: false
      sh: "The region of the address, such as the province, state, or district."
      t: "`$STRING`"
    }
    provinceCode: {
      h: "Province Code"
      n: "provinceCode"
      r: false
      sh: "The alphanumeric code for the region."
      t: "`$STRING`"
    }
    zip: {
      h: "Zip"
      n: "zip"
      r: false
      sh: "The zip or postal code of the address."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "mailing_address"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST customerAddressCreate"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "customer_access_token"
                or: "customer_access_token"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "mutation MailingAddressCreateCustomerAddressCreate($address: MailingAddressInput!, $customerAccessToken: String!) { customerAddressCreate(address: $address, customerAccessToken: $customerAccessToken) { customerAddress { ...MailingAddressFields } } } fragment MailingAddressFields on MailingAddress { address1 address2 city company country countryCodeV2 firstName formatted formattedArea id lastName latitude longitude name phone province provinceCode zip }"
            field: "customerAddressCreate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "MailingAddressInput!"
                name: "address"
              }
              {
                from: "customerAccessToken"
                gqltype: "String!"
                name: "customerAccessToken"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "customerAddressCreate"
          q: {
            "$action": "customer_address_create"
            exist: [
              "customer_access_token"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.customerAddressCreate.customerAddress`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST customerAddressUpdate"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "customer_access_token"
                or: "customer_access_token"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "mutation MailingAddressUpdateCustomerAddressUpdate($address: MailingAddressInput!, $customerAccessToken: String!, $id: ID!) { customerAddressUpdate(address: $address, customerAccessToken: $customerAccessToken, id: $id) { customerAddress { ...MailingAddressFields } } } fragment MailingAddressFields on MailingAddress { address1 address2 city company country countryCodeV2 firstName formatted formattedArea id lastName latitude longitude name phone province provinceCode zip }"
            field: "customerAddressUpdate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "MailingAddressInput!"
                name: "address"
              }
              {
                from: "customerAccessToken"
                gqltype: "String!"
                name: "customerAccessToken"
              }
              {
                from: "id"
                gqltype: "ID!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "customerAddressUpdate"
          q: {
            "$action": "customer_address_update"
            exist: [
              "customer_access_token"
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.customerAddressUpdate.customerAddress`"
          }
        }
      ]
    }
  }



}