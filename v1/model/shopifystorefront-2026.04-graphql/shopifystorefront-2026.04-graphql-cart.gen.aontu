          contract: {
            id: "POST cartBuyerIdentityUpdate"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"CartBuyerIdentityInput!\",\"name\":\"buyerIdentity\",\"reqd\":true,\"type\":\"CartBuyerIdentityInput\"},{\"gqltype\":\"ID!\",\"name\":\"cartId\",\"reqd\":true,\"type\":\"ID\"}],\"deprecated\":false,\"desc\":\"Updates the buyer identity on a [`Cart`](https://shopify.dev/docs/api/storefront/current/objects/Cart), including contact information, location, and checkout preferences. The buyer's country determines [international pricing](https://shopify.dev/docs/storefronts/headless/building-with-the-storefront-api/markets/international-pricing) and should match their shipping address.\\n\\nUse this mutation to associate a logged-in customer via access token, set a B2B company location, or configure checkout preferences like delivery method. Preferences prefill checkout fields but don't sync back to the cart if overwritten at checkout.\\n\",\"gqltype\":\"CartBuyerIdentityUpdatePayload\",\"list\":false,\"name\":\"cartBuyerIdentityUpdate\",\"reqd\":false,\"type\":\"CartBuyerIdentityUpdatePayload\"},\"invocation\":{\"doc\":\"mutation CartUpdateBuyerIdentityUpdate($buyerIdentity: CartBuyerIdentityInput!, $cartId: ID!) { cartBuyerIdentityUpdate(buyerIdentity: $buyerIdentity, cartId: $cartId) { cart { ...CartFields } } } fragment CartFields on Cart { checkoutUrl createdAt id note totalQuantity updatedAt }\",\"field\":\"cartBuyerIdentityUpdate\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"CartBuyerIdentityInput!\",\"name\":\"buyerIdentity\"},{\"from\":\"cartId\",\"gqltype\":\"ID!\",\"name\":\"cartId\"}]},\"protocol\":\"graphql\",\"types\":{\"CartBuyerIdentityInput\":{\"desc\":\"The input fields for identifying the buyer associated with a cart. Buyer identity determines [international pricing](https://shopify.dev/docs/storefronts/headless/building-with-the-storefront-api/markets/international-pricing) and should match the customer's shipping address.\\n\\nUsed by [`cartCreate`](https://shopify.dev/docs/api/storefront/current/mutations/cartCreate) and [`cartBuyerIdentityUpdate`](https://shopify.dev/docs/api/storefront/current/mutations/cartBuyerIdentityUpdate) to set contact information, location, and checkout preferences.\\n\\n> Note:\\n> Preferences prefill fields at checkout but don't sync back to the cart if overwritten.\\n\",\"fields\":{\"companyLocationId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The company location of the buyer that is interacting with the cart.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"companyLocationId\",\"reqd\":false,\"type\":\"ID\"},\"countryCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"The country where the buyer is located.\",\"gqltype\":\"CountryCode\",\"list\":false,\"name\":\"countryCode\",\"reqd\":false,\"type\":\"CountryCode\"},\"customerAccessToken\":{\"args\":[],\"deprecated\":false,\"desc\":\"The access token used to identify the customer associated with the cart.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"customerAccessToken\",\"reqd\":false,\"type\":\"String\"},\"email\":{\"args\":[],\"deprecated\":false,\"desc\":\"The email address of the buyer that is interacting with the cart.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"email\",\"reqd\":false,\"type\":\"String\"},\"phone\":{\"args\":[],\"deprecated\":false,\"desc\":\"The phone number of the buyer that is interacting with the cart.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"phone\",\"reqd\":false,\"type\":\"String\"},\"preferences\":{\"args\":[],\"deprecated\":false,\"desc\":\"A set of preferences tied to the buyer interacting with the cart. Preferences are used to prefill fields in at checkout to streamline information collection.\\nPreferences are not synced back to the cart if they are overwritten.\\n\",\"gqltype\":\"CartPreferencesInput\",\"list\":false,\"name\":\"preferences\",\"reqd\":false,\"type\":\"CartPreferencesInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartBuyerIdentityInput\"},\"CartDeliveryCoordinatesPreferenceInput\":{\"desc\":\"Preferred location used to find the closest pick up point based on coordinates.\",\"fields\":{\"countryCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"The two-letter code for the country of the preferred location.\\n\\nFor example, US.\\n\",\"gqltype\":\"CountryCode!\",\"list\":false,\"name\":\"countryCode\",\"reqd\":true,\"type\":\"CountryCode\"},\"latitude\":{\"args\":[],\"deprecated\":false,\"desc\":\"The geographic latitude for a given location. Coordinates are required in order to set pickUpHandle for pickup points.\",\"gqltype\":\"Float!\",\"list\":false,\"name\":\"latitude\",\"reqd\":true,\"type\":\"Float\"},\"longitude\":{\"args\":[],\"deprecated\":false,\"desc\":\"The geographic longitude for a given location. Coordinates are required in order to set pickUpHandle for pickup points.\",\"gqltype\":\"Float!\",\"list\":false,\"name\":\"longitude\",\"reqd\":true,\"type\":\"Float\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartDeliveryCoordinatesPreferenceInput\"},\"CartDeliveryPreferenceInput\":{\"desc\":\"Delivery preferences can be used to prefill the delivery section at checkout.\",\"fields\":{\"coordinates\":{\"args\":[],\"deprecated\":false,\"desc\":\"The coordinates of a delivery location in order of preference.\",\"gqltype\":\"CartDeliveryCoordinatesPreferenceInput\",\"list\":false,\"name\":\"coordinates\",\"reqd\":false,\"type\":\"CartDeliveryCoordinatesPreferenceInput\"},\"deliveryMethod\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferred delivery methods such as shipping, local pickup or through pickup points.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[PreferenceDeliveryMethodType!]\",\"list\":true,\"name\":\"deliveryMethod\",\"reqd\":false,\"type\":\"PreferenceDeliveryMethodType\"},\"pickupHandle\":{\"args\":[],\"deprecated\":false,\"desc\":\"The pickup handle prefills checkout fields with the location for either local pickup or pickup points delivery methods.\\nIt accepts both location ID for local pickup and external IDs for pickup points.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[String!]\",\"list\":true,\"name\":\"pickupHandle\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartDeliveryPreferenceInput\"},\"CartPreferencesInput\":{\"desc\":\"The input fields represent preferences for the buyer that is interacting with the cart.\",\"fields\":{\"delivery\":{\"args\":[],\"deprecated\":false,\"desc\":\"Delivery preferences can be used to prefill the delivery section in at checkout.\",\"gqltype\":\"CartDeliveryPreferenceInput\",\"list\":false,\"name\":\"delivery\",\"reqd\":false,\"type\":\"CartDeliveryPreferenceInput\"},\"wallet\":{\"args\":[],\"deprecated\":false,\"desc\":\"Wallet preferences are used to populate relevant payment fields in the checkout flow.\\nAccepted value: `[\\\"shop_pay\\\"]`.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[String!]\",\"list\":true,\"name\":\"wallet\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartPreferencesInput\"},\"CountryCode\":{\"desc\":\"The code designating a country/region, which generally follows ISO 3166-1 alpha-2 guidelines.\\nIf a territory doesn't have a country code value in the `CountryCode` enum, then it might be considered a subdivision\\nof another country. For example, the territories associated with Spain are represented by the country code `ES`,\\nand the territories associated with the United States of America are represented by the country code `US`.\\n\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"CountryCode\",\"values\":[\"AC\",\"AD\",\"AE\",\"AF\",\"AG\",\"AI\",\"AL\",\"AM\",\"AN\",\"AO\",\"AR\",\"AT\",\"AU\",\"AW\",\"AX\",\"AZ\",\"BA\",\"BB\",\"BD\",\"BE\",\"BF\",\"BG\",\"BH\",\"BI\",\"BJ\",\"BL\",\"BM\",\"BN\",\"BO\",\"BQ\",\"BR\",\"BS\",\"BT\",\"BV\",\"BW\",\"BY\",\"BZ\",\"CA\",\"CC\",\"CD\",\"CF\",\"CG\",\"CH\",\"CI\",\"CK\",\"CL\",\"CM\",\"CN\",\"CO\",\"CR\",\"CU\",\"CV\",\"CW\",\"CX\",\"CY\",\"CZ\",\"DE\",\"DJ\",\"DK\",\"DM\",\"DO\",\"DZ\",\"EC\",\"EE\",\"EG\",\"EH\",\"ER\",\"ES\",\"ET\",\"FI\",\"FJ\",\"FK\",\"FO\",\"FR\",\"GA\",\"GB\",\"GD\",\"GE\",\"GF\",\"GG\",\"GH\",\"GI\",\"GL\",\"GM\",\"GN\",\"GP\",\"GQ\",\"GR\",\"GS\",\"GT\",\"GW\",\"GY\",\"HK\",\"HM\",\"HN\",\"HR\",\"HT\",\"HU\",\"ID\",\"IE\",\"IL\",\"IM\",\"IN\",\"IO\",\"IQ\",\"IR\",\"IS\",\"IT\",\"JE\",\"JM\",\"JO\",\"JP\",\"KE\",\"KG\",\"KH\",\"KI\",\"KM\",\"KN\",\"KP\",\"KR\",\"KW\",\"KY\",\"KZ\",\"LA\",\"LB\",\"LC\",\"LI\",\"LK\",\"LR\",\"LS\",\"LT\",\"LU\",\"LV\",\"LY\",\"MA\",\"MC\",\"MD\",\"ME\",\"MF\",\"MG\",\"MK\",\"ML\",\"MM\",\"MN\",\"MO\",\"MQ\",\"MR\",\"MS\",\"MT\",\"MU\",\"MV\",\"MW\",\"MX\",\"MY\",\"MZ\",\"NA\",\"NC\",\"NE\",\"NF\",\"NG\",\"NI\",\"NL\",\"NO\",\"NP\",\"NR\",\"NU\",\"NZ\",\"OM\",\"PA\",\"PE\",\"PF\",\"PG\",\"PH\",\"PK\",\"PL\",\"PM\",\"PN\",\"PS\",\"PT\",\"PY\",\"QA\",\"RE\",\"RO\",\"RS\",\"RU\",\"RW\",\"SA\",\"SB\",\"SC\",\"SD\",\"SE\",\"SG\",\"SH\",\"SI\",\"SJ\",\"SK\",\"SL\",\"SM\",\"SN\",\"SO\",\"SR\",\"SS\",\"ST\",\"SV\",\"SX\",\"SY\",\"SZ\",\"TA\",\"TC\",\"TD\",\"TF\",\"TG\",\"TH\",\"TJ\",\"TK\",\"TL\",\"TM\",\"TN\",\"TO\",\"TR\",\"TT\",\"TV\",\"TW\",\"TZ\",\"UA\",\"UG\",\"UM\",\"US\",\"UY\",\"UZ\",\"VA\",\"VC\",\"VE\",\"VG\",\"VN\",\"VU\",\"WF\",\"WS\",\"XK\",\"YE\",\"YT\",\"ZA\",\"ZM\",\"ZW\",\"ZZ\"]},\"Float\":{\"desc\":\"The `Float` scalar type represents signed double-precision fractional values as specified by [IEEE 754](https://en.wikipedia.org/wiki/IEEE_floating_point).\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Float\"},\"ID\":{\"desc\":\"The `ID` scalar type represents a unique identifier, often used to refetch an object or as key for a cache. The ID type appears in a JSON response as a String; however, it is not intended to be human-readable. When expected as an input type, any string (such as `\\\"4\\\"`) or integer (such as `4`) input value will be accepted as an ID.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"ID\"},\"PreferenceDeliveryMethodType\":{\"desc\":\"The preferred delivery methods such as shipping, local pickup or through pickup points.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"PreferenceDeliveryMethodType\",\"values\":[\"PICKUP_POINT\",\"PICK_UP\",\"SHIPPING\"]},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
