# Entity: cart

main: kit: entity: cart: {

  alias: field: {}

  fields: [
    {
      name: "checkoutUrl"
      req: true
      short: "The URL of the checkout for the cart."
      type: "`$ANY`"
    }
    {
      name: "createdAt"
      req: true
      short: "The date and time when the cart was created."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "A globally-unique ID."
      type: "`$STRING`"
    }
    {
      name: "note"
      req: false
      short: "A note that's associated with the cart."
      type: "`$STRING`"
    }
    {
      name: "totalQuantity"
      req: true
      short: "The total number of items in the cart."
      type: "`$INTEGER`"
    }
    {
      name: "updatedAt"
      req: true
      short: "The date and time when the cart was updated."
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "cart"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST cartCreate"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"CartInput\",\"name\":\"input\",\"reqd\":false,\"type\":\"CartInput\"}],\"deprecated\":false,\"desc\":\"Creates a new [`Cart`](https://shopify.dev/docs/api/storefront/current/objects/Cart) for a buyer session. You can optionally initialize the cart with merchandise lines, discount codes, gift card codes, buyer identity for international pricing, and custom attributes.\\n\\nThe returned cart includes a `checkoutUrl` that directs the buyer to complete their purchase.\\n\",\"gqltype\":\"CartCreatePayload\",\"list\":false,\"name\":\"cartCreate\",\"reqd\":false,\"type\":\"CartCreatePayload\"},\"invocation\":{\"doc\":\"mutation CartCreate($input: CartInput) { cartCreate(input: $input) { cart { ...CartFields } } } fragment CartFields on Cart { checkoutUrl createdAt id note totalQuantity updatedAt }\",\"field\":\"cartCreate\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"CartInput\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"AttributeInput\":{\"desc\":\"A custom key-value pair that stores additional information on a [cart](https://shopify.dev/docs/api/storefront/current/objects/Cart) or [cart line](https://shopify.dev/docs/api/storefront/current/objects/CartLine). Attributes capture additional information like gift messages, special instructions, or custom order details. Learn more about [managing carts with the Storefront API](https://shopify.dev/docs/storefronts/headless/building-with-the-storefront-api/cart/manage).\\n\",\"fields\":{\"key\":{\"args\":[],\"deprecated\":false,\"desc\":\"Key or name of the attribute.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"key\",\"reqd\":true,\"type\":\"String\"},\"value\":{\"args\":[],\"deprecated\":false,\"desc\":\"Value of the attribute.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"value\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"AttributeInput\"},\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"CartAddressInput\":{\"desc\":\"Specifies a delivery address for a cart. Provide either a [`deliveryAddress`](https://shopify.dev/docs/api/storefront/current/input-objects/CartAddressInput#fields-deliveryAddress) with full address details, or a [`copyFromCustomerAddressId`](https://shopify.dev/docs/api/storefront/current/input-objects/CartAddressInput#fields-copyFromCustomerAddressId) to copy from an existing customer address. Used by [`CartSelectableAddressInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartSelectableAddressInput) and [`CartSelectableAddressUpdateInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartSelectableAddressUpdateInput).\\n\",\"fields\":{\"copyFromCustomerAddressId\":{\"args\":[],\"deprecated\":false,\"desc\":\"Copies details from the customer address to an address on this cart.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"copyFromCustomerAddressId\",\"reqd\":false,\"type\":\"ID\"},\"deliveryAddress\":{\"args\":[],\"deprecated\":false,\"desc\":\"A delivery address stored on this cart.\",\"gqltype\":\"CartDeliveryAddressInput\",\"list\":false,\"name\":\"deliveryAddress\",\"reqd\":false,\"type\":\"CartDeliveryAddressInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartAddressInput\"},\"CartBuyerIdentityInput\":{\"desc\":\"The input fields for identifying the buyer associated with a cart. Buyer identity determines [international pricing](https://shopify.dev/docs/storefronts/headless/building-with-the-storefront-api/markets/international-pricing) and should match the customer's shipping address.\\n\\nUsed by [`cartCreate`](https://shopify.dev/docs/api/storefront/current/mutations/cartCreate) and [`cartBuyerIdentityUpdate`](https://shopify.dev/docs/api/storefront/current/mutations/cartBuyerIdentityUpdate) to set contact information, location, and checkout preferences.\\n\\n> Note:\\n> Preferences prefill fields at checkout but don't sync back to the cart if overwritten.\\n\",\"fields\":{\"companyLocationId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The company location of the buyer that is interacting with the cart.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"companyLocationId\",\"reqd\":false,\"type\":\"ID\"},\"countryCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"The country where the buyer is located.\",\"gqltype\":\"CountryCode\",\"list\":false,\"name\":\"countryCode\",\"reqd\":false,\"type\":\"CountryCode\"},\"customerAccessToken\":{\"args\":[],\"deprecated\":false,\"desc\":\"The access token used to identify the customer associated with the cart.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"customerAccessToken\",\"reqd\":false,\"type\":\"String\"},\"email\":{\"args\":[],\"deprecated\":false,\"desc\":\"The email address of the buyer that is interacting with the cart.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"email\",\"reqd\":false,\"type\":\"String\"},\"phone\":{\"args\":[],\"deprecated\":false,\"desc\":\"The phone number of the buyer that is interacting with the cart.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"phone\",\"reqd\":false,\"type\":\"String\"},\"preferences\":{\"args\":[],\"deprecated\":false,\"desc\":\"A set of preferences tied to the buyer interacting with the cart. Preferences are used to prefill fields in at checkout to streamline information collection.\\nPreferences are not synced back to the cart if they are overwritten.\\n\",\"gqltype\":\"CartPreferencesInput\",\"list\":false,\"name\":\"preferences\",\"reqd\":false,\"type\":\"CartPreferencesInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartBuyerIdentityInput\"},\"CartDeliveryAddressInput\":{\"desc\":\"The input fields to create or update a cart address.\",\"fields\":{\"address1\":{\"args\":[],\"deprecated\":false,\"desc\":\"The first line of the address. Typically the street address or PO Box number.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"address1\",\"reqd\":false,\"type\":\"String\"},\"address2\":{\"args\":[],\"deprecated\":false,\"desc\":\"The second line of the address. Typically the number of the apartment, suite, or unit.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"address2\",\"reqd\":false,\"type\":\"String\"},\"city\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the city, district, village, or town.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"city\",\"reqd\":false,\"type\":\"String\"},\"company\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the customer's company or organization.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"company\",\"reqd\":false,\"type\":\"String\"},\"countryCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the country.\",\"gqltype\":\"CountryCode\",\"list\":false,\"name\":\"countryCode\",\"reqd\":false,\"type\":\"CountryCode\"},\"firstName\":{\"args\":[],\"deprecated\":false,\"desc\":\"The first name of the customer.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"firstName\",\"reqd\":false,\"type\":\"String\"},\"lastName\":{\"args\":[],\"deprecated\":false,\"desc\":\"The last name of the customer.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"lastName\",\"reqd\":false,\"type\":\"String\"},\"phone\":{\"args\":[],\"deprecated\":false,\"desc\":\"A unique phone number for the customer.\\n\\nFormatted using E.164 standard. For example, _+16135551111_.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"phone\",\"reqd\":false,\"type\":\"String\"},\"provinceCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"The region of the address, such as the province, state, or district.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"provinceCode\",\"reqd\":false,\"type\":\"String\"},\"zip\":{\"args\":[],\"deprecated\":false,\"desc\":\"The zip or postal code of the address.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"zip\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartDeliveryAddressInput\"},\"CartDeliveryCoordinatesPreferenceInput\":{\"desc\":\"Preferred location used to find the closest pick up point based on coordinates.\",\"fields\":{\"countryCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"The two-letter code for the country of the preferred location.\\n\\nFor example, US.\\n\",\"gqltype\":\"CountryCode!\",\"list\":false,\"name\":\"countryCode\",\"reqd\":true,\"type\":\"CountryCode\"},\"latitude\":{\"args\":[],\"deprecated\":false,\"desc\":\"The geographic latitude for a given location. Coordinates are required in order to set pickUpHandle for pickup points.\",\"gqltype\":\"Float!\",\"list\":false,\"name\":\"latitude\",\"reqd\":true,\"type\":\"Float\"},\"longitude\":{\"args\":[],\"deprecated\":false,\"desc\":\"The geographic longitude for a given location. Coordinates are required in order to set pickUpHandle for pickup points.\",\"gqltype\":\"Float!\",\"list\":false,\"name\":\"longitude\",\"reqd\":true,\"type\":\"Float\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartDeliveryCoordinatesPreferenceInput\"},\"CartDeliveryInput\":{\"desc\":\"The input fields for the cart's delivery properties.\",\"fields\":{\"addresses\":{\"args\":[],\"deprecated\":false,\"desc\":\"Selectable addresses to present to the buyer on the cart.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[CartSelectableAddressInput!]\",\"list\":true,\"name\":\"addresses\",\"reqd\":false,\"type\":\"CartSelectableAddressInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartDeliveryInput\"},\"CartDeliveryPreferenceInput\":{\"desc\":\"Delivery preferences can be used to prefill the delivery section at checkout.\",\"fields\":{\"coordinates\":{\"args\":[],\"deprecated\":false,\"desc\":\"The coordinates of a delivery location in order of preference.\",\"gqltype\":\"CartDeliveryCoordinatesPreferenceInput\",\"list\":false,\"name\":\"coordinates\",\"reqd\":false,\"type\":\"CartDeliveryCoordinatesPreferenceInput\"},\"deliveryMethod\":{\"args\":[],\"deprecated\":false,\"desc\":\"The preferred delivery methods such as shipping, local pickup or through pickup points.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[PreferenceDeliveryMethodType!]\",\"list\":true,\"name\":\"deliveryMethod\",\"reqd\":false,\"type\":\"PreferenceDeliveryMethodType\"},\"pickupHandle\":{\"args\":[],\"deprecated\":false,\"desc\":\"The pickup handle prefills checkout fields with the location for either local pickup or pickup points delivery methods.\\nIt accepts both location ID for local pickup and external IDs for pickup points.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[String!]\",\"list\":true,\"name\":\"pickupHandle\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartDeliveryPreferenceInput\"},\"CartInput\":{\"desc\":\"The input fields for creating a [`Cart`](https://shopify.dev/docs/api/storefront/current/objects/Cart). Used by the [`cartCreate`](https://shopify.dev/docs/api/storefront/current/mutations/cartCreate) mutation.\\n\\nAccepts merchandise lines, discount codes, gift card codes, and a note. You can also set custom attributes, metafields, buyer identity for international pricing, and delivery addresses.\\n\",\"fields\":{\"attributes\":{\"args\":[],\"deprecated\":false,\"desc\":\"An array of key-value pairs that contains additional information about the cart.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[AttributeInput!]\",\"list\":true,\"name\":\"attributes\",\"reqd\":false,\"type\":\"AttributeInput\"},\"buyerIdentity\":{\"args\":[],\"deprecated\":false,\"desc\":\"The customer associated with the cart. Used to determine [international pricing]\\n(https://shopify.dev/custom-storefronts/internationalization/international-pricing).\\nBuyer identity should match the customer's shipping address.\\n\",\"gqltype\":\"CartBuyerIdentityInput\",\"list\":false,\"name\":\"buyerIdentity\",\"reqd\":false,\"type\":\"CartBuyerIdentityInput\"},\"delivery\":{\"args\":[],\"deprecated\":false,\"desc\":\"The delivery-related fields for the cart.\",\"gqltype\":\"CartDeliveryInput\",\"list\":false,\"name\":\"delivery\",\"reqd\":false,\"type\":\"CartDeliveryInput\"},\"discountCodes\":{\"args\":[],\"deprecated\":false,\"desc\":\"The case-insensitive discount codes that the customer added at checkout.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[String!]\",\"list\":true,\"name\":\"discountCodes\",\"reqd\":false,\"type\":\"String\"},\"giftCardCodes\":{\"args\":[],\"deprecated\":false,\"desc\":\"The case-insensitive gift card codes.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[String!]\",\"list\":true,\"name\":\"giftCardCodes\",\"reqd\":false,\"type\":\"String\"},\"lines\":{\"args\":[],\"deprecated\":false,\"desc\":\"A list of merchandise lines to add to the cart.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[CartLineInput!]\",\"list\":true,\"name\":\"lines\",\"reqd\":false,\"type\":\"CartLineInput\"},\"metafields\":{\"args\":[],\"deprecated\":false,\"desc\":\"The metafields to associate with this cart.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[CartInputMetafieldInput!]\",\"list\":true,\"name\":\"metafields\",\"reqd\":false,\"type\":\"CartInputMetafieldInput\"},\"note\":{\"args\":[],\"deprecated\":false,\"desc\":\"A note that's associated with the cart. For example, the note can be a personalized message to the buyer.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"note\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartInput\"},\"CartInputMetafieldInput\":{\"desc\":\"The input fields for a cart metafield value to set.\\n\\nCart metafields will be copied to order metafields at order creation time if there is a matching order metafield definition with the [`cart to order copyable`](https://shopify.dev/docs/apps/build/metafields/use-metafield-capabilities#cart-to-order-copyable) capability enabled.\\n\",\"fields\":{\"key\":{\"args\":[],\"deprecated\":false,\"desc\":\"The key name of the metafield.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"key\",\"reqd\":true,\"type\":\"String\"},\"type\":{\"args\":[],\"deprecated\":false,\"desc\":\"The type of data that the cart metafield stores.\\nThe type of data must be a [supported type](https://shopify.dev/apps/metafields/types).\\n\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"type\",\"reqd\":true,\"type\":\"String\"},\"value\":{\"args\":[],\"deprecated\":false,\"desc\":\"The data to store in the cart metafield. The data is always stored as a string, regardless of the metafield's type.\\n\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"value\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartInputMetafieldInput\"},\"CartLineInput\":{\"desc\":\"The input fields for adding a merchandise line to a cart. Each line represents a [`ProductVariant`](https://shopify.dev/docs/api/storefront/current/objects/ProductVariant) the buyer intends to purchase, along with the quantity and optional [`SellingPlan`](https://shopify.dev/docs/api/storefront/current/objects/SellingPlan) for subscriptions.\\n\\nUsed by the [`cartCreate`](https://shopify.dev/docs/api/storefront/current/mutations/cartCreate) mutation when creating a cart with initial items, and the [`cartLinesAdd`](https://shopify.dev/docs/api/storefront/current/mutations/cartLinesAdd) mutation when adding items to an existing cart.\\n\",\"fields\":{\"attributes\":{\"args\":[],\"deprecated\":false,\"desc\":\"An array of key-value pairs that contains additional information about the merchandise line.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[AttributeInput!]\",\"list\":true,\"name\":\"attributes\",\"reqd\":false,\"type\":\"AttributeInput\"},\"merchandiseId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the merchandise that the buyer intends to purchase.\",\"gqltype\":\"ID!\",\"list\":false,\"name\":\"merchandiseId\",\"reqd\":true,\"type\":\"ID\"},\"parent\":{\"args\":[],\"deprecated\":false,\"desc\":\"The parent line item of the cart line.\",\"gqltype\":\"CartLineParentInput\",\"list\":false,\"name\":\"parent\",\"reqd\":false,\"type\":\"CartLineParentInput\"},\"quantity\":{\"args\":[],\"deprecated\":false,\"desc\":\"The quantity of the merchandise.\",\"gqltype\":\"Int\",\"list\":false,\"name\":\"quantity\",\"reqd\":false,\"type\":\"Int\"},\"sellingPlanId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the selling plan that the merchandise is being purchased with.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"sellingPlanId\",\"reqd\":false,\"type\":\"ID\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartLineInput\"},\"CartLineParentInput\":{\"desc\":\"The parent line item of the cart line.\",\"fields\":{\"lineId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The id of the parent line item.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"lineId\",\"reqd\":false,\"type\":\"ID\"},\"merchandiseId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the parent line merchandise.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"merchandiseId\",\"reqd\":false,\"type\":\"ID\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartLineParentInput\"},\"CartPreferencesInput\":{\"desc\":\"The input fields represent preferences for the buyer that is interacting with the cart.\",\"fields\":{\"delivery\":{\"args\":[],\"deprecated\":false,\"desc\":\"Delivery preferences can be used to prefill the delivery section in at checkout.\",\"gqltype\":\"CartDeliveryPreferenceInput\",\"list\":false,\"name\":\"delivery\",\"reqd\":false,\"type\":\"CartDeliveryPreferenceInput\"},\"wallet\":{\"args\":[],\"deprecated\":false,\"desc\":\"Wallet preferences are used to populate relevant payment fields in the checkout flow.\\nAccepted value: `[\\\"shop_pay\\\"]`.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[String!]\",\"list\":true,\"name\":\"wallet\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartPreferencesInput\"},\"CartSelectableAddressInput\":{\"desc\":\"The input fields for a selectable delivery address to present to the buyer. Used by [`CartDeliveryInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartDeliveryInput) when creating a cart with the [`cartCreate`](https://shopify.dev/docs/api/storefront/current/mutations/cartCreate) mutation.\\n\\nYou can pre-select an address for the buyer, mark it as one-time use so it isn't saved after checkout, and specify how strictly the address should be validated.\\n\",\"fields\":{\"address\":{\"args\":[],\"deprecated\":false,\"desc\":\"Exactly one kind of delivery address.\",\"gqltype\":\"CartAddressInput!\",\"list\":false,\"name\":\"address\",\"reqd\":true,\"type\":\"CartAddressInput\"},\"oneTimeUse\":{\"args\":[],\"deprecated\":false,\"desc\":\"When true, this delivery address will not be associated with the buyer after a successful checkout.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"oneTimeUse\",\"reqd\":false,\"type\":\"Boolean\"},\"selected\":{\"args\":[],\"deprecated\":false,\"desc\":\"Sets exactly one address as pre-selected for the buyer.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"selected\",\"reqd\":false,\"type\":\"Boolean\"},\"validationStrategy\":{\"args\":[],\"deprecated\":false,\"desc\":\"Defines what kind of address validation is requested.\",\"gqltype\":\"DeliveryAddressValidationStrategy\",\"list\":false,\"name\":\"validationStrategy\",\"reqd\":false,\"type\":\"DeliveryAddressValidationStrategy\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartSelectableAddressInput\"},\"CountryCode\":{\"desc\":\"The code designating a country/region, which generally follows ISO 3166-1 alpha-2 guidelines.\\nIf a territory doesn't have a country code value in the `CountryCode` enum, then it might be considered a subdivision\\nof another country. For example, the territories associated with Spain are represented by the country code `ES`,\\nand the territories associated with the United States of America are represented by the country code `US`.\\n\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"CountryCode\",\"values\":[\"AC\",\"AD\",\"AE\",\"AF\",\"AG\",\"AI\",\"AL\",\"AM\",\"AN\",\"AO\",\"AR\",\"AT\",\"AU\",\"AW\",\"AX\",\"AZ\",\"BA\",\"BB\",\"BD\",\"BE\",\"BF\",\"BG\",\"BH\",\"BI\",\"BJ\",\"BL\",\"BM\",\"BN\",\"BO\",\"BQ\",\"BR\",\"BS\",\"BT\",\"BV\",\"BW\",\"BY\",\"BZ\",\"CA\",\"CC\",\"CD\",\"CF\",\"CG\",\"CH\",\"CI\",\"CK\",\"CL\",\"CM\",\"CN\",\"CO\",\"CR\",\"CU\",\"CV\",\"CW\",\"CX\",\"CY\",\"CZ\",\"DE\",\"DJ\",\"DK\",\"DM\",\"DO\",\"DZ\",\"EC\",\"EE\",\"EG\",\"EH\",\"ER\",\"ES\",\"ET\",\"FI\",\"FJ\",\"FK\",\"FO\",\"FR\",\"GA\",\"GB\",\"GD\",\"GE\",\"GF\",\"GG\",\"GH\",\"GI\",\"GL\",\"GM\",\"GN\",\"GP\",\"GQ\",\"GR\",\"GS\",\"GT\",\"GW\",\"GY\",\"HK\",\"HM\",\"HN\",\"HR\",\"HT\",\"HU\",\"ID\",\"IE\",\"IL\",\"IM\",\"IN\",\"IO\",\"IQ\",\"IR\",\"IS\",\"IT\",\"JE\",\"JM\",\"JO\",\"JP\",\"KE\",\"KG\",\"KH\",\"KI\",\"KM\",\"KN\",\"KP\",\"KR\",\"KW\",\"KY\",\"KZ\",\"LA\",\"LB\",\"LC\",\"LI\",\"LK\",\"LR\",\"LS\",\"LT\",\"LU\",\"LV\",\"LY\",\"MA\",\"MC\",\"MD\",\"ME\",\"MF\",\"MG\",\"MK\",\"ML\",\"MM\",\"MN\",\"MO\",\"MQ\",\"MR\",\"MS\",\"MT\",\"MU\",\"MV\",\"MW\",\"MX\",\"MY\",\"MZ\",\"NA\",\"NC\",\"NE\",\"NF\",\"NG\",\"NI\",\"NL\",\"NO\",\"NP\",\"NR\",\"NU\",\"NZ\",\"OM\",\"PA\",\"PE\",\"PF\",\"PG\",\"PH\",\"PK\",\"PL\",\"PM\",\"PN\",\"PS\",\"PT\",\"PY\",\"QA\",\"RE\",\"RO\",\"RS\",\"RU\",\"RW\",\"SA\",\"SB\",\"SC\",\"SD\",\"SE\",\"SG\",\"SH\",\"SI\",\"SJ\",\"SK\",\"SL\",\"SM\",\"SN\",\"SO\",\"SR\",\"SS\",\"ST\",\"SV\",\"SX\",\"SY\",\"SZ\",\"TA\",\"TC\",\"TD\",\"TF\",\"TG\",\"TH\",\"TJ\",\"TK\",\"TL\",\"TM\",\"TN\",\"TO\",\"TR\",\"TT\",\"TV\",\"TW\",\"TZ\",\"UA\",\"UG\",\"UM\",\"US\",\"UY\",\"UZ\",\"VA\",\"VC\",\"VE\",\"VG\",\"VN\",\"VU\",\"WF\",\"WS\",\"XK\",\"YE\",\"YT\",\"ZA\",\"ZM\",\"ZW\",\"ZZ\"]},\"DeliveryAddressValidationStrategy\":{\"desc\":\"Controls how delivery addresses are validated during cart operations. The default validation checks only the country code, while strict validation verifies all address fields against Shopify's checkout rules and rejects invalid addresses.\\n\\nUsed by [`DeliveryAddressInput`](https://shopify.dev/docs/api/storefront/current/input-objects/DeliveryAddressInput) when setting buyer identity preferences, and by [`CartSelectableAddressInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartSelectableAddressInput) and [`CartSelectableAddressUpdateInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartSelectableAddressUpdateInput) when managing cart delivery addresses.\\n\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"DeliveryAddressValidationStrategy\",\"values\":[\"COUNTRY_CODE_ONLY\",\"STRICT\"]},\"Float\":{\"desc\":\"The `Float` scalar type represents signed double-precision fractional values as specified by [IEEE 754](https://en.wikipedia.org/wiki/IEEE_floating_point).\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Float\"},\"ID\":{\"desc\":\"The `ID` scalar type represents a unique identifier, often used to refetch an object or as key for a cache. The ID type appears in a JSON response as a String; however, it is not intended to be human-readable. When expected as an input type, any string (such as `\\\"4\\\"`) or integer (such as `4`) input value will be accepted as an ID.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"ID\"},\"Int\":{\"desc\":\"The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Int\"},\"PreferenceDeliveryMethodType\":{\"desc\":\"The preferred delivery methods such as shipping, local pickup or through pickup points.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"PreferenceDeliveryMethodType\",\"values\":[\"PICKUP_POINT\",\"PICK_UP\",\"SHIPPING\"]},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
            doc: "mutation CartCreate($input: CartInput) { cartCreate(input: $input) { cart { ...CartFields } } } fragment CartFields on Cart { checkoutUrl createdAt id note totalQuantity updatedAt }"
            field: "cartCreate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CartInput"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "cartCreate"
          transform: {
            req: "`reqdata`"
            res: "`body.data.cartCreate.cart`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
