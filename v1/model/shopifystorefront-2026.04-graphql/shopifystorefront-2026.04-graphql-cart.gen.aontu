            json: "{\"field\":{\"args\":[{\"gqltype\":\"[CartSelectableAddressUpdateInput!]!\",\"name\":\"addresses\",\"reqd\":true,\"type\":\"CartSelectableAddressUpdateInput\"},{\"gqltype\":\"ID!\",\"name\":\"cartId\",\"reqd\":true,\"type\":\"ID\"}],\"deprecated\":false,\"desc\":\"Updates one or more delivery addresses on a [`Cart`](https://shopify.dev/docs/api/storefront/current/objects/Cart). Each address can be modified to change its details, set it as the pre-selected address for checkout, or mark it for one-time use so it isn't saved to the customer's account.\\n\",\"gqltype\":\"CartDeliveryAddressesUpdatePayload\",\"list\":false,\"name\":\"cartDeliveryAddressesUpdate\",\"reqd\":false,\"type\":\"CartDeliveryAddressesUpdatePayload\"},\"invocation\":{\"doc\":\"mutation CartUpdateDeliveryAddressesUpdate($addresses: [CartSelectableAddressUpdateInput!]!, $cartId: ID!) { cartDeliveryAddressesUpdate(addresses: $addresses, cartId: $cartId) { cart { ...CartFields } } } fragment CartFields on Cart { checkoutUrl createdAt id note totalQuantity updatedAt }\",\"field\":\"cartDeliveryAddressesUpdate\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"[CartSelectableAddressUpdateInput!]!\",\"name\":\"addresses\"},{\"from\":\"cartId\",\"gqltype\":\"ID!\",\"name\":\"cartId\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"CartAddressInput\":{\"desc\":\"Specifies a delivery address for a cart. Provide either a [`deliveryAddress`](https://shopify.dev/docs/api/storefront/current/input-objects/CartAddressInput#fields-deliveryAddress) with full address details, or a [`copyFromCustomerAddressId`](https://shopify.dev/docs/api/storefront/current/input-objects/CartAddressInput#fields-copyFromCustomerAddressId) to copy from an existing customer address. Used by [`CartSelectableAddressInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartSelectableAddressInput) and [`CartSelectableAddressUpdateInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartSelectableAddressUpdateInput).\\n\",\"fields\":{\"copyFromCustomerAddressId\":{\"args\":[],\"deprecated\":false,\"desc\":\"Copies details from the customer address to an address on this cart.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"copyFromCustomerAddressId\",\"reqd\":false,\"type\":\"ID\"},\"deliveryAddress\":{\"args\":[],\"deprecated\":false,\"desc\":\"A delivery address stored on this cart.\",\"gqltype\":\"CartDeliveryAddressInput\",\"list\":false,\"name\":\"deliveryAddress\",\"reqd\":false,\"type\":\"CartDeliveryAddressInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartAddressInput\"},\"CartDeliveryAddressInput\":{\"desc\":\"The input fields to create or update a cart address.\",\"fields\":{\"address1\":{\"args\":[],\"deprecated\":false,\"desc\":\"The first line of the address. Typically the street address or PO Box number.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"address1\",\"reqd\":false,\"type\":\"String\"},\"address2\":{\"args\":[],\"deprecated\":false,\"desc\":\"The second line of the address. Typically the number of the apartment, suite, or unit.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"address2\",\"reqd\":false,\"type\":\"String\"},\"city\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the city, district, village, or town.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"city\",\"reqd\":false,\"type\":\"String\"},\"company\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the customer's company or organization.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"company\",\"reqd\":false,\"type\":\"String\"},\"countryCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the country.\",\"gqltype\":\"CountryCode\",\"list\":false,\"name\":\"countryCode\",\"reqd\":false,\"type\":\"CountryCode\"},\"firstName\":{\"args\":[],\"deprecated\":false,\"desc\":\"The first name of the customer.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"firstName\",\"reqd\":false,\"type\":\"String\"},\"lastName\":{\"args\":[],\"deprecated\":false,\"desc\":\"The last name of the customer.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"lastName\",\"reqd\":false,\"type\":\"String\"},\"phone\":{\"args\":[],\"deprecated\":false,\"desc\":\"A unique phone number for the customer.\\n\\nFormatted using E.164 standard. For example, _+16135551111_.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"phone\",\"reqd\":false,\"type\":\"String\"},\"provinceCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"The region of the address, such as the province, state, or district.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"provinceCode\",\"reqd\":false,\"type\":\"String\"},\"zip\":{\"args\":[],\"deprecated\":false,\"desc\":\"The zip or postal code of the address.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"zip\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartDeliveryAddressInput\"},\"CartSelectableAddressUpdateInput\":{\"desc\":\"The input fields to update a line item on a cart.\",\"fields\":{\"address\":{\"args\":[],\"deprecated\":false,\"desc\":\"Exactly one kind of delivery address.\",\"gqltype\":\"CartAddressInput\",\"list\":false,\"name\":\"address\",\"reqd\":false,\"type\":\"CartAddressInput\"},\"id\":{\"args\":[],\"deprecated\":false,\"desc\":\"The id of the selectable address.\",\"gqltype\":\"ID!\",\"list\":false,\"name\":\"id\",\"reqd\":true,\"type\":\"ID\"},\"oneTimeUse\":{\"args\":[],\"deprecated\":false,\"desc\":\"When true, this delivery address will not be associated with the buyer after a successful checkout.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"oneTimeUse\",\"reqd\":false,\"type\":\"Boolean\"},\"selected\":{\"args\":[],\"deprecated\":false,\"desc\":\"Sets exactly one address as pre-selected for the buyer.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"selected\",\"reqd\":false,\"type\":\"Boolean\"},\"validationStrategy\":{\"args\":[],\"deprecated\":false,\"desc\":\"Defines what kind of address validation is requested.\",\"gqltype\":\"DeliveryAddressValidationStrategy\",\"list\":false,\"name\":\"validationStrategy\",\"reqd\":false,\"type\":\"DeliveryAddressValidationStrategy\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartSelectableAddressUpdateInput\"},\"CountryCode\":{\"desc\":\"The code designating a country/region, which generally follows ISO 3166-1 alpha-2 guidelines.\\nIf a territory doesn't have a country code value in the `CountryCode` enum, then it might be considered a subdivision\\nof another country. For example, the territories associated with Spain are represented by the country code `ES`,\\nand the territories associated with the United States of America are represented by the country code `US`.\\n\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"CountryCode\",\"values\":[\"AC\",\"AD\",\"AE\",\"AF\",\"AG\",\"AI\",\"AL\",\"AM\",\"AN\",\"AO\",\"AR\",\"AT\",\"AU\",\"AW\",\"AX\",\"AZ\",\"BA\",\"BB\",\"BD\",\"BE\",\"BF\",\"BG\",\"BH\",\"BI\",\"BJ\",\"BL\",\"BM\",\"BN\",\"BO\",\"BQ\",\"BR\",\"BS\",\"BT\",\"BV\",\"BW\",\"BY\",\"BZ\",\"CA\",\"CC\",\"CD\",\"CF\",\"CG\",\"CH\",\"CI\",\"CK\",\"CL\",\"CM\",\"CN\",\"CO\",\"CR\",\"CU\",\"CV\",\"CW\",\"CX\",\"CY\",\"CZ\",\"DE\",\"DJ\",\"DK\",\"DM\",\"DO\",\"DZ\",\"EC\",\"EE\",\"EG\",\"EH\",\"ER\",\"ES\",\"ET\",\"FI\",\"FJ\",\"FK\",\"FO\",\"FR\",\"GA\",\"GB\",\"GD\",\"GE\",\"GF\",\"GG\",\"GH\",\"GI\",\"GL\",\"GM\",\"GN\",\"GP\",\"GQ\",\"GR\",\"GS\",\"GT\",\"GW\",\"GY\",\"HK\",\"HM\",\"HN\",\"HR\",\"HT\",\"HU\",\"ID\",\"IE\",\"IL\",\"IM\",\"IN\",\"IO\",\"IQ\",\"IR\",\"IS\",\"IT\",\"JE\",\"JM\",\"JO\",\"JP\",\"KE\",\"KG\",\"KH\",\"KI\",\"KM\",\"KN\",\"KP\",\"KR\",\"KW\",\"KY\",\"KZ\",\"LA\",\"LB\",\"LC\",\"LI\",\"LK\",\"LR\",\"LS\",\"LT\",\"LU\",\"LV\",\"LY\",\"MA\",\"MC\",\"MD\",\"ME\",\"MF\",\"MG\",\"MK\",\"ML\",\"MM\",\"MN\",\"MO\",\"MQ\",\"MR\",\"MS\",\"MT\",\"MU\",\"MV\",\"MW\",\"MX\",\"MY\",\"MZ\",\"NA\",\"NC\",\"NE\",\"NF\",\"NG\",\"NI\",\"NL\",\"NO\",\"NP\",\"NR\",\"NU\",\"NZ\",\"OM\",\"PA\",\"PE\",\"PF\",\"PG\",\"PH\",\"PK\",\"PL\",\"PM\",\"PN\",\"PS\",\"PT\",\"PY\",\"QA\",\"RE\",\"RO\",\"RS\",\"RU\",\"RW\",\"SA\",\"SB\",\"SC\",\"SD\",\"SE\",\"SG\",\"SH\",\"SI\",\"SJ\",\"SK\",\"SL\",\"SM\",\"SN\",\"SO\",\"SR\",\"SS\",\"ST\",\"SV\",\"SX\",\"SY\",\"SZ\",\"TA\",\"TC\",\"TD\",\"TF\",\"TG\",\"TH\",\"TJ\",\"TK\",\"TL\",\"TM\",\"TN\",\"TO\",\"TR\",\"TT\",\"TV\",\"TW\",\"TZ\",\"UA\",\"UG\",\"UM\",\"US\",\"UY\",\"UZ\",\"VA\",\"VC\",\"VE\",\"VG\",\"VN\",\"VU\",\"WF\",\"WS\",\"XK\",\"YE\",\"YT\",\"ZA\",\"ZM\",\"ZW\",\"ZZ\"]},\"DeliveryAddressValidationStrategy\":{\"desc\":\"Controls how delivery addresses are validated during cart operations. The default validation checks only the country code, while strict validation verifies all address fields against Shopify's checkout rules and rejects invalid addresses.\\n\\nUsed by [`DeliveryAddressInput`](https://shopify.dev/docs/api/storefront/current/input-objects/DeliveryAddressInput) when setting buyer identity preferences, and by [`CartSelectableAddressInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartSelectableAddressInput) and [`CartSelectableAddressUpdateInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartSelectableAddressUpdateInput) when managing cart delivery addresses.\\n\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"DeliveryAddressValidationStrategy\",\"values\":[\"COUNTRY_CODE_ONLY\",\"STRICT\"]},\"ID\":{\"desc\":\"The `ID` scalar type represents a unique identifier, often used to refetch an object or as key for a cache. The ID type appears in a JSON response as a String; however, it is not intended to be human-readable. When expected as an input type, any string (such as `\\\"4\\\"`) or integer (such as `4`) input value will be accepted as an ID.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"ID\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
