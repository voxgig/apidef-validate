ing\"},\"countryCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the country.\",\"gqltype\":\"CountryCode\",\"list\":false,\"name\":\"countryCode\",\"reqd\":false,\"type\":\"CountryCode\"},\"firstName\":{\"args\":[],\"deprecated\":false,\"desc\":\"The first name of the customer.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"firstName\",\"reqd\":false,\"type\":\"String\"},\"lastName\":{\"args\":[],\"deprecated\":false,\"desc\":\"The last name of the customer.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"lastName\",\"reqd\":false,\"type\":\"String\"},\"phone\":{\"args\":[],\"deprecated\":false,\"desc\":\"A unique phone number for the customer.\\n\\nFormatted using E.164 standard. For example, _+16135551111_.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"phone\",\"reqd\":false,\"type\":\"String\"},\"provinceCode\":{\"args\":[],\"deprecated\":false,\"desc\":\"The region of the address, such as the province, state, or district.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"provinceCode\",\"reqd\":false,\"type\":\"String\"},\"zip\":{\"args\":[],\"deprecated\":false,\"desc\":\"The zip or postal code of the address.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"zip\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartDeliveryAddressInput\"},\"CartSelectableAddressInput\":{\"desc\":\"The input fields for a selectable delivery address to present to the buyer. Used by [`CartDeliveryInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartDeliveryInput) when creating a cart with the [`cartCreate`](https://shopify.dev/docs/api/storefront/current/mutations/cartCreate) mutation.\\n\\nYou can pre-select an address for the buyer, mark it as one-time use so it isn't saved after checkout, and specify how strictly the address should be validated.\\n\",\"fields\":{\"address\":{\"args\":[],\"deprecated\":false,\"desc\":\"Exactly one kind of delivery address.\",\"gqltype\":\"CartAddressInput!\",\"list\