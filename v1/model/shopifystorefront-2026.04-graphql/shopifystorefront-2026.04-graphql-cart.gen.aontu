            json: "{\"field\":{\"args\":[{\"gqltype\":\"ID!\",\"name\":\"cartId\",\"reqd\":true,\"type\":\"ID\"},{\"gqltype\":\"[CartLineUpdateInput!]!\",\"name\":\"lines\",\"reqd\":true,\"type\":\"CartLineUpdateInput\"}],\"deprecated\":false,\"desc\":\"Updates one or more merchandise lines on a [`Cart`](https://shopify.dev/docs/api/storefront/current/objects/Cart). You can modify the quantity, swap the merchandise, change custom attributes, or update the selling plan for each line. You can update a maximum of 250 lines per request.\\n\\nOmitting the [`attributes`](https://shopify.dev/docs/api/storefront/current/mutations/cartLinesUpdate#arguments-lines.fields.attributes) field or setting it to null preserves existing line attributes. Pass an empty array to clear all attributes from a line.\\n\",\"gqltype\":\"CartLinesUpdatePayload\",\"list\":false,\"name\":\"cartLinesUpdate\",\"reqd\":false,\"type\":\"CartLinesUpdatePayload\"},\"invocation\":{\"doc\":\"mutation CartUpdateLinesUpdate($cartId: ID!, $lines: [CartLineUpdateInput!]!) { cartLinesUpdate(cartId: $cartId, lines: $lines) { cart { ...CartFields } } } fragment CartFields on Cart { checkoutUrl createdAt id note totalQuantity updatedAt }\",\"field\":\"cartLinesUpdate\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"cartId\",\"gqltype\":\"ID!\",\"name\":\"cartId\"},{\"from\":\"\",\"gqltype\":\"[CartLineUpdateInput!]!\",\"name\":\"lines\"}]},\"protocol\":\"graphql\",\"types\":{\"AttributeInput\":{\"desc\":\"A custom key-value pair that stores additional information on a [cart](https://shopify.dev/docs/api/storefront/current/objects/Cart) or [cart line](https://shopify.dev/docs/api/storefront/current/objects/CartLine). Attributes capture additional information like gift messages, special instructions, or custom order details. Learn more about [managing carts with the Storefront API](https://shopify.dev/docs/storefronts/headless/building-with-the-storefront-api/cart/manage).\\n\",\"fields\":{\"key\":{\"args\":[],\"deprecated\":false,\"desc\":\"Key or name of the attribute.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"key\",\"reqd\":true,\"type\":\"String\"},\"value\":{\"args\":[],\"deprecated\":false,\"desc\":\"Value of the attribute.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"value\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"AttributeInput\"},\"CartLineUpdateInput\":{\"desc\":\"The input fields for updating a merchandise line in a cart. Used by the [`cartLinesUpdate`](https://shopify.dev/docs/api/storefront/current/mutations/cartLinesUpdate) mutation.\\n\\nSpecify the line item's [`id`](https://shopify.dev/docs/api/storefront/current/input-objects/CartLineUpdateInput#fields-id) along with any fields to modify. You can change the quantity, swap the merchandise, update custom attributes, or associate a different selling plan.\\n\",\"fields\":{\"attributes\":{\"args\":[],\"deprecated\":false,\"desc\":\"An array of key-value pairs that contains additional information about the merchandise line.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[AttributeInput!]\",\"list\":true,\"name\":\"attributes\",\"reqd\":false,\"type\":\"AttributeInput\"},\"id\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the merchandise line.\",\"gqltype\":\"ID!\",\"list\":false,\"name\":\"id\",\"reqd\":true,\"type\":\"ID\"},\"merchandiseId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the merchandise for the line item.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"merchandiseId\",\"reqd\":false,\"type\":\"ID\"},\"quantity\":{\"args\":[],\"deprecated\":false,\"desc\":\"The quantity of the line item.\",\"gqltype\":\"Int\",\"list\":false,\"name\":\"quantity\",\"reqd\":false,\"type\":\"Int\"},\"sellingPlanId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the selling plan that the merchandise is being purchased with.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"sellingPlanId\",\"reqd\":false,\"type\":\"ID\"}},