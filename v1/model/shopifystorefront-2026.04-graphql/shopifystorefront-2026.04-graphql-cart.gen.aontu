            id: "POST cartLinesAdd"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"ID!\",\"name\":\"cartId\",\"reqd\":true,\"type\":\"ID\"},{\"gqltype\":\"[CartLineInput!]!\",\"name\":\"lines\",\"reqd\":true,\"type\":\"CartLineInput\"}],\"deprecated\":false,\"desc\":\"Adds one or more merchandise lines to an existing [`Cart`](https://shopify.dev/docs/api/storefront/current/objects/Cart). Each line specifies the [product variant](https://shopify.dev/docs/api/storefront/current/objects/ProductVariant) to purchase. Quantity defaults to `1` if not provided.\\n\\nYou can add up to 250 lines in a single request. Use [`CartLineInput`](https://shopify.dev/docs/api/storefront/current/input-objects/CartLineInput) to configure each line's merchandise, quantity, selling plan, custom attributes, and any parent relationships for nested line items such as warranties or add-ons.\\n\",\"gqltype\":\"CartLinesAddPayload\",\"list\":false,\"name\":\"cartLinesAdd\",\"reqd\":false,\"type\":\"CartLinesAddPayload\"},\"invocation\":{\"doc\":\"mutation CartUpdateLinesAdd($cartId: ID!, $lines: [CartLineInput!]!) { cartLinesAdd(cartId: $cartId, lines: $lines) { cart { ...CartFields } } } fragment CartFields on Cart { checkoutUrl createdAt id note totalQuantity updatedAt }\",\"field\":\"cartLinesAdd\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"cartId\",\"gqltype\":\"ID!\",\"name\":\"cartId\"},{\"from\":\"\",\"gqltype\":\"[CartLineInput!]!\",\"name\":\"lines\"}]},\"protocol\":\"graphql\",\"types\":{\"AttributeInput\":{\"desc\":\"A custom key-value pair that stores additional information on a [cart](https://shopify.dev/docs/api/storefront/current/objects/Cart) or [cart line](https://shopify.dev/docs/api/storefront/current/objects/CartLine). Attributes capture additional information like gift messages, special instructions, or custom order details. Learn more about [managing carts with the Storefront API](https://shopify.dev/docs/storefronts/headless/building-with-the-storefront-api/cart/manage).\\n\",\"fields\":{\"key\":{\"args\":[],\"deprecated\":false,\"desc\":\"Key or name of the attribute.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"key\",\"reqd\":true,\"type\":\"String\"},\"value\":{\"args\":[],\"deprecated\":false,\"desc\":\"Value of the attribute.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"value\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"AttributeInput\"},\"CartLineInput\":{\"desc\":\"The input fields for adding a merchandise line to a cart. Each line represents a [`ProductVariant`](https://shopify.dev/docs/api/storefront/current/objects/ProductVariant) the buyer intends to purchase, along with the quantity and optional [`SellingPlan`](https://shopify.dev/docs/api/storefront/current/objects/SellingPlan) for subscriptions.\\n\\nUsed by the [`cartCreate`](https://shopify.dev/docs/api/storefront/current/mutations/cartCreate) mutation when creating a cart with initial items, and the [`cartLinesAdd`](https://shopify.dev/docs/api/storefront/current/mutations/cartLinesAdd) mutation when adding items to an existing cart.\\n\",\"fields\":{\"attributes\":{\"args\":[],\"deprecated\":false,\"desc\":\"An array of key-value pairs that contains additional information about the merchandise line.\\n\\nThe input must not contain more than `250` values.\",\"gqltype\":\"[AttributeInput!]\",\"list\":true,\"name\":\"attributes\",\"reqd\":false,\"type\":\"AttributeInput\"},\"merchandiseId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the merchandise that the buyer intends to purchase.\",\"gqltype\":\"ID!\",\"list\":false,\"name\":\"merchandiseId\",\"reqd\":true,\"type\":\"ID\"},\"parent\":{\"args\":[],\"deprecated\":false,\"desc\":\"The parent line item of the cart line.\",\"gqltype\":\"CartLineParentInput\",\"list\":false,\"name\":\"parent\",\"reqd\":false,\"type\":\"CartLineParentInput\"},\"quantity\":{\"args\":[],\"deprecated\":false,\"desc\":\"The quantity of the merchandise.\",\"gqltype\":\"Int\",\"list\":false,\"name\":\"quantity\",\"reqd\":false,\"type\":\"Int\"},\"sellingPlanId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the selling plan that the merchandise is being purchased with.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"sellingPlanId\",\"reqd\":false,\"type\":\"ID\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartLineInput\"},\"CartLineParentInput\":{\"desc\":\"The parent line item of the cart line.\",\"fields\":{\"lineId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The id of the parent line item.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"lineId\",\"reqd\":false,\"type\":\"ID\"},\"merchandiseId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the parent line merchandise.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"merchandiseId\",\"reqd\":false,\"type\":\"ID\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CartLineParentInput\"},\"ID\":{\"desc\":\"The `ID` scalar type represents a unique identifier, often used to refetch an object or as key for a cache. The ID type appears in a JSON response as a String; however, it is not intended to be human-readable. When expected as an input type, any string (such as `\\\"4\\\"`) or integer (such as `4`) input value will be accepted as an ID.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"ID\"},\"Int\":{\"desc\":\"The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Int\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
