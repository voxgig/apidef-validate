# Entity: blog

main: kit: entity: blog: {

  alias: field: {}

  fields: {
    handle: {
      h: "Handle"
      n: "handle"
      r: true
      sh: "A human-friendly unique string for the Blog automatically generated from its title."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "A globally-unique ID."
      t: "`$STRING`"
    }
    onlineStoreUrl: {
      h: "Online Store Url"
      n: "onlineStoreUrl"
      r: false
      sh: "The URL used for viewing the resource on the shop's Online Store."
      t: "`$ANY`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "The blogs’s title."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "blog"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "POST blogs"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "before"
                or: "before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "first"
                or: "first"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "last"
                or: "last"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "query"
                or: "query"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "reverse"
                or: "reverse"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "param"
                n: "sort_key"
                or: "sort_key"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          gq: {
            doc: "query BlogList($after: String, $before: String, $first: Int, $last: Int, $query: String, $reverse: Boolean, $sortKey: BlogSortKeys) { blogs(after: $after, before: $before, first: $first, last: $last, query: $query, reverse: $reverse, sortKey: $sortKey) { nodes { ...BlogFields } pageInfo { endCursor hasNextPage } } } fragment BlogFields on Blog { handle id onlineStoreUrl title }"
            field: "blogs"
            optype: "query"
            page: {
              cursor: "pageInfo.endCursor"
              more: "pageInfo.hasNextPage"
              nodes: "nodes"
              style: "relay"
            }
            vars: [
              {
                from: "after"
                gqltype: "String"
                name: "after"
              }
              {
                from: "before"
                gqltype: "String"
                name: "before"
              }
              {
                from: "first"
                gqltype: "Int"
                name: "first"
              }
              {
                from: "last"
                gqltype: "Int"
                name: "last"
              }
              {
                from: "query"
                gqltype: "String"
                name: "query"
              }
              {
                from: "reverse"
                gqltype: "Boolean"
                name: "reverse"
              }
              {
                from: "sortKey"
                gqltype: "BlogSortKeys"
                name: "sortKey"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "blogs"
          t: {
            req: "`reqdata`"
            res: "`body.data.blogs.nodes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST blogByHandle"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "handle"
                or: "handle"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query BlogLoad($handle: String!) { blogByHandle(handle: $handle) { ...BlogFields } } fragment BlogFields on Blog { handle id onlineStoreUrl title }"
            field: "blogByHandle"
            optype: "query"
            vars: [
              {
                from: "handle"
                gqltype: "String!"
                name: "handle"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "blogByHandle"
          q: {
            exist: [
              "handle"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.blogByHandle`"
          }
        }
        {
          co: {
            id: "POST blog"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "handle"
                or: "handle"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "id"
                or: "id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query BlogLoad($handle: String, $id: ID) { blog(handle: $handle, id: $id) { ...BlogFields } } fragment BlogFields on Blog { handle id onlineStoreUrl title }"
            field: "blog"
            optype: "query"
            vars: [
              {
                from: "handle"
                gqltype: "String"
                name: "handle"
              }
              {
                from: "id"
                gqltype: "ID"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "blog"
          t: {
            req: "`reqdata`"
            res: "`body.data.blog`"
          }
        }
      ]
    }
  }



}