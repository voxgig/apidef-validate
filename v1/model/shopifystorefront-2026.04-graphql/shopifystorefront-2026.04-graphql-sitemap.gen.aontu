              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "sitemap"
          select: {
            exist: [
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.sitemap`"
          }
        }
