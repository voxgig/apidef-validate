# Entity: product

main: kit: entity: product: {

  alias: field: {}

  fields: [
    {
      name: "availableForSale"
      req: true
      short: "Indicates if at least one product variant is available for sale."
      type: "`$BOOLEAN`"
    }
    {
      name: "category"
      req: false
      short: "The category of a product from [Shopify's Standard Product Taxonomy](https://shopify.github.io/product-taxonomy/releases/unstable/?categoryId=sg-4-17-2-17)."
      type: "`$OBJECT`"
    }
    {
      name: "createdAt"
      req: true
      short: "The date and time when the product was created."
      type: "`$ANY`"
    }
    {
      name: "description"
      req: true
      short: "A single-line description of the product, with [HTML tags](https://developer.mozilla.org/en-US/docs/Web/HTML) removed."
      type: "`$STRING`"
    }
    {
      name: "descriptionHtml"
      req: true
      short: "The description of the product, with HTML tags."
      type: "`$ANY`"
    }
    {
      name: "encodedVariantAvailability"
      req: false
      short: "An encoded string containing all option value combinations with a corresponding variant that is currently available for sale."
      type: "`$STRING`"
    }
    {
      name: "encodedVariantExistence"
      req: false
      short: "An encoded string containing all option value combinations with a corresponding variant."
      type: "`$STRING`"
    }
    {
      name: "featuredImage"
      req: false
      short: "The featured image for the product."
      type: "`$OBJECT`"
    }
    {
      name: "handle"
      req: true
      short: "A unique, human-readable string of the product's title."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "A globally-unique ID."
      type: "`$STRING`"
    }
    {
      name: "isGiftCard"
      req: true
      short: "Whether the product is a gift card."
      type: "`$BOOLEAN`"
    }
    {
      name: "onlineStoreUrl"
      req: false
      short: "The product's URL on the online store."
      type: "`$ANY`"
    }
    {
      name: "productType"
      req: true
      short: "The [product type](https://help.shopify.com/manual/products/details/product-type) that merchants define."
      type: "`$STRING`"
    }
    {
      name: "publishedAt"
      req: true
      short: "The date and time when the product was published to the channel."
      type: "`$ANY`"
    }
    {
      name: "requiresSellingPlan"
      req: true
      short: "Whether the product can only be purchased with a [selling plan](/docs/apps/build/purchase-options/subscriptions/selling-plans)."
      type: "`$BOOLEAN`"
    }
    {
      name: "selectedOrFirstAvailableVariant"
      req: false
      short: "Find an active product variant based on selected options, availability or the first variant."
      type: "`$OBJECT`"
    }
    {
      name: "tags"
      req: true
      short: "A comma-separated list of searchable keywords that are associated with the product."
      type: "`$STRING`"
    }
    {
      name: "title"
      req: true
      short: "The name for the product that displays to customers."
      type: "`$STRING`"
    }
    {
      name: "totalInventory"
      req: false
      short: "The quantity of inventory that's in stock."
      type: "`$INTEGER`"
    }
    {
      name: "trackingParameters"
      req: false
      short: "URL parameters to be added to a page URL to track the origin of on-site search traffic for [analytics reporting](https://help.shopify.com/manual/reports-and-analytics/shopify-reports/report-types/default-reports/behaviour-reports)."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "The date and time when the product was last modified."
      type: "`$ANY`"
    }
    {
      name: "vendor"
      req: true
      short: "The name of the product's vendor."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "product"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "intent"
                orig: "intent"
                reqd: false
                type: "`$ANY`"
              }
              {
                kind: "param"
                name: "product_handle"
                orig: "product_handle"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "product_id"
                orig: "product_id"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          graphql: {
            doc: "query ProductList($intent: ProductRecommendationIntent, $productHandle: String, $productId: ID) { productRecommendations(intent: $intent, productHandle: $productHandle, productId: $productId) { ...ProductFields } } fragment ProductFields on Product { availableForSale category { id } createdAt description descriptionHtml encodedVariantAvailability encodedVariantExistence featuredImage { id } handle id isGiftCard onlineStoreUrl productType publishedAt requiresSellingPlan selectedOrFirstAvailableVariant { id } tags title totalInventory trackingParameters updatedAt vendor }"
            field: "productRecommendations"
            optype: "query"
            vars: [
              {
                from: "intent"
                gqltype: "ProductRecommendationIntent"
                name: "intent"
              }
              {
                from: "productHandle"
                gqltype: "String"
                name: "productHandle"
              }
              {
                from: "productId"
                gqltype: "ID"
                name: "productId"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "productRecommendations"
          transform: {
            req: "`reqdata`"
            res: "`body.data.productRecommendations`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "after"
                orig: "after"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "before"
                orig: "before"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "first"
                orig: "first"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "last"
                orig: "last"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "query"
                orig: "query"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "reverse"
                orig: "reverse"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                kind: "param"
                name: "sort_key"
                orig: "sort_key"
                reqd: false
                type: "`$ANY`"
              }
            ]
          }
          graphql: {
            doc: "query ProductList($after: String, $before: String, $first: Int, $last: Int, $query: String, $reverse: Boolean, $sortKey: ProductSortKeys) { products(after: $after, before: $before, first: $first, last: $last, query: $query, reverse: $reverse, sortKey: $sortKey) { nodes { ...ProductFields } pageInfo { endCursor hasNextPage } } } fragment ProductFields on Product { availableForSale category { id } createdAt description descriptionHtml encodedVariantAvailability encodedVariantExistence featuredImage { id } handle id isGiftCard onlineStoreUrl productType publishedAt requiresSellingPlan selectedOrFirstAvailableVariant { id } tags title totalInventory trackingParameters updatedAt vendor }"
            field: "products"
            optype: "query"
            page: {
              cursor: "pageInfo.endCursor"
              more: "pageInfo.hasNextPage"
              nodes: "nodes"
              style: "relay"
            }
            vars: [
              {
                from: "after"
                gqltype: "String"
                name: "after"
              }
              {
                from: "before"
                gqltype: "String"
                name: "before"
              }
              {
                from: "first"
                gqltype: "Int"
                name: "first"
              }
              {
                from: "last"
                gqltype: "Int"
                name: "last"
              }
              {
                from: "query"
                gqltype: "String"
                name: "query"
              }
              {
                from: "reverse"
                gqltype: "Boolean"
                name: "reverse"
              }
              {
                from: "sortKey"
                gqltype: "ProductSortKeys"
                name: "sortKey"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "products"
          transform: {
            req: "`reqdata`"
            res: "`body.data.products.nodes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "handle"
                orig: "handle"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          graphql: {
            doc: "query ProductLoad($handle: String!) { productByHandle(handle: $handle) { ...ProductFields } } fragment ProductFields on Product { availableForSale category { id } createdAt description descriptionHtml encodedVariantAvailability encodedVariantExistence featuredImage { id } handle id isGiftCard onlineStoreUrl productType publishedAt requiresSellingPlan selectedOrFirstAvailableVariant { id } tags title totalInventory trackingParameters updatedAt vendor }"
            field: "productByHandle"
            optype: "query"
            vars: [
              {
                from: "handle"
                gqltype: "String!"
                name: "handle"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "productByHandle"
          select: {
            exist: [
              "handle"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.productByHandle`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "handle"
                orig: "handle"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          graphql: {
            doc: "query ProductLoad($handle: String, $id: ID) { product(handle: $handle, id: $id) { ...ProductFields } } fragment ProductFields on Product { availableForSale category { id } createdAt description descriptionHtml encodedVariantAvailability encodedVariantExistence featuredImage { id } handle id isGiftCard onlineStoreUrl productType publishedAt requiresSellingPlan selectedOrFirstAvailableVariant { id } tags title totalInventory trackingParameters updatedAt vendor }"
            field: "product"
