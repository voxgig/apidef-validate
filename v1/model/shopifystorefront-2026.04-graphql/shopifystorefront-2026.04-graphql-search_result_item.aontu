            json: "{\"field\":{\"args\":[{\"gqltype\":\"String\",\"name\":\"after\",\"reqd\":false,\"type\":\"String\"},{\"gqltype\":\"String\",\"name\":\"before\",\"reqd\":false,\"type\":\"String\"},{\"gqltype\":\"Int\",\"name\":\"first\",\"reqd\":false,\"type\":\"Int\"},{\"gqltype\":\"Int\",\"name\":\"last\",\"reqd\":false,\"type\":\"Int\"},{\"gqltype\":\"SearchPrefixQueryType\",\"name\":\"prefix\",\"reqd\":false,\"type\":\"SearchPrefixQueryType\"},{\"gqltype\":\"[ProductFilter!]\",\"name\":\"productFilters\",\"reqd\":false,\"type\":\"ProductFilter\"},{\"gqltype\":\"String!\",\"name\":\"query\",\"reqd\":true,\"type\":\"String\"},{\"gqltype\":\"Boolean\",\"name\":\"reverse\",\"reqd\":false,\"type\":\"Boolean\"},{\"gqltype\":\"SearchSortKeys\",\"name\":\"sortKey\",\"reqd\":false,\"type\":\"SearchSortKeys\"},{\"gqltype\":\"[SearchType!]\",\"name\":\"types\",\"reqd\":false,\"type\":\"SearchType\"},{\"gqltype\":\"SearchUnavailableProductsType\",\"name\":\"unavailableProducts\",\"reqd\":false,\"type\":\"SearchUnavailableProductsType\"}],\"deprecated\":false,\"desc\":\"Returns paginated search results for [`Product`](https://shopify.dev/docs/api/storefront/current/objects/Product), [`Page`](https://shopify.dev/docs/api/storefront/current/objects/Page), and [`Article`](https://shopify.dev/docs/api/storefront/current/objects/Article) resources based on a query string. Results are sorted by relevance by default.\\n\\nThe response includes the total result count and available product filters for building [faceted search interfaces](https://shopify.dev/docs/storefronts/headless/building-with-the-storefront-api/products-collections/filter-products). Use the [`prefix`](https://shopify.dev/docs/api/storefront/current/enums/SearchPrefixQueryType) argument to enable partial word matching on the last search term, allowing queries like \\\"winter snow\\\" to match \\\"snowboard\\\" or \\\"snowshoe\\\".\\n\",\"gqltype\":\"SearchResultItemConnection!\",\"list\":false,\"name\":\"search\",\"reqd\":true,\"type\":\"SearchResultItemConnection\"},\"invocation\":{\"doc\":\"query SearchResultItemList($after: String, $before: String, $first: Int, $last: Int, $prefix: SearchPrefixQueryType, $productFilters: [ProductFilter!], $query: String!, $reverse: Boolean, $sortKey: SearchSortKeys, $types: [SearchType!], $unavailableProducts: SearchUnavailableProductsType) { search(after: $after, before: $before, first: $first, last: $last, prefix: $prefix, productFilters: $productFilters, query: $query, reverse: $reverse, sortKey: $sortKey, types: $types, unavailableProducts: $unavailableProducts) { nodes { id } pageInfo { endCursor hasNextPage } } }\",\"field\":\"search\",\"optype\":\"query\",\"page\":{\"cursor\":\"pageInfo.endCursor\",\"more\":\"pageInfo.hasNextPage\",\"nodes\":\"nodes\",\"style\":\"relay\"},\"vars\":[{\"from\":\"after\",\"gqltype\":\"String\",\"name\":\"after\"},{\"from\":\"before\",\"gqltype\":\"String\",\"name\":\"before\"},{\"from\":\"first\",\"gqltype\":\"Int\",\"name\":\"first\"},{\"from\":\"last\",\"gqltype\":\"Int\",\"name\":\"last\"},{\"from\":\"prefix\",\"gqltype\":\"SearchPrefixQueryType\",\"name\":\"prefix\"},{\"from\":\"\",\"gqltype\":\"[ProductFilter!]\",\"name\":\"productFilters\"},{\"from\":\"query\",\"gqltype\":\"String!\",\"name\":\"query\"},{\"from\":\"reverse\",\"gqltype\":\"Boolean\",\"name\":\"reverse\"},{\"from\":\"sortKey\",\"gqltype\":\"SearchSortKeys\",\"name\":\"sortKey\"},{\"from\":\"types\",\"gqltype\":\"[SearchType!]\",\"name\":\"types\"},{\"from\":\"unavailableProducts\",\"gqltype\":\"SearchUnavailableProductsType\",\"name\":\"unavailableProducts\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"CategoryFilter\":{\"desc\":\"A filter used to view a subset of products in a collection matching a specific category value.\\n\",\"fields\":{\"id\":{\"args\":[],\"deprecated\":false,\"desc\":\"The id of the category to filter on.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"id\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CategoryFilter\"},\"Float\":{\"desc\":\"The `Float` scalar type represents signed double-precision fractional values as specified by [IEEE 754](https://en.wikipedia.org/wiki/IEEE_floating_point).\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Float\"},\"Int\":{\"desc\":\"The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Int\"},\"MetafieldFilter\":{\"desc\":\"Filters products in a collection by matching a specific metafield value. Used by the [`ProductFilter`](https://shopify.dev/docs/api/storefront/current/input-objects/ProductFilter) input's `productMetafield` and `variantMetafield` fields.\\n\\nSupports the following metafield types: `number_integer`, `number_decimal`, `single_line_text_field`, and `boolean`.\\n\",\"fields\":{\"key\":{\"args\":[],\"deprecated\":false,\"desc\":\"The key of the metafield to filter on.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"key\",\"reqd\":true,\"type\":\"String\"},\"namespace\":{\"args\":[],\"deprecated\":false,\"desc\":\"The namespace of the metafield to filter on.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"namespace\",\"reqd\":true,\"type\":\"String\"},\"value\":{\"args\":[],\"deprecated\":false,\"desc\":\"The value of the metafield.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"value\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"MetafieldFilter\"},\"PriceRangeFilter\":{\"desc\":\"A price range for filtering products in a collection. Used by the [`ProductFilter`](https://shopify.dev/docs/api/storefront/current/input-objects/ProductFilter) input's [`price`](https://shopify.dev/docs/api/storefront/current/input-objects/ProductFilter#fields-price) field.\\n\\n> Note: Omitting the [maximum](https://shopify.dev/docs/api/storefront/currents/input-objects/PriceRangeFilter#fields-max) returns all products above the [minimum](https://shopify.dev/docs/api/storefront/current/input-objects/PriceRangeFilter#fields-min).\\n\",\"fields\":{\"max\":{\"args\":[],\"deprecated\":false,\"desc\":\"The maximum price in the range. Empty indicates no max price.\",\"gqltype\":\"Float\",\"list\":false,\"name\":\"max\",\"reqd\":false,\"type\":\"Float\"},\"min\":{\"args\":[],\"deprecated\":false,\"desc\":\"The minimum price in the range. Defaults to zero.\",\"gqltype\":\"Float\",\"list\":false,\"name\":\"min\",\"reqd\":false,\"type\":\"Float\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"PriceRangeFilter\"},\"ProductFilter\":{\"desc\":\"The input fields for a filter used to view a subset of products in a collection.\\nBy default, the `available` and `price` filters are enabled. Filters are customized with the Shopify Search & Discovery app.\\nLearn more about [customizing storefront filtering](https://help.shopify.com/manual/online-store/themes/customizing-themes/storefront-filters).\\n\",\"fields\":{\"available\":{\"args\":[],\"deprecated\":false,\"desc\":\"Filter on if the product is available for sale.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"available\",\"reqd\":false,\"type\":\"Boolean\"},\"category\":{\"args\":[],\"deprecated\":false,\"desc\":\"A product category to filter on.\",\"gqltype\":\"CategoryFilter\",\"list\":false,\"name\":\"category\",\"reqd\":false,\"type\":\"CategoryFilter\"},\"price\":{\"args\":[],\"deprecated\":false,\"desc\":\"A range of prices to filter with-in.\",\"gqltype\":\"PriceRangeFilter\",\"list\":false,\"name\":\"price\",\"reqd\":false,\"type\":\"PriceRangeFilter\"},\"productMetafield\":{\"args\":[],\"deprecated\":false,\"desc\":\"A product metafield to filter on.\",\"gqltype\":\"MetafieldFilter\",\"list\":false,\"name\":\"productMetafield\",\"reqd\":false,\"type\":\"MetafieldFilter\"},\"productType\":{\"args\":[],\"deprecated\":false,\"desc\":\"The product type to filter on.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"productType\",\"reqd\":false,\"type\":\"String\"},\"productVendor\":{\"args\":[],\"deprecated\":false,\"desc\":\"The product vendor to filter on.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"productVendor\",\"reqd\":false,\"type\":\"String\"},\"tag\":{\"args\":[],\"deprecated\":false,\"desc\":\"A product tag to filter on.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"tag\",\"reqd\":false,\"type\":\"String\"},\"taxonomyMetafield\":{\"args\":[],\"deprecated\":false,\"desc\":\"A standard product attribute metafield to filter on.\",\"gqltype\":\"TaxonomyMetafieldFilter\",\"list\":false,\"name\":\"taxonomyMetafield\",\"reqd\":false,\"type\":\"TaxonomyMetafieldFilter\"},\"variantMetafield\":{\"args\":[],\"deprecated\":false,\"desc\":\"A variant metafield to filter on.\",\"gqltype\":\"MetafieldFilter\",\"list\":false,\"name\":\"variantMetafield\",\"reqd\":false,\"type\":\"MetafieldFilter\"},\"variantOption\":{\"args\":[],\"deprecated\":false,\"desc\":\"A variant option to filter on.\",\"gqltype\":\"VariantOptionFilter\",\"list\":false,\"name\":\"variantOption\",\"reqd\":false,\"type\":\"VariantOptionFilter\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"ProductFilter\"},\"SearchPrefixQueryType\":{\"desc\":\"Specifies whether to perform a partial word match on the last search term.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"SearchPrefixQueryType\",\"values\":[\"LAST\",\"NONE\"]},\"SearchSortKeys\":{\"desc\":\"The set of valid sort keys for the search query.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"SearchSortKeys\",\"values\":[\"PRICE\",\"RELEVANCE\"]},\"SearchType\":{\"desc\":\"The types of search items to perform search within.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"SearchType\",\"values\":[\"ARTICLE\",\"PAGE\",\"PRODUCT\"]},\"SearchUnavailableProductsType\":{\"desc\":\"Specifies whether to display results for unavailable products.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"SearchUnavailableProductsType\",\"values\":[\"HIDE\",\"LAST\",\"SHOW\"]},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"},\"TaxonomyMetafieldFilter\":{\"desc\":\"A filter used to view a subset of products in a collection matching a specific taxonomy metafield value.\\n\",\"fields\":{\"key\":{\"args\":[],\"deprecated\":false,\"desc\":\"The key of the metafield to filter on.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"key\",\"reqd\":true,\"type\":\"String\"},\"namespace\":{\"args\":[],\"deprecated\":false,\"desc\":\"The namespace of the metafield to filter on.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"namespace\",\"reqd\":true,\"type\":\"String\"},\"value\":{\"args\":[],\"deprecated\":false,\"desc\":\"The value of the metafield.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"value\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"TaxonomyMetafieldFilter\"},\"VariantOptionFilter\":{\"desc\":\"The input fields for a filter used to view a subset of products in a collection matching a specific variant option.\",\"fields\":{\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the variant option to filter on.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"name\",\"reqd\":true,\"type\":\"String\"},\"value\":{\"args\":[],\"deprecated\":false,\"desc\":\"The value of the variant option to filter on.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"value\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"VariantOptionFilter\"}},\"typesScope\":\"inputs\"}"
