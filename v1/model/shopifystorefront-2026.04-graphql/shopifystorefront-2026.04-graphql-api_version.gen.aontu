# Entity: api_version

main: kit: entity: api_version: {

  alias: field: {}

  fields: [
    {
      name: "displayName"
      req: true
      short: "The human-readable name of the version."
      type: "`$STRING`"
    }
    {
      name: "handle"
      req: true
      short: "The unique identifier of an ApiVersion."
      type: "`$STRING`"
    }
    {
      name: "supported"
      req: true
      short: "Whether the version is actively supported by Shopify."
      type: "`$BOOLEAN`"
    }
  ]

  name: "api_version"
  op: {
    list: {
      name: "list"
      points: [
        {
          graphql: {
            doc: "query ApiVersionList { publicApiVersions { ...ApiVersionFields } } fragment ApiVersionFields on ApiVersion { displayName handle supported }"
            field: "publicApiVersions"
            optype: "query"
          }
          kind: "graphql"
          method: "POST"
          orig: "publicApiVersions"
          transform: {
            req: "`reqdata`"
            res: "`body.data.publicApiVersions`"
          }
        }
      ]
    }
  }



}