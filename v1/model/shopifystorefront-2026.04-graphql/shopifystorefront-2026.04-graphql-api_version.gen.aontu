# Entity: api_version

main: kit: entity: api_version: {

  alias: field: {}

  fields: {
    displayName: {
      h: "Display Name"
      n: "displayName"
      r: true
      sh: "The human-readable name of the version."
      t: "`$STRING`"
    }
    handle: {
      h: "Handle"
      n: "handle"
      r: true
      sh: "The unique identifier of an ApiVersion."
      t: "`$STRING`"
    }
    supported: {
      h: "Supported"
      n: "supported"
      r: true
      sh: "Whether the version is actively supported by Shopify."
      t: "`$BOOLEAN`"
    }
  }

  name: "api_version"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "POST publicApiVersions"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "query ApiVersionList { publicApiVersions { ...ApiVersionFields } } fragment ApiVersionFields on ApiVersion { displayName handle supported }"
            field: "publicApiVersions"
            optype: "query"
          }
          k: "graphql"
          m: "POST"
          o: "publicApiVersions"
          t: {
            req: "`reqdata`"
            res: "`body.data.publicApiVersions`"
          }
        }
      ]
    }
  }



}