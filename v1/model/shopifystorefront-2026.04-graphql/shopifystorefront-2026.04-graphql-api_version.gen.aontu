            json: "{\"field\":{\"args\":[],\"deprecated\":false,\"desc\":\"Returns all public Storefront [API versions](https://shopify.dev/docs/api/storefront/current/objects/ApiVersion), including supported, release candidate, and unstable versions.\\n\",\"gqltype\":\"[ApiVersion!]!\",\"list\":true,\"name\":\"publicApiVersions\",\"reqd\":true,\"type\":\"ApiVersion\"},\"invocation\":{\"doc\":\"query ApiVersionList { publicApiVersions { ...ApiVersionFields } } fragment ApiVersionFields on ApiVersion { displayName handle supported }\",\"field\":\"publicApiVersions\",\"optype\":\"query\",\"vars\":[]},\"protocol\":\"graphql\",\"types\":{},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
            doc: "query ApiVersionList { publicApiVersions { ...ApiVersionFields } } fragment ApiVersionFields on ApiVersion { displayName handle supported }"
            field: "publicApiVersions"
