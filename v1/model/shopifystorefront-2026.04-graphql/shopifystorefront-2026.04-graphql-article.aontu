          contract: {
            id: "POST articles"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"String\",\"name\":\"after\",\"reqd\":false,\"type\":\"String\"},{\"gqltype\":\"String\",\"name\":\"before\",\"reqd\":false,\"type\":\"String\"},{\"gqltype\":\"Int\",\"name\":\"first\",\"reqd\":false,\"type\":\"Int\"},{\"gqltype\":\"Int\",\"name\":\"last\",\"reqd\":false,\"type\":\"Int\"},{\"gqltype\":\"String\",\"name\":\"query\",\"reqd\":false,\"type\":\"String\"},{\"gqltype\":\"Boolean\",\"name\":\"reverse\",\"reqd\":false,\"type\":\"Boolean\"},{\"gqltype\":\"ArticleSortKeys\",\"name\":\"sortKey\",\"reqd\":false,\"type\":\"ArticleSortKeys\"}],\"deprecated\":false,\"desc\":\"Returns a paginated list of [`Article`](https://shopify.dev/docs/api/storefront/current/objects/Article) objects from the shop's [`Blog`](https://shopify.dev/docs/api/storefront/current/objects/Blog) objects. Each article is a blog post containing content, author information, tags, and optional images.\\n\\nUse the `query` argument to filter results by author, blog title, tags, or date fields. Sort results using the `sortKey` argument and reverse them with the `reverse` argument.\\n\",\"gqltype\":\"ArticleConnection!\",\"list\":false,\"name\":\"articles\",\"reqd\":true,\"type\":\"ArticleConnection\"},\"invocation\":{\"doc\":\"query ArticleList($after: String, $before: String, $first: Int, $last: Int, $query: String, $reverse: Boolean, $sortKey: ArticleSortKeys) { articles(after: $after, before: $before, first: $first, last: $last, query: $query, reverse: $reverse, sortKey: $sortKey) { nodes { ...ArticleFields } pageInfo { endCursor hasNextPage } } } fragment ArticleFields on Article { blog { id } content contentHtml excerpt excerptHtml handle id image { id } onlineStoreUrl publishedAt tags title trackingParameters }\",\"field\":\"articles\",\"optype\":\"query\",\"page\":{\"cursor\":\"pageInfo.endCursor\",\"more\":\"pageInfo.hasNextPage\",\"nodes\":\"nodes\",\"style\":\"relay\"},\"vars\":[{\"from\":\"after\",\"gqltype\":\"String\",\"name\":\"after\"},{\"from\":\"before\",\"gqltype\":\"String\",\"name\":\"before\"},{\"from\":\"first\",\"gqltype\":\"Int\",\"name\":\"first\"},{\"from\":\"last\",\"gqltype\":\"Int\",\"name\":\"last\"},{\"from\":\"query\",\"gqltype\":\"String\",\"name\":\"query\"},{\"from\":\"reverse\",\"gqltype\":\"Boolean\",\"name\":\"reverse\"},{\"from\":\"sortKey\",\"gqltype\":\"ArticleSortKeys\",\"name\":\"sortKey\"}]},\"protocol\":\"graphql\",\"types\":{\"ArticleSortKeys\":{\"desc\":\"The set of valid sort keys for the Article query.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"ArticleSortKeys\",\"values\":[\"AUTHOR\",\"BLOG_TITLE\",\"ID\",\"PUBLISHED_AT\",\"RELEVANCE\",\"TITLE\",\"UPDATED_AT\"]},\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"Int\":{\"desc\":\"The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Int\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
