# Entity: article

main: kit: entity: article: {

  alias: field: {}

  fields: {
    blog: {
      h: "Blog"
      n: "blog"
      r: false
      sh: "The blog that the article belongs to."
      t: "`$OBJECT`"
    }
    content: {
      h: "Content"
      n: "content"
      r: true
      sh: "Stripped content of the article, single line with HTML tags removed."
      t: "`$STRING`"
    }
    contentHtml: {
      h: "Content Html"
      n: "contentHtml"
      r: true
      sh: "The content of the article, complete with HTML formatting."
      t: "`$ANY`"
    }
    excerpt: {
      h: "Excerpt"
      n: "excerpt"
      r: false
      sh: "Stripped excerpt of the article, single line with HTML tags removed."
      t: "`$STRING`"
    }
    excerptHtml: {
      h: "Excerpt Html"
      n: "excerptHtml"
      r: false
      sh: "The excerpt of the article, complete with HTML formatting."
      t: "`$ANY`"
    }
    handle: {
      h: "Handle"
      n: "handle"
      r: true
      sh: "A human-friendly unique string for the Article automatically generated from its title."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "A globally-unique ID."
      t: "`$STRING`"
    }
    image: {
      h: "Image"
      n: "image"
      r: false
      sh: "The image associated with the article."
      t: "`$OBJECT`"
    }
    onlineStoreUrl: {
      h: "Online Store Url"
      n: "onlineStoreUrl"
      r: false
      sh: "The URL used for viewing the resource on the shop's Online Store."
      t: "`$ANY`"
    }
    publishedAt: {
      h: "Published At"
      n: "publishedAt"
      r: true
      sh: "The date and time when the article was published."
      t: "`$ANY`"
    }
    tags: {
      h: "Tags"
      n: "tags"
      r: true
      sh: "A categorization that a article can be tagged with."
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "The article’s name."
      t: "`$STRING`"
    }
    trackingParameters: {
      h: "Tracking Parameters"
      n: "trackingParameters"
      r: false
      sh: "URL parameters to be added to a page URL to track the origin of on-site search traffic for [analytics reporting](https://help.shopify.com/manual/reports-and-analytics/shopify-reports/report-types/default-reports/behaviour-reports)."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "article"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "after"
                orig: "after"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "before"
                orig: "before"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "first"
                orig: "first"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "last"
                orig: "last"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "query"
                orig: "query"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "reverse"
                orig: "reverse"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                kind: "param"
                name: "sort_key"
                orig: "sort_key"
                reqd: false
                type: "`$ANY`"
              }
            ]
          }
          contract: {
            id: "POST articles"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "query ArticleList($after: String, $before: String, $first: Int, $last: Int, $query: String, $reverse: Boolean, $sortKey: ArticleSortKeys) { articles(after: $after, before: $before, first: $first, last: $last, query: $query, reverse: $reverse, sortKey: $sortKey) { nodes { ...ArticleFields } pageInfo { endCursor hasNextPage } } } fragment ArticleFields on Article { blog { id } content contentHtml excerpt excerptHtml handle id image { id } onlineStoreUrl publishedAt tags title trackingParameters }"
            field: "articles"
            optype: "query"
            page: {
              cursor: "pageInfo.endCursor"
              more: "pageInfo.hasNextPage"
              nodes: "nodes"
              style: "relay"
            }
            vars: [
              {
                from: "after"
                gqltype: "String"
                name: "after"
              }
              {
                from: "before"
                gqltype: "String"
                name: "before"
              }
              {
                from: "first"
                gqltype: "Int"
                name: "first"
              }
              {
                from: "last"
                gqltype: "Int"
                name: "last"
              }
              {
                from: "query"
                gqltype: "String"
                name: "query"
              }
              {
                from: "reverse"
                gqltype: "Boolean"
                name: "reverse"
              }
              {
                from: "sortKey"
                gqltype: "ArticleSortKeys"
                name: "sortKey"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "articles"
          transform: {
            req: "`reqdata`"
            res: "`body.data.articles.nodes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST article"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "query ArticleLoad($id: ID!) { article(id: $id) { ...ArticleFields } } fragment ArticleFields on Article { blog { id } content contentHtml excerpt excerptHtml handle id image { id } onlineStoreUrl publishedAt tags title trackingParameters }"
            field: "article"
            optype: "query"
            vars: [
              {
                from: "id"
                gqltype: "ID!"
                name: "id"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "article"
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.article`"
          }
        }
      ]
    }
  }



}