            id: "POST customerCreate"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"CustomerCreateInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"CustomerCreateInput\"}],\"deprecated\":false,\"desc\":\"Creates a new [`Customer`](https://shopify.dev/docs/api/storefront/current/objects/Customer) account with the provided contact information and login credentials. The customer can then sign in for things such as accessing their account, viewing order history, and managing saved addresses.\\n\\n> Caution:\\n> This mutation creates customer credentials. Ensure passwords are collected securely and never logged or exposed in client-side code.\\n\",\"gqltype\":\"CustomerCreatePayload\",\"list\":false,\"name\":\"customerCreate\",\"reqd\":false,\"type\":\"CustomerCreatePayload\"},\"invocation\":{\"doc\":\"mutation CustomerCreate($input: CustomerCreateInput!) { customerCreate(input: $input) { customer { ...CustomerFields } } } fragment CustomerFields on Customer { acceptsMarketing avatarUrl createdAt defaultAddress { id } displayName email firstName id lastName numberOfOrders phone tags updatedAt }\",\"field\":\"customerCreate\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"CustomerCreateInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"CustomerCreateInput\":{\"desc\":\"The input fields for creating a new [`Customer`](https://shopify.dev/docs/api/storefront/current/objects/Customer) account. Used by the [`customerCreate`](https://shopify.dev/docs/api/storefront/current/mutations/customerCreate) mutation.\\n\\nFor legacy customer accounts only and requires an email address and password. Optionally accepts the customer's name, phone number, and email marketing consent.\\n\\n> Caution:\\n> The password is used for customer authentication. Ensure it's transmitted securely and never logged or stored in plain text.\\n\",\"fields\":{\"acceptsMarketing\":{\"args\":[],\"deprecated\":false,\"desc\":\"Indicates whether the customer has consented to be sent marketing material via email.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"acceptsMarketing\",\"reqd\":false,\"type\":\"Boolean\"},\"email\":{\"args\":[],\"deprecated\":false,\"desc\":\"The customer’s email.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"email\",\"reqd\":true,\"type\":\"String\"},\"firstName\":{\"args\":[],\"deprecated\":false,\"desc\":\"The customer’s first name.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"firstName\",\"reqd\":false,\"type\":\"String\"},\"lastName\":{\"args\":[],\"deprecated\":false,\"desc\":\"The customer’s last name.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"lastName\",\"reqd\":false,\"type\":\"String\"},\"password\":{\"args\":[],\"deprecated\":false,\"desc\":\"The login password used by the customer.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"password\",\"reqd\":true,\"type\":\"String\"},\"phone\":{\"args\":[],\"deprecated\":false,\"desc\":\"A unique phone number for the customer.\\n\\nFormatted using E.164 standard. For example, _+16135551111_.\\n\",\"gqltype\":\"String\",\"list\":false,\"name\":\"phone\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CustomerCreateInput\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
