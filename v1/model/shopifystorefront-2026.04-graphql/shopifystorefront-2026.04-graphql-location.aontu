    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the location."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "location"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "POST locations"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "before"
                or: "before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "first"
                or: "first"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "last"
