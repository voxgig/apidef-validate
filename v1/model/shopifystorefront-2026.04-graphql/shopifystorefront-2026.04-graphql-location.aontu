                name: "near"
              }
              {
                from: "reverse"
                gqltype: "Boolean"
                name: "reverse"
              }
              {
                from: "sortKey"
                gqltype: "LocationSortKeys"
                name: "sortKey"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "locations"
          t: {
            req: "`reqdata`"
