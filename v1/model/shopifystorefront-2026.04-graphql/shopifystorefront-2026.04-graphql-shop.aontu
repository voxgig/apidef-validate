# Entity: shop

main: kit: entity: shop: {

  alias: field: {}

  fields: [
    {
      name: "contact_information"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "customer_account_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "legal_notice"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "money_format"
      req: true
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      type: "`$STRING`"
    }
    {
      name: "privacy_policy"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "refund_policy"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "shipping_policy"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "ships_to_country"
      req: true
      type: "`$STRING`"
    }
    {
      name: "subscription_policy"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "terms_of_sale"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "terms_of_service"
      req: false
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "shop"
  op: {
    load: {
      name: "load"
      points: [
        {
          graphql: {
            doc: "query ShopLoad { shop { ...ShopFields } } fragment ShopFields on Shop { contactInformation { id } customerAccountUrl description id legalNotice { id } moneyFormat name privacyPolicy { id } refundPolicy { id } shippingPolicy { id } shipsToCountries subscriptionPolicy { id } termsOfSale { id } termsOfService { id } }"
            field: "shop"
            optype: "query"
          }
          kind: "graphql"
          method: "POST"
          orig: "shop"
          transform: {
            req: "`reqdata`"
            res: "`body.data.shop`"
          }
        }
      ]
    }
  }



}
