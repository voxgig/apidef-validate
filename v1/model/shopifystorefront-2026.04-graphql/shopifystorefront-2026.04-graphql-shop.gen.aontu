# Entity: shop

main: kit: entity: shop: {

  alias: field: {}

  fields: {
    contactInformation: {
      h: "Contact Information"
      n: "contactInformation"
      r: false
      sh: "The shop's contact information."
      t: "`$OBJECT`"
    }
    customerAccountUrl: {
      h: "Customer Account Url"
      n: "customerAccountUrl"
      r: false
      sh: "The URL for the customer account (only present if shop has a customer account vanity domain)."
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "A description of the shop."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "A globally-unique ID."
      t: "`$STRING`"
    }
    legalNotice: {
      h: "Legal Notice"
      n: "legalNotice"
      r: false
      sh: "The shop's legal notice."
      t: "`$OBJECT`"
    }
    moneyFormat: {
      h: "Money Format"
      n: "moneyFormat"
      r: true
      sh: "A string representing the way currency is formatted when the currency isn’t specified."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The shop’s name."
      t: "`$STRING`"
    }
    privacyPolicy: {
      h: "Privacy Policy"
      n: "privacyPolicy"
      r: false
      sh: "The shop’s privacy policy."
      t: "`$OBJECT`"
    }
    refundPolicy: {
      h: "Refund Policy"
      n: "refundPolicy"
      r: false
      sh: "The shop’s refund policy."
      t: "`$OBJECT`"
    }
    shippingPolicy: {
      h: "Shipping Policy"
      n: "shippingPolicy"
      r: false
      sh: "The shop’s shipping policy."
      t: "`$OBJECT`"
    }
    shipsToCountries: {
      h: "Ships To Countries"
      n: "shipsToCountries"
      r: true
      sh: "Countries that the shop ships to."
      t: "`$STRING`"
    }
    subscriptionPolicy: {
      h: "Subscription Policy"
      n: "subscriptionPolicy"
      r: false
      sh: "The shop’s subscription policy."
      t: "`$OBJECT`"
    }
    termsOfSale: {
      h: "Terms Of Sale"
      n: "termsOfSale"
      r: false
      sh: "The shop's terms of sale."
      t: "`$OBJECT`"
    }
    termsOfService: {
      h: "Terms Of Service"
      n: "termsOfService"
      r: false
      sh: "The shop’s terms of service."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "shop"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST shop"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "query ShopLoad { shop { ...ShopFields } } fragment ShopFields on Shop { contactInformation { id } customerAccountUrl description id legalNotice { id } moneyFormat name privacyPolicy { id } refundPolicy { id } shippingPolicy { id } shipsToCountries subscriptionPolicy { id } termsOfSale { id } termsOfService { id } }"
            field: "shop"
            optype: "query"
          }
          k: "graphql"
          m: "POST"
          o: "shop"
          t: {
            req: "`reqdata`"
            res: "`body.data.shop`"
          }
        }
      ]
    }
  }



}