# Entity: shop

main: kit: entity: shop: {

  alias: field: {}

  fields: [
    {
      name: "contactInformation"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "customerAccountUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "legalNotice"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "moneyFormat"
      req: true
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      type: "`$STRING`"
    }
    {
      name: "privacyPolicy"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "refundPolicy"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "shippingPolicy"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "shipsToCountries"
      req: true
      type: "`$STRING`"
    }
    {
      name: "subscriptionPolicy"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "termsOfSale"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "termsOfService"
      req: false
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "shop"
  op: {
    load: {
      name: "load"
      points: [
        {
          graphql: {
            doc: "query ShopLoad { shop { ...ShopFields } } fragment ShopFields on Shop { contactInformation { id } customerAccountUrl description id legalNotice { id } moneyFormat name privacyPolicy { id } refundPolicy { id } shippingPolicy { id } shipsToCountries subscriptionPolicy { id } termsOfSale { id } termsOfService { id } }"
            field: "shop"
            optype: "query"
          }
          kind: "graphql"
          method: "POST"
          orig: "shop"
          transform: {
            req: "`reqdata`"
            res: "`body.data.shop`"
          }
        }
      ]
    }
  }



}