          contract: {
            id: "POST customerAccessTokenRenew"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"String!\",\"name\":\"customerAccessToken\",\"reqd\":true,\"type\":\"String\"}],\"deprecated\":false,\"desc\":\"Extends the validity of a [`CustomerAccessToken`](https://shopify.dev/docs/api/storefront/current/objects/CustomerAccessToken) before it expires. The renewed token maintains authenticated access to customer operations.\\n\\nRenewal must happen before the token's [`expiresAt`](https://shopify.dev/docs/api/storefront/current/objects/CustomerAccessToken#field-CustomerAccessToken.fields.expiresAt) time. If a token has already expired, then use [`customerAccessTokenCreate`](https://shopify.dev/docs/api/storefront/current/mutations/customerAccessTokenCreate) to generate a new token with the customer's credentials.\\n\\n> Caution:\\n> Store access tokens securely. Never store tokens in plain text or insecure locations, and avoid exposing them in URLs or logs.\\n\",\"gqltype\":\"CustomerAccessTokenRenewPayload\",\"list\":false,\"name\":\"customerAccessTokenRenew\",\"reqd\":false,\"type\":\"CustomerAccessTokenRenewPayload\"},\"invocation\":{\"doc\":\"mutation CustomerAccessTokenCreateRenew($customerAccessToken: String!) { customerAccessTokenRenew(customerAccessToken: $customerAccessToken) { customerAccessToken { ...CustomerAccessTokenFields } } } fragment CustomerAccessTokenFields on CustomerAccessToken { accessToken expiresAt }\",\"field\":\"customerAccessTokenRenew\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"customerAccessToken\",\"gqltype\":\"String!\",\"name\":\"customerAccessToken\"}]},\"protocol\":\"graphql\",\"types\":{\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
            doc: "mutation CustomerAccessTokenCreateRenew($customerAccessToken: String!) { customerAccessTokenRenew(customerAccessToken: $customerAccessToken) { customerAccessToken { ...CustomerAccessTokenFields } } } fragment CustomerAccessTokenFields on CustomerAccessToken { accessToken expiresAt }"
            field: "customerAccessTokenRenew"
            optype: "mutation"
            vars: [
              {
                from: "customerAccessToken"
                gqltype: "String!"
                name: "customerAccessToken"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "customerAccessTokenRenew"
          select: {
            "$action": "renew"
            exist: [
              "customer_access_token"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.customerAccessTokenRenew.customerAccessToken`"
          }
        }
        {
          contract: {
            id: "POST customerAccessTokenCreate"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"CustomerAccessTokenCreateInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"CustomerAccessTokenCreateInput\"}],\"deprecated\":false,\"desc\":\"For legacy customer accounts only.\\n\\nCreates a [`CustomerAccessToken`](https://shopify.dev/docs/api/storefront/current/objects/CustomerAccessToken) using the customer's email and password. The access token is required to read or modify the [`Customer`](https://shopify.dev/docs/api/storefront/current/objects/Customer) object, such as updating account information or managing addresses.\\n\\nThe token has an expiration time. Use [`customerAccessTokenRenew`](https://shopify.dev/docs/api/storefront/current/mutations/customerAccessTokenRenew) to extend the token before it expires, or create a new token if it's already expired.\\n\\n> Caution:\\n> This mutation handles customer credentials. Always transmit requests over HTTPS and never log or expose the password.\\n\",\"gqltype\":\"CustomerAccessTokenCreatePayload\",\"list\":false,\"name\":\"customerAccessTokenCreate\",\"reqd\":false,\"type\":\"CustomerAccessTokenCreatePayload\"},\"invocation\":{\"doc\":\"mutation CustomerAccessTokenCreate($input: CustomerAccessTokenCreateInput!) { customerAccessTokenCreate(input: $input) { customerAccessToken { ...CustomerAccessTokenFields } } } fragment CustomerAccessTokenFields on CustomerAccessToken { accessToken expiresAt }\",\"field\":\"customerAccessTokenCreate\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"CustomerAccessTokenCreateInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"CustomerAccessTokenCreateInput\":{\"desc\":\"The input fields for authenticating a customer with email and password. Used by the [`customerAccessTokenCreate`](https://shopify.dev/docs/api/storefront/current/mutations/customerAccessTokenCreate) mutation to generate a [`CustomerAccessToken`](https://shopify.dev/docs/api/storefront/current/objects/CustomerAccessToken), which is required to read or modify customer data.\\n\",\"fields\":{\"email\":{\"args\":[],\"deprecated\":false,\"desc\":\"The email associated to the customer.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"email\",\"reqd\":true,\"type\":\"String\"},\"password\":{\"args\":[],\"deprecated\":false,\"desc\":\"The login password to be used by the customer.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"password\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CustomerAccessTokenCreateInput\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
