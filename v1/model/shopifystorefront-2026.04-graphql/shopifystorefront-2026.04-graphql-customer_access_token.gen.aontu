            doc: "mutation CustomerAccessTokenCreate($input: CustomerAccessTokenCreateInput!) { customerAccessTokenCreate(input: $input) { customerAccessToken { ...CustomerAccessTokenFields } } } fragment CustomerAccessTokenFields on CustomerAccessToken { accessToken expiresAt }"
            field: "customerAccessTokenCreate"
