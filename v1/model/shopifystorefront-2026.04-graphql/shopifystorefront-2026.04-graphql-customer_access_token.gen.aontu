          }
          contract: {
            id: "POST customerAccessTokenDelete"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"String!\",\"name\":\"customerAccessToken\",\"reqd\":true,\"type\":\"String\"}],\"deprecated\":false,\"desc\":\"Permanently destroys a [`CustomerAccessToken`](https://shopify.dev/docs/api/storefront/current/objects/CustomerAccessToken). Use this mutation when a customer explicitly signs out or when you need to revoke the token. Use [`customerAccessTokenCreate`](https://shopify.dev/docs/api/storefront/current/mutations/customerAccessTokenCreate) to generate a new token with the customer's credentials.\\n\\n> Caution:\\n> This action is irreversible. The customer needs to sign in again to obtain a new access token.\\n\",\"gqltype\":\"CustomerAccessTokenDeletePayload\",\"list\":false,\"name\":\"customerAccessTokenDelete\",\"reqd\":false,\"type\":\"CustomerAccessTokenDeletePayload\"},\"invocation\":{\"doc\":\"mutation CustomerAccessTokenRemove($customerAccessToken: String!) { customerAccessTokenDelete(customerAccessToken: $customerAccessToken) { deletedAccessToken deletedCustomerAccessTokenId } }\",\"field\":\"customerAccessTokenDelete\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"customerAccessToken\",\"gqltype\":\"String!\",\"name\":\"customerAccessToken\"}]},\"protocol\":\"graphql\",\"types\":{\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
            doc: "mutation CustomerAccessTokenRemove($customerAccessToken: String!) { customerAccessTokenDelete(customerAccessToken: $customerAccessToken) { deletedAccessToken deletedCustomerAccessTokenId } }"
            field: "customerAccessTokenDelete"
