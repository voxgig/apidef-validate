# Entity: mailing_address

main: kit: entity: mailing_address: {

  alias: field: {}

  fields: [
    {
      name: "address1"
      req: false
      short: "The first line of the address."
      type: "`$STRING`"
    }
    {
      name: "address2"
      req: false
      short: "The second line of the address."
      type: "`$STRING`"
    }
    {
      name: "city"
      req: false
      short: "The name of the city, district, village, or town."
      type: "`$STRING`"
    }
    {
      name: "company"
      req: false
      short: "The name of the customer's company or organization."
      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      short: "The name of the country."
      type: "`$STRING`"
    }
    {
      name: "countryCodeV2"
      req: false
      short: "The two-letter code for the country of the address."
      type: "`$STRING`"
    }
    {
      name: "firstName"
      req: false
      short: "The first name of the customer."
      type: "`$STRING`"
    }
    {
      name: "formatted"
      req: true
      short: "A formatted version of the address, customized by the provided arguments."
      type: "`$STRING`"
    }
    {
      name: "formattedArea"
      req: false
      short: "A comma-separated list of the values for city, province, and country."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "A globally-unique ID."
      type: "`$STRING`"
    }
    {
      name: "lastName"
      req: false
      short: "The last name of the customer."
      type: "`$STRING`"
    }
    {
      name: "latitude"
      req: false
      short: "The latitude coordinate of the customer address."
      type: "`$NUMBER`"
    }
    {
      name: "longitude"
      req: false
      short: "The longitude coordinate of the customer address."
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      short: "The full name of the customer, based on firstName and lastName."
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      short: "A unique phone number for the customer."
      type: "`$STRING`"
    }
    {
      name: "province"
      req: false
      short: "The region of the address, such as the province, state, or district."
      type: "`$STRING`"
    }
    {
      name: "provinceCode"
      req: false
      short: "The alphanumeric code for the region."
      type: "`$STRING`"
    }
    {
      name: "zip"
      req: false
      short: "The zip or postal code of the address."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "mailing_address"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "customer_access_token"
                orig: "customer_access_token"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          graphql: {
            doc: "mutation MailingAddressCreateCustomerAddressCreate($address: MailingAddressInput!, $customerAccessToken: String!) { customerAddressCreate(address: $address, customerAccessToken: $customerAccessToken) { customerAddress { ...MailingAddressFields } } } fragment MailingAddressFields on MailingAddress { address1 address2 city company country countryCodeV2 firstName formatted formattedArea id lastName latitude longitude name phone province provinceCode zip }"
            field: "customerAddressCreate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "MailingAddressInput!"
                name: "address"
              }
              {
                from: "customerAccessToken"
                gqltype: "String!"
                name: "customerAccessToken"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "customerAddressCreate"
          select: {
            "$action": "customer_address_create"
            exist: [
              "customer_access_token"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.customerAddressCreate.customerAddress`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "customer_access_token"
                orig: "customer_access_token"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          graphql: {
            doc: "mutation MailingAddressUpdateCustomerAddressUpdate($address: MailingAddressInput!, $customerAccessToken: String!, $id: ID!) { customerAddressUpdate(address: $address, customerAccessToken: $customerAccessToken, id: $id) { customerAddress { ...MailingAddressFields } } } fragment MailingAddressFields on MailingAddress { address1 address2 city company country countryCodeV2 firstName formatted formattedArea id lastName latitude longitude name phone province provinceCode zip }"
            field: "customerAddressUpdate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "MailingAddressInput!"
                name: "address"
              }
              {
                from: "customerAccessToken"
                gqltype: "String!"
                name: "customerAccessToken"
              }
              {
                from: "id"
                gqltype: "ID!"
                name: "id"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "customerAddressUpdate"
          select: {
            "$action": "customer_address_update"
            exist: [
              "customer_access_token"
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.customerAddressUpdate.customerAddress`"
          }
        }
      ]
    }
  }



}