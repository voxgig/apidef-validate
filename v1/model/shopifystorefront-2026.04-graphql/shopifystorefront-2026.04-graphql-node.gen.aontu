# Entity: node

main: kit: entity: node: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "A globally-unique ID."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "node"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "POST nodes"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "ids"
                or: "ids"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query NodeList($ids: [ID!]!) { nodes(ids: $ids) { ...NodeFields } } fragment NodeFields on Node { id }"
            field: "nodes"
            optype: "query"
            vars: [
              {
                from: "ids"
                gqltype: "[ID!]!"
                name: "ids"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "nodes"
          q: {
            exist: [
              "ids"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.nodes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST node"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query NodeLoad($id: ID!) { node(id: $id) { ...NodeFields } } fragment NodeFields on Node { id }"
            field: "node"
            optype: "query"
            vars: [
              {
                from: "id"
                gqltype: "ID!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "node"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.node`"
          }
        }
      ]
    }
  }



}