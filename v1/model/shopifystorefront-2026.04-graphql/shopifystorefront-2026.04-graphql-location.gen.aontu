nfo.endCursor\",\"more\":\"pageInfo.hasNextPage\",\"nodes\":\"nodes\",\"style\":\"relay\"},\"vars\":[{\"from\":\"after\",\"gqltype\":\"String\",\"name\":\"after\"},{\"from\":\"before\",\"gqltype\":\"String\",\"name\":\"before\"},{\"from\":\"first\",\"gqltype\":\"Int\",\"name\":\"first\"},{\"from\":\"last\",\"gqltype\":\"Int\",\"name\":\"last\"},{\"from\":\"\",\"gqltype\":\"GeoCoordinateInput\",\"name\":\"near\"},{\"from\":\"reverse\",\"gqltype\":\"Boolean\",\"name\":\"reverse\"},{\"from\":\"sortKey\",\"gqltype\":\"LocationSortKeys\",\"name\":\"sortKey\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"Float\":{\"desc\":\"The `Float` scalar type represents signed double-precision fractional values as specified by [IEEE 754](https://en.wikipedia.org/wiki/IEEE_floating_point).\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Float\"},\"GeoCoordinateInput\":{\"desc\":\"The input fields used to specify a geographical location.\",\"fields\":{\"latitude\":{\"args\":[],\"deprecated\":false,\"desc\":\"The coordinate's latitude value.\",\"gqltype\":\"Float!\",\"list\":false,\"name\":\"latitude\",\"reqd\":true,\"type\":\"Float\"},\"longitude\":{\"args\":[],\"deprecated\":false,\"desc\":\"The coordinate's longitude value.\",\"gqltype\":\"Float!\",\"list\":false,\"name\":\"longitude\",\"reqd\":true,\"type\":\"Float\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"GeoCoordinateInput\"},\"Int\":{\"desc\":\"The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Int\"},\"LocationSortKeys\":{\"desc\":\"The set of valid sort keys for the Location query.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"LocationSortKeys\",\"values\":[\"CITY\",\"DISTANCE\",\"ID\",\"NAME\"]},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
