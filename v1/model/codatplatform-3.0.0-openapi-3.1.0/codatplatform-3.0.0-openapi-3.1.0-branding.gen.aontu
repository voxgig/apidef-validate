# Entity: branding

main: kit: entity: branding: {

  alias: field: {}

  fields: [
    {
      name: "button"
      req: false
      short: "Button branding references."
      type: "`$OBJECT`"
    }
    {
      name: "logo"
      req: false
      short: "Logo branding references."
      type: "`$OBJECT`"
    }
    {
      name: "sourceId"
      req: false
      short: "A source-specific ID used to distinguish between different sources originating from the same data connection."
      type: "`$STRING`"
    }
  ]

  name: "branding"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "gbol"
                kind: "param"
                name: "platform_key"
                orig: "platform_key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/integrations/{platformKey}/branding"
          rename: {
            param: {
              platformKey: "platform_key"
            }
          }
          segments: [
            {
              lit: "integrations"
            }
            {
              var: "platform_key"
            }
            {
              lit: "branding"
            }
          ]
          select: {
            exist: [
              "platform_key"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "integration"
      ]
    ]
  }



}