# Entity: supplemental_data_config

main: kit: entity: supplemental_data_config: {

  alias: field: {}

  fields: [
    {
      name: "dataSource"
      req: false
      short: "The underlying endpoint of the source system which the configuration is targeting."
      type: "`$STRING`"
    }
    {
      name: "pullData"
      req: false
      short: "The additional properties that are required when pulling records."
      type: "`$OBJECT`"
    }
    {
      name: "pushData"
      req: false
      short: "The additional properties that are required to create and/or update records."
      type: "`$OBJECT`"
    }
  ]

  name: "supplemental_data_config"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "invoices"
                kind: "param"
                name: "data_type_id"
                orig: "data_type"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "gbol"
                kind: "param"
                name: "platform_key"
                orig: "platform_key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /integrations/{platformKey}/dataTypes/{dataType}/supplementalDataConfig"
            json: "{\"operationId\":\"get-supplemental-data-configuration\",\"parameters\":[{\"description\":\"A unique 4-letter key to represent a platform in each integration.\",\"in\":\"path\",\"name\":\"platformKey\",\"required\":true,\"schema\":{\"description\":\"A unique 4-letter key to represent a platform in each integration. View [accounting](https://docs.codat.io/integrations/accounting/overview#platform-keys), [banking](https://docs.codat.io/integrations/banking/overview#platform-keys), and [commerce](https://docs.codat.io/integrations/commerce/overview#platform-keys) platform keys.\",\"example\":\"gbol\",\"maxLength\":4,\"minLength\":4,\"pattern\":\"[a-z]{4}\",\"type\":\"string\"}},{\"description\":\"Supported supplemental data data type.\",\"in\":\"path\",\"name\":\"dataType\",\"required\":true,\"schema\":{\"description\":\"Data types that support supplemental data\",\"enum\":[\"chartOfAccounts\",\"bills\",\"company\",\"creditNotes\",\"customers\",\"invoices\",\"items\",\"journalEntries\",\"suppliers\",\"taxRates\",\"commerce-companyInfo\",\"commerce-customers\",\"commerce-disputes\",\"commerce-locations\",\"commerce-orders\",\"commerce-payments\",\"commerce-paymentMethods\",\"commerce-products\",\"commerce-productCategories\",\"commerce-taxComponents\",\"commerce-transactions\"],\"example\":\"invoices\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"\",\"examples\":[{\"supplementalDataConfig\":{\"orders-supplemental-data\":{\"dataSource\":\"/orders\",\"pullData\":{\"orderNumber\":\"order_num\"},\"pushData\":{\"orderNumber\":\"order_num\"}}}}],\"properties\":{\"supplementalDataConfig\":{\"additionalProperties\":{\"description\":\"The client's defined name for the object.\",\"properties\":{\"dataSource\":{\"description\":\"The underlying endpoint of the source system which the configuration is targeting. \",\"type\":\"string\"},\"pullData\":{\"additionalProperties\":{\