# Entity: webhook

main: kit: entity: webhook: {

  alias: field: {}

  fields: [
    {
      name: "companyTags"
      req: false
      short: "Company tags provide an additional way to filter messages, independent of event types."
      type: "`$ARRAY`"
    }
    {
      name: "disabled"
      req: false
      short: "Flag that enables or disables the endpoint from receiving events."
      type: "`$BOOLEAN`"
    }
    {
      name: "eventTypes"
      req: false
      short: "An array of event types the webhook consumer subscribes to."
      type: "`$ARRAY`"
    }
    {
      format: "uuid"
      name: "id"
      req: false
      short: "Unique identifier for the webhook consumer."
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: false
      short: "The URL that will consume webhook events dispatched by Codat."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "webhook"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /webhooks"
            json: "{\"operationId\":\"create-webhook-consumer\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"Subscribe consumer to one or more event types\":{\"value\":{\"eventTypes\":[\"DataSyncCompleted\",\"Dataset data changed\"],\"url\":\"https://example.com/webhoook-consumer\"}},\"Subscribe consumer with disabled endpoint\":{\"value\":{\"disabled\":true,\"eventTypes\":[\"DataSyncCompleted\"],\"url\":\"https://example.com/webhoook-consumer\"}}},\"schema\":{\"properties\":{\"companyTags\":{\"description\":\"Company tags provide an additional way to filter messages, independent of event types. Company tags are case-sensitive, and only messages from companies with matching tags will be sent to this endpoint. Use the format `tagKey:tagValue`.\",\"items\":{\"maxLength\":128,\"type\":\"string\"},\"maxItems\":10,\"nullable\":true,\"type\":\"array\"},\"disabled\":{\"default\":false,\"description\":\"Flag that enables or disables the endpoint from receiving events. Disabled when set to `true`.\",\"nullable\":true,\"type\":\"boolean\"},\"eventTypes\":{\"description\":\"An array of event types the webhook consumer subscribes to.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"url\":{\"description\":\"The URL that will consume webhook events dispatched by Codat.\",\"format\":\"uri\",\"type\":\"string\"}},\"title\":\"Create webhook consumer\",\"type\":\"object\"}}}},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"Subscribe consumer to one or more event types\":{\"value\":{\"disabled\":false,\"eventTypes\":[\"DataSyncCompleted\",\"DatasetDataChanged\"],\"id\":\"12571faf-0898-47e7-afdd-0fe9eb0a9bf5\",\"url\":\"https://example.com/webhoook-consumer\"}},\"Subscribe consumer with disabled endpoint\":{\"value\":{\"disabled\":true,\"eventTypes\":[\"DataSyncCompleted\"],\"id\":\"12571faf-0898-47e7-afdd-0fe9eb0a9bf5\",\"url\":\"https://example.com/webhoook-consumer\"}}},\"schema\":{\"def