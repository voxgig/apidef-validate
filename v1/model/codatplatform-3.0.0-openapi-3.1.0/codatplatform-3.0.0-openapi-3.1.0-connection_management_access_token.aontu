# Entity: connection_management_access_token

main: kit: entity: connection_management_access_token: {

  alias: field: {}

  fields: [
    {
      name: "accessToken"
      req: false
      short: "Access token that allows SMBs to manage connections that have access to their data."
      type: "`$STRING`"
    }
  ]

