        {
          contract: {
            id: "POST /profile/syncSettings"
            json: "{\"operationId\":\"update-profile-syncSettings\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"allOf\":[{\"properties\":{\"clientId\":{\"description\":\"Unique identifier for your client in Codat.\",\"format\":\"uuid\",\"title\":\"Client ID\",\"type\":\"string\"},\"overridesDefaults\":{\"default\":true,\"description\":\"Set to `True` if you want to override default [sync settings](https://docs.codat.io/knowledge-base/advanced-sync-settings).\",\"type\":\"boolean\"},\"settings\":{\"items\":{\"description\":\"Describes how often, and how much history, should be fetched for the given data type when a pull operation is queued.\",\"examples\":[{\"dataType\":\"invoices\",\"fetchOnFirstLink\":true,\"isLocked\":true,\"monthsToSync\":24,\"syncFromUtc\":\"2020-01-01T12:00:00.000Z\",\"syncFromWindow\":24,\"syncOrder\":0,\"syncSchedule\":24}],\"properties\":{\"dataType\":{\"description\":\"Available data types\",\"enum\":[\"accountTransactions\",\"balanceSheet\",\"bankAccounts\",\"bankTransactions\",\"billCreditNotes\",\"billPayments\",\"bills\",\"cashFlowStatement\",\"chartOfAccounts\",\"company\",\"creditNotes\",\"customers\",\"directCosts\",\"directIncomes\",\"invoices\",\"itemReceipts\",\"items\",\"journalEntries\",\"journals\",\"paymentMethods\",\"payments\",\"profitAndLoss\",\"purchaseOrders\",\"salesOrders\",\"suppliers\",\"taxRates\",\"trackingCategories\",\"transfers\",\"banking-accountBalances\",\"banking-accounts\",\"banking-transactionCategories\",\"banking-transactions\",\"commerce-companyInfo\",\"commerce-customers\",\"commerce-disputes\",\"commerce-locations\",\"commerce-orders\",\"commerce-paymentMethods\",\"commerce-payments\",\"commerce-productCategories\",\"commerce-products\",\"commerce-taxComponents\",\"commerce-transactions\"],\"example\":\"invoices\",\"title\":\"Data types\",\"type\":\"string\"},\"fetchOnFirstLink\":{\"description\":\"Whether this data type should be queued after a company has authorized a connection.\",\"type\":\"boolean\"},\"isLocked\":{\"description\":\"`True` if the [sync setting](https://docs.codat.io/knowledge-base/advanced-sync-settings) is locked.\",\"type\":\"boolean\"},\"monthsToSync\":{\"description\":\"Months of data to fetch, for report data types (`balanceSheet` & `profitAndLoss`) only.\",\"example\":24,\"type\":\"integer\"},\"syncFromUtc\":{\"description\":\"Date from which data should be fetched. Set this *or* `syncFromWindow`.\",\"examples\":[\"2022-10-23T00:00:00.000Z\",\"2022-10-23T00:00:00.000Z\"],\"title\":\"Date time\",\"type\":\"string\"},\"syncFromWindow\":{\"description\":\"Number of months of data to be fetched. Set this *or* `syncFromUTC`.\",\"example\":24,\"type\":\"integer\"},\"syncOrder\":{\"description\":\"The sync in which data types are queued for a sync.\",\"type\":\"integer\"},\"syncSchedule\":{\"description\":\"Number of hours after which this data type should be refreshed.\",\"example\":24,\"type\":\"integer\"}},\"required\":[\"dataType\",\"fetchOnFirstLink\",\"syncSchedule\",\"syncOrder\"],\"title\":\"SyncSetting\",\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"clientId\",\"settings\",\"overridesDefaults\"]}],\"type\":\"object\"}}},\"description\":\"Include a `syncSetting` object for each data type.\\n`syncFromWindow`, `syncFromUTC` & `monthsToSync` only need to be included if you wish to set a value for them.\"},\"responses\":{\"204\":{\"description\":\"No Content\"},\"401\":{\"content\":{\"application/json\":{\"examples\":{\"Unauthorized\":{\"value\":{\"canBeRetried\":\"Unknown\",\"correlationId\":\"7eb40d6b415d7bcd99ce658268284056\",\"detailedErrorCode\":0,\"error\":\"Unauthorized\",\"service\":\"PublicApi\",\"statusCode\":401}}},\"schema\":{\"definitions\":{\"errorValidation\":{\"description\":\"A human-readable object describing validation decisions Codat has made. If an operation has failed because of validation errors, they will be detailed here.\",\"nullable\":true,