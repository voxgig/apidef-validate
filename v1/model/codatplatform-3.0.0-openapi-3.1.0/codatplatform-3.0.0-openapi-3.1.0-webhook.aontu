# Entity: webhook

main: kit: entity: webhook: {

  alias: field: {}

  fields: [
    {
      name: "companyTags"
      req: false
      short: "Company tags provide an additional way to filter messages, independent of event types."
      type: "`$ARRAY`"
    }
    {
      name: "disabled"
      req: false
      short: "Flag that enables or disables the endpoint from receiving events."
      type: "`$BOOLEAN`"
    }
    {
      name: "eventTypes"
      req: false
      short: "An array of event types the webhook consumer subscribes to."
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the webhook consumer."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "The URL that will consume webhook events dispatched by Codat."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "webhook"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/webhooks"
          parts: [
            "webhooks"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/webhooks"
          parts: [
            "webhooks"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                example: "8a210b68-6988-11ed-a1eb-0242ac120002"
                kind: "param"
                name: "id"
                orig: "webhook_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/webhooks/{webhookId}"
          parts: [
            "webhooks"
            "{id}"
          ]
          rename: {
            param: {
              webhookId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}