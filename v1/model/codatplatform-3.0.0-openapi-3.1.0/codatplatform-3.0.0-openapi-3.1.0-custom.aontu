          method: "GET"
          orig: "/integrations/{platformKey}/dataTypes/custom/{customDataIdentifier}"
          rename: {
            param: {
              customDataIdentifier: "id"
              platformKey: "platform_key"
            }
          }
          segments: [
            {
              lit: "integrations"
            }
            {
              var: "platform_key"
            }
            {
              lit: "dataTypes"
            }
            {
              lit: "custom"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "platform_key"
            ]
          }
