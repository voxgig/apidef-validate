            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                example: "DynamicsPurchaseOrders"
                kind: "param"
                name: "id"
                orig: "custom_data_identifier"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "gbol"
                kind: "param"
                name: "platform_key"
                orig: "platform_key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "PUT /integrations/{platformKey}/dataTypes/custom/{customDataIdentifier}"
            json: "{\"operationId\":\"configure-custom-data-type\",\"parameters\":[{\"description\":\"A unique 4-letter key to represent a platform in each integration.\",\"in\":\"path\",\"name\":\"platformKey\",\"required\":true,\"schema\":{\"description\":\"A unique 4-letter key to represent a platform in each integration. View [accounting](https://docs.codat.io/integrations/accounting/overview#platform-keys), [banking](https://docs.codat.io/integrations/banking/overview#platform-keys), and [commerce](https://docs.codat.io/integrations/commerce/overview#platform-keys) platform keys.\",\"example\":\"gbol\",\"maxLength\":4,\"minLength\":4,\"pattern\":\"[a-z]{4}\",\"type\":\"string\"}},{\"description\":\"Unique identifier for a custom data type.\",\"in\":\"path\",\"name\":\"customDataIdentifier\",\"required\":true,\"schema\":{\"example\":\"DynamicsPurchaseOrders\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"Dynamics 365 Business Central\":{\"value\":{\"dataSource\":\"api/purchaseOrders\",\"keyBy\":[\"$[*].id\"],\"requiredData\":{\"currency\":\"$[*].currencyCode\",\"date\":\"$[*].orderDate\",\"number\":\"$[*].number\",\"totalexvat\":\"$[*].totalAmountExcludingTax\",\"totaltax\":\"$[*].totalTaxAmount\",\"vendor\":\"$[*].number\"},\"sourceModifiedDate\":[\"$[*].lastModifiedDateTime\"]}},\"QuickBooks Online\":{\"value\":{\"dataSource\":\"/query?query=select * from Account\",\"keyBy\":[\"$.Id\"],\"requiredData\":{\"Currentbal\":\"$.CurrentBalance\",\"SubAcc\":\"$.SubAccount\",\"id\":\"$.Id\"},\"sourceModifiedDate\":[\"$.time\"]}},\"Xero Mapping Arrays\":{\"value\":{\"dataSource\":\"/api.xro/2.0/Invoices\",\"keyBy\":[\"$.InvoiceID\"],\"requiredData\":{\"InvoiceID\":\"$.InvoiceID\",\"invNumber\":\"$.InvoiceNumber\",\"lines\":\"$.LineItems[*]\",\"type\":\"$.Type\"},\"sourceModifiedDate\":[\"$.UpdatedDateUTC\"]}},\"Xero Simple Record\":{\"value\":{\"dataSource\":\"/api.xro/2.0/Accounts\",\"keyBy\":[\"$.AccountID\"],\"requiredData\":{\"SysAcc\":\"$.SystemAccount\",\"accountId\":\"$.AccountID\",\"code\":\"$.Code\",\"type\":\"$.Type\"}}}},\"schema\":{\"description\":\"Client's configuration details for a specific custom data type and platform pair.\",\"examples\":[{\"dataSource\":\"api/purchaseOrders?$filter=currencyCode eq 'NOK'\",\"keyBy\":[\"$[*].id\"],\"requiredData\":{\"currencyCode\":\"$[*].currencyCode\",\"id\":\"$[*].id\",\"number\":\"$[*].number\",\"orderDate\":\"$[*].orderDate\",\"totalAmountExcludingTax\":\"$[*].totalAmountExcludingTax\",\"totalTaxAmount\":\"$[*].totalTaxAmount\",\"vendorName\":\"$[*].number\"},\"sourceModifiedDate\":[\"$[*].lastModifiedDateTime\"]}],\"properties\":{\"dataSource\":{\"description\":\"Underlying endpoint of the source platform that will serve as a data source for the custom data type. This value is not validated by Codat.\",\"type\":\"string\"},\"keyBy\":{\"description\":\"An array of properties from the source system that can be used to uniquely identify the records returned for the custom data type. This value is not validated by Codat.\",\"items\":{\"type\":\"string\"},\"minLength\":1,\"type\":\"array\"},\"requiredData\":{\"additionalProperties\":{\"description\":\"The client's defined name for the property with the value being the source system's property name which the mapping is targeting.\",\"type\":\"string\"},\"description\":\"Properties required to be fetched from the underlying platform for the custom data type that is being configured. This value is not validated by Codat.\",\"type\":\"object\"},\"sourceModifiedDate\":{\"description\":\"Property in the source platform nominated by the client that defines the date when a record was last modified there. This value is not validated by Codat.\",\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}},\"title\":\"Custom data type configuration\",\"type\":\"object\"}}},\"description\":\"Custom data type configuration for the specified platform.\"},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"Dynamics 365 Business Central\":{\"value\":{\"dataSource\":\"api/purchaseOrders\",\"keyBy\":[\"$[*].id\"],\"requiredData\":{\"currency\":\"$[*].currencyCode\",\"date\":\"$[*].orderDate\",\"number\":\"$[*].number\",\"totalexvat\":\"$[*].totalAmountExcludingTax\",\"totaltax\":\"$[*].totalTaxAmount\",\"vendor\":\"$[*].number\"},\"sourceModifiedDate\":[\"$[*].lastModifiedDateTime\"]}},\"QuickBooks Online\":{\"value\":{\"dataSource\":\"/query?query=select * from Account\",\"keyBy\":[\"$.Id\"],\"requiredData\":{\"Currentbal\":\"$.CurrentBalance\",\"SubAcc\":\"$.SubAccount\",\"id\":\"$.Id\"},\"sourceModifiedDate\":[\"$.time\"]}},\"Xero Mapping Arrays\":{\"value\":{\"dataSource\":\"/api.xro/2.0/Invoices\",\"keyBy\":[\"$.InvoiceID\"],\"requiredData\":{\"InvoiceID\":\"$.InvoiceID\",\"invNumber\":\"$.InvoiceNumber\",\"lines\":\"$.LineItems[*]\",\"type\":\"$.Type\"},\"sourceModifiedDate\":[\"$.UpdatedDateUTC\"]}},\"Xero Simple Record\":{\"value\":{\"dataSource\":\"/api.xro/2.0/Accounts\",\"keyBy\":[\"$.AccountID\"],\"requiredData\":{\"SysAcc\":\"$.SystemAccount\",\"accountId\":\"$.AccountID\",\"code\":\"$.Code\",\"type\":\"$.Type\"}}}},\"schema\":{\"description\":\"Client's configuration details for a specific custom data type and platform pair.\",\"examples\":[{\"dataSource\":\"api/purchaseOrders?$filter=currencyCode eq 'NOK'\",\"keyBy\":[\"$[*].id\"],\"requiredData\":{\"currencyCode\":\"$[*].currencyCode\",\"id\":\"$[*].id\",\"number\":\"$[*].number\",\"orderDate\":\"$[*].orderDate\",\"totalAmountExcludingTax\":\"$[*].totalAmountExcludingTax\",\"totalTaxAmount\":\"$[*].totalTaxAmount\",\"vendorName\":\"$[*].number\"},\"sourceModifiedDate\":[\"$[*].lastModifiedDateTime\"]}],\"properties\":{\"dataSource\":{\"description\":\"Underlying endpoint of the source platform that will serve as a data source for the custom data type. This value is not validated by Codat.\",\"type\":\"string\"},\"keyBy\":{\"description\":\"An 