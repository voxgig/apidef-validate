# Entity: integration

main: kit: entity: integration: {

  alias: field: {}

  fields: {
    dataProvidedBy: {
      h: "Data Provided By"
      n: "dataProvidedBy"
      r: false
      sh: "The name of the data provider."
      t: "`$STRING`"
    }
    datatypeFeatures: {
      h: "Datatype Features"
      n: "datatypeFeatures"
      r: false
      t: "`$ARRAY`"
    }
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: true
      sh: "Whether this integration is enabled for your customers to use."
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    integrationId: {
      fo: "uuid"
      h: "Integration Id"
      n: "integrationId"
      r: false
      sh: "A Codat ID representing the integration."
      t: "`$STRING`"
    }
    isBeta: {
      h: "Is Beta"
      n: "isBeta"
      r: false
      sh: "`True` if the integration is currently in beta release."
      t: "`$BOOLEAN`"
    }
    isOfflineConnector: {
      h: "Is Offline Connector"
      n: "isOfflineConnector"
      r: false
      sh: "`True` if the integration is to an application installed and run locally on an SMBs computer."
      t: "`$BOOLEAN`"
    }
    key: {
      h: "Key"
      n: "key"
      r: true
      sh: "A unique 4-letter key to represent a platform in each integration."
      t: "`$STRING`"
    }
    links: {
      h: "Links"
      n: "links"
      r: true
      t: "`$OBJECT`"
    }
    logoUrl: {
      fo: "uri"
      h: "Logo Url"
      n: "logoUrl"
      r: true
      sh: "Static url for integration's logo."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Name of integration."
      t: "`$STRING`"
    }
    pageNumber: {
      h: "Page Number"
      n: "pageNumber"
      r: true
      sh: "Current page number."
      t: "`$INTEGER`"
    }
    pageSize: {
      h: "Page Size"
      n: "pageSize"
      r: true
      sh: "Number of items to return in results array."
      t: "`$INTEGER`"
    }
    results: {
      h: "Results"
      n: "results"
      r: false
      t: "`$ARRAY`"
    }
    sourceId: {
      fo: "uuid"
      h: "Source Id"
      n: "sourceId"
      r: false
      sh: "A source-specific ID used to distinguish between different sources originating from the same data connection."
      t: "`$STRING`"
    }
    sourceType: {
      h: "Source Type"
      n: "sourceType"
      r: false
      sh: "The type of platform of the connection."
      t: "`$STRING`"
    }
    totalResults: {
      h: "Total Results"
      n: "totalResults"
      r: true
      sh: "Total number of items."
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "integration"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "-modifiedDate"
                kind: "query"
                name: "order_by"
                orig: "order_by"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 100
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "id=e3334455-1aed-4e71-ab43-6bccf12092ee"
                kind: "query"
                name: "query"
                orig: "query"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /integrations"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/integrations"
          segments: [
            {
              lit: "integrations"
            }
          ]
          select: {
            exist: [
              "order_by"
              "page"
              "page_size"
              "query"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "gbol"
                kind: "param"
                name: "id"
                orig: "platform_key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /integrations/{platformKey}"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/integrations/{platformKey}"
          rename: {
            param: {
              platformKey: "id"
            }
          }
          segments: [
            {
              lit: "integrations"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "integration"
      ]
    ]
  }



}