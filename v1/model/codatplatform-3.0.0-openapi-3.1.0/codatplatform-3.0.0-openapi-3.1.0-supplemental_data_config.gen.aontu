# Entity: supplemental_data_config

main: kit: entity: supplemental_data_config: {

  alias: field: {}

  fields: [
    {
      name: "dataSource"
      req: false
      short: "The underlying endpoint of the source system which the configuration is targeting."
      type: "`$STRING`"
    }
    {
      name: "pullData"
      req: false
      short: "The additional properties that are required when pulling records."
      type: "`$OBJECT`"
    }
    {
      name: "pushData"
      req: false
      short: "The additional properties that are required to create and/or update records."
      type: "`$OBJECT`"
    }
  ]

  name: "supplemental_data_config"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "invoices"
                kind: "param"
                name: "data_type_id"
                orig: "data_type"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "gbol"
                kind: "param"
                name: "platform_key"
                orig: "platform_key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/integrations/{platformKey}/dataTypes/{dataType}/supplementalDataConfig"
          rename: {
            param: {
              dataType: "data_type_id"
              platformKey: "platform_key"
            }
          }
          segments: [
            {
              lit: "integrations"
            }
            {
              var: "platform_key"
            }
            {
              lit: "dataTypes"
            }
            {
              var: "data_type_id"
            }
            {
              lit: "supplementalDataConfig"
            }
          ]
          select: {
            exist: [
              "data_type_id"
              "platform_key"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.supplementalDataConfig`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "integration"
        "data_type"
      ]
    ]
  }



}