# Entity: custom

main: kit: entity: custom: {

  alias: field: {}

  fields: [
    {
      name: "dataSource"
      req: false
      short: "Underlying endpoint of the source platform that will serve as a data source for the custom data type."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "keyBy"
      req: false
      short: "An array of properties from the source system that can be used to uniquely identify the records returned for the custom data type."
      type: "`$ARRAY`"
    }
    {
      name: "pageNumber"
      req: false
      short: "Current page number."
      type: "`$INTEGER`"
    }
    {
      name: "pageSize"
      req: false
      short: "Number of items to return in results array."
      type: "`$INTEGER`"
    }
    {
      name: "requiredData"
      req: false
      short: "Properties required to be fetched from the underlying platform for the custom data type that is being configured."
      type: "`$OBJECT`"
    }
    {
      name: "results"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "sourceModifiedDate"
      req: false
      short: "Property in the source platform nominated by the client that defines the date when a record was last modified there."
      type: "`$ARRAY`"
    }
    {
      name: "totalResults"
      req: false
      short: "Total number of items."
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "custom"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "8a210b68-6988-11ed-a1eb-0242ac120002"
                kind: "param"
                name: "company_id"
                orig: "company_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "2e9d2c44-f675-40ba-8049-353bfcb5e171"
                kind: "param"
                name: "connection_id"
                orig: "connection_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "DynamicsPurchaseOrders"
                kind: "param"
                name: "id"
                orig: "custom_data_identifier"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 100
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/companies/{companyId}/connections/{connectionId}/data/custom/{customDataIdentifier}"
          rename: {
            param: {
              companyId: "company_id"
              connectionId: "connection_id"
              customDataIdentifier: "id"
            }
          }
          segments: [
            {
              lit: "companies"
            }
            {
              var: "company_id"
            }
            {
              lit: "connections"
            }
            {
              var: "connection_id"
            }
            {
              lit: "data"
            }
            {
              lit: "custom"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "company_id"
              "connection_id"
              "id"
              "page"
              "page_size"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                example: "DynamicsPurchaseOrders"
                kind: "param"
                name: "id"
                orig: "custom_data_identifier"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "gbol"
                kind: "param"
                name: "platform_key"
                orig: "platform_key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/integrations/{platformKey}/dataTypes/custom/{customDataIdentifier}"
          rename: {
            param: {
              customDataIdentifier: "id"
              platformKey: "platform_key"
            }
          }
          segments: [
            {
              lit: "integrations"
            }
            {
              var: "platform_key"
            }
            {
              lit: "dataTypes"
            }
            {
              lit: "custom"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "platform_key"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                example: "DynamicsPurchaseOrders"
                kind: "param"
                name: "id"
                orig: "custom_data_identifier"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "gbol"
                kind: "param"
                name: "platform_key"
                orig: "platform_key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PUT"
          orig: "/integrations/{platformKey}/dataTypes/custom/{customDataIdentifier}"
          rename: {
            param: {
              customDataIdentifier: "id"
              platformKey: "platform_key"
            }
          }
          segments: [
            {
              lit: "integrations"
            }
            {
              var: "platform_key"
            }
            {
              lit: "dataTypes"
            }
            {
              lit: "custom"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "platform_key"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "integration"
      ]
      [
        "company"
        "connection"
      ]
    ]
  }



}