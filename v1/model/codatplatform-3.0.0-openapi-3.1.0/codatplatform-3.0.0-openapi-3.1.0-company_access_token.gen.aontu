      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    tokenType: {
      h: "Token Type"
      n: "tokenType"
      r: true
      sh: "The type of token."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "company_access_token"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "8a210b68-6988-11ed-a1eb-0242ac120002"
                kind: "param"
                name: "id"
                orig: "company_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /companies/{companyId}/accessToken"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/companies/{companyId}/accessToken"
          rename: {
            param: {
              companyId: "id"
            }
          }
          segments: [
            {
              lit: "companies"
            }
            {
              var: "id"
            }
            {
              lit: "accessToken"
            }
          ]
          select: {
            exist: [
