# Entity: search

main: kit: entity: search: {

  alias: field: {}

  fields: {
    epics: {
      h: "Epics"
      n: "epics"
      r: true
      sh: "The results of the Epic search query."
      t: "`$OBJECT`"
    }
    iterations: {
      h: "Iterations"
      n: "iterations"
      r: true
      sh: "The results of the Iteration search query."
      t: "`$OBJECT`"
    }
    milestones: {
      h: "Milestones"
      n: "milestones"
      r: true
      sh: "The results of the Objective search query."
      t: "`$OBJECT`"
    }
    stories: {
      h: "Stories"
      n: "stories"
      r: true
      sh: "The results of the Story search query."
      t: "`$OBJECT`"
    }
  }

  name: "search"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/v3/search"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "detail"
                or: "detail"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "entity_type"
                or: "entity_type"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "next"
                or: "next"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "page_size"
                or: "page_size"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "query"
                or: "query"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v3/search"
          q: {
            exist: [
              "detail"
              "entity_type"
              "next"
              "page_size"
              "query"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "search"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}