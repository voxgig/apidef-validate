# Entity: story_comment

main: kit: entity: story_comment: {

  alias: field: {}

  fields: {
    app_url: {
      h: "App Url"
      n: "app_url"
      r: true
      sh: "The Shortcut application url for the Comment."
      t: "`$STRING`"
    }
    author_id: {
      fo: "uuid"
      h: "Author Id"
      n: "author_id"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The unique ID of the Member who is the Comment's author."
      t: "`$STRING`"
    }
    blocker: {
      h: "Blocker"
      n: "blocker"
      r: false
      sh: "Marks the comment as a blocker that can be surfaced to permissions or teams mentioned in the comment."
      t: "`$BOOLEAN`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The time/date when the Comment was created."
      t: "`$STRING`"
    }
    deleted: {
      h: "Deleted"
      n: "deleted"
      r: true
      sh: "True/false boolean indicating whether the Comment has been deleted."
      t: "`$BOOLEAN`"
    }
    entity_type: {
      h: "Entity Type"
      n: "entity_type"
      r: true
      sh: "A string description of this resource."
      t: "`$STRING`"
    }
    external_id: {
      h: "External Id"
      n: "external_id"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "This field can be set to another unique ID."
      t: "`$STRING`"
    }
