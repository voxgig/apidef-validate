      h: "Group Mention Ids"
      n: "group_mention_ids"
      r: true
      sh: "The unique IDs of the Group who are mentioned in the Comment."
      t: "`$ARRAY`"
    }
    id: {
      fo: "int64"
      h: "Id"
      n: "id"
      r: true
      sh: "The unique ID of the Comment."
      t: "`$INTEGER`"
    }
    linked_to_slack: {
      h: "Linked To Slack"
      n: "linked_to_slack"
      r: true
      sh: "Whether the Comment is currently the root of a thread that is linked to Slack."
      t: "`$BOOLEAN`"
    }
    member_mention_ids: {
      h: "Member Mention Ids"
      n: "member_mention_ids"
      r: true
      sh: "The unique IDs of the Member who are mentioned in the Comment."
      t: "`$ARRAY`"
    }
    mention_ids: {
      h: "Mention Ids"
      n: "mention_ids"
      r: true
      sh: "`Deprecated:` use `member_mention_ids`."
      t: "`$ARRAY`"
    }
    parent_id: {
      fo: "int64"
      h: "Parent Id"
      n: "parent_id"
      r: false
      sh: "The ID of the parent Comment this Comment is threaded under."
      t: "`$INTEGER`"
    }
    position: {
      fo: "int64"
      h: "Position"
      n: "position"
      r: true
      sh: "The Comments numerical position in the list from oldest to newest."
      t: "`$INTEGER`"
    }
    reactions: {
      h: "Reactions"
      n: "reactions"
      r: true
      sh: "A set of Reactions to this Comment."
      t: "`$ARRAY`"
    }
    story_id: {
      fo: "int64"
      h: "Story Id"
      n: "story_id"
      r: true
      sh: "The ID of the Story on which the Comment appears."
      t: "`$INTEGER`"
    }
    text: {
      h: "Text"
      n: "text"
      r: true
      sh: "The text of the Comment."
      t: "`$STRING`"
    }
    unblocks_parent: {
      h: "Unblocks Parent"
      n: "unblocks_parent"
      r: false
      sh: "Marks the comment as an unblocker to its blocker parent."
      t: "`$BOOLEAN`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The time/date when the Comment was updated."
      t: "`$STRING`"
    }
  }

