# Entity: repository

main: kit: entity: repository: {

  alias: field: {}

  fields: {
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "The time/date the Repository was created."
      t: "`$STRING`"
    }
    entity_type: {
      h: "Entity Type"
      n: "entity_type"
      r: true
      sh: "A string description of this resource."
      t: "`$STRING`"
    }
    external_id: {
      h: "External Id"
      n: "external_id"
      r: true
      sh: "The VCS unique identifier for the Repository."
      t: "`$STRING`"
    }
    full_name: {
      h: "Full Name"
      n: "full_name"
      r: true
      sh: "The full name of the VCS repository."
      t: "`$STRING`"
    }
    id: {
      fo: "int64"
      h: "Id"
      n: "id"
      r: true
      sh: "The ID associated to the VCS repository in Shortcut."
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The shorthand name of the VCS repository."
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "The VCS provider for the Repository."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "The time/date the Repository was updated."
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The URL of the Repository."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "repository"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /api/v3/repositories"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/api/v3/repositories"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "repositories"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "repo_public_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /api/v3/repositories/{repo-public-id}"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/api/v3/repositories/{repo-public-id}"
          rename: {
            param: {
              "repo-public-id": "id"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "repositories"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}