# Entity: repository

main: kit: entity: repository: {

  alias: field: {}

  fields: [
    {
      name: "created_at"
      req: true
      short: "The time/date the Repository was created."
      type: "`$STRING`"
    }
    {
      name: "entity_type"
      req: true
      short: "A string description of this resource."
      type: "`$STRING`"
    }
    {
      name: "external_id"
      req: true
      short: "The VCS unique identifier for the Repository."
      type: "`$STRING`"
    }
    {
      name: "full_name"
      req: true
      short: "The full name of the VCS repository."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The ID associated to the VCS repository in Shortcut."
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: true
      short: "The shorthand name of the VCS repository."
      type: "`$STRING`"
    }
    {
      name: "type"
      req: true
      short: "The VCS provider for the Repository."
      type: "`$STRING`"
    }
    {
      name: "updated_at"
      req: true
      short: "The time/date the Repository was updated."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "The URL of the Repository."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "repository"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api/v3/repositories"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "repositories"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "repo_public_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v3/repositories/{repo-public-id}"
          rename: {
            param: {
              "repo-public-id": "id"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "repositories"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}