ring\"}},\"required\":[\"external_id\",\"url\"],\"type\":\"object\"},\"task_ids\":{\"description\":\"An array of IDs of Tasks attached to the story.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"updated_at\":{\"description\":\"The time/date the Story was updated.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"workflow_id\":{\"description\":\"The ID of the workflow the story belongs to.\",\"format\":\"int64\",\"type\":\"integer\"},\"workflow_state_id\":{\"description\":\"The ID of the workflow state the story is currently in.\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"app_url\",\"archived\",\"started\",\"story_links\",\"entity_type\",\"labels\",\"task_ids\",\"mention_ids\",\"member_mention_ids\",\"story_type\",\"file_ids\",\"num_tasks_completed\",\"workflow_id\",\"completed_at_override\",\"started_at\",\"completed_at\",\"name\",\"global_id\",\"completed\",\"blocker\",\"epic_id\",\"story_template_id\",\"external_links\",\"previous_iteration_ids\",\"requested_by_id\",\"iteration_id\",\"label_ids\",\"started_at_override\",\"group_id\",\"workflow_state_id\",\"updated_at\",\"group_mention_ids\",\"follower_ids\",\"owner_ids\",\"external_id\",\"id\",\"estimate\",\"position\",\"blocked\",\"project_id\",\"linked_file_ids\",\"deadline\",\"stats\",\"comment_ids\",\"created_at\",\"moved_at\"],\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Resource\"},\"400\":{\"description\":\"Schema mismatch\"},\"404\":{\"description\":\"Resource does not exist\"},\"422\":{\"description\":\"Unprocessable\"}},\"security\":[{\"api_token\":[]}],\"securitySchemes\":{\"api_token\":{\"in\":\"header\",\"name\":\"Shortcut-Token\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
