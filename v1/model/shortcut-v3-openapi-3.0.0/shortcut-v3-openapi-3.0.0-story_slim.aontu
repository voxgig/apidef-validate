 resource.\",\"type\":\"string\"},\"id\":{\"description\":\"The unique identifier of the Story Link.\",\"format\":\"int64\",\"type\":\"integer\"},\"object_id\":{\"description\":\"The ID of the object Story.\",\"format\":\"int64\",\"type\":\"integer\"},\"subject_id\":{\"description\":\"The ID of the subject Story.\",\"format\":\"int64\",\"type\":\"integer\"},\"subject_workflow_state_id\":{\"description\":\"The workflow state of the \\\"subject\\\" story.\",\"format\":\"int64\",\"type\":\"integer\"},\"type\":{\"description\":\"This indicates whether the Story is the subject or object in the Story Link.\",\"type\":\"string\"},\"updated_at\":{\"description\":\"The time/date when the Story Link was last updated.\",\"format\":\"date-time\",\"type\":\"string\"},\"verb\":{\"description\":\"How the subject Story acts on the object Story. This can be \\\"blocks\\\", \\\"duplicates\\\", or \\\"relates to\\\".\",\"type\":\"string\"}},\"required\":[\"entity_type\",\"object_id\",\"verb\",\"type\",\"updated_at\",\"id\",\"subject_id\",\"subject_workflow_state_id\",\"created_at\"],\"type\":\"object\"},\"type\":\"array\"},\"story_template_id\":{\"description\":\"The ID of the story template used to create this story, or null if not created using a template.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"story_type\":{\"description\":\"The type of story (feature, bug, chore).\",\"type\":\"string\"},\"sub_task_story_ids\":{\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"synced_item\":{\"additionalProperties\":false,\"description\":\"The synced item for the story.\",\"properties\":{\"external_id\":{\"description\":\"The id used to reference an external entity.\",\"type\":\"string\"},\"url\":{\"description\":\"The url to the external entity.\",\"type\":\"string\"}},\"required\":[\"external_id\",\"url\"],\"type\":\"object\"},\"task_ids\":{\"description\":\"An array of IDs of Tasks attached to the story.\",\"items\":{\"format\":\"int64\",\"type\"