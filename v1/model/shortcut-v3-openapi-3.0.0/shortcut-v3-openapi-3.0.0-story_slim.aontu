    update: {
      name: "update"
      points: [
        {
          contract: {
            id: "PUT /api/v3/stories/bulk"
            json: "{\"operationId\":\"updateMultipleStories\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"after_id\":{\"description\":\"The ID of the story that the stories are to be moved below.\",\"format\":\"int64\",\"type\":\"integer\"},\"archived\":{\"description\":\"If the Stories should be archived or not.\",\"type\":\"boolean\"},\"before_id\":{\"description\":\"The ID of the story that the stories are to be moved before.\",\"format\":\"int64\",\"type\":\"integer\"},\"custom_fields_add\":{\"description\":\"A map specifying a CustomField ID and CustomFieldEnumValue ID that represents an assertion of some value for a CustomField.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"field_id\":{\"description\":\"The unique public ID for the CustomField.\",\"format\":\"uuid\",\"type\":\"string\"},\"value\":{\"description\":\"A literal value for the CustomField. Currently ignored.\",\"type\":\"string\"},\"value_id\":{\"description\":\"The unique public ID for the CustomFieldEnumValue.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"field_id\",\"value_id\"],\"type\":\"object\"},\"type\":\"array\"},\"custom_fields_remove\":{\"description\":\"A map specifying a CustomField ID and CustomFieldEnumValue ID that represents an assertion of some value for a CustomField.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"field_id\":{\"description\":\"The unique public ID for the CustomField.\",\"format\":\"uuid\",\"type\":\"string\"},\"value\":{\"description\":\"A literal value for the CustomField. Currently ignored.\",\"type\":\"string\"},\"value_id\":{\"description\":\"The unique public ID for the CustomFieldEnumValue.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"field_id\",\"value_id\"],\"type\":\"object\"},\"type\":\"array\"},\"deadline\":{\"description\":\"The due date of the story.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"epic_id\":{\"description\":\"The ID of the epic the story belongs to.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"estimate\":{\"description\":\"The numeric point estimate of the story. Can also be null, which means unestimated.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"external_links\":{\"description\":\"An array of External Links associated with this story.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"follower_ids_add\":{\"description\":\"The UUIDs of the new followers to be added.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"follower_ids_remove\":{\"description\":\"The UUIDs of the followers to be removed.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"group_id\":{\"description\":\"The Id of the Group the Stories should belong to.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"iteration_id\":{\"description\":\"The ID of the iteration the story belongs to.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"labels_add\":{\"description\":\"An array of labels to be added.\",\"items\":{\"additionalProperties\":false,\"description\":\"Request parameters for creating a Label on a Shortcut Story.\",\"properties\":{\"color\":{\"description\":\"The hex color to be displayed with the Label (for example, \\\"#ff0000\\\").\",\"format\":\"css-color\",\"minLength\":1,\"pattern\":\"^#[a-fA-F0-9]{6}$\",\"type\":\"string\"},\"description\":{\"description\":\"The description of the new Label.\",\"maxLength\":1024,\"type\":\"string\"},\"external_id\":{\"description\":\"This field can be set to another unique ID. In the case that the Label has been imported from another tool, the ID in the other tool can be indicated here.\",\"maxLength\":128,\"minLength\":1,\"type\":\"string\"},\"name\":{\"description\":\"The name of the new Label.\",\"maxLength\":128,\"minLength\":1,\"type\":\"string\"}},\"required\":[\"name\"],\"type\":\"object\"},\"type\":\"array\"},\"labels_remove\":{\"description\":\"An array of labels to be removed.\",\"items\":{\"additionalProperties\":false,\"description\":\"Request parameters for creating a Label on a Shortcut Story.\",\"properties\":{\"color\":{\"description\":\"The hex color to be displayed with the Label (for example, \\\"#ff0000\\\").\",\"format\":\"css-color\",\"minLength\":1,\"pattern\":\"^#[a-fA-F0-9]{6}$\",\"type\":\"string\"},\"description\":{\"description\":\"The description of the new Label.\",\"maxLength\":1024,\"type\":\"string\"},\"external_id\":{\"description\":\"This field can be set to another unique ID. In the case that the Label has been imported from another tool, the ID in the other tool can be indicated here.\",\"maxLength\":128,\"minLength\":1,\"type\":\"string\"},\"name\":{\"description\":\"The name of the new Label.\",\"maxLength\":128,\"minLength\":1,\"type\":\"string\"}},\"required\":[\"name\"],\"type\":\"object\"},\"type\":\"array\"},\"move_to\":{\"description\":\"One of \\\"first\\\" or \\\"last\\\". This can be used to move the given story to the first or last position in the workflow state.\",\"enum\":[\"last\",\"first\"],\"type\":\"string\"},\"owner_ids_add\":{\"description\":\"The UUIDs of the new owners to be added.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"owner_ids_remove\":{\"description\":\"The UUIDs of the owners to be removed.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"project_id\":{\"description\":\"The ID of the Project the Stories should belong to.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"requested_by_id\":{\"description\":\"The ID of the member that requested the story.\",\"format\":\"uuid\",\"type\":\"string\"},\"story_ids\":{\"description\":\"The Ids of the Stories you wish to update.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\",\"uniqueItems\":true},\"story_type\":{\"description\":\"The type of story (feature, bug, chore).\",\"enum\":[\"feature\",\"chore\",\"bug\"],\"type\":\"string\"},\"workflow_state_id\":{\"description\":\"The ID of the workflow state to put the stories in.\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"story_ids\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"description\":\"StorySlim represents the same resource as a Story, but is more light-weight. For certain fields it provides ids rather than full resources (e.g., `comment_ids` and `file_ids`) and it also excludes certain aggregate values (e.g., `cycle_time`). The `description` field can be optionally included. Use the [Get Story](#Get-Story) endpoint to fetch the unabridged payload for a Story.\",\"properties\":{\"app_url\":{\"description\":\"The Shortcut application url for the Story.\",\"type\":\"string\"},\"archived\":{\"description\":\"True if the story has been archived or not.\",\"type\":\"boolean\"},\"blocked\":{\"description\":\"A true/false boolean indicating if the Story is currently blocked.\",\"type\":\"boolean\"},\"blocker\":{\"description\":\"A true/false boolean indicating if the Story is currently a blocker of another story.\",\"type\":\"boolean\"},\"comment_ids\":{\"description\":\"An array of IDs of Comments attached to the story.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"completed\":{\"description\":\"A true/false boolean indicating if the Story has been completed.\",\"type\":\"boolean\"},\"completed_at\":{\"description\":\"The time/date the Story was completed.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"completed_at_override\":{\"description\":\"A manual override for the time/date the Story was completed.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"created_at\":{\"description\":\"The time/date the Story was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"custom_fields\":{\"description\":\"An array of CustomField value assertions for the story.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"field_id\":{\"description\":\"The unique public ID for a CustomField.\",\"format\":\"uuid\",\"type\":\"string\"},\"value\":{\"description\":\"A string representation of the value, if applicable.\",\"type\":\"string\"},\"value_id\":{\"description\":\"The unique public ID for a CustomFieldEnumValue.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"field_id\",\"value_id\",\"value\"],\"type\":\"object\"},\"type\":\"array\"},\"cycle_time\":{\"description\":\"The cycle time (in seconds) of this story when complete.\",\"format\":\"int64\",\"type\":\"integer\"},\"deadline\":{\"description\":\"The due date of the story.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"description\":{\"description\":\"The description of the Story.\",\"type\":\"string\"},\"entity_type\":{\"description\":\"A string description of this resource.\",\"type\":\"string\"},\"epic_id\":{\"description\":\"The ID of the epic the story belongs to.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"estimate\":{\"description\":\"The numeric point estimate of the story. Can also be null, which means unestimated.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"external_id\":{\"description\":\"This field can be set to another unique ID. In the case that the Story has been imported from another tool, the ID in the other tool can be indicated here.\",\"nullable\":true,\"type\":\"string\"},\"external_links\":{\"description\":\"An array of external links (strings) associated with a Story\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"file_ids\":{\"description\":\"An array of IDs of Files attached to the story.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"follower_ids\":{\"description\":\"An array of UUIDs for any Members listed as Followers.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"formatted_vcs_branch_name\":{\"description\":\"The formatted branch name for this story.\",\"nullable\":true,\"type\":\"string\"},\"global_id\":{\"type\":\"string\"},\"group_id\":{\"description\":\"The ID of the group associated with the story.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"group_mention_ids\":{\"description\":\"An array of Group IDs that have been mentioned in the Story description.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"id\":{\"description\":\"The unique ID of the Story.\",\"format\":\"int64\",\"type\":\"integer\"},\"iteration_id\":{\"description\":\"The ID of the iteration the story belongs to.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"label_ids\":{\"description\":\"An array of label ids attached to the story.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"labels\":{\"description\":\"An array of labels attached to the story.\",\"items\":{\"additionalProperties\":false,\"description\":\"A Label can be used to associate and filter Stories and Epics, and also create new Workspaces. A slim Label does not include aggregate stats. Fetch the Label using the labels endpoint to retrieve them.\",\"properties\":{\"app_url\":{\"description\":\"The Shortcut application url for the Label.\",\"type\":\"string\"},\"archived\":{\"description\":\"A true/false boolean indicating if the Label has been archived.\",\"type\":\"boolean\"},\"color\":{\"description\":\"The hex color to be displayed with the Label (for example, \\\"#ff0000\\\").\",\"format\":\"css-color\",\"minLength\":1,\"nullable\":true,\"pattern\":\"^#[a-fA-F0-9]{6}$\",\"type\":\"string\"},\"created_at\":{\"description\":\"The time/date that the Label was created.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"description\":{\"description\":\"The description of the Label.\",\"nullable\":true,\"type\":\"string\"},\"entity_type\":{\"description\":\"A string description of this resource.\",\"type\":\"string\"},\"external_id\":{\"description\":\"This field can be set to another unique ID. In the case that the Label has been imported from another tool, the ID in the other tool can be indicated here.\",\"nullable\":true,\"type\":\"string\"},\"global_id\":{\"type\":\"string\"},\"id\":{\"description\":\"The unique ID of the Label.\",\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"description\":\"The name of the Label.\",\"type\":\"string\"},\"updated_at\":{\"description\":\"The time/date that the Label was updated.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"app_url\",\"description\",\"archived\",\"entity_type\",\"color\",\"name\",\"global_id\",\"updated_at\",\"external_id\",\"id\",\"created_at\"],\"type\":\"object\"},\"type\":\"array\"},\"lead_time\":{\"description\":\"The lead time (in seconds) of this story when complete.\",\"format\":\"int64\",\"type\":\"integer\"},\"linked_file_ids\":{\"description\":\"An array of IDs of LinkedFiles attached to the story.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"member_mention_ids\":{\"description\":\"An array of Member IDs that have been mentioned in the Story description.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"mention_ids\":{\"description\":\"`Deprecated:` use `member_mention_ids`.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"moved_at\":{\"description\":\"The time/date the Story was last changed workflow-state.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the story.\",\"type\":\"string\"},\"num_tasks_completed\":{\"description\":\"The number of tasks on the story which are complete.\",\"format\":\"int64\",\"type\":\"integer\"},\"o