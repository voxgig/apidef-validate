# Entity: member

main: kit: entity: member: {

  alias: field: {}

  fields: {
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "The time/date the Member was created."
      t: "`$STRING`"
    }
    created_without_invite: {
      h: "Created Without Invite"
      n: "created_without_invite"
      r: true
      sh: "Whether this member was created as a placeholder entity."
      t: "`$BOOLEAN`"
    }
    disabled: {
      h: "Disabled"
      n: "disabled"
      r: true
      sh: "True/false boolean indicating whether the Member has been disabled within the Workspace."
      t: "`$BOOLEAN`"
    }
    entity_type: {
      h: "Entity Type"
      n: "entity_type"
      r: true
      sh: "A string description of this resource."
      t: "`$STRING`"
    }
