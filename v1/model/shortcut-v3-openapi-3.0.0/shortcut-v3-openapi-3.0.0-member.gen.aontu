      h: "Mention Name"
      n: "mention_name"
      r: true
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      t: "`$STRING`"
    }
    organization2: {
      h: "Organization2"
      n: "organization2"
      r: true
      t: "`$OBJECT`"
    }
    profile: {
      h: "Profile"
      n: "profile"
      r: true
      sh: "A group of Member profile details."
      t: "`$OBJECT`"
    }
    replaced_by: {
      fo: "uuid"
      h: "Replaced By"
      n: "replaced_by"
      r: false
      sh: "The id of the member that replaces this one when merged."
      t: "`$STRING`"
    }
    role: {
      h: "Role"
      n: "role"
      r: true
      sh: "The Member's role in the Workspace."
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "The user state, one of partial, full, disabled, or imported."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "The time/date the Member was last updated."
      t: "`$STRING`"
    }
    workspace2: {
      h: "Workspace2"
      n: "workspace2"
      r: true
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "member"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v3/members"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "disabled"
                or: "disabled"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "query"
                n: "org_public_id"
                or: "org_public_id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v3/members"
          q: {
            exist: [
              "disabled"
              "org_public_id"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "members"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/v3/members/{member-public-id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "member_public_id"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "org_public_id"
                or: "org_public_id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v3/members/{member-public-id}"
          q: {
            exist: [
              "id"
              "org_public_id"
            ]
          }
          r: {
            param: {
              "member-public-id": "id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "members"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /api/v3/member"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/v3/member"
          s: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "member"
            }
