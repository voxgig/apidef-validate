      h: "Group Ids"
      n: "group_ids"
      r: true
      sh: "The Member's group ids"
      t: "`$ARRAY`"
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: true
      sh: "The Member's ID in Shortcut."
      t: "`$STRING`"
    }
    installation_id: {
      fo: "uuid"
      h: "Installation Id"
      n: "installation_id"
      r: false
      sh: "Only set for agents."
      t: "`$STRING`"
    }
    is_owner: {
      h: "Is Owner"
      n: "is_owner"
      r: true
      t: "`$BOOLEAN`"
    }
