          contract: {
            id: "GET /api/v3/groups/{group-public-id}/stories"
            json: "{\"operationId\":\"listGroupStories\",\"parameters\":[{\"description\":\"The unique ID of the Group.\",\"in\":\"path\",\"name\":\"group-public-id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The maximum number of results to return. (Defaults to 1000, max 1000)\",\"in\":\"query\",\"name\":\"limit\",\"required\":false,\"schema\":{\"format\":\"int64\",\"type\":\"integer\"}},{\"description\":\"The offset at which to begin returning results. (Defaults to 0)\",\"in\":\"query\",\"name\":\"offset\",\"required\":false,\"schema\":{\"format\":\"int64\",\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"description\":\"StorySlim represents the same resource as a Story, but is more light-weight. For certain fields it provides ids rather than full resources (e.g., `comment_ids` and `file_ids`) and it also excludes certain aggregate values (e.g., `cycle_time`). The `description` field can be optionally included. Use the [Get Story](#Get-Story) endpoint to fetch the unabridged payload for a Story.\",\"properties\":{\"app_url\":{\"description\":\"The Shortcut application url for the Story.\",\"type\":\"string\"},\"archived\":{\"description\":\"True if the story has been archived or not.\",\"type\":\"boolean\"},\"blocked\":{\"description\":\"A true/false boolean indicating if the Story is currently blocked.\",\"type\":\"boolean\"},\"blocker\":{\"description\":\"A true/false boolean indicating if the Story is currently a blocker of another story.\",\"type\":\"boolean\"},\"comment_ids\":{\"description\":\"An array of IDs of Comments attached to the story.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"completed\":{\"description\":\"A true/false boolean indicating if the Story has been completed.\",\"type\":\"boolean\"},\"completed_at\":{\"description\":\"The time/date the Story was completed.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"completed_at_override\":{\"description\":\"A manual override for the time/date the Story was completed.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"created_at\":{\"description\":\"The time/date the Story was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"custom_fields\":{\"description\":\"An array of CustomField value assertions for the story.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"field_id\":{\"description\":\"The unique public ID for a CustomField.\",\"format\":\"uuid\",\"type\":\"string\"},\"value\":{\"description\":\"A string representation of the value, if applicable.\",\"type\":\"string\"},\"value_id\":{\"description\":\"The unique public ID for a CustomFieldEnumValue.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"field_id\",\"value_id\",\"value\"],\"type\":\"object\"},\"type\":\"array\"},\"cycle_time\":{\"description\":\"The cycle time (in seconds) of this story when complete.\",\"format\":\"int64\",\"type\":\"integer\"},\"deadline\":{\"description\":\"The due date of the story.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"description\":{\"description\":\"The description of the Story.\",\"type\":\"string\"},\"entity_type\":{\"description\":\"A string description of this resource.\",\"type\":\"string\"},\"epic_id\":{\"description\":\"The ID of the epic the story belongs to.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"estimate\":{\"description\":\"The numeric point estimate of the story. Can also be null, which means unestimated.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"external_id\":{\"description\":\"This field can be set to another unique ID. In the case that the Story has been imported from another tool, the ID in the other tool can be indicated here.\",\"nullable\":true,\"type\":\"string\"},\"external_links\":{\"description\":\"An array of external links (strings) associated with a Story\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"file_ids\":{\"description\":\"An array of IDs of Files attached to the story.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"follower_ids\":{\"description\":\"An array of UUIDs for any Members listed as Followers.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"formatted_vcs_branch_name\":{\"description\":\"The formatted branch name for this story.\",\"nullable\":true,\"type\":\"string\"},\"global_id\":{\"type\":\"string\"},\"group_id\":{\"description\":\"The ID of the group associated with the story.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"group_mention_ids\":{\"description\":\"An array of Group IDs that have been mentioned in the Story description.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"id\":{\"description\":\"The unique ID of the Story.\",\"format\":\"int64\",\"type\":\"integer\"},\"iteration_id\":{\"description\":\"The ID of the iteration the story belongs to.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"label_ids\":{\"description\":\"An array of label ids attached to the story.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"labels\":{\"description\":\"An array of labels attached to the story.\",\"items\":{\"additionalProperties\":false,\"description\":\"A Label can be used to associate and filter Stories and Epics, and also create new Workspaces. A slim Label does not include aggregate stats. Fetch the Label using the labels endpoint to retrieve them.\",\"properties\":{\"app_url\":{\"description\":\"The Shortcut application url for the Label.\",\"type\":\"string\"},\"archived\":{\"description\":\"A true/false boolean indicating if the Label has been archived.\",\"type\":\"boolean\"},\"color\":{\"description\":\"The hex color to be displayed with the Label (for example, \\\"#ff0000\\\").\",\