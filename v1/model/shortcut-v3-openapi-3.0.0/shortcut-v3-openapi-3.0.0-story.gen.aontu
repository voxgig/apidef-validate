tems\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"follower_ids\":{\"description\":\"An array of UUIDs for any Members listed as Followers.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"formatted_vcs_branch_name\":{\"description\":\"The formatted branch name for this story.\",\"nullable\":true,\"type\":\"string\"},\"global_id\":{\"type\":\"string\"},\"group_id\":{\"description\":\"The ID of the group associated with the story.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"group_mention_ids\":{\"description\":\"An array of Group IDs that have been mentioned in the Story description.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"id\":{\"description\":\"The unique ID of the Story.\",\"format\":\"int64\",\"type\":\"integer\"},\"iteration_id\":{\"description\":\"The ID of the iteration the story belongs to.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"label_ids\":{\"description\":\"An array of label ids attached to the story.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"labels\":{\"description\":\"An array of labels attached to the story.\",\"items\":{\"additionalProperties\":false,\"description\":\"A Label can be used to associate and filter Stories and Epics, and also create new Workspaces. A slim Label does not include aggregate stats. Fetch the Label using the labels endpoint to retrieve them.\",\"properties\":{\"app_url\":{\"description\":\"The Shortcut application url for the Label.\",\"type\":\"string\"},\"archived\":{\"description\":\"A true/false boolean indicating if the Label has been archived.\",\"type\":\"boolean\"},\"color\":{\"description\":\"The hex color to be displayed with the Label (for example, \\\"#ff0000\\\").\",\"format\":\"css-color\",\"minLength\":1,\"nullable\":true,\"pattern\":\"^#[a-fA-F0-9]{6}$\",\"type\":\"string\"},\"created_at\":{\"description\":\"The time/date that the Label was created.\