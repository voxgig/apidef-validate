se or some other large initiative that you are working on.\",\"properties\":{\"app_url\":{\"description\":\"The Shortcut application url for the Objective.\",\"type\":\"string\"},\"archived\":{\"description\":\"A boolean indicating whether the Objective has been archived or not.\",\"type\":\"boolean\"},\"categories\":{\"description\":\"An array of Categories attached to the Objective.\",\"items\":{\"additionalProperties\":false,\"description\":\"A Category can be used to associate Objectives.\",\"properties\":{\"archived\":{\"description\":\"A true/false boolean indicating if the Category has been archived.\",\"type\":\"boolean\"},\"color\":{\"description\":\"The hex color to be displayed with the Category (for example, \\\"#ff0000\\\").\",\"format\":\"css-color\",\"minLength\":1,\"nullable\":true,\"pattern\":\"^#[a-fA-F0-9]{6}$\",\"type\":\"string\"},\"created_at\":{\"description\":\"The time/date that the Category was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"entity_type\":{\"description\":\"A string description of this resource.\",\"type\":\"string\"},\"external_id\":{\"description\":\"This field can be set to another unique ID. In the case that the Category has been imported from another tool, the ID in the other tool can be indicated here.\",\"nullable\":true,\"type\":\"string\"},\"global_id\":{\"description\":\"The Global ID of the Category.\",\"type\":\"string\"},\"id\":{\"description\":\"The unique ID of the Category.\",\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"description\":\"The name of the Category.\",\"type\":\"string\"},\"type\":{\"description\":\"The type of entity this Category is associated with; currently Milestone or Objective is the only type of Category.\",\"type\":\"string\"},\"updated_at\":{\"description\":\"The time/date that the Category was updated.\",\"format\":\"date-time\",\"type\":\"string\"}},\"required\":[\"archived\",\"entity_type\",\"color\",\"name\",\"global_id\",\"type\",\"updated_at\",\"external_id\",\"id\",\"created_at\"],\"type\":\"object\"},\"type\":\"array\"},\"completed\":{\"description\":\"A true/false boolean indicating if the Objectivehas been completed.\",\"type\":\"boolean\"},\"completed_at\":{\"description\":\"The time/date the Objective was completed.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"completed_at_override\":{\"description\":\"A manual override for the time/date the Objective was completed.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"created_at\":{\"description\":\"The time/date the Objective was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"description\":{\"description\":\"The Objective's description.\",\"type\":\"string\"},\"entity_type\":{\"description\":\"A string description of this resource.\",\"type\":\"string\"},\"global_id\":{\"type\":\"string\"},\"id\":{\"description\":\"The unique ID of the Objective.\",\"format\":\"int64\",\"type\":\"integer\"},\"key_result_ids\":{\"description\":\"The IDs of the Key Results associated with the Objective.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"name\":{\"description\":\"The name of the Objective.\",\"type\":\"string\"},\"position\":{\"description\":\"A number representing the position of the Objective in relation to every other Objective within the Workspace.\",\"format\":\"int64\",\"type\":\"integer\"},\"started\":{\"description\":\"A true/false boolean indicating if the Objective has been started.\",\"type\":\"boolean\"},\"started_at\":{\"description\":\"The time/date the Objective was started.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"started_at_override\":{\"description\":\"A manual override for the time/date the Objective was started.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"state\":{\"description\":\"The workflow state that the Objective is in.\",\"type\":\"string\"},\"stats\":{\"additionalProperties\":false,\"description\":\"A group of calculated values for this Objective.\",\"properties\":{\"average_cycle_time\":{\"description\":\"The average cycle time (in seconds) of completed stories in this Objective.\",\"format\":\"int64\",\"type\":\"integer\"},\"average_lead_time\":{\"description\":\"The average lead time (in seconds) of completed stories in this Objective.\",\"format\":\"int64\",\"type\":\"integer\"},\"num_related_documents\":{\"description\":\"The number of related documents to this Objective.\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"num_related_documents\"],\"type\":\"object\"},\"updated_at\":{\"description\":\"The time/date the Objective was updated.\",\"format\":\"date-time\",\"type\":\"string\"}},\"required\":[\"app_url\",\"description\",\"archived\",\"started\",\"entity_type\",\"completed_at_override\",\"started_at\",\"completed_at\",\"name\",\"global_id\",\"completed\",\"state\",\"started_at_override\",\"updated_at\",\"categories\",\"id\",\"key_result_ids\",\"position\",\"stats\",\"created_at\"],\"type\":\"object\"}}},\"description\":\"Resource\"},\"400\":{\"description\":\"Schema mismatch\"},\"403\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"entitlement_tag\":{\"description\":\"Short tag describing the unusable entitlement action taken by the user.\",\"maxLength\":63,\"minLength\":1,\"type\":\"string\"},\"message\":{\"description\":\"Message displayed to the user on why their action failed.\",\"maxLength\":256,\"minLength\":1,\"type\":\"string\"},\"reason_tag\":{\"description\":\"The tag for violating an entitlement action.\",\"enum\":[\"entitlement-violation\"],\"type\":\"string\"}},\"required\":[\"reason_tag\",\"entitlement_tag\",\"message\"],\"type\":\"object\"}}},\"description\":\"\"},\"404\":{\"description\":\"Resource does not exist\"},\"422\":{\"description\":\"Unprocessable\"}},\"security\":[{\"api_token\":[]}],\"securitySchemes\":{\"api_token\":{\"in\":\"header\",\"name\":\"Shortcut-Token\",\"type\":\"ap