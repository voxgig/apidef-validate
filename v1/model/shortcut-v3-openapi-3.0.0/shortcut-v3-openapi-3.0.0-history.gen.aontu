\":{\"action\":{\"description\":\"The action of the entity referenced.\",\"enum\":[\"update\"],\"type\":\"string\"},\"app_url\":{\"description\":\"The application URL of the Story.\",\"maxLength\":2048,\"pattern\":\"^https?://.+$\",\"type\":\"string\"},\"changes\":{\"additionalProperties\":false,\"description\":\"The changes that have occurred as a result of the action.\",\"properties\":{\"archived\":{\"additionalProperties\":false,\"description\":\"True if the Story has archived, otherwise false.\",\"properties\":{\"new\":{\"description\":\"The new value.\",\"type\":\"boolean\"},\"old\":{\"description\":\"The old value.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"blocked\":{\"additionalProperties\":false,\"description\":\"True if the Story has archived, otherwise false.\",\"properties\":{\"new\":{\"description\":\"The new value.\",\"type\":\"boolean\"},\"old\":{\"description\":\"The old value.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"blocker\":{\"additionalProperties\":false,\"description\":\"True if the Story has archived, otherwise false.\",\"properties\":{\"new\":{\"description\":\"The new value.\",\"type\":\"boolean\"},\"old\":{\"description\":\"The old value.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"branch_ids\":{\"additionalProperties\":false,\"description\":\"Task IDs that have been added or removed from the Story.\",\"properties\":{\"adds\":{\"description\":\"The values that have been added.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"removes\":{\"description\":\"The values that have been removed\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"}},\"type\":\"object\"},\"commit_ids\":{\"additionalProperties\":false,\"description\":\"Task IDs that have been added or removed from the Story.\",\"properties\":{\"adds\":{\"description\":\"The values that have been added.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"removes\":{\"description\":\"The values 