# Entity: history

main: kit: entity: history: {

  alias: field: {}

  fields: [
    {
      name: "actions"
      req: true
      short: "An array of actions that were performed for the change."
      type: "`$ARRAY`"
      union: {
        branches: 19
        count: 1
        depth: 1
      }
    }
    {
      name: "actor_name"
      req: false
      short: "The name of the actor that performed the action, if it can be determined."
      type: "`$STRING`"
    }
    {
      format: "uuid"
      name: "automation_id"
      req: false
      short: "The ID of the automation that performed the change."
      type: "`$STRING`"
    }
    {
      name: "changed_at"
      req: true
      short: "The date when the change occurred."
      type: "`$STRING`"
    }
    {
      name: "external_id"
      req: false
      short: "The ID of the webhook that handled the change."
      type: "`$STRING`"
    }
    {
      format: "uuid"
      name: "id"
      req: true
      short: "The ID representing the change for the story."
      type: "`$STRING`"
    }
    {
      format: "uuid"
      name: "member_id"
      req: false
      short: "The ID of the member who performed the change."
      type: "`$STRING`"
    }
    {
      name: "primary_id"
      req: false
      short: "The ID of the primary entity that has changed, if applicable."
      type: "`$STRING`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    {
      name: "references"
      req: false
      short: "An array of objects affected by the change."
      type: "`$ARRAY`"
      union: {
        branches: 12
        count: 12
        depth: 5
      }
    }
    {
      name: "version"
      req: true
      short: "The version of the change format."
      type: "`$STRING`"
    }
    {
      name: "webhook_id"
      req: false
      short: "The ID of the webhook that handled the change."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "history"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "story_id"
                orig: "story_public_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /api/v3/stories/{story-public-id}/history"
            json: "{\"operationId\":\"storyHistory\",\"parameters\":[{\"description\":\"The ID of the Story.\",\"in\":\"path\",\"name\":\"story-public-id\",\"required\":true,\"schema\":{\"format\":\"int64\",\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"description\":\"A history item is a group of actions that represent a transactional change to a Story.\",\"properties\":{\"actions\":{\"description\":\"An array of actions that were performed for the change.\",\"items\":{\"oneOf\":[{\"additionalProperties\":false,\"description\":\"An action representing a VCS Branch being created.\",\"properties\":{\"action\":{\"description\":\"The action of the entity referenced.\",\"enum\":[\"create\"],\"type\":\"string\"},\"entity_type\":{\"description\":\"The type of entity referenced.\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the entity referenced.\",\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"description\":\"The name of the VCS Branch that was pushed\",\"type\":\"string\"},\"url\":{\"description\":\"The URL from the provider of the VCS Branch that was pushed\",\"type\":\"string\"}},\"required\":[\"id\",\"entity_type\",\"name\",\"url\",\"action\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"An action representing a VCS Branch being merged.\",\"properties\":{\"action\":{\"description\":\"The action of the entity referenced.\",\"enum\":[\"merge\"],\"type\":\"string\"},\"entity_type\":{\"description\":\"The type of entity referenced.\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the entity referenced.\",\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"description\":\"The name of the VCS Branch that was pushed\",\"type\":\"string\"},\"url\":{\"description\":\"The URL from the provider of the VCS Branch that was pushed\",\"type\":\"string\"}},\"required\":[\"id\",\"entity_type\",\"name\",\"url\",\"action\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"An action representing a VCS Branch being pushed.\",\"properties\":{\"action\":{\"description\":\"The action of the entity referenced.\",\"enum\":[\"push\"],\"type\":\"string\"},\"entity_type\":{\"description\":\"The type of entity referenced.\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the entity referenced.\",\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"description\":\"The name of the VCS Branch that was pushed\",\"type\":\"string\"},\"url\":{\"description\":\"The URL from the provider of the VCS Branch that was pushed\",\"type\":\"string\"}},\"required\":[\"id\",\"entity_type\",\"name\",\"url\",\"action\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"An action representing a Label being created.\",\"properties\":{\"action\":{\"description\":\"The action of the entity referenced.\",\"enum\":[\"create\"],\"type\":\"string\"},\"app_url\":{\"description\":\"The application URL of the Label.\",\"maxLength\":2048,\"pattern\":\"^https?://.+$\",\"type\":\"string\"},\"entity_type\":{\"description\":\"The type of entity referenced.\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the entity referenced.\",\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"description\":\"The name of the Label.\",\"type\":\"string\"}},\"required\":[\"id\",\"entity_type\",\"action\",\"app_url\",\"name\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"An action representing a Label being updated.\",\"properties\":{\"action\":{\"description\":\"The action of the entity referenced.\",\"enum\":[\"update\"],\"type\":\"string\"},\"entity_type\":{\"description\":\"The type of entity referenced.\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the entity referenced.\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"id\",\"entity_type\",\"action\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"An action representing a Label being deleted.\",\"properties\":{\"action\":{\"description\":\"The action of the entity referenced.\",\"enum\":[\"delete\"],\"type\":\"string\"},\"entity_type\":{\"description\":\"The type of entity referenced.\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the entity referenced.\",\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"description\":\"The name of the Label.\",\"type\":\"string\"}},\"required\":[\"id\",\"entity_type\",\"action\",\"name\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"An action representing a Project being updated.\",\"properties\":{\"action\":{\"description\":\"The action of the entity referenced.\",\"enum\":[\"update\"],\"type\":\"string\"},\"app_url\":{\"description\":\"The application URL of the Project.\",\"maxLength\":2048,\"pattern\":\"^https?://.+$\",\"type\":\"string\"},\"entity_type\":{\"description\":\"The type of entity referenced.\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the entity referenced.\",\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"description\":\"The name of the Project.\",\"type\":\"string\"}},\"required\":[\"id\",\"entity_type\",\"action\",\"app_url\",\"name\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"An action representing various operations for a Pull Request.\",\"properties\":{\"action\":{\"description\":\"The action of the entity referenced.\",\"enum\":[\"open\",\"update\",\"reopen\",\"close\",\"sync\",\"comment\"],\"type\":\"string\"},\"entity_type\":{\"description\":\"The type of entity referenced.\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the entity referenced.\",\"format\":\"int64\",\"type\":\"integer\"},\"number\":{\"description\":\"The VCS Repository-specific ID for the Pull Request.\",\"format\":\"int64\",\"type\":\"integer\"},\"title\":{\"description\":\"The title of the Pull Request.\",\"type\":\"string\"},\"url\":{\"description\":\"The URL from the provider of the VCS Pull Request.\",\"maxLength\":2048,\"pattern\":\"^https?://.+$\",\"type\":\"string\"}},\"required\":[\"id\",\"entity_type\",\"action\",\"number\",\"title\",\"url\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"An action representing a Story being created.\",\"properties\":{\"action\":{\"description\":\"The action of the entity referenced.\",\"enum\":[\"create\"],\"type\":\"string\"},\"app_url\":{\"description\":\"The application URL of the Story.\",\"maxLength\":2048,\"pattern\":\"^https?://.+$\",\"type\":\"string\"},\"blocked\":{\"description\":\"Whether or not the Story is blocked by another Story.\",\"type\":\"boolean\"},\"blocker\":{\"description\":\"Whether or not the Story is blocking another Story.\",\"type\":\"boolean\"},\"completed\":{\"description\":\"Whether or not the Story is completed.\",\"type\":\"boolean\"},\"custom_field_value_ids\":{\"description\":\"An array of Custom Field Enum Value ids on this Story.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"deadline\":{\"description\":\"The timestamp representing the Story's deadline.\",\"type\":\"string\"},\"description\":{\"description\":\"The description of the Story.\",\"type\":\"string\"},\"entity_type\":{\"description\":\"The type of entity referenced.\",\"type\":\"string\"},\"epic_id\":{\"description\":\"The Epic ID for this Story.\",\"format\":\"int64\",\"type\":\"integer\"},\"estimate\":{\"description\":\"The estimate (or point value) for the Story.\",\"format\":\"int64\",\"type\":\"integer\"},\"follower_ids\":{\"description\":\"An array of Member IDs for the followers of the Story.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"group_id\":{\"description\":\"The Team IDs for the followers of the Story.\",\"format\":\"uuid\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the entity referenced.\",\"format\":\"int64\",\"type\":\"integer\"},\"iteration_id\":{\"description\":\"The Iteration I