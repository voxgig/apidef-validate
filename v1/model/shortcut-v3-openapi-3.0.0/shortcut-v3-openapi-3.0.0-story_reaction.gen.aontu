                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/api/v3/stories/{story-public-id}/comments/{comment-public-id}/reactions"
          q: {
            exist: [
              "comment_id"
              "story_id"
            ]
          }
          r: {
            param: {
              "comment-public-id": "comment_id"
              "story-public-id": "story_id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "stories"
            }
            {
              var: "story_id"
            }
            {
              lit: "comments"
            }
            {
              var: "comment_id"
            }
            {
              lit: "reactions"
            }
          ]
          t: {
            req: {
              emoji: "`reqdata.emoji`"
            }
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /api/v3/stories/{story-public-id}/comments/{comment-public-id}/reactions"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "comment_id"
                or: "comment_public_id"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "story_id"
                or: "story_public_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "DELETE"
          o: "/api/v3/stories/{story-public-id}/comments/{comment-public-id}/reactions"
          q: {
            exist: [
              "comment_id"
              "story_id"
            ]
          }
          r: {
            param: {
              "comment-public-id": "comment_id"
              "story-public-id": "story_id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "stories"
            }
            {
              var: "story_id"
            }
            {
              lit: "comments"
            }
            {
              var: "comment_id"
            }
            {
              lit: "reactions"
            }
          ]
          t: {
