# Entity: story_reaction

main: kit: entity: story_reaction: {

  alias: field: {}

  fields: {
    emoji: {
      h: "Emoji"
      n: "emoji"
      r: true
      sh: "The emoji short-code to add / remove."
      t: "`$STRING`"
    }
  }

  name: "story_reaction"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /api/v3/stories/{story-public-id}/comments/{comment-public-id}/reactions"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
