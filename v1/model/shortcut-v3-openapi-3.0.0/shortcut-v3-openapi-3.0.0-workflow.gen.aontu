# Entity: workflow

main: kit: entity: workflow: {

  alias: field: {}

  fields: [
    {
      name: "auto_assign_owner"
      req: true
      short: "Indicates if an owner is automatically assigned when an unowned story is started."
      type: "`$BOOLEAN`"
    }
    {
      name: "created_at"
      req: true
      short: "The date the Workflow was created."
      type: "`$STRING`"
    }
    {
      name: "default_state_id"
      req: true
      short: "The unique ID of the default state that new Stories are entered into."
      type: "`$INTEGER`"
    }
    {
      name: "description"
      req: true
      short: "A description of the workflow."
      type: "`$STRING`"
    }
    {
      name: "entity_type"
      req: true
      short: "A string description of this resource."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The unique ID of the Workflow."
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: true
      short: "The name of the workflow."
      type: "`$STRING`"
    }
    {
      name: "project_ids"
      req: true
      short: "An array of IDs of projects within the Workflow."
      type: "`$ARRAY`"
    }
    {
      name: "states"
      req: true
      short: "A map of the states in this Workflow."
      type: "`$ARRAY`"
    }
    {
      name: "team_id"
      req: true
      short: "The ID of the team the workflow belongs to."
      type: "`$INTEGER`"
    }
    {
      name: "updated_at"
      req: true
      short: "The date the Workflow was updated."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "workflow"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api/v3/workflows"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "workflows"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "workflow_public_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v3/workflows/{workflow-public-id}"
          rename: {
            param: {
              "workflow-public-id": "id"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "workflows"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}