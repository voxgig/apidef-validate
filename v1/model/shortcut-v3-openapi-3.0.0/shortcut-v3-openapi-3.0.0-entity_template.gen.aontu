            json: "{\"operationId\":\"createEntityTemplate\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"description\":\"Request parameters for creating an entirely new entity template.\",\"properties\":{\"author_id\":{\"description\":\"The id of the user creating this template.\",\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the new entity template\",\"maxLength\":128,\"minLength\":1,\"type\":\"string\"},\"story_contents\":{\"additionalProperties\":false,\"description\":\"A map of story attributes this template populates.\",\"properties\":{\"custom_fields\":{\"description\":\"An array of maps specifying a CustomField ID and CustomFieldEnumValue ID that represents an assertion of some value for a CustomField.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"field_id\":{\"description\":\"The unique public ID for the CustomField.\",\"format\":\"uuid\",\"type\":\"string\"},\"value\":{\"description\":\"A literal value for the CustomField. Currently ignored.\",\"type\":\"string\"},\"value_id\":{\"description\":\"The unique public ID for the CustomFieldEnumValue.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"field_id\",\"value_id\"],\"type\":\"object\"},\"type\":\"array\"},\"deadline\":{\"description\":\"The due date of the story.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"description\":{\"description\":\"The description of the story.\",\"type\":\"string\"},\"epic_id\":{\"description\":\"The ID of the epic the to be populated.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"estimate\":{\"description\":\"The numeric point estimate to be populated.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"external_links\":{\"description\":\"An array of external links to be populated.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"file_ids\":{\"description\":\"An array of the attached file IDs to be populated.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\",\"uniqueItems\":true},\"follower_ids\":{\"description\":\"An array of UUIDs for any Members listed as Followers.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"group_id\":{\"description\":\"The ID of the group to be populated.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"iteration_id\":{\"description\":\"The ID of the iteration the to be populated.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"labels\":{\"description\":\"An array of labels to be populated by the template.\",\"items\":{\"additionalProperties\":false,\"description\":\"Request parameters for creating a Label on a Shortcut Story.\",\"properties\":{\"color\":{\"description\":\"The hex color to be displayed with the Label (for example, \\\"#ff0000\\\").\",\"format\":\"css-color\",\"minLength\":1,\"pattern\":\"^#[a-fA-F0-9]{6}$\",\"type\":\"string\"},\"description\":{\"description\":\"The description of the new Label.\",\"maxLength\":1024,\"type\":\"string\"},\"external_id\":{\"description\":\"This field can be set to another unique ID. In the case that the Label has been imported from another tool, the ID in the other tool can be indicated here.\",\"maxLength\":128,\"minLength\":1,\"type\":\"string\"},\"name\":{\"description\":\"The name of the new Label.\",\"maxLength\":128,\"minLength\":1,\"type\":\"string\"}},\"required\":[\"name\"],\"type\":\"object\"},\"type\":\"array\"},\"linked_file_ids\":{\"description\":\"An array of the linked file IDs to be populated.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\",\"uniqueItems\":true},\"name\":{\"description\":\"The name of the story.\",\"maxLength\":512,\"type\":\"string\"},\"owner_ids\":{\"description\":\"An array of UUIDs of the owners of this story.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"project_id\":{\"description\":\"The ID of the project the story belongs to.\",\"format\":\"int64\",\"type\":\"integer\"},\"story_type\":{\"description\":\"The type of story (feature, bug, chore).\",\"type\":\"string\"},\"sub_tasks\":{\"description\":\"An array of sub-tasks connected to the story\",\"items\":{\"additionalProperties\":false,\"properties\":{\"name\":{\"description\":\"The name of the SubTask.\",\"maxLength\":512,\"minLength\":1,\"type\":\"string\"},\"owner_ids\":{\"description\":\"An array of UUIDs of the owners of this story.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"workflow_state_id\":{\"description\":\"The ID of the workflow state the story will be in.\",\"format\":\"int64\",\"type\":\"integer\"}},\"required\":[\"name\"],\"type\":\"object\"},\"type\":\"array\"},\"tasks\":{\"description\":\"An array of tasks to be populated by the template.\",\"items\":{\"additionalProperties\":false,\"description\":\"Request parameters for specifying how to pre-populate a task through a template.\",\"properties\":{\"complete\":{\"description\":\"True/false boolean indicating whether the Task is completed. Defaults to false.\",\"type\":\"boolean\"},\"description\":{\"description\":\"The Task description.\",\"maxLength\":2048,\"minLength\":1,\"type\":\"string\"},\"external_id\":{\"description\":\"This field can be set to another unique ID. In the case that the Task has been imported from another tool, the ID in the other tool can be indicated here.\",\"maxLength\":128,\"type\":\"string\"},\"owner_ids\":{\"description\":\"An array of UUIDs for any members you want to add as Owners on this new Task.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"description\"],\"type\":\"object\"},\"type\":\"array\"},\"workflow_state_id\":{\"description\":\"The ID of the workflow state to be populated.\",\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"}},\"type\":\"object\"}},\"required\":[\"name\"