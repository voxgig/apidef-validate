          contract: {
            id: "GET /api/v3/search/iterations"
            json: "{\"operationId\":\"searchIterations\",\"parameters\":[{\"description\":\"See our help center article on [search operators](https://help.shortcut.com/hc/en-us/articles/360000046646-Search-Operators)\",\"in\":\"query\",\"name\":\"query\",\"required\":true,\"schema\":{\"minLength\":1,\"type\":\"string\"}},{\"description\":\"The number of search results to include in a page. Minimum of 1 and maximum of 250.\",\"in\":\"query\",\"name\":\"page_size\",\"required\":false,\"schema\":{\"format\":\"int64\",\"type\":\"integer\"}},{\"description\":\"The amount of detail included in each result item.\\n   \\\"full\\\" will include all descriptions and comments and more fields on\\n   related items such as pull requests, branches and tasks.\\n   \\\"slim\\\" omits larger fulltext fields such as descriptions and comments\\n   and only references related items by id.\\n   The default is \\\"full\\\".\",\"in\":\"query\",\"name\":\"detail\",\"required\":false,\"schema\":{\"enum\":[\"full\",\"slim\"],\"type\":\"string\"}},{\"description\":\"The next page token.\",\"in\":\"query\",\"name\":\"next\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"A collection of entity_types to search. Defaults to story and epic. Supports: epic, iteration, objective, story.\",\"explode\":true,\"in\":\"query\",\"name\":\"entity_types\",\"required\":false,\"schema\":{\"items\":{\"enum\":[\"story\",\"milestone\",\"epic\",\"iteration\",\"objective\"],\"type\":\"string\"},\"type\":\"array\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"description\":\"The results of the Iteration search query.\",\"properties\":{\"data\":{\"description\":\"A list of search results.\",\"items\":{\"additionalProperties\":false,\"description\":\"IterationSlim represents the same resource as an Iteration, but is more light-weight. Use the [Get Iteration](#Get-Iteration) endpoint to fetch the unabridged payload for an Iteration. \",\"properties\":{\"app_url\":{\"description\":\"The Shortcut application url for the Iteration.\",\"type\":\"string\"},\"associated_groups\":{\"description\":\"An array containing Group IDs and Group-owned story counts for the Iteration's associated groups.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"associated_stories_count\":{\"description\":\"The number of stories this Group owns in the Iteration.\",\"format\":\"int64\",\"type\":\"integer\"},\"group_id\":{\"description\":\"The Group ID of the associated group.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"group_id\"],\"type\":\"object\"},\"type\":\"array\"},\"created_at\":{\"description\":\"The instant when this iteration was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"end_date\":{\"description\":\"The date this iteration ends.\",\"format\":\"date-time\",\"type\":\"string\"},\"entity_type\":{\"description\":\"A string description of this resource\",\"type\":\"string\"},\"follower_ids\":{\"description\":\"An array of UUIDs for any Members listed as Followers.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"global_id\":{\"type\":\"string\"},\"group_ids\":{\"description\":\"An array of UUIDs for any Groups you want to add as Followers. Currently, only one Group association is presented in our web UI.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"group_mention_ids\":{\"description\":\"An array of Group IDs that have been mentioned in the Story description.\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"id\":{\"description\":\"The ID of the iteration.\",\"format\":\"int64\",\"type\":\"integer\"},\"label_ids\":{\"description\":\"An array of label ids attached to the iteration.\",\"items\":{\"format\":\"int64\",\"type\":\"integer\"},\"type\":\"array\"},\"labels\":{\"description\":\"An array of labels attached to the iteration.\",\"items\":{\"additionalProperties\":