            }
            {
              lit: "v3"
            }
            {
              lit: "entity-templates"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "entity_template_public_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v3/entity-templates/{entity-template-public-id}"
          rename: {
            param: {
              "entity-template-public-id": "id"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "entity-templates"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.story_contents`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "entity_template_public_id"
