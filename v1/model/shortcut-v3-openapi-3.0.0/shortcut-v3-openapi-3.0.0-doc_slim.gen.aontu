# Entity: doc_slim

main: kit: entity: doc_slim: {

  alias: field: {}

  fields: {
    app_url: {
      h: "App Url"
      n: "app_url"
      r: true
      sh: "The Shortcut application url for the Doc."
      t: "`$STRING`"
    }
    content: {
      h: "Content"
      n: "content"
      r: true
      sh: "The content for the new document"
      t: "`$STRING`"
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: true
      sh: "The public id of the Doc"
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "The title for the new document"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "doc_slim"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /api/v3/documents"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/api/v3/documents"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "documents"
            }
          ]
          transform: {
            req: {
              content: "`reqdata.content`"
              title: "`reqdata.title`"
            }
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /api/v3/documents"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/api/v3/documents"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "documents"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}