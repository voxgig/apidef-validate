# Entity: workflow

main: kit: entity: workflow: {

  alias: field: {}

  fields: {
    auto_assign_owner: {
      h: "Auto Assign Owner"
      n: "auto_assign_owner"
      r: true
      sh: "Indicates if an owner is automatically assigned when an unowned story is started."
      t: "`$BOOLEAN`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "The date the Workflow was created."
      t: "`$STRING`"
    }
    default_state_id: {
      fo: "int64"
      h: "Default State Id"
      n: "default_state_id"
      r: true
      sh: "The unique ID of the default state that new Stories are entered into."
      t: "`$INTEGER`"
    }
    description: {
      h: "Description"
      n: "description"
      r: true
      sh: "A description of the workflow."
      t: "`$STRING`"
    }
    entity_type: {
      h: "Entity Type"
      n: "entity_type"
      r: true
      sh: "A string description of this resource."
      t: "`$STRING`"
    }
    id: {
      fo: "int64"
      h: "Id"
      n: "id"
      r: true
      sh: "The unique ID of the Workflow."
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the workflow."
      t: "`$STRING`"
    }
    project_ids: {
      h: "Project Ids"
      n: "project_ids"
      r: true
      sh: "An array of IDs of projects within the Workflow."
      t: "`$ARRAY`"
    }
    states: {
      h: "States"
      n: "states"
      r: true
      sh: "A map of the states in this Workflow."
      t: "`$ARRAY`"
    }
    team_id: {
      fo: "int64"
      h: "Team Id"
      n: "team_id"
      r: true
      sh: "The ID of the team the workflow belongs to."
      t: "`$INTEGER`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "The date the Workflow was updated."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "workflow"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v3/workflows"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/v3/workflows"
          s: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "workflows"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/v3/workflows/{workflow-public-id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "workflow_public_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/api/v3/workflows/{workflow-public-id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              "workflow-public-id": "id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              lit: "workflows"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}