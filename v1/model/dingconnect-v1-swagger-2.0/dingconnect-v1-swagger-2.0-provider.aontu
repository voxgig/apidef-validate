          contract: {
            id: "GET /api/V1/GetProviders"
            json: "{\"operationId\":\"GetProviders\",\"parameters\":[{\"collectionFormat\":\"multi\",\"description\":\"Filter the list to providers with the submitted provider codes.\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"providerCodes\",\"type\":\"array\"},{\"collectionFormat\":\"multi\",\"description\":\"Filter the list to providers in countries with the submitted countryIso.\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"countryIsos\",\"type\":\"array\"},{\"collectionFormat\":\"multi\",\"description\":\"Filter the list to providers in regions with the submitted regionCodes.\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"regionCodes\",\"type\":\"array\"},{\"default\":\"\",\"description\":\"Filter the list to providers that are valid for the submitted account number. For phone number based products, the account number should be in international phone number format.\",\"in\":\"query\",\"name\":\"accountNumber\",\"type\":\"string\"},{\"description\":\"Correlates HTTP requests between a client and server\",\"in\":\"header\",\"name\":\"X-Correlation-Id\",\"type\":\"String\"}],\"produces\":[\"application/json\",\"text/json\"],\"protocol\":\"http\",\"responses\":{\"200\":{\"description\":\"OK\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"Items\":{\"description\":\"A list of providers that the distributor has Products for.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"CountryIso\":{\"description\":\"The country within which the provider operates\",\"type\":\"string\"},\"CustomerCareNumber\":{\"description\":\"Customer care number of the provider\",\"type\":\"string\"},\"LogoUrl\":{\"description\":\"Link to image of the provider logo\",\"type\":\"string\"},\"Name\":{\"description\":\"The English trading name of the provider.\",\"type\":\"string\"},\"PaymentTypes\":{\"description\":\"Indicates the supported payment types for all the products in this provider. Current possible values are: Prepaid and Postpaid\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"ProviderCode\":{\"description\":\"Uniquely identifies a provider\",\"type\":\"string\"},\"RegionCodes\":{\"description\":\"Regions supported by the provider within the country\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"ShortName\":{\"description\":\"A shorter version of the Name suitable for use in space restricted UI elements\",\"type\":\"string\"},\"ValidationRegex\":{\"description\":\"Account numbers must match the ValidationRegex\",\"type\":\"string\"}},\"required\":[\"ProviderCode\",\"CountryIso\",\"Name\",\"ValidationRegex\",\"RegionCodes\",\"PaymentTypes\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\",\"Items\"],\"type\":\"object\"}},\"400\":{\"description\":\"BadRequest\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"401\":{\"description\":\"Unauthorized\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"500\":{\"description\":\"InternalServerError\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"503\":{\"description\":\"ServiceUnavailable\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}}},\"securitySchemes\":{\"APIKeyHeader\":{\"description\":\"Use the API key that was issued to you.\",\"in\":\"header\",\"name\":\"api_key\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"
