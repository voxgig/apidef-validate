# Entity: transfer_record

main: kit: entity: transfer_record: {

  alias: field: {}

  fields: {
    AccountNumber: {
      h: "Account Number"
      n: "AccountNumber"
      r: false
      sh: "Filter transfers by AccountNumber"
      t: "`$STRING`"
    }
    DistributorRef: {
      h: "Distributor Ref"
      n: "DistributorRef"
      r: false
      sh: "Filter transfers by DistributorRef."
      t: "`$STRING`"
    }
    ErrorCodes: {
      h: "Error Codes"
      n: "ErrorCodes"
      r: true
      sh: "Any error codes that were returned as part of the SendTransfer or in the case of a Batch `ProcessingMode` that may have occurred later after the batch was submitted to the Provider."
      t: "`$ARRAY`"
    }
    ResultCode: {
      fo: "int32"
      h: "Result Code"
      n: "ResultCode"
      r: true
      t: "`$INTEGER`"
    }
    Skip: {
      fo: "int32"
      h: "Skip"
      n: "Skip"
      r: false
      sh: "The amount of records to by-pass before returning the remaining records"
      t: "`$INTEGER`"
    }
    Take: {
      fo: "int32"
      h: "Take"
      n: "Take"
      r: true
      sh: "The amount of records to return"
      t: "`$INTEGER`"
    }
    TransferRecord: {
      h: "Transfer Record"
      n: "TransferRecord"
      r: true
      t: "`$OBJECT`"
    }
    TransferRef: {
      h: "Transfer Ref"
      n: "TransferRef"
      r: false
      sh: "Filter by Ding TransferRef"
      t: "`$STRING`"
    }
  }

  name: "transfer_record"
  op: {
    list: {
      name: "list"
      points: [
        {
          bf: [
            "AccountNumber"
            "DistributorRef"
            "Skip"
            "Take"
            "TransferRef"
          ]
          co: {
            id: "POST /api/V1/ListTransferRecords"
            source: "swagger2"
            version: 2
          }
          g: {
            header: [
              {
                explode: false
                k: "header"
                n: "x_correlation_id"
                or: "X-Correlation-Id"
                r: false
                style: "simple"
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/api/V1/ListTransferRecords"
          rs: {
            alternatives: [
              {
                kind: "json"
                media: "text/json"
              }
            ]
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "V1"
            }
            {
              lit: "ListTransferRecords"
            }
          ]
          t: {
            req: {
              AccountNumber: "`reqdata.account_number`"
              DistributorRef: "`reqdata.distributor_ref`"
              Skip: "`reqdata.skip`"
              Take: "`reqdata.take`"
              TransferRef: "`reqdata.transfer_ref`"
            }
            res: "`body.Items`"
          }
        }
      ]
    }
  }



}