# Entity: country

main: kit: entity: country: {

  alias: field: {}

  fields: {
    CountryIso: {
      h: "Country Iso"
      n: "CountryIso"
      r: true
      sh: "Alphabetic 2 character ISO country code"
      t: "`$STRING`"
    }
    CountryName: {
      h: "Country Name"
      n: "CountryName"
      r: true
      sh: "English country name"
      t: "`$STRING`"
    }
    InternationalDialingInformation: {
      h: "International Dialing Information"
      n: "InternationalDialingInformation"
      r: true
      sh: "Phone number dialing information"
      t: "`$ARRAY`"
    }
    RegionCodes: {
      h: "Region Codes"
      n: "RegionCodes"
      r: true
      sh: "Regions supported within the country"
      t: "`$ARRAY`"
    }
  }

  name: "country"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/V1/GetCountries"
            source: "swagger2"
            version: 2
          }
          g: {
            header: [
              {
                explode: false
                k: "header"
                n: "x_correlation_id"
                or: "X-Correlation-Id"
                r: false
                style: "simple"
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/V1/GetCountries"
          rs: {
            alternatives: [
              {
                kind: "json"
                media: "text/json"
              }
            ]
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "V1"
            }
            {
              lit: "GetCountries"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.Items`"
          }
        }
      ]
    }
  }



}