            id: "POST /api/V1/ListTransferRecords"
            json: "{\"consumes\":[\"application/json\"],\"operationId\":\"ListTransferRecords\",\"parameters\":[{\"description\":\"Correlates HTTP requests between a client and server\",\"in\":\"header\",\"name\":\"X-Correlation-Id\",\"type\":\"String\"},{\"in\":\"body\",\"name\":\"request\",\"required\":true,\"schema\":{\"additionalProperties\":false,\"properties\":{\"AccountNumber\":{\"description\":\"Filter transfers by AccountNumber\",\"type\":\"string\"},\"DistributorRef\":{\"description\":\"Filter transfers by DistributorRef.\",\"type\":\"string\"},\"Skip\":{\"description\":\"The amount of records to by-pass before returning the remaining records\",\"format\":\"int32\",\"type\":\"integer\"},\"Take\":{\"description\":\"The amount of records to return\",\"format\":\"int32\",\"type\":\"integer\"},\"TransferRef\":{\"description\":\"Filter by Ding TransferRef\",\"type\":\"string\"}},\"required\":[\"Take\"],\"type\":\"object\"}}],\"produces\":[\"application/json\",\"text/json\"],\"protocol\":\"http\",\"responses\":{\"200\":{\"description\":\"OK\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"Items\":{\"description\":\"The list of items satisfying the transfer query.\",\"items\":{\"additionalProperties\":false,\"description\":\"Captures the TransferRecord that was created when a SendTransfer was submitted and any ErrorCodes that resulted\",\"properties\":{\"ErrorCodes\":{\"description\":\"Any error codes that were returned as part of the SendTransfer or in the case of a Batch `ProcessingMode`\\nthat may have occurred later after the batch was submitted to the Provider.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"},\"TransferRecord\":{\"additionalProperties\":false,\"properties\":{\"AccountNumber\":{\"description\":\"The account number targeted in the transfer\",\"type\":\"string\"},\"CommissionApplied\":{\"description\":\"The actual commision that was earned for selling this transfer\",\"format\":\"decimal\",\"type\":\"number\"},\"CompletedUtc\":{\"description\":\"The UTC datetime that the transfer was recorded as being completed in our system\",\"format\":\"date-time\",\"type\":\"string\"},\"Price\":{\"additionalProperties\":false,\"properties\":{\"CustomerFee\":{\"description\":\"The fee that the distributor has asked us to collect from the customer\",\"format\":\"decimal\",\"type\":\"number\"},\"DistributorFee\":{\"description\":\"The fee that Ding charges the distributor to fulfil the transfer\",\"format\":\"decimal\",\"type\":\"number\"},\"ReceiveCurrencyIso\":{\"description\":\"The currency of the ReceiveValue and ReceiveValueExcludingTax fields\",\"type\":\"string\"},\"ReceiveValue\":{\"description\":\"The estimated value that will be received by the target account, including any tax (if applicable).\",\"format\":\"decimal\",\"type\":\"number\"},\"ReceiveValueExcludingTax\":{\"description\":\"The estimated amount received into the account before Tax was added\",\"format\":\"decimal\",\"type\":\"number\"},\"SendCurrencyIso\":{\"description\":\"The currency of the SendValue field\",\"type\":\"string\"},\"SendValue\":{\"description\":\"The value that is submitted to SendTransfer\",\"format\":\"decimal\",\"type\":\"number\"},\"TaxCalculation\":{\"description\":\"The type of calculation that was done (can vary by country)\",\"type\":\"string\"},\"TaxName\":{\"description\":\"The name of the tax applicable to this product\",\"type\":\"string\"},\"TaxRate\":{\"description\":\"The tax rate that was applied\",\"format\":\"decimal\",\"type\":\"number\"}},\"required\":[\"CustomerFee\",\"DistributorFee\",\"ReceiveValue\",\"ReceiveCurrencyIso\",\"ReceiveValueExcludingTax\",\"SendValue\",\"SendCurrencyIso\"],\"type\":\"object\"},\"ProcessingState\":{\"description\":\"Will indicate the current state of the transfer as it progresses through our system\",\"type\":\"string\"},\"ReceiptParams\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Name value pairs of data that is in the ReceiptText along with other transactional details returned by the provider\",\"type\":\"object\"},\"ReceiptText\":{\"description\":\"Provider specific receipt text for the transfer. May contain additional information for the end customer.\",\"type\":\"string\"},\"SkuCode\":{\"description\":\"The unique product SkuCode\",\"type\":\"string\"},\"StartedUtc\":{\"description\":\"The UTC datetime when processing the transfer was started.\",\"format\":\"date-time\",\"type\":\"string\"},\"TransferId\":{\"additionalProperties\":false,\"properties\":{\"DistributorRef\":{\"description\":\"The distributor's identifier for the transfer.\",\"type\":\"string\"},\"TransferRef\":{\"description\":\"The unique identifier for the transfer within our system\",\"type\":\"string\"}},\"required\":[\"TransferRef\",\"DistributorRef\"],\"type\":\"object\"}},\"required\":[\"SkuCode\",\"CommissionApplied\",\"ProcessingState\",\"AccountNumber\"],\"type\":\"object\"}},\"required\":[\"TransferRecord\",\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"},\"ThereAreMoreItems\":{\"description\":\"Indicates if the caller should execute the query again.\",\"type\":\"boolean\"}},\"required\":[\"ResultCode\",\"ErrorCodes\",\"Items\",\"ThereAreMoreItems\"],\"type\":\"object\"}},\"400\":{\"description\":\"BadRequest\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"401\":{\"description\":\"Unauthorized\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"500\":{\"description\":\"InternalServerError\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"503\":{\"description\":\"ServiceUnavailable\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}}},\"securitySchemes\":{\"APIKeyHeader\":{\"description\":\"Use the API key that was issued to you.\",\"in\":\"header\",\"name\":\"api_key\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"
