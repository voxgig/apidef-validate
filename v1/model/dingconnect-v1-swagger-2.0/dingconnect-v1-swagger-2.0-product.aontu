          contract: {
            id: "GET /api/V1/GetProducts"
            json: "{\"operationId\":\"GetProducts\",\"parameters\":[{\"collectionFormat\":\"multi\",\"description\":\"Filter the list to products for countries with the given ISOs.\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"countryIsos\",\"type\":\"array\"},{\"collectionFormat\":\"multi\",\"description\":\"Filter the list to products supplied by providers with the submitted provider codes.\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"providerCodes\",\"type\":\"array\"},{\"collectionFormat\":\"multi\",\"description\":\"Filter the list to products with the submitted SkuCodes.\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"skuCodes\",\"type\":\"array\"},{\"collectionFormat\":\"multi\",\"description\":\"Filter the list to products with the listed benefits.\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"benefits\",\"type\":\"array\"},{\"collectionFormat\":\"multi\",\"description\":\"Filter the list to products in regions with the submitted regionCodes.\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"regionCodes\",\"type\":\"array\"},{\"default\":\"\",\"description\":\"Filter the list to products that are valid for the submitted account number. For phone number based products, the account number should be in international phone number format.\",\"in\":\"query\",\"name\":\"accountNumber\",\"type\":\"string\"},{\"description\":\"Correlates HTTP requests between a client and server\",\"in\":\"header\",\"name\":\"X-Correlation-Id\",\"type\":\"String\"}],\"produces\":[\"application/json\",\"text/json\"],\"protocol\":\"http\",\"responses\":{\"200\":{\"description\":\"OK\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"Items\":{\"description\":\"A list of products that fulfil the submitted criteria.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"AdditionalInformation\":{\"description\":\"Any distributor specific information/caveats about this particular product\",\"type\":\"string\"},\"Benefits\":{\"description\":\"What type of benefits will the transfer give to the target account\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"CommissionRate\":{\"description\":\"The rate of commission that will be applied for selling this product\",\"format\":\"decimal\",\"type\":\"number\"},\"DefaultDisplayText\":{\"description\":\"The Display text from the `LocalizedProductDescription` in the default language (usually \\\"en\\\").\",\"type\":\"string\"},\"LocalizationKey\":{\"description\":\"Key to be used in conjunction with `GetProductDescriptions`\",\"type\":\"string\"},\"LookupBillsRequired\":{\"description\":\"If true, it indicates to consume this product you must call LookupBills first and send the BillRef during the SendTransfer\",\"type\":\"boolean\"},\"Maximum\":{\"additionalProperties\":false,\"properties\":{\"CustomerFee\":{\"description\":\"The fee that the distributor has asked us to collect from the customer\",\"format\":\"decimal\",\"type\":\"number\"},\"DistributorFee\":{\"description\":\"The fee that Ding charges the distributor to fulfil the transfer\",\"format\":\"decimal\",\"type\":\"number\"},\"ReceiveCurrencyIso\":{\"description\":\"The currency of the ReceiveValue and ReceiveValueExcludingTax fields\",\"type\":\"string\"},\"ReceiveValue\":{\"description\":\"The estimated value that will be received by the target account, including any tax (if applicable).\",\"format\":\"decimal\",\"type\":\"number\"},\"ReceiveValueExcludingTax\":{\"description\":\"The estimated amount received into the account before Tax was added\",\"format\":\"decimal\",\"type\":\"number\"},\"SendCurrencyIso\":{\"description\":\"The currency of the SendValue field\",\"type\":\"string\"},\"SendValue\":{\"description\":\"The value that is submitted to SendTransfer\",\"format\":\"decimal\",\"type\":\"number\"},\"TaxCalculation\":{\"description\":\"The type of calculation that was done (can vary by country)\",\"type\":\"string\"},\"TaxName\":{\"description\":\"The name of the tax applicable to this product\",\"type\":\"string\"},\"TaxRate\":{\"description\":\"The tax rate that was applied\",\"format\":\"decimal\",\"type\":\"number\"}},\"required\":[\"CustomerFee\",\"DistributorFee\",\"ReceiveValue\",\"ReceiveCurrencyIso\",\"ReceiveValueExcludingTax\",\"SendValue\",\"SendCurrencyIso\"],\"type\":\"object\"},\"Minimum\":{\"additionalProperties\":false,\"properties\":{\"CustomerFee\":{\"description\":\"The fee that the distributor has asked us to collect from the customer\",\"format\":\"decimal\",\"type\":\"number\"},\"DistributorFee\":{\"description\":\"The fee that Ding charges the distributor to fulfil the transfer\",\"format\":\"decimal\",\"type\":\"number\"},\"ReceiveCurrencyIso\":{\"description\":\"The currency of the ReceiveValue and ReceiveValueExcludingTax fields\",\"type\":\"string\"},\"ReceiveValue\":{\"description\":\"The estimated value that will be received by the target account, including any tax (if applicable).\",\"format\":\"decimal\",\"type\":\"number\"},\"ReceiveValueExcludingTax\":{\"description\":\"The estimated amount received into the account before Tax was added\",\"format\":\"decimal\",\"type\":\"number\"},\"SendCurrencyIso\":{\"description\":\"The currency of the SendValue field\",\"type\":\"string\"},\"SendValue\":{\"description\":\"The value that is submitted to SendTransfer\",\"format\":\"decimal\",\"type\":\"number\"},\"TaxCalculation\":{\"description\":\"The type of calculation that was done (can vary by country)\",\"type\":\"string\"},\"TaxName\":{\"description\":\"The name of the tax applicable to this product\",\"type\":\"string\"},\"TaxRate\":{\"description\":\"The tax rate that was applied\",\"format\":\"decimal\",\"type\":\"number\"}},\"required\":[\"CustomerFee\",\"DistributorFee\",\"ReceiveValue\",\"ReceiveCurrencyIso\",\"ReceiveValueExcludingTax\",\"SendValue\",\"SendCurrencyIso\"],\"type\":\"object\"},\"PaymentTypes\":{\"description\":\"Indicates the supported payment types for this product. Current possible values are: Prepaid and Postpaid\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"ProcessingMode\":{\"description\":\"Transaction processing mode for this product\",\"type\":\"string\"},\"ProviderCode\":{\"description\":\"The provider of the product\",\"type\":\"string\"},\"RedemptionMechanism\":{\"description\":\"Indicates if the customer is required to take further action in order to redeem the transfer\",\"type\":\"string\"},\"RegionCode\":{\"description\":\"Region for this product\",\"type\":\"string\"},\"SettingDefinitions\":{\"description\":\"Name/Value pairs that should be submitted during `SendTransfer`\",\"items\":{\"additionalProperties\":false,\"properties\":{\"Description\":{\"description\":\"English explanation as to the purpose of the setting\",\"type\":\"string\"},\"IsMandatory\":{\"description\":\"Indicates if the setting must be submitted during `SendTransfer`\",\"type\":\"boolean\"},\"Name\":{\"description\":\"Setting name to use during SendTranfer\",\"type\":\"string\"}},\"required\":[\"Name\",\"Description\",\"IsMandatory\"],\"type\":\"object\"},\"type\":\"array\"},\"SkuCode\":{\"description\":\"Unique code to be used in conjunction with `SendTransfer` (SKU: \\\"Stock Keeping Unit\\\").\",\"type\":\"string\"},\"UatNumber\":{\"description\":\"User Acceptance Test Number\",\"type\":\"string\"},\"ValidityPeriodIso\":{\"description\":\"How long is the product valid for after purchase\",\"type\":\"string\"}},\"required\":[\"ProviderCode\",\"SkuCode\",\"LocalizationKey\",\"SettingDefinitions\",\"Maximum\",\"Minimum\",\"CommissionRate\",\"ProcessingMode\",\"RedemptionMechanism\",\"Benefits\",\"UatNumber\",\"DefaultDisplayText\",\"RegionCode\",\"PaymentTypes\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\",\"Items\"],\"type\":\"object\"}},\"400\":{\"description\":\"BadRequest\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"401\":{\"description\":\"Unauthorized\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"500\":{\"description\":\"InternalServerError\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"503\":{\"description\":\"ServiceUnavailable\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}}},\"securitySchemes\":{\"APIKeyHeader\":{\"description\":\"Use the API key that was issued to you.\",\"in\":\"header\",\"name\":\"api_key\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"
            source: "swagger2"
            version: 1
          }
