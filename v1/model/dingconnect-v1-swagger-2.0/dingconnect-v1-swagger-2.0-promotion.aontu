# Entity: promotion

main: kit: entity: promotion: {

  alias: field: {}

  fields: {
    CurrencyIso: {
      h: "Currency Iso"
      n: "CurrencyIso"
      r: true
      sh: "Currency promotion - usually the same as the Provider"
      t: "`$STRING`"
    }
    EndUtc: {
      fo: "date-time"
      h: "End Utc"
      n: "EndUtc"
      r: true
      sh: "End date and time in UTC of the promotion."
      t: "`$STRING`"
    }
    LocalizationKey: {
      h: "Localization Key"
      n: "LocalizationKey"
      r: true
      sh: "Key to be used in conjunction with `GetPromotionDescriptions`"
      t: "`$STRING`"
    }
    MinimumSendAmount: {
      fo: "decimal"
      h: "Minimum Send Amount"
      n: "MinimumSendAmount"
      r: true
      sh: "Minimum amount to be sent to apply for this promotion, specified in the distributor's currency"
      t: "`$NUMBER`"
    }
    ProviderCode: {
      h: "Provider Code"
      n: "ProviderCode"
      r: true
      sh: "The code of the provider that the promotion applies to"
      t: "`$STRING`"
    }
    StartUtc: {
      fo: "date-time"
      h: "Start Utc"
      n: "StartUtc"
      r: true
      sh: "Start date and time in UTC of the promotion"
      t: "`$STRING`"
    }
    ValidityPeriodIso: {
      h: "Validity Period Iso"
      n: "ValidityPeriodIso"
      r: false
      sh: "Validity of the promotion"
      t: "`$STRING`"
    }
  }

  name: "promotion"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/V1/GetPromotions"
            source: "swagger2"
            version: 2
          }
          g: {
            header: [
              {
                explode: false
                k: "header"
                n: "x_correlation_id"
                or: "X-Correlation-Id"
                r: false
                style: "simple"
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: ""
                explode: true
                k: "query"
                n: "account_number"
                or: "accountNumber"
                r: false
                style: "form"
                t: "`$STRING`"
              }
              {
                explode: true
                k: "query"
                n: "country_iso"
                or: "countryIsos"
                r: false
                style: "form"
                t: "`$ARRAY`"
              }
              {
                explode: true
                k: "query"
                n: "provider_code"
                or: "providerCodes"
                r: false
                style: "form"
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/api/V1/GetPromotions"
          rs: {
            alternatives: [
              {
                kind: "json"
                media: "text/json"
              }
            ]
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "V1"
            }
            {
              lit: "GetPromotions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.Items`"
          }
        }
      ]
    }
  }



}