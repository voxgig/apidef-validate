          contract: {
            id: "GET /api/V1/GetPromotions"
            json: "{\"operationId\":\"GetPromotions\",\"parameters\":[{\"collectionFormat\":\"multi\",\"description\":\"Filter the list to promotions for countries with the given ISOs.\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"countryIsos\",\"type\":\"array\"},{\"collectionFormat\":\"multi\",\"description\":\"Filter the list to promotions on products supplied by providers with the submitted provider codes.\",\"in\":\"query\",\"items\":{\"type\":\"string\"},\"name\":\"providerCodes\",\"type\":\"array\"},{\"default\":\"\",\"description\":\"Filter the list to promotions on products that are valid for the submitted account number. For phone number based products, the account number should be in international phone number format.\",\"in\":\"query\",\"name\":\"accountNumber\",\"type\":\"string\"},{\"description\":\"Correlates HTTP requests between a client and server\",\"in\":\"header\",\"name\":\"X-Correlation-Id\",\"type\":\"String\"}],\"produces\":[\"application/json\",\"text/json\"],\"protocol\":\"http\",\"responses\":{\"200\":{\"description\":\"OK\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"Items\":{\"description\":\"List of available promotions\",\"items\":{\"additionalProperties\":false,\"properties\":{\"CurrencyIso\":{\"description\":\"Currency promotion - usually the same as the Provider\",\"type\":\"string\"},\"EndUtc\":{\"description\":\"End date and time in UTC of the promotion. This will be DateTime.MaxValue if there is no end date.\",\"format\":\"date-time\",\"type\":\"string\"},\"LocalizationKey\":{\"description\":\"Key to be used in conjunction with `GetPromotionDescriptions`\",\"type\":\"string\"},\"MinimumSendAmount\":{\"description\":\"Minimum amount to be sent to apply for this promotion, specified in the distributor's currency\",\"format\":\"decimal\",\"type\":\"number\"},\"ProviderCode\":{\"description\":\"The code of the provider that the promotion applies to\",\"type\":\"string\"},\"StartUtc\":{\"description\":\"Start date and time in UTC of the promotion\",\"format\":\"date-time\",\"type\":\"string\"},\"ValidityPeriodIso\":{\"description\":\"Validity of the promotion\",\"type\":\"string\"}},\"required\":[\"ProviderCode\",\"StartUtc\",\"EndUtc\",\"CurrencyIso\",\"MinimumSendAmount\",\"LocalizationKey\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\",\"Items\"],\"type\":\"object\"}},\"400\":{\"description\":\"BadRequest\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"401\":{\"description\":\"Unauthorized\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"500\":{\"description\":\"InternalServerError\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}},\"503\":{\"description\":\"ServiceUnavailable\",\"schema\":{\"additionalProperties\":false,\"properties\":{\"ErrorCodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"Code\":{\"description\":\"The code that can be used to lookup the explanatory message associated with the error\",\"type\":\"string\"},\"Context\":{\"description\":\"API specific context as to the reason for the specific code\",\"type\":\"string\"}},\"required\":[\"Code\"],\"type\":\"object\"},\"type\":\"array\"},\"ResultCode\":{\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"ResultCode\",\"ErrorCodes\"],\"type\":\"object\"}}},\"securitySchemes\":{\"APIKeyHeader\":{\"description\":\"Use the API key that was issued to you.\",\"in\":\"header\",\"name\":\"api_key\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"
            source: "swagger2"
            version: 1
          }
          method: "GET"
