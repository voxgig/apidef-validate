# Entity: currency

main: kit: entity: currency: {

  alias: field: {}

  fields: {
    CurrencyIso: {
      h: "Currency Iso"
      n: "CurrencyIso"
      r: true
      sh: "Alphabetic 3 character ISO currency code"
      t: "`$STRING`"
    }
    CurrencyName: {
      h: "Currency Name"
      n: "CurrencyName"
      r: true
      t: "`$STRING`"
    }
  }

  name: "currency"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/V1/GetCurrencies"
            source: "swagger2"
            version: 2
          }
          g: {
            header: [
              {
                explode: false
                k: "header"
                n: "x_correlation_id"
                or: "X-Correlation-Id"
                r: false
                style: "simple"
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/V1/GetCurrencies"
          rs: {
            alternatives: [
              {
                kind: "json"
                media: "text/json"
              }
            ]
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "V1"
            }
            {
              lit: "GetCurrencies"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.Items`"
          }
        }
      ]
    }
  }



}