        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier of the user"
      t: "`$STRING`"
    }
    is_admin: {
      h: "Is Admin"
      n: "is_admin"
      r: false
      sh: "Indication about whether the user is an administrator of the school; true if she is, or false if she is not."
      t: "`$BOOLEAN`"
    }
    is_affiliate: {
      h: "Is Affiliate"
      n: "is_affiliate"
      r: false
      sh: "Indication about whether the user is an affiliate of the school; true if she is, or false if she is not."
      t: "`$BOOLEAN`"
    }
    is_instructor: {
      h: "Is Instructor"
      n: "is_instructor"
      r: false
      sh: "Indication about whether the user is an instructor in the school; true if she is, or false if she is not."
      t: "`$BOOLEAN`"
    }
    is_reporter: {
      h: "Is Reporter"
      n: "is_reporter"
      r: false
      sh: "Indication about whether the user is an reporter in the school; true if she is, or false if she is not."
