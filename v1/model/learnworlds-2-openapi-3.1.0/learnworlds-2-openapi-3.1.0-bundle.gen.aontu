# Entity: bundle

main: kit: entity: bundle: {

  alias: field: {}

  fields: {
    access: {
      h: "Access"
      n: "access"
      r: false
      sh: "Access type of the bundle"
      t: "`$STRING`"
    }
    afterPurchase: {
      h: "After Purchase"
      n: "afterPurchase"
      r: false
      sh: "After purchase navigation settings for this bundle"
      t: "`$OBJECT`"
    }
    created: {
      fo: "float"
      h: "Created"
      n: "created"
      r: false
      sh: "Date the bundle was created, in UNIX timestamp format"
      t: "`$NUMBER`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Bundle description"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier of the bundle"
      t: "`$STRING`"
    }
    image: {
      h: "Image"
      n: "image"
      r: false
      sh: "Bundle image (full URL)"
      t: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$STRING`"
        ]
      ]
    }
    modified: {
      fo: "float"
      h: "Modified"
      n: "modified"
      r: false
      sh: "Date the bundle was modified for the last time, in UNIX timestamp format"
      t: "`$NUMBER`"
    }
    paymentPlans: {
      h: "Payment Plans"
      n: "paymentPlans"
      r: false
      sh: "Payment plans associated with the bundle."
      t: "`$ARRAY`"
    }
    price: {
      fo: "float"
      h: "Price"
      n: "price"
      r: false
      sh: "Price of the bundle"
      t: "`$NUMBER`"
    }
    products: {
      h: "Products"
      n: "products"
      r: false
      sh: "Products in the bundle"
      t: "`$OBJECT`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "Title of the bundle"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "bundle"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /v2/bundles"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/v2/bundles"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "bundles"
            }
          ]
          select: {
            exist: [
              "authorization"
              "lw_client"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /v2/bundles/{id}"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/v2/bundles/{id}"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "bundles"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "authorization"
              "id"
              "lw_client"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}