              }
            ]
          }
          method: "POST"
          orig: "/v2/users/{id}/courses/{cid}/complete"
          parts: [
            "v2"
            "users"
            "{user_id}"
            "courses"
            "{course_id}"
            "complete"
          ]
          rename: {
            param: {
              cid: "course_id"
              id: "user_id"
            }
          }
          select: {
            exist: [
              "authorization"
              "course_id"
              "lw_client"
              "user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            header: [
              {
                kind: "header"
