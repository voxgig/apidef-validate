# Entity: calendar

main: kit: entity: calendar: {

  alias: field: {}

  fields: {
    bookingDetails: {
      h: "Booking Details"
      n: "bookingDetails"
      r: false
      sh: "Booking details of the event."
      t: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$OBJECT`"
        ]
      ]
    }
    productId: {
      h: "Product Id"
      n: "productId"
      r: false
      sh: "Unique identifier of the product"
      t: "`$STRING`"
    }
    startDate: {
      h: "Start Date"
      n: "startDate"
      r: false
      sh: "Start date of the event, in UNIX timestamp format"
      t: "`$NUMBER`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "Title of the event"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "Type of the event"
      t: "`$STRING`"
    }
  }

  name: "calendar"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v2/school/events"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                explode: false
                k: "header"
                n: "lw_client"
                or: "Lw-Client"
                r: true
                style: "simple"
                t: "`$STRING`"
              }
            ]
            query: [
              {
                explode: true
                k: "query"
                n: "event_type"
                or: "event_type"
                r: false
                style: "form"
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v2/school/events"
          q: {
            exist: [
              "lw_client"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "school"
            }
            {
              lit: "events"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}