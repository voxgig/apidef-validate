# Entity: calendar

main: kit: entity: calendar: {

  alias: field: {}

  fields: [
    {
      name: "bookingDetails"
      req: false
      short: "Booking details of the event."
      type: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$OBJECT`"
        ]
      ]
    }
    {
      name: "productId"
      req: false
      short: "Unique identifier of the product"
      type: "`$STRING`"
    }
    {
      name: "startDate"
      req: false
      short: "Start date of the event, in UNIX timestamp format"
      type: "`$NUMBER`"
    }
    {
      name: "title"
      req: false
      short: "Title of the event"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of the event"
      type: "`$STRING`"
    }
  ]

  name: "calendar"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "event_type"
                orig: "event_type"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/school/events"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "school"
            }
            {
              lit: "events"
            }
          ]
          select: {
            exist: [
              "authorization"
              "event_type"
              "lw_client"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}