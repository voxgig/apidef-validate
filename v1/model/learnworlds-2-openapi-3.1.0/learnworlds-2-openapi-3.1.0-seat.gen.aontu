            ]
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PUT"
          orig: "/v2/seats/{id}"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "seats"
