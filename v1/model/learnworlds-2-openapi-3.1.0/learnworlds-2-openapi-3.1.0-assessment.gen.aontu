# Entity: assessment

main: kit: entity: assessment: {

  alias: field: {}

  fields: [
    {
      name: "answers"
      req: false
      short: "Related answers data"
      type: "`$ARRAY`"
    }
    {
      name: "created"
      req: false
      short: "Date the submission was created (started), in UNIX timestamp format"
      type: "`$NUMBER`"
    }
    {
      name: "email"
      req: false
      short: "Email account of the user who submitted the responses"
      type: "`$STRING`"
    }
    {
      name: "generalFeedback"
      req: false
      short: "General feedback for a submission"
      type: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "grade"
      req: false
      short: "The grade that corresponds to the responses provided by the user"
      type: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "id"
      req: false
      short: "Unique identifier of the submission of responses by the user specified by the user id"
      type: "`$STRING`"
    }
    {
      name: "modified"
      req: false
      short: "Date the submission was modified for the last time, in UNIX timestamp format"
      type: "`$NUMBER`"
    }
    {
      name: "passed"
      req: false
      short: "Indication about whether or not the assessment result was passed or failed"
      type: [
        "`$ONE`"
        [
          "`$BOOLEAN`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "submittedTimestamp"
      req: false
      short: "Date the submission was finished (submitted), in UNIX timestamp format"
      type: "`$NUMBER`"
    }
    {
      name: "user_id"
      req: false
      short: "Unique identifier of the user who submitted the responses"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "assessment"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "form_id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "items_per_page"
                orig: "items_per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "user"
                orig: "user"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/forms/{id}/responses"
          rename: {
            param: {
              id: "form_id"
            }
          }
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "forms"
            }
            {
              var: "form_id"
            }
            {
              lit: "responses"
            }
          ]
          select: {
            exist: [
              "authorization"
              "form_id"
              "items_per_page"
              "lw_client"
              "page"
              "user"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "items_per_page"
                orig: "items_per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "user"
                orig: "user"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/assessments/{id}/responses"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "assessments"
            }
            {
              var: "id"
            }
            {
              lit: "responses"
            }
          ]
          select: {
            "$action": "response"
            exist: [
              "authorization"
              "id"
              "items_per_page"
              "lw_client"
              "page"
              "user"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "form"
      ]
    ]
  }



}