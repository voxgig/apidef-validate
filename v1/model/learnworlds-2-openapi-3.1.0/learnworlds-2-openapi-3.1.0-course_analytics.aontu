# Entity: course_analytics

main: kit: entity: course_analytics: {

  alias: field: {}

  fields: [
    {
      name: "avg_score_rate"
      req: false
      short: "Average score (%)"
      type: "`$NUMBER`"
    }
    {
      name: "avg_time_to_finish"
      req: false
      short: "Average time to finish the course in seconds"
      type: "`$INTEGER`"
    }
    {
      name: "certificates_issued"
      req: false
      short: "Number of issued certifications"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "learning_units"
      req: false
      short: "Number of learning activities"
      type: "`$INTEGER`"
    }
    {
      name: "social_interactions"
      req: false
      short: "Number of social interactions"
      type: "`$INTEGER`"
    }
    {
      name: "students"
      req: false
      short: "Number of students"
      type: "`$INTEGER`"
    }
    {
      name: "success_rate"
      req: false
      short: "Success rate (%)"
      type: "`$NUMBER`"
    }
    {
      name: "total_study_time"
      req: false
      short: "Total study time in seconds"
      type: "`$INTEGER`"
    }
    {
      name: "video_time"
      req: false
      short: "Total video duration of the course in seconds"
      type: "`$INTEGER`"
    }
    {
      name: "video_viewing_time"
      req: false
      short: "Total video time viewed"
      type: "`$INTEGER`"
    }
    {
      name: "videos"
      req: false
      short: "Number of videos"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "course_analytics"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/courses/{id}/analytics"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "courses"
            }
            {
              var: "id"
            }
            {
              lit: "analytics"
            }
          ]
          select: {
            exist: [
              "authorization"
              "id"
              "lw_client"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}