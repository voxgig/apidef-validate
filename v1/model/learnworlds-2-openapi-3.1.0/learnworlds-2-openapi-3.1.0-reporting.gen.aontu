# Entity: reporting

main: kit: entity: reporting: {

  alias: field: {}

  fields: {
    average_score_rate: {
      fo: "float"
      h: "Average Score Rate"
      n: "average_score_rate"
      r: false
      sh: "Average score percentage"
      t: "`$NUMBER`"
    }
    completed_at: {
      h: "Completed At"
      n: "completed_at"
      r: false
      sh: "Completion date in UNIX timestamp format."
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    completed_units: {
      h: "Completed Units"
      n: "completed_units"
      r: false
      sh: "Total number of completed course learning activities by the user"
      t: "`$INTEGER`"
    }
    course_id: {
      h: "Course Id"
      n: "course_id"
      r: false
      sh: "Unique identifier of the course"
      t: "`$STRING`"
    }
    progress_per_section_unit: {
      h: "Progress Per Section Unit"
      n: "progress_per_section_unit"
      r: false
      sh: "User progress data per section/learning activity"
      t: "`$ARRAY`"
    }
    progress_rate: {
      fo: "float"
      h: "Progress Rate"
      n: "progress_rate"
      r: false
      sh: "Progress rate (%)"
      t: "`$NUMBER`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "Status of user progress"
      t: "`$STRING`"
    }
    time_on_course: {
      h: "Time On Course"
      n: "time_on_course"
      r: false
      sh: "Time spent on the course in seconds"
      t: "`$INTEGER`"
    }
    total_units: {
      h: "Total Units"
      n: "total_units"
      r: false
      sh: "Total number of course learning activities"
      t: "`$INTEGER`"
    }
  }

  name: "reporting"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "user_id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "items_per_page"
                orig: "items_per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "1"
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /v2/users/{id}/progress"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/v2/users/{id}/progress"
          rename: {
            param: {
              id: "user_id"
            }
          }
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "users"
            }
            {
              var: "user_id"
            }
            {
              lit: "progress"
            }
          ]
          select: {
            exist: [
              "authorization"
              "items_per_page"
              "lw_client"
              "page"
              "user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "user"
      ]
    ]
  }



}