    original_price: {
      fo: "float"
      h: "Original Price"
      n: "original_price"
      r: false
      sh: "Original price of the course"
      t: "`$NUMBER`"
    }
    price: {
      fo: "float"
      h: "Price"
      n: "price"
      r: false
      sh: "Price of the course"
      t: "`$NUMBER`"
    }
    title: {
      h: "Title"
      n: "title"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "Title of the course"
      t: "`$STRING`"
    }
    titleId: {
      h: "Title Id"
      n: "titleId"
      r: true
      sh: "Unique identifier of the course title."
      t: "`$STRING`"
    }
  }

