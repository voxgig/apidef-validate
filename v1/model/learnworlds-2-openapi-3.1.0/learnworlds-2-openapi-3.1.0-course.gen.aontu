      h: "Course Image"
      n: "courseImage"
      r: false
      sh: "Course image (full URL)"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    created: {
      fo: "float"
      h: "Created"
      n: "created"
      r: false
      sh: "Date the course was created, in UNIX timestamp format"
      t: "`$NUMBER`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Description of the course"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    discount_price: {
      fo: "float"
      h: "Discount Price"
      n: "discount_price"
      r: false
      sh: "Discount price of the course"
      t: "`$NUMBER`"
    }
    dripFeed: {
      h: "Drip Feed"
      n: "dripFeed"
      r: false
      sh: "Course setting for scheduled course delivery (drip feed); none refers to drip feed not being enabled."
      t: "`$STRING`"
    }
    expires: {
      h: "Expires"
      n: "expires"
      r: false
      sh: "Expiration timeframe value, defines the expiration timeframe, together with the type / unit in the \"expiresType\" field."
      t: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$INTEGER`"
        ]
      ]
    }
    expiresType: {
      h: "Expires Type"
      n: "expiresType"
      r: false
      sh: "Expiration timeframe type / unit, defines the expiration timeframe, together with the actual value in the \"expires\" field."
      t: "`$STRING`"
    }
    final_price: {
      fo: "float"
      h: "Final Price"
      n: "final_price"
      r: false
      sh: "Final price of the course"
      t: "`$NUMBER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier of the course"
      t: "`$STRING`"
    }
    identifiers: {
      h: "Identifiers"
      n: "identifiers"
      r: false
      sh: "Course identifiers for in app purchases."
      t: "`$OBJECT`"
    }
    label: {
      h: "Label"
      n: "label"
      r: false
      sh: "Label of the course"
      t: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$STRING`"
        ]
      ]
    }
    modified: {
      fo: "float"
      h: "Modified"
      n: "modified"
      r: false
