# Entity: course

main: kit: entity: course: {

  alias: field: {}

  fields: {
    access: {
      h: "Access"
      n: "access"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "Access type of course"
      t: "`$STRING`"
    }
    afterPurchase: {
      h: "After Purchase"
      n: "afterPurchase"
      r: false
      sh: "After purchase navigation settings for this course"
      t: "`$OBJECT`"
    }
    author: {
      h: "Author"
      n: "author"
      r: false
      sh: "Information about the course author"
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    categories: {
      h: "Categories"
      n: "categories"
      r: false
      sh: "Categories this course belongs in"
      t: "`$ARRAY`"
    }
