# Entity: certificate

main: kit: entity: certificate: {

  alias: field: {}

  fields: {
    attempts: {
      fo: "float"
      h: "Attempts"
      n: "attempts"
      r: false
      sh: "Number of attempts"
      t: "`$INTEGER`"
    }
    course_id: {
      h: "Course Id"
      n: "course_id"
      r: false
      sh: "Unique identifier of the course"
      t: "`$STRING`"
    }
    external_url: {
      h: "External Url"
      n: "external_url"
      r: false
      sh: "External URL of the certificate; null if provider is LearnWorlds"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    form: {
      h: "Form"
      n: "form"
      op: {
        update: {
          req: true
          type: "`$OBJECT`"
        }
      }
      r: false
      sh: "Form data of the certificate"
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier of the certificate"
      t: "`$STRING`"
    }
    issued: {
      fo: "float"
      h: "Issued"
      n: "issued"
      op: {
        update: {
          req: true
          type: "`$NUMBER`"
        }
      }
      r: false
      sh: "Date the certification was issued, in Unix timestamp format"
      t: "`$NUMBER`"
    }
    provider: {
      h: "Provider"
      n: "provider"
      r: false
      sh: "Provider of the certificate"
      t: "`$STRING`"
    }
    score: {
      h: "Score"
      n: "score"
      r: false
      sh: "Score of the certificate"
      t: "`$STRING`"
    }
    short_url: {
      h: "Short Url"
      n: "short_url"
      r: false
      sh: "Short URL of the certificate"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "Status of the certificate"
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "Title of the certificate"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "Type of the certificate"
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      sh: "User related data"
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "certificate"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "course_id"
                orig: "course_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "user_id"
                orig: "user_id"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /v2/certificates"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/v2/certificates"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "certificates"
            }
          ]
          select: {
            exist: [
              "authorization"
              "course_id"
              "lw_client"
              "page"
              "user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
