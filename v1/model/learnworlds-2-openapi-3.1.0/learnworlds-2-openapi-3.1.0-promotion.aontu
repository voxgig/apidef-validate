# Entity: promotion

main: kit: entity: promotion: {

  alias: field: {}

  fields: [
    {
      name: "applies_to_all"
      req: false
      short: "All courses and/or bundles that the promotion coupon will be applied to."
      type: "`$ARRAY`"
    }
    {
      name: "bulk"
      req: false
      short: "Indication about whether there's a bulk set of codes created for this coupon."
      type: "`$BOOLEAN`"
    }
    {
      name: "code"
      req: false
      short: "Coupon code"
      type: "`$STRING`"
    }
    {
      name: "coupons"
      req: false
      short: "Promotion coupons"
      type: "`$ARRAY`"
    }
    {
      name: "created"
      req: false
      short: "Date the promotion was created, in UNIX timestamp format"
      type: "`$NUMBER`"
    }
    {
      name: "expires"
      req: false
      short: "Coupon expiration date, in YYYY-MM-DD format"
      type: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$STRING`"
        ]
      ]
    }
    {
      name: "id"
      req: false
      short: "Unique identifier of the promotion"
      type: "`$STRING`"
    }
    {
      name: "modified"
      req: false
      short: "Date the promotion was modified for the last time, in UNIX timestamp format"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "Name of the promotion"
      type: "`$STRING`"
    }
    {
      name: "prefix"
      req: false
      short: "Coupon prefix"
      type: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "products"
      req: false
      short: "Specific products that the promotion coupon will be applied to"
      type: "`$ARRAY`"
    }
    {
      name: "quantity"
      req: false
      short: "Number of redemptions that are allowed for this coupon (null as a value means that there is no limit in how many times a coupon can be redeemed)"
      type: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "times_used"
      req: false
      short: "Coupon number of times used."
      type: "`$INTEGER`"
    }
    {
      name: "type"
      req: false
      short: "Type of discount"
      type: "`$STRING`"
    }
    {
      name: "value"
      req: false
      short: "Percentage or fixed amount of discount"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "promotion"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/v2/promotions"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "promotions"
            }
          ]
          select: {
            exist: [
              "authorization"
              "lw_client"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "id"
                orig: "pid"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/promotions/{pid}/coupons"
          rename: {
            param: {
              pid: "id"
            }
          }
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "promotions"
            }
            {
              var: "id"
            }
            {
              lit: "coupons"
            }
          ]
          select: {
            "$action": "coupon"
            exist: [
              "authorization"
              "id"
              "lw_client"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/promotions"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "promotions"
            }
          ]
          select: {
            exist: [
              "authorization"
              "lw_client"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/promotions/{id}"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "promotions"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "authorization"
              "id"
              "lw_client"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}