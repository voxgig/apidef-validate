# Entity: installment

main: kit: entity: installment: {

  alias: field: {}

  fields: [
    {
      name: "amount"
      req: false
      short: "Amount per installment"
      type: "`$NUMBER`"
    }
    {
      name: "current_period_end"
      req: false
      short: "End of the current period that the installment has been invoiced for, in UNIX timestamp format"
      type: "`$NUMBER`"
    }
    {
      name: "current_period_start"
      req: false
      short: "Start of the current period that the installment has been invoiced for, in UNIX timestamp format"
      type: "`$NUMBER`"
    }
    {
      name: "email"
      req: false
      short: "Email of the user"
      type: "`$STRING`"
    }
    {
      name: "ends_at"
      req: false
      short: "Datetime the installment ends, in UNIX timestamp format"
      type: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "firstAmount"
      req: false
      short: "Ιnitial amount of money the customers have to pay up front."
      type: "`$NUMBER`"
    }
    {
      name: "firstInstallmentDate"
      req: false
      short: "Date of the first installment, in UNIX timestamp format"
      type: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "firstInstallmentType"
      req: false
      short: "Type of the first installment"
      type: "`$STRING`"
    }
    {
      name: "firstInstallmentlDays"
      req: false
      short: "Number of days since the first installment"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier of the installment"
      type: "`$STRING`"
    }
    {
      name: "installmentIntervalType"
      req: false
      short: "How much time between each installment"
      type: "`$STRING`"
    }
    {
      name: "isCancelable"
      req: false
      short: "Indication about whether the installment can be canceled; true if it is cancelable, or false if it is not."
      type: "`$BOOLEAN`"
    }
    {
      name: "name"
      req: false
      short: "Name of the installment"
      type: "`$STRING`"
    }
    {
      name: "paymentsCount"
      req: false
      short: "Number of payments of the installment"
      type: "`$NUMBER`"
    }
    {
      name: "paymentsPayed"
      req: false
      short: "Number of completed payments of the installment"
      type: "`$NUMBER`"
    }
    {
      name: "plan_id"
      req: false
      short: "Unique identifier of the subscription plan"
      type: "`$STRING`"
    }
    {
      name: "productId"
      req: false
      short: "Unique identifier of the product"
      type: "`$STRING`"
    }
    {
      name: "productType"
      req: false
      short: "Type of the product"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Status of the installment"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of the installment"
      type: "`$STRING`"
    }
    {
      name: "user_id"
      req: false
      short: "Unique identifier of the user"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "installment"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "product_id"
                orig: "product_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "product_type"
                orig: "product_type"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "user_id"
                orig: "user_id"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/installments/active"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "installments"
            }
            {
              lit: "active"
            }
          ]
          select: {
            "$action": "active"
            exist: [
              "authorization"
              "lw_client"
              "page"
              "product_id"
              "product_type"
              "user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}