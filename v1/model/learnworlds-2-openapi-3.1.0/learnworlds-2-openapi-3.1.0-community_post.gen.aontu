# Entity: community_post

main: kit: entity: community_post: {

  alias: field: {}

  fields: [
    {
      name: "created"
      req: false
      short: "Date the post was made, in UNIX timestamp format"
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier of the post"
      type: "`$STRING`"
    }
    {
      name: "items"
      req: false
      short: "List of post content items outside of text content"
      type: "`$ARRAY`"
    }
    {
      name: "likes"
      req: false
      short: "List of users who have liked the post"
      type: "`$ARRAY`"
    }
    {
      name: "mentions"
      req: false
      short: "User mentions of the post"
      type: "`$ARRAY`"
    }
    {
      name: "posted_in"
      req: false
      short: "Information about where the post was made"
      type: "`$OBJECT`"
    }
    {
      name: "text"
      req: false
      short: "Text content of the post"
      type: "`$STRING`"
    }
    {
      name: "upvotes"
      req: false
      short: "List of users who have upvoted the post"
      type: "`$ARRAY`"
    }
    {
      name: "user"
      req: false
      short: "Information about the post author"
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "community_post"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/community/posts/{id}"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "community"
            }
            {
              lit: "posts"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "authorization"
              "id"
              "lw_client"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}