# Entity: community_post

main: kit: entity: community_post: {

  alias: field: {}

  fields: {
    created: {
      fo: "float"
      h: "Created"
      n: "created"
      r: false
      sh: "Date the post was made, in UNIX timestamp format"
      t: "`$NUMBER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier of the post"
      t: "`$STRING`"
    }
    items: {
      h: "Items"
      n: "items"
      r: false
      sh: "List of post content items outside of text content"
      t: "`$ARRAY`"
    }
    likes: {
      h: "Likes"
      n: "likes"
      r: false
      sh: "List of users who have liked the post"
      t: "`$ARRAY`"
    }
    mentions: {
      h: "Mentions"
      n: "mentions"
      r: false
      sh: "User mentions of the post"
      t: "`$ARRAY`"
    }
    posted_in: {
      h: "Posted In"
      n: "posted_in"
      r: false
      sh: "Information about where the post was made"
      t: "`$OBJECT`"
    }
    text: {
      h: "Text"
      n: "text"
      r: false
      sh: "Text content of the post"
      t: "`$STRING`"
    }
    upvotes: {
      h: "Upvotes"
      n: "upvotes"
      r: false
      sh: "List of users who have upvoted the post"
      t: "`$ARRAY`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      sh: "Information about the post author"
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "community_post"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v2/community/posts"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "authorization"
                or: "Authorization"
                r: true
                t: "`$STRING`"
              }
              {
                k: "header"
                n: "lw_client"
                or: "Lw-Client"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "course_id"
                or: "course_id"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "items_per_page"
                or: "items_per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "mention"
                or: "mentions"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "space_id"
                or: "space_id"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "user_id"
                or: "user_id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v2/community/posts"
          q: {
            "$action": "post"
            exist: [
              "authorization"
              "lw_client"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "community"
            }
            {
              lit: "posts"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v2/community/posts/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "authorization"
                or: "Authorization"
                r: true
                t: "`$STRING`"
              }
              {
                k: "header"
                n: "lw_client"
                or: "Lw-Client"
                r: true
                t: "`$STRING`"
              }
            ]
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v2/community/posts/{id}"
          q: {
            exist: [
              "authorization"
              "id"
              "lw_client"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "community"
            }
            {
              lit: "posts"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}