# Entity: community_post

main: kit: entity: community_post: {

  alias: field: {}

  fields: {
    created: {
      fo: "float"
      h: "Created"
      n: "created"
      r: false
      sh: "Date the post was made, in UNIX timestamp format"
      t: "`$NUMBER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier of the post"
      t: "`$STRING`"
    }
    items: {
      h: "Items"
      n: "items"
      r: false
      sh: "List of post content items outside of text content"
      t: "`$ARRAY`"
    }
    likes: {
      h: "Likes"
      n: "likes"
      r: false
      sh: "List of users who have liked the post"
      t: "`$ARRAY`"
    }
    mentions: {
      h: "Mentions"
      n: "mentions"
      r: false
      sh: "User mentions of the post"
      t: "`$ARRAY`"
    }
    posted_in: {
      h: "Posted In"
      n: "posted_in"
      r: false
      sh: "Information about where the post was made"
      t: "`$OBJECT`"
    }
    text: {
      h: "Text"
      n: "text"
      r: false
      sh: "Text content of the post"
      t: "`$STRING`"
    }
    upvotes: {
      h: "Upvotes"
      n: "upvotes"
      r: false
      sh: "List of users who have upvoted the post"
      t: "`$ARRAY`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      sh: "Information about the post author"
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "community_post"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "lw_client"
                orig: "lw_client"
                reqd: true
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /v2/community/posts/{id}"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/v2/community/posts/{id}"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "community"
            }
            {
              lit: "posts"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "authorization"
              "id"
              "lw_client"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}