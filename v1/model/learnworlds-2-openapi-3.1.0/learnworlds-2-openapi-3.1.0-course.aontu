# Entity: course

main: kit: entity: course: {

  alias: field: {}

  fields: [
    {
      name: "access"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "Access type of course"
      type: "`$STRING`"
    }
    {
      name: "afterPurchase"
      req: false
      short: "After purchase navigation settings for this course"
      type: "`$OBJECT`"
    }
    {
      name: "author"
      req: false
      short: "Information about the course author"
