        "`$ONE`"
        [
          "`$NULL`"
          "`$INTEGER`"
        ]
      ]
    }
    {
      name: "expiresType"
      req: false
      short: "Expiration timeframe type / unit, defines the expiration timeframe, together with the actual value in the \"expires\" field."
