              }
            ]
          }
          method: "POST"
          orig: "/v2/seats/{id}/users/{uid}"
          rename: {
            param: {
              id: "seat_id"
            }
          }
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "seats"
            }
