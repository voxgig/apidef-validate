# Entity: lead

main: kit: entity: lead: {

  alias: field: {}

  fields: {
    created: {
      fo: "float"
      h: "Created"
      n: "created"
      r: false
      sh: "Date the lead was created, in UNIX timestamp format"
      t: "`$NUMBER`"
    }
    email: {
      h: "Email"
      n: "email"
      r: false
      sh: "Email account of the user"
      t: "`$STRING`"
    }
    eu_customer: {
      h: "Eu Customer"
      n: "eu_customer"
      r: false
      sh: "Indication of whether the user is located in Europe; true if she is, or false if she's not located in Europe."
      t: [
        "`$ONE`"
        [
          "`$BOOLEAN`"
          "`$NULL`"
        ]
      ]
    }
    first_name: {
      h: "First Name"
      n: "first_name"
      r: false
      sh: "First Name of the user"
      t: "`$STRING`"
    }
    last_name: {
      h: "Last Name"
      n: "last_name"
      r: false
      sh: "Last name of the user"
      t: "`$STRING`"
    }
    page_submitted: {
      h: "Page Submitted"
      n: "page_submitted"
      r: false
      sh: "Page of the academy, in which the lead submitted their email account"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    submissions: {
      h: "Submissions"
      n: "submissions"
      r: false
      sh: "Array of the all the submissions of this email account in lead capture forms of the academy"
      t: "`$ARRAY`"
    }
    subscribed_for_marketing_emails: {
      h: "Subscribed For Marketing Emails"
      n: "subscribed_for_marketing_emails"
      r: false
      sh: "Indication about whether the user has agreed to receive marketing emails; true if she has agreed and thus should receive marketing emails, or false if she has not."
      t: [
        "`$ONE`"
        [
          "`$BOOLEAN`"
          "`$NULL`"
        ]
      ]
    }
    tags: {
      h: "Tags"
      n: "tags"
      r: false
      sh: "Array of the tags of the user"
      t: "`$ARRAY`"
    }
    user_id: {
      fo: "float"
      h: "User Id"
      n: "user_id"
      r: false
      sh: "The unique identifier of the respective user"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    user_registered_at: {
      fo: "float"
      h: "User Registered At"
      n: "user_registered_at"
      r: false
      sh: "Date the respective lead was also registered as a user, in UNIX timestamp format"
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    utms: {
      h: "Utms"
      n: "utms"
      r: false
      sh: "Values of the UTM fields for this user"
      t: "`$OBJECT`"
    }
  }

  name: "lead"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v2/leads"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "authorization"
                or: "authorization"
                r: true
                t: "`$STRING`"
              }
              {
                k: "header"
                n: "lw_client"
                or: "lw_client"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/v2/leads"
          q: {
            exist: [
              "authorization"
              "lw_client"
              "page"
            ]
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "leads"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}