      t: "`$INTEGER`"
    }
    video_viewing_time: {
      h: "Video Viewing Time"
      n: "video_viewing_time"
      r: false
      sh: "Total video time viewed"
      t: "`$INTEGER`"
    }
    videos: {
      h: "Videos"
      n: "videos"
      r: false
