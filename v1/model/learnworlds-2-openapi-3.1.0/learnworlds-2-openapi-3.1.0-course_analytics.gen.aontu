# Entity: course_analytics

main: kit: entity: course_analytics: {

  alias: field: {}

  fields: {
    avg_score_rate: {
      fo: "float"
      h: "Avg Score Rate"
      n: "avg_score_rate"
      r: false
      sh: "Average score (%)"
