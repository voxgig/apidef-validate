    }
    avg_time_to_finish: {
      h: "Avg Time To Finish"
      n: "avg_time_to_finish"
      r: false
      sh: "Average time to finish the course in seconds"
      t: "`$INTEGER`"
    }
    certificates_issued: {
      h: "Certificates Issued"
      n: "certificates_issued"
      r: false
      sh: "Number of issued certifications"
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    learning_units: {
      h: "Learning Units"
      n: "learning_units"
      r: false
      sh: "Number of learning activities"
      t: "`$INTEGER`"
    }
    social_interactions: {
      h: "Social Interactions"
      n: "social_interactions"
      r: false
      sh: "Number of social interactions"
      t: "`$INTEGER`"
    }
    students: {
      h: "Students"
      n: "students"
      r: false
      sh: "Number of students"
      t: "`$INTEGER`"
    }
    success_rate: {
      fo: "float"
      h: "Success Rate"
      n: "success_rate"
