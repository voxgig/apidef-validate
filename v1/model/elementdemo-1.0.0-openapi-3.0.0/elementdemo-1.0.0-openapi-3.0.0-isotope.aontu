# Entity: isotope

main: kit: entity: isotope: {

  alias: field: {}

  fields: [
    {
      format: "float"
      name: "abundance"
      req: false
      short: "Natural abundance as a fraction, absent for synthetic isotopes."
      type: "`$NUMBER`"
    }
    {
      name: "element_id"
      req: true
      short: "Parent element identifier."
      type: "`$STRING`"
    }
    {
      name: "halflife"
      req: false
      short: "Half-life, absent for stable isotopes."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "Isotope identifier, symbol dash mass number."
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "mass"
      req: true
      short: "Isotopic mass in daltons."
      type: "`$NUMBER`"
    }
    {
      name: "mass_number"
      req: true
      short: "Total protons and neutrons."
      type: "`$INTEGER`"
    }
    {
      name: "mode"
      req: false
      short: "Primary decay mode, absent for stable isotopes."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "Isotope name."
      type: "`$STRING`"
    }
    {
      name: "product"
      req: false
      short: "Primary decay product isotope, absent for stable isotopes."
      type: "`$STRING`"
    }
    {
      name: "stable"
      req: true
      short: "True if the isotope is stable."
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

