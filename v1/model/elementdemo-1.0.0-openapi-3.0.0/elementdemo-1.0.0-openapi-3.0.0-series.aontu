# Entity: series

main: kit: entity: series: {

  alias: field: {}

  fields: {
    color: {
      h: "Color"
      n: "color"
      r: true
      sh: "Display color used by the element card renderer."
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: true
      sh: "One-line description of the series."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Series identifier."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Series name."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "series"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /series"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/series"
          s: [
            {
              lit: "series"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /series/{series_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "series_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/series/{series_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              series_id: "id"
            }
          }
          s: [
            {
              lit: "series"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}