# Entity: installation

main: kit: entity: installation: {

  alias: field: {}

  fields: {
    access_tokens_url: {
      fo: "uri"
      h: "Access Tokens Url"
      n: "access_tokens_url"
      r: true
      t: "`$STRING`"
    }
    account: {
      h: "Account"
      n: "account"
      r: true
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    app_id: {
      h: "App Id"
      n: "app_id"
      r: true
      t: "`$INTEGER`"
    }
    app_slug: {
      h: "App Slug"
      n: "app_slug"
      r: true
      t: "`$STRING`"
    }
    client_id: {
      h: "Client Id"
      n: "client_id"
      r: false
      t: "`$STRING`"
    }
    contact_email: {
      h: "Contact Email"
      n: "contact_email"
      r: false
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      t: "`$STRING`"
    }
    events: {
      h: "Events"
      n: "events"
      r: true
      t: "`$ARRAY`"
    }
    has_multiple_single_files: {
      h: "Has Multiple Single Files"
      n: "has_multiple_single_files"
      r: false
      t: "`$BOOLEAN`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The ID of the installation."
      t: "`$INTEGER`"
    }
    permissions: {
      h: "Permissions"
      n: "permissions"
      r: true
      sh: "The permissions granted to the user access token."
      t: "`$OBJECT`"
    }
    repositories_url: {
      fo: "uri"
      h: "Repositories Url"
      n: "repositories_url"
      r: true
      t: "`$STRING`"
    }
    repository_selection: {
      h: "Repository Selection"
      n: "repository_selection"
      r: true
      sh: "Describe whether all repositories have been selected or there's a selection involved"
      t: "`$STRING`"
    }
    single_file_name: {
      h: "Single File Name"
      n: "single_file_name"
      r: true
      t: "`$STRING`"
    }
    single_file_paths: {
      h: "Single File Paths"
      n: "single_file_paths"
      r: false
      t: "`$ARRAY`"
    }
    suspended_at: {
      fo: "date-time"
      h: "Suspended At"
      n: "suspended_at"
      r: true
      t: "`$STRING`"
    }
    suspended_by: {
      h: "Suspended By"
      n: "suspended_by"
      r: true
      sh: "A GitHub user."
      t: "`$OBJECT`"
    }
    target_id: {
      h: "Target Id"
      n: "target_id"
      r: true
      sh: "The ID of the user or organization this token is being scoped to."
      t: "`$INTEGER`"
    }
    target_type: {
      h: "Target Type"
      n: "target_type"
      r: true
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "installation"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /app/installations"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "outdated"
                or: "outdated"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "since"
                or: "since"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/app/installations"
          q: {
            exist: [
              "outdated"
              "page"
              "per_page"
              "since"
            ]
          }
          s: [
            {
              lit: "app"
            }
            {
              lit: "installations"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /repos/{owner}/{repo}/installation"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/installation"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "installation"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /orgs/{org}/installation"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/installation"
          q: {
            exist: [
              "org_id"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "installation"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /users/{username}/installation"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "username"
                or: "username"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/users/{username}/installation"
          q: {
            exist: [
              "username"
            ]
          }
          s: [
            {
              lit: "users"
            }
            {
              var: "username"
            }
            {
              lit: "installation"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /app/installations/{installation_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: 1
                k: "param"
                n: "id"
                or: "installation_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/app/installations/{installation_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              installation_id: "id"
            }
          }
          s: [
            {
              lit: "app"
            }
            {
              lit: "installations"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /app/installations/{installation_id}/suspended"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: 1
                k: "param"
                n: "id"
                or: "installation_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "DELETE"
          o: "/app/installations/{installation_id}/suspended"
          q: {
            "$action": "suspended"
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              installation_id: "id"
            }
          }
          s: [
            {
              lit: "app"
            }
            {
              lit: "installations"
            }
            {
              var: "id"
            }
            {
              lit: "suspended"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PUT /app/installations/{installation_id}/suspended"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: 1
                k: "param"
                n: "id"
                or: "installation_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "PUT"
          o: "/app/installations/{installation_id}/suspended"
          q: {
            "$action": "suspended"
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              installation_id: "id"
            }
          }
          s: [
            {
              lit: "app"
            }
            {
              lit: "installations"
            }
            {
              var: "id"
            }
            {
              lit: "suspended"
            }
