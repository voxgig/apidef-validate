# Entity: classroom_accepted_assignment

main: kit: entity: classroom_accepted_assignment: {

  alias: field: {}

  fields: {
    assignment: {
      h: "Assignment"
      n: "assignment"
      r: true
      sh: "A GitHub Classroom assignment"
      t: "`$OBJECT`"
    }
    commit_count: {
      h: "Commit Count"
      n: "commit_count"
      r: true
      sh: "Count of student commits."
      t: "`$INTEGER`"
    }
    grade: {
      h: "Grade"
      n: "grade"
      r: true
      sh: "Most recent grade."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier of the repository."
      t: "`$INTEGER`"
    }
    passing: {
      h: "Passing"
      n: "passing"
      r: true
      sh: "Whether a submission passed."
      t: "`$BOOLEAN`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: true
      sh: "A GitHub repository view for Classroom"
      t: "`$OBJECT`"
    }
    students: {
      h: "Students"
      n: "students"
      r: true
      t: "`$ARRAY`"
    }
    submitted: {
      h: "Submitted"
      n: "submitted"
      r: true
      sh: "Whether an accepted assignment has been submitted."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "classroom_accepted_assignment"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /assignments/{assignment_id}/accepted_assignments"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "assignment_id"
                or: "assignment_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/assignments/{assignment_id}/accepted_assignments"
          q: {
            exist: [
              "assignment_id"
              "page"
              "per_page"
            ]
          }
          s: [
            {
              lit: "assignments"
            }
            {
              var: "assignment_id"
            }
            {
              lit: "accepted_assignments"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "assignment"
      ]
    ]
  }



}