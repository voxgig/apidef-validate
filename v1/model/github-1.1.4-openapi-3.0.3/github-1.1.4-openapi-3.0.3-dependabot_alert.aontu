# Entity: dependabot_alert

main: kit: entity: dependabot_alert: {

  alias: field: {}

  fields: {
    auto_dismissed_at: {
      fo: "date-time"
      h: "Auto Dismissed At"
      n: "auto_dismissed_at"
      r: false
      ro: true
      sh: "The time that the alert was auto-dismissed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      ro: true
      sh: "The time that the alert was created in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    dependency: {
      h: "Dependency"
      n: "dependency"
      r: true
      ro: true
      sh: "Details for the vulnerable dependency."
      t: "`$OBJECT`"
    }
    dismissed_at: {
      fo: "date-time"
      h: "Dismissed At"
      n: "dismissed_at"
      r: true
      ro: true
      sh: "The time that the alert was dismissed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    dismissed_by: {
      h: "Dismissed By"
      n: "dismissed_by"
      r: true
      sh: "A GitHub user."
      t: "`$OBJECT`"
    }
    dismissed_comment: {
      h: "Dismissed Comment"
      n: "dismissed_comment"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "An optional comment associated with the alert's dismissal."
      t: "`$STRING`"
    }
    dismissed_reason: {
      h: "Dismissed Reason"
      n: "dismissed_reason"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The reason that the alert was dismissed."
      t: "`$STRING`"
    }
    fixed_at: {
      fo: "date-time"
      h: "Fixed At"
      n: "fixed_at"
      r: true
      ro: true
      sh: "The time that the alert was no longer detected and was considered fixed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      ro: true
      sh: "The GitHub URL of the alert resource."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    number: {
      h: "Number"
      n: "number"
      r: true
      ro: true
      sh: "The security alert number."
      t: "`$INTEGER`"
    }
    security_advisory: {
      h: "Security Advisory"
      n: "security_advisory"
      r: true
      ro: true
      sh: "Details for the GitHub Security Advisory."
      t: "`$OBJECT`"
    }
    security_vulnerability: {
      h: "Security Vulnerability"
      n: "security_vulnerability"
      r: true
      ro: true
      sh: "Details pertaining to one vulnerable version range for the advisory."
      t: "`$OBJECT`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      ro: true
      sh: "The state of the Dependabot alert."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      ro: true
      sh: "The time that the alert was last updated in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      ro: true
      sh: "The REST API URL of the alert resource."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "dependabot_alert"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/dependabot/alerts"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "before"
                or: "before"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "desc"
                k: "query"
                n: "direction"
                or: "direction"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "ecosystem"
                or: "ecosystem"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "epss_percentage"
                or: "epss_percentage"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 30
                k: "query"
                n: "first"
                or: "first"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "has"
                or: "has"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "last"
                or: "last"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "manifest"
                or: "manifest"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "package"
                or: "package"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "scope"
                or: "scope"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "severity"
                or: "severity"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "created"
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "state"
                or: "state"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/dependabot/alerts"
          q: {
            exist: [
              "after"
              "before"
              "direction"
              "ecosystem"
              "epss_percentage"
              "first"
              "has"
              "last"
              "manifest"
              "owner"
              "package"
              "page"
              "per_page"
              "repo"
              "scope"
              "severity"
              "sort"
              "state"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "dependabot"
            }
            {
              lit: "alerts"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/dependabot/alerts/{alert_number}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "alert_number"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/dependabot/alerts/{alert_number}"
          q: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          r: {
            param: {
              alert_number: "id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "dependabot"
            }
            {
              lit: "alerts"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PATCH /repos/{owner}/{repo}/dependabot/alerts/{alert_number}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "alert_number"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PATCH"
          o: "/repos/{owner}/{repo}/dependabot/alerts/{alert_number}"
          q: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          r: {
            param: {
              alert_number: "id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "dependabot"
            }
            {
              lit: "alerts"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: {
              dismissed_comment: "`reqdata.dismissed_comment`"
              dismissed_reason: "`reqdata.dismissed_reason`"
              state: "`reqdata.state`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.repo")]
  ]

}