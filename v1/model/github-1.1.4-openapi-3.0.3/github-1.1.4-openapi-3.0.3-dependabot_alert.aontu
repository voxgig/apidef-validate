          contract: {
            id: "GET /repos/{owner}/{repo}/dependabot/alerts"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/dependabot/alerts"
          segments: [
            {
              lit: "repos"
            }
