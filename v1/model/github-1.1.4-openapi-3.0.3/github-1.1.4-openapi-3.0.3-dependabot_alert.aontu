# Entity: dependabot_alert

main: kit: entity: dependabot_alert: {

  alias: field: {}

  fields: {
    auto_dismissed_at: {
      fo: "date-time"
      h: "Auto Dismissed At"
      n: "auto_dismissed_at"
      r: false
      ro: true
      sh: "The time that the alert was auto-dismissed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      ro: true
      sh: "The time that the alert was created in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    dependency: {
      h: "Dependency"
      n: "dependency"
      r: true
      ro: true
      sh: "Details for the vulnerable dependency."
      t: "`$OBJECT`"
    }
    dismissed_at: {
      fo: "date-time"
      h: "Dismissed At"
      n: "dismissed_at"
      r: true
      ro: true
      sh: "The time that the alert was dismissed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    dismissed_by: {
      h: "Dismissed By"
      n: "dismissed_by"
      r: true
      sh: "A GitHub user."
      t: "`$OBJECT`"
    }
    dismissed_comment: {
      h: "Dismissed Comment"
      n: "dismissed_comment"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "An optional comment associated with the alert's dismissal."
      t: "`$STRING`"
    }
    dismissed_reason: {
      h: "Dismissed Reason"
      n: "dismissed_reason"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The reason that the alert was dismissed."
      t: "`$STRING`"
    }
    fixed_at: {
      fo: "date-time"
      h: "Fixed At"
      n: "fixed_at"
      r: true
      ro: true
      sh: "The time that the alert was no longer detected and was considered fixed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      ro: true
      sh: "The GitHub URL of the alert resource."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    number: {
      h: "Number"
      n: "number"
      r: true
      ro: true
      sh: "The security alert number."
      t: "`$INTEGER`"
    }
    security_advisory: {
      h: "Security Advisory"
      n: "security_advisory"
      r: true
      ro: true
      sh: "Details for the GitHub Security Advisory."
      t: "`$OBJECT`"
    }
    security_vulnerability: {
      h: "Security Vulnerability"
      n: "security_vulnerability"
      r: true
      ro: true
      sh: "Details pertaining to one vulnerable version range for the advisory."
      t: "`$OBJECT`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      ro: true
      sh: "The state of the Dependabot alert."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      ro: true
      sh: "The time that the alert was last updated in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      ro: true
      sh: "The REST API URL of the alert resource."
      t: "`$STRING`"
    }
  }

