# Entity: pages_deployment_status

main: kit: entity: pages_deployment_status: {

  alias: field: {}

  fields: [
    {
      name: "status"
      req: false
      short: "The current status of the deployment."
      type: "`$STRING`"
    }
  ]

  name: "pages_deployment_status"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "pages_deployment_id"
                orig: "pages_deployment_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/pages/deployments/{pages_deployment_id}"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "pages"
            }
            {
              lit: "deployments"
            }
            {
              var: "pages_deployment_id"
            }
          ]
          select: {
            exist: [
              "owner"
              "pages_deployment_id"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "deployment"
      ]
    ]
  }



}