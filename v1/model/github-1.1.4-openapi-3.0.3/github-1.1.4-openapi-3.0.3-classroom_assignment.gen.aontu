            json: "{\"operationId\":\"classroom/get-an-assignment\",\"parameters\":[{\"description\":\"The unique identifier of the classroom assignment.\",\"in\":\"path\",\"name\":\"assignment_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"accepted\":100,\"classroom\":{\"archived\":\"false,\",\"id\":1296269,\"name\":\"Programming Elixir\",\"url\":\"https://classroom.github.com/classrooms/1-programming-elixir\"},\"deadline\":\"2011-01-26T19:06:43Z\",\"editor\":\"codespaces\",\"feedback_pull_requests_enabled\":true,\"id\":\"12,\",\"invitations_enabled\":\"true,\",\"invite_link\":\"https://classroom.github.com/a/Lx7jiUgx\",\"language\":\"ruby\",\"max_members\":0,\"max_teams\":0,\"passing\":10,\"public_repo\":\"false,\",\"slug\":\"intro-to-binaries\",\"stater_code_repository\":{\"default_branch\":\"main\",\"full_name\":\"octocat/Hello-World\",\"html_url\":\"https://github.com/octocat/Hello-World\",\"id\":1296269,\"node_id\":\"MDEwOlJlcG9zaXRvcnkxMjk2MjY5\",\"private\":false},\"students_are_repo_admins\":false,\"submitted\":40,\"title\":\"Intro to Binaries\",\"type\":\"individual\"}}},\"schema\":{\"description\":\"A GitHub Classroom assignment\",\"properties\":{\"accepted\":{\"description\":\"The number of students that have accepted the assignment.\",\"example\":25,\"type\":\"integer\"},\"classroom\":{\"description\":\"A GitHub Classroom classroom\",\"properties\":{\"archived\":{\"description\":\"Whether classroom is archived.\",\"example\":false,\"type\":\"boolean\"},\"id\":{\"description\":\"Unique identifier of the classroom.\",\"example\":42,\"type\":\"integer\"},\"name\":{\"description\":\"The name of the classroom.\",\"example\":\"Programming Elixir\",\"type\":\"string\"},\"organization\":{\"description\":\"A GitHub organization.\",\"properties\":{\"avatar_url\":{\"example\":\"https://github.com/images/error/octocat_happy.gif\",\"type\":\"string\"},\"html_url\":{\"example\":\"https://github.com/github\",\"format\":\"uri\",\"type\":\"string\"},\"id\":{\"example\":1,\"type\":\"integer\"},\"login\":{\"example\":\"github\",\"type\":\"string\"},\"name\":{\"example\":\"Github - Code thigns happen here\",\"nullable\":true,\"type\":\"string\"},\"node_id\":{\"example\":\"MDEyOk9yZ2FuaXphdGlvbjE=\",\"type\":\"string\"}},\"required\":[\"id\",\"login\",\"node_id\",\"html_url\",\"name\",\"avatar_url\"],\"title\":\"Organization Simple for Classroom\",\"type\":\"object\"},\"url\":{\"description\":\"The URL of the classroom on GitHub Classroom.\",\"example\":\"https://classroom.github.com/classrooms/1-programming-elixir\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"archived\",\"organization\",\"url\"],\"title\":\"Classroom\",\"type\":\"object\"},\"deadline\":{\"description\":\"The time at which the assignment is due.\",\"example\":\"2011-01-26T19:06:43Z\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"editor\":{\"description\":\"The selected editor for the assignment.\",\"example\":\"codespaces\",\"type\":\"string\"},\"feedback_pull_requests_enabled\":{\"description\":\"Whether feedback pull request will be created when a student accepts the assignment.\",\"example\":true,\"type\":\"boolean\"},\"id\":{\"description\":\"Unique identifier of the repository.\",\"example\":42,\"type\":\"integer\"},\"invitations_enabled\":{\"description\":\"Whether the invitation link is enabled. Visiting an enabled invitation link will accept the assignment.\",\"example\":true,\"type\":\"boolean\"},\"invite_link\":{\"description\":\"The link that a student can use to accept the assignment.\",\"example\":\"https://classroom.github.com/a/Lx7jiUgx\",\"type\":\"string\"},\"language\":{\"description\":\"The programming language used in the assignment.\",\"example\":\"elixir\",\"type\":\"string\"},\"max_members\":{\"description\":\"The maximum allowable members per team.\",\"example\":0,\"nullable\":true,\"type\":\"integer\"},\"max_teams\":{\"description\":\"The maximum allowable teams for the assignment.\",\"example\":0,\"nullable\":true,\"type\":\"integer\"},\"passing\":{\"description\":\"The number of students that have passed the assignment.\",\"example\":10,\"type\":\"integer\"},\"public_repo\":{\"description\":\"Whether an accepted assignment creates a public repository.\",\"example\":true,\"type\":\"boolean\"},\"slug\":{\"description\":\"Sluggified name of the assignment.\",\"example\":\"intro-to-binaries\",\"type\":\"string\"},\"starter_code_repository\":{\"description\":\"A GitHub repository view for Classroom\",\"properties\":{\"default_branch\":{\"description\":\"The default branch for the repository.\",\"example\":\"main\",\"type\":\"string\"},\"full_name\":{\"description\":\"The full, globally unique name of the repository.\",\"example\":\"octocat/Hello-World\",\"type\":\"string\"},\"html_url\":{\"description\":\"The URL to view the repository on GitHub.com.\",\"example\":\"https://github.com/octocat/Hello-World\",\"format\":\"uri\",\"type\":\"string\"},\"id\":{\"description\":\"A unique identifier of the repository.\",\"example\":1296269,\"type\":\"integer\"},\"node_id\":{\"description\":\"The GraphQL identifier of the repository.\",\"example\":\"MDEwOlJlcG9zaXRvcnkxMjk2MjY5\",\"type\":\"string\"},\"private\":{\"description\":\"Whether the repository is private.\",\"type\":\"boolean\"}},\"required\":[\"id\",\"full_name\",\"html_url\",\"node_id\",\"private\",\"default_branch\"],\"title\":\"Simple Classroom Repository\",\"type\":\"object\"},\"students_are_repo_admins\":{\"description\":\"Whether students are admins on created repository when a student accepts the assignment.\",\"example\":true,\"type\":\"boolean\"},\"submitted\":{\"description\":\"The number of students that have submitted the assignment.\",\"example\":10,\"type\":\"integer\"},\"title\":{\"description\":\"Assignment title.\",\"example\":\"Intro to Binaries\",\"type\":\"string\"},\"type\":{\"description\":\"Whether it's a group assignment or individual assignment.\",\"enum\":[\"individual\",\"group\"],\"example\":\"individual\",\"type\":\"string\"}},\"required\":[\"id\",\"public_repo\",\"title\",\"type\",\"invite_link\",\"invitations_enabled\",\"slug\",\"students_are_repo_admins\",\"feedback_pull_requests_enabled\",\"max_teams\",\"max_members\",\"editor\",\"accepted\",\"submitted\",\"passing\",\"language\",\"deadline\",\"starter_code_repository\",\"classroom\"],\"title\":\"Classroom Assignment\",\"type\":\"object\"}}},\"description\":\"Response\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Resource not found\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
