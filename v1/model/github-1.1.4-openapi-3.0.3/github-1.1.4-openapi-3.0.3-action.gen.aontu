# Entity: action

main: kit: entity: action: {

  alias: field: {}

  fields: {
    active_caches_count: {
      h: "Active Caches Count"
      n: "active_caches_count"
      r: true
      sh: "The number of active caches in the repository."
      t: "`$INTEGER`"
    }
    active_caches_size_in_bytes: {
      h: "Active Caches Size In Bytes"
      n: "active_caches_size_in_bytes"
      r: true
      sh: "The sum of the size in bytes of all the active cache items in the repository."
      t: "`$INTEGER`"
    }
    full_name: {
      h: "Full Name"
      n: "full_name"
      r: true
      sh: "The repository owner and name for the cache usage being shown."
      t: "`$STRING`"
    }
    included_minutes: {
      h: "Included Minutes"
      n: "included_minutes"
      r: true
      sh: "The amount of free GitHub Actions minutes available."
      t: "`$INTEGER`"
    }
    minutes_used_breakdown: {
      h: "Minutes Used Breakdown"
      n: "minutes_used_breakdown"
      r: true
      t: "`$OBJECT`"
    }
    total_minutes_used: {
      h: "Total Minutes Used"
      n: "total_minutes_used"
      r: true
      sh: "The sum of the free and paid GitHub Actions minutes used."
      t: "`$INTEGER`"
    }
    total_paid_minutes_used: {
      h: "Total Paid Minutes Used"
      n: "total_paid_minutes_used"
      r: true
      sh: "The total paid GitHub Actions minutes used."
      t: "`$INTEGER`"
    }
  }

