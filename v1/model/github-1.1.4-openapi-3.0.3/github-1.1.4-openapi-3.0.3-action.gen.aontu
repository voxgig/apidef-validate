            json: "{\"operationId\":\"actions/list-github-hosted-runners-in-group-for-org\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"Unique identifier of the self-hosted runner group.\",\"in\":\"path\",\"name\":\"runner_group_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"description\":\"The number of results per page (max 100). For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"per_page\",\"schema\":{\"default\":30,\"type\":\"integer\"}},{\"description\":\"The page number of the results to fetch. For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"page\",\"schema\":{\"default\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"runners\":[{\"id\":5,\"image\":{\"id\":\"ubuntu-20.04\",\"size\":86},\"last_active_on\":\"2022-10-09T23:39:01Z\",\"machine_size_details\":{\"cpu_cores\":4,\"id\":\"4-core\",\"memory_gb\":16,\"storage_gb\":150},\"maximum_runners\":10,\"name\":\"My hosted ubuntu runner\",\"platform\":\"linux-x64\",\"public_ip_enabled\":true,\"public_ips\":[{\"enabled\":true,\"length\":31,\"prefix\":\"20.80.208.150\"}],\"runner_group_id\":2,\"status\":\"Ready\"},{\"id\":7,\"image\":{\"id\":\"windows-latest\",\"size\":256},\"last_active_on\":\"2023-04-26T15:23:37Z\",\"machine_size_details\":{\"cpu_cores\":8,\"id\":\"8-core\",\"memory_gb\":32,\"storage_gb\":300},\"maximum_runners\":20,\"name\":\"My hosted Windows runner\",\"platform\":\"win-x64\",\"public_ip_enabled\":false,\"public_ips\":[],\"runner_group_id\":2,\"status\":\"Ready\"}],\"total_count\":2}}},\"schema\":{\"properties\":{\"runners\":{\"items\":{\"description\":\"A Github-hosted hosted runner.\",\"properties\":{\"id\":{\"description\":\"The unique identifier of the hosted runner.\",\"example\":5,\"type\":\"integer\"},\"image_details\":{\"description\":\"Provides details of a hosted runner image\",\"nullable\":true,\"properties\":{\"display_name\":{\"description\":\"Display name for this image.\",\"example\":20.04,\"type\":\"string\"},\"id\":{\"description\":\"The ID of the image. Use this ID for the `image` parameter when creating a new larger runner.\",\"example\":\"ubuntu-20.04\",\"type\":\"string\"},\"size_gb\":{\"description\":\"Image size in GB.\",\"example\":86,\"type\":\"integer\"},\"source\":{\"description\":\"The image provider.\",\"enum\":[\"github\",\"partner\",\"custom\"],\"type\":\"string\"}},\"required\":[\"id\",\"size_gb\",\"display_name\",\"source\"],\"title\":\"GitHub-hosted runner image details.\",\"type\":\"object\"},\"last_active_on\":{\"description\":\"The time at which the runner was last used, in ISO 8601 format.\",\"example\":\"2022-10-09T23:39:01Z\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"machine_size_details\":{\"description\":\"Provides details of a particular machine spec.\",\"properties\":{\"cpu_cores\":{\"description\":\"The number of cores.\",\"example\":8,\"type\":\"integer\"},\"id\":{\"description\":\"The ID used for the `size` parameter when creating a new runner.\",\"example\":\"8-core\",\"type\":\"string\"},\"memory_gb\":{\"description\":\"The available RAM for the machine spec.\",\"example\":32,\"type\":\"integer\"},\"storage_gb\":{\"description\":\"The available SSD storage for the machine spec.\",\"example\":300,\"type\":\"integer\"}},\"required\":[\"id\",\"cpu_cores\",\"memory_gb\",\"storage_gb\"],\"title\":\"Github-owned VM details.\",\"type\":\"object\"},\"maximum_runners\":{\"default\":10,\"description\":\"The maximum amount of hosted runners. Runners will not scale automatically above this number. Use this setting to limit your cost.\",\"example\":5,\"type\":\"integer\"},\"name\":{\"description\":\"The name of the hosted runner.\",\"example\":\"my-github-hosted-runner\",\"type\":\"string\"},\"platform\":{\"description\":\"The operating system of the image.\",\"example\":\"linux-x64\",\"type\":\"string\"},\"public_ip_enabled\":{\"description\":\"Whether public IP is enabled for the hosted runners.\",\"example\":true,\"type\":\"boolean\"},\"public_ips\":{\"description\":\"The public IP ranges when public IP is enabled for the hosted runners.\",\"items\":{\"description\":\"Provides details of Public IP for a GitHub-hosted larger runners\",\"properties\":{\"enabled\":{\"description\":\"Whether public IP is enabled.\",\"example\":true,\"type\":\"boolean\"},\"length\":{\"description\":\"The length of the IP prefix.\",\"example\":28,\"type\":\"integer\"},\"prefix\":{\"description\":\"The prefix for the public IP.\",\"example\":\"20.80.208.150\",\"type\":\"string\"}},\"title\":\"Public IP for a GitHub-hosted larger runners.\",\"type\":\"object\"},\"type\":\"array\"},\"runner_group_id\":{\"description\":\"The unique identifier of the group that the hosted runner belongs to.\",\"example\":2,\"type\":\"integer\"},\"status\":{\"description\":\"The status of the runner.\",\"enum\":[\"Ready\",\"Provisioning\",\"Shutdown\",\"Deleting\",\"Stuck\"],\"example\":\"Ready\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"image_details\",\"machine_size_details\",\"status\",\"public_ip_enabled\",\"platform\"],\"title\":\"GitHub-hosted hosted runner\",\"type\":\"object\"},\"type\":\"array\"},\"total_count\":{\"type\":\"number\"}},\"required\":[\"total_count\",\"runners\"],\"type\":\"object\"}}},\"description\":\"Response\",\"headers\":{\"Link\":{\"example\":\"<https://api.github.com/resource?page=2>; rel=\\\"next\\\", <https://api.github.com/resource?page=5>; rel=\\\"last\\\"\",\"schema\":{\"type\":\"string\"}}}}},\"securitySource\":\"unspecified\"}"
