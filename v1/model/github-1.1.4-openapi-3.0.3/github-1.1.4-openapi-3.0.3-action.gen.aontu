# Entity: action

main: kit: entity: action: {

  alias: field: {}

  fields: {
    MACOS: {
      h: "Macos"
      n: "MACOS"
      r: false
      sh: "Total minutes used on macOS runner machines."
      t: "`$INTEGER`"
    }
    UBUNTU: {
      h: "Ubuntu"
      n: "UBUNTU"
