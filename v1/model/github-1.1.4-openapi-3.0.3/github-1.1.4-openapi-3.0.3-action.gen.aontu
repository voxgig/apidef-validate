  name: "action"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /repos/{owner}/{repo}/actions/runners/{runner_id}/labels"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
