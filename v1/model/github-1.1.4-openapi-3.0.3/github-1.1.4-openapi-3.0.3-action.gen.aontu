            json: "{\"operationId\":\"actions/generate-runner-jitconfig-for-org\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"labels\":[\"self-hosted\",\"X64\",\"macOS\",\"no-gpu\"],\"name\":\"New runner\",\"runner_group_id\":1,\"work_folder\":\"_work\"}}},\"schema\":{\"properties\":{\"labels\":{\"description\":\"The names of the custom labels to add to the runner. **Minimum items**: 1. **Maximum items**: 100.\",\"items\":{\"type\":\"string\"},\"maxItems\":100,\"minItems\":1,\"type\":\"array\"},\"name\":{\"description\":\"The name of the new runner.\",\"type\":\"string\"},\"runner_group_id\":{\"description\":\"The ID of the runner group to register the runner to.\",\"type\":\"integer\"},\"work_folder\":{\"default\":\"_work\",\"description\":\"The working directory to be used for job execution, relative to the runner install directory.\",\"type\":\"string\"}},\"required\":[\"name\",\"runner_group_id\",\"labels\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"encoded_jit_config\":\"abc123\",\"runner\":{\"busy\":false,\"id\":23,\"labels\":[{\"id\":5,\"name\":\"self-hosted\",\"type\":\"read-only\"},{\"id\":7,\"name\":\"X64\",\"type\":\"read-only\"},{\"id\":20,\"name\":\"macOS\",\"type\":\"read-only\"},{\"id\":21,\"name\":\"no-gpu\",\"type\":\"custom\"}],\"name\":\"New runner\",\"os\":\"unknown\",\"status\":\"offline\"}}}},\"schema\":{\"properties\":{\"encoded_jit_config\":{\"description\":\"The base64 encoded runner configuration.\",\"type\":\"string\"},\"runner\":{\"description\":\"A self hosted runner\",\"properties\":{\"busy\":{\"type\":\"boolean\"},\"ephemeral\":{\"type\":\"boolean\"},\"id\":{\"description\":\"The ID of the runner.\",\"example\":5,\"type\":\"integer\"},\"labels\":{\"items\":{\"description\":\"A label for a self hosted runner\",\"properties\":{\"id\":{\"description\":\"Unique identifier of the label.\",\"type\":\"integer\"},\"name\":{\"description\":\"Name of the label.\",\"type\":\"string\"},\"type\":{\"description\":\"The type of label. Read-only labels are applied automatically when the runner is configured.\",\"enum\":[\"read-only\",\"custom\"],\"type\":\"string\"}},\"required\":[\"name\"],\"title\":\"Self hosted runner label\",\"type\":\"object\"},\"type\":\"array\"},\"name\":{\"description\":\"The name of the runner.\",\"example\":\"iMac\",\"type\":\"string\"},\"os\":{\"description\":\"The Operating System of the runner.\",\"example\":\"macos\",\"type\":\"string\"},\"runner_group_id\":{\"description\":\"The ID of the runner group.\",\"example\":1,\"type\":\"integer\"},\"status\":{\"description\":\"The status of the runner.\",\"example\":\"online\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"os\",\"status\",\"busy\",\"labels\"],\"title\":\"Self hosted runners\",\"type\":\"object\"}},\"required\":[\"runner\",\"encoded_jit_config\"],\"type\":\"object\"}}},\"description\":\"Response\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Resource not found\"},\"409\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Conflict\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Validation Error Simple\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"errors\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"message\":{\"type\":\"string\"}},\"required\":[\"message\",\"documentation_url\"],\"title\":\"Validation Error Simple\",\"type\":\"object\"}}},\"description\":\"Validation failed, or the endpoint has been spammed.\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/orgs/{org}/actions/runners/generate-jitconfig"
          rename: {
