# Entity: commit

main: kit: entity: commit: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: true
      type: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    {
      name: "base"
      req: true
      short: "The name of the base branch that the head will be merged into."
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "comments_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "commit"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "commit_message"
      req: false
      short: "Commit message to use for the merge commit."
      type: "`$STRING`"
    }
    {
      name: "committer"
      req: true
      type: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    {
      name: "files"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "head"
      req: true
      short: "The head to merge."
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "parents"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "sha"
      req: true
      type: "`$STRING`"
    }
    {
      name: "stats"
      req: false
      type: "`$OBJECT`"
    }
    {
      format: "uri"
      name: "url"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
