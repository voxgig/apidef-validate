# Entity: commit

main: kit: entity: commit: {

  alias: field: {}

  fields: {
    author: {
      h: "Author"
      n: "author"
      r: true
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    base: {
      h: "Base"
      n: "base"
      r: true
      sh: "The name of the base branch that the head will be merged into."
      t: "`$STRING`"
    }
    comments_url: {
      fo: "uri"
      h: "Comments Url"
      n: "comments_url"
      r: true
      t: "`$STRING`"
    }
    commit: {
      h: "Commit"
      n: "commit"
      r: true
      t: "`$OBJECT`"
    }
    commit_message: {
      h: "Commit Message"
      n: "commit_message"
      r: false
      sh: "Commit message to use for the merge commit."
      t: "`$STRING`"
    }
    committer: {
      h: "Committer"
      n: "committer"
      r: true
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    files: {
      h: "Files"
      n: "files"
      r: false
      t: "`$ARRAY`"
    }
    head: {
      h: "Head"
      n: "head"
      r: true
      sh: "The head to merge."
      t: "`$STRING`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    node_id: {
      h: "Node Id"
      n: "node_id"
      r: true
      t: "`$STRING`"
    }
    parents: {
      h: "Parents"
      n: "parents"
      r: true
      t: "`$ARRAY`"
    }
    sha: {
      h: "Sha"
      n: "sha"
      r: true
      t: "`$STRING`"
    }
    stats: {
      h: "Stats"
      n: "stats"
      r: false
      t: "`$OBJECT`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /repos/{owner}/{repo}/merges"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/repos/{owner}/{repo}/merges"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "merges"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.commit`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/commits"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "author"
                or: "author"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "committer"
                or: "committer"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "path"
                or: "path"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "sha"
                or: "sha"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "since"
                or: "since"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "until"
                or: "until"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/commits"
          q: {
            exist: [
              "author"
              "committer"
              "owner"
              "page"
              "path"
              "per_page"
              "repo"
              "sha"
              "since"
              "until"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "commits"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /repos/{owner}/{repo}/pulls/{pull_number}/commits"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "pull_number"
                or: "pull_number"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/pulls/{pull_number}/commits"
          q: {
            exist: [
              "owner"
              "page"
              "per_page"
              "pull_number"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "pulls"
            }
            {
              var: "pull_number"
            }
            {
              lit: "commits"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/commits/{ref}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "ref"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/commits/{ref}"
          q: {
            exist: [
              "id"
              "owner"
              "page"
              "per_page"
              "repo"
            ]
          }
          r: {
            param: {
              ref: "id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "commits"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.commit`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
      [
        "repo"
        "pull"
      ]
    ]
  }



}