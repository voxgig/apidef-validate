# Entity: repository

main: kit: entity: repository: {

  alias: field: {}

  fields: {
    allow_auto_merge: {
      h: "Allow Auto Merge"
      n: "allow_auto_merge"
      r: false
      sh: "Whether to allow Auto-merge to be used on pull requests."
      t: "`$BOOLEAN`"
    }
    allow_forking: {
      h: "Allow Forking"
      n: "allow_forking"
      r: false
      sh: "Whether to allow forking this repo"
      t: "`$BOOLEAN`"
    }
    allow_merge_commit: {
      h: "Allow Merge Commit"
      n: "allow_merge_commit"
      r: false
      sh: "Whether to allow merge commits for pull requests."
      t: "`$BOOLEAN`"
    }
    allow_rebase_merge: {
      h: "Allow Rebase Merge"
      n: "allow_rebase_merge"
      r: false
      sh: "Whether to allow rebase merges for pull requests."
      t: "`$BOOLEAN`"
    }
    allow_squash_merge: {
      h: "Allow Squash Merge"
      n: "allow_squash_merge"
      r: false
      sh: "Whether to allow squash merges for pull requests."
      t: "`$BOOLEAN`"
    }
    allow_update_branch: {
      h: "Allow Update Branch"
      n: "allow_update_branch"
      r: false
      sh: "Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging."
      t: "`$BOOLEAN`"
    }
    anonymous_access_enabled: {
      h: "Anonymous Access Enabled"
      n: "anonymous_access_enabled"
      r: false
      sh: "Whether anonymous git access is enabled for this repository"
      t: "`$BOOLEAN`"
    }
