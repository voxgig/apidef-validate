  name: "repository"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /enterprises/{enterprise}/code-security/configurations/{configuration_id}/repositories"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "configuration_id"
                or: "configuration_id"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "enterprise_id"
                or: "enterprise"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                explode: true
                k: "query"
                n: "after"
                or: "after"
                r: false
                style: "form"
                t: "`$STRING`"
              }
              {
                explode: true
                k: "query"
                n: "before"
                or: "before"
                r: false
                style: "form"
                t: "`$STRING`"
              }
              {
                ex: 30
                explode: true
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                style: "form"
                t: "`$INTEGER`"
              }
              {
                ex: "all"
                explode: true
                k: "query"
                n: "status"
                or: "status"
                r: false
                style: "form"
                t: "`$STRING`"
              }
            ]
