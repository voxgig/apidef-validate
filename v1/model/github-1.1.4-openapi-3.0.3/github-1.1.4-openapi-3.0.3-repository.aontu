  id: {
    field: "id"
    name: "id"
  }

  name: "repository"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /user/starred"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "desc"
                k: "query"
                n: "direction"
                or: "direction"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "created"
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/user/starred"
          q: {
            exist: [
              "direction"
              "page"
              "per_page"
              "sort"
            ]
          }
          s: [
            {
              lit: "user"
            }
            {
              lit: "starred"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}