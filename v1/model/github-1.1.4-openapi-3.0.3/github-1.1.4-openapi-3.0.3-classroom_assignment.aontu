# Entity: classroom_assignment

main: kit: entity: classroom_assignment: {

  alias: field: {}

  fields: [
    {
      name: "accepted"
      req: true
      short: "The number of students that have accepted the assignment."
      type: "`$INTEGER`"
    }
    {
      name: "classroom"
      req: true
      short: "A GitHub Classroom classroom"
      type: "`$OBJECT`"
    }
    {
      name: "deadline"
      req: true
      short: "The time at which the assignment is due."
      type: "`$STRING`"
    }
    {
      name: "editor"
      req: true
      short: "The selected editor for the assignment."
      type: "`$STRING`"
    }
    {
      name: "feedback_pull_requests_enabled"
      req: true
      short: "Whether feedback pull request will be created when a student accepts the assignment."
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: true
      short: "Unique identifier of the repository."
      type: "`$INTEGER`"
    }
    {
      name: "invitations_enabled"
      req: true
      short: "Whether the invitation link is enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "invite_link"
      req: true
      short: "The link that a student can use to accept the assignment."
      type: "`$STRING`"
    }
    {
      name: "language"
      req: true
      short: "The programming language used in the assignment."
      type: "`$STRING`"
    }
    {
      name: "max_members"
      req: true
      short: "The maximum allowable members per team."
      type: "`$INTEGER`"
    }
    {
      name: "max_teams"
      req: true
      short: "The maximum allowable teams for the assignment."
      type: "`$INTEGER`"
    }
    {
      name: "passing"
      req: true
      short: "The number of students that have passed the assignment."
      type: "`$INTEGER`"
    }
    {
      name: "public_repo"
      req: true
      short: "Whether an accepted assignment creates a public repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "slug"
      req: true
      short: "Sluggified name of the assignment."
      type: "`$STRING`"
    }
    {
      name: "starter_code_repository"
      req: true
      short: "A GitHub repository view for Classroom"
      type: "`$OBJECT`"
    }
    {
      name: "students_are_repo_admins"
      req: true
      short: "Whether students are admins on created repository when a student accepts the assignment."
      type: "`$BOOLEAN`"
    }
    {
      name: "submitted"
      req: true
      short: "The number of students that have submitted the assignment."
      type: "`$INTEGER`"
    }
    {
      name: "title"
      req: true
      short: "Assignment title."
      type: "`$STRING`"
    }
    {
      name: "type"
      req: true
      short: "Whether it's a group assignment or individual assignment."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "classroom_assignment"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "assignment_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/assignments/{assignment_id}"
          rename: {
            param: {
              assignment_id: "id"
            }
          }
          segments: [
            {
              lit: "assignments"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}