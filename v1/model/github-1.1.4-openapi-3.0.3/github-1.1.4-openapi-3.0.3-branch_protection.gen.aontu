# Entity: branch_protection

main: kit: entity: branch_protection: {

  alias: field: {}

  fields: {
    allow_deletions: {
      h: "Allow Deletions"
      n: "allow_deletions"
      r: false
      t: "`$OBJECT`"
    }
    allow_force_pushes: {
      h: "Allow Force Pushes"
      n: "allow_force_pushes"
      r: false
      t: "`$OBJECT`"
    }
    allow_fork_syncing: {
      h: "Allow Fork Syncing"
      n: "allow_fork_syncing"
      r: false
      sh: "Whether users can pull changes from upstream when the branch is locked."
      t: "`$OBJECT`"
    }
    block_creations: {
      h: "Block Creations"
      n: "block_creations"
      r: false
      t: "`$OBJECT`"
    }
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: false
      t: "`$BOOLEAN`"
    }
    enforce_admins: {
      h: "Enforce Admins"
      n: "enforce_admins"
      r: true
      sh: "Protected Branch Admin Enforced"
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    lock_branch: {
      h: "Lock Branch"
      n: "lock_branch"
      r: false
      sh: "Whether to set the branch as read-only."
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      t: "`$STRING`"
    }
    protection_url: {
      h: "Protection Url"
      n: "protection_url"
      r: false
      t: "`$STRING`"
    }
    required_conversation_resolution: {
      h: "Required Conversation Resolution"
      n: "required_conversation_resolution"
      r: false
      t: "`$OBJECT`"
    }
    required_linear_history: {
      h: "Required Linear History"
      n: "required_linear_history"
      r: false
      t: "`$OBJECT`"
    }
    required_pull_request_reviews: {
      h: "Required Pull Request Reviews"
      n: "required_pull_request_reviews"
      r: true
      sh: "Protected Branch Pull Request Review"
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 2
        depth: 7
      }
    }
    required_signatures: {
      h: "Required Signatures"
      n: "required_signatures"
      r: true
      t: "`$OBJECT`"
    }
    required_status_checks: {
      h: "Required Status Checks"
      n: "required_status_checks"
      r: true
      sh: "Protected Branch Required Status Check"
      t: "`$OBJECT`"
    }
    restrictions: {
      h: "Restrictions"
      n: "restrictions"
      r: true
      sh: "Branch Restriction Policy"
      t: "`$OBJECT`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "branch_protection"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/branches/{branch}/protection"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "branch"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/branches/{branch}/protection"
          q: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          r: {
            param: {
              branch: "id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "branches"
            }
            {
              var: "id"
            }
            {
              lit: "protection"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.repo")]
  ]

}