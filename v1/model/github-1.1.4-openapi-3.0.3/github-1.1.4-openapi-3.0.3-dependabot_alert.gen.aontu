            source: "openapi3"
            version: 1
          }
          method: "PATCH"
          orig: "/repos/{owner}/{repo}/dependabot/alerts/{alert_number}"
          rename: {
            param: {
              alert_number: "id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "dependabot"
            }
            {
              lit: "alerts"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              dismissed_comment: "`reqdata.dismissed_comment`"
              dismissed_reason: "`reqdata.dismissed_reason`"
              state: "`reqdata.state`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}