# Entity: actions_fork_pr_workflows_private_repo

main: kit: entity: actions_fork_pr_workflows_private_repo: {

  alias: field: {}

  fields: [
    {
      name: "require_approval_for_fork_pr_workflows"
      req: true
      short: "Whether workflows triggered by pull requests from forks require approval from a repository administrator to run."
      type: "`$BOOLEAN`"
    }
    {
      name: "run_workflows_from_fork_pull_requests"
      req: true
      short: "Whether workflows triggered by pull requests from forks are allowed to run on private repositories."
      type: "`$BOOLEAN`"
    }
    {
      name: "send_secrets_and_variables"
      req: true
      short: "Whether to make secrets and variables available to workflows triggered by pull requests from forks."
      type: "`$BOOLEAN`"
    }
    {
      name: "send_write_tokens_to_workflows"
      req: true
      short: "Whether GitHub Actions can create pull requests or submit approving pull request reviews from a workflow triggered by a fork pull request."
      type: "`$BOOLEAN`"
    }
  ]

  name: "actions_fork_pr_workflows_private_repo"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/actions/permissions/fork-pr-workflows-private-repos"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "actions"
            "permissions"
            "fork-pr-workflows-private-repos"
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/orgs/{org}/actions/permissions/fork-pr-workflows-private-repos"
          parts: [
            "orgs"
            "{org_id}"
            "actions"
            "permissions"
            "fork-pr-workflows-private-repos"
          ]
          rename: {
            param: {
              org: "org_id"
            }
          }
          select: {
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
      [
        "repo"
      ]
    ]
  }



}