# Entity: self_hosted_runner

main: kit: entity: self_hosted_runner: {

  alias: field: {}

  fields: {
    enabled_repositories: {
      h: "Enabled Repositories"
      n: "enabled_repositories"
      r: true
      sh: "The policy that controls whether self-hosted runners can be used by repositories in the organization"
      t: "`$STRING`"
    }
    selected_repositories_url: {
      h: "Selected Repositories Url"
      n: "selected_repositories_url"
      r: false
      sh: "The URL to the endpoint for managing selected repositories for self-hosted runners in the organization"
      t: "`$STRING`"
    }
  }

  name: "self_hosted_runner"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /orgs/{org}/actions/permissions/self-hosted-runners"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/orgs/{org}/actions/permissions/self-hosted-runners"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
            {
              lit: "self-hosted-runners"
            }
          ]
          select: {
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
    ]
  }



}