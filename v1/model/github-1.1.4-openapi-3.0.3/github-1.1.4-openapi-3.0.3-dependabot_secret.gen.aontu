          }
          contract: {
            id: "GET /repos/{owner}/{repo}/dependabot/secrets/{secret_name}"
            json: "{\"operationId\":\"dependabot/get-repo-secret\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the secret.\",\"in\":\"path\",\"name\":\"secret_name\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"created_at\":\"2019-08-10T14:59:22Z\",\"name\":\"MY_ARTIFACTORY_PASSWORD\",\"updated_at\":\"2020-01-10T14:59:22Z\"}}},\"schema\":{\"description\":\"Set secrets for Dependabot.\",\"properties\":{\"created_at\":{\"format\":\"date-time\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the secret.\",\"example\":\"MY_ARTIFACTORY_PASSWORD\",\"type\":\"string\"},\"updated_at\":{\"format\":\"date-time\",\"type\":\"string\"}},\"required\":[\"name\",\"created_at\",\"updated_at\"],\"title\":\"Dependabot Secret\",\"type\":\"object\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/dependabot/secrets/{secret_name}"
          rename: {
            param: {
              secret_name: "id"
            }
          }
          segments: [
