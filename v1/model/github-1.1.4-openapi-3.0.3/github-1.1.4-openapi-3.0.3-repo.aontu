            id: "POST /repos/{owner}/{repo}/hooks/{hook_id}/deliveries/{delivery_id}/attempts"
            json: "{\"operationId\":\"repos/redeliver-webhook-delivery\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The unique identifier of the hook. You can find this value in the `X-GitHub-Hook-ID` header of a webhook delivery.\",\"in\":\"path\",\"name\":\"hook_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"in\":\"path\",\"name\":\"delivery_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"202\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":null}},\"schema\":{\"type\":\"object\"}}},\"description\":\"Accepted\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}},\"application/scim+json\":{\"schema\":{\"description\":\"Scim Error\",\"properties\":{\"detail\":{\"nullable\":true,\"type\":\"string\"},\"documentation_url\":{\"nullable\":true,\"type\":\"string\"},\"message\":{\"nullable\":true,\"type\":\"string\"},\"schemas\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"scimType\":{\"nullable\":true,\"type\":\"string\"},\"status\":{\"type\":\"integer\"}},\"title\":\"Scim Error\",\"type\":\"object\"}}},\"description\":\"Bad Request\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Validation Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"errors\":{\"items\":{\"properties\":{\"code\":{\"type\":\"string\"},\"field\":{\"type\":\"string\"},\"index\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"},\"resource\":{\"type\":\"string\"},\"value\":{\"oneOf\":[{\"nullable\":true,\"type\":\"string\"},{\"nullable\":true,\"type\":\"integer\"},{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}]}},\"required\":[\"code\"],\"type\":\"object\"},\"type\":\"array\"},\"message\":{\"type\":\"string\"}},\"required\":[\"message\",\"documentation_url\"],\"title\":\"Validation Error\",\"type\":\"object\"}}},\"description\":\"Validation failed, or the endpoint has been spammed.\"}},\"securitySource\":\"unspecified\"}"
