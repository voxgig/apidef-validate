  id: {
    field: "id"
    name: "id"
  }

  name: "repo"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "client_payload"
            "event_type"
          ]
          co: {
            id: "POST /repos/{owner}/{repo}/dispatches"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
