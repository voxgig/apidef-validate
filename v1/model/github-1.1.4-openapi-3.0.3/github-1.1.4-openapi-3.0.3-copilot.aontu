# Entity: copilot

main: kit: entity: copilot: {

  alias: field: {}

  fields: {
    assignee: {
      h: "Assignee"
      n: "assignee"
      r: true
      sh: "A GitHub user."
      t: "`$OBJECT`"
    }
    assigning_team: {
      h: "Assigning Team"
      n: "assigning_team"
      r: false
      sh: "The team through which the assignee is granted access to GitHub Copilot, if applicable."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "Timestamp of when the assignee was last granted access to GitHub Copilot, in ISO 8601 format."
      t: "`$STRING`"
    }
    last_activity_at: {
      fo: "date-time"
      h: "Last Activity At"
      n: "last_activity_at"
      r: false
      sh: "Timestamp of user's last GitHub Copilot activity, in ISO 8601 format."
      t: "`$STRING`"
    }
    last_activity_editor: {
      h: "Last Activity Editor"
      n: "last_activity_editor"
      r: false
      sh: "Last editor that was used by the user for a GitHub Copilot completion."
      t: "`$STRING`"
    }
    last_authenticated_at: {
      fo: "date-time"
      h: "Last Authenticated At"
      n: "last_authenticated_at"
      r: false
      sh: "Timestamp of the last time the user authenticated with GitHub Copilot, in ISO 8601 format."
      t: "`$STRING`"
    }
    organization: {
      h: "Organization"
      n: "organization"
      r: true
      sh: "A GitHub organization."
      t: "`$OBJECT`"
    }
    pending_cancellation_date: {
      fo: "date"
      h: "Pending Cancellation Date"
      n: "pending_cancellation_date"
      r: false
      sh: "The pending cancellation date for the seat, in `YYYY-MM-DD` format."
      t: "`$STRING`"
    }
    plan_type: {
      h: "Plan Type"
      n: "plan_type"
      r: false
      sh: "The Copilot plan of the organization, or the parent enterprise, when applicable."
      t: "`$STRING`"
    }
    selected_teams: {
      h: "Selected Teams"
      n: "selected_teams"
      r: true
      sh: "List of team names within the organization to which to grant access to GitHub Copilot."
      t: "`$ARRAY`"
    }
    selected_usernames: {
      h: "Selected Usernames"
      n: "selected_usernames"
      r: true
      sh: "The usernames of the organization members to be granted access to GitHub Copilot."
      t: "`$ARRAY`"
    }
    updated_at: {
      de: true
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "**Closing down notice:** This field is no longer relevant and is closing down."
      t: "`$STRING`"
    }
  }

  name: "copilot"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /orgs/{org}/copilot/billing/selected_teams"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/orgs/{org}/copilot/billing/selected_teams"
          q: {
            exist: [
              "org_id"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "copilot"
            }
            {
              lit: "billing"
            }
            {
              lit: "selected_teams"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /orgs/{org}/copilot/billing/selected_users"
            source: "openapi3"
            version: 2
          }
