# Entity: copilot

main: kit: entity: copilot: {

  alias: field: {}

  fields: [
    {
      name: "assignee"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      name: "assigning_team"
      req: false
      short: "The team through which the assignee is granted access to GitHub Copilot, if applicable."
      type: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    {
      name: "created_at"
      req: true
      short: "Timestamp of when the assignee was last granted access to GitHub Copilot, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "last_activity_at"
      req: false
      short: "Timestamp of user's last GitHub Copilot activity, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "last_activity_editor"
      req: false
      short: "Last editor that was used by the user for a GitHub Copilot completion."
      type: "`$STRING`"
    }
    {
      name: "last_authenticated_at"
      req: false
      short: "Timestamp of the last time the user authenticated with GitHub Copilot, in ISO 8601 format."
