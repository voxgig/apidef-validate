    }
    {
      name: "organization"
      req: true
      short: "A GitHub organization."
      type: "`$OBJECT`"
    }
    {
      name: "pending_cancellation_date"
      req: false
      short: "The pending cancellation date for the seat, in `YYYY-MM-DD` format."
      type: "`$STRING`"
    }
    {
      name: "plan_type"
      req: false
      short: "The Copilot plan of the organization, or the parent enterprise, when applicable."
      type: "`$STRING`"
    }
    {
      name: "selected_teams"
      req: true
      short: "List of team names within the organization to which to grant access to GitHub Copilot."
      type: "`$ARRAY`"
    }
    {
      name: "selected_usernames"
      req: true
      short: "The usernames of the organization members to be granted access to GitHub Copilot."
      type: "`$ARRAY`"
    }
    {
      name: "updated_at"
      req: false
      short: "**Closing down notice:** This field is no longer relevant and is closing down."
      type: "`$STRING`"
    }
  ]

