# Entity: global_advisory

main: kit: entity: global_advisory: {

  alias: field: {}

  fields: [
    {
      name: "credits"
      req: true
      short: "The users who contributed to the advisory."
      type: "`$ARRAY`"
    }
    {
      name: "cve_id"
      req: true
      short: "The Common Vulnerabilities and Exposures (CVE) ID."
      type: "`$STRING`"
    }
    {
      name: "cvss"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "cvss_severities"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "cwes"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "description"
      req: true
      short: "A detailed description of what the advisory entails."
      type: "`$STRING`"
    }
    {
      name: "epss"
      req: false
      short: "The EPSS scores as calculated by the [Exploit Prediction Scoring System](https://www.first.org/epss)."
      type: "`$OBJECT`"
    }
    {
      name: "ghsa_id"
      req: true
      short: "The GitHub Security Advisory ID."
      type: "`$STRING`"
    }
    {
      name: "github_reviewed_at"
      req: true
      short: "The date and time of when the advisory was reviewed by GitHub, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "html_url"
      req: true
      short: "The URL for the advisory."
      type: "`$STRING`"
    }
    {
      name: "identifiers"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "nvd_published_at"
      req: true
      short: "The date and time when the advisory was published in the National Vulnerability Database, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "published_at"
      req: true
      short: "The date and time of when the advisory was published, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "references"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "repository_advisory_url"
      req: true
      short: "The API URL for the repository advisory."
      type: "`$STRING`"
    }
    {
      name: "severity"
      req: true
      short: "The severity of the advisory."
      type: "`$STRING`"
    }
    {
      name: "source_code_location"
      req: true
      short: "The URL of the advisory's source code."
      type: "`$STRING`"
    }
    {
      name: "summary"
      req: true
      short: "A short summary of the advisory."
      type: "`$STRING`"
    }
    {
      name: "type"
      req: true
      short: "The type of advisory."
      type: "`$STRING`"
    }
    {
      name: "updated_at"
      req: true
      short: "The date and time of when the advisory was last updated, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "The API URL for the advisory."
      type: "`$STRING`"
    }
    {
      name: "vulnerabilities"
      req: true
      short: "The products and respective version ranges affected by the advisory."
      type: "`$ARRAY`"
    }
    {
      name: "withdrawn_at"
      req: true
      short: "The date and time of when the advisory was withdrawn, in ISO 8601 format."
      type: "`$STRING`"
    }
  ]

  name: "global_advisory"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "affect"
                orig: "affect"
                reqd: false
                type: "`$ANY`"
              }
              {
                kind: "query"
                name: "after"
                orig: "after"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "before"
                orig: "before"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "cve_id"
                orig: "cve_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "cwe"
                orig: "cwe"
                reqd: false
                type: "`$ANY`"
              }
              {
                example: "desc"
                kind: "query"
                name: "direction"
                orig: "direction"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "ecosystem"
                orig: "ecosystem"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "epss_percentage"
                orig: "epss_percentage"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "epss_percentile"
                orig: "epss_percentile"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "ghsa_id"
                orig: "ghsa_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "is_withdrawn"
                orig: "is_withdrawn"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                kind: "query"
                name: "modified"
                orig: "modified"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "published"
                orig: "published"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "severity"
                orig: "severity"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "published"
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "reviewed"
                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "updated"
                orig: "updated"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/advisories"
          parts: [
            "advisories"
          ]
          select: {
            exist: [
              "affect"
              "after"
              "before"
              "cve_id"
              "cwe"
              "direction"
              "ecosystem"
              "epss_percentage"
              "epss_percentile"
              "ghsa_id"
              "is_withdrawn"
              "modified"
              "per_page"
              "published"
              "severity"
              "sort"
              "type"
              "updated"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "ghsa_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/advisories/{ghsa_id}"
          parts: [
            "advisories"
            "{id}"
          ]
          rename: {
            param: {
              ghsa_id: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}