# Entity: copilot_organization_detail

main: kit: entity: copilot_organization_detail: {

  alias: field: {}

  fields: {
    active_this_cycle: {
      h: "Active This Cycle"
      n: "active_this_cycle"
      r: false
      sh: "The number of seats that have used Copilot during the current billing cycle."
      t: "`$INTEGER`"
    }
    added_this_cycle: {
      h: "Added This Cycle"
      n: "added_this_cycle"
      r: false
      sh: "Seats added during the current billing cycle."
      t: "`$INTEGER`"
    }
    inactive_this_cycle: {
      h: "Inactive This Cycle"
      n: "inactive_this_cycle"
      r: false
      sh: "The number of seats that have not used Copilot during the current billing cycle."
      t: "`$INTEGER`"
    }
    pending_cancellation: {
      h: "Pending Cancellation"
      n: "pending_cancellation"
      r: false
      sh: "The number of seats that are pending cancellation at the end of the current billing cycle."
      t: "`$INTEGER`"
    }
    pending_invitation: {
      h: "Pending Invitation"
      n: "pending_invitation"
      r: false
      sh: "The number of users who have been invited to receive a Copilot seat through this organization."
      t: "`$INTEGER`"
    }
    total: {
      h: "Total"
      n: "total"
      r: false
      sh: "The total number of seats being billed for the organization as of the current billing cycle."
      t: "`$INTEGER`"
    }
  }

  name: "copilot_organization_detail"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /orgs/{org}/copilot/billing"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/copilot/billing"
          q: {
            exist: [
              "org_id"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "copilot"
            }
            {
              lit: "billing"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.seat_breakdown`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.org")]
  ]

}