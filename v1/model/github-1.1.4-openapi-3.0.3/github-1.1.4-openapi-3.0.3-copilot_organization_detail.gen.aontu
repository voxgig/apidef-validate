# Entity: copilot_organization_detail

main: kit: entity: copilot_organization_detail: {

  alias: field: {}

  fields: {
    cli: {
      h: "Cli"
      n: "cli"
      r: false
      sh: "The organization policy for allowing or disallowing Copilot in the CLI."
      t: "`$STRING`"
    }
    ide_chat: {
      h: "Ide Chat"
      n: "ide_chat"
      r: false
      sh: "The organization policy for allowing or disallowing Copilot Chat in the IDE."
      t: "`$STRING`"
    }
    plan_type: {
      h: "Plan Type"
      n: "plan_type"
      r: false
      sh: "The Copilot plan of the organization, or the parent enterprise, when applicable."
      t: "`$STRING`"
    }
    platform_chat: {
      h: "Platform Chat"
      n: "platform_chat"
      r: false
      sh: "The organization policy for allowing or disallowing Copilot features on GitHub.com."
      t: "`$STRING`"
    }
    public_code_suggestions: {
      h: "Public Code Suggestions"
      n: "public_code_suggestions"
      r: true
      sh: "The organization policy for allowing or blocking suggestions matching public code (duplication detection filter)."
      t: "`$STRING`"
    }
    seat_breakdown: {
      h: "Seat Breakdown"
      n: "seat_breakdown"
      r: true
      sh: "The breakdown of Copilot Business seats for the organization."
      t: "`$OBJECT`"
    }
    seat_management_setting: {
      h: "Seat Management Setting"
      n: "seat_management_setting"
      r: true
      sh: "The mode of assigning new seats."
      t: "`$STRING`"
    }
  }

  name: "copilot_organization_detail"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /orgs/{org}/copilot/billing"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/copilot/billing"
          q: {
            exist: [
              "org_id"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "copilot"
            }
            {
              lit: "billing"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.org")]
  ]

}