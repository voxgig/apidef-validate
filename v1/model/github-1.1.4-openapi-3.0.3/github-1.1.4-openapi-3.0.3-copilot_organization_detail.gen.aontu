# Entity: copilot_organization_detail

main: kit: entity: copilot_organization_detail: {

  alias: field: {}

  fields: [
    {
      name: "active_this_cycle"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "added_this_cycle"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "inactive_this_cycle"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "pending_cancellation"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "pending_invitation"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "total"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "copilot_organization_detail"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/orgs/{org}/copilot/billing"
          parts: [
            "orgs"
            "{org_id}"
            "copilot"
            "billing"
          ]
          rename: {
            param: {
              org: "org_id"
            }
          }
          select: {
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.seat_breakdown`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
    ]
  }



}