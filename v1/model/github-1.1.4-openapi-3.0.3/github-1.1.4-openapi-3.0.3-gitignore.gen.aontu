# Entity: gitignore

main: kit: entity: gitignore: {

  alias: field: {}

  name: "gitignore"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /gitignore/templates"
            json: "{\"operationId\":\"gitignore/get-all-templates\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":[\"Actionscript\",\"Android\",\"AppceleratorTitanium\",\"Autotools\",\"Bancha\",\"C\",\"C++\"]}},\"schema\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"}}},\"description\":\"Response\"},\"304\":{\"description\":\"Not modified\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
