            json: "{\"operationId\":\"secret-scanning/get-scan-history\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"backfill_scans\":[{\"completed_at\":\"2024-10-07T02:50:00Z\",\"started_at\":\"2024-10-07T02:47:00Z\",\"status\":\"completed\",\"type\":\"git\"},{\"completed_at\":\"2024-10-07T02:49:00Z\",\"started_at\":\"2024-10-07T02:47:00Z\",\"status\":\"completed\",\"type\":\"issue\"},{\"completed_at\":\"2024-10-07T02:48:00Z\",\"started_at\":\"2024-10-07T02:47:00Z\",\"status\":\"completed\",\"type\":\"discussion\"}],\"custom_pattern_backfill_scans\":[{\"completed_at\":\"2024-10-07T02:55:00Z\",\"pattern_scope\":\"enterprise\",\"pattern_slug\":\"my-custom-pattern\",\"started_at\":\"2024-10-07T02:47:00Z\",\"status\":\"completed\",\"type\":\"git\"},{\"completed_at\":\"2024-10-07T02:55:00Z\",\"pattern_scope\":\"organization\",\"pattern_slug\":\"my-custom-pattern\",\"started_at\":\"2024-10-07T02:47:00Z\",\"status\":\"completed\",\"type\":\"git\"}],\"incremental_scans\":[{\"completed_at\":\"2024-10-07T02:47:00Z\",\"status\":\"completed\",\"type\":\"git\"}],\"pattern_update_scans\":[{\"completed_at\":\"2024-10-07T02:51:00Z\",\"started_at\":\"2024-10-07T02:47:00Z\",\"status\":\"in_progress\",\"type\":\"discussion\"}]}}},\"schema\":{\"properties\":{\"backfill_scans\":{\"items\":{\"description\":\"Information on a single scan performed by secret scanning on the repository\",\"properties\":{\"completed_at\":{\"description\":\"The time that the scan was completed. Empty if the scan is running\",\"format\":\"date-time\",