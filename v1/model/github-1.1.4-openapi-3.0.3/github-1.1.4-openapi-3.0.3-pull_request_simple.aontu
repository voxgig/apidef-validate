# Entity: pull_request_simple

main: kit: entity: pull_request_simple: {

  alias: field: {}

  fields: {
    reviewers: {
      h: "Reviewers"
      n: "reviewers"
      r: false
      sh: "An array of user `login`s that will be requested."
      t: "`$ARRAY`"
    }
    team_reviewers: {
      h: "Team Reviewers"
      n: "team_reviewers"
      r: false
      sh: "An array of team `slug`s that will be requested."
      t: "`$ARRAY`"
    }
  }

  name: "pull_request_simple"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /repos/{owner}/{repo}/pulls/{pull_number}/requested_reviewers"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "pull_number"
                or: "pull_number"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/repos/{owner}/{repo}/pulls/{pull_number}/requested_reviewers"
          q: {
            exist: [
              "owner"
              "pull_number"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "pulls"
            }
            {
              var: "pull_number"
            }
            {
              lit: "requested_reviewers"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /repos/{owner}/{repo}/pulls/{pull_number}/requested_reviewers"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "pull_number"
                or: "pull_number"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/repos/{owner}/{repo}/pulls/{pull_number}/requested_reviewers"
          q: {
            exist: [
              "owner"
              "pull_number"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "pulls"
            }
            {
              var: "pull_number"
            }
            {
              lit: "requested_reviewers"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "pull"
      ]
    ]
  }



}