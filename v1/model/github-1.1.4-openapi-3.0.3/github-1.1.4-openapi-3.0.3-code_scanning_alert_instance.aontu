# Entity: code_scanning_alert_instance

main: kit: entity: code_scanning_alert_instance: {

  alias: field: {}

  fields: [
    {
      name: "analysis_key"
      req: false
      short: "Identifies the configuration under which the analysis was executed."
      type: "`$STRING`"
    }
    {
      name: "category"
      req: false
      short: "Identifies the configuration under which the analysis was executed."
      type: "`$STRING`"
    }
    {
      name: "classifications"
      req: false
      short: "Classifications that have been applied to the file that triggered the alert."
      type: "`$ARRAY`"
    }
    {
      name: "commit_sha"
      req: false
      type: "`$STRING`"
    }
    {
      name: "environment"
      req: false
      short: "Identifies the variable values associated with the environment in which the analysis that generated this alert instance was performed, such as the language that was analyzed."
      type: "`$STRING`"
    }
    {
      name: "html_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "location"
      req: false
      short: "Describe a region within a file for the alert."
      type: "`$OBJECT`"
    }
    {
      name: "message"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "ref"
      req: false
      short: "The Git reference, formatted as `refs/pull/<number>/merge`, `refs/pull/<number>/head`, `refs/heads/<branch name>` or simply `<branch name>`."
      type: "`$STRING`"
    }
    {
      name: "state"
      req: false
      short: "State of a code scanning alert."
      type: "`$STRING`"
    }
  ]

  name: "code_scanning_alert_instance"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "alert_number"
                orig: "alert_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "pr"
                orig: "pr"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "ref"
                orig: "ref"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/code-scanning/alerts/{alert_number}/instances"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "alerts"
            }
            {
              var: "alert_number"
            }
            {
              lit: "instances"
            }
          ]
          select: {
            exist: [
              "alert_number"
              "owner"
              "page"
              "per_page"
              "pr"
              "ref"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "alert"
      ]
    ]
  }



}