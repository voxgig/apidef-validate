# Entity: actions_workflow_access_to_repository

main: kit: entity: actions_workflow_access_to_repository: {

  alias: field: {}

  fields: {
    access_level: {
      h: "Access Level"
      n: "access_level"
      r: true
      sh: "Defines the level of access that workflows outside of the repository have to actions and reusable workflows within the repository."
      t: "`$STRING`"
    }
  }

  name: "actions_workflow_access_to_repository"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/actions/permissions/access"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/actions/permissions/access"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
            {
              lit: "access"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}