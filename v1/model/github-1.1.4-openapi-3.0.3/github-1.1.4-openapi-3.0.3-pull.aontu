# Entity: pull

main: kit: entity: pull: {

  alias: field: {}

  fields: [
    {
      name: "active_lock_reason"
      req: false
      type: "`$STRING`"
    }
    {
      name: "additions"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "assignee"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      name: "assignees"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "author_association"
      req: true
      short: "How the author is associated with the repository."
      type: "`$STRING`"
    }
    {
      name: "auto_merge"
      req: true
      short: "The status of auto merging a pull request."
      type: "`$OBJECT`"
    }
    {
      name: "base"
      op: {
        patch: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The name of the branch you want the changes pulled into."
      type: "`$OBJECT`"
    }
    {
      name: "body"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        patch: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The contents of the pull request."
      type: "`$STRING`"
    }
    {
      name: "changed_files"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "closed_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "comments"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "comments_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "commits"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "commits_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "created_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "deletions"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "diff_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "draft"
      req: false
      short: "Indicates whether or not the pull request is a draft."
      type: "`$BOOLEAN`"
    }
    {
      name: "expected_head_sha"
      req: false
      short: "The expected SHA of the pull request's HEAD ref."
      type: "`$STRING`"
    }
    {
      name: "head"
      req: true
      short: "The name of the branch where your changes are implemented."
      type: "`$OBJECT`"
    }
    {
      name: "head_repo"
      req: false
      short: "The name of the repository where the changes in the pull request were made."
      type: "`$STRING`"
    }
    {
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "issue"
      req: false
      short: "An issue in the repository to convert to a pull request."
      type: "`$INTEGER`"
    }
    {
      name: "issue_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "labels"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "links"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "locked"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "maintainer_can_modify"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
        patch: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      short: "Indicates whether maintainers can modify the pull request."
      type: "`$BOOLEAN`"
    }
    {
      name: "merge_commit_sha"
      req: true
      type: "`$STRING`"
    }
    {
      name: "mergeable"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "mergeable_state"
      req: true
      type: "`$STRING`"
    }
    {
      name: "merged"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "merged_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "merged_by"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      name: "milestone"
      req: true
      short: "A collection of related issues and pull requests."
      type: "`$OBJECT`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "number"
      req: true
      short: "Number uniquely identifying the pull request within its repository."
      type: "`$INTEGER`"
    }
    {
      name: "patch_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "rebaseable"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "requested_reviewers"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "requested_teams"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "review_comment_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "review_comments"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "review_comments_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "state"
      op: {
        patch: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "State of this Pull Request."
      type: "`$STRING`"
    }
    {
      name: "statuses_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "title"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        patch: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The title of the pull request."
      type: "`$STRING`"
    }
    {
      name: "updated_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "user"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "pull"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/pulls"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "pulls"
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "base"
                orig: "base"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "direction"
                orig: "direction"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "head"
                orig: "head"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "created"
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "open"
                kind: "query"
                name: "state"
                orig: "state"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/pulls"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "pulls"
          ]
          select: {
            exist: [
              "base"
              "direction"
              "head"
              "owner"
              "page"
              "per_page"
              "repo"
              "sort"
              "state"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "commit_sha"
                orig: "commit_sha"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/commits/{commit_sha}/pulls"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "commits"
            "{commit_sha}"
            "pulls"
          ]
          select: {
            exist: [
              "commit_sha"
              "owner"
              "page"
              "per_page"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "pull_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/pulls/{pull_number}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "pulls"
            "{id}"
          ]
          rename: {
            param: {
              pull_number: "id"
            }
          }
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "pull_number"
                orig: "pull_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/pulls/{pull_number}/merge"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "pulls"
            "{pull_number}"
            "merge"
          ]
          select: {
            "$action": "merge"
            exist: [
              "owner"
              "pull_number"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    patch: {
      name: "patch"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "pull_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/repos/{owner}/{repo}/pulls/{pull_number}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "pulls"
            "{id}"
          ]
          rename: {
            param: {
              pull_number: "id"
            }
          }
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "comment_id"
                orig: "comment_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/repos/{owner}/{repo}/pulls/comments/{comment_id}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "pulls"
            "comments"
            "{comment_id}"
          ]
          select: {
            exist: [
              "comment_id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "pull_number"
                orig: "pull_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PUT"
          orig: "/repos/{owner}/{repo}/pulls/{pull_number}/update-branch"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "pulls"
            "{pull_number}"
            "update-branch"
          ]
          select: {
            "$action": "update_branch"
            exist: [
              "owner"
              "pull_number"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
      [
        "repo"
        "commit"
      ]
      [
        "repo"
        "comment"
      ]
      [
        "repo"
        "pull"
      ]
    ]
  }



}