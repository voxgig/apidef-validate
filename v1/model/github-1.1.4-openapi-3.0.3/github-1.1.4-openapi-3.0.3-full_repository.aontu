  id: {
    field: "id"
    from: {
      owner: "owner.login"
    }
    name: "id"
    parts: [
      "owner"
      "repo"
    ]
    sep: "/"
  }

  name: "full_repository"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /repos/{template_owner}/{template_repo}/generate"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "template_owner"
                or: "template_owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "template_repo"
                or: "template_repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/repos/{template_owner}/{template_repo}/generate"
          q: {
            exist: [
              "template_owner"
              "template_repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "template_owner"
            }
            {
              var: "template_repo"
            }
            {
              lit: "generate"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /orgs/{org}/repos"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/orgs/{org}/repos"
          q: {
            exist: [
              "org_id"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "repos"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /user/repos"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/user/repos"
          s: [
            {
              lit: "user"
            }
            {
              lit: "repos"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
