# Entity: full_repository

main: kit: entity: full_repository: {

  alias: field: {}

  alias: {
    field: {
      github_id: "id"
    }
  }

  fields: [
    {
      name: "allow_auto_merge"
      req: false
      short: "Either `true` to allow auto-merge on pull requests, or `false` to disallow auto-merge."
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_forking"
      req: false
      short: "Either `true` to allow private forks, or `false` to prevent private forks."
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_merge_commit"
      req: false
      short: "Either `true` to allow merging pull requests with a merge commit, or `false` to prevent merging pull requests with merge commits."
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_rebase_merge"
      req: false
      short: "Either `true` to allow rebase-merging pull requests, or `false` to prevent rebase-merging."
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_squash_merge"
      req: false
      short: "Either `true` to allow squash-merging pull requests, or `false` to prevent squash-merging."
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_update_branch"
      req: false
      short: "Either `true` to always allow a pull request head branch that is behind its base branch to be updated even if it is not required to be up to date before merging, or false otherwise."
      type: "`$BOOLEAN`"
    }
    {
      name: "anonymous_access_enabled"
      req: false
      short: "Whether anonymous git access is allowed."
      type: "`$BOOLEAN`"
    }
    {
