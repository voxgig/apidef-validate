# Entity: full_repository

main: kit: entity: full_repository: {

  alias: field: {}

  alias: {
    field: {
      github_id: "id"
    }
  }

  fields: {
    allow_auto_merge: {
      h: "Allow Auto Merge"
      n: "allow_auto_merge"
      r: false
      sh: "Either `true` to allow auto-merge on pull requests, or `false` to disallow auto-merge."
      t: "`$BOOLEAN`"
    }
    allow_forking: {
      h: "Allow Forking"
      n: "allow_forking"
