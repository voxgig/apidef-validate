          method: "GET"
          orig: "/repos/{owner}/{repo}"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
