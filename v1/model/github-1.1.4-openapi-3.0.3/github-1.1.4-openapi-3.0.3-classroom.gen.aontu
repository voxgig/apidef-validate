# Entity: classroom

main: kit: entity: classroom: {

  alias: field: {}

  fields: {
    archived: {
      h: "Archived"
      n: "archived"
      r: true
      sh: "Returns whether classroom is archived or not."
      t: "`$BOOLEAN`"
    }
    avatar_url: {
      h: "Avatar Url"
      n: "avatar_url"
      r: true
      t: "`$STRING`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier of the classroom."
      t: "`$INTEGER`"
    }
    login: {
      h: "Login"
      n: "login"
      r: true
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the classroom."
      t: "`$STRING`"
    }
    node_id: {
      h: "Node Id"
      n: "node_id"
      r: true
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The url of the classroom on GitHub Classroom."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "classroom"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /classrooms"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/classrooms"
          q: {
            exist: [
              "page"
              "per_page"
            ]
          }
          s: [
            {
              lit: "classrooms"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /classrooms/{classroom_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "classroom_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/classrooms/{classroom_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              classroom_id: "id"
            }
          }
          s: [
            {
              lit: "classrooms"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.organization`"
          }
        }
      ]
    }
  }



}