# Entity: commit_comparison

main: kit: entity: commit_comparison: {

  alias: field: {}

  fields: [
    {
      name: "ahead_by"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "base_commit"
      req: true
      short: "Commit"
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 2
        depth: 2
      }
    }
    {
      name: "behind_by"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "commits"
      req: true
      type: "`$ARRAY`"
      union: {
        branches: 2
        count: 2
        depth: 3
      }
    }
    {
      format: "uri"
      name: "diff_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "files"
      req: false
      type: "`$ARRAY`"
    }
    {
      format: "uri"
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "merge_base_commit"
      req: true
      short: "Commit"
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 2
        depth: 2
      }
    }
    {
