# Entity: workflow_run_usage

main: kit: entity: workflow_run_usage: {

  alias: field: {}

  fields: [
    {
      name: "MACOS"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "UBUNTU"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "WINDOWS"
      req: true
      type: "`$OBJECT`"
    }
  ]

  name: "workflow_run_usage"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "run_id"
                orig: "run_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/actions/runs/{run_id}/timing"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "runs"
            }
            {
              var: "run_id"
            }
            {
              lit: "timing"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
              "run_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.billable`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "run"
      ]
    ]
  }



}