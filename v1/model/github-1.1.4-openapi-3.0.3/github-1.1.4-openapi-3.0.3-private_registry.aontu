# Entity: private_registry

main: kit: entity: private_registry: {

  alias: field: {}

  fields: [
    {
      name: "created_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "encrypted_value"
      req: false
      short: "The value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get private registries public key for an organization](https://docs.github.com/re…"
      type: "`$STRING`"
    }
    {
      name: "key"
      req: true
      short: "The Base64 encoded public key."
      type: "`$STRING`"
    }
    {
      name: "key_id"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The identifier for the key."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The name of the private registry configuration."
      type: "`$STRING`"
    }
    {
      name: "registry_type"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "The registry type."
      type: "`$STRING`"
    }
    {
      name: "selected_repository_ids"
      req: false
      short: "An array of repository IDs that can access the organization private registry."
      type: "`$ARRAY`"
    }
    {
      name: "updated_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "The URL of the private registry."
      type: "`$STRING`"
    }
    {
      name: "username"
      req: false
      short: "The username to use when authenticating with the private registry."
      type: "`$STRING`"
    }
    {
      name: "visibility"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "Which type of organization repositories have access to the private registry."
      type: "`$STRING`"
    }
  ]

  name: "private_registry"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/orgs/{org}/private-registries"
          parts: [
            "orgs"
            "{org_id}"
            "private-registries"
          ]
          rename: {
            param: {
              org: "org_id"
            }
          }
          select: {
            exist: [
              "org_id"
              "page"
              "per_page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.configurations`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/orgs/{org}/private-registries/public-key"
          parts: [
            "orgs"
            "{org_id}"
            "private-registries"
            "public-key"
          ]
          rename: {
            param: {
              org: "org_id"
            }
          }
          select: {
            "$action": "public_key"
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "secret_name"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/orgs/{org}/private-registries/{secret_name}"
          parts: [
            "orgs"
            "{org_id}"
            "private-registries"
            "{id}"
          ]
          rename: {
            param: {
              org: "org_id"
              secret_name: "id"
            }
          }
          select: {
            exist: [
              "id"
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "secret_name"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/orgs/{org}/private-registries/{secret_name}"
          parts: [
            "orgs"
            "{org_id}"
            "private-registries"
            "{id}"
          ]
          rename: {
            param: {
              org: "org_id"
              secret_name: "id"
            }
          }
          select: {
            exist: [
              "id"
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
    ]
  }



}