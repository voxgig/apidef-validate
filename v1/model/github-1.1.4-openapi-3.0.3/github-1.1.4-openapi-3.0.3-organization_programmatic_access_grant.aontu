      t: "`$STRING`"
    }
    repository_selection: {
      h: "Repository Selection"
      n: "repository_selection"
      r: true
      sh: "Type of repository selection requested."
      t: "`$STRING`"
    }
    token_expired: {
      h: "Token Expired"
      n: "token_expired"
      r: true
      sh: "Whether the associated fine-grained personal access token has expired."
      t: "`$BOOLEAN`"
    }
    token_expires_at: {
      h: "Token Expires At"
      n: "token_expires_at"
      r: true
      sh: "Date and time when the associated fine-grained personal access token expires."
      t: "`$STRING`"
    }
    token_id: {
      h: "Token Id"
      n: "token_id"
      r: true
      sh: "Unique identifier of the user's token."
      t: "`$INTEGER`"
    }
    token_last_used_at: {
      h: "Token Last Used At"
      n: "token_last_used_at"
      r: true
      sh: "Date and time when the associated fine-grained personal access token was last used for authentication."
      t: "`$STRING`"
    }
    token_name: {
      h: "Token Name"
      n: "token_name"
      r: true
      sh: "The name given to the user's token."
      t: "`$STRING`"
    }
  }

