# Entity: dependency_graph

main: kit: entity: dependency_graph: {

  alias: field: {}

  fields: [
    {
      name: "detector"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "job"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "manifests"
      req: false
      type: "`$OBJECT`"
      union: {
        branches: 3
        count: 1
        depth: 4
      }
    }
    {
      name: "metadata"
      req: false
      type: "`$OBJECT`"
      union: {
        branches: 3
        count: 1
        depth: 1
      }
    }
    {
      name: "ref"
      req: true
      type: "`$STRING`"
    }
    {
      name: "scanned"
      req: true
      type: "`$STRING`"
    }
    {
      name: "sha"
      req: true
      type: "`$STRING`"
    }
    {
      name: "version"
      req: true
      type: "`$INTEGER`"
    }
  ]

  name: "dependency_graph"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/dependency-graph/snapshots"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "dependency-graph"
            "snapshots"
          ]
          select: {
            "$action": "snapshot"
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              detector: "`reqdata.detector`"
              job: "`reqdata.job`"
              manifests: "`reqdata.manifest`"
              metadata: "`reqdata.metadata`"
              ref: "`reqdata.ref`"
              scanned: "`reqdata.scanned`"
              sha: "`reqdata.sha`"
              version: "`reqdata.version`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}