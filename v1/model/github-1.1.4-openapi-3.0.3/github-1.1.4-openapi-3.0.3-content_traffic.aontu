# Entity: content_traffic

main: kit: entity: content_traffic: {

  alias: field: {}

  fields: [
    {
      name: "count"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "path"
      req: true
      type: "`$STRING`"
    }
    {
      name: "title"
      req: true
      type: "`$STRING`"
    }
    {
      name: "uniques"
      req: true
      type: "`$INTEGER`"
    }
  ]

  name: "content_traffic"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
