  fields: {
    bypass_pull_request_allowances: {
      h: "Bypass Pull Request Allowances"
      n: "bypass_pull_request_allowances"
      r: false
      sh: "Allow specific users, teams, or apps to bypass pull request requirements."
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 5
      }
    }
    dismiss_stale_reviews: {
      h: "Dismiss Stale Reviews"
      n: "dismiss_stale_reviews"
      op: {
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Set to `true` if you want to automatically dismiss approving reviews when someone pushes a new commit."
      t: "`$BOOLEAN`"
    }
    dismissal_restrictions: {
      h: "Dismissal Restrictions"
      n: "dismissal_restrictions"
      r: false
      sh: "Specify which users, teams, and apps can dismiss pull request reviews."
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 5
      }
    }
    require_code_owner_reviews: {
      h: "Require Code Owner Reviews"
      n: "require_code_owner_reviews"
      op: {
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Blocks merging pull requests until [code owners](https://docs.github.com/articles/about-code-owners/) have reviewed."
      t: "`$BOOLEAN`"
    }
    require_last_push_approval: {
      h: "Require Last Push Approval"
      n: "require_last_push_approval"
      r: false
      sh: "Whether the most recent push must be approved by someone other than the person who pushed it."
      t: "`$BOOLEAN`"
    }
    required_approving_review_count: {
      h: "Required Approving Review Count"
      n: "required_approving_review_count"
      r: false
      sh: "Specifies the number of reviewers required to approve pull requests."
      t: "`$INTEGER`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      t: "`$STRING`"
    }
  }

