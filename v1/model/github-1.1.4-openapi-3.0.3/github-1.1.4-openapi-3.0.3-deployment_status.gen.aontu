      short: "The URL to associate with this status."
      type: "`$STRING`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "performed_via_github_app"
      req: true
      short: "GitHub apps are a new way to extend GitHub."
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      format: "uri"
      name: "repository_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "state"
      req: true
      short: "The state of the status."
      type: "`$STRING`"
    }
