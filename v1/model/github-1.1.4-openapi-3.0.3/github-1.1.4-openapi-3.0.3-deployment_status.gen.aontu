# Entity: deployment_status

main: kit: entity: deployment_status: {

  alias: field: {}

  fields: [
    {
      name: "auto_inactive"
      req: false
      short: "Adds a new `inactive` status to all prior non-transient, non-production environment deployments with the same repository and `environment` name as the created status's deployment."
      type: "`$BOOLEAN`"
    }
    {
      format: "date-time"
      name: "created_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "creator"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      format: "uri"
      name: "deployment_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "description"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "A short description of the status."
      type: "`$STRING`"
    }
    {
      name: "environment"
      req: false
      short: "The environment of the deployment that the status is for."
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "environment_url"
      req: false
      short: "The URL for accessing your environment."
      type: "`$STRING`"
    }
    {
      format: "int64"
      name: "id"
      req: true
      type: "`$INTEGER`"
    }
    {
