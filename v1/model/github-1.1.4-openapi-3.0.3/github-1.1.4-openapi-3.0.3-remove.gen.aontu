"user_view_type\":{\"example\":\"public\",\"type\":\"string\"}},\"required\":[\"avatar_url\",\"events_url\",\"followers_url\",\"following_url\",\"gists_url\",\"gravatar_id\",\"html_url\",\"id\",\"node_id\",\"login\",\"organizations_url\",\"received_events_url\",\"repos_url\",\"site_admin\",\"starred_url\",\"subscriptions_url\",\"type\",\"url\"],\"title\":\"Simple User\",\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Successfully removed team members.\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
