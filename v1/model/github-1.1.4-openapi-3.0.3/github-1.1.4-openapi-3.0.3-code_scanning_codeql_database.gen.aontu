  id: {
    field: "id"
    name: "id"
  }

  name: "code_scanning_codeql_database"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/code-scanning/codeql/databases"
            source: "openapi3"
