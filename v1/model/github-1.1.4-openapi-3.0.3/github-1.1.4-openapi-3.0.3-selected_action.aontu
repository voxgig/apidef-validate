# Entity: selected_action

main: kit: entity: selected_action: {

  alias: field: {}

  fields: {
    github_owned_allowed: {
      h: "Github Owned Allowed"
      n: "github_owned_allowed"
      r: false
      sh: "Whether GitHub-owned actions are allowed."
      t: "`$BOOLEAN`"
    }
    patterns_allowed: {
      h: "Patterns Allowed"
      n: "patterns_allowed"
      r: false
      sh: "Specifies a list of string-matching patterns to allow specific action(s) and reusable workflow(s)."
      t: "`$ARRAY`"
    }
    verified_allowed: {
      h: "Verified Allowed"
      n: "verified_allowed"
      r: false
      sh: "Whether actions from GitHub Marketplace verified creators are allowed."
      t: "`$BOOLEAN`"
    }
  }

  name: "selected_action"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/actions/permissions/selected-actions"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/actions/permissions/selected-actions"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
            {
              lit: "selected-actions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.patterns_allowed`"
          }
        }
        {
          co: {
            id: "GET /orgs/{org}/actions/permissions/selected-actions"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/actions/permissions/selected-actions"
          q: {
            exist: [
              "org_id"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
            {
              lit: "selected-actions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.patterns_allowed`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.org")]
    [path("$.main.kit.entity.repo")]
  ]

}