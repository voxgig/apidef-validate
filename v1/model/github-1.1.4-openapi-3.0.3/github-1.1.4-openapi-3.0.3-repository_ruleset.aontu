            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "ruleset_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "PUT /orgs/{org}/rulesets/{ruleset_id}"
            json: "{\"operationId\":\"repos/update-org-ruleset\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The ID of the ruleset.\",\"in\":\"path\",\"name\":\"ruleset_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"bypass_actors\":[{\"actor_id\":234,\"actor_type\":\"Team\",\"bypass_mode\":\"always\"}],\"conditions\":{\"ref_name\":{\"exclude\":[\"refs/heads/dev*\"],\"include\":[\"refs/heads/main\",\"refs/heads/master\"]},\"repository_name\":{\"exclude\":[\"unimportant_repository\"],\"include\":[\"important_repository\",\"another_important_repository\"],\"protected\":true}},\"enforcement\":\"active\",\"name\":\"super cool ruleset\",\"rules\":[{\"parameters\":{\"operator\":\"contains\",\"pattern\":\"github\"},\"type\":\"commit_author_email_pattern\"}],\"target\":\"branch\"}}},\"schema\":{\"properties\":{\"bypass_actors\":{\"description\":\"The actors that can bypass the rules in this ruleset\",\"items\":{\"description\":\"An actor that can bypass rules in a ruleset\",\"properties\":{\"actor_id\":{\"description\":\"The ID of the actor that can bypass a ruleset. Required for `Integration`, `RepositoryRole`, and `Team` actor types. If `actor_type` is `OrganizationAdmin`, this should be `1`. If `actor_type` is `DeployKey`, this should be null. `OrganizationAdmin` is not applicable for personal repositories.\",\"nullable\":true,\"type\":\"integer\"},\"actor_type\":{\"description\":\"The type of actor that can bypass a ruleset.\",\"enum\":[\"Integration\",\"OrganizationAdmin\",\"RepositoryRole\",\"Team\",\"DeployKey\"],\"type\":\"string\"},\"bypass_mode\":{\"default\":\"always\",\"description\":\"When the specified actor can bypass the ruleset. `pull_request` means that an actor can only bypass rules on pull requests. `pull_request` is not applicable for the `DeployKey` actor type. Also, `pull_request` is only applicable to branch rulesets. When `bypass_mode` is `exempt`, rules will not be run for that actor and a bypass audit entry will not be created.\",\"enum\":[\"always\",\"pull_request\",\"exempt\"],\"type\":\"string\"}},\"required\":[\"actor_type\"],\"title\":\"Repository Ruleset Bypass Actor\",\"type\":\"object\"},\"type\":\"array\"},\"conditions\":{\"description\":\"Conditions for an organization ruleset.\\nThe branch and tag rulesets conditions object should contain both `repository_name` and `ref_name` properties, or both `repository_id` and `ref_name` properties, or both `repository_property` and `ref_name` properties.\\nThe push rulesets conditions object does not require the `ref_name` property.\\nFor repository policy rulesets, the conditions object should only contain the `repository_name`, the `repository_id`, or the `repository_property`.\",\"oneOf\":[{\"allOf\":[{\"description\":\"Parameters for a repository ruleset ref name condition\",\"properties\":{\"ref_name\":{\"properties\":{\"exclude\":{\"description\":\"Array of ref names or patterns to exclude. The condition will not pass if any of these patterns match.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"include\":{\"description\":\"Array of ref names or patterns to include. One of these patterns must match for the condition to pass. Also accepts `~DEFAULT_BRANCH` to include the default branch or `~ALL` to include all branches.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}},\"title\":\"Repository ruleset conditions for ref names\",\"type\":\"object\"},{\"description\":\"Parameters for a repository name condition\",\"properties\":{\"repository_name\":{\"properties\":{\"exclude\":{\"description\":\"Array of repository names or patterns to exclude. The condition will not pass if any of these patterns match.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"include\":{\"description\":\"Array of repository names or patterns to include. One of these patterns must match for the condition to pass. Also accepts `~ALL` to include all repositories.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"protected\":{\"description\":\"Whether renaming of target repositories is prevented.\",\"type\":\"boolean\"}},\"type\":\"object\"}},\"required\":[\"repository_name\"],\"title\":\"Repository ruleset conditions for repository names\",\"type\":\"object\"}],\"description\":\"Conditions to target repositories by name and refs by name\",\"title\":\"repository_name_and_ref_name\",\"type\":\"object\"},{\"allOf\":[{\"description\":\"Parameters for a repository ruleset ref name condition\",\"properties\":{\"ref_name\":{\"properties\":{\"exclude\":{\"description\":\"Array of ref names or patterns to exclude. The condition will not pass if any of these patterns match.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"include\":{\"description\":\"Array of ref names or patterns to include. One of these patterns must match for the condition to pass. Also accepts `~DEFAULT_BRANCH` to include the default branch or `~ALL` to include all branches.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}},\"title\":\"Repository ruleset conditions for ref names\",\"type\":\"object\"},{\"description\":\"Parameters for a repository ID condition\",\"properties\":{\"repository_id\":{\"properties\":{\"repository_ids\":{\"description\":\"The repository IDs that the ruleset applies to. One of these IDs must match for the condition to pass.\",\"items\":{\"type\":\"integer\"},\"type\":\"array\"}},\"type\":\"object\"}},\"required\":[\"repository_id\"],\"title\":\"Repository ruleset conditions for repository IDs\",\"type\":\"object\"}],\"description\":\"Conditions to target repositories by id and refs by name\",\"title\":\"repository_id_and_ref_name\",\"type\":\"object\"},{\"allOf\":[{\"description\":\"Parameters for a repository ruleset ref name condition\",\"properties\":{\"ref_name\":{\"properties\":{\"exclude\":{\"description\":\"Array of ref names or patterns to exclude. The condition will not pass if any of these patterns match.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"include\":{\"description\":\"Array of ref names or patterns to include. One of these patterns must match for the condition to pass. Also accepts `~DEFAULT_BRANCH` to include the default branch or `~ALL` to include all branches.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}},\"title\":\"Repository ruleset conditions for ref names\",\"type\":\"object\"},{\"description\":\"Parameters for a repository property condition\",\"properties\":{\"repository_property\":{\"properties\":{\"exclude\":{\"description\":\"The repository properties and values to exclude. The condition will not pass if any of these properties match.\",\"items\":{\"description\":\"Parameters for a targeting a repository property\",\"properties\":{\"name\":{\"description\":\"The name of the repository property to target\",\"type\":\"string\"},\"property_values\":{\"description\":\"The values to match for the repository property\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"source\":{\"description\":\"The source of the repository property. Defaults to 'custom' if not specified.\",\"enum\":[\"custom\",\"system\"],\"type\":\"string\"}},\"required\":[\"name\",\"property_values\"],\"title\":\"Repository ruleset property targeting definition\",\"type\":\"object\"},\"type\":\"array\"},\"include\":{\"description\":\"The repository properties and values to include. All of these properties must match for the condition to pass.\",\"items\":{\"description\":\"Parameters for a targeting a repository property\",\"properties\":{\"name\":{\"description\":\"The name of the repository property to target\",\"type\":\"string\"},\"property_values\":{\"description\":\"The values to match for the repository property\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"source\":{\"description\":\"The source of the repository property. Defaults to 'custom' if not specified.\",\"enum\":[\"custom\",\"system\"],\"type\":\"string\"}},\"required\":[\"name\",\"property_values\"],\"title\":\"Repository ruleset property targeting definition\",\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}},\"required\":[\"repository_property\"],\"title\":\"Repository ruleset conditions for repository properties\",\"type\":\"object\"}],\"description\":\"Conditions to target repositories by property and refs by name\",\"title\":\"repository_property_and_ref_name\",\"type\":\"object\"}],\"title\":\"Organization ruleset conditions\",\"type\":\"object\"},\"enforcement\":{\"description\":\"The enforcement level of the ruleset. `evaluate` allows admins to test rules before enforcing them. Admins can view insights on the Rule Insights page (`evaluate` is only available with GitHub Enterprise).\",\"enum\":[\"disabled\",\"active\",\"evaluate\"],\"type\":\"string\"},\"name\":{\"description\":\"The name of the ruleset.\",\"type\":\"string\"},\"rules\":{\"description\":\"An array of rules within the ruleset.\",\"items\":{\"description\":\"A repository rule.\",\"oneOf\":[{\"description\":\"Only allow users with bypass permission to create matching refs.\",\"properties\":{\"type\":{\"enum\":[\"creation\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"creation\",\"type\":\"object\"},{\"description\":\"Only allow users with bypass permission to update matching refs.\",\"properties\":{\"parameters\":{\"properties\":{\"update_allows_fetch_and_merge\":{\"description\":\"Branch can pull changes from its upstream repository\",\"type\":\"boolean\"}},\"required\":[\"update_allows_fetch_and_merge\"],\"type\":\"object\"},\"type\":{\"enum\":[\"update\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"update\",\"type\":\"object\"},{\"description\":\"Only allow users with bypass permissions to delete matching refs.\",\"properties\":{\"type\":{\"enum\":[\"deletion\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"deletion\",\"type\":\"object\"},{\"description\":\"Prevent merge commits from being pushed to matching refs.\",\"properties\":{\"type\":{\"enum\":[\"required_linear_history\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"required_linear_history\",\"type\":\"object\"},{\"description\":\"Choose which environments must be successfully deployed to before refs can be pushed into a ref that matches this rule.\",\"properties\":{\"parameters\":{\"properties\":{\"required_deployment_environments\":{\"description\":\"The environments that must be successfully deployed to before branches can be merged.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"required_deployment_environments\"],\"type\":\"object\"},\"type\":{\"enum\":[\"required_deployments\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"required_deployments\",\"type\":\"object\"},{\"description\":\"Commits pushed to matching refs must have verified signatures.\",\"properties\":{\"type\":{\"enum\":[\"required_signatures\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"required_signatures\",\"type\":\"object\"},{\"description\":\"Require all commits be made to a non-target branch and submitted via a pull request before they can be merged.\",\"properties\":{\"parameters\":{\"properties\":{\"allowed_merge_methods\":{\"description\":\"Array of allowed merge methods. Allowed values include `merge`, `squash`, and `rebase`. At least one option must be enabled.\",\"items\":{\"enum\":[\"merge\",\"squash\",\"rebase\"],\"type\":\"string\"},\"type\":\"array\"},\"automatic_copilot_code_review_enabled\":{\"description\":\"Request Copilot code review for new pull requests automatically if the author has access to Copilot code review.\",\"type\":\"boolean\"},\"dismiss_stale_reviews_on_push\":{\"description\":\"New, reviewable commits pushed will dismiss previous pull request review approvals.\",\"type\":\"boolean\"},\"require_code_owner_review\":{\"description\":\"Require an approving review in pull requests that modify files that have a designated code owner.\",\"type\":\"boolean\"},\"require_last_push_approval\":{\"description\":\"Whether the most recent reviewable push must be approved by someone other than the person who pushed it.\",\"type\":\"boolean\"},\"required_approving_review_count\":{\"description\":\"The number of approving reviews that are required before a pull request can be merged.\",\"maximum\":10,\"minimum\":0,\"type\":\"integer\"},\"required_review_thread_resolution\":{\"description\":\"All conversations on code must be resolved before a pull request can be merged.\",\"type\":\"boolean\"}},\"required\":[\"dismiss_stale_reviews_on_push\",\"require_code_owner_review\",\"require_last_push_approval\",\"required_approving_review_count\",\"required_review_thread_resolution\"],\"type\":\"object\"},\"type\":{\"enum\":[\"pull_request\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"pull_request\",\"type\":\"object\"},{\"description\":\"Choose which status checks must pass before the ref is updated. When enabled, commits must first be pushed to another ref where the checks pass.\",\"properties\":{\"parameters\":{\"properties\":{\"do_not_enforce_on_create\":{\"description\":\"Allow repositories and branches to be created if a check would otherwise prohibit it.\",\"type\":\"boolean\"},\"required_status_checks\":{\"description\":\"Status checks that are required.\",\"items\":{\"description\":\"Required status check\",\"properties\":{\"context\":{\"description\":\"The status check context name that must be present on the commit.\",\"type\":\"string\"},\"integration_id\":{\"description\":\"The optional integration ID that this status check must originate from.\",\"type\":\"integer\"}},\"required\":[\"context\"],\"title\":\"StatusCheckConfiguration\",\"type\":\"object\"},\"type\":\"array\"},\"strict_required_status_checks_policy\":{\"description\":\"Whether pull requests targeting a matching branch must be tested with the latest code. This setting will not take effect unless at least one status check is enabled.\",\"type\":\"boolean\"}},\"required\":[\"required_status_checks\",\"strict_required_status_checks_policy\"],\"type\":\"object\"},\"type\":{\"enum\":[\"required_status_checks\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"required_status_checks\",\"type\":\"object\"},{\"description\":\"Prevent users with push access from force pushing to refs.\",\"properties\":{\"type\":{\"enum\":[\"non_fast_forward\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"non_fast_forward\",\"type\":\"object\"},{\"description\":\"Parameters to be used for the commit_message_pattern rule\",\"properties\":{\"parameters\":{\"properties\":{\"name\":{\"description\":\"How this rule will appear to users.\",\"type\":\"string\"},\"negate\":{\"description\":\"If true, the rule will fail if the pattern matches.\",\"type\":\"boolean\"},\"operator\":{\"description\":\"The operator to use for matching.\",\"enum\":[\"starts_with\",\"ends_with\",\"contains\",\"regex\"],\"type\":\"string\"},\"pattern\":{\"description\":\"The pattern to match with.\",\"type\":\"string\"}},\"required\":[\"operator\",\"pattern\"],\"type\":\"object\"},\"type\":{\"enum\":[\"commit_message_pattern\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"commit_message_pattern\",\"type\":\"object\"},{\"description\":\"Parameters to be used for the commit_author_email_pattern rule\",\"properties\":{\"parameters\":{\"properties\":{\"name\":{\"description\":\"How this rule will appear to users.\",\"type\":\"string\"},\"negate\":{\"description\":\"If true, the rule will fail if the pattern matches.\",\"type\":\"boolean\"},\"operator\":{\"description\":\"The operator to use for matching.\",\"enum\":[\"starts_with\",\"ends_with\",\"contains\",\"regex\"],\"type\":\"string\"},\"pattern\":{\"description\":\"The pattern to match with.\",\"type\":\"string\"}},\"required\":[\"operator\",\"pattern\"],\"type\":\"object\"},\"type\":{\"enum\":[\"commit_author_email_pattern\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"commit_author_email_pattern\",\"type\":\"object\"},{\"description\":\"Parameters to be used for the committer_email_pattern rule\",\"properties\":{\"parameters\":{\"properties\":{\"name\":{\"description\":\"How this rule will appear to users.\",\"type\":\"string\"},\"negate\":{\"description\":\"If true, the rule will fail if the pattern matches.\",\"type\":\"boolean\"},\"operator\":{\"description\":\"The operator to use for matching.\",\"enum\":[\"starts_with\",\"ends_with\",\"contains\",\"regex\"],\"type\":\"string\"},\"pattern\":{\"description\":\"The pattern to match with.\",\"type\":\"string\"}},\"required\":[\"operator\",\"pattern\"],\"type\":\"object\"},\"type\":{\"enum\":[\"committer_email_pattern\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"committer_email_pattern\",\"type\":\"object\"},{\"description\":\"Parameters to be used for the branch_name_pattern rule\",\"properties\":{\"parameters\":{\"properties\":{\"name\":{\"description\":\"How this rule will appear to users.\",\"type\":\"string\"},\"negate\":{\"description\":\"If true, the rule will fail if the pattern matches.\",\"type\":\"boolean\"},\"operator\":{\"description\":\"The operator to use for matching.\",\"enum\":[\"starts_with\",\"ends_with\",\"contains\",\"regex\"],\"type\":\"string\"},\"pattern\":{\"description\":\"The pattern to match with.\",\"type\":\"string\"}},\"required\":[\"operator\",\"pattern\"],\"type\":\"object\"},\"type\":{\"enum\":[\"branch_name_pattern\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"branch_name_pattern\",\"type\":\"object\"},{\"description\":\"Parameters to be used for the tag_name_pattern rule\",\"properties\":{\"parameters\":{\"properties\":{\"name\":{\"description\":\"How this rule will appear to users.\",\"type\":\"string\"},\"negate\":{\"description\":\"If true, the rule will fail if the pattern matches.\",\"type\":\"boolean\"},\"operator\":{\"description\":\"The operator to use for matching.\",\"enum\":[\"starts_with\",\"ends_with\",\"contains\",\"regex\"],\"type\":\"string\"},\"pattern\":{\"description\":\"The pattern to match with.\",\"type\":\"string\"}},\"required\":[\"operator\",\"pattern\"],\"type\":\"object\"},\"type\":{\"enum\":[\"tag_name_pattern\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"tag_name_pattern\",\"type\":\"object\"},{\"description\":\"Prevent commits that include changes in specified file and folder paths from being pushed to the commit graph. This includes absolute paths that contain file names.\",\"properties\":{\"parameters\":{\"properties\":{\"restricted_file_paths\":{\"description\":\"The file paths that are restricted from being pushed to the commit graph.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"restricted_file_paths\"],\"type\":\"object\"},\"type\":{\"enum\":[\"file_path_restriction\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"file_path_restriction\",\"type\":\"object\"},{\"description\":\"Prevent commits that include file paths that exceed the specified character limit from being pushed to the commit graph.\",\"properties\":{\"parameters\":{\"properties\":{\"max_file_path_length\":{\"description\":\"The maximum amount of characters allowed in file paths.\",\"maximum\":32767,\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"max_file_path_length\"],\"type\":\"object\"},\"type\":{\"enum\":[\"max_file_path_length\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"max_file_path_length\",\"type\":\"object\"},{\"description\":\"Prevent commits that include files with specified file extensions from being pushed to the commit graph.\",\"properties\":{\"parameters\":{\"properties\":{\"restricted_file_extensions\":{\"description\":\"The file extensions that are restricted from being pushed to the commit graph.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"restricted_file_extensions\"],\"type\":\"object\"},\"type\":{\"enum\":[\"file_extension_restriction\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"file_extension_restriction\",\"type\":\"object\"},{\"description\":\"Prevent commits with individual files that exceed the specified limit from being pushed to the commit graph.\",\"properties\":{\"parameters\":{\"properties\":{\"max_file_size\":{\"description\":\"The maximum file size allowed in megabytes. This limit does not apply to Git Large File Storage (Git LFS).\",\"maximum\":100,\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"max_file_size\"],\"type\":\"object\"},\"type\":{\"enum\":[\"max_file_size\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"max_file_size\",\"type\":\"object\"},{\"description\":\"Require all changes made to a targeted branch to pass the specified workflows before they can be merged.\",\"properties\":{\"parameters\":{\"properties\":{\"do_not_enforce_on_create\":{\"description\":\"Allow repositories and branches to be created if a check would otherwise prohibit it.\",\"type\":\"boolean\"},\"workflows\":{\"description\":\"Workflows that must pass for this rule to pass.\",\"items\":{\"description\":\"A workflow that must run for this rule to pass\",\"properties\":{\"path\":{\"description\":\"The path to the workflow file\",\"type\":\"string\"},\"ref\":{\"description\":\"The ref (branch or tag) of the workflow file to use\",\"type\":\"string\"},\"repository_id\":{\"description\":\"The ID of the repository where the workflow is defined\",\"type\":\"integer\"},\"sha\":{\"description\":\"The commit SHA of the workflow file to use\",\"type\":\"string\"}},\"required\":[\"path\",\"repository_id\"],\"title\":\"WorkflowFileReference\",\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"workflows\"],\"type\":\"object\"},\"type\":{\"enum\":[\"workflows\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"workflows\",\"type\":\"object\"},{\"description\":\"Choose which tools must provide code scanning results before the reference is updated. When configured, code scanning must be enabled and have results for both the commit and the reference being updated.\",\"properties\":{\"parameters\":{\"properties\":{\"code_scanning_tools\":{\"description\":\"Tools that must provide code scanning results for this rule to pass.\",\"items\":{\"description\":\"A tool that must provide code scanning results for this rule to pass.\",\"properties\":{\"alerts_threshold\":{\"description\":\"The severity level at which code scanning results that raise alerts block a reference update. For more information on alert severity levels, see \\\"[About code scanning alerts](https://docs.github.com/code-security/code-scanning/managing-code-scanning-alerts/about-code-scanning-alerts#about-alert-severity-and-security-severity-levels).\\\"\",\"enum\":[\"none\",\"errors\",\"errors_and_warnings\",\"all\"],\"type\":\"string\"},\"security_alerts_threshold\":{\"description\":\"The severity level at which code scanning results that raise security alerts block a reference update. For more information on security severity levels, see \\\"[About code scanning alerts](https://docs.github.com/code-security/code-scanning/managing-code-scanning-alerts/about-code-scanning-alerts#about-alert-severity-and-security-severity-levels).\\\"\",\"enum\":[\"none\",\"critical\",\"high_or_higher\",\"medium_or_higher\",\"all\"],\"type\":\"string\"},\"tool\":{\"description\":\"The name of a code scanning tool\",\"type\":\"string\"}},\"required\":[\"alerts_threshold\",\"security_alerts_threshold\",\"tool\"],\"title\":\"CodeScanningTool\",\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"code_scanning_tools\"],\"type\":\"object\"},\"type\":{\"enum\":[\"code_scanning\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"code_scanning\",\"type\":\"object\"}],\"title\":\"Repository Rule\",\"type\":\"object\"},\"type\":\"array\"},\"target\":{\"description\":\"The target of the ruleset\",\"enum\":[\"branch\",\"tag\",\"push\",\"repository\"],\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Request body\",\"required\":false},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"_links\":{\"html\":{\"href\":\"https://github.com/organizations/my-org/settings/rules/21\"},\"self\":{\"href\":\"https://api.github.com/orgs/my-org/rulesets/21\"}},\"bypass_actors\":[{\"actor_id\":234,\"actor_type\":\"Team\",\"bypass_mode\":\"always\"}],\"conditions\":{\"ref_name\":{\"exclude\":[\"refs/heads/dev*\"],\"include\":[\"refs/heads/main\",\"refs/heads/master\"]},\"repository_name\":{\"exclude\":[\"unimportant_repository\"],\"include\":[\"important_repository\",\"another_important_repository\"],\"protected\":true}},\"created_at\":\"2023-08-15T08:43:03Z\",\"enforcement\":\"active\",\"id\":21,\"name\":\"super cool ruleset\",\"node_id\":\"RRS_lACkVXNlcgQB\",\"rules\":[{\"parameters\":{\"operator\":\"contains\",\"pattern\":\"github\"},\"type\":\"commit_author_email_pattern\"}],\"source\":\"my-org\",\"source_type\":\"Organization\",\"target\":\"branch\",\"updated_at\":\"2023-09-23T16:29:47Z\"}}},\"schema\":{\"description\":\"A set of rules to apply when specified conditions are met.\",\"properties\":{\"_links\":{\"properties\":{\"html\":{\"nullable\":true,\"properties\":{\"href\":{\"description\":\"The html URL of the ruleset\",\"type\":\"string\"}},\"type\":\"object\"},\"self\":{\"properties\":{\"href\":{\"description\":\"The URL of the ruleset\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"},\"bypass_actors\":{\"description\":\"The actors that can bypass the rules in this ruleset\",\"items\":{\"description\":\"An actor that can bypass rules in a ruleset\",\"properties\":{\"actor_id\":{\"description\":\"The ID of the actor that can bypass a ruleset. Required for `Integration`, `RepositoryRole`, and `Team` actor types. If `actor_type` is `OrganizationAdmin`, this should be `1`. If `actor_type` is `DeployKey`, this should be null. `OrganizationAdmin` is not applicable for personal repositories.\",\"nullable\":true,\"type\":\"integer\"},\"actor_type\":{\"description\":\"The type of actor that can bypass a ruleset.\",\"enum\":[\"Integration\",\"OrganizationAdmin\",\"RepositoryRole\",\"Team\",\"DeployKey\"],\"type\":\"string\"},\"bypass_mode\":{\"default\":\"always\",\"description\":\"When the specified actor can bypass the ruleset. `pull_request` means that an actor can only bypass rules on pull requests. `pull_request` is not applicable for the `DeployKey` actor type. Also, `pull_request` is only applicable to branch rulesets. When `bypass_mode` is `exempt`, rules will not be run for that actor and a bypass audit entry will not be created.\",\"enum\":[\"always\",\"pull_request\",\"exempt\"],\"type\":\"string\"}},\"required\":[\"actor_type\"],\"title\":\"Repository Ruleset Bypass Actor\",\"type\":\"object\"},\"type\":\"array\"},\"conditions\":{\"anyOf\":[{\"description\":\"Parameters for a repository ruleset ref name condition\",\"properties\":{\"ref_name\":{\"properties\":{\"exclude\":{\"description\":\"Array of ref names or patterns to exclude. The condition will not pass if any of these patterns match.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"include\":{\"description\":\"Array of ref names or patterns to include. One of these patterns must match for the condition to pass. Also accepts `~DEFAULT_BRANCH` to include the default branch or `~ALL` to include all branches.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}},\"title\":\"Repository ruleset conditions for ref names\",\"type\":\"object\"},{\"description\":\"Conditions for an organization ruleset.\\nThe branch and tag rulesets conditions object should contain both `repository_name` and `ref_name` properties, or both `repository_id` and `ref_name` properties, or both `repository_property` and `ref_name` properties.\\nThe push rulesets conditions object does not require the `ref_name` property.\\nFor repository policy rulesets, the conditions object should only contain the `repository_name`, the `repository_id`, or the `repository_property`.\",\"oneOf\":[{\"allOf\":[{\"description\":\"Parameters for a repository ruleset ref name condition\",\"properties\":{\"ref_name\":{\"properties\":{\"exclude\":{\"description\":\"Array of ref names or patterns to exclude. The condition will not pass if any of these patterns match.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"include\":{\"description\":\"Array of ref names or patterns to include. One of these patterns must match for the condition to pass. Also accepts `~DEFAULT_BRANCH` to include the default branch or `~ALL` to include all branches.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}},\"title\":\"Repository ruleset conditions for ref names\",\"type\":\"object\"},{\"description\":\"Parameters for a repository name condition\",\"properties\":{\"repository_name\":{\"properties\":{\"exclude\":{\"description\":\"Array of repository names or patterns to exclude. The condition will not pass if any of these patterns match.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"include\":{\"description\":\"Array of repository names or patterns to include. One of these patterns must match for the condition to pass. Also accepts `~ALL` to include all repositories.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"protected\":{\"description\":\"Whether renaming of target repositories is prevented.\",\"type\":\"boolean\"}},\"type\":\"object\"}},\"required\":[\"repository_name\"],\"title\":\"Repository ruleset conditions for repository names\",\"type\":\"object\"}],\"description\":\"Conditions to target repositories by name and refs by name\",\"title\":\"repository_name_and_ref_name\",\"type\":\"object\"},{\"allOf\":[{\"description\":\"Parameters for a repository ruleset ref name condition\",\"properties\":{\"ref_name\":{\"properties\":{\"exclude\":{\"description\":\"Array of ref names or patterns to exclude. The condition will not pass if any of these patterns match.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"include\":{\"description\":\"Array of ref names or patterns to include. One of these patterns must match for the condition to pass. Also accepts `~DEFAULT_BRANCH` to include the default branch or `~ALL` to include all branches.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}},\"title\":\"Repository ruleset conditions for ref names\",\"type\":\"object\"},{\"description\":\"Parameters for a repository ID condition\",\"properties\":{\"repository_id\":{\"properties\":{\"repository_ids\":{\"description\":\"The repository IDs that the ruleset applies to. One of these IDs must match for the condition to pass.\",\"items\":{\"type\":\"integer\"},\"type\":\"array\"}},\"type\":\"object\"}},\"required\":[\"repository_id\"],\"title\":\"Repository ruleset conditions for repository IDs\",\"type\":\"object\"}],\"description\":\"Conditions to target repositories by id and refs by name\",\"title\":\"repository_id_and_ref_name\",\"type\":\"object\"},{\"allOf\":[{\"description\":\"Parameters for a repository ruleset ref name condition\",\"properties\":{\"ref_name\":{\"properties\":{\"exclude\":{\"description\":\"Array of ref names or patterns to exclude. The condition will not pass if any of these patterns match.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"include\":{\"description\":\"Array of ref names or patterns to include. One of these patterns must match for the condition to pass. Also accepts `~DEFAULT_BRANCH` to include the default branch or `~ALL` to include all branches.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}},\"title\":\"Repository ruleset conditions for ref names\",\"type\":\"object\"},{\"description\":\"Parameters for a repository property condition\",\"properties\":{\"repository_property\":{\"properties\":{\"exclude\":{\"description\":\"The repository properties and values to exclude. The condition will not pass if any of these properties match.\",\"items\":{\"description\":\"Parameters for a targeting a repository property\",\"properties\":{\"name\":{\"description\":\"The name of the repository property to target\",\"type\":\"string\"},\"property_values\":{\"description\":\"The values to match for the repository property\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"source\":{\"description\":\"The source of the repository property. Defaults to 'custom' if not specified.\",\"enum\":[\"custom\",\"system\"],\"type\":\"string\"}},\"required\":[\"name\",\"property_values\"],\"title\":\"Repository ruleset property targeting definition\",\"type\":\"object\"},\"type\":\"array\"},\"include\":{\"description\":\"The repository properties and values to include. All of these properties must match for the condition to pass.\",\"items\":{\"description\":\"Parameters for a targeting a repository property\",\"properties\":{\"name\":{\"description\":\"The name of the repository property to target\",\"type\":\"string\"},\"property_values\":{\"description\":\"The values to match for the repository property\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"source\":{\"description\":\"The source of the repository property. Defaults to 'custom' if not specified.\",\"enum\":[\"custom\",\"system\"],\"type\":\"string\"}},\"required\":[\"name\",\"property_values\"],\"title\":\"Repository ruleset property targeting definition\",\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}},\"required\":[\"repository_property\"],\"title\":\"Repository ruleset conditions for repository properties\",\"type\":\"object\"}],\"description\":\"Conditions to target repositories by property and refs by name\",\"title\":\"repository_property_and_ref_name\",\"type\":\"object\"}],\"title\":\"Organization ruleset conditions\",\"type\":\"object\"}],\"nullable\":true},\"created_at\":{\"format\":\"date-time\",\"type\":\"string\"},\"current_user_can_bypass\":{\"description\":\"The bypass type of the user making the API request for this ruleset. This field is only returned when\\nquerying the repository-level endpoint.\",\"enum\":[\"always\",\"pull_requests_only\",\"never\",\"exempt\"],\"type\":\"string\"},\"enforcement\":{\"description\":\"The enforcement level of the ruleset. `evaluate` allows admins to test rules before enforcing them. Admins can view insights on the Rule Insights page (`evaluate` is only available with GitHub Enterprise).\",\"enum\":[\"disabled\",\"active\",\"evaluate\"],\"type\":\"string\"},\"id\":{\"description\":\"The ID of the ruleset\",\"type\":\"integer\"},\"name\":{\"description\":\"The name of the ruleset\",\"type\":\"string\"},\"node_id\":{\"type\":\"string\"},\"rules\":{\"items\":{\"description\":\"A repository rule.\",\"oneOf\":[{\"description\":\"Only allow users with bypass permission to create matching refs.\",\"properties\":{\"type\":{\"enum\":[\"creation\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"creation\",\"type\":\"object\"},{\"description\":\"Only allow users with bypass permission to update matching refs.\",\"properties\":{\"parameters\":{\"properties\":{\"update_allows_fetch_and_merge\":{\"description\":\"Branch can pull changes from its upstream repository\",\"type\":\"boolean\"}},\"required\":[\"update_allows_fetch_and_merge\"],\"type\":\"object\"},\"type\":{\"enum\":[\"update\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"update\",\"type\":\"object\"},{\"description\":\"Only allow users with bypass permissions to delete matching refs.\",\"properties\":{\"type\":{\"enum\":[\"deletion\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"deletion\",\"type\":\"object\"},{\"description\":\"Prevent merge commits from being pushed to matching refs.\",\"properties\":{\"type\":{\"enum\":[\"required_linear_history\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"required_linear_history\",\"type\":\"object\"},{\"description\":\"Merges must be performed via a merge queue.\",\"properties\":{\"parameters\":{\"properties\":{\"check_response_timeout_minutes\":{\"description\":\"Maximum time for a required status check to report a conclusion. After this much time has elapsed, checks that have not reported a conclusion will be assumed to have failed\",\"maximum\":360,\"minimum\":1,\"type\":\"integer\"},\"grouping_strategy\":{\"description\":\"When set to ALLGREEN, the merge commit created by merge queue for each PR in the group must pass all required checks to merge. When set to HEADGREEN, only the commit at the head of the merge group, i.e. the commit containing changes from all of the PRs in the group, must pass its required checks to merge.\",\"enum\":[\"ALLGREEN\",\"HEADGREEN\"],\"type\":\"string\"},\"max_entries_to_build\":{\"description\":\"Limit the number of queued pull requests requesting checks and workflow runs at the same time.\",\"maximum\":100,\"minimum\":0,\"type\":\"integer\"},\"max_entries_to_merge\":{\"description\":\"The maximum number of PRs that will be merged together in a group.\",\"maximum\":100,\"minimum\":0,\"type\":\"integer\"},\"merge_method\":{\"description\":\"Method to use when merging changes from queued pull requests.\",\"enum\":[\"MERGE\",\"SQUASH\",\"REBASE\"],\"type\":\"string\"},\"min_entries_to_merge\":{\"description\":\"The minimum number of PRs that will be merged together in a group.\",\"maximum\":100,\"minimum\":0,\"type\":\"integer\"},\"min_entries_to_merge_wait_minutes\":{\"description\":\"The time merge queue should wait after the first PR is added to the queue for the minimum group size to be met. After this time has elapsed, the minimum group size will be ignored and a smaller group will be merged.\",\"maximum\":360,\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"check_response_timeout_minutes\",\"grouping_strategy\",\"max_entries_to_build\",\"max_entries_to_merge\",\"merge_method\",\"min_entries_to_merge\",\"min_entries_to_merge_wait_minutes\"],\"type\":\"object\"},\"type\":{\"enum\":[\"merge_queue\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"merge_queue\",\"type\":\"object\"},{\"description\":\"Choose which environments must be successfully deployed to before refs can be pushed into a ref that matches this rule.\",\"properties\":{\"parameters\":{\"properties\":{\"required_deployment_environments\":{\"description\":\"The environments that must be successfully deployed to before branches can be merged.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"required_deployment_environments\"],\"type\":\"object\"},\"type\":{\"enum\":[\"required_deployments\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"required_deployments\",\"type\":\"object\"},{\"description\":\"Commits pushed to matching refs must have verified signatures.\",\"properties\":{\"type\":{\"enum\":[\"required_signatures\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"required_signatures\",\"type\":\"object\"},{\"description\":\"Require all commits be made to a non-target branch and submitted via a pull request before they can be merged.\",\"properties\":{\"parameters\":{\"properties\":{\"allowed_merge_methods\":{\"description\":\"Array of allowed merge methods. Allowed values include `merge`, `squash`, and `rebase`. At least one option must be enabled.\",\"items\":{\"enum\":[\"merge\",\"squash\",\"rebase\"],\"type\":\"string\"},\"type\":\"array\"},\"automatic_copilot_code_review_enabled\":{\"description\":\"Request Copilot code review for new pull requests automatically if the author has access to Copilot code review.\",\"type\":\"boolean\"},\"dismiss_stale_reviews_on_push\":{\"description\":\"New, reviewable commits pushed will dismiss previous pull request review approvals.\",\"type\":\"boolean\"},\"require_code_owner_review\":{\"description\":\"Require an approving review in pull requests that modify files that have a designated code owner.\",\"type\":\"boolean\"},\"require_last_push_approval\":{\"description\":\"Whether the most recent reviewable push must be approved by someone other than the person who pushed it.\",\"type\":\"boolean\"},\"required_approving_review_count\":{\"description\":\"The number of approving reviews that are required before a pull request can be merged.\",\"maximum\":10,\"minimum\":0,\"type\":\"integer\"},\"required_review_thread_resolution\":{\"description\":\"All conversations on code must be resolved before a pull request can be merged.\",\"type\":\"boolean\"}},\"required\":[\"dismiss_stale_reviews_on_push\",\"require_code_owner_review\",\"require_last_push_approval\",\"required_approving_review_count\",\"required_review_thread_resolution\"],\"type\":\"object\"},\"type\":{\"enum\":[\"pull_request\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"pull_request\",\"type\":\"object\"},{\"description\":\"Choose which status checks must pass before the ref is updated. When enabled, commits must first be pushed to another ref where the checks pass.\",\"properties\":{\"parameters\":{\"properties\":{\"do_not_enforce_on_create\":{\"description\":\"Allow repositories and branches to be created if a check would otherwise prohibit it.\",\"type\":\"boolean\"},\"required_status_checks\":{\"description\":\"Status checks that are required.\",\"items\":{\"description\":\"Required status check\",\"properties\":{\"context\":{\"description\":\"The status check context name that must be present on the commit.\",\"type\":\"string\"},\"integration_id\":{\"description\":\"The optional integration ID that this status check must originate from.\",\"type\":\"integer\"}},\"required\":[\"context\"],\"title\":\"StatusCheckConfiguration\",\"type\":\"object\"},\"type\":\"array\"},\"strict_required_status_checks_policy\":{\"description\":\"Whether pull requests targeting a matching branch must be tested with the latest code. This setting will not take effect unless at least one status check is enabled.\",\"type\":\"boolean\"}},\"required\":[\"required_status_checks\",\"strict_required_status_checks_policy\"],\"type\":\"object\"},\"type\":{\"enum\":[\"required_status_checks\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"required_status_checks\",\"type\":\"object\"},{\"description\":\"Prevent users with push access from force pushing to refs.\",\"properties\":{\"type\":{\"enum\":[\"non_fast_forward\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"non_fast_forward\",\"type\":\"object\"},{\"description\":\"Parameters to be used for the commit_message_pattern rule\",\"properties\":{\"parameters\":{\"properties\":{\"name\":{\"description\":\"How this rule will appear to users.\",\"type\":\"string\"},\"negate\":{\"description\":\"If true, the rule will fail if the pattern matches.\",\"type\":\"boolean\"},\"operator\":{\"description\":\"The operator to use for matching.\",\"enum\":[\"starts_with\",\"ends_with\",\"contains\",\"regex\"],\"type\":\"string\"},\"pattern\":{\"description\":\"The pattern to match with.\",\"type\":\"string\"}},\"required\":[\"operator\",\"pattern\"],\"type\":\"object\"},\"type\":{\"enum\":[\"commit_message_pattern\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"commit_message_pattern\",\"type\":\"object\"},{\"description\":\"Parameters to be used for the commit_author_email_pattern rule\",\"properties\":{\"parameters\":{\"properties\":{\"name\":{\"description\":\"How this rule will appear to users.\",\"type\":\"string\"},\"negate\":{\"description\":\"If true, the rule will fail if the pattern matches.\",\"type\":\"boolean\"},\"operator\":{\"description\":\"The operator to use for matching.\",\"enum\":[\"starts_with\",\"ends_with\",\"contains\",\"regex\"],\"type\":\"string\"},\"pattern\":{\"description\":\"The pattern to match with.\",\"type\":\"string\"}},\"required\":[\"operator\",\"pattern\"],\"type\":\"object\"},\"type\":{\"enum\":[\"commit_author_email_pattern\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"commit_author_email_pattern\",\"type\":\"object\"},{\"description\":\"Parameters to be used for the committer_email_pattern rule\",\"properties\":{\"parameters\":{\"properties\":{\"name\":{\"description\":\"How this rule will appear to users.\",\"type\":\"string\"},\"negate\":{\"description\":\"If true, the rule will fail if the pattern matches.\",\"type\":\"boolean\"},\"operator\":{\"description\":\"The operator to use for matching.\",\"enum\":[\"starts_with\",\"ends_with\",\"contains\",\"regex\"],\"type\":\"string\"},\"pattern\":{\"description\":\"The pattern to match with.\",\"type\":\"string\"}},\"required\":[\"operator\",\"pattern\"],\"type\":\"object\"},\"type\":{\"enum\":[\"committer_email_pattern\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"committer_email_pattern\",\"type\":\"object\"},{\"description\":\"Parameters to be used for the branch_name_pattern rule\",\"properties\":{\"parameters\":{\"properties\":{\"name\":{\"description\":\"How this rule will appear to users.\",\"type\":\"string\"},\"negate\":{\"description\":\"If true, the rule will fail if the pattern matches.\",\"type\":\"boolean\"},\"operator\":{\"description\":\"The operator to use for matching.\",\"enum\":[\"starts_with\",\"ends_with\",\"contains\",\"regex\"],\"type\":\"string\"},\"pattern\":{\"description\":\"The pattern to match with.\",\"type\":\"string\"}},\"required\":[\"operator\",\"pattern\"],\"type\":\"object\"},\"type\":{\"enum\":[\"branch_name_pattern\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"branch_name_pattern\",\"type\":\"object\"},{\"description\":\"Parameters to be used for the tag_name_pattern rule\",\"properties\":{\"parameters\":{\"properties\":{\"name\":{\"description\":\"How this rule will appear to users.\",\"type\":\"string\"},\"negate\":{\"description\":\"If true, the rule will fail if the pattern matches.\",\"type\":\"boolean\"},\"operator\":{\"description\":\"The operator to use for matching.\",\"enum\":[\"starts_with\",\"ends_with\",\"contains\",\"regex\"],\"type\":\"string\"},\"pattern\":{\"description\":\"The pattern to match with.\",\"type\":\"string\"}},\"required\":[\"operator\",\"pattern\"],\"type\":\"object\"},\"type\":{\"enum\":[\"tag_name_pattern\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"tag_name_pattern\",\"type\":\"object\"},{\"description\":\"Prevent commits that include changes in specified file and folder paths from being pushed to the commit graph. This includes absolute paths that contain file names.\",\"properties\":{\"parameters\":{\"properties\":{\"restricted_file_paths\":{\"description\":\"The file paths that are restricted from being pushed to the commit graph.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"restricted_file_paths\"],\"type\":\"object\"},\"type\":{\"enum\":[\"file_path_restriction\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"file_path_restriction\",\"type\":\"object\"},{\"description\":\"Prevent commits that include file paths that exceed the specified character limit from being pushed to the commit graph.\",\"properties\":{\"parameters\":{\"properties\":{\"max_file_path_length\":{\"description\":\"The maximum amount of characters allowed in file paths.\",\"maximum\":32767,\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"max_file_path_length\"],\"type\":\"object\"},\"type\":{\"enum\":[\"max_file_path_length\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"max_file_path_length\",\"type\":\"object\"},{\"description\":\"Prevent commits that include files with specified file extensions from being pushed to the commit graph.\",\"properties\":{\"parameters\":{\"properties\":{\"restricted_file_extensions\":{\"description\":\"The file extensions that are restricted from being pushed to the commit graph.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"restricted_file_extensions\"],\"type\":\"object\"},\"type\":{\"enum\":[\"file_extension_restriction\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"file_extension_restriction\",\"type\":\"object\"},{\"description\":\"Prevent commits with individual files that exceed the specified limit from being pushed to the commit graph.\",\"properties\":{\"parameters\":{\"properties\":{\"max_file_size\":{\"description\":\"The maximum file size allowed in megabytes. This limit does not apply to Git Large File Storage (Git LFS).\",\"maximum\":100,\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"max_file_size\"],\"type\":\"object\"},\"type\":{\"enum\":[\"max_file_size\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"max_file_size\",\"type\":\"object\"},{\"description\":\"Require all changes made to a targeted branch to pass the specified workflows before they can be merged.\",\"properties\":{\"parameters\":{\"properties\":{\"do_not_enforce_on_create\":{\"description\":\"Allow repositories and branches to be created if a check would otherwise prohibit it.\",\"type\":\"boolean\"},\"workflows\":{\"description\":\"Workflows that must pass for this rule to pass.\",\"items\":{\"description\":\"A workflow that must run for this rule to pass\",\"properties\":{\"path\":{\"description\":\"The path to the workflow file\",\"type\":\"string\"},\"ref\":{\"description\":\"The ref (branch or tag) of the workflow file to use\",\"type\":\"string\"},\"repository_id\":{\"description\":\"The ID of the repository where the workflow is defined\",\"type\":\"integer\"},\"sha\":{\"description\":\"The commit SHA of the workflow file to use\",\"type\":\"string\"}},\"required\":[\"path\",\"repository_id\"],\"title\":\"WorkflowFileReference\",\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"workflows\"],\"type\":\"object\"},\"type\":{\"enum\":[\"workflows\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"workflows\",\"type\":\"object\"},{\"description\":\"Choose which tools must provide code scanning results before the reference is updated. When configured, code scanning must be enabled and have results for both the commit and the reference being updated.\",\"properties\":{\"parameters\":{\"properties\":{\"code_scanning_tools\":{\"description\":\"Tools that must provide code scanning results for this rule to pass.\",\"items\":{\"description\":\"A tool that must provide code scanning results for this rule to pass.\",\"properties\":{\"alerts_threshold\":{\"description\":\"The severity level at which code scanning results that raise alerts block a reference update. For more information on alert severity levels, see \\\"[About code scanning alerts](https://docs.github.com/code-security/code-scanning/managing-code-scanning-alerts/about-code-scanning-alerts#about-alert-severity-and-security-severity-levels).\\\"\",\"enum\":[\"none\",\"errors\",\"errors_and_warnings\",\"all\"],\"type\":\"string\"},\"security_alerts_threshold\":{\"description\":\"The severity level at which code scanning results that raise security alerts block a reference update. For more information on security severity levels, see \\\"[About code scanning alerts](https://docs.github.com/code-security/code-scanning/managing-code-scanning-alerts/about-code-scanning-alerts#about-alert-severity-and-security-severity-levels).\\\"\",\"enum\":[\"none\",\"critical\",\"high_or_higher\",\"medium_or_higher\",\"all\"],\"type\":\"string\"},\"tool\":{\"description\":\"The name of a code scanning tool\",\"type\":\"string\"}},\"required\":[\"alerts_threshold\",\"security_alerts_threshold\",\"tool\"],\"title\":\"CodeScanningTool\",\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"code_scanning_tools\"],\"type\":\"object\"},\"type\":{\"enum\":[\"code_scanning\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"code_scanning\",\"type\":\"object\"},{\"description\":\"Request Copilot code review for new pull requests automatically if the author has access to Copilot code review.\",\"properties\":{\"parameters\":{\"properties\":{\"review_draft_pull_requests\":{\"description\":\"Copilot automatically reviews draft pull requests before they are marked as ready for review.\",\"type\":\"boolean\"},\"review_on_push\":{\"description\":\"Copilot automatically reviews each new push to the pull request.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"type\":{\"enum\":[\"copilot_code_review\"],\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"copilot_code_review\",\"type\":\"object\"}],\"title\":\"Repository Rule\",\"type\":\"object\"},\"type\":\"array\"},\"source\":{\"description\":\"The name of the source\",\"type\":\"string\"},\"source_type\":{\"description\":\"The type of the source of the ruleset\",\"enum\":[\"Repository\",\"Organization\",\"Enterprise\"],\"type\":\"string\"},\"target\":{\"description\":\"The target of the ruleset\",\"enum\":[\"branch\",\"tag\",\"push\",\"repository\"],\"type\":\"string\"},\"updated_at\":{\"format\":\"date-time\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"source\",\"enforcement\"],\"title\":\"Repository ruleset\",\"type\":\"object\"}}},\"description\":\"Response\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Resource not found\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Internal Error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "PUT"
          orig: "/orgs/{org}/rulesets/{ruleset_id}"
          rename: {
            param: {
              org: "org_id"
              ruleset_id: "id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "rulesets"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
