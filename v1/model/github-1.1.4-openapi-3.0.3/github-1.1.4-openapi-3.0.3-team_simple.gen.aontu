# Entity: team_simple

main: kit: entity: team_simple: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: true
      short: "Description of the team"
      type: "`$STRING`"
    }
    {
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "Unique identifier of the team"
      type: "`$INTEGER`"
    }
    {
      name: "ldap_dn"
      req: false
      short: "Distinguished Name (DN) that team maps to within LDAP environment"
      type: "`$STRING`"
    }
    {
      name: "members_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "Name of the team"
      type: "`$STRING`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "notification_setting"
      req: false
      short: "The notification setting the team has set"
      type: "`$STRING`"
    }
    {
      name: "permission"
      req: true
      short: "Permission that the team will have for its repositories"
      type: "`$STRING`"
    }
    {
      name: "privacy"
      req: false
      short: "The level of privacy this team should have"
      type: "`$STRING`"
    }
    {
      name: "repositories_url"
      req: true
      type: "`$STRING`"
    }
    {
