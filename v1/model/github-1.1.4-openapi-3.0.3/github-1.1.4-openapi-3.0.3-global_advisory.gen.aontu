# Entity: global_advisory

main: kit: entity: global_advisory: {

  alias: field: {}

  fields: {
    credits: {
      h: "Credits"
      n: "credits"
      r: true
      ro: true
      sh: "The users who contributed to the advisory."
      t: "`$ARRAY`"
    }
    cve_id: {
      h: "Cve Id"
      n: "cve_id"
      r: true
      ro: true
      sh: "The Common Vulnerabilities and Exposures (CVE) ID."
      t: "`$STRING`"
    }
    cvss: {
      h: "Cvss"
      n: "cvss"
      r: true
      t: "`$OBJECT`"
    }
    cvss_severities: {
      h: "Cvss Severities"
      n: "cvss_severities"
      r: false
      t: "`$OBJECT`"
    }
    cwes: {
      h: "Cwes"
      n: "cwes"
      r: true
      t: "`$ARRAY`"
    }
    description: {
      h: "Description"
      n: "description"
      r: true
      sh: "A detailed description of what the advisory entails."
      t: "`$STRING`"
    }
    epss: {
      h: "Epss"
      n: "epss"
      r: false
      ro: true
      sh: "The EPSS scores as calculated by the [Exploit Prediction Scoring System](https://www.first.org/epss)."
      t: "`$OBJECT`"
    }
    ghsa_id: {
      h: "Ghsa Id"
      n: "ghsa_id"
      r: true
      ro: true
      sh: "The GitHub Security Advisory ID."
      t: "`$STRING`"
    }
    github_reviewed_at: {
      fo: "date-time"
      h: "Github Reviewed At"
      n: "github_reviewed_at"
      r: true
      ro: true
      sh: "The date and time of when the advisory was reviewed by GitHub, in ISO 8601 format."
      t: "`$STRING`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      ro: true
      sh: "The URL for the advisory."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    identifiers: {
      h: "Identifiers"
      n: "identifiers"
      r: true
      ro: true
      t: "`$ARRAY`"
    }
    nvd_published_at: {
      fo: "date-time"
      h: "Nvd Published At"
      n: "nvd_published_at"
      r: true
      ro: true
      sh: "The date and time when the advisory was published in the National Vulnerability Database, in ISO 8601 format."
      t: "`$STRING`"
    }
    published_at: {
      fo: "date-time"
      h: "Published At"
      n: "published_at"
      r: true
      ro: true
      sh: "The date and time of when the advisory was published, in ISO 8601 format."
      t: "`$STRING`"
    }
    references: {
      h: "References"
      n: "references"
      r: true
      t: "`$ARRAY`"
    }
    repository_advisory_url: {
      fo: "uri"
      h: "Repository Advisory Url"
      n: "repository_advisory_url"
      r: true
      ro: true
      sh: "The API URL for the repository advisory."
      t: "`$STRING`"
    }
    severity: {
      h: "Severity"
      n: "severity"
      r: true
      sh: "The severity of the advisory."
      t: "`$STRING`"
    }
    source_code_location: {
      fo: "uri"
      h: "Source Code Location"
      n: "source_code_location"
      r: true
      sh: "The URL of the advisory's source code."
      t: "`$STRING`"
    }
    summary: {
      h: "Summary"
      n: "summary"
      r: true
      sh: "A short summary of the advisory."
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      ro: true
      sh: "The type of advisory."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      ro: true
      sh: "The date and time of when the advisory was last updated, in ISO 8601 format."
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      ro: true
      sh: "The API URL for the advisory."
      t: "`$STRING`"
    }
    vulnerabilities: {
      h: "Vulnerabilities"
      n: "vulnerabilities"
      r: true
      sh: "The products and respective version ranges affected by the advisory."
      t: "`$ARRAY`"
    }
    withdrawn_at: {
      fo: "date-time"
      h: "Withdrawn At"
      n: "withdrawn_at"
      r: true
      ro: true
      sh: "The date and time of when the advisory was withdrawn, in ISO 8601 format."
      t: "`$STRING`"
    }
  }

  id: {
