            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "import"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
