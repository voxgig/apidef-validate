            version: 2
          }
          method: "PATCH"
          orig: "/repos/{owner}/{repo}/import/lfs"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "import"
            }
            {
              lit: "lfs"
            }
          ]
          select: {
            "$action": "lfs"
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
