              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/automated-security-fixes"
            json: "{\"operationId\":\"repos/check-automated-security-fixes\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"enabled\":true,\"paused\":false}}},\"schema\":{\"description\":\"Check Dependabot security updates\",\"properties\":{\"enabled\":{\"description\":\"Whether Dependabot security updates are enabled for the repository.\",\"example\":true,\"type\":\"boolean\"},\"paused\":{\"description\":\"Whether Dependabot security updates are paused for the repository.\",\"example\":false,\"type\":\"boolean\"}},\"required\":[\"enabled\",\"paused\"],\"title\":\"Check Dependabot security updates\",\"type\":\"object\"}}},\"description\":\"Response if Dependabot is enabled\"},\"404\":{\"description\":\"Not Found if Dependabot is not enabled for the repository\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/automated-security-fixes"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
