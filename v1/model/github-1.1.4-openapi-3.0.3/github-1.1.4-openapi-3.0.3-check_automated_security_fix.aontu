# Entity: check_automated_security_fix

main: kit: entity: check_automated_security_fix: {

  alias: field: {}

  fields: {
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: true
      sh: "Whether Dependabot security updates are enabled for the repository."
      t: "`$BOOLEAN`"
    }
    paused: {
      h: "Paused"
      n: "paused"
      r: true
      sh: "Whether Dependabot security updates are paused for the repository."
      t: "`$BOOLEAN`"
    }
  }

  name: "check_automated_security_fix"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/automated-security-fixes"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/automated-security-fixes"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "automated-security-fixes"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}