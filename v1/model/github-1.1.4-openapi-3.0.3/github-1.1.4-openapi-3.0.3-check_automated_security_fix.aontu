# Entity: check_automated_security_fix

main: kit: entity: check_automated_security_fix: {

  alias: field: {}

  fields: [
    {
      name: "enabled"
      req: true
      short: "Whether Dependabot security updates are enabled for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "paused"
      req: true
      short: "Whether Dependabot security updates are paused for the repository."
      type: "`$BOOLEAN`"
    }
  ]

  name: "check_automated_security_fix"
  op: {
    load: {
      name: "load"
      points: [
