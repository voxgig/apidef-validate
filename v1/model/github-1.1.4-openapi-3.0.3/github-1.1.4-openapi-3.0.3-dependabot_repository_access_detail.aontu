  id: {
    field: "id"
    name: "id"
  }

  name: "dependabot_repository_access_detail"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /organizations/{org}/dependabot/repository-access"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/organizations/{org}/dependabot/repository-access"
          segments: [
            {
              lit: "organizations"
            }
            {
              var: "org"
            }
            {
              lit: "dependabot"
            }
            {
              lit: "repository-access"
            }
          ]
          select: {
            exist: [
              "org"
              "page"
              "per_page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.accessible_repositories`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "organization"
      ]
    ]
