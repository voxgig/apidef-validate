# Entity: code_scanning_variant_analysi

main: kit: entity: code_scanning_variant_analysi: {

  alias: field: {}

  fields: [
    {
      name: "actions_workflow_run_id"
      req: false
      short: "The GitHub Actions workflow run used to execute this variant analysis."
      type: "`$INTEGER`"
    }
    {
      name: "actor"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      format: "date-time"
      name: "completed_at"
      req: false
      short: "The date and time at which the variant analysis was completed, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
    {
      name: "controller_repo"
      req: true
      short: "A GitHub repository."
      type: "`$OBJECT`"
    }
    {
      format: "date-time"
      name: "created_at"
      req: false
      short: "The date and time at which the variant analysis was created, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
    {
      name: "failure_reason"
      req: false
      short: "The reason for a failure of the variant analysis."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The ID of the variant analysis."
      type: "`$INTEGER`"
    }
    {
      name: "language"
      req: true
      short: "The language targeted by the CodeQL query"
      type: "`$STRING`"
    }
    {
      name: "query_language"
      req: true
      short: "The language targeted by the CodeQL query"
      type: "`$STRING`"
    }
    {
      name: "query_pack"
      req: true
      short: "A Base64-encoded tarball containing a CodeQL query and all its dependencies"
      type: "`$STRING`"
    }
    {
      name: "query_pack_url"
      req: true
      short: "The download url for the query pack."
      type: "`$STRING`"
    }
    {
      name: "repositories"
      req: false
      short: "List of repository names (in the form `owner/repo-name`) to run the query against."
      type: "`$ARRAY`"
    }
    {
      name: "repository_lists"
      req: false
      short: "List of repository lists to run the query against."
      type: "`$ARRAY`"
    }
    {
      name: "repository_owners"
      req: false
      short: "List of organization or user names whose repositories the query should be run against."
      type: "`$ARRAY`"
    }
    {
      name: "scanned_repositories"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "skipped_repositories"
      req: true
      short: "Information about repositories that were skipped from processing."
      type: "`$OBJECT`"
    }
    {
      name: "status"
      req: true
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "updated_at"
      req: false
      short: "The date and time at which the variant analysis was last updated, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "code_scanning_variant_analysi"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /repos/{owner}/{repo}/code-scanning/codeql/variant-analyses"
            json: "{\"operationId\":\"code-scanning/create-variant-analysis\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"repositories_parameter\":{\"summary\":\"Using the \\\"repositories\\\" field. \\\"query_pack\\\" is abridged for brevity.\",\"value\":{\"language\":\"csharp\",\"query_pack\":\"aGVsbG8=\",\"repositories\":[\"octocat/Hello-World\",\"octocat/example\"]}},\"repository_lists\":{\"summary\":\"Using the \\\"repository_lists\\\" field. \\\"query_pack\\\" is abridged.\",\"value\":{\"language\":\"csharp\",\"query_pack\":\"aGVsbG8=\",\"repository_lists\":[\"top-100-csharp\"]}},\"repository_owners\":{\"summary\":\"Using the \\\"repository_owners\\\" field. \\\"query_pack\\\" is abridged.\",\"value\":{\"language\":\"csharp\",\"query_pack\":\"aGVsbG8=\",\"repository_owners\":[\"octocat\"]}}},\"schema\":{\"additionalProperties\":false,\"oneOf\":[{\"required\":[\"repositories\"]},{\"required\":[\"repository_lists\"]},{\"required\":[\"repository_owners\"]}],\"properties\":{\"language\":{\"description\":\"The language targeted by the CodeQL query\",\"enum\":[\"cpp\",\"csharp\",\"go\",\"java\",\"javascript\",\"python\",\"ruby\",\"rust\",\"swift\"],\"type\":\"string\"},\"query_pack\":{\"description\":\"A Base64-encoded tarball containing a CodeQL query and all its dependencies\",\"type\":\"string\"},\"repositories\":{\"description\":\"List of repository names (in the form `owner/repo-name`) to run the query against. Precisely one property from `repositories`, `repository_lists` and `repository_owners` is required.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"repository_lists\":{\"description\":\"List of repository lists to run the query against. Precisely one property from `repositories`, `repository_lists` and `repository_owners` is required.\",\"items\":{\"type\":\"string\"},\"maxItems\":1,\"type\":\"array\"},\"repository_owners\":{\"description\":\"List of organization or user names whose repositories the query should be run against. Precisely one property from `repositories`, `repository_lists` and `repository_owners` is required.\",\"items\":{\"type\":\"string\"},\"maxItems\":1,\"type\":\"array\"}},\"required\":[\"language\",\"query_pack\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"repositories_parameter\":{\"summary\":\"Response for a successful variant analysis submission\",\"value\":{\"summary\":\"Default response\",\"value\":{\"actions_workflow_run_id\":3453588,\"actor\":{\"avatar_url\":\"https://github.com/images/error/octocat_happy.gif\",\"events_url\":\"https://api.github.com/users/octocat/events{/privacy}\",\"followers_url\":\"https://api.github.com/users/octocat/followers\",\"following_url\":\"https://api.github.com/users/octocat/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/octocat/gists{/gist_id}\",\"gravatar_id\":\"\",\"html_url\":\"https://github.com/octocat\",\"id\":1,\"login\":\"octocat\",\"node_id\":\"MDQ6VXNlcjE=\",\"organizations_url\":\"https://api.github.com/users/octocat/orgs\",\"received_events_url\":\"https://api.github.com/users/octocat/received_events\",\"repos_url\":\"https://api.github.com/users/octocat/repos\",\"site_admin\":false,\"starred_url\":\"https://api.github.com/users/octocat/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/octocat/subscriptions\",\"type\":\"User\",\"url\":\"https://api.github.com/users/octocat\"},\"completed_at\":\"2022-09-12T13:15:33Z\",\"controller_repo\":{\"archive_url\":\"https://api.github.com/repos