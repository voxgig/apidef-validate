          contract: {
            id: "POST /repos/{owner}/{repo}/environments/{environment_name}/deployment-branch-policies"
            json: "{\"operationId\":\"repos/create-deployment-branch-policy\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the environment. The name must be URL encoded. For example, any slashes in the name must be replaced with `%2F`.\",\"in\":\"path\",\"name\":\"environment_name\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"example-single-branch\":{\"summary\":\"Example of a single branch name pattern\",\"value\":{\"name\":\"main\",\"type\":\"branch\"}},\"example-single-tag\":{\"summary\":\"Example of a single tag name pattern\",\"value\":{\"name\":\"v1\",\"type\":\"tag\"}},\"example-wildcard\":{\"summary\":\"Example of a wildcard name pattern\",\"value\":{\"name\":\"release/*\"}}},\"schema\":{\"properties\":{\"name\":{\"description\":\"The name pattern that branches or tags must match in order to deploy to the environment.\\n\\nWildcard characters will not match `/`. For example, to match branches that begin with `release/` and contain an additional single slash, use `release/*/*`.\\nFor more information about pattern matching syntax, see the [Ruby File.fnmatch documentation](https://ruby-doc.org/core-2.5.1/File.html#method-c-fnmatch).\",\"example\":\"release/*\",\"type\":\"string\"},\"type\":{\"description\":\"Whether this rule targets a branch or tag\",\"enum\":[\"branch\",\"tag\"],\"example\":\"branch\",\"type\":\"string\"}},\"required\":[\"name\"],\"title\":\"Deployment branch and tag policy name pattern\",\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"example-single-branch\":{\"value\":{\"id\":364663,\"name\":\"main\",\"node_id\":\"MDE2OkdhdGVCcmFuY2hQb2xpY3kzNjQ2NjM=\"}},\"example-single-tag\":{\"value\":{\"id\":364663,\"name\":\"v1\",\"node_id\":\"MDE2OkdhdGVCcmFuY2hQb2xpY3kzNjQ2NjM=\",\"type\":\"tag\"}},\"example-wildcard\":{\"value\":{\"id\":364662,\"name\":\"release/*\",\"node_id\":\"MDE2OkdhdGVCcmFuY2hQb2xpY3kzNjQ2NjI=\"}}},\"schema\":{\"description\":\"Details of a deployment branch or tag policy.\",\"properties\":{\"id\":{\"description\":\"The unique identifier of the branch or tag policy.\",\"example\":361471,\"type\":\"integer\"},\"name\":{\"description\":\"The name pattern that branches or tags must match in order to deploy to the environment.\",\"example\":\"release/*\",\"type\":\"string\"},\"node_id\":{\"example\":\"MDE2OkdhdGVCcmFuY2hQb2xpY3kzNjE0NzE=\",\"type\":\"string\"},\"type\":{\"description\":\"Whether this rule targets a branch or tag.\",\"enum\":[\"branch\",\"tag\"],\"example\":\"branch\",\"type\":\"string\"}},\"title\":\"Deployment branch policy\",\"type\":\"object\"}}},\"description\":\"Response\"},\"303\":{\"description\":\"Response if the same branch name pattern already exists\"},\"404\":{\"description\":\"Not Found or `deployment_branch_policy.custom_branch_policies` property for the environment is set to false\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/environments/{environment_name}/deployment-branch-policies"
          segments: [
