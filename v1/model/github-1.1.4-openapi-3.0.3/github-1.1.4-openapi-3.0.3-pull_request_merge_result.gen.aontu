# Entity: pull_request_merge_result

main: kit: entity: pull_request_merge_result: {

  alias: field: {}

  fields: [
    {
      name: "commit_message"
      req: false
      short: "Extra detail to append to automatic commit message."
      type: "`$STRING`"
    }
    {
      name: "commit_title"
      req: false
      short: "Title for the automatic commit message."
      type: "`$STRING`"
    }
    {
      name: "merge_method"
      req: false
      short: "The merge method to use."
      type: "`$STRING`"
    }
    {
      name: "merged"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "message"
      req: true
      type: "`$STRING`"
    }
    {
      name: "sha"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "SHA that pull request head must match to allow merge."
      type: "`$STRING`"
    }
  ]

  name: "pull_request_merge_result"
  op: {
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "pull_number"
                orig: "pull_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PUT"
          orig: "/repos/{owner}/{repo}/pulls/{pull_number}/merge"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "pulls"
            }
            {
              var: "pull_number"
            }
            {
              lit: "merge"
            }
          ]
          select: {
            exist: [
              "owner"
              "pull_number"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "pull"
      ]
    ]
  }



}