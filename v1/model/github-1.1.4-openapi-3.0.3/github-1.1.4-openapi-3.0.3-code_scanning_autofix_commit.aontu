# Entity: code_scanning_autofix_commit

main: kit: entity: code_scanning_autofix_commit: {

  alias: field: {}

  fields: {
    message: {
      h: "Message"
      n: "message"
      r: false
      sh: "Commit message to be used."
      t: "`$STRING`"
    }
    target_ref: {
      h: "Target Ref"
      n: "target_ref"
      r: false
      sh: "The Git reference of target branch for the commit."
      t: "`$STRING`"
    }
  }

  name: "code_scanning_autofix_commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "alert_id"
                orig: "alert_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /repos/{owner}/{repo}/code-scanning/alerts/{alert_number}/autofix/commits"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/code-scanning/alerts/{alert_number}/autofix/commits"
          rename: {
            param: {
              alert_number: "alert_id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "alerts"
            }
            {
              var: "alert_id"
            }
            {
              lit: "autofix"
            }
            {
              lit: "commits"
            }
          ]
          select: {
            exist: [
              "alert_id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "alert"
      ]
    ]
  }



}