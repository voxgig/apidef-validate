          contract: {
            id: "GET /assignments/{assignment_id}/accepted_assignments"
            json: "{\"operationId\":\"classroom/list-accepted-assignments-for-an-assignment\",\"parameters\":[{\"description\":\"The unique identifier of the classroom assignment.\",\"in\":\"path\",\"name\":\"assignment_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"description\":\"The page number of the results to fetch. For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"page\",\"schema\":{\"default\":1,\"type\":\"integer\"}},{\"description\":\"The number of results per page (max 100). For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"per_page\",\"schema\":{\"default\":30,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"assignment\":{\"accepted\":100,\"classroom\":{\"archived\":\"false,\",\"id\":1296269,\"name\":\"Programming Elixir\",\"url\":\"https://classroom.github.com/classrooms/1-programming-elixir\"},\"editor\":\"codespaces\",\"feedback_pull_requests_enabled\":true,\"id\":\"12,\",\"invitations_enabled\":\"true,\",\"invite_link\":\"https://classroom.github.com/a/Lx7jiUgx\",\"language\":\"ruby\",\"max_members\":0,\"max_teams\":0,\"passing\":10,\"public_repo\":\"false,\",\"slug\":\"intro-to-binaries\",\"students_are_repo_admins\":false,\"submitted\":40,\"title\":\"Intro to Binaries\",\"type\":\"individual\"},\"commit_count\":5,\"grade\":\"5/10\",\"id\":\"12,\",\"passing\":\"false,\",\"repository\":{\"default_branch\":\"main\",\"full_name\":\"octocat/Hello-World\",\"html_url\":\"https://github.com/octocat/Hello-World\",\"id\":1296269,\"node_id\":\"MDEwOlJlcG9zaXRvcnkxMjk2MjY5\",\"private\":false},\"students\":[{\"avatar_url\":\"https://github.com/images/error/octocat_happy.gif\",\"html_url\":\"https://github.com/octocat\",\"id\":1,\"login\":\"octocat\"}],\"submitted\":\"false,\"}}},\"schema\":{\"items\":{\"description\":\"A GitHub Classroom accepted assignment\",\"properties\":{\"assignment\":{\"description\":\"A GitHub Classroom assignment\",\"properties\":{\"accepted\":{\"description\":\"The number of students that have accepted the assignment.\",\"example\":25,\"type\":\"integer\"},\"classroom\":{\"description\":\"A GitHub Classroom classroom\",\"properties\":{\"archived\":{\"description\":\"Returns whether classroom is archived or not.\",\"example\":false,\"type\":\"boolean\"},\"id\":{\"description\":\"Unique identifier of the classroom.\",\"example\":42,\"type\":\"integer\"},\"name\":{\"description\":\"The name of the classroom.\",\"example\":\"Programming Elixir\",\"type\":\"string\"},\"url\":{\"description\":\"The url of the classroom on GitHub Classroom.\",\"example\":\"https://classroom.github.com/classrooms/1-programming-elixir\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"archived\",\"url\"],\"title\":\"Simple Classroom\",\"type\":\"object\"},\"deadline\":{\"description\":\"The time at which the assignment is due.\",\"example\":\"2011-01-26T19:06:43Z\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"editor\":{\"description\":\"The selected editor for the assignment.\",\"example\":\"codespaces\",\"type\":\"string\"},\"feedback_pull_requests_enabled\":{\"description\":\"Whether feedback pull request will be created on assignment acceptance.\",\"example\":true,\"type\":\"boolean\"},\"id\":{\"description\":\"Unique identifier of the repository.\",\"example\":42,\"type\":\"integer\"},\"invitations_enabled\":{\"description\":\"Whether the invitation link is enabled. Visiting an enabled invitation link will accept the assignment.\",\"example\":true,\"type\":\"boolean\"},\"invite_link\":{\"description\":\"The link that a student can use to accept the assignment.\",\"example\":\"https://classroom.github.com/a/Lx7jiUgx\",\"type\":\"string\"},\"language\":{\"description\":\"The programming language used in the assignment.\",\"example\":\"elixir\",\"type\":\"string\"},\"max_members\":{\"description\":\"The maximum allowable members per team.\",\"example\":0,\"nullable\":true,\"type\":\"integer\"},\"max_teams\":{\"description\":\"The maximum allowable teams for the assignment.\",\"example\":0,\"nullable\":true,\"type\":\"integer\"},\"passing\":{\"description\":\"The number of students that have passed the assignment.\",\"example\":10,\"type\":\"integer\"},\"public_repo\":{\"description\":\"Whether an accepted assignment creates a public repository.\",\"example\":true,\"type\":\"boolean\"},\"slug\":{\"description\":\"Sluggified name of the assignment.\",\"example\":\"intro-to-binaries\",\"type\":\"string\"},\"students_are_repo_admins\":{\"description\":\"Whether students are admins on created repository on accepted assignment.\",\"example\":true,\"type\":\"boolean\"},\"submitted\":{\"description\":\"The number of students that have submitted the assignment.\",\"example\":10,\"type\":\"integer\"},\"title\":{\"description\":\"Assignment title.\",\"example\":\"Intro to Binaries\",\"type\":\"string\"},\"type\":{\"description\":\"Whether it's a Group Assignment or Individual Assignment.\",\"enum\":[\"individual\",\"group\"],\"example\":\"individual\",\"type\":\"string\"}},\"required\":[\"id\",\"public_repo\",\"title\",\"type\",\"invite_link\",\"invitations_enabled\",\"slug\",\"students_are_repo_admins\",\"feedback_pull_requests_enabled\",\"editor\",\"accepted\",\"submitted\",\"passing\",\"language\",\"deadline\",\"classroom\"],\"title\":\"Simple Classroom Assignment\",\"type\":\"object\"},\"commit_count\":{\"description\":\"Count of student commits.\",\"example\":5,\"type\":\"integer\"},\"grade\":{\"description\":\"Most recent grade.\",\"example\":\"10/10\",\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier of the repository.\",\"example\":42,\"type\":\"integer\"},\"passing\":{\"description\":\"Whether a submission passed.\",\"example\":true,\"type\":\"boolean\"},\"repository\":{\"description\":\"A GitHub repository view for Classroom\",\"properties\":{\"default_branch\":{\"description\":\"The default branch for the repository.\",\"example\":\"main\",\"type\":\"string\"},\"full_name\":{\"description\":\"The full, globally unique name of the repository.\",\"example\":\"octocat/Hello-World\",\"type\":\"string\"},\"html_url\":{\"description\":\"The URL to view the repository on GitHub.com.\",\"example\":\"https://github.com/octocat/Hello-World\",\"format\":\"uri\",\"type\":\"string\"},\"id\":{\"description\":\"A unique identifier of the repository.\",\"example\":1296269,\"type\":\"integer\"},\"node_id\":{\"description\":\"The GraphQL identifier of the repository.\",\"example\":\"MDEwOlJlcG9zaXRvcnkxMjk2MjY5\",\"type\":\"string\"},\"private\":{\"description\":\"Whether the repository is private.\",\"type\":\"boolean\"}},\"required\":[\"id\",\"full_name\",\"html_url\",\"node_id\",\"private\",\"default_branch\"],\"title\":\"Simple Classroom Repository\",\"type\":\"object\"},\"students\":{\"items\":{\"description\":\"A GitHub user simplified for Classroom.\",\"properties\":{\"avatar_url\":{\"example\":\"https://github.com/images/error/octocat_happy.gif\",\"format\":\"uri\",\"type\":\"string\"},\"html_url\":{\"example\":\"https://github.com/octocat\",\"format\":\"uri\",\"type\":\"string\"},\"id\":{\"example\":1,\"type\":\"integer\"},\"login\":{\"example\":\"octocat\",\"type\":\"string\"}},\"required\":[\"id\",\"login\",\"avatar_url\",\"html_url\"],\"title\":\"Simple Classroom User\",\"type\":\"object\"},\"type\":\"array\"},\"submitted\":{\"description\":\"Whether an accepted assignment has been submitted.\",\"example\":true,\"type\":\"boolean\"}},\"required\":[\"id\",\"submitted\",\"passing\",\"commit_count\",\"grade\",\"students\",\"repository\",\"assignment\"],\"title\":\"Classroom Accepted Assignment\",\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
