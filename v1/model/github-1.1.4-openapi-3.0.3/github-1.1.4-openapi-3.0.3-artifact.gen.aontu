# Entity: artifact

main: kit: entity: artifact: {

  alias: field: {}

  fields: {
    head_branch: {
      h: "Head Branch"
      n: "head_branch"
      r: false
      t: "`$STRING`"
    }
    head_repository_id: {
      h: "Head Repository Id"
      n: "head_repository_id"
      r: false
      t: "`$INTEGER`"
    }
    head_sha: {
      h: "Head Sha"
      n: "head_sha"
      r: false
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$INTEGER`"
    }
    repository_id: {
      h: "Repository Id"
      n: "repository_id"
      r: false
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "artifact"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/actions/artifacts/{artifact_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "artifact_id"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/actions/artifacts/{artifact_id}"
          q: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          r: {
            param: {
              artifact_id: "id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "artifacts"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.workflow_run`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}