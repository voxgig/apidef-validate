              }
              {
                k: "query"
                n: "before"
                or: "before"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "desc"
                k: "query"
                n: "direction"
                or: "direction"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "ref"
                or: "ref"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "time_period"
                or: "time_period"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/activity"
          q: {
            exist: [
              "activity_type"
              "actor"
              "after"
              "before"
              "direction"
              "owner"
              "per_page"
              "ref"
              "repo"
              "time_period"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "activity"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
