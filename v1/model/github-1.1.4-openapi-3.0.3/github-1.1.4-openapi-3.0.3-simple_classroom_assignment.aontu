            json: "{\"operationId\":\"classroom/list-assignments-for-a-classroom\",\"parameters\":[{\"description\":\"The unique identifier of the classroom.\",\"in\":\"path\",\"name\":\"classroom_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"description\":\"The page number of the results to fetch. For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"page\",\"schema\":{\"default\":1,\"type\":\"integer\"}},{\"description\":\"The number of results per page (max 100). For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"per_page\",\"schema\":{\"default\":30,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"accepted\":100,\"classroom\":{\"archived\":\"false,\",\"id\":1296269,\"name\":\"Programming Elixir\",\"url\":\"https://classroom.github.com/classrooms/1-programming-elixir\"},\"deadline\":\"2020-01-11T11:59:22Z\",\"editor\":\"codespaces\",\"feedback_pull_requests_enabled\":true,\"id\":\"12,\",\"invitations_enabled\":\"true,\",\"invite_link\":\"https://classroom.github.com/a/Lx7jiUgx\",\"language\":\"ruby\",\"max_members\":0,\"max_teams\":0,\"passing\":10,\"public_repo\":\"false,\",\"slug\":\"intro-to-binaries\",\"students_are_repo_admins\":false,\"submitted\":40,\"title\":\"Intro to Binaries\",\"type\":\"individual\"}}},\"schema\":{\"items\":{\"description\":\"A GitHub Classroom assignment\",\"properties\":{\"accepted\":{\"description\":\"The number of students that have accepted the assignment.\",\"example\":25,\"type\":\"integer\"},\"classroom\":{\"description\":\"A GitHub Classroom classroom\",\"properties\":{\"archived\":{\"description\":\"Returns whether classroom is archived or not.\",\"example\":false,\"type\":\"boolean\"},\"id\":{\"description\":\"Unique identifier of the classroom.\",\"example\":42,\"type\":\"integer\"},\"name\":{\"description\":\"The name of the classroom.\",\"example\":\"Programming Elixir\",\"type\":\"string\"},\"url\":{\"description\":\"The url of the classroom on GitHub Classroom.\",\"example\":\"https://classroom.github.com/classrooms/1-programming-elixir\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"archived\",\"url\"],\"title\":\"Simple Classroom\",\"type\":\"object\"},\"deadline\":{\"description\":\"The time at which the assignment is due.\",\"example\":\"2011-01-26T19:06:43Z\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"editor\":{\"description\":\"The selected editor for the assignment.\",\"example\":\"codespaces\",\"type\":\"string\"},\"feedback_pull_requests_enabled\":{\"description\":\"Whether feedback pull request will be created on assignment acceptance.\",\"example\":true,\"type\":\"boolean\"},\"id\":{\"description\":\"Unique identifier of the repository.\",\"example\":42,\"type\":\"integer\"},\"invitations_enabled\":{\"description\":\"Whether the invitation link is enabled. Visiting an enabled invitation link will accept the assignment.\",\"example\":true,\"type\":\"boolean\"},\"invite_link\":{\"description\":\"The link that a student can use to accept the assignment.\",\"example\":\"https://classroom.github.com/a/Lx7jiUgx\",\"type\":\"string\"},\"language\":{\"description\":\"The programming language used in the assignment.\",\"example\":\"elixir\",\"type\":\"string\"},\"max_members\":{\"description\":\"The maximum allowable members per team.\",\"example\":0,\"nullable\":true,\"type\":\"integer\"},\"max_teams\":{\"description\":\"The maximum allowable teams for the assignment.\",\"example\":0,\"nullable\":true,\"type\":\"integer\"},\"passing\":{\"description\":\"The number of students that have passed the assignment.\",\"example\":10,\"type\":\"integer\"},\"public_repo\":{\"description\":\"Whether an accepted assignment creates a public repository.\",\"example\":true,\"type\":\"boolean\"},\"slug\":{\"description\":\"Sluggified name of the assignment.\",\"example\":\"intro-to-binaries\",\"type\":\"string\"},\"students_are_repo_admins\":{\"description\":\"Whether students are admins on created repository on accepted assignment.\",\"example\":true,\"type\":\"boolean\"},\"submitted\":{\"description\":\"The number of students that have submitted the assignment.\",\"example\":10,\"type\":\"integer\"},\"title\":{\"description\":\"Assignment title.\",\"example\":\"Intro to Binaries\",\"type\":\"string\"},\"type\":{\"description\":\"Whether it's a Group Assignment or Individual Assignment.\",\"enum\":[\"individual\",\"group\"],\"example\":\"individual\",\"type\":\"string\"}},\"required\":[\"id\",\"public_repo\",\"title\",\"type\",\"invite_link\",\"invitations_enabled\",\"slug\",\"students_are_repo_admins\",\"feedback_pull_requests_enabled\",\"editor\",\"accepted\",\"submitted\",\"passing\",\"language\",\"deadline\",\"classroom\"],\"title\":\"Simple Classroom Assignment\",\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
