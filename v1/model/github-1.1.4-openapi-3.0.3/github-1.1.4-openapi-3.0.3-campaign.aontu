                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /orgs/{org}/campaigns"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/orgs/{org}/campaigns"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "campaigns"
            }
          ]
          select: {
            exist: [
              "direction"
              "org_id"
              "page"
              "per_page"
              "sort"
              "state"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "campaign_number"
