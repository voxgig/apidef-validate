            json: "{\"operationId\":\"campaigns/create-campaign\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"code_scanning_alerts\":[{\"alert_numbers\":[1,2],\"repository_id\":1296269}],\"description\":\"Address critical alerts before they are exploited to prevent breaches, protect sensitive data, and mitigate financial and reputational damage.\",\"ends_at\":\"2024-03-14T00:00:00Z\",\"managers\":[\"octocat\"],\"name\":\"Critical CodeQL alerts\"}}},\"schema\":{\"additionalProperties\":false,\"properties\":{\"code_scanning_alerts\":{\"description\":\"The code scanning alerts to include in this campaign\",\"items\":{\"additionalProperties\":false,\"properties\":{\"alert_numbers\":{\"description\":\"The alert numbers\",\"items\":{\"type\":\"integer\"},\"minItems\":1,\"type\":\"array\"},\"repository_id\":{\"description\":\"The repository id\",\"type\":\"integer\"}},\"required\":[\"repository_id\",\"alert_numbers\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"},\"contact_link\":{\"description\":\"The contact link of the campaign. Must be a URI.\",\"format\":\"uri\",\"nullable\":true,\"type\":\"string\"},\"description\":{\"description\":\"A description for the campaign\",\"maxLength\":255,\"minLength\":1,\"type\":\"string\"},\"ends_at\":{\"description\":\"The end date and time of the campaign. The date must be in the future.\",\"format\":\"date-time\",\"type\":\"string\"},\"generate_issues\":{\"default\":false,\"description\":\"If true, will automatically generate issues for the campaign. The default is false.\",\"type\":\"boolean\"},\"managers\":{\"description\":\"The logins of the users to set as the campaign managers. At this time, only a single manager can be supplied.\",\"items\":{\"description\":\"The login of each manager\",\"type\":\"string\"},\"maxItems\":10,\"type\":\"array\"},\"name\":{\"description\":\"The name of the campaign\",\"maxLength\":50,\"minLength\":1,\"type\":\"string\"},\"team_managers\":{\"description\":\"The slugs of the teams to set as the campaign managers.\",\"items\":{\"description\":\"The slug of each team\",\"type\":\"string\"},\"maxItems\":10,\"type\":\"array\"}},\"required\":[\"name\",\"description\",\"ends_at\",\"code_scanning_alerts\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"alert_stats\":{\"closed_count\":3,\"in_progress_count\":3,\"open_count\":10},\"closed_at\":null,\"created_at\":\"2024-02-14T12:29:18Z\",\"description\":\"Address critical alerts before they are exploited to prevent breaches, protect sensitive data, and mitigate financial and reputational damage.\",\"ends_at\":\"2024-03-14T12:29:18Z\",\"managers\":[{\"avatar_url\":\"https://github.com/images/error/octocat_happy.gif\",\"events_url\":\"https://api.github.com/users/octocat/events{/privacy}\",\"followers_url\":\"https://api.github.com/users/octocat/followers\",\"following_url\":\"https://api.github.com/users/octocat/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/octocat/gists{/gist_id}\",\"gravatar_id\":\"\",\"html_url\":\"https://github.com/octocat\",\"id\":1,\"login\":\"octocat\",\"node_id\":\"MDQ6VXNlcjE=\",\"organizations_url\":\"https://api.github.com/users/octocat/orgs\",\"received_events_url\":\"https://api.github.com/users/octocat/received_events\",\"repos_url\":\"https://api.github.com/users/octocat/repos\",\"site_admin\":false,\"starred_url\":\"https://api.github.com/users/octocat/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/octocat/subscriptions\",\"type\":\"User\",\"url\":\"https://api.github.com/users/octocat\"}],\"name\":\"Critical CodeQL alert\",\"number\":3,\"published_at\":\"2024-02-14T12:29:18Z\",\"state\":