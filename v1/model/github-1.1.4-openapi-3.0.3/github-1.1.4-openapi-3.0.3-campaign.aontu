                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /orgs/{org}/campaigns/{campaign_number}"
            source: "openapi3"
