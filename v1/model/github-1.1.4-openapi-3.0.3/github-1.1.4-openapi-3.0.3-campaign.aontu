# Entity: campaign

main: kit: entity: campaign: {

  alias: field: {}

  fields: {
    alert_stats: {
      h: "Alert Stats"
      n: "alert_stats"
      r: true
      t: "`$OBJECT`"
    }
    closed_at: {
      fo: "date-time"
      h: "Closed At"
      n: "closed_at"
      r: false
      sh: "The date and time the campaign was closed, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      t: "`$STRING`"
    }
    code_scanning_alerts: {
      h: "Code Scanning Alerts"
      n: "code_scanning_alerts"
      r: true
      sh: "The code scanning alerts to include in this campaign"
      t: "`$ARRAY`"
    }
    contact_link: {
      fo: "uri"
      h: "Contact Link"
      n: "contact_link"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The contact link of the campaign."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "The date and time the campaign was created, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The campaign description"
      t: "`$STRING`"
    }
    ends_at: {
      fo: "date-time"
      h: "Ends At"
      n: "ends_at"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The date and time the campaign has ended, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      t: "`$STRING`"
    }
    generate_issues: {
      h: "Generate Issues"
      n: "generate_issues"
      r: false
      sh: "If true, will automatically generate issues for the campaign."
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    managers: {
      h: "Managers"
      n: "managers"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
        update: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "The campaign managers"
      t: "`$ARRAY`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The campaign name"
      t: "`$STRING`"
    }
    number: {
      h: "Number"
      n: "number"
      r: true
      sh: "The number of the newly created campaign"
      t: "`$INTEGER`"
    }
    published_at: {
      fo: "date-time"
      h: "Published At"
      n: "published_at"
      r: false
      sh: "The date and time the campaign was published, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Indicates whether a campaign is open or closed"
      t: "`$STRING`"
    }
    team_managers: {
      h: "Team Managers"
      n: "team_managers"
      r: false
      sh: "The campaign team managers"
      t: "`$ARRAY`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "The date and time the campaign was last updated, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "campaign"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /orgs/{org}/campaigns"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/orgs/{org}/campaigns"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "campaigns"
            }
          ]
          select: {
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: {
              code_scanning_alerts: "`reqdata.code_scanning_alert`"
              contact_link: "`reqdata.contact_link`"
              description: "`reqdata.description`"
              ends_at: "`reqdata.ends_at`"
              generate_issues: "`reqdata.generate_issue`"
              managers: "`reqdata.manager`"
              name: "`reqdata.name`"
              team_managers: "`reqdata.team_manager`"
            }
            res: "`body`"
          }
        }
      ]
    }
