# Entity: campaign

main: kit: entity: campaign: {

  alias: field: {}

  fields: [
    {
      name: "alert_stats"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "closed_at"
      req: false
      short: "The date and time the campaign was closed, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
    {
      name: "code_scanning_alerts"
      req: true
      short: "The code scanning alerts to include in this campaign"
      type: "`$ARRAY`"
    }
    {
      name: "contact_link"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The contact link of the campaign."
      type: "`$STRING`"
    }
    {
      name: "created_at"
      req: true
      short: "The date and time the campaign was created, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
    {
      name: "description"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The campaign description"
      type: "`$STRING`"
    }
    {
      name: "ends_at"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The date and time the campaign has ended, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
    {
      name: "generate_issues"
      req: false
      short: "If true, will automatically generate issues for the campaign."
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "managers"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
        update: {
          req: false
          type: "`$ARRAY`"
        }
      }
      req: true
      short: "The campaign managers"
      type: "`$ARRAY`"
    }
    {
      name: "name"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "The campaign name"
      type: "`$STRING`"
    }
    {
      name: "number"
      req: true
      short: "The number of the newly created campaign"
      type: "`$INTEGER`"
    }
    {
      name: "published_at"
      req: false
      short: "The date and time the campaign was published, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
    {
      name: "state"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "Indicates whether a campaign is open or closed"
      type: "`$STRING`"
    }
    {
      name: "team_managers"
      req: false
      short: "The campaign team managers"
      type: "`$ARRAY`"
    }
    {
      name: "updated_at"
      req: true
      short: "The date and time the campaign was last updated, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "campaign"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/orgs/{org}/campaigns"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "campaigns"
            }
          ]
          select: {
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: {
              code_scanning_alerts: "`reqdata.code_scanning_alert`"
              contact_link: "`reqdata.contact_link`"
              description: "`reqdata.description`"
              ends_at: "`reqdata.ends_at`"
              generate_issues: "`reqdata.generate_issue`"
              managers: "`reqdata.manager`"
              name: "`reqdata.name`"
              team_managers: "`reqdata.team_manager`"
            }
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "desc"
                kind: "query"
                name: "direction"
                orig: "direction"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "created"
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "state"
                orig: "state"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/orgs/{org}/campaigns"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "campaigns"
            }
          ]
          select: {
            exist: [
              "direction"
              "org_id"
              "page"
              "per_page"
              "sort"
              "state"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "campaign_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/orgs/{org}/campaigns/{campaign_number}"
          rename: {
            param: {
              campaign_number: "id"
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "campaigns"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "campaign_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/orgs/{org}/campaigns/{campaign_number}"
          rename: {
            param: {
              campaign_number: "id"
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "campaigns"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "campaign_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/orgs/{org}/campaigns/{campaign_number}"
          rename: {
            param: {
              campaign_number: "id"
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "campaigns"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "org_id"
            ]
          }
          transform: {
            req: {
              contact_link: "`reqdata.contact_link`"
              description: "`reqdata.description`"
              ends_at: "`reqdata.ends_at`"
              managers: "`reqdata.manager`"
              name: "`reqdata.name`"
              state: "`reqdata.state`"
              team_managers: "`reqdata.team_manager`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
    ]
  }



}