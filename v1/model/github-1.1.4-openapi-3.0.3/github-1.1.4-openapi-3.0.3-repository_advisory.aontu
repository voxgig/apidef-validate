            id: "POST /repos/{owner}/{repo}/security-advisories"
            json: "{\"operationId\":\"security-advisories/create-repository-advisory\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"credits\":[{\"login\":\"monalisa\",\"type\":\"reporter\"},{\"login\":\"octocat\",\"type\":\"analyst\"}],\"cve_id\":null,\"cwe_ids\":[\"CWE-1101\",\"CWE-20\"],\"description\":\"A more in-depth description of what the problem is.\",\"severity\":\"high\",\"summary\":\"A new important advisory\",\"vulnerabilities\":[{\"package\":{\"ecosystem\":\"npm\",\"name\":\"a-package\"},\"patched_versions\":\"1.0.0\",\"vulnerable_functions\":[\"important_function\"],\"vulnerable_version_range\":\"< 1.0.0\"}]}},\"minimal\":{\"value\":{\"description\":\"A more in-depth description of what the problem is.\",\"summary\":\"A new important advisory\",\"vulnerabilities\":[{\"package\":{\"ecosystem\":\"npm\"}}]}},\"withVectorString\":{\"value\":{\"credits\":[{\"login\":\"monalisa\",\"type\":\"reporter\"},{\"login\":\"octocat\",\"type\":\"analyst\"}],\"cve_id\":null,\"cvss_vector_string\":\"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:L\",\"cwe_ids\":[\"CWE-1101\",\"CWE-20\"],\"description\":\"A more in-depth description of what the problem is.\",\"summary\":\"A new important advisory\",\"vulnerabilities\":[{\"package\":{\"ecosystem\":\"npm\",\"name\":\"a-package\"},\"patched_versions\":\"1.0.0\",\"vulnerable_functions\":[\"important_function\"],\"vulnerable_version_range\":\"< 1.0.0\"}]}}},\"schema\":{\"additionalProperties\":false,\"properties\":{\"credits\":{\"description\":\"A list of users receiving credit for their participation in the security advisory.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"login\":{\"description\":\"The username of the user credited.\",\"type\":\"string\"},\"type\":{\"description\":\"The type of credit the user is receiving.\",\"enum\":[\"analyst\",\"finder\",\"reporter\",\"coordinator\",\"remediation_developer\",\"remediation_reviewer\",\"remediation_verifier\",\"tool\",\"sponsor\",\"other\"],\"type\":\"string\"}},\"required\":[\"login\",\"type\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"cve_id\":{\"description\":\"The Common Vulnerabilities and Exposures (CVE) ID.\",\"nullable\":true,\"type\":\"string\"},\"cvss_vector_string\":{\"description\":\"The CVSS vector that calculates the severity of the advisory. You must choose between setting this field or `severity`.\",\"nullable\":true,\"type\":\"string\"},\"cwe_ids\":{\"description\":\"A list of Common Weakness Enumeration (CWE) IDs.\",\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"description\":{\"description\":\"A detailed description of what the advisory impacts.\",\"maxLength\":65535,\"type\":\"string\"},\"severity\":{\"description\":\"The severity of the advisory. You must choose between setting this field or `cvss_vector_string`.\",\"enum\":[\"critical\",\"high\",\"medium\",\"low\"],\"nullable\":true,\"type\":\"string\"},\"start_private_fork\":{\"default\":false,\"description\":\"Whether to create a temporary private fork of the repository to collaborate on a fix.\",\"type\":\"boolean\"},\"summary\":{\"description\":\"A short summary of the advisory.\",\"maxLength\":1024,\"type\":\"string\"},\"vulnerabilities\":{\"description\":\"A product affected by the vulnerability detailed in a repository security advisory.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"package\":{\"description\":\"The name of the package affected by the vulnerability.\",\"properties\":{\"ecosystem\":{\"description\":\"The package's langua