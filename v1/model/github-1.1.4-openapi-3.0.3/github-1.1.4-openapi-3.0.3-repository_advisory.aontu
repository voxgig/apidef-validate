          contract: {
            id: "PATCH /repos/{owner}/{repo}/security-advisories/{ghsa_id}"
            json: "{\"operationId\":\"security-advisories/update-repository-advisory\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The GHSA (GitHub Security Advisory) identifier of the advisory.\",\"in\":\"path\",\"name\":\"ghsa_id\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"add_credit\":{\"summary\":\"To add a credit to an advisory, send the whole array of values.\",\"value\":{\"credits\":[{\"login\":\"monauser\",\"type\":\"remediation_developer\"}]}},\"default\":{\"summary\":\"Updating the severity and state.\",\"value\":{\"severity\":\"critical\",\"state\":\"published\"}},\"invalid_state_transition\":{\"summary\":\"Example of an invalid state transition, from `published` to `draft`.\",\"value\":{\"state\":\"draft\"}},\"update_severity_with_cvss_set\":{\"summary\":\"Severity cannot be updated when the CVSS is already set.\",\"value\":{\"severity\":\"low\"}},\"update_vvrs\":{\"summary\":\"To add vulnerable versions, include existing versions in the array.\",\"value\":[{\"package\":{\"ecosystem\":\"pip\",\"name\":\"a-package\"},\"patched_versions\":\"1.0.1\",\"vulnerable_functions\":[\"function1\"],\"vulnerable_version_range\":\">= 1.0.0, < 1.0.1\"},{\"package\":{\"ecosystem\":\"pip\",\"name\":\"another-package\"},\"patched_versions\":\"1.0.2\",\"vulnerable_functions\":[\"function2\"],\"vulnerable_version_range\":\">= 1.0.0, < 1.0.2\"}]}},\"schema\":{\"additionalProperties\":false,\"properties\":{\"collaborating_teams\":{\"description\":\"A list of team slugs which have been granted write access to the advisory.\",\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"collaborating_users\":{\"description\":\"A list of usernames who have been granted write access to the advisory.\",\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"credits\":{\"description\":\"A list of users receiving credit for their participation in the security advisory.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"login\":{\"description\":\"The username of the user credited.\",\"type\":\"string\"},\"type\":{\"description\":\"The type of credit the user is receiving.\",\"enum\":[\"analyst\",\"finder\",\"reporter\",\"coordinator\",\"remediation_developer\",\"remediation_reviewer\",\"remediation_verifier\",\"tool\",\"sponsor\",\"other\"],\"type\":\"string\"}},\"required\":[\"login\",\"type\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"cve_id\":{\"description\":\"The Common Vulnerabilities and Exposures (CVE) ID.\",\"nullable\":true,\"type\":\"string\"},\"cvss_vector_string\":{\"description\":\"The CVSS vector that calculates the severity of the advisory. You must choose between setting this field or `severity`.\",\"nullable\":true,\"type\":\"string\"},\"cwe_ids\":{\"description\":\"A list of Common Weakness Enumeration (CWE) IDs.\",\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"description\":{\"description\":\"A detailed description of what the advisory impacts.\",\"maxLength\":65535,\"type\":\"string\"},\"severity\":{\"description\":\"The severity of the advisory. You must choose between setting this field or `cvss_vector_string`.\",\"enum\":[\"critical\",\"high\",\"medium\",\"low\"],\"nullable\":true,\"type\":\"string\"},\"state\":{\"description\":\"The state of the advisory.\",\"enum\":[\"published\",\"closed\",\"draft\"],\"type\":\"string\"},\"summary\":{\"description\":\"A short summary of the advisory.\",\"maxLength\":1024,\"type\":\"string\"},\"vulnerabilities\":{\"description\":\"A product affected 