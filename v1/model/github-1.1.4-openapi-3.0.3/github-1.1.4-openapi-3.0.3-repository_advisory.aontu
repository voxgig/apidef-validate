            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/security-advisories"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "security-advisories"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              credits: "`reqdata.credit`"
              cve_id: "`reqdata.cve_id`"
              cvss_vector_string: "`reqdata.cvss_vector_string`"
              cwe_ids: "`reqdata.cwe_id`"
              description: "`reqdata.description`"
              severity: "`reqdata.severity`"
              start_private_fork: "`reqdata.start_private_fork`"
              summary: "`reqdata.summary`"
              vulnerabilities: "`reqdata.vulnerability`"
            }
