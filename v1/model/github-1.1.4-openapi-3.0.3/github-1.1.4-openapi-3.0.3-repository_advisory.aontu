# Entity: repository_advisory

main: kit: entity: repository_advisory: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: true
      short: "The author of the advisory."
      type: "`$ANY`"
    }
    {
      name: "closed_at"
      req: true
      short: "The date and time of when the advisory was closed, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "collaborating_teams"
      op: {
        update: {
          req: false
          type: "`$ARRAY`"
        }
      }
      req: true
      short: "A list of teams that collaborate on the advisory."
      type: "`$ARRAY`"
    }
    {
      name: "collaborating_users"
      op: {
        update: {
          req: false
          type: "`$ARRAY`"
        }
      }
      req: true
      short: "A list of users that collaborate on the advisory."
      type: "`$ARRAY`"
    }
    {
      name: "created_at"
      req: true
      short: "The date and time of when the advisory was created, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "credits"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
        update: {
          req: false
          type: "`$ARRAY`"
        }
      }
      req: true
      short: "A list of users receiving credit for their participation in the security advisory."
      type: "`$ARRAY`"
    }
    {
      name: "credits_detailed"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "cve_id"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The Common Vulnerabilities and Exposures (CVE) ID."
      type: "`$STRING`"
    }
    {
      name: "cvss"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "cvss_severities"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "cvss_vector_string"
      req: false
      short: "The CVSS vector that calculates the severity of the advisory."
      type: "`$STRING`"
    }
    {
      name: "cwe_ids"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
        update: {
          req: false
          type: "`$ARRAY`"
        }
      }
      req: true
      short: "A list of only the CWE IDs."
      type: "`$ARRAY`"
    }
    {
      name: "cwes"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "description"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "A detailed description of what the advisory entails."
      type: "`$STRING`"
    }
    {
      name: "ghsa_id"
      req: true
      short: "The GitHub Security Advisory ID."
      type: "`$STRING`"
    }
    {
      name: "html_url"
      req: true
      short: "The URL for the advisory."
      type: "`$STRING`"
    }
    {
      name: "identifiers"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "private_fork"
      req: true
      short: "A temporary private fork of the advisory's repository for collaborating on a fix."
      type: "`$ANY`"
    }
    {
      name: "published_at"
      req: true
      short: "The date and time of when the advisory was published, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "publisher"
      req: true
      short: "The publisher of the advisory."
      type: "`$ANY`"
    }
    {
      name: "severity"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The severity of the advisory."
      type: "`$STRING`"
    }
    {
      name: "start_private_fork"
      req: false
      short: "Whether to create a temporary private fork of the repository to collaborate on a fix."
      type: "`$BOOLEAN`"
    }
    {
      name: "state"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The state of the advisory."
      type: "`$STRING`"
    }
    {
      name: "submission"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "summary"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "A short summary of the advisory."
      type: "`$STRING`"
    }
    {
      name: "updated_at"
      req: true
      short: "The date and time of when the advisory was last updated, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "The API URL for the advisory."
      type: "`$STRING`"
    }
    {
      name: "vulnerabilities"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
        update: {
          req: false
          type: "`$ARRAY`"
        }
      }
      req: true
      short: "A product affected by the vulnerability detailed in a repository security advisory."
      type: "`$ARRAY`"
    }
    {
      name: "withdrawn_at"
      req: true
      short: "The date and time of when the advisory was withdrawn, in ISO 8601 format."
      type: "`$STRING`"
    }
  ]

  name: "repository_advisory"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/security-advisories"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "security-advisories"
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              credits: "`reqdata.credit`"
              cve_id: "`reqdata.cve_id`"
              cvss_vector_string: "`reqdata.cvss_vector_string`"
              cwe_ids: "`reqdata.cwe_id`"
              description: "`reqdata.description`"
              severity: "`reqdata.severity`"
              start_private_fork: "`reqdata.start_private_fork`"
              summary: "`reqdata.summary`"
              vulnerabilities: "`reqdata.vulnerability`"
            }
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/security-advisories/reports"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "security-advisories"
            "reports"
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              cvss_vector_string: "`reqdata.cvss_vector_string`"
              cwe_ids: "`reqdata.cwe_id`"
              description: "`reqdata.description`"
              severity: "`reqdata.severity`"
              start_private_fork: "`reqdata.start_private_fork`"
              summary: "`reqdata.summary`"
              vulnerabilities: "`reqdata.vulnerability`"
            }
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "after"
                orig: "after"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "before"
                orig: "before"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "desc"
                kind: "query"
                name: "direction"
                orig: "direction"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "created"
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "state"
                orig: "state"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/security-advisories"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "security-advisories"
          ]
          select: {
            exist: [
              "after"
              "before"
              "direction"
              "owner"
              "per_page"
              "repo"
              "sort"
              "state"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "after"
                orig: "after"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "before"
                orig: "before"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "desc"
                kind: "query"
                name: "direction"
                orig: "direction"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "created"
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "state"
                orig: "state"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/orgs/{org}/security-advisories"
          parts: [
            "orgs"
            "{org_id}"
            "security-advisories"
          ]
          rename: {
            param: {
              org: "org_id"
            }
          }
          select: {
            exist: [
              "after"
              "before"
              "direction"
              "org_id"
              "per_page"
              "sort"
              "state"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "ghsa_id"
                orig: "ghsa_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/security-advisories/{ghsa_id}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "security-advisories"
            "{ghsa_id}"
          ]
          select: {
            exist: [
              "ghsa_id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "ghsa_id"
                orig: "ghsa_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/repos/{owner}/{repo}/security-advisories/{ghsa_id}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "security-advisories"
            "{ghsa_id}"
          ]
          select: {
            exist: [
              "ghsa_id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              collaborating_teams: "`reqdata.collaborating_team`"
              collaborating_users: "`reqdata.collaborating_user`"
              credits: "`reqdata.credit`"
              cve_id: "`reqdata.cve_id`"
              cvss_vector_string: "`reqdata.cvss_vector_string`"
              cwe_ids: "`reqdata.cwe_id`"
              description: "`reqdata.description`"
              severity: "`reqdata.severity`"
              state: "`reqdata.state`"
              summary: "`reqdata.summary`"
              vulnerabilities: "`reqdata.vulnerability`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
      [
        "repo"
      ]
      [
        "repo"
        "security_advisory"
      ]
    ]
  }



}