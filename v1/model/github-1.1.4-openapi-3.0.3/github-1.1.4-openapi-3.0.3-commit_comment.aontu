          orig: "/repos/{owner}/{repo}/comments/{comment_id}"
          rename: {
            param: {
              comment_id: "id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "comments"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
      [
        "repo"
        "commit"
      ]
    ]
  }



}