# Entity: page_deployment

main: kit: entity: page_deployment: {

  alias: field: {}

  fields: {
    artifact_id: {
      h: "Artifact Id"
      n: "artifact_id"
      r: false
      sh: "The ID of an artifact that contains the .zip or .tar of static assets to deploy."
      t: "`$NUMBER`"
    }
    artifact_url: {
      h: "Artifact Url"
      n: "artifact_url"
      r: false
      sh: "The URL of an artifact that contains the .zip or .tar of static assets to deploy."
      t: "`$STRING`"
    }
    environment: {
      h: "Environment"
      n: "environment"
      r: false
      sh: "The target environment for this GitHub Pages deployment."
      t: "`$STRING`"
    }
    oidc_token: {
      h: "Oidc Token"
      n: "oidc_token"
      r: true
      sh: "The OIDC token issued by GitHub Actions certifying the origin of the deployment."
      t: "`$STRING`"
    }
    pages_build_version: {
      h: "Pages Build Version"
      n: "pages_build_version"
      r: true
      sh: "A unique string that represents the version of the build for this deployment."
      t: "`$STRING`"
    }
  }

  name: "page_deployment"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /repos/{owner}/{repo}/pages/deployments"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/pages/deployments"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "pages"
            }
            {
              lit: "deployments"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.id`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}