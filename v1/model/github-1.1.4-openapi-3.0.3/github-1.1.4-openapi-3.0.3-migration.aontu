# Entity: migration

main: kit: entity: migration: {

  alias: field: {}

  fields: {
    archive_url: {
      fo: "uri"
      h: "Archive Url"
      n: "archive_url"
      r: false
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      t: "`$STRING`"
    }
    exclude: {
      h: "Exclude"
      n: "exclude"
      r: false
      sh: "Exclude related items from being returned in the response in order to improve performance of the request."
      t: "`$ARRAY`"
    }
    exclude_attachments: {
      h: "Exclude Attachments"
      n: "exclude_attachments"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Indicates whether attachments should be excluded from the migration (to reduce migration archive file size)."
      t: "`$BOOLEAN`"
    }
    exclude_git_data: {
      h: "Exclude Git Data"
      n: "exclude_git_data"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Indicates whether the repository git data should be excluded from the migration."
      t: "`$BOOLEAN`"
    }
    exclude_metadata: {
      h: "Exclude Metadata"
      n: "exclude_metadata"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Indicates whether metadata should be excluded and only git source should be included for the migration."
      t: "`$BOOLEAN`"
    }
    exclude_owner_projects: {
      h: "Exclude Owner Projects"
      n: "exclude_owner_projects"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Indicates whether projects owned by the organization or users should be excluded."
      t: "`$BOOLEAN`"
    }
    exclude_releases: {
      h: "Exclude Releases"
      n: "exclude_releases"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Indicates whether releases should be excluded from the migration (to reduce migration archive file size)."
      t: "`$BOOLEAN`"
    }
    guid: {
      h: "Guid"
      n: "guid"
      r: true
      t: "`$STRING`"
    }
    id: {
      fo: "int64"
      h: "Id"
      n: "id"
      r: true
      t: "`$INTEGER`"
    }
    lock_repositories: {
      h: "Lock Repositories"
      n: "lock_repositories"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Indicates whether repositories should be locked (to prevent manipulation) while migrating data."
      t: "`$BOOLEAN`"
    }
    node_id: {
      h: "Node Id"
      n: "node_id"
      r: true
      t: "`$STRING`"
    }
    org_metadata_only: {
      h: "Org Metadata Only"
      n: "org_metadata_only"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Indicates whether this should only include organization metadata (repositories array should be empty and will ignore other flags)."
      t: "`$BOOLEAN`"
    }
    owner: {
      h: "Owner"
      n: "owner"
      r: true
      sh: "A GitHub user."
      t: "`$OBJECT`"
    }
    repositories: {
      h: "Repositories"
      n: "repositories"
      r: true
      sh: "The repositories included in the migration."
      t: "`$ARRAY`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      t: "`$STRING`"
    }
  }

