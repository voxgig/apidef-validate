          type: "`$ARRAY`"
        }
      }
      req: true
      short: "Determines what events the hook is triggered for."
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: true
      short: "Unique identifier of the webhook."
      type: "`$INTEGER`"
    }
    {
      name: "last_response"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "name"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
