      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
        update: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "Determines what events the hook is triggered for."
      t: "`$ARRAY`"
    }
