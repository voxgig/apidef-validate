# Entity: hook

main: kit: entity: hook: {

  alias: field: {}

  fields: {
    active: {
      h: "Active"
      n: "active"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Determines whether the hook is actually triggered on pushes."
      t: "`$BOOLEAN`"
    }
    add_events: {
      h: "Add Events"
      n: "add_events"
      r: false
      sh: "Determines a list of events to be added to the list of events that the Hook triggers for."
      t: "`$ARRAY`"
    }
    config: {
      h: "Config"
      n: "config"
      op: {
        create: {
          req: false
          type: "`$OBJECT`"
        }
        update: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      sh: "Configuration object of the webhook"
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      t: "`$STRING`"
    }
