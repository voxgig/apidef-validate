      h: "Last Response"
      n: "last_response"
      r: true
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The name of a valid service, use 'web' for a webhook."
      t: "`$STRING`"
    }
    ping_url: {
      fo: "uri"
      h: "Ping Url"
      n: "ping_url"
      r: true
      t: "`$STRING`"
    }
    remove_events: {
      h: "Remove Events"
      n: "remove_events"
      r: false
