# Entity: hook

main: kit: entity: hook: {

  alias: field: {}

  fields: [
    {
      name: "active"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      short: "Determines whether the hook is actually triggered on pushes."
      type: "`$BOOLEAN`"
    }
    {
      name: "add_events"
      req: false
      short: "Determines a list of events to be added to the list of events that the Hook triggers for."
      type: "`$ARRAY`"
    }
    {
      name: "config"
      op: {
        create: {
          req: false
          type: "`$OBJECT`"
        }
        update: {
          req: false
          type: "`$OBJECT`"
        }
      }
      req: true
      short: "Configuration object of the webhook"
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "created_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "deliveries_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "events"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
        update: {
          req: false
          type: "`$ARRAY`"
        }
      }
      req: true
      short: "Determines what events the hook is triggered for."
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: true
      short: "Unique identifier of the webhook."
      type: "`$INTEGER`"
    }
    {
      name: "last_response"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "name"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The name of a valid service, use 'web' for a webhook."
      type: "`$STRING`"
    }
    {
      name: "ping_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "remove_events"
      req: false
      short: "Determines a list of events to be removed from the list of events that the Hook triggers for."
      type: "`$ARRAY`"
    }
    {
      name: "test_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "type"
      req: true
      type: "`$STRING`"
    }
    {
      name: "updated_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "hook"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/hooks"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "hooks"
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              active: "`reqdata.active`"
              config: "`reqdata.config`"
              events: "`reqdata.event`"
              name: "`reqdata.name`"
            }
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/hooks"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "hooks"
          ]
          select: {
            exist: [
              "owner"
              "page"
              "per_page"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "hook_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/hooks/{hook_id}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "hooks"
            "{id}"
          ]
          rename: {
            param: {
              hook_id: "id"
            }
          }
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "hook_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/repos/{owner}/{repo}/hooks/{hook_id}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "hooks"
            "{id}"
          ]
          rename: {
            param: {
              hook_id: "id"
            }
          }
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}