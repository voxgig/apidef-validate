                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "PUT"
          orig: "/app/installations/{installation_id}/suspended"
          parts: [
            "app"
            "installations"
            "{installation_id}"
            "suspended"
          ]
          select: {
            exist: [
              "installation_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

