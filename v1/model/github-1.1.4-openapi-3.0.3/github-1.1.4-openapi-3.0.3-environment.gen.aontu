# Entity: environment

main: kit: entity: environment: {

  alias: field: {}

  fields: [
    {
      format: "date-time"
      name: "created_at"
      req: true
      short: "The time that the environment was created, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "deployment_branch_policy"
      req: true
      short: "The type of deployment branch policy for this environment."
      type: "`$OBJECT`"
    }
    {
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      format: "int64"
      name: "id"
      req: true
      short: "The id of the environment."
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: true
      short: "The name of the environment."
      type: "`$STRING`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "prevent_self_review"
      req: false
      short: "Whether or not a user who created the job is prevented from approving their own job."
      type: "`$BOOLEAN`"
    }
    {
      name: "protection_rules"
      req: false
      short: "Built-in deployment protection rules for the environment."
      type: "`$ARRAY`"
      union: {
        branches: 3
        count: 2
        depth: 8
      }
    }
    {
      name: "reviewers"
      req: false
      short: "The people or teams that may review jobs that reference the environment."
      type: "`$ARRAY`"
    }
    {
      format: "date-time"
      name: "updated_at"
      req: true
      short: "The time that the environment was last updated, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "wait_timer"
      req: false
      short: "The amount of time to delay a job after the job is initially triggered."
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "environment"
  op: {
    load: {
      name: "load"
