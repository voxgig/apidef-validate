# Entity: environment

main: kit: entity: environment: {

  alias: field: {}

  fields: {
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "The time that the environment was created, in ISO 8601 format."
      t: "`$STRING`"
    }
    deployment_branch_policy: {
      h: "Deployment Branch Policy"
      n: "deployment_branch_policy"
      r: true
      sh: "The type of deployment branch policy for this environment."
      t: "`$OBJECT`"
    }
    html_url: {
      h: "Html Url"
      n: "html_url"
      r: true
      t: "`$STRING`"
    }
    id: {
      fo: "int64"
      h: "Id"
      n: "id"
      r: true
      sh: "The id of the environment."
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the environment."
      t: "`$STRING`"
    }
    node_id: {
      h: "Node Id"
      n: "node_id"
      r: true
      t: "`$STRING`"
    }
    prevent_self_review: {
      h: "Prevent Self Review"
      n: "prevent_self_review"
      r: false
      sh: "Whether or not a user who created the job is prevented from approving their own job."
      t: "`$BOOLEAN`"
    }
    protection_rules: {
      h: "Protection Rules"
      n: "protection_rules"
      r: false
      sh: "Built-in deployment protection rules for the environment."
      t: "`$ARRAY`"
      union: {
        branches: 3
        count: 2
        depth: 8
      }
    }
    reviewers: {
      h: "Reviewers"
      n: "reviewers"
      r: false
      sh: "The people or teams that may review jobs that reference the environment."
      t: "`$ARRAY`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "The time that the environment was last updated, in ISO 8601 format."
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      t: "`$STRING`"
    }
    wait_timer: {
      h: "Wait Timer"
      n: "wait_timer"
      r: false
      sh: "The amount of time to delay a job after the job is initially triggered."
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "environment"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "environment_name"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/environments/{environment_name}"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/environments/{environment_name}"
          rename: {
            param: {
              environment_name: "id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "environments"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "environment_name"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "PUT /repos/{owner}/{repo}/environments/{environment_name}"
            source: "openapi3"
            version: 2
          }
          method: "PUT"
          orig: "/repos/{owner}/{repo}/environments/{environment_name}"
          rename: {
            param: {
              environment_name: "id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "environments"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              deployment_branch_policy: "`reqdata.deployment_branch_policy`"
              prevent_self_review: "`reqdata.prevent_self_review`"
              reviewers: "`reqdata.reviewer`"
              wait_timer: "`reqdata.wait_timer`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}