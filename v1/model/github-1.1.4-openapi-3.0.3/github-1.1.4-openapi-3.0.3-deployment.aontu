      type: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    {
      name: "performed_via_github_app"
      req: true
      short: "GitHub apps are a new way to extend GitHub."
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "production_environment"
