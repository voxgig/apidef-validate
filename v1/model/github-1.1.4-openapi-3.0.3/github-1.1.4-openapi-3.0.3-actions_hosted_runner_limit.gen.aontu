      short: "The current number of static public IP addresses in use by Hosted Runners."
      type: "`$INTEGER`"
    }
    {
      name: "maximum"
      req: true
      short: "The maximum number of static public IP addresses that can be used for Hosted Runners."
      type: "`$INTEGER`"
    }
  ]

  name: "actions_hosted_runner_limit"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
