                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /orgs/{org}/actions/hosted-runners/limits"
            json: "{\"operationId\":\"actions/get-hosted-runners-limits-for-org\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"public_ips\":{\"current_usage\":17,\"maximum\":50}}}},\"schema\":{\"properties\":{\"public_ips\":{\"description\":\"Provides details of static public IP limits for GitHub-hosted Hosted Runners\",\"properties\":{\"current_usage\":{\"description\":\"The current number of static public IP addresses in use by Hosted Runners.\",\"example\":17,\"type\":\"integer\"},\"maximum\":{\"description\":\"The maximum number of static public IP addresses that can be used for Hosted Runners.\",\"example\":50,\"type\":\"integer\"}},\"required\":[\"maximum\",\"current_usage\"],\"title\":\"Static public IP Limits for GitHub-hosted Hosted Runners.\",\"type\":\"object\"}},\"required\":[\"public_ips\"],\"type\":\"object\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/orgs/{org}/actions/hosted-runners/limits"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "actions"
            }
            {
              lit: "hosted-runners"
            }
            {
              lit: "limits"
            }
          ]
          select: {
            exist: [
