      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "fixed_at"
      readOnly: true
      req: false
      short: "The time that the alert was no longer detected and was considered fixed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "html_url"
      readOnly: true
      req: true
      short: "The GitHub URL of the alert resource."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "instances_url"
      readOnly: true
      req: true
      short: "The REST API URL for fetching the list of instances for an alert."
      type: "`$STRING`"
    }
    {
      name: "most_recent_instance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "number"
      readOnly: true
      req: true
      short: "The security alert number."
      type: "`$INTEGER`"
    }
    {
      name: "rule"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "state"
      req: true
      short: "State of a code scanning alert."
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      type: "`$OBJECT`"
    }
    {
      format: "date-time"
      name: "updated_at"
      readOnly: true
      req: false
      short: "The time that the alert was last updated in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      readOnly: true
      req: true
      short: "The REST API URL of the alert resource."
      type: "`$STRING`"
    }
  ]

