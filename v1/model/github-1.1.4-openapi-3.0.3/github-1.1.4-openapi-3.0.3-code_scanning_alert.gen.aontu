      type: "`$STRING`"
    }
    {
      name: "dismissed_by"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      name: "dismissed_comment"
      req: false
      short: "The dismissal comment associated with the dismissal of the alert."
      type: "`$STRING`"
    }
    {
      name: "dismissed_reason"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
