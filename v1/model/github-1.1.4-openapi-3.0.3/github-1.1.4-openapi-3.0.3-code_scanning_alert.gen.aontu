            json: "{\"operationId\":\"code-scanning/update-alert\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.\",\"in\":\"path\",\"name\":\"alert_number\",\"required\":true,\"schema\":{\"description\":\"The security alert number.\",\"readOnly\":true,\"type\":\"integer\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"create_request\":true,\"dismissed_comment\":\"This alert is not actually correct, because there's a sanitizer included in the library.\",\"dismissed_reason\":\"false positive\",\"state\":\"dismissed\"}}},\"schema\":{\"properties\":{\"create_request\":{\"description\":\"If `true`, attempt to create an alert dismissal request.\",\"type\":\"boolean\"},\"dismissed_comment\":{\"description\":\"The dismissal comment associated with the dismissal of the alert.\",\"maxLength\":280,\"nullable\":true,\"type\":\"string\"},\"dismissed_reason\":{\"description\":\"**Required when the state is dismissed.** The reason for dismissing or closing the alert.\",\"enum\":[\"false positive\",\"won't fix\",\"used in tests\"],\"nullable\":true,\"type\":\"string\"},\"state\":{\"description\":\"Sets the state of the code scanning alert. You must provide `dismissed_reason` when you set the state to `dismissed`.\",\"enum\":[\"open\",\"dismissed\"],\"type\":\"string\"}},\"required\":[\"state\"],\"type\":\"object\"}}},\"required\":tru