# Entity: code_scanning_alert

main: kit: entity: code_scanning_alert: {

  alias: field: {}

  fields: {
    create_request: {
      h: "Create Request"
      n: "create_request"
      r: false
      sh: "If `true`, attempt to create an alert dismissal request."
      t: "`$BOOLEAN`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      ro: true
      sh: "The time that the alert was created in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    dismissal_approved_by: {
      h: "Dismissal Approved By"
      n: "dismissal_approved_by"
      r: true
      sh: "A GitHub user."
      t: "`$OBJECT`"
    }
    dismissed_at: {
      fo: "date-time"
      h: "Dismissed At"
      n: "dismissed_at"
      r: true
      ro: true
      sh: "The time that the alert was dismissed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    dismissed_by: {
      h: "Dismissed By"
      n: "dismissed_by"
      r: true
      sh: "A GitHub user."
      t: "`$OBJECT`"
    }
    dismissed_comment: {
      h: "Dismissed Comment"
      n: "dismissed_comment"
      r: false
      sh: "The dismissal comment associated with the dismissal of the alert."
      t: "`$STRING`"
    }
    dismissed_reason: {
      h: "Dismissed Reason"
      n: "dismissed_reason"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "**Required when the state is dismissed.** The reason for dismissing or closing the alert."
      t: "`$STRING`"
    }
    fixed_at: {
      fo: "date-time"
      h: "Fixed At"
      n: "fixed_at"
      r: false
      ro: true
      sh: "The time that the alert was no longer detected and was considered fixed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      ro: true
      sh: "The GitHub URL of the alert resource."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    instances_url: {
      fo: "uri"
      h: "Instances Url"
      n: "instances_url"
      r: true
      ro: true
      sh: "The REST API URL for fetching the list of instances for an alert."
      t: "`$STRING`"
    }
    most_recent_instance: {
      h: "Most Recent Instance"
      n: "most_recent_instance"
      r: true
      t: "`$OBJECT`"
    }
    number: {
      h: "Number"
      n: "number"
      r: true
      ro: true
      sh: "The security alert number."
      t: "`$INTEGER`"
    }
    rule: {
      h: "Rule"
      n: "rule"
      r: true
      t: "`$OBJECT`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "State of a code scanning alert."
      t: "`$STRING`"
    }
    tool: {
      h: "Tool"
      n: "tool"
      r: true
      t: "`$OBJECT`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      ro: true
      sh: "The time that the alert was last updated in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      ro: true
      sh: "The REST API URL of the alert resource."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "code_scanning_alert"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/code-scanning/alerts/{alert_number}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "alert_number"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/code-scanning/alerts/{alert_number}"
          q: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          r: {
            param: {
              alert_number: "id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "alerts"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PATCH /repos/{owner}/{repo}/code-scanning/alerts/{alert_number}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "alert_number"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PATCH"
          o: "/repos/{owner}/{repo}/code-scanning/alerts/{alert_number}"
          q: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          r: {
            param: {
              alert_number: "id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "alerts"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.repo")]
  ]

}