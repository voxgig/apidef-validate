# Entity: check_suite_preference

main: kit: entity: check_suite_preference: {

  alias: field: {}

  fields: {
    auto_trigger_checks: {
      h: "Auto Trigger Checks"
      n: "auto_trigger_checks"
      r: false
      sh: "Enables or disables automatic creation of CheckSuite events upon pushes to the repository."
      t: "`$ARRAY`"
    }
    preferences: {
      h: "Preferences"
      n: "preferences"
      r: true
      t: "`$OBJECT`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: true
      sh: "Minimal Repository"
      t: "`$OBJECT`"
    }
  }

  name: "check_suite_preference"
  op: {
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PATCH /repos/{owner}/{repo}/check-suites/preferences"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PATCH"
          o: "/repos/{owner}/{repo}/check-suites/preferences"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "check-suites"
            }
            {
              lit: "preferences"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}