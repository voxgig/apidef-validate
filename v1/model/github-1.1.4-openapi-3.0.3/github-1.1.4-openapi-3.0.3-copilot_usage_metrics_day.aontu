# Entity: copilot_usage_metrics_day

main: kit: entity: copilot_usage_metrics_day: {

  alias: field: {}

  fields: {
    copilot_dotcom_chat: {
      h: "Copilot Dotcom Chat"
      n: "copilot_dotcom_chat"
      r: false
      sh: "Usage metrics for Copilot Chat in GitHub.com"
      t: "`$OBJECT`"
    }
    copilot_dotcom_pull_requests: {
      h: "Copilot Dotcom Pull Requests"
      n: "copilot_dotcom_pull_requests"
      r: false
      sh: "Usage metrics for Copilot for pull requests."
      t: "`$OBJECT`"
    }
    copilot_ide_chat: {
      h: "Copilot Ide Chat"
      n: "copilot_ide_chat"
      r: false
      sh: "Usage metrics for Copilot Chat in the IDE."
      t: "`$OBJECT`"
    }
    copilot_ide_code_completions: {
      h: "Copilot Ide Code Completions"
      n: "copilot_ide_code_completions"
      r: false
      sh: "Usage metrics for Copilot editor code completions in the IDE."
      t: "`$OBJECT`"
    }
    date: {
      fo: "date"
      h: "Date"
      n: "date"
      r: true
      sh: "The date for which the usage metrics are aggregated, in `YYYY-MM-DD` format."
      t: "`$STRING`"
    }
    total_active_users: {
      h: "Total Active Users"
      n: "total_active_users"
      r: false
      sh: "The total number of Copilot users with activity belonging to any Copilot feature, globally, for the given day."
      t: "`$INTEGER`"
    }
    total_engaged_users: {
      h: "Total Engaged Users"
      n: "total_engaged_users"
      r: false
      sh: "The total number of Copilot users who engaged with any Copilot feature, for the given day."
      t: "`$INTEGER`"
    }
  }

  name: "copilot_usage_metrics_day"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /orgs/{org}/team/{team_slug}/copilot/metrics"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "team_id"
                or: "team_slug"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 100
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "since"
                or: "since"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "until"
                or: "until"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/team/{team_slug}/copilot/metrics"
          q: {
            exist: [
              "org_id"
              "page"
              "per_page"
              "since"
              "team_id"
              "until"
            ]
          }
          r: {
            param: {
              org: "org_id"
              team_slug: "team_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "team"
            }
            {
              var: "team_id"
            }
            {
              lit: "copilot"
            }
            {
              lit: "metrics"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /orgs/{org}/copilot/metrics"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 100
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "since"
                or: "since"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "until"
                or: "until"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/copilot/metrics"
          q: {
            exist: [
              "org_id"
              "page"
              "per_page"
              "since"
              "until"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "copilot"
            }
            {
              lit: "metrics"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
      [
        "org"
        "team"
      ]
    ]
  }



}