":4}],\"name\":\"a-custom-model\"}],\"name\":\"neovim\",\"total_engaged_users\":7}],\"languages\":[{\"name\":\"python\",\"total_engaged_users\":10},{\"name\":\"ruby\",\"total_engaged_users\":10}],\"total_engaged_users\":20},\"date\":\"2024-06-24\",\"total_active_users\":24,\"total_engaged_users\":20}]}},\"schema\":{\"items\":{\"additionalProperties\":true,\"description\":\"Copilot usage metrics for a given day.\",\"properties\":{\"copilot_dotcom_chat\":{\"additionalProperties\":true,\"description\":\"Usage metrics for Copilot Chat in GitHub.com\",\"nullable\":true,\"properties\":{\"models\":{\"description\":\"List of model metrics for a custom models and the default model.\",\"items\":{\"properties\":{\"custom_model_training_date\":{\"description\":\"The training date for the custom model (if applicable).\",\"nullable\":true,\"type\":\"string\"},\"is_custom_model\":{\"description\":\"Indicates whether a model is custom or default.\",\"type\":\"boolean\"},\"name\":{\"description\":\"Name of the model used for Copilot Chat. If the default model is used will appear as 'default'.\",\"type\":\"string\"},\"total_chats\":{\"description\":\"Total number of chats initiated by users on github.com.\",\"type\":\"integer\"},\"total_engaged_users\":{\"description\":\"Total number of users who prompted Copilot Chat on github.com at least once for each model.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"total_engaged_users\":{\"description\":\"Total number of users who prompted Copilot Chat on github.com at least once.\",\"type\":\"integer\"}},\"type\":\"object\"},\"copilot_dotcom_pull_requests\":{\"additionalProperties\":true,\"description\":\"Usage metrics for Copilot for pull requests.\",\"nullable\":true,\"properties\":{\"repositories\":{\"description\":\"Repositories in which users used Copilot for Pull Requests to generate pull request summaries\",\"items\":{\"properties\":{\"models\":{\"description\":\"List of model metrics for custom models and the default model.\",\"items\":{\"properties\":{\"custom_model_training_date\":{\"description\":\"The training date for the custom model.\",\"nullable\":true,\"type\":\"string\"},\"is_custom_model\":{\"description\":\"Indicates whether a model is custom or default.\",\"type\":\"boolean\"},\"name\":{\"description\":\"Name of the model used for Copilot pull request summaries. If the default model is used will appear as 'default'.\",\"type\":\"string\"},\"total_engaged_users\":{\"description\":\"The number of users who generated pull request summaries using Copilot for Pull Requests in the given repository and model.\",\"type\":\"integer\"},\"total_pr_summaries_created\":{\"description\":\"The number of pull request summaries generated using Copilot for Pull Requests in the given repository.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"name\":{\"description\":\"Repository name\",\"type\":\"string\"},\"total_engaged_users\":{\"description\":\"The number of users who generated pull request summaries using Copilot for Pull Requests in the given repository.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"total_engaged_users\":{\"description\":\"The number of users who used Copilot for Pull Requests on github.com to generate a pull request summary at least once.\",\"type\":\"integer\"}},\"type\":\"object\"},\"copilot_ide_chat\":{\"additionalProperties\":true,\"description\":\"Usage metrics for Copilot Chat in the IDE.\",\"nullable\":true,\"properties\":{\"editors\":{\"items\":{\"description\":\"Copilot Chat metrics, for active editors.\",\"properties\":{\"models\":{\"description\":\"List of model metrics for custom models and the default model.\",\"items\":{\"properties\":{\"custom_model_training_date\":{\"description\":\"The training date for the custom model.\",\"nullable\":true,\"type\":\"string\"},\"is_custom_model\":{\"description\":\"Indicates whether a model is custom or default.\",\"type\":\"boolean\"},\"name\":{\"description\":\"Name of the model used for Copilot Chat. If the default model is used will appear as 'default'.\",\"type\":\"string\"},\"total_chat_copy_events\":{\"description\":\"The number of times users copied a code suggestion from Copilot Chat using the keyboard, or the 'Copy' UI element, for the given editor.\",\"type\":\"integer\"},\"total_chat_insertion_events\":{\"description\":\"The number of times users accepted a code suggestion from Copilot Chat using the 'Insert Code' UI element, for the given editor.\",\"type\":\"integer\"},\"total_chats\":{\"description\":\"The total number of chats initiated by users in the given editor and model.\",\"type\":\"integer\"},\"total_engaged_users\":{\"description\":\"The number of users who prompted Copilot Chat in the given editor and model.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"name\":{\"description\":\"Name of the given editor.\",\"type\":\"string\"},\"total_engaged_users\":{\"description\":\"The number of users who prompted Copilot Chat in the specified editor.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"total_engaged_users\":{\"description\":\"Total number of users who prompted Copilot Chat in the IDE.\",\"type\":\"integer\"}},\"type\":\"object\"},\"copilot_ide_code_completions\":{\"additionalProperties\":true,\"description\":\"Usage metrics for Copilot editor code completions in the IDE.\",\"nullable\":true,\"properties\":{\"editors\":{\"items\":{\"additionalProperties\":true,\"description\":\"Copilot code completion metrics for active editors.\",\"properties\":{\"models\":{\"description\":\"List of model metrics for custom models and the default model.\",\"items\":{\"properties\":{\"custom_model_training_date\":{\"description\":\"The training date for the custom model.\",\"nullable\":true,\"type\":\"string\"},\"is_custom_model\":{\"description\":\"Indicates whether a model is custom or default.\",\"type\":\"boolean\"},\"languages\":{\"description\":\"Code completion metrics for active languages, for the given editor.\",\"items\":{\"description\":\"Usage metrics for a given language for the given editor for Copilot code completions.\",\"properties\":{\"name\":{\"description\":\"Name of the language used for Copilot code completion suggestions, for the given editor.\",\"type\":\"string\"},\"total_code_acceptances\":{\"description\":\"The number of Copilot code suggestions accepted for the given editor, for the given language. Includes both full and partial acceptances.\",\"type\":\"integer\"},\"total_code_lines_accepted\":{\"description\":\"The number of lines of code accepted from Copilot code suggestions for the given editor, for the given language.\",\"type\":\"integer\"},\"total_code_lines_suggested\":{\"description\":\"The number of lines of code suggested by Copilot code completions for the given editor, for the given language.\",\"type\":\"integer\"},\"total_code_suggestions\":{\"description\":\"The number of Copilot code suggestions generated for the given editor, for the given language.\",\"type\":\"integer\"},\"total_engaged_users\":{\"description\":\"Number of users who accepted at least one Copilot code completion suggestion for the given editor, for the given language. Includes both full and partial acceptances.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"name\":{\"description\":\"Name of the model used for Copilot code completion suggestions. If the default model is used will appear as 'default'.\",\"type\":\"string\"},\"total_engaged_users\":{\"description\":\"Number of users who accepted at least one Copilot code completion suggestion for the given editor, for the given language and model. Includes both full and partial acceptances.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"name\":{\"description\":\"Name of the given editor.\",\"type\":\"string\"},\"total_engaged_users\":{\"description\":\"Number of users who accepted at least one Copilot code completion suggestion for the given editor. Includes both full and partial acceptances.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"languages\":{\"description\":\"Code completion metrics for active languages.\",\"items\":{\"description\":\"Usage metrics for a given language for the given editor for Copilot code completions.\",\"properties\":{\"name\":{\"description\":\"Name of the language used for Copilot code completion suggestions.\",\"type\":\"string\"},\"total_engaged_users\":{\"description\":\"Number of users who accepted at least one Copilot code completion suggestion for the given language. Includes both full and partial acceptances.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"total_engaged_users\":{\"description\":\"Number of users who accepted at least one Copilot code suggestion, across all active editors. Includes both full and partial acceptances.\",\"type\":\"integer\"}},\"type\":\"object\"},\"date\":{\"description\":\"The date for which the usage metrics are aggregated, in `YYYY-MM-DD` format.\",\"format\":\"date\",\"type\":\"string\"},\"total_active_users\":{\"description\":\"The total number of Copilot users with activity belonging to any Copilot feature, globally, for the given day. Includes passive activity such as receiving a code suggestion, as well as engagement activity such as accepting a code suggestion or prompting chat. Does not include authentication events. Is not limited to the individual features detailed on the endpoint.\",\"type\":\"integer\"},\"total_engaged_users\":{\"description\":\"The total number of Copilot users who engaged with any Copilot feature, for the given day. Examples include but are not limited to accepting a code suggestion, prompting Copilot chat, or triggering a PR Summary. Does not include authentication events. Is not limited to the individual features detailed on the endpoint.\",\"type\":\"integer\"}},\"required\":[\"date\"],\"title\":\"Copilot Usage Metrics\",\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Response\"},\"403\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Forbidden\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Resource not found\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Copilot Usage Merics API setting is disabled at the organization or enterprise level.\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Internal Error\"}},\"securitySource\":\"unspecified\"}"
