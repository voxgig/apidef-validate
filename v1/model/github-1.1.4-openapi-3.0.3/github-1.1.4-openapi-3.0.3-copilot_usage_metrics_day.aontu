t_copy_events\":{\"description\":\"The number of times users copied a code suggestion from Copilot Chat using the keyboard, or the 'Copy' UI element, for the given editor.\",\"type\":\"integer\"},\"total_chat_insertion_events\":{\"description\":\"The number of times users accepted a code suggestion from Copilot Chat using the 'Insert Code' UI element, for the given editor.\",\"type\":\"integer\"},\"total_chats\":{\"description\":\"The total number of chats initiated by users in the given editor and model.\",\"type\":\"integer\"},\"total_engaged_users\":{\"description\":\"The number of users who prompted Copilot Chat in the given editor and model.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"name\":{\"description\":\"Name of the given editor.\",\"type\":\"string\"},\"total_engaged_users\":{\"description\":\"The number of users who prompted Copilot Chat in the specified editor.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"total_engaged_users\":{\"description\":\"Total number of users who prompted Copilot Chat in the IDE.\",\"type\":\"integer\"}},\"type\":\"object\"},\"copilot_ide_code_completions\":{\"additionalProperties\":true,\"description\":\"Usage metrics for Copilot editor code completions in the IDE.\",\"nullable\":true,\"properties\":{\"editors\":{\"items\":{\"additionalProperties\":true,\"description\":\"Copilot code completion metrics for active editors.\",\"properties\":{\"models\":{\"description\":\"List of model metrics for custom models and the default model.\",\"items\":{\"properties\":{\"custom_model_training_date\":{\"description\":\"The training date for the custom model.\",\"nullable\":true,\"type\":\"string\"},\"is_custom_model\":{\"description\":\"Indicates whether a model is custom or default.\",\"type\":\"boolean\"},\"languages\":{\"description\":\"Code completion metrics for active languages, for the given editor.\",\"items\":{\"description\":\"Usage metrics for a given language for the given editor for Copilot code completions.\",\"properties\":{\"name\":{\"description\":\"Name of the language used for Copilot code completion suggestions, for the given editor.\",\"type\":\"string\"},\"total_code_acceptances\":{\"description\":\"The number of Copilot code suggestions accepted for the given editor, for the given language. Includes both full and partial acceptances.\",\"type\":\"integer\"},\"total_code_lines_accepted\":{\"description\":\"The number of lines of code accepted from Copilot code suggestions for the given editor, for the given language.\",\"type\":\"integer\"},\"total_code_lines_suggested\":{\"description\":\"The number of lines of code suggested by Copilot code completions for the given editor, for the given language.\",\"type\":\"integer\"},\"total_code_suggestions\":{\"description\":\"The number of Copilot code suggestions generated for the given editor, for the given language.\",\"type\":\"integer\"},\"total_engaged_users\":{\"description\":\"Number of users who accepted at least one Copilot code completion suggestion for the given editor, for the given language. Includes both full and partial acceptances.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"name\":{\"description\":\"Name of the model used for Copilot code completion suggestions. If the default model is used will appear as 'default'.\",\"type\":\"string\"},\"total_engaged_users\":{\"description\":\"Number of users who accepted at least one Copilot code completion suggestion for the given editor, for the given language and model. Includes both full and partial acceptances.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"name\":{\"description\":\"Name of the given editor.\",\"type\":\"string\"},\"total_engaged_users\":{\"description\":\"Number of users who accepted at least one Copilot code completion suggestion for the given editor. Includes both full and partial acceptances.\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"lan