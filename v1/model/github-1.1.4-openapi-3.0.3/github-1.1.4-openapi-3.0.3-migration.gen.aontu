# Entity: migration

main: kit: entity: migration: {

  alias: field: {}

  fields: [
    {
      format: "uri"
      name: "archive_url"
      req: false
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "created_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "exclude"
      req: false
      short: "Exclude related items from being returned in the response in order to improve performance of the request."
      type: "`$ARRAY`"
    }
    {
      name: "exclude_attachments"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      short: "Indicates whether attachments should be excluded from the migration (to reduce migration archive file size)."
      type: "`$BOOLEAN`"
    }
    {
      name: "exclude_git_data"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      short: "Indicates whether the repository git data should be excluded from the migration."
      type: "`$BOOLEAN`"
    }
    {
      name: "exclude_metadata"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      short: "Indicates whether metadata should be excluded and only git source should be included for the migration."
      type: "`$BOOLEAN`"
    }
    {
      name: "exclude_owner_projects"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      short: "Indicates whether projects owned by the organization or users should be excluded."
      type: "`$BOOLEAN`"
    }
    {
      name: "exclude_releases"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      short: "Indicates whether releases should be excluded from the migration (to reduce migration archive file size)."
      type: "`$BOOLEAN`"
    }
    {
      name: "guid"
      req: true
      type: "`$STRING`"
    }
    {
      format: "int64"
      name: "id"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "lock_repositories"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      short: "Indicates whether repositories should be locked (to prevent manipulation) while migrating data."
      type: "`$BOOLEAN`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "org_metadata_only"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      short: "Indicates whether this should only include organization metadata (repositories array should be empty and will ignore other flags)."
      type: "`$BOOLEAN`"
    }
    {
      name: "owner"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      name: "repositories"
      req: true
      short: "The repositories included in the migration."
      type: "`$ARRAY`"
    }
    {
      name: "state"
      req: true
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "updated_at"
      req: true
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "migration"
