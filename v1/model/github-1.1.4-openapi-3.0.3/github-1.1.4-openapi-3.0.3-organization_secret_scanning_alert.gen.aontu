          contract: {
            id: "GET /orgs/{org}/secret-scanning/alerts"
            json: "{\"operationId\":\"secret-scanning/list-alerts-for-org\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"Set to `open` or `resolved` to only list secret scanning alerts in a specific state.\",\"in\":\"query\",\"name\":\"state\",\"required\":false,\"schema\":{\"enum\":[\"open\",\"resolved\"],\"type\":\"string\"}},{\"description\":\"A comma-separated list of secret types to return. All default secret patterns are returned. To return generic patterns, pass the token name(s) in the parameter. See \\\"[Supported secret scanning patterns](https://docs.github.com/code-security/secret-scanning/introduction/supported-secret-scanning-patterns#supported-secrets)\\\" for a complete list of secret types.\",\"in\":\"query\",\"name\":\"secret_type\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"A comma-separated list of resolutions. Only secret scanning alerts with one of these resolutions are listed. Valid resolutions are `false_positive`, `wont_fix`, `revoked`, `pattern_edited`, `pattern_deleted` or `used_in_tests`.\",\"in\":\"query\",\"name\":\"resolution\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"The property to sort the results by. `created` means when the alert was created. `updated` means when the alert was updated or resolved.\",\"in\":\"query\",\"name\":\"sort\",\"required\":false,\"schema\":{\"default\":\"created\",\"enum\":[\"created\",\"updated\"],\"type\":\"string\"}},{\"description\":\"The direction to sort the results by.\",\"in\":\"query\",\"name\":\"direction\",\"required\":false,\"schema\":{\"default\":\"desc\",\"enum\":[\"asc\",\"desc\"],\"type\":\"string\"}},{\"description\":\"The page number of the results to fetch. For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"page\",\"schema\":{\"default\":1,\"type\":\"integer\"}},{\"description\":\"The number of results per page (max 100). For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"per_page\",\"schema\":{\"default\":30,\"type\":\"integer\"}},{\"description\":\"A cursor, as given in the [Link header](https://docs.github.com/rest/guides/using-pagination-in-the-rest-api#using-link-headers). If specified, the query only searches for events before this cursor. To receive an initial cursor on your first request, include an empty \\\"before\\\" query string.\",\"in\":\"query\",\"name\":\"before\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"A cursor, as given in the [Link header](https://docs.github.com/rest/guides/using-pagination-in-the-rest-api#using-link-headers). If specified, the query only searches for events after this cursor.  To receive an initial cursor on your first request, include an empty \\\"after\\\" query string.\",\"in\":\"query\",\"name\":\"after\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"A comma-separated list of validities that, when present, will return alerts that match the validities in this list. Valid options are `active`, `inactive`, and `unknown`.\",\"in\":\"query\",\"name\":\"validity\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"A boolean value representing whether or not to filter alerts by the publicly-leaked tag being present.\",\"in\":\"query\",\"name\":\"is_publicly_leaked\",\"required\":false,\"schema\":{\"default\":false,\"type\":\"boolean\"}},{\"description\":\"A boolean value representing whether or not to filter alerts by the multi-repo tag being present.\",\"in\":\"query\",\"name\":\"is_multi_repo\",\"required\":false,\"schema\":{\"default\":false,\"type\":\"boolean\"}},{\"description\":\"A boolean value representing whether or not to hide literal secrets in the results.\",\"in\":\"query\",\"name\":\"hide_secret\",\"required\":false,\"schema\":{\"default\":false,\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"created_at\":\"2020-11-06T18:48:51Z\",\"first_location_detected\":{\"blob_sha\":\"af5626b4a114abcb82d63db7c8082c3c4756e51b\",\"blob_url\":\"https://api.github.com/repos/octocat/hello-world/git/blobs/af5626b4a114abcb82d63db7c8082c3c4756e51b\",\"commit_sha\":\"f14d7debf9775f957cf4f1e8176da0786431f72b\",\"commit_url\":\"https://api.github.com/repos/octocat/hello-world/git/commits/f14d7debf9775f957cf4f1e8176da0786431f72b\",\"end_column\":64,\"end_line\":1,\"path\":\"/example/secrets.txt\",\"start_column\":1,\"start_line\":1},\"has_more_locations\":true,\"html_url\":\"https://github.com/owner/private-repo/security/secret-scanning/2\",\"is_base64_encoded\":false,\"locations_url\":\"https://api.github.com/repos/owner/private-repo/secret-scanning/alerts/2/locations\",\"multi_repo\":false,\"number\":2,\"publicly_leaked\":false,\"push_protection_bypass_request_comment\":\"Example comment\",\"push_protection_bypass_request_html_url\":\"https://github.com/owner/repo/secret_scanning_exemptions/1\",\"push_protection_bypass_request_reviewer\":{\"avatar_url\":\"https://alambic.github.com/avatars/u/3?\",\"events_url\":\"https://api.github.com/users/octocat/events{/privacy}\",\"followers_url\":\"https://api.github.com/users/octocat/followers\",\"following_url\":\"https://api.github.com/users/octocat/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/octocat/gists{/gist_id}\",\"gravatar_id\":\"\",\"html_url\":\"https://github.com/octocat\",\"id\":3,\"login\":\"octocat\",\"node_id\":\"MDQ6VXNlcjI=\",\"organizations_url\":\"https://api.github.com/users/octocat/orgs\",\"received_events_url\":\"https://api.github.com/users/octocat/received_e