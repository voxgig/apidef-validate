\"type\":\"string\"},\"id\":{\"description\":\"The unique identifier of the network configuration.\",\"example\":\"123ABC456DEF789\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the network configuration.\",\"example\":\"my-network-configuration\",\"type\":\"string\"},\"network_settings_ids\":{\"description\":\"The unique identifier of each network settings in the configuration.\",\"example\":\"123ABC456DEF789\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"id\",\"name\",\"created_on\"],\"title\":\"Hosted compute network configuration\",\"type\":\"object\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
