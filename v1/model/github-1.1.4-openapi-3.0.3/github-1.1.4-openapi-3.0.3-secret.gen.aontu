# Entity: secret

main: kit: entity: secret: {

  alias: field: {}

  fields: {
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "The date and time at which the secret was created, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      t: "`$STRING`"
    }
    encrypted_value: {
      h: "Encrypted Value"
      n: "encrypted_value"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an environment public…"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      syn: true
      t: "`$STRING`"
    }
    key_id: {
      h: "Key Id"
      n: "key_id"
      r: true
      sh: "ID of the key you used to encrypt the secret."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the secret."
      t: "`$STRING`"
    }
    selected_repositories_url: {
      fo: "uri"
      h: "Selected Repositories Url"
      n: "selected_repositories_url"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
        load: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The API URL at which the list of repositories this secret is visible to can be retrieved"
      t: "`$STRING`"
    }
    selected_repository_ids: {
      h: "Selected Repository Ids"
      n: "selected_repository_ids"
      r: false
      sh: "An array of repository ids that can access the organization secret."
      t: "`$ARRAY`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "The date and time at which the secret was last updated, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      t: "`$STRING`"
    }
    visibility: {
      h: "Visibility"
      n: "visibility"
      r: true
      sh: "Visibility of a secret"
      t: "`$STRING`"
    }
  }

