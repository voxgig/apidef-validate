# Entity: dependency_graph

main: kit: entity: dependency_graph: {

  alias: field: {}

  name: "dependency_graph"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /repos/{owner}/{repo}/dependency-graph/snapshots"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/dependency-graph/snapshots"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "dependency-graph"
            }
            {
              lit: "snapshots"
            }
          ]
          select: {
            "$action": "snapshot"
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              detector: "`reqdata.detector`"
              job: "`reqdata.job`"
              manifests: "`reqdata.manifest`"
              metadata: "`reqdata.metadata`"
              ref: "`reqdata.ref`"
              scanned: "`reqdata.scanned`"
              sha: "`reqdata.sha`"
              version: "`reqdata.version`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}