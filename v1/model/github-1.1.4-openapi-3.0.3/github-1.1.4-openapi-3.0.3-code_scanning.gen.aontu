# Entity: code_scanning

main: kit: entity: code_scanning: {

  alias: field: {}

  fields: [
    {
      name: "checkout_uri"
      req: false
      short: "The base directory used in the analysis, as it appears in the SARIF file."
      type: "`$STRING`"
    }
    {
      name: "commit_sha"
      req: true
      short: "The SHA of the commit to which the analysis you are uploading relates."
      type: "`$STRING`"
    }
    {
      name: "ref"
      req: true
      short: "The full Git reference, formatted as `refs/heads/<branch name>`, `refs/tags/<tag>`, `refs/pull/<number>/merge`, or `refs/pull/<number>/head`."
      type: "`$STRING`"
    }
    {
      name: "sarif"
      req: true
      short: "A Base64 string representing the SARIF file to upload."
      type: "`$STRING`"
    }
    {
      name: "started_at"
      req: false
      short: "The time that the analysis run began."
      type: "`$STRING`"
    }
    {
      name: "tool_name"
      req: false
      short: "The name of the tool used to generate the code scanning analysis."
      type: "`$STRING`"
    }
    {
      name: "validate"
      req: false
      short: "Whether the SARIF file will be validated according to the code scanning specifications."
      type: "`$BOOLEAN`"
    }
  ]

  name: "code_scanning"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/code-scanning/sarifs"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "sarifs"
            }
          ]
          select: {
            "$action": "sarif"
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              checkout_uri: "`reqdata.checkout_uri`"
              commit_sha: "`reqdata.commit_sha`"
              ref: "`reqdata.ref`"
              sarif: "`reqdata.sarif`"
              started_at: "`reqdata.started_at`"
              tool_name: "`reqdata.tool_name`"
              validate: "`reqdata.validate`"
            }
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "language"
                orig: "language"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/repos/{owner}/{repo}/code-scanning/codeql/databases/{language}"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "codeql"
            }
            {
              lit: "databases"
            }
            {
              var: "language"
            }
          ]
          select: {
            exist: [
              "language"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
      [
        "repo"
        "databas"
      ]
    ]
  }



}