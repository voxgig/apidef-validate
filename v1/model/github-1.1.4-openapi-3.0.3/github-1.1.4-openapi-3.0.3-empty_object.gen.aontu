    patch: {
      name: "patch"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "PATCH /repos/{owner}/{repo}/code-scanning/default-setup"
            json: "{\"operationId\":\"code-scanning/update-default-setup\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"state\":\"configured\",\"threat_model\":\"remote_and_local\"}}},\"schema\":{\"additionalProperties\":false,\"description\":\"Configuration for code scanning default setup.\",\"properties\":{\"languages\":{\"description\":\"CodeQL languages to be analyzed.\",\"items\":{\"enum\":[\"actions\",\"c-cpp\",\"csharp\",\"go\",\"java-kotlin\",\"javascript-typescript\",\"python\",\"ruby\",\"swift\"],\"type\":\"string\"},\"type\":\"array\"},\"query_suite\":{\"description\":\"CodeQL query suite to be used.\",\"enum\":[\"default\",\"extended\"],\"type\":\"string\"},\"runner_label\":{\"description\":\"Runner label to be used if the runner type is labeled.\",\"example\":\"code-scanning\",\"nullable\":true,\"type\":\"string\"},\"runner_type\":{\"description\":\"Runner type to be used.\",\"enum\":[\"standard\",\"labeled\"],\"type\":\"string\"},\"state\":{\"description\":\"The desired state of code scanning default setup.\",\"enum\":[\"configured\",\"not-configured\"],\"type\":\"string\"},\"threat_model\":{\"description\":\"Threat model to be used for code scanning analysis. Use `remote` to analyze only network sources and `remote_and_local` to include local sources like filesystem access, command-line arguments, database reads, environment variable and standard input.\",\"enum\":[\"remote\",\"remote_and_local\"],\"type\":\"string\"}},\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":null}},\"schema\":{\"additionalProperties\":false,\"description\":\"An object without any properties.\",\"properties\":{},\"title\":\"Empty Object\",\"type\":\"object\"}}},\"description\":\"Response\"},\"202\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"run_id\":42,\"run_url\":\"https://api.github.com/repos/octoorg/octocat/actions/runs/42\"}}},\"schema\":{\"description\":\"You can use `run_url` to track the status of the run. This includes a property status and conclusion.\\nYou should not rely on this always being an actions workflow run object.\",\"properties\":{\"run_id\":{\"description\":\"ID of the corresponding run.\",\"type\":\"integer\"},\"run_url\":{\"description\":\"URL of the corresponding run.\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Response\"},\"403\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Response if the repository is archived or if GitHub Advanced Security is not enabled for this repository\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Resource not found\"},\"409\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Response if there is already a validation run in progress with a different default setup configuration\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Response if the configuration change cannot be made because the repository is not in the required state\"},\"503\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"type\":\"string\"},\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Service unavailable\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "PATCH"
          orig: "/repos/{owner}/{repo}/code-scanning/default-setup"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "default-setup"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              languages: "`reqdata.language`"
              query_suite: "`reqdata.query_suite`"
              runner_label: "`reqdata.runner_label`"
              runner_type: "`reqdata.runner_type`"
              state: "`reqdata.state`"
              threat_model: "`reqdata.threat_model`"
            }
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "environment_id"
                orig: "environment_name"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "secret_name"
                orig: "secret_name"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "PUT /repos/{owner}/{repo}/environments/{environment_name}/secrets/{secret_name}"
            json: "{\"operationId\":\"actions/create-or-update-environment-secret\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the environment. The name must be URL encoded. For example, any slashes in the name must be replaced with `%2F`.\",\"in\":\"path\",\"name\":\"environment_name\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the secret.\",\"in\":\"path\",\"name\":\"secret_name\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"encrypted_value\":\"c2VjcmV0\",\"key_id\":\"012345678912345678\"}}},\"schema\":{\"properties\":{\"encrypted_value\":{\"description\":\"Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an environment public key](https://docs.github.com/rest/actions/secrets#get-an-environment-public-key) endpoint.\",\"pattern\":\"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{4})$\",\"type\":\"string\"},\"key_id\":{\"description\":\"ID of the key you used to encrypt the secret.\",\"type\":\"string\"}},\"required\":[\"encrypted_value\",\"key_id\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":null}},\"schema\":{\"additionalProperties\":false,\"description\":\"An object without any properties.\",\"properties\":{},\"title\":\"Empty Object\",\"type\":\"object\"}}},\"description\":\"Response when creating a secret\"},\"204\":{\"description\":\"Response when updating a secret\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "PUT"
          orig: "/repos/{owner}/{repo}/environments/{environment_name}/secrets/{secret_name}"
          rename: {
            param: {
              environment_name: "environment_id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "environments"
            }
            {
              var: "environment_id"
            }
            {
              lit: "secrets"
            }
            {
              var: "secret_name"
            }
          ]
          select: {
            exist: [
              "environment_id"
              "owner"
              "repo"
              "secret_name"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "secret_name"
                orig: "secret_name"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
