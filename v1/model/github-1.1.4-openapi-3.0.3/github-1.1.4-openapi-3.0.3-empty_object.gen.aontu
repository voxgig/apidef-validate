# Entity: empty_object

main: kit: entity: empty_object: {

  alias: field: {}

  fields: [
    {
      name: "attestations"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "enable_debug_logging"
      req: false
      short: "Whether to enable debug logging for the re-run."
      type: "`$BOOLEAN`"
    }
    {
      name: "encrypted_value"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an environment public key](https://docs.github.com/rest/actions/secrets#get-an-en…"
      type: "`$STRING`"
    }
    {
      name: "include_claim_keys"
      op: {
        update: {
          req: true
          type: "`$ARRAY`"
        }
      }
      req: false
      short: "Array of unique strings."
      type: "`$ARRAY`"
    }
    {
      name: "key_id"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "ID of the key you used to encrypt the secret."
      type: "`$STRING`"
    }
    {
      name: "languages"
      req: false
      short: "CodeQL languages to be analyzed."
      type: "`$ARRAY`"
    }
    {
      name: "name"
      req: true
      short: "The name of the variable."
      type: "`$STRING`"
    }
    {
      name: "query_suite"
      req: false
      short: "CodeQL query suite to be used."
      type: "`$STRING`"
    }
    {
      name: "runner_label"
      req: false
      short: "Runner label to be used if the runner type is labeled."
      type: "`$STRING`"
    }
    {
      name: "runner_type"
      req: false
      short: "Runner type to be used."
      type: "`$STRING`"
    }
    {
      name: "selected_repository_ids"
      req: false
      short: "An array of repository ids that can access the organization variable."
      type: "`$ARRAY`"
    }
    {
      name: "state"
      req: false
      short: "The desired state of code scanning default setup."
      type: "`$STRING`"
    }
    {
      name: "threat_model"
      req: false
      short: "Threat model to be used for code scanning analysis."
      type: "`$STRING`"
    }
    {
      name: "use_default"
      req: true
      short: "Whether to use the default template or not."
      type: "`$BOOLEAN`"
    }
    {
      name: "value"
      req: true
      short: "The value of the variable."
      type: "`$STRING`"
    }
    {
      name: "visibility"
      req: true
      short: "The type of repositories in the organization that can access the variable."
      type: "`$STRING`"
    }
  ]

