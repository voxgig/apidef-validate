# Entity: environment_approval

main: kit: entity: environment_approval: {

  alias: field: {}

  fields: {
    comment: {
      h: "Comment"
      n: "comment"
      r: true
      sh: "The comment submitted with the deployment review"
      t: "`$STRING`"
    }
    environments: {
      h: "Environments"
      n: "environments"
      r: true
      sh: "The list of environments that were approved or rejected"
      t: "`$ARRAY`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "Whether deployment to the environment(s) was approved or rejected or pending (with comments)"
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: true
      sh: "A GitHub user."
      t: "`$OBJECT`"
    }
  }

  name: "environment_approval"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/actions/runs/{run_id}/approvals"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "run_id"
                or: "run_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/actions/runs/{run_id}/approvals"
          q: {
            exist: [
              "owner"
              "repo"
              "run_id"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "runs"
            }
            {
              var: "run_id"
            }
            {
              lit: "approvals"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "run"
      ]
    ]
  }



}