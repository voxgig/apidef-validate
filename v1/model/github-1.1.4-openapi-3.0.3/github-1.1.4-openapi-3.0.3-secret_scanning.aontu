# Entity: secret_scanning

main: kit: entity: secret_scanning: {

  alias: field: {}

  fields: [
    {
      name: "custom_pattern_settings"
      req: false
      short: "Pattern settings for custom patterns."
      type: "`$ARRAY`"
    }
    {
      name: "pattern_config_version"
      req: false
      short: "The updated pattern configuration version."
      type: "`$STRING`"
    }
    {
      name: "provider_pattern_settings"
      req: false
      short: "Pattern settings for provider patterns."
      type: "`$ARRAY`"
    }
  ]

  name: "secret_scanning"
  op: {
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/orgs/{org}/secret-scanning/pattern-configurations"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "secret-scanning"
            }
            {
              lit: "pattern-configurations"
            }
          ]
          select: {
            "$action": "pattern_configuration"
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
    ]
  }



}