# Entity: page

main: kit: entity: page: {

  alias: field: {}

  fields: {
    build_type: {
      h: "Build Type"
      n: "build_type"
      r: false
      sh: "The process in which the Page will be built."
      t: "`$STRING`"
    }
    cname: {
      h: "Cname"
      n: "cname"
      r: true
      sh: "The Pages site's custom domain"
      t: "`$STRING`"
    }
    custom_404: {
      h: "Custom 404"
      n: "custom_404"
      r: true
      sh: "Whether the Page has a custom 404 page."
      t: "`$BOOLEAN`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: false
      sh: "The web address the Page can be accessed from."
      t: "`$STRING`"
    }
    https_certificate: {
      h: "Https Certificate"
      n: "https_certificate"
      r: true
      t: "`$OBJECT`"
    }
    https_enforced: {
      h: "Https Enforced"
      n: "https_enforced"
      r: false
      sh: "Whether https is enabled on the domain"
      t: "`$BOOLEAN`"
    }
    pending_domain_unverified_at: {
      fo: "date-time"
      h: "Pending Domain Unverified At"
      n: "pending_domain_unverified_at"
      r: false
      sh: "The timestamp when a pending domain becomes unverified."
      t: "`$STRING`"
    }
    protected_domain_state: {
      h: "Protected Domain State"
      n: "protected_domain_state"
      r: false
      sh: "The state if the domain is verified"
      t: "`$STRING`"
    }
    public: {
      h: "Public"
      n: "public"
      r: true
      sh: "Whether the GitHub Pages site is publicly visible."
      t: "`$BOOLEAN`"
    }
    source: {
      h: "Source"
      n: "source"
      r: true
      sh: "The source branch and directory used to publish your Pages site."
      t: "`$OBJECT`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      sh: "The status of the most recent build of the Page."
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      sh: "The API address for accessing this Page resource."
      t: "`$STRING`"
    }
  }

  name: "page"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /repos/{owner}/{repo}/pages"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/pages"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "pages"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/pages"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/pages"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "pages"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}