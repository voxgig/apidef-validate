# Entity: selected_action

main: kit: entity: selected_action: {

  alias: field: {}

  fields: {
    github_owned_allowed: {
      h: "Github Owned Allowed"
      n: "github_owned_allowed"
      r: false
      sh: "Whether GitHub-owned actions are allowed."
      t: "`$BOOLEAN`"
    }
    patterns_allowed: {
      h: "Patterns Allowed"
      n: "patterns_allowed"
      r: false
      sh: "Specifies a list of string-matching patterns to allow specific action(s) and reusable workflow(s)."
      t: "`$ARRAY`"
    }
    verified_allowed: {
      h: "Verified Allowed"
      n: "verified_allowed"
      r: false
      sh: "Whether actions from GitHub Marketplace verified creators are allowed."
      t: "`$BOOLEAN`"
    }
  }

  name: "selected_action"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/actions/permissions/selected-actions"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/actions/permissions/selected-actions"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
            {
              lit: "selected-actions"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.patterns_allowed`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /orgs/{org}/actions/permissions/selected-actions"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/orgs/{org}/actions/permissions/selected-actions"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
            {
              lit: "selected-actions"
            }
          ]
          select: {
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.patterns_allowed`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
      [
        "repo"
      ]
    ]
  }



}