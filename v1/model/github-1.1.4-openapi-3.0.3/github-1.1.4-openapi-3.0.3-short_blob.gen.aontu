# Entity: short_blob

main: kit: entity: short_blob: {

  alias: field: {}

  fields: {
    content: {
      h: "Content"
      n: "content"
      r: true
      sh: "The new blob's content."
      t: "`$STRING`"
    }
    encoding: {
      h: "Encoding"
      n: "encoding"
      r: false
      sh: "The encoding used for `content`."
      t: "`$STRING`"
    }
  }

  name: "short_blob"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /repos/{owner}/{repo}/git/blobs"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/git/blobs"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "git"
            }
            {
              lit: "blobs"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}