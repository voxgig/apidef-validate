# Entity: actions_repository_permission

main: kit: entity: actions_repository_permission: {

  alias: field: {}

  fields: {
    allowed_actions: {
      h: "Allowed Actions"
      n: "allowed_actions"
      r: false
      sh: "The permissions policy that controls the actions and reusable workflows that are allowed to run."
      t: "`$STRING`"
    }
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: true
      sh: "Whether GitHub Actions is enabled on the repository."
      t: "`$BOOLEAN`"
    }
    selected_actions_url: {
      h: "Selected Actions Url"
      n: "selected_actions_url"
      r: false
      sh: "The API URL to use to get or set the actions and reusable workflows that are allowed to run, when `allowed_actions` is set to `selected`."
      t: "`$STRING`"
    }
    sha_pinning_required: {
      h: "Sha Pinning Required"
      n: "sha_pinning_required"
      r: false
      sh: "Whether actions must be pinned to a full-length commit SHA."
      t: "`$BOOLEAN`"
    }
  }

  name: "actions_repository_permission"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/actions/permissions"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/actions/permissions"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.repo")]
  ]

}