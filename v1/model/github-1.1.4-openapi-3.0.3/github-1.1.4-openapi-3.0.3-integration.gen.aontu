# Entity: integration

main: kit: entity: integration: {

  alias: field: {}

  fields: [
    {
      name: "apps"
      req: true
      short: "The GitHub Apps that have push access to this branch."
      type: "`$ARRAY`"
    }
    {
      name: "client_id"
      req: false
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "created_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "description"
      req: true
      type: "`$STRING`"
    }
    {
      name: "events"
      req: true
      short: "The list of events for the GitHub app."
      type: "`$ARRAY`"
    }
    {
      format: "uri"
      name: "external_url"
      req: true
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "Unique identifier of the GitHub app"
      type: "`$INTEGER`"
    }
    {
      name: "installations_count"
      req: false
      short: "The number of installations associated with the GitHub app."
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: true
      short: "The name of the GitHub app"
      type: "`$STRING`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "owner"
      req: true
      type: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    {
      name: "permissions"
      req: true
      short: "The set of permissions for the GitHub app"
      type: "`$OBJECT`"
    }
    {
      name: "slug"
      req: false
      short: "The slug name of the GitHub app"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "updated_at"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

