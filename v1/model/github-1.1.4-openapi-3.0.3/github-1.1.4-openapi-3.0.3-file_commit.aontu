# Entity: file_commit

main: kit: entity: file_commit: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: true
      short: "The author of the file."
      type: "`$OBJECT`"
    }
    {
      name: "branch"
      req: false
      short: "The branch name."
      type: "`$STRING`"
    }
