              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /repos/{owner}/{repo}/branches/{branch}/protection/restrictions/apps"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/branches/{branch}/protection/restrictions/apps"
          rename: {
            param: {
              branch: "branch_id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
              lit: "protection"
            }
            {
              lit: "restrictions"
            }
            {
              lit: "apps"
            }
          ]
          select: {
            exist: [
              "branch_id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
