# Entity: integration

main: kit: entity: integration: {

  alias: field: {}

  fields: {
    apps: {
      h: "Apps"
      n: "apps"
      r: true
      sh: "The GitHub Apps that have push access to this branch."
      t: "`$ARRAY`"
    }
    client_id: {
      h: "Client Id"
      n: "client_id"
      r: false
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: true
      t: "`$STRING`"
    }
    events: {
      h: "Events"
      n: "events"
      r: true
      sh: "The list of events for the GitHub app."
      t: "`$ARRAY`"
    }
    external_url: {
      fo: "uri"
      h: "External Url"
      n: "external_url"
      r: true
      t: "`$STRING`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier of the GitHub app"
      t: "`$INTEGER`"
    }
    installations_count: {
      h: "Installations Count"
      n: "installations_count"
      r: false
      sh: "The number of installations associated with the GitHub app."
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the GitHub app"
      t: "`$STRING`"
    }
    node_id: {
      h: "Node Id"
      n: "node_id"
      r: true
      t: "`$STRING`"
    }
    owner: {
      h: "Owner"
      n: "owner"
      r: true
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    permissions: {
      h: "Permissions"
      n: "permissions"
      r: true
      sh: "The set of permissions for the GitHub app"
      t: "`$OBJECT`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: false
      sh: "The slug name of the GitHub app"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "integration"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /repos/{owner}/{repo}/branches/{branch}/protection/restrictions/apps"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "branch_id"
                or: "branch"
                r: true
