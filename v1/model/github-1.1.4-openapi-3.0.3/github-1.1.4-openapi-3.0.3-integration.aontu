                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/repos/{owner}/{repo}/branches/{branch}/protection/restrictions/apps"
          q: {
            exist: [
              "branch_id"
              "owner"
              "repo"
            ]
          }
          r: {
            param: {
              branch: "branch_id"
            }
          }
          s: [
            {
