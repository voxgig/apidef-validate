# Entity: oidc_custom_sub_repo

main: kit: entity: oidc_custom_sub_repo: {

  alias: field: {}

  fields: {
    include_claim_keys: {
      h: "Include Claim Keys"
      n: "include_claim_keys"
      r: false
      sh: "Array of unique strings."
      t: "`$ARRAY`"
    }
    use_default: {
      h: "Use Default"
      n: "use_default"
      r: true
      sh: "Whether to use the default template or not."
      t: "`$BOOLEAN`"
    }
  }

  name: "oidc_custom_sub_repo"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/actions/oidc/customization/sub"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/actions/oidc/customization/sub"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "oidc"
            }
            {
              lit: "customization"
            }
            {
              lit: "sub"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.include_claim_keys`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}