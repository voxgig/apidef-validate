# Entity: git_commit

main: kit: entity: git_commit: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: true
      short: "Identifying information for the git-user"
      type: "`$OBJECT`"
    }
    {
      name: "committer"
      op: {
        create: {
          req: false
          type: "`$OBJECT`"
        }
      }
      req: true
      short: "Identifying information for the git-user"
      type: "`$OBJECT`"
    }
    {
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "message"
      req: true
      short: "Message describing the purpose of the commit"
      type: "`$STRING`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "parents"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
      }
      req: true
      short: "The full SHAs of the commits that were the parents of this commit."
      type: "`$ARRAY`"
    }
    {
      name: "sha"
      req: true
      short: "SHA for the commit"
      type: "`$STRING`"
    }
    {
      name: "signature"
      req: false
      short: "The [PGP signature](https://en.wikipedia.org/wiki/Pretty_Good_Privacy) of the commit."
      type: "`$STRING`"
    }
    {
      name: "tree"
      req: true
      short: "The SHA of the tree object this commit points to"
      type: "`$OBJECT`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "verification"
      req: true
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "git_commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/git/commits"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "git"
            }
            {
              lit: "commits"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "commit_sha"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/git/commits/{commit_sha}"
          rename: {
            param: {
              commit_sha: "id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "git"
            }
            {
              lit: "commits"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}