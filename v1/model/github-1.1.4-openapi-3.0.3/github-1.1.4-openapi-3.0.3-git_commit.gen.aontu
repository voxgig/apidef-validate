# Entity: git_commit

main: kit: entity: git_commit: {

  alias: field: {}

  fields: {
    author: {
      h: "Author"
      n: "author"
      r: true
      sh: "Identifying information for the git-user"
      t: "`$OBJECT`"
    }
    committer: {
      h: "Committer"
      n: "committer"
      op: {
        create: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      sh: "Identifying information for the git-user"
      t: "`$OBJECT`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    message: {
      h: "Message"
      n: "message"
      r: true
      sh: "Message describing the purpose of the commit"
      t: "`$STRING`"
    }
    node_id: {
      h: "Node Id"
      n: "node_id"
      r: true
      t: "`$STRING`"
    }
    parents: {
      h: "Parents"
      n: "parents"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "The full SHAs of the commits that were the parents of this commit."
      t: "`$ARRAY`"
    }
    sha: {
      h: "Sha"
      n: "sha"
      r: true
      sh: "SHA for the commit"
      t: "`$STRING`"
    }
    signature: {
      h: "Signature"
      n: "signature"
      r: false
      sh: "The [PGP signature](https://en.wikipedia.org/wiki/Pretty_Good_Privacy) of the commit."
      t: "`$STRING`"
    }
    tree: {
      h: "Tree"
      n: "tree"
      r: true
      sh: "The SHA of the tree object this commit points to"
      t: "`$OBJECT`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      t: "`$STRING`"
    }
    verification: {
      h: "Verification"
      n: "verification"
      r: true
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "git_commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /repos/{owner}/{repo}/git/commits"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/repos/{owner}/{repo}/git/commits"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "git"
            }
            {
              lit: "commits"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/git/commits/{commit_sha}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "commit_sha"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/git/commits/{commit_sha}"
          q: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          r: {
            param: {
              commit_sha: "id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "git"
            }
            {
              lit: "commits"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}