# Entity: actions_organization_permission

main: kit: entity: actions_organization_permission: {

  alias: field: {}

  fields: [
    {
      name: "allowed_actions"
      req: false
      short: "The permissions policy that controls the actions and reusable workflows that are allowed to run."
      type: "`$STRING`"
    }
    {
      name: "enabled_repositories"
      req: true
      short: "The policy that controls the repositories in the organization that are allowed to run GitHub Actions."
      type: "`$STRING`"
    }
    {
      name: "selected_actions_url"
      req: false
      short: "The API URL to use to get or set the actions and reusable workflows that are allowed to run, when `allowed_actions` is set to `selected`."
      type: "`$STRING`"
    }
    {
      name: "selected_repositories_url"
      req: false
      short: "The API URL to use to get or set the selected repositories that are allowed to run GitHub Actions, when `enabled_repositories` is set to `selected`."
      type: "`$STRING`"
    }
    {
      name: "sha_pinning_required"
      req: false
      short: "Whether actions must be pinned to a full-length commit SHA."
      type: "`$BOOLEAN`"
    }
  ]

  name: "actions_organization_permission"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /orgs/{org}/actions/permissions"
            json: "{\"operationId\":\"actions/get-github-actions-permissions-organization\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"allowed_actions\":\"selected\",\"enabled_repositories\":\"all\",\"selected_actions_url\":\"https://api.github.com/organizations/42/actions/permissions/selected-actions\",\"sha_pinning_required\":true}}},\"schema\":{\"properties\":{\"allowed_actions\":{\"description\":\"The permissions policy that controls the actions and reusable workflows that are allowed to run.\",\"enum\":[\"all\",\"local_only\",\"selected\"],\"type\":\"string\"},\"enabled_repositories\":{\"description\":\"The policy that controls the repositories in the organization that are allowed to run GitHub Actions.\",\"enum\":[\"all\",\"none\",\"selected\"],\"type\":\"string\"},\"selected_actions_url\":{\"description\":\"The API URL to use to get or set the actions and reusable workflows that are allowed to run, when `allowed_actions` is set to `selected`.\",\"type\":\"string\"},\"selected_repositories_url\":{\"description\":\"The API URL to use to get or set the selected repositories that are allowed to run GitHub Actions, when `enabled_repositories` is set to `selected`.\",\"type\":\"string\"},\"sha_pinning_required\":{\"description\":\"Whether actions must be pinned to a full-length commit SHA.\",\"type\":\"boolean\"}},\"required\":[\"enabled_repositories\"],\"type\":\"object\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/orgs/{org}/actions/permissions"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
          ]
          select: {
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
    ]
  }



}