# Entity: dependency_graph_spdx_sbom

main: kit: entity: dependency_graph_spdx_sbom: {

  alias: field: {}

  fields: {
    SPDXID: {
      h: "Spdxid"
      n: "SPDXID"
      r: true
      sh: "The SPDX identifier for the SPDX document."
      t: "`$STRING`"
    }
    comment: {
      h: "Comment"
      n: "comment"
      r: false
      sh: "An optional comment about the SPDX document."
      t: "`$STRING`"
    }
    creationInfo: {
      h: "Creation Info"
      n: "creationInfo"
      r: true
      t: "`$OBJECT`"
    }
    dataLicense: {
      h: "Data License"
      n: "dataLicense"
      r: true
      sh: "The license under which the SPDX document is licensed."
      t: "`$STRING`"
    }
    documentNamespace: {
      h: "Document Namespace"
      n: "documentNamespace"
      r: true
      sh: "The namespace for the SPDX document."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the SPDX document."
      t: "`$STRING`"
    }
    packages: {
      h: "Packages"
      n: "packages"
      r: true
      t: "`$ARRAY`"
    }
    relationships: {
      h: "Relationships"
      n: "relationships"
      r: true
      t: "`$ARRAY`"
    }
    spdxVersion: {
      h: "Spdx Version"
      n: "spdxVersion"
      r: true
      sh: "The version of the SPDX specification that this document conforms to."
      t: "`$STRING`"
    }
  }

  name: "dependency_graph_spdx_sbom"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/dependency-graph/sbom"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/dependency-graph/sbom"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "dependency-graph"
            }
            {
              lit: "sbom"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.sbom`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}