            id: "GET /orgs/{org}/insights/api/user-stats/{user_id}"
            json: "{\"operationId\":\"api-insights/get-user-stats\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The ID of the user to query for stats\",\"in\":\"path\",\"name\":\"user_id\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The minimum timestamp to query for stats. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.\",\"in\":\"query\",\"name\":\"min_timestamp\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The maximum timestamp to query for stats. Defaults to the time 30 days ago. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.\",\"in\":\"query\",\"name\":\"max_timestamp\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"The page number of the results to fetch. For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"page\",\"schema\":{\"default\":1,\"type\":\"integer\"}},{\"description\":\"The number of results per page (max 100). For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"per_page\",\"schema\":{\"default\":30,\"type\":\"integer\"}},{\"description\":\"The direction to sort the results by.\",\"in\":\"query\",\"name\":\"direction\",\"required\":false,\"schema\":{\"default\":\"desc\",\"enum\":[\"asc\",\"desc\"],\"type\":\"string\"}},{\"description\":\"The property to sort the results by.\",\"in\":\"query\",\"name\":\"sort\",\"required\":false,\"schema\":{\"items\":{\"default\":\"total_request_count\",\"enum\":[\"last_rate_limited_timestamp\",\"last_request_timestamp\",\"rate_limited_request_count\",\"subject_name\",\"total_request_count\"],\"type\":\"string\"},\"type\":\"array\"}},{\"description\":\"Providing a substring will filter results where the actor name contains the substring. This is a case-insensitive search.\",\"in\":\"query\",\"name\":\"actor_name_substring\",\"required\":false,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":[{\"actor_id\":954453,\"actor_name\":\"GitHub Actions\",\"actor_type\":\"oauth_app\",\"last_rate_limited_timestamp\":\"2024-09-18T06:30:09Z\",\"last_request_timestamp\":\"2024-09-18T15:43:03Z\",\"oauth_application_id\":1245,\"rate_limited_request_count\":13,\"total_request_count\":544665}]}},\"schema\":{\"description\":\"API Insights usage stats for a user\",\"items\":{\"properties\":{\"actor_id\":{\"format\":\"int64\",\"type\":\"integer\"},\"actor_name\":{\"type\":\"string\"},\"actor_type\":{\"type\":\"string\"},\"integration_id\":{\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"last_rate_limited_timestamp\":{\"nullable\":true,\"type\":\"string\"},\"last_request_timestamp\":{\"type\":\"string\"},\"oauth_application_id\":{\"format\":\"int64\",\"nullable\":true,\"type\":\"integer\"},\"rate_limited_request_count\":{\"type\":\"integer\"},\"total_request_count\":{\"type\":\"integer\"}},\"type\":\"object\"},\"title\":\"User Stats\",\"type\":\"array\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
