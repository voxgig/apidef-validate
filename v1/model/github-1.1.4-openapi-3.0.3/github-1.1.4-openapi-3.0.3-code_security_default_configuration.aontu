              lit: "code-security"
            }
            {
              lit: "configurations"
            }
            {
              lit: "defaults"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /orgs/{org}/code-security/configurations/defaults"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
