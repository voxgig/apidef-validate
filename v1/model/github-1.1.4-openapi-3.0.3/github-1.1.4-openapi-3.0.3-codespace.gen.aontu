  id: {
    field: "id"
    name: "id"
  }

  name: "codespace"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "codespace_name"
                orig: "codespace_name"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "member_id"
                orig: "username"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/orgs/{org}/members/{username}/codespaces/{codespace_name}/stop"
          rename: {
            param: {
              org: "org_id"
              username: "member_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "members"
            }
            {
              var: "member_id"
            }
            {
              lit: "codespaces"
            }
            {
              var: "codespace_name"
            }
            {
              lit: "stop"
            }
          ]
          select: {
            "$action": "stop"
            exist: [
              "codespace_name"
              "member_id"
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "pull_number"
                orig: "pull_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/pulls/{pull_number}/codespaces"
          segments: [
