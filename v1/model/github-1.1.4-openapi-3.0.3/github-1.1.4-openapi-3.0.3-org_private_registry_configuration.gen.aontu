# Entity: org_private_registry_configuration

main: kit: entity: org_private_registry_configuration: {

  alias: field: {}

  fields: {
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the private registry configuration."
      t: "`$STRING`"
    }
    registry_type: {
      h: "Registry Type"
      n: "registry_type"
      r: true
      sh: "The registry type."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      t: "`$STRING`"
    }
    username: {
      h: "Username"
      n: "username"
      r: false
      sh: "The username to use when authenticating with the private registry."
      t: "`$STRING`"
    }
    visibility: {
      h: "Visibility"
      n: "visibility"
