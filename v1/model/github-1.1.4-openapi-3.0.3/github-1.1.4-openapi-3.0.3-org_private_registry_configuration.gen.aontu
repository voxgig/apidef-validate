              }
            ]
          }
          contract: {
            id: "GET /orgs/{org}/private-registries/{secret_name}"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/orgs/{org}/private-registries/{secret_name}"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "private-registries"
            }
            {
              var: "secret_name"
            }
          ]
          select: {
            exist: [
              "org_id"
              "secret_name"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
