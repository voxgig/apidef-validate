# Entity: pending_deployment

main: kit: entity: pending_deployment: {

  alias: field: {}

  fields: [
    {
      name: "current_user_can_approve"
      req: true
      short: "Whether the currently authenticated user can approve the deployment"
      type: "`$BOOLEAN`"
    }
    {
      name: "environment"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "reviewers"
      req: true
      short: "The people or teams that may approve jobs that reference the environment."
      type: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 3
      }
    }
    {
      name: "wait_timer"
      req: true
      short: "The set duration of the wait timer"
      type: "`$INTEGER`"
    }
    {
      format: "date-time"
      name: "wait_timer_started_at"
      req: true
      short: "The time that the wait timer began."
      type: "`$STRING`"
    }
  ]

