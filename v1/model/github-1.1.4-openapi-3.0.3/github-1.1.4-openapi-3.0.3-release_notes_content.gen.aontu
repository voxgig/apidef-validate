# Entity: release_notes_content

main: kit: entity: release_notes_content: {

  alias: field: {}

  fields: {
    body: {
      h: "Body"
      n: "body"
      r: true
      sh: "The generated body describing the contents of the release supporting markdown formatting"
      t: "`$STRING`"
    }
    configuration_file_path: {
      h: "Configuration File Path"
      n: "configuration_file_path"
      r: false
      sh: "Specifies a path to a file in the repository containing configuration settings used for generating the release notes."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The generated name of the release"
      t: "`$STRING`"
    }
    previous_tag_name: {
      h: "Previous Tag Name"
      n: "previous_tag_name"
      r: false
      sh: "The name of the previous tag to use as the starting point for the release notes."
      t: "`$STRING`"
    }
    tag_name: {
      h: "Tag Name"
      n: "tag_name"
      r: true
      sh: "The tag name for the release."
      t: "`$STRING`"
    }
    target_commitish: {
      h: "Target Commitish"
      n: "target_commitish"
      r: false
      sh: "Specifies the commitish value that will be the target for the release's tag."
      t: "`$STRING`"
    }
  }

  name: "release_notes_content"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /repos/{owner}/{repo}/releases/generate-notes"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/releases/generate-notes"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "releases"
            }
            {
              lit: "generate-notes"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}