# Entity: git_tree

main: kit: entity: git_tree: {

  alias: field: {}

  fields: {
    base_tree: {
      h: "Base Tree"
      n: "base_tree"
      r: false
      sh: "The SHA1 of an existing Git tree object which will be used as the base for the new tree."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    sha: {
      h: "Sha"
      n: "sha"
      r: true
      t: "`$STRING`"
    }
    tree: {
      h: "Tree"
      n: "tree"
      r: true
      sh: "Objects specifying a tree structure"
      t: "`$ARRAY`"
    }
    truncated: {
      h: "Truncated"
      n: "truncated"
      r: true
      t: "`$BOOLEAN`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "git_tree"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /repos/{owner}/{repo}/git/trees"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/repos/{owner}/{repo}/git/trees"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "git"
            }
            {
              lit: "trees"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/git/trees/{tree_sha}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "tree_sha"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "recursive"
                or: "recursive"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/git/trees/{tree_sha}"
          q: {
            exist: [
              "id"
              "owner"
              "recursive"
              "repo"
            ]
          }
          r: {
            param: {
              tree_sha: "id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "git"
            }
            {
              lit: "trees"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.repo")]
  ]

}