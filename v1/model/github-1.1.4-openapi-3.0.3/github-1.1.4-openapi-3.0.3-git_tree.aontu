# Entity: git_tree

main: kit: entity: git_tree: {

  alias: field: {}

  fields: {
    base_tree: {
      h: "Base Tree"
      n: "base_tree"
      r: false
      sh: "The SHA1 of an existing Git tree object which will be used as the base for the new tree."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    sha: {
      h: "Sha"
      n: "sha"
      r: true
      t: "`$STRING`"
    }
    tree: {
      h: "Tree"
      n: "tree"
      r: true
      sh: "Objects specifying a tree structure"
      t: "`$ARRAY`"
    }
    truncated: {
      h: "Truncated"
      n: "truncated"
      r: true
      t: "`$BOOLEAN`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "git_tree"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /repos/{owner}/{repo}/git/trees"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/git/trees"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "git"
            }
            {
              lit: "trees"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "tree_sha"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "recursive"
                orig: "recursive"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/git/trees/{tree_sha}"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/git/trees/{tree_sha}"
          rename: {
            param: {
              tree_sha: "id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "git"
            }
            {
              lit: "trees"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "owner"
              "recursive"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}