# Entity: code_scanning_alert_instance

main: kit: entity: code_scanning_alert_instance: {

  alias: field: {}

  fields: {
    analysis_key: {
      h: "Analysis Key"
      n: "analysis_key"
      r: false
      sh: "Identifies the configuration under which the analysis was executed."
      t: "`$STRING`"
    }
    category: {
      h: "Category"
      n: "category"
      r: false
      sh: "Identifies the configuration under which the analysis was executed."
      t: "`$STRING`"
    }
    classifications: {
      h: "Classifications"
      n: "classifications"
      r: false
      sh: "Classifications that have been applied to the file that triggered the alert."
      t: "`$ARRAY`"
    }
    commit_sha: {
      h: "Commit Sha"
      n: "commit_sha"
      r: false
      t: "`$STRING`"
    }
    environment: {
      h: "Environment"
      n: "environment"
      r: false
      sh: "Identifies the variable values associated with the environment in which the analysis that generated this alert instance was performed, such as the language that was analyzed."
      t: "`$STRING`"
    }
    html_url: {
      h: "Html Url"
      n: "html_url"
      r: false
      t: "`$STRING`"
    }
    location: {
      h: "Location"
      n: "location"
      r: false
      sh: "Describe a region within a file for the alert."
      t: "`$OBJECT`"
    }
    message: {
      h: "Message"
      n: "message"
      r: false
      t: "`$OBJECT`"
    }
    ref: {
      h: "Ref"
      n: "ref"
      r: false
      sh: "The Git reference, formatted as `refs/pull/<number>/merge`, `refs/pull/<number>/head`, `refs/heads/<branch name>` or simply `<branch name>`."
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
      sh: "State of a code scanning alert."
      t: "`$STRING`"
    }
  }

  name: "code_scanning_alert_instance"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "alert_number"
                orig: "alert_number"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "pr"
                orig: "pr"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "ref"
                orig: "ref"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/code-scanning/alerts/{alert_number}/instances"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/code-scanning/alerts/{alert_number}/instances"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "alerts"
            }
            {
              var: "alert_number"
            }
            {
              lit: "instances"
            }
          ]
          select: {
            exist: [
              "alert_number"
              "owner"
              "page"
              "per_page"
              "pr"
              "ref"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "alert"
      ]
    ]
  }



}