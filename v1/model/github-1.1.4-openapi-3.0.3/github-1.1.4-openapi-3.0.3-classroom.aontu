# Entity: classroom

main: kit: entity: classroom: {

  alias: field: {}

  fields: [
    {
      name: "archived"
      req: true
      short: "Returns whether classroom is archived or not."
      type: "`$BOOLEAN`"
    }
    {
      name: "avatar_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "Unique identifier of the classroom."
      type: "`$INTEGER`"
    }
    {
      name: "login"
      req: true
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The name of the classroom."
      type: "`$STRING`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "The url of the classroom on GitHub Classroom."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "classroom"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/classrooms"
          parts: [
            "classrooms"
          ]
          select: {
            exist: [
              "page"
              "per_page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "classroom_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/classrooms/{classroom_id}"
          parts: [
            "classrooms"
            "{id}"
          ]
          rename: {
            param: {
              classroom_id: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.organization`"
          }
        }
      ]
    }
  }



}