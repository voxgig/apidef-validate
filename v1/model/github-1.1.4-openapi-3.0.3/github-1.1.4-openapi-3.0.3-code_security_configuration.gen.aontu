            id: "POST /enterprises/{enterprise}/code-security/configurations"
            json: "{\"operationId\":\"code-security/create-configuration-for-enterprise\",\"parameters\":[{\"description\":\"The slug version of the enterprise name.\",\"in\":\"path\",\"name\":\"enterprise\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"summary\":\"Example for a code security configuration\",\"value\":{\"advanced_security\":\"enabled\",\"dependabot_alerts\":\"enabled\",\"dependabot_security_updates\":\"not_set\",\"description\":\"This is a code security configuration for octo-enterprise\",\"name\":\"High rish settings\",\"secret_scanning\":\"enabled\"}}},\"schema\":{\"additionalProperties\":false,\"properties\":{\"advanced_security\":{\"default\":\"disabled\",\"description\":\"The enablement status of GitHub Advanced Security features. `enabled` will enable both Code Security and Secret Protection features.\\n\\n> [!WARNING]\\n> `code_security` and `secret_protection` are deprecated values for this field. Prefer the individual `code_security` and `secret_protection` fields to set the status of these features.\\n\",\"enum\":[\"enabled\",\"disabled\",\"code_security\",\"secret_protection\"],\"type\":\"string\"},\"code_scanning_default_setup\":{\"default\":\"disabled\",\"description\":\"The enablement status of code scanning default setup\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"code_scanning_default_setup_options\":{\"description\":\"Feature options for code scanning default setup\",\"nullable\":true,\"properties\":{\"runner_label\":{\"description\":\"The label of the runner to use for code scanning default setup when runner_type is 'labeled'.\",\"nullable\":true,\"type\":\"string\"},\"runner_type\":{\"description\":\"Whether to use labeled runners or standard GitHub runners.\",\"enum\":[\"standard\",\"labeled\",\"not_set\"],\"type\":\"string\"}},\"type\":\"object\"},\"code_scanning_delegated_alert_dismissal\":{\"default\":\"disabled\",\"description\":\"The enablement status of code scanning delegated alert dismissal\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"code_scanning_options\":{\"description\":\"Security Configuration feature options for code scanning\",\"nullable\":true,\"properties\":{\"allow_advanced\":{\"description\":\"Whether to allow repos which use advanced setup\",\"nullable\":true,\"type\":\"boolean\"}},\"type\":\"object\"},\"code_security\":{\"description\":\"The enablement status of GitHub Code Security features.\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependabot_alerts\":{\"default\":\"disabled\",\"description\":\"The enablement status of Dependabot alerts\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependabot_security_updates\":{\"default\":\"disabled\",\"description\":\"The enablement status of Dependabot security updates\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependency_graph\":{\"default\":\"enabled\",\"description\":\"The enablement status of Dependency Graph\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependency_graph_autosubmit_action\":{\"default\":\"disabled\",\"description\":\"The enablement status of Automatic dependency submission\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependency_graph_autosubmit_action_options\":{\"description\":\"Feature options for Automatic dependency submission\",\"properties\":{\"labeled_runners\":{\"default\":false,\"description\":\"Whether to use runners labeled with 'dependency-submission' or standard GitHub runners.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"description\":{\"description\":\"A description of the code security configuration\",\"maxLength\":255,\"type\":\"string\"},\"enforcement\":{\"default\":\"enforced\",\"description\":\"The enforcement status for a security configuration\",\"enum\":[\"enforced\",\"unenforced\"],\"type\":\"string\"},\"name\":{\"description\":\"The name of the code security configuration. Must be unique within the enterprise.\",\"type\":\"string\"},\"private_vulnerability_reporting\":{\"default\":\"disabled\",\"description\":\"The enablement status of private vulnerability reporting\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_protection\":{\"description\":\"The enablement status of GitHub Secret Protection features.\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning\":{\"default\":\"disabled\",\"description\":\"The enablement status of secret scanning\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_delegated_alert_dismissal\":{\"default\":\"disabled\",\"description\":\"The enablement status of secret scanning delegated alert dismissal\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_generic_secrets\":{\"default\":\"disabled\",\"description\":\"The enablement status of Copilot secret scanning\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_non_provider_patterns\":{\"default\":\"disabled\",\"description\":\"The enablement status of secret scanning non provider patterns\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_push_protection\":{\"default\":\"disabled\",\"description\":\"The enablement status of secret scanning push protection\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_validity_checks\":{\"default\":\"disabled\",\"description\":\"The enablement status of secret scanning validity checks\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"}},\"required\":[\"name\",\"description\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"advanced_security\":\"enabled\",\"code_scanning_default_setup\":\"disabled\",\"code_scanning_delegated_alert_dismissal\":\"disabled\",\"created_at\":\"2024-05-01T00:00:00Z\",\"dependabot_alerts\":\"enabled\",\"dependabot_security_updates\":\"not_set\",\"dependency_graph\":\"enabled\",\"dependency_graph_autosubmit_action\":\"enabled\",\"dependency_graph_autosubmit_action_options\":{\"labeled_runners\":false},\"description\":\"This is a code security configuration for octo-enterprise\",\"enforcement\":\"enforced\",\"html_url\":\"https://github.com/enterprises/octo-enterprise/settings/security_analysis/configurations/1325/edit\",\"id\":1325,\"name\":\"High risk settings\",\"private_vulnerability_reporting\":\"disabled\",\"secret_scanning\":\"enabled\",\"secret_scanning_delegated_alert_dismissal\":\"disabled\",\"secret_scanning_delegated_bypass\":\"disabled\",\"secret_scanning_generic_secrets\":\"disabled\",\"secret_scanning_non_provider_patterns\":\"disabled\",\"secret_scanning_push_protection\":\"disabled\",\"secret_scanning_validity_checks\":\"disabled\",\"target_type\":\"enterprise\",\"updated_at\":\"2024-05-01T00:00:00Z\",\"url\":\"https://api.github.com/enterprises/octo-enterprise/code-security/configurations/1325\"}}},\"schema\":{\"description\":\"A code security configuration\",\"properties\":{\"advanced_security\":{\"description\":\"The enablement status of GitHub Advanced Security\",\"enum\":[\"enabled\",\"disabled\",\"code_security\",\"secret_protection\"],\"type\":\"string\"},\"code_scanning_default_setup\":{\"description\":\"The enablement status of code scanning default setup\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"code_scanning_default_setup_options\":{\"description\":\"Feature options for code scanning default setup\",\"nullable\":true,\"properties\":{\"runner_label\":{\"description\":\"The label of the runner to use for code scanning when runner_type is 'labeled'.\",\"nullable\":true,\"type\":\"string\"},\"runner_type\":{\"description\":\"Whether to use labeled runners or standard GitHub runners.\",\"enum\":[\"standard\",\"labeled\",\"not_set\"],\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"code_scanning_delegated_alert_dismissal\":{\"description\":\"The enablement status of code scanning delegated alert dismissal\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"code_scanning_options\":{\"description\":\"Feature options for code scanning\",\"nullable\":true,\"properties\":{\"allow_advanced\":{\"description\":\"Whether to allow repos which use advanced setup\",\"nullable\":true,\"type\":\"boolean\"}},\"type\":\"object\"},\"created_at\":{\"format\":\"date-time\",\"type\":\"string\"},\"dependabot_alerts\":{\"description\":\"The enablement status of Dependabot alerts\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependabot_security_updates\":{\"description\":\"The enablement status of Dependabot security updates\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependency_graph\":{\"description\":\"The enablement status of Dependency Graph\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependency_graph_autosubmit_action\":{\"description\":\"The enablement status of Automatic dependency submission\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependency_graph_autosubmit_action_options\":{\"description\":\"Feature options for Automatic dependency submission\",\"properties\":{\"labeled_runners\":{\"description\":\"Whether to use runners labeled with 'dependency-submission' or standard GitHub runners.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"description\":{\"description\":\"A description of the code security configuration\",\"type\":\"string\"},\"enforcement\":{\"description\":\"The enforcement status for a security configuration\",\"enum\":[\"enforced\",\"unenforced\"],\"type\":\"string\"},\"html_url\":{\"description\":\"The URL of the configuration\",\"format\":\"uri\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the code security configuration\",\"type\":\"integer\"},\"name\":{\"description\":\"The name of the code security configuration. Must be unique within the organization.\",\"type\":\"string\"},\"private_vulnerability_reporting\":{\"description\":\"The enablement status of private vulnerability reporting\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning\":{\"description\":\"The enablement status of secret scanning\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_delegated_alert_dismissal\":{\"description\":\"The enablement status of secret scanning delegated alert dismissal\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_delegated_bypass\":{\"description\":\"The enablement status of secret scanning delegated bypass\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_delegated_bypass_options\":{\"description\":\"Feature options for secret scanning delegated bypass\",\"properties\":{\"reviewers\":{\"description\":\"The bypass reviewers for secret scanning delegated bypass\",\"items\":{\"properties\":{\"reviewer_id\":{\"description\":\"The ID of the team or role selected as a bypass reviewer\",\"type\":\"integer\"},\"reviewer_type\":{\"description\":\"The type of the bypass reviewer\",\"enum\":[\"TEAM\",\"ROLE\"],\"type\":\"string\"}},\"required\":[\"reviewer_id\",\"reviewer_type\"],\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"secret_scanning_generic_secrets\":{\"description\":\"The enablement status of Copilot secret scanning\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_non_provider_patterns\":{\"description\":\"The enablement status of secret scanning non-provider patterns\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_push_protection\":{\"description\":\"The ena