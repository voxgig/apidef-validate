fault\":\"not_set\",\"description\":\"The enablement status of code scanning delegated alert dismissal\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"code_scanning_options\":{\"description\":\"Security Configuration feature options for code scanning\",\"nullable\":true,\"properties\":{\"allow_advanced\":{\"description\":\"Whether to allow repos which use advanced setup\",\"nullable\":true,\"type\":\"boolean\"}},\"type\":\"object\"},\"code_security\":{\"description\":\"The enablement status of GitHub Code Security features.\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependabot_alerts\":{\"default\":\"disabled\",\"description\":\"The enablement status of Dependabot alerts\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependabot_security_updates\":{\"default\":\"disabled\",\"description\":\"The enablement status of Dependabot security updates\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependency_graph\":{\"default\":\"enabled\",\"description\":\"The enablement status of Dependency Graph\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependency_graph_autosubmit_action\":{\"default\":\"disabled\",\"description\":\"The enablement status of Automatic dependency submission\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"dependency_graph_autosubmit_action_options\":{\"description\":\"Feature options for Automatic dependency submission\",\"properties\":{\"labeled_runners\":{\"default\":false,\"description\":\"Whether to use runners labeled with 'dependency-submission' or standard GitHub runners.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"description\":{\"description\":\"A description of the code security configuration\",\"maxLength\":255,\"type\":\"string\"},\"enforcement\":{\"default\":\"enforced\",\"description\":\"The enforcement status for a security configuration\",\"enum\":[\"enforced\",\"unenforced\"],\"type\":\"string\"},\"name\":{\"description\":\"The name of the code security configuration. Must be unique within the organization.\",\"type\":\"string\"},\"private_vulnerability_reporting\":{\"default\":\"disabled\",\"description\":\"The enablement status of private vulnerability reporting\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_protection\":{\"description\":\"The enablement status of GitHub Secret Protection features.\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning\":{\"default\":\"disabled\",\"description\":\"The enablement status of secret scanning\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_delegated_alert_dismissal\":{\"description\":\"The enablement status of secret scanning delegated alert dismissal\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_delegated_bypass\":{\"default\":\"disabled\",\"description\":\"The enablement status of secret scanning delegated bypass\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_delegated_bypass_options\":{\"description\":\"Feature options for secret scanning delegated bypass\",\"properties\":{\"reviewers\":{\"description\":\"The bypass reviewers for secret scanning delegated bypass\",\"items\":{\"properties\":{\"reviewer_id\":{\"description\":\"The ID of the team or role selected as a bypass reviewer\",\"type\":\"integer\"},\"reviewer_type\":{\"description\":\"The type of the bypass reviewer\",\"enum\":[\"TEAM\",\"ROLE\"],\"type\":\"string\"}},\"required\":[\"reviewer_id\",\"reviewer_type\"],\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"secret_scanning_generic_secrets\":{\"default\":\"disabled\",\"description\":\"The enablement status of Copilot secret scanning\",\"enum\":[\"enabled\",\"disabled\",\"not_set\"],\"type\":\"string\"},\"secret_scanning_non_provider_patterns\":{\"default\":\"disabled\",\"