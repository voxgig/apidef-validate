# Entity: classroom_assignment_grade

main: kit: entity: classroom_assignment_grade: {

  alias: field: {}

  fields: {
    assignment_name: {
      h: "Assignment Name"
      n: "assignment_name"
      r: true
      sh: "Name of the assignment"
      t: "`$STRING`"
    }
    assignment_url: {
      h: "Assignment Url"
      n: "assignment_url"
      r: true
      sh: "URL of the assignment"
      t: "`$STRING`"
    }
    github_username: {
      h: "Github Username"
      n: "github_username"
      r: true
      sh: "GitHub username of the student"
      t: "`$STRING`"
    }
    group_name: {
      h: "Group Name"
      n: "group_name"
      r: false
      sh: "If a group assignment, name of the group the student is in"
      t: "`$STRING`"
    }
    points_available: {
      h: "Points Available"
      n: "points_available"
      r: true
      sh: "Number of points available for the assignment"
      t: "`$INTEGER`"
    }
    points_awarded: {
      h: "Points Awarded"
      n: "points_awarded"
      r: true
      sh: "Number of points awarded to the student"
      t: "`$INTEGER`"
    }
    roster_identifier: {
      h: "Roster Identifier"
      n: "roster_identifier"
      r: true
      sh: "Roster identifier of the student"
      t: "`$STRING`"
    }
    starter_code_url: {
      h: "Starter Code Url"
      n: "starter_code_url"
      r: true
      sh: "URL of the starter code for the assignment"
      t: "`$STRING`"
    }
    student_repository_name: {
      h: "Student Repository Name"
      n: "student_repository_name"
      r: true
      sh: "Name of the student's assignment repository"
      t: "`$STRING`"
    }
    student_repository_url: {
      h: "Student Repository Url"
      n: "student_repository_url"
      r: true
      sh: "URL of the student's assignment repository"
      t: "`$STRING`"
    }
    submission_timestamp: {
      h: "Submission Timestamp"
      n: "submission_timestamp"
      r: true
      sh: "Timestamp of the student's assignment submission"
      t: "`$STRING`"
    }
  }

  name: "classroom_assignment_grade"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "assignment_id"
                orig: "assignment_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /assignments/{assignment_id}/grades"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/assignments/{assignment_id}/grades"
          segments: [
            {
              lit: "assignments"
            }
            {
              var: "assignment_id"
            }
            {
              lit: "grades"
            }
          ]
          select: {
            exist: [
              "assignment_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "assignment"
      ]
    ]
  }



}