                name: "direction"
                orig: "direction"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "pr"
                orig: "pr"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "ref"
                orig: "ref"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "6c81cd8e-b078-4ac3-a3be-1dad7dbd0b53"
                kind: "query"
                name: "sarif_id"
                orig: "sarif_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "created"
