                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "tool_name"
                orig: "tool_name"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/code-scanning/analyses"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "code-scanning"
            "analyses"
          ]
          select: {
            exist: [
              "direction"
              "owner"
              "page"
              "per_page"
              "pr"
              "ref"
              "repo"
              "sarif_id"
              "sort"
              "tool_guid"
              "tool_name"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "analysis_id"
                orig: "analysis_id"
