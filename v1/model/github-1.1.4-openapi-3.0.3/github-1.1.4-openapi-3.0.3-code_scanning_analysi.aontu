      short: "The name of the tool used to generate the code scanning analysis."
      type: "`$STRING`"
    }
    {
      name: "ref"
      req: true
      short: "The Git reference, formatted as `refs/pull/<number>/merge`, `refs/pull/<number>/head`, `refs/heads/<branch name>` or simply `<branch name>`."
      type: "`$STRING`"
    }
    {
      name: "results_count"
      req: true
      short: "The total number of results in the analysis."
      type: "`$INTEGER`"
    }
    {
      name: "rules_count"
      req: true
      short: "The total number of rules used in the analysis."
      type: "`$INTEGER`"
    }
    {
      name: "sarif_id"
      req: true
      short: "An identifier for the upload."
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "url"
      req: true
      short: "The REST API URL of the analysis resource."
      type: "`$STRING`"
    }
    {
      name: "version"
      req: false
      short: "The version of the tool used to generate the code scanning analysis."
      type: "`$STRING`"
    }
    {
      name: "warning"
      req: true
      short: "Warning generated when processing the analysis"
