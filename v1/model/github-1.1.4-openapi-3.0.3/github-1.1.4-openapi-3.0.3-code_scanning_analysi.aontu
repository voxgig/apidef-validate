      req: true
      short: "The SHA of the commit to which the analysis you are uploading relates."
      type: "`$STRING`"
    }
    {
      name: "created_at"
      req: true
      short: "The time that the analysis was created in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
