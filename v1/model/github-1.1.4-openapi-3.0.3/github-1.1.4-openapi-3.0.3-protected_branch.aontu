# Entity: protected_branch

main: kit: entity: protected_branch: {

  alias: field: {}

  fields: {
    allow_deletions: {
      h: "Allow Deletions"
      n: "allow_deletions"
      op: {
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Allows deletion of the protected branch by anyone with write access to the repository."
      t: "`$OBJECT`"
    }
    allow_force_pushes: {
      h: "Allow Force Pushes"
      n: "allow_force_pushes"
      op: {
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Permits force pushes to the protected branch by anyone with write access to the repository."
      t: "`$OBJECT`"
    }
    allow_fork_syncing: {
      h: "Allow Fork Syncing"
      n: "allow_fork_syncing"
      r: false
      sh: "Whether users can pull changes from upstream when the branch is locked."
      t: "`$OBJECT`"
    }
    block_creations: {
      h: "Block Creations"
      n: "block_creations"
      op: {
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "If set to `true`, the `restrictions` branch protection settings which limits who can push will also block pushes which create new branches, unless the push is initiated by a user, team, or app which has the ability to push."
      t: "`$OBJECT`"
    }
    enforce_admins: {
      h: "Enforce Admins"
      n: "enforce_admins"
      r: true
      sh: "Enforce all configured restrictions for administrators."
      t: "`$OBJECT`"
    }
    lock_branch: {
      h: "Lock Branch"
      n: "lock_branch"
      r: false
      sh: "Whether to set the branch as read-only."
      t: "`$OBJECT`"
    }
    required_conversation_resolution: {
      h: "Required Conversation Resolution"
      n: "required_conversation_resolution"
      r: false
      sh: "Requires all conversations on code to be resolved before a pull request can be merged into a branch that matches this rule."
      t: "`$OBJECT`"
    }
    required_linear_history: {
      h: "Required Linear History"
      n: "required_linear_history"
      op: {
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Enforces a linear commit Git history, which prevents anyone from pushing merge commits to a branch."
      t: "`$OBJECT`"
    }
    required_pull_request_reviews: {
      h: "Required Pull Request Reviews"
      n: "required_pull_request_reviews"
      r: true
      sh: "Require at least one approving review on a pull request, before merging."
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 7
      }
    }
    required_signatures: {
      h: "Required Signatures"
      n: "required_signatures"
      r: true
      t: "`$OBJECT`"
    }
    required_status_checks: {
      h: "Required Status Checks"
      n: "required_status_checks"
      r: true
      sh: "Status Check Policy"
      t: "`$OBJECT`"
    }
    restrictions: {
      h: "Restrictions"
      n: "restrictions"
      r: true
      sh: "Branch Restriction Policy"
      t: "`$OBJECT`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      t: "`$STRING`"
    }
  }

  name: "protected_branch"
  op: {
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PUT /repos/{owner}/{repo}/branches/{branch}/protection"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "branch_id"
                or: "branch"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PUT"
          o: "/repos/{owner}/{repo}/branches/{branch}/protection"
          q: {
            exist: [
              "branch_id"
              "owner"
              "repo"
            ]
          }
          r: {
            param: {
              branch: "branch_id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
              lit: "protection"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "branch"
      ]
    ]
  }



}