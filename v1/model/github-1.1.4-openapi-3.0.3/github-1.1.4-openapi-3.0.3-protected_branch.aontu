# Entity: protected_branch

main: kit: entity: protected_branch: {

  alias: field: {}

  fields: [
    {
      name: "allow_deletions"
      op: {
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "allow_force_pushes"
      op: {
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "allow_fork_syncing"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "block_creations"
      op: {
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "enforce_admins"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "lock_branch"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "required_conversation_resolution"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "required_linear_history"
      op: {
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "required_pull_request_reviews"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 7
      }
    }
    {
      name: "required_signatures"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "required_status_checks"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "restrictions"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "protected_branch"
  op: {
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "branch_id"
                orig: "branch"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PUT"
          orig: "/repos/{owner}/{repo}/branches/{branch}/protection"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "branches"
            "{branch_id}"
            "protection"
          ]
          rename: {
            param: {
              branch: "branch_id"
            }
          }
          select: {
            exist: [
              "branch_id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "branch"
      ]
    ]
  }



}