# Entity: secret_scanning_push_protection_bypass

main: kit: entity: secret_scanning_push_protection_bypass: {

  alias: field: {}

  fields: [
    {
      name: "expire_at"
      req: false
      short: "The time that the bypass will expire in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      type: "`$STRING`"
    }
    {
      name: "placeholder_id"
      req: true
      short: "The ID of the push protection bypass placeholder."
      type: "`$STRING`"
    }
    {
      name: "reason"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "The reason for bypassing push protection."
      type: "`$STRING`"
    }
    {
      name: "token_type"
      req: false
      short: "The token type this bypass is for."
      type: "`$STRING`"
    }
  ]

  name: "secret_scanning_push_protection_bypass"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/secret-scanning/push-protection-bypasses"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "secret-scanning"
            }
            {
              lit: "push-protection-bypasses"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}