# Entity: environment

main: kit: entity: environment: {

  alias: field: {}

  fields: [
    {
      name: "created_at"
      req: true
      short: "The time that the environment was created, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "deployment_branch_policy"
      req: true
      short: "The type of deployment branch policy for this environment."
      type: "`$OBJECT`"
    }
    {
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The id of the environment."
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: true
      short: "The name of the environment."
      type: "`$STRING`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "prevent_self_review"
      req: false
      short: "Whether or not a user who created the job is prevented from approving their own job."
      type: "`$BOOLEAN`"
    }
    {
      name: "protection_rules"
      req: false
      short: "Built-in deployment protection rules for the environment."
      type: "`$ARRAY`"
      union: {
        branches: 3
        count: 2
        depth: 8
      }
    }
    {
      name: "reviewers"
      req: false
      short: "The people or teams that may review jobs that reference the environment."
      type: "`$ARRAY`"
    }
    {
      name: "updated_at"
      req: true
      short: "The time that the environment was last updated, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "wait_timer"
      req: false
      short: "The amount of time to delay a job after the job is initially triggered."
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "environment"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "environment_name"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/environments/{environment_name}"
          rename: {
            param: {
              environment_name: "id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "environments"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "environment_name"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PUT"
          orig: "/repos/{owner}/{repo}/environments/{environment_name}"
          rename: {
            param: {
              environment_name: "id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "environments"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              deployment_branch_policy: "`reqdata.deployment_branch_policy`"
              prevent_self_review: "`reqdata.prevent_self_review`"
              reviewers: "`reqdata.reviewer`"
              wait_timer: "`reqdata.wait_timer`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}