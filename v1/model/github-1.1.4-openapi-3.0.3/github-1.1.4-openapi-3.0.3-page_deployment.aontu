# Entity: page_deployment

main: kit: entity: page_deployment: {

  alias: field: {}

  fields: {
    artifact_id: {
      h: "Artifact Id"
      n: "artifact_id"
      r: false
      sh: "The ID of an artifact that contains the .zip or .tar of static assets to deploy."
      t: "`$NUMBER`"
    }
    artifact_url: {
      h: "Artifact Url"
      n: "artifact_url"
      r: false
      sh: "The URL of an artifact that contains the .zip or .tar of static assets to deploy."
      t: "`$STRING`"
    }
    environment: {
      h: "Environment"
      n: "environment"
      r: false
      sh: "The target environment for this GitHub Pages deployment."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The ID of the GitHub Pages deployment."
      t: "`$STRING`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    oidc_token: {
      h: "Oidc Token"
      n: "oidc_token"
      r: true
      sh: "The OIDC token issued by GitHub Actions certifying the origin of the deployment."
      t: "`$STRING`"
    }
    page_url: {
      fo: "uri"
      h: "Page Url"
      n: "page_url"
      r: true
      sh: "The URI to the deployed GitHub Pages."
      t: "`$STRING`"
    }
    pages_build_version: {
      h: "Pages Build Version"
      n: "pages_build_version"
      r: true
      sh: "A unique string that represents the version of the build for this deployment."
      t: "`$STRING`"
    }
    preview_url: {
      fo: "uri"
      h: "Preview Url"
      n: "preview_url"
      r: false
      sh: "The URI to the deployed GitHub Pages preview."
      t: "`$STRING`"
    }
    status_url: {
      fo: "uri"
      h: "Status Url"
      n: "status_url"
      r: true
      sh: "The URI to monitor GitHub Pages deployment status."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "page_deployment"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "artifact_id"
            "artifact_url"
            "environment"
            "oidc_token"
            "pages_build_version"
          ]
          co: {
            id: "POST /repos/{owner}/{repo}/pages/deployments"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/repos/{owner}/{repo}/pages/deployments"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "pages"
            }
            {
              lit: "deployments"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.repo")]
  ]

}