# Entity: git_tag

main: kit: entity: git_tag: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "message"
      req: true
      short: "Message describing the purpose of the tag"
