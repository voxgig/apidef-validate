# Entity: job

main: kit: entity: job: {

  alias: field: {}

  fields: {
    check_run_url: {
      h: "Check Run Url"
      n: "check_run_url"
      r: true
      t: "`$STRING`"
    }
    completed_at: {
      fo: "date-time"
      h: "Completed At"
      n: "completed_at"
      r: true
      sh: "The time that the job finished, in ISO 8601 format."
      t: "`$STRING`"
    }
    conclusion: {
      h: "Conclusion"
      n: "conclusion"
      r: true
      sh: "The outcome of the job."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "The time that the job created, in ISO 8601 format."
      t: "`$STRING`"
    }
    head_branch: {
      h: "Head Branch"
      n: "head_branch"
      r: true
      sh: "The name of the current branch."
      t: "`$STRING`"
    }
    head_sha: {
      h: "Head Sha"
      n: "head_sha"
      r: true
      sh: "The SHA of the commit that is being run."
      t: "`$STRING`"
    }
    html_url: {
      h: "Html Url"
      n: "html_url"
      r: true
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The id of the job."
      t: "`$INTEGER`"
    }
    labels: {
      h: "Labels"
      n: "labels"
      r: true
      sh: "Labels for the workflow job."
      t: "`$ARRAY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the job."
      t: "`$STRING`"
    }
    node_id: {
      h: "Node Id"
      n: "node_id"
      r: true
      t: "`$STRING`"
    }
    run_attempt: {
      h: "Run Attempt"
      n: "run_attempt"
      r: false
      sh: "Attempt number of the associated workflow run, 1 for first attempt and higher if the workflow was re-run."
      t: "`$INTEGER`"
    }
    run_id: {
      h: "Run Id"
      n: "run_id"
      r: true
      sh: "The id of the associated workflow run."
      t: "`$INTEGER`"
    }
    run_url: {
      h: "Run Url"
      n: "run_url"
      r: true
      t: "`$STRING`"
    }
    runner_group_id: {
      h: "Runner Group Id"
      n: "runner_group_id"
      r: true
      sh: "The ID of the runner group to which this job has been assigned."
      t: "`$INTEGER`"
    }
    runner_group_name: {
      h: "Runner Group Name"
      n: "runner_group_name"
      r: true
      sh: "The name of the runner group to which this job has been assigned."
      t: "`$STRING`"
    }
    runner_id: {
      h: "Runner Id"
      n: "runner_id"
      r: true
      sh: "The ID of the runner to which this job has been assigned."
      t: "`$INTEGER`"
    }
    runner_name: {
      h: "Runner Name"
      n: "runner_name"
      r: true
      sh: "The name of the runner to which this job has been assigned."
      t: "`$STRING`"
    }
    started_at: {
      fo: "date-time"
      h: "Started At"
      n: "started_at"
      r: true
      sh: "The time that the job started, in ISO 8601 format."
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      sh: "The phase of the lifecycle that the job is currently in."
      t: "`$STRING`"
    }
    steps: {
      h: "Steps"
      n: "steps"
      r: false
      sh: "Steps in this job."
      t: "`$ARRAY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      t: "`$STRING`"
    }
    workflow_name: {
      h: "Workflow Name"
      n: "workflow_name"
      r: true
      sh: "The name of the workflow."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "job"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "job_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/actions/jobs/{job_id}"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/actions/jobs/{job_id}"
          rename: {
            param: {
              job_id: "id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "jobs"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}