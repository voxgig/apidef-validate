# Entity: code_scanning_sarifs_status

main: kit: entity: code_scanning_sarifs_status: {

  alias: field: {}

  fields: {
    analyses_url: {
      fo: "uri"
      h: "Analyses Url"
      n: "analyses_url"
      r: false
      ro: true
      sh: "The REST API URL for getting the analyses associated with the upload."
      t: "`$STRING`"
    }
    errors: {
      h: "Errors"
      n: "errors"
      r: false
      ro: true
      sh: "Any errors that ocurred during processing of the delivery."
      t: "`$ARRAY`"
    }
    processing_status: {
      h: "Processing Status"
      n: "processing_status"
      r: false
      sh: "`pending` files have not yet been processed, while `complete` means results from the SARIF have been stored."
      t: "`$STRING`"
    }
  }

  name: "code_scanning_sarifs_status"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "sarif_id"
                orig: "sarif_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/code-scanning/sarifs/{sarif_id}"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/code-scanning/sarifs/{sarif_id}"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "sarifs"
            }
            {
              var: "sarif_id"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
              "sarif_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "sarif"
      ]
    ]
  }



}