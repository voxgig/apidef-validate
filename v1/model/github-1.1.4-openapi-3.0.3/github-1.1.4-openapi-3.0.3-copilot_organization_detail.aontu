# Entity: copilot_organization_detail

main: kit: entity: copilot_organization_detail: {

  alias: field: {}

  fields: [
    {
      name: "active_this_cycle"
      req: false
      short: "The number of seats that have used Copilot during the current billing cycle."
      type: "`$INTEGER`"
    }
    {
      name: "added_this_cycle"
      req: false
      short: "Seats added during the current billing cycle."
      type: "`$INTEGER`"
    }
    {
      name: "inactive_this_cycle"
      req: false
      short: "The number of seats that have not used Copilot during the current billing cycle."
      type: "`$INTEGER`"
    }
    {
      name: "pending_cancellation"
      req: false
      short: "The number of seats that are pending cancellation at the end of the current billing cycle."
      type: "`$INTEGER`"
    }
    {
      name: "pending_invitation"
      req: false
      short: "The number of users who have been invited to receive a Copilot seat through this organization."
      type: "`$INTEGER`"
    }
    {
      name: "total"
      req: false
      short: "The total number of seats being billed for the organization as of the current billing cycle."
      type: "`$INTEGER`"
    }
  ]

  name: "copilot_organization_detail"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /orgs/{org}/copilot/billing"
            json: "{\"operationId\":\"copilot/get-copilot-organization-details\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"cli\":\"enabled\",\"ide_chat\":\"enabled\",\"plan_type\":\"business\",\"platform_chat\":\"enabled\",\"public_code_suggestions\":\"block\",\"seat_breakdown\":{\"active_this_cycle\":12,\"added_this_cycle\":9,\"inactive_this_cycle\":11,\"pending_cancellation\":0,\"pending_invitation\":0,\"total\":12},\"seat_management_setting\":\"assign_selected\"}}},\"schema\":{\"additionalProperties\":true,\"description\":\"Information about the seat breakdown and policies set for an organization with a Copilot Business or Copilot Enterprise subscription.\",\"properties\":{\"cli\":{\"description\":\"The organization policy for allowing or disallowing Copilot in the CLI.\",\"enum\":[\"enabled\",\"disabled\",\"unconfigured\"],\"type\":\"string\"},\"ide_chat\":{\"description\":\"The organization policy for allowing or disallowing Copilot Chat in the IDE.\",\"enum\":[\"enabled\",\"disabled\",\"unconfigured\"],\"type\":\"string\"},\"plan_type\":{\"description\":\"The Copilot plan of the organization, or the parent enterprise, when applicable.\",\"enum\":[\"business\",\"enterprise\"],\"type\":\"string\"},\"platform_chat\":{\"description\":\"The organization policy for allowing or disallowing Copilot features on GitHub.com.\",\"enum\":[\"enabled\",\"disabled\",\"unconfigured\"],\"type\":\"string\"},\"public_code_suggestions\":{\"description\":\"The organization policy for allowing or blocking suggestions matching public code (duplication detection filter).\",\"enum\":[\"allow\",\"block\",\"unconfigured\"],\"type\":\"string\"},\"seat_breakdown\":{\"description\":\"The breakdown of Copilot Business seats for the organization.\",\"properties\":{\"active_this_cycle\":{\"description\":\"The number of seats that have used Copilot during the current billing cycle.\",\"type\":\"integer\"},\"added_this_cycle\":{\"description\":\"Seats added during the current billing cycle.\",\"type\":\"integer\"},\"inactive_this_cycle\":{\"description\":\"The number of seats that have not used Copilot during the current billing cycle.\",\"type\":\"integer\"},\"pending_cancellation\":{\"description\":\"The number of seats that are pending cancellation at the end of the current billing cycle.\",\"type\":\"integer\"},\"pending_invitation\":{\"description\":\"The number of users who have been invited to receive a Copilot seat through this organization.\",\"type\":\"integer\"},\"total\":{\"description\":\"The total number of seats being billed for the organization as of the current billing cycle.\",\"type\":\"integer\"}},\"title\":\"Copilot Seat Breakdown\",\"type\":\"object\"},\"seat_management_setting\":{\"description\":\"The mode of assigning new seats.\",\"enum\":[\"assign_all\",\"assign_selected\",\"disabled\",\"unconfigured\"],\"type\":\"string\"}},\"required\":[\"seat_breakdown\",\"public_code_suggestions\",\"seat_management_setting\"],\"title\":\"Copilot Organization Details\",\"type\":\"object\"}}},\"description\":\"OK\"},\"401\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Requires authentication\"},\"403\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Forbidden\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Resource not found\"},\"422\":{\"description\":\"There is a problem with your account's associated payment method.\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Internal Error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/orgs/{org}/copilot/billing"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "copilot"
            }
            {
              lit: "billing"
            }
          ]
          select: {
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.seat_breakdown`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
    ]
  }



}