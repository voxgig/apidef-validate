      n: "use_default"
      r: true
      sh: "Whether to use the default template or not."
      t: "`$BOOLEAN`"
    }
    value: {
      h: "Value"
      n: "value"
      r: true
      sh: "The value of the variable."
      t: "`$STRING`"
    }
    visibility: {
      h: "Visibility"
      n: "visibility"
      r: true
