    }
    runner_type: {
      h: "Runner Type"
      n: "runner_type"
      r: false
      sh: "Runner type to be used."
      t: "`$STRING`"
    }
    selected_repository_ids: {
      h: "Selected Repository Ids"
      n: "selected_repository_ids"
      r: false
      sh: "An array of repository ids that can access the organization variable."
      t: "`$ARRAY`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
