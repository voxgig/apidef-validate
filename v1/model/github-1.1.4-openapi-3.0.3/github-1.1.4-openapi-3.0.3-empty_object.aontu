      h: "Key Id"
      n: "key_id"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "ID of the key you used to encrypt the secret."
      t: "`$STRING`"
    }
    languages: {
