    }
    encrypted_value: {
      h: "Encrypted Value"
      n: "encrypted_value"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an environment public key](https://docs.github.com/rest/actions/secrets#get-an-en…"
      t: "`$STRING`"
    }
    include_claim_keys: {
      h: "Include Claim Keys"
      n: "include_claim_keys"
      op: {
