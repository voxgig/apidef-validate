      n: "query_suite"
      r: false
      sh: "CodeQL query suite to be used."
      t: "`$STRING`"
    }
    runner_label: {
      h: "Runner Label"
      n: "runner_label"
      r: false
      sh: "Runner label to be used if the runner type is labeled."
      t: "`$STRING`"
    }
    runner_type: {
      h: "Runner Type"
      n: "runner_type"
      r: false
      sh: "Runner type to be used."
      t: "`$STRING`"
    }
    selected_repository_ids: {
      h: "Selected Repository Ids"
      n: "selected_repository_ids"
      r: false
      sh: "An array of repository ids that can access the organization secret."
      t: "`$ARRAY`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
      sh: "The desired state of code scanning default setup."
      t: "`$STRING`"
    }
    threat_model: {
