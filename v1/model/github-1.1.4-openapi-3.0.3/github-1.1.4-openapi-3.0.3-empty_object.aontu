    }
    use_default: {
      h: "Use Default"
      n: "use_default"
      r: true
      sh: "Whether to use the default template or not."
      t: "`$BOOLEAN`"
    }
    visibility: {
      h: "Visibility"
      n: "visibility"
      r: true
      sh: "Which type of organization repositories have access to the organization secret."
      t: "`$STRING`"
    }
