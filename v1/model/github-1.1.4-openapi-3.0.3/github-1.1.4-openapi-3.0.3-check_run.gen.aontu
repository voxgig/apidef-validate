n\":\"The name of the check.\",\"example\":\"test-coverage\",\"type\":\"string\"},\"node_id\":{\"example\":\"MDg6Q2hlY2tSdW40\",\"type\":\"string\"},\"output\":{\"properties\":{\"annotations_count\":{\"type\":\"integer\"},\"annotations_url\":{\"format\":\"uri\",\"type\":\"string\"},\"summary\":{\"nullable\":true,\"type\":\"string\"},\"text\":{\"nullable\":true,\"type\":\"string\"},\"title\":{\"nullable\":true,\"type\":\"string\"}},\"required\":[\"title\",\"summary\",\"text\",\"annotations_count\",\"annotations_url\"],\"type\":\"object\"},\"pull_requests\":{\"description\":\"Pull requests that are open with a `head_sha` or `head_branch` that matches the check. The returned pull requests do not necessarily indicate pull requests that triggered the check.\",\"items\":{\"properties\":{\"base\":{\"properties\":{\"ref\":{\"type\":\"string\"},\"repo\":{\"properties\":{\"id\":{\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"required\":[\"id\",\"url\",\"name\"],\"type\":\"object\"},\"sha\":{\"type\":\"string\"}},\"required\":[\"ref\",\"sha\",\"repo\"],\"type\":\"object\"},\"head\":{\"properties\":{\"ref\":{\"type\":\"string\"},\"repo\":{\"properties\":{\"id\":{\"format\":\"int64\",\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"required\":[\"id\",\"url\",\"name\"],\"type\":\"object\"},\"sha\":{\"type\":\"string\"}},\"required\":[\"ref\",\"sha\",\"repo\"],\"type\":\"object\"},\"id\":{\"format\":\"int64\",\"type\":\"integer\"},\"number\":{\"type\":\"integer\"},\"url\":{\"type\":\"string\"}},\"required\":[\"id\",\"number\",\"url\",\"head\",\"base\"],\"title\":\"Pull Request Minimal\",\"type\":\"object\"},\"type\":\"array\"},\"started_at\":{\"example\":\"2018-05-04T01:14:52Z\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"status\":{\"description\":\"The phase of the lifecycle that the check is currently in. Statuses of waiting, requested, and pending are reserved for GitHub Actions check runs.\",\"enum\":[\"queued\",\"in_progress\",\"completed\",\"waiting\",\"requested\",\"pending\"],\"example\":\"queued\",\"type\":\"string\"},\"url\":{\"example\":\"https://api.github.com/repos/github/hello-world/check-runs/4\",\"type\":\"string\"}},\"required\":[\"id\",\"node_id\",\"head_sha\",\"name\",\"url\",\"html_url\",\"details_url\",\"status\",\"conclusion\",\"started_at\",\"completed_at\",\"external_id\",\"check_suite\",\"output\",\"app\",\"pull_requests\"],\"title\":\"CheckRun\",\"type\":\"object\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
