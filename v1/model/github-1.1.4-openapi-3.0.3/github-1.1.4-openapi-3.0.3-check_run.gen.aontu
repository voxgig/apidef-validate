# Entity: check_run

main: kit: entity: check_run: {

  alias: field: {}

  fields: [
    {
      name: "actions"
      req: false
      short: "Displays a button on GitHub that can be clicked to alert your app to do additional tasks."
      type: "`$ARRAY`"
    }
    {
      name: "app"
      req: true
      short: "GitHub apps are a new way to extend GitHub."
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "check_suite"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "completed_at"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The time the check completed."
      type: "`$STRING`"
    }
    {
      name: "conclusion"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "**Required if you provide `completed_at` or a `status` of `completed`**."
      type: "`$STRING`"
    }
    {
      name: "deployment"
      req: true
      short: "A deployment created as the result of an Actions check run from a workflow that references an environment"
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 4
      }
    }
    {
      name: "details_url"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The URL of the integrator's site that has the full details of the check."
      type: "`$STRING`"
    }
    {
      name: "external_id"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "A reference for the run on the integrator's system."
      type: "`$STRING`"
    }
    {
      name: "head_sha"
      req: true
      short: "The SHA of the commit that is being checked."
      type: "`$STRING`"
    }
    {
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The id of the check."
      type: "`$INTEGER`"
    }
    {
      name: "name"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The name of the check."
      type: "`$STRING`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "output"
      req: true
      short: "Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run."
      type: "`$OBJECT`"
    }
    {
      name: "pull_requests"
      req: true
      short: "Pull requests that are open with a `head_sha` or `head_branch` that matches the check."
      type: "`$ARRAY`"
    }
    {
      name: "started_at"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The time that the check run began."
      type: "`$STRING`"
    }
    {
      name: "status"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The phase of the lifecycle that the check is currently in."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "check_run"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/check-runs"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "check-runs"
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "check_run_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/check-runs/{check_run_id}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "check-runs"
            "{id}"
          ]
          rename: {
            param: {
              check_run_id: "id"
            }
          }
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "check_run_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/repos/{owner}/{repo}/check-runs/{check_run_id}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "check-runs"
            "{id}"
          ]
          rename: {
            param: {
              check_run_id: "id"
            }
          }
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}