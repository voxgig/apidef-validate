          contract: {
            id: "GET /orgs/{org}/dependabot/secrets/{secret_name}"
            json: "{\"operationId\":\"dependabot/get-org-secret\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the secret.\",\"in\":\"path\",\"name\":\"secret_name\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"created_at\":\"2019-08-10T14:59:22Z\",\"name\":\"NPM_TOKEN\",\"selected_repositories_url\":\"https://api.github.com/orgs/octo-org/dependabot/secrets/NPM_TOKEN/repositories\",\"updated_at\":\"2020-01-10T14:59:22Z\",\"visibility\":\"selected\"}}},\"schema\":{\"description\":\"Secrets for GitHub Dependabot for an organization.\",\"properties\":{\"created_at\":{\"format\":\"date-time\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the secret.\",\"example\":\"SECRET_TOKEN\",\"type\":\"string\"},\"selected_repositories_url\":{\"example\":\"https://api.github.com/organizations/org/dependabot/secrets/my_secret/repositories\",\"format\":\"uri\",\"type\":\"string\"},\"updated_at\":{\"format\":\"date-time\",\"type\":\"string\"},\"visibility\":{\"description\":\"Visibility of a secret\",\"enum\":[\"all\",\"private\",\"selected\"],\"type\":\"string\"}},\"required\":[\"name\",\"created_at\",\"updated_at\",\"visibility\"],\"title\":\"Dependabot Secret for an Organization\",\"type\":\"object\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/orgs/{org}/dependabot/secrets/{secret_name}"
          rename: {
