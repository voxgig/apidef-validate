# Entity: code_scanning_autofix_commit

main: kit: entity: code_scanning_autofix_commit: {

  alias: field: {}

  fields: {
    message: {
      h: "Message"
      n: "message"
      r: false
      sh: "Commit message to be used."
      t: "`$STRING`"
    }
    target_ref: {
      h: "Target Ref"
      n: "target_ref"
      r: false
      sh: "The Git reference of target branch for the commit."
      t: "`$STRING`"
    }
  }

  name: "code_scanning_autofix_commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /repos/{owner}/{repo}/code-scanning/alerts/{alert_number}/autofix/commits"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "alert_id"
                or: "alert_number"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/repos/{owner}/{repo}/code-scanning/alerts/{alert_number}/autofix/commits"
          q: {
            exist: [
              "alert_id"
              "owner"
              "repo"
            ]
          }
          r: {
            param: {
              alert_number: "alert_id"
            }
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "alerts"
            }
            {
              var: "alert_id"
            }
            {
              lit: "autofix"
            }
            {
              lit: "commits"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.repo")]
  ]

}