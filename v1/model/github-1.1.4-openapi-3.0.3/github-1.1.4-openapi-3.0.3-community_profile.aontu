# Entity: community_profile

main: kit: entity: community_profile: {

  alias: field: {}

  fields: {
    code_of_conduct: {
      h: "Code Of Conduct"
      n: "code_of_conduct"
      r: true
      sh: "Code of Conduct Simple"
      t: "`$OBJECT`"
    }
    code_of_conduct_file: {
      h: "Code Of Conduct File"
      n: "code_of_conduct_file"
      r: true
      t: "`$OBJECT`"
    }
    contributing: {
      h: "Contributing"
      n: "contributing"
      r: true
      t: "`$OBJECT`"
    }
    issue_template: {
      h: "Issue Template"
      n: "issue_template"
      r: true
      t: "`$OBJECT`"
    }
    license: {
      h: "License"
      n: "license"
      r: true
      sh: "License Simple"
      t: "`$OBJECT`"
    }
    pull_request_template: {
      h: "Pull Request Template"
      n: "pull_request_template"
      r: true
      t: "`$OBJECT`"
    }
    readme: {
      h: "Readme"
      n: "readme"
      r: true
      t: "`$OBJECT`"
    }
  }

  name: "community_profile"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/community/profile"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/community/profile"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "community"
            }
            {
              lit: "profile"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.files`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}