# Entity: actions_cache_usage_by_repository

main: kit: entity: actions_cache_usage_by_repository: {

  alias: field: {}

  fields: {
    active_caches_count: {
      h: "Active Caches Count"
      n: "active_caches_count"
      r: true
      sh: "The number of active caches in the repository."
      t: "`$INTEGER`"
    }
    active_caches_size_in_bytes: {
      h: "Active Caches Size In Bytes"
      n: "active_caches_size_in_bytes"
      r: true
      sh: "The sum of the size in bytes of all the active cache items in the repository."
      t: "`$INTEGER`"
    }
    full_name: {
      h: "Full Name"
      n: "full_name"
      r: true
      sh: "The repository owner and name for the cache usage being shown."
      t: "`$STRING`"
    }
  }

  name: "actions_cache_usage_by_repository"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/actions/cache/usage"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/actions/cache/usage"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "cache"
            }
            {
              lit: "usage"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}