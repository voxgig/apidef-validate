# Entity: pending_deployment

main: kit: entity: pending_deployment: {

  alias: field: {}

  fields: {
    current_user_can_approve: {
      h: "Current User Can Approve"
      n: "current_user_can_approve"
      r: true
      sh: "Whether the currently authenticated user can approve the deployment"
      t: "`$BOOLEAN`"
    }
    environment: {
      h: "Environment"
      n: "environment"
      r: true
      t: "`$OBJECT`"
    }
    reviewers: {
      h: "Reviewers"
      n: "reviewers"
      r: true
      sh: "The people or teams that may approve jobs that reference the environment."
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 3
      }
    }
    wait_timer: {
      h: "Wait Timer"
      n: "wait_timer"
      r: true
      sh: "The set duration of the wait timer"
      t: "`$INTEGER`"
    }
    wait_timer_started_at: {
      fo: "date-time"
      h: "Wait Timer Started At"
      n: "wait_timer_started_at"
      r: true
      sh: "The time that the wait timer began."
      t: "`$STRING`"
    }
  }

  name: "pending_deployment"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/actions/runs/{run_id}/pending_deployments"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "run_id"
                or: "run_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/actions/runs/{run_id}/pending_deployments"
          q: {
            exist: [
              "owner"
              "repo"
              "run_id"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "runs"
            }
            {
              var: "run_id"
            }
            {
              lit: "pending_deployments"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "run"
      ]
    ]
  }



}