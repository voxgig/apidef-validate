# Entity: runner_application

main: kit: entity: runner_application: {

  alias: field: {}

  fields: {
    architecture: {
      h: "Architecture"
      n: "architecture"
      r: true
      t: "`$STRING`"
    }
    download_url: {
      h: "Download Url"
      n: "download_url"
      r: true
      t: "`$STRING`"
    }
    filename: {
      h: "Filename"
      n: "filename"
      r: true
      t: "`$STRING`"
    }
    os: {
      h: "Os"
      n: "os"
      r: true
      t: "`$STRING`"
    }
    sha256_checksum: {
