# Entity: runner_application

main: kit: entity: runner_application: {

  alias: field: {}

  fields: {
    architecture: {
      h: "Architecture"
      n: "architecture"
      r: true
      t: "`$STRING`"
    }
    download_url: {
      h: "Download Url"
      n: "download_url"
      r: true
      t: "`$STRING`"
    }
    filename: {
      h: "Filename"
      n: "filename"
      r: true
      t: "`$STRING`"
    }
    os: {
      h: "Os"
      n: "os"
      r: true
      t: "`$STRING`"
    }
    sha256_checksum: {
      h: "Sha256 Checksum"
      n: "sha256_checksum"
      r: false
      t: "`$STRING`"
    }
    temp_download_token: {
      h: "Temp Download Token"
      n: "temp_download_token"
      r: false
      sh: "A short lived bearer token used to download the runner, if needed."
      t: "`$STRING`"
    }
  }

  name: "runner_application"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/actions/runners/downloads"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/actions/runners/downloads"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "runners"
            }
            {
              lit: "downloads"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /orgs/{org}/actions/runners/downloads"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/orgs/{org}/actions/runners/downloads"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "actions"
            }
            {
              lit: "runners"
            }
            {
              lit: "downloads"
            }
          ]
          select: {
            exist: [
              "org_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
      [
        "repo"
      ]
    ]
  }



}