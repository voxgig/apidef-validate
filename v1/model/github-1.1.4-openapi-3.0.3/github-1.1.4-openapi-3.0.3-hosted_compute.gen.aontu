      sh: "The name of the network configuration."
      t: "`$STRING`"
    }
    network_settings_ids: {
      h: "Network Settings Ids"
      n: "network_settings_ids"
      r: false
      sh: "The unique identifier of each network settings in the configuration."
      t: "`$ARRAY`"
    }
  }

