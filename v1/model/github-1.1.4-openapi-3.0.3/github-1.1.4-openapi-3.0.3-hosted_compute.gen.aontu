              }
            ]
          }
          contract: {
            id: "DELETE /orgs/{org}/settings/network-configurations/{network_configuration_id}"
            source: "openapi3"
            version: 2
          }
          method: "DELETE"
          orig: "/orgs/{org}/settings/network-configurations/{network_configuration_id}"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "settings"
            }
            {
              lit: "network-configurations"
