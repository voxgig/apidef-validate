          }
          method: "GET"
          orig: "/orgs/{org}/settings/network-configurations"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "settings"
            }
            {
              lit: "network-configurations"
            }
          ]
          select: {
            exist: [
              "org_id"
              "page"
              "per_page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.network_configurations`"
          }
