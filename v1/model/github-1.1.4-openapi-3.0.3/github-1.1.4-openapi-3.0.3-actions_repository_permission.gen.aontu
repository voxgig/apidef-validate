# Entity: actions_repository_permission

main: kit: entity: actions_repository_permission: {

  alias: field: {}

  fields: [
    {
      name: "allowed_actions"
      req: false
      short: "The permissions policy that controls the actions and reusable workflows that are allowed to run."
      type: "`$STRING`"
    }
    {
      name: "enabled"
      req: true
      short: "Whether GitHub Actions is enabled on the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "selected_actions_url"
      req: false
      short: "The API URL to use to get or set the actions and reusable workflows that are allowed to run, when `allowed_actions` is set to `selected`."
      type: "`$STRING`"
    }
    {
      name: "sha_pinning_required"
      req: false
      short: "Whether actions must be pinned to a full-length commit SHA."
      type: "`$BOOLEAN`"
    }
  ]

  name: "actions_repository_permission"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/actions/permissions"
            json: "{\"operationId\":\"actions/get-github-actions-permissions-repository\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"allowed_actions\":\"selected\",\"enabled\":true,\"selected_actions_url\":\"https://api.github.com/repositories/42/actions/permissions/selected-actions\",\"sha_pinning_required\":true}}},\"schema\":{\"properties\":{\"allowed_actions\":{\"description\":\"The permissions policy that controls the actions and reusable workflows that are allowed to run.\",\"enum\":[\"all\",\"local_only\",\"selected\"],\"type\":\"string\"},\"enabled\":{\"description\":\"Whether GitHub Actions is enabled on the repository.\",\"type\":\"boolean\"},\"selected_actions_url\":{\"description\":\"The API URL to use to get or set the actions and reusable workflows that are allowed to run, when `allowed_actions` is set to `selected`.\",\"type\":\"string\"},\"sha_pinning_required\":{\"description\":\"Whether actions must be pinned to a full-length commit SHA.\",\"type\":\"boolean\"}},\"required\":[\"enabled\"],\"type\":\"object\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/actions/permissions"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}