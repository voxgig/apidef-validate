# Entity: commit

main: kit: entity: commit: {

  alias: field: {}

  fields: {
    author: {
      h: "Author"
      n: "author"
      r: true
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    base: {
      h: "Base"
      n: "base"
      r: true
      sh: "The name of the base branch that the head will be merged into."
      t: "`$STRING`"
    }
    comments_url: {
      fo: "uri"
      h: "Comments Url"
      n: "comments_url"
      r: true
      t: "`$STRING`"
    }
    commit: {
      h: "Commit"
      n: "commit"
      r: true
      t: "`$OBJECT`"
    }
    commit_message: {
      h: "Commit Message"
      n: "commit_message"
      r: false
      sh: "Commit message to use for the merge commit."
      t: "`$STRING`"
    }
    committer: {
      h: "Committer"
      n: "committer"
      r: true
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    files: {
      h: "Files"
      n: "files"
      r: false
      t: "`$ARRAY`"
    }
    head: {
      h: "Head"
      n: "head"
      r: true
      sh: "The head to merge."
      t: "`$STRING`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    node_id: {
      h: "Node Id"
      n: "node_id"
      r: true
      t: "`$STRING`"
    }
    parents: {
      h: "Parents"
      n: "parents"
      r: true
      t: "`$ARRAY`"
    }
    sha: {
      h: "Sha"
      n: "sha"
      r: true
      t: "`$STRING`"
    }
    stats: {
      h: "Stats"
      n: "stats"
      r: false
      t: "`$OBJECT`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /repos/{owner}/{repo}/merges"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/merges"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "merges"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.commit`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "author"
                orig: "author"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "committer"
                orig: "committer"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "path"
                orig: "path"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "sha"
