# Entity: full_repository

main: kit: entity: full_repository: {

  alias: field: {}

  fields: [
    {
      name: "allow_auto_merge"
      req: false
      short: "Either `true` to allow auto-merge on pull requests, or `false` to disallow auto-merge."
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_forking"
      req: false
      short: "Either `true` to allow private forks, or `false` to prevent private forks."
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_merge_commit"
      req: false
      short: "Either `true` to allow merging pull requests with a merge commit, or `false` to prevent merging pull requests with merge commits."
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_rebase_merge"
      req: false
      short: "Either `true` to allow rebase-merging pull requests, or `false` to prevent rebase-merging."
      type: "`$BOOLEAN`"
    }
    {
      name: "allow_squash_merge"
