# Entity: actions_fork_pr_workflows_private_repo

main: kit: entity: actions_fork_pr_workflows_private_repo: {

  alias: field: {}

  fields: {
    require_approval_for_fork_pr_workflows: {
      h: "Require Approval For Fork Pr Workflows"
      n: "require_approval_for_fork_pr_workflows"
      r: true
      sh: "Whether workflows triggered by pull requests from forks require approval from a repository administrator to run."
      t: "`$BOOLEAN`"
    }
    run_workflows_from_fork_pull_requests: {
      h: "Run Workflows From Fork Pull Requests"
      n: "run_workflows_from_fork_pull_requests"
      r: true
      sh: "Whether workflows triggered by pull requests from forks are allowed to run on private repositories."
      t: "`$BOOLEAN`"
    }
    send_secrets_and_variables: {
      h: "Send Secrets And Variables"
      n: "send_secrets_and_variables"
      r: true
      sh: "Whether to make secrets and variables available to workflows triggered by pull requests from forks."
      t: "`$BOOLEAN`"
    }
    send_write_tokens_to_workflows: {
      h: "Send Write Tokens To Workflows"
      n: "send_write_tokens_to_workflows"
      r: true
      sh: "Whether GitHub Actions can create pull requests or submit approving pull request reviews from a workflow triggered by a fork pull request."
      t: "`$BOOLEAN`"
    }
  }

  name: "actions_fork_pr_workflows_private_repo"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/actions/permissions/fork-pr-workflows-private-repos"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/actions/permissions/fork-pr-workflows-private-repos"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
            {
              lit: "fork-pr-workflows-private-repos"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /orgs/{org}/actions/permissions/fork-pr-workflows-private-repos"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/actions/permissions/fork-pr-workflows-private-repos"
          q: {
            exist: [
              "org_id"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
            {
              lit: "fork-pr-workflows-private-repos"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
      [
        "repo"
      ]
    ]
  }



}