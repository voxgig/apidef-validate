# Entity: actions_organization_permission

main: kit: entity: actions_organization_permission: {

  alias: field: {}

  fields: {
    allowed_actions: {
      h: "Allowed Actions"
      n: "allowed_actions"
      r: false
      sh: "The permissions policy that controls the actions and reusable workflows that are allowed to run."
      t: "`$STRING`"
    }
    enabled_repositories: {
      h: "Enabled Repositories"
      n: "enabled_repositories"
      r: true
      sh: "The policy that controls the repositories in the organization that are allowed to run GitHub Actions."
      t: "`$STRING`"
    }
    selected_actions_url: {
      h: "Selected Actions Url"
      n: "selected_actions_url"
      r: false
      sh: "The API URL to use to get or set the actions and reusable workflows that are allowed to run, when `allowed_actions` is set to `selected`."
      t: "`$STRING`"
    }
    selected_repositories_url: {
      h: "Selected Repositories Url"
      n: "selected_repositories_url"
      r: false
      sh: "The API URL to use to get or set the selected repositories that are allowed to run GitHub Actions, when `enabled_repositories` is set to `selected`."
      t: "`$STRING`"
    }
    sha_pinning_required: {
      h: "Sha Pinning Required"
      n: "sha_pinning_required"
      r: false
      sh: "Whether actions must be pinned to a full-length commit SHA."
      t: "`$BOOLEAN`"
    }
  }

  name: "actions_organization_permission"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /orgs/{org}/actions/permissions"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/actions/permissions"
          q: {
            exist: [
              "org_id"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
    ]
  }



}