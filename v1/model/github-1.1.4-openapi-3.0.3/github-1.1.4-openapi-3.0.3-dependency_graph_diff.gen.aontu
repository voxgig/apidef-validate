# Entity: dependency_graph_diff

main: kit: entity: dependency_graph_diff: {

  alias: field: {}

  fields: {
    change_type: {
      h: "Change Type"
      n: "change_type"
      r: true
      t: "`$STRING`"
    }
    ecosystem: {
      h: "Ecosystem"
      n: "ecosystem"
      r: true
      t: "`$STRING`"
    }
    license: {
      h: "License"
      n: "license"
      r: true
      t: "`$STRING`"
    }
    manifest: {
      h: "Manifest"
      n: "manifest"
      r: true
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      t: "`$STRING`"
    }
    package_url: {
      h: "Package Url"
      n: "package_url"
      r: true
      t: "`$STRING`"
    }
    scope: {
      h: "Scope"
      n: "scope"
      r: true
