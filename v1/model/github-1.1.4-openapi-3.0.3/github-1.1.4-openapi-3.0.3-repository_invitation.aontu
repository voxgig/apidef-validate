            source: "openapi3"
            version: 1
          }
          method: "PATCH"
          orig: "/repos/{owner}/{repo}/invitations/{invitation_id}"
          rename: {
            param: {
              invitation_id: "id"
            }
          }
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "invitations"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
