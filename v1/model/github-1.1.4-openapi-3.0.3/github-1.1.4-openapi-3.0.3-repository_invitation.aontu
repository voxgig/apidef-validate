# Entity: repository_invitation

main: kit: entity: repository_invitation: {

  alias: field: {}

  fields: [
    {
      format: "date-time"
      name: "created_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "expired"
      req: false
      short: "Whether or not the invitation has expired"
      type: "`$BOOLEAN`"
    }
    {
      name: "html_url"
      req: true
      type: "`$STRING`"
    }
    {
      format: "int64"
      name: "id"
      req: true
      short: "Unique identifier of the repository invitation."
      type: "`$INTEGER`"
    }
    {
      name: "invitee"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      name: "inviter"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      name: "node_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "permission"
      req: false
      short: "The permission to grant the collaborator."
      type: "`$STRING`"
    }
    {
      name: "permissions"
      op: {
        patch: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The permission associated with the invitation."
      type: "`$STRING`"
    }
    {
      name: "repository"
      req: true
      short: "Minimal Repository"
      type: "`$OBJECT`"
    }
    {
      name: "url"
      req: true
      short: "URL for the repository invitation"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "repository_invitation"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/invitations"
