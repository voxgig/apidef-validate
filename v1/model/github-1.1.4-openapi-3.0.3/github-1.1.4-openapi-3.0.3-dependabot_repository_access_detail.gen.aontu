# Entity: dependabot_repository_access_detail

main: kit: entity: dependabot_repository_access_detail: {

  alias: field: {}

  fields: [
    {
      name: "archive_url"
      req: true
      short: "A template for the API URL to download the repository as an archive."
      type: "`$STRING`"
    }
    {
      name: "assignees_url"
      req: true
      short: "A template for the API URL to list the available assignees for issues in the repository."
      type: "`$STRING`"
    }
    {
      name: "blobs_url"
      req: true
      short: "A template for the API URL to create or retrieve a raw Git blob in the repository."
      type: "`$STRING`"
    }
    {
      name: "branches_url"
      req: true
      short: "A template for the API URL to get information about branches in the repository."
      type: "`$STRING`"
    }
    {
      name: "collaborators_url"
      req: true
      short: "A template for the API URL to get information about collaborators of the repository."
      type: "`$STRING`"
    }
    {
      name: "comments_url"
      req: true
      short: "A template for the API URL to get information about comments on the repository."
      type: "`$STRING`"
    }
    {
      name: "commits_url"
      req: true
      short: "A template for the API URL to get information about commits on the repository."
      type: "`$STRING`"
    }
    {
      name: "compare_url"
      req: true
      short: "A template for the API URL to compare two commits or refs."
      type: "`$STRING`"
    }
    {
      name: "contents_url"
      req: true
      short: "A template for the API URL to get the contents of the repository."
      type: "`$STRING`"
    }
    {
      name: "contributors_url"
      req: true
      short: "A template for the API URL to list the contributors to the repository."
      type: "`$STRING`"
    }
    {
      name: "deployments_url"
      req: true
      short: "The API URL to list the deployments of the repository."
      type: "`$STRING`"
    }
    {
      name: "description"
      req: true
      short: "The repository description."
      type: "`$STRING`"
    }
    {
      name: "downloads_url"
      req: true
      short: "The API URL to list the downloads on the repository."
      type: "`$STRING`"
    }
    {
      name: "events_url"
      req: true
      short: "The API URL to list the events of the repository."
      type: "`$STRING`"
    }
    {
      name: "fork"
      req: true
      short: "Whether the repository is a fork."
      type: "`$BOOLEAN`"
    }
    {
      name: "forks_url"
      req: true
      short: "The API URL to list the forks of the repository."
      type: "`$STRING`"
    }
    {
      name: "full_name"
      req: true
      short: "The full, globally unique, name of the repository."
      type: "`$STRING`"
    }
    {
      name: "git_commits_url"
      req: true
      short: "A template for the API URL to get information about Git commits of the repository."
      type: "`$STRING`"
    }
    {
      name: "git_refs_url"
      req: true
      short: "A template for the API URL to get information about Git refs of the repository."
      type: "`$STRING`"
    }
    {
      name: "git_tags_url"
      req: true
      short: "A template for the API URL to get information about Git tags of the repository."
      type: "`$STRING`"
    }
    {
      name: "hooks_url"
      req: true
      short: "The API URL to list the hooks on the repository."
      type: "`$STRING`"
    }
    {
      name: "html_url"
      req: true
      short: "The URL to view the repository on GitHub.com."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "A unique identifier of the repository."
      type: "`$INTEGER`"
    }
    {
      name: "issue_comment_url"
      req: true
      short: "A template for the API URL to get information about issue comments on the repository."
      type: "`$STRING`"
    }
    {
      name: "issue_events_url"
      req: true
      short: "A template for the API URL to get information about issue events on the repository."
      type: "`$STRING`"
    }
    {
      name: "issues_url"
      req: true
      short: "A template for the API URL to get information about issues on the repository."
      type: "`$STRING`"
    }
    {
      name: "keys_url"
      req: true
      short: "A template for the API URL to get information about deploy keys on the repository."
      type: "`$STRING`"
    }
    {
      name: "labels_url"
      req: true
      short: "A template for the API URL to get information about labels of the repository."
      type: "`$STRING`"
    }
    {
      name: "languages_url"
      req: true
      short: "The API URL to get information about the languages of the repository."
      type: "`$STRING`"
    }
    {
      name: "merges_url"
      req: true
      short: "The API URL to merge branches in the repository."
      type: "`$STRING`"
    }
    {
      name: "milestones_url"
      req: true
      short: "A template for the API URL to get information about milestones of the repository."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The name of the repository."
      type: "`$STRING`"
    }
    {
      name: "node_id"
      req: true
      short: "The GraphQL identifier of the repository."
      type: "`$STRING`"
    }
    {
      name: "notifications_url"
      req: true
      short: "A template for the API URL to get information about notifications on the repository."
      type: "`$STRING`"
    }
    {
      name: "owner"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      name: "private"
      req: true
      short: "Whether the repository is private."
      type: "`$BOOLEAN`"
    }
    {
      name: "pulls_url"
      req: true
      short: "A template for the API URL to get information about pull requests on the repository."
      type: "`$STRING`"
    }
    {
      name: "releases_url"
      req: true
      short: "A template for the API URL to get information about releases on the repository."
      type: "`$STRING`"
    }
    {
      name: "stargazers_url"
      req: true
      short: "The API URL to list the stargazers on the repository."
      type: "`$STRING`"
    }
    {
      name: "statuses_url"
      req: true
      short: "A template for the API URL to get information about statuses of a commit."
      type: "`$STRING`"
    }
    {
      name: "subscribers_url"
      req: true
      short: "The API URL to list the subscribers on the repository."
      type: "`$STRING`"
    }
    {
      name: "subscription_url"
      req: true
      short: "The API URL to subscribe to notifications for this repository."
      type: "`$STRING`"
    }
    {
      name: "tags_url"
      req: true
      short: "The API URL to get information about tags on the repository."
      type: "`$STRING`"
    }
    {
      name: "teams_url"
      req: true
      short: "The API URL to list the teams on the repository."
      type: "`$STRING`"
    }
    {
      name: "trees_url"
      req: true
      short: "A template for the API URL to create or retrieve a raw Git tree of the repository."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "The URL to get more information about the repository from the GitHub API."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "dependabot_repository_access_detail"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/organizations/{org}/dependabot/repository-access"
          segments: [
            {
              lit: "organizations"
            }
            {
              var: "org"
            }
            {
              lit: "dependabot"
            }
            {
              lit: "repository-access"
            }
          ]
          select: {
            exist: [
              "org"
              "page"
              "per_page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.accessible_repositories`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "organization"
      ]
    ]
  }



}