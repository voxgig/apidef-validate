  id: {
    field: "id"
    name: "id"
  }

  name: "app"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "code"
                orig: "code"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /app-manifests/{code}/conversions"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/app-manifests/{code}/conversions"
          segments: [
            {
              lit: "app-manifests"
            }
            {
              var: "code"
            }
            {
              lit: "conversions"
            }
          ]
          select: {
            exist: [
              "code"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "delivery_id"
                orig: "delivery_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "POST /app/hook/deliveries/{delivery_id}/attempts"
            source: "openapi3"
            version: 2
          }
          method: "POST"
          orig: "/app/hook/deliveries/{delivery_id}/attempts"
          segments: [
            {
              lit: "app"
            }
            {
              lit: "hook"
            }
            {
              lit: "deliveries"
            }
            {
              var: "delivery_id"
            }
            {
              lit: "attempts"
            }
          ]
          select: {
            exist: [
              "delivery_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                example: 1
                kind: "param"
                name: "installation_id"
                orig: "installation_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 30
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /user/installations/{installation_id}/repositories"
            source: "openapi3"
            version: 2
          }
          method: "GET"
          orig: "/user/installations/{installation_id}/repositories"
          segments: [
            {
              lit: "user"
            }
            {
              lit: "installations"
            }
            {
              var: "installation_id"
            }
            {
              lit: "repositories"
            }
          ]
          select: {
            exist: [
              "installation_id"
              "page"
              "per_page"
            ]
