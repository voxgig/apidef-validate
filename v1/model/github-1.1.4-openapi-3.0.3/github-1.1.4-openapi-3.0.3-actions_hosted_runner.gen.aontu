"example\":\"2022-10-09T23:39:01Z\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"machine_size_details\":{\"description\":\"Provides details of a particular machine spec.\",\"properties\":{\"cpu_cores\":{\"description\":\"The number of cores.\",\"example\":8,\"type\":\"integer\"},\"id\":{\"description\":\"The ID used for the `size` parameter when creating a new runner.\",\"example\":\"8-core\",\"type\":\"string\"},\"memory_gb\":{\"description\":\"The available RAM for the machine spec.\",\"example\":32,\"type\":\"integer\"},\"storage_gb\":{\"description\":\"The available SSD storage for the machine spec.\",\"example\":300,\"type\":\"integer\"}},\"required\":[\"id\",\"cpu_cores\",\"memory_gb\",\"storage_gb\"],\"title\":\"Github-owned VM details.\",\"type\":\"object\"},\"maximum_runners\":{\"default\":10,\"description\":\"The maximum amount of hosted runners. Runners will not scale automatically above this number. Use this setting to limit your cost.\",\"example\":5,\"type\":\"integer\"},\"name\":{\"description\":\"The name of the hosted runner.\",\"example\":\"my-github-hosted-runner\",\"type\":\"string\"},\"platform\":{\"description\":\"The operating system of the image.\",\"example\":\"linux-x64\",\"type\":\"string\"},\"public_ip_enabled\":{\"description\":\"Whether public IP is enabled for the hosted runners.\",\"example\":true,\"type\":\"boolean\"},\"public_ips\":{\"description\":\"The public IP ranges when public IP is enabled for the hosted runners.\",\"items\":{\"description\":\"Provides details of Public IP for a GitHub-hosted larger runners\",\"properties\":{\"enabled\":{\"description\":\"Whether public IP is enabled.\",\"example\":true,\"type\":\"boolean\"},\"length\":{\"description\":\"The length of the IP prefix.\",\"example\":28,\"type\":\"integer\"},\"prefix\":{\"description\":\"The prefix for the public IP.\",\"example\":\"20.80.208.150\",\"type\":\"string\"}},\"title\":\"Public IP for a GitHub-hosted larger runners.\",\"type\":\"ob