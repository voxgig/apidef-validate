# Entity: actions_hosted_runner

main: kit: entity: actions_hosted_runner: {

  alias: field: {}

  fields: [
    {
      name: "enable_static_ip"
      req: false
      short: "Whether this runner should be created with a static public IP."
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the hosted runner."
      type: "`$INTEGER`"
    }
    {
      name: "image"
      req: true
      short: "The image of runner."
      type: "`$OBJECT`"
    }
    {
      name: "image_details"
      req: true
      short: "Provides details of a hosted runner image"
      type: "`$OBJECT`"
    }
    {
      format: "date-time"
      name: "last_active_on"
      req: false
      short: "The time at which the runner was last used, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "machine_size_details"
      req: true
      short: "Provides details of a particular machine spec."
      type: "`$OBJECT`"
    }
    {
      name: "maximum_runners"
      req: false
      short: "The maximum amount of hosted runners."
      type: "`$INTEGER`"
    }
    {
      name: "name"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The name of the hosted runner."
      type: "`$STRING`"
    }
    {
      name: "platform"
      req: true
      short: "The operating system of the image."
      type: "`$STRING`"
    }
    {
      name: "public_ip_enabled"
      req: true
      short: "Whether public IP is enabled for the hosted runners."
      type: "`$BOOLEAN`"
    }
    {
      name: "public_ips"
      req: false
      short: "The public IP ranges when public IP is enabled for the hosted runners."
      type: "`$ARRAY`"
    }
    {
      name: "runner_group_id"
      op: {
        create: {
          req: true
          type: "`$INTEGER`"
        }
      }
      req: false
      short: "The unique identifier of the group that the hosted runner belongs to."
      type: "`$INTEGER`"
    }
    {
      name: "size"
      req: true
      short: "The machine size of the runner."
      type: "`$STRING`"
    }
    {
      name: "status"
      req: true
      short: "The status of the runner."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "actions_hosted_runner"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /orgs/{org}/actions/hosted-runners"
            json: "{\"operationId\":\"actions/create-hosted-runner-for-org\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"enable_static_ip\":false,\"image\":{\"id\":\"ubuntu-latest\",\"source\":\"github\"},\"maximum_runners\":50,\"name\":\"My Hosted runner\",\"runner_group_id\":1,\"size\":\"4-core\"}}},\"schema\":{\"properties\":{\"enable_static_ip\":{\"description\":\"Whether this runner should be created with a static public IP. Note limit on account. To list limits on account, use `GET actions/hosted-runners/limits`\",\"type\":\"boolean\"},\"image\":{\"description\":\"The image of runner. To list all available images, use `GET /actions/hosted-runners/images/github-owned` or `GET /actions/hosted-runners/images/partner`.\",\"properties\":{\"id\":{\"description\":\"The unique identifier of the runner image.\",\"type\":\"string\"},\"source\":{\"description\":\"The source of the runner image.\",\"enum\":[\"github\",\"partner\",\"custom\"],\"type\":\"string\"}},\"type\":\"object\"},\"maximum_runners\":{\"description\":\"The maximum amount of runners to scale up to. Runners will not auto-scale above this number. Use this setting to limit your cost.\",\"type\":\"integer\"},\"name\":{\"description\":\"Name of the runner. Must be between 1 and 64 characters and may only contain upper and lowercase letters a-z, numbers 0-9, '.', '-', and '_'.\",\"type\":\"string\"},\"runner_group_id\":{\"description\":\"The existing runner group to add this runner to.\",\"type\":\"integer\"},\"size\":{\"description\":\"The machine size of the runner. To list available sizes, use `GET actions/hosted-runners/machine-sizes`\",\"type\":\"string\"}},\"required\":[\"name\",\"image\",\"size\",\"runner_group_id\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"id\":5,\"image\":{\"id\":\"ubuntu-20.04\",\"size\":86},\"last_active_on\":\"2022-10-09T23:39:01Z\",\"machine_size_details\":{\"cpu_cores\":4,\"id\":\"4-core\",\"memory_gb\":16,\"storage_gb\":150},\"maximum_runners\":10,\"name\":\"My hosted ubuntu runner\",\"platform\":\"linux-x64\",\"public_ip_enabled\":true,\"public_ips\":[{\"enabled\":true,\"length\":31,\"prefix\":\"20.80.208.150\"}],\"runner_group_id\":2,\"status\":\"Ready\"}}},\"schema\":{\"description\":\"A Github-hosted hosted runner.\",\"properties\":{\"id\":{\"description\":\"The unique identifier of the hosted runner.\",\"example\":5,\"type\":\"integer\"},\"image_details\":{\"description\":\"Provides details of a hosted runner image\",\"nullable\":true,\"properties\":{\"display_name\":{\"description\":\"Display name for this image.\",\"example\":20.04,\"type\":\"string\"},\"id\":{\"description\":\"The ID of the image. Use this ID for the `image` parameter when creating a new larger runner.\",\"example\":\"ubuntu-20.04\",\"type\":\"string\"},\"size_gb\":{\"description\":\"Image size in GB.\",\"example\":86,\"type\":\"integer\"},\"source\":{\"description\":\"The image provider.\",\"enum\":[\"github\",\"partner\",\"custom\"],\"type\":\"string\"}},\"required\":[\"id\",\"size_gb\",\"display_name\",\"source\"],\"title\":\"GitHub-hosted runner image details.\",\"type\":\"object\"},\"last_active_on\":{\"description\":\"The time at which the runner was last used, in ISO 8601 format.\",\"example\":\"2022-10-09T23:39:01Z\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"machine_size_details\":{\"description\":\"Provides details of a particular machine spec.\",\"properties\":{\"cpu_cores\":{\"description\":\"The number of cores.\",\"example\":8,\"type\":\"integer\"},\"id\":{\"description\":\"The ID used for the `size` parameter when creating a new runner.\",\"example\":\"8-core\",\"type\":\"string\"},\"memory_gb\":{\"description\":\"The available RAM for the machine spec.\",\"example\":32,\"type\":\"integer\"},\"storage_gb\":{\"description\":\"The available SSD storage for the machine spec.\",\"example\":300,\"type\":\"integer\"}},\"required\":[\"id\",\"cpu_cores\",\"memory_gb\",\"storage_gb\"],\"title\":\"Github-owned VM details.\",\"type\":\"object\"},\"maximum_runners\":{\"default\":10,\"description\":\"The maximum amount of hosted runners. Runners will not scale automatically above this number. Use this setting to limit your cost.\",\"example\":5,\"type\":\"integer\"},\"name\":{\"description\":\"The name of the hosted runner.\",\"example\":\"my-github-hosted-runner\",\"type\":\"string\"},\"platform\":{\"description\":\"The operating system of the image.\",\"example\":\"linux-x64\",\"type\":\"string\"},\"public_ip_enabled\":{\"description\":\"Whether public IP is enabled for the hosted runners.\",\"example\":true,\"type\":\"boolean\"},\"public_ips\":{\"description\":\"The public IP ranges when public IP is enabled for the hosted runners.\",\"items\":{\"description\":\"Provides details of Public IP for a GitHub-hosted larger runners\",\"properties\":{\"enabled\":{\"description\":\"Whether public IP is enabled.\",\"example\":true,\"type\":\"boolean\"},\"length\":{\"description\":\"The length of the IP prefix.\",\"example\":28,\"type\":\"integer\"},\"prefix\":{\"description\":\"The prefix for the public IP.\",\"example\":\"20.80.208.150\",\"type\":\"string\"}},\"title\":\"Public IP for a GitHub-hosted larger runners.\",\"type\":\"object\"},\"type\":\"array\"},\"runner_group_id\":{\"description\":\"The unique identifier of the group that the hosted runner belongs to.\",\"example\":2,\"type\":\"integer\"},\"status\":{\"description\":\"The status of the runner.\",\"enum\":[\"Ready\",\"Provisioning\",\"Shutdown\",\"Deleting\",\"Stuck\"],\"example\":\"Ready\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"image_details\",\"machine_size_details\",\"status\",\"public_ip_enabled\",\"platform\"],\"title\":\"GitHub-hosted hosted runner\",\"type\":\"object\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
