          contract: {
            id: "PATCH /orgs/{org}/projectsV2/{project_number}/items/{item_id}"
            json: "{\"operationId\":\"projects/update-item-for-org\",\"parameters\":[{\"description\":\"The project's number.\",\"in\":\"path\",\"name\":\"project_number\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The unique identifier of the project item.\",\"in\":\"path\",\"name\":\"item_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"date_field\":{\"summary\":\"Update a date field\",\"value\":{\"fields\":[{\"id\":789,\"value\":\"2023-10-05\"}]}},\"iteration_field\":{\"summary\":\"Update an iteration field\",\"value\":{\"fields\":[{\"id\":1011,\"value\":\"866ee5b8\"}]}},\"number_field\":{\"summary\":\"Update a number field\",\"value\":{\"fields\":[{\"id\":456,\"value\":42.5}]}},\"single_select_field\":{\"summary\":\"Update a single select field\",\"value\":{\"fields\":[{\"id\":789,\"value\":\"47fc9ee4\"}]}},\"text_field\":{\"summary\":\"Update a text field\",\"value\":{\"fields\":[{\"id\":123,\"value\":\"Updated text value\"}]}}},\"schema\":{\"properties\":{\"fields\":{\"description\":\"A list of field updates to apply.\",\"items\":{\"properties\":{\"id\":{\"description\":\"The ID of the project field to update.\",\"type\":\"integer\"},\"value\":{\"description\":\"The new value for the field:\\n- For text, number, and date fields, provide the new value directly.\\n- For single select and iteration fields, provide the ID of the option or iteration.\\n- To clear the field, set this to null.\",\"nullable\":true,\"oneOf\":[{\"type\":\"string\"},{\"type\":\"number\"}]}},\"required\":[\"id\",\"value\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"fields\"],\"type\":\"object\"}}},\"description\":\"Field updates to apply to the project item. Only text, number, date, single