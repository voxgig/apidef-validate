            json: "{\"operationId\":\"orgs/custom-properties-for-repos-get-organization-values\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The number of results per page (max 100). For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"per_page\",\"schema\":{\"default\":30,\"type\":\"integer\"}},{\"description\":\"The page number of the results to fetch. For more information, see \\\"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\\\"\",\"in\":\"query\",\"name\":\"page\",\"schema\":{\"default\":1,\"type\":\"integer\"}},{\"description\":\"Finds repositories in the organization with a query containing one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/search/search#constructing-a-search-query). See \\\"[Searching for repositories](https://docs.github.com/articles/searching-for-repositories/)\\\" for a detailed list of qualifiers.\",\"in\":\"query\",\"name\":\"repository_query\",\"required\":false,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":[{\"properties\":[{\"property_name\":\"environment\",\"value\":\"production\"},{\"property_name\":\"service\",\"value\":\"web\"},{\"property_name\":\"team\",\"value\":\"octocat\"}],\"repository_full_name\":\"octocat/Hello-World\",\"repository_id\":1296269,\"repository_name\":\"Hello-World\"}]}},\"schema\":{\"items\":{\"description\":\"List of custom property values for a repository\",\"properties\":{\"properties\":{\"description\":\"List of custom property names and associated values\",\"items\":{\"description\":\"Custom property name and associated value\",\"properties\":{\"property_name\":{\"description\":\"The name of the property\",\"type\":\"string\"},\"value\":{\"description\":\"The value assigned to the property\",\"nullable\":true,\"oneOf\":[{\"type\":\"string\"},{\"items\":{\"type\":\"string\"},\"type\":\"array\"}]}},\"required\":[\"property_name\",\"value\"],\"title\":\"Custom Property Value\",\"type\":\"object\"},\"type\":\"array\"},\"repository_full_name\":{\"example\":\"octocat/Hello-World\",\"type\":\"string\"},\"repository_id\":{\"example\":1296269,\"type\":\"integer\"},\"repository_name\":{\"example\":\"Hello-World\",\"type\":\"string\"}},\"required\":[\"repository_id\",\"repository_name\",\"repository_full_name\",\"properties\"],\"title\":\"Organization Repository Custom Property Values\",\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Response\",\"headers\":{\"Link\":{\"example\":\"<https://api.github.com/resource?page=2>; rel=\\\"next\\\", <https://api.github.com/resource?page=5>; rel=\\\"last\\\"\",\"schema\":{\"type\":\"string\"}}}},\"403\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Forbidden\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Resource not found\"}},\"securitySource\":\"unspecified\"}"
