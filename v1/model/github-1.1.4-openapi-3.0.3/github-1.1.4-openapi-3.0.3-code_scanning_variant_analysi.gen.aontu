# Entity: code_scanning_variant_analysi

main: kit: entity: code_scanning_variant_analysi: {

  alias: field: {}

  fields: [
    {
      name: "actions_workflow_run_id"
      req: false
      short: "The GitHub Actions workflow run used to execute this variant analysis."
      type: "`$INTEGER`"
    }
    {
      name: "actor"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      name: "completed_at"
      req: false
      short: "The date and time at which the variant analysis was completed, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
    {
      name: "controller_repo"
      req: true
      short: "A GitHub repository."
      type: "`$OBJECT`"
    }
    {
      name: "created_at"
      req: false
      short: "The date and time at which the variant analysis was created, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
    {
      name: "failure_reason"
      req: false
      short: "The reason for a failure of the variant analysis."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The ID of the variant analysis."
      type: "`$INTEGER`"
    }
    {
      name: "language"
      req: true
      short: "The language targeted by the CodeQL query"
      type: "`$STRING`"
    }
    {
      name: "query_language"
      req: true
      short: "The language targeted by the CodeQL query"
      type: "`$STRING`"
    }
    {
      name: "query_pack"
      req: true
      short: "A Base64-encoded tarball containing a CodeQL query and all its dependencies"
      type: "`$STRING`"
    }
    {
      name: "query_pack_url"
      req: true
      short: "The download url for the query pack."
      type: "`$STRING`"
    }
    {
      name: "repositories"
      req: false
      short: "List of repository names (in the form `owner/repo-name`) to run the query against."
      type: "`$ARRAY`"
    }
    {
      name: "repository_lists"
      req: false
      short: "List of repository lists to run the query against."
      type: "`$ARRAY`"
    }
    {
      name: "repository_owners"
      req: false
      short: "List of organization or user names whose repositories the query should be run against."
      type: "`$ARRAY`"
    }
    {
      name: "scanned_repositories"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "skipped_repositories"
      req: true
      short: "Information about repositories that were skipped from processing."
      type: "`$OBJECT`"
    }
    {
      name: "status"
      req: true
      type: "`$STRING`"
    }
    {
      name: "updated_at"
      req: false
      short: "The date and time at which the variant analysis was last updated, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "code_scanning_variant_analysi"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/repos/{owner}/{repo}/code-scanning/codeql/variant-analyses"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "codeql"
            }
            {
              lit: "variant-analyses"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: {
              language: "`reqdata.language`"
              query_pack: "`reqdata.query_pack`"
              repositories: "`reqdata.repository`"
              repository_lists: "`reqdata.repository_list`"
              repository_owners: "`reqdata.repository_owner`"
            }
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "codeql_variant_analysis_id"
                orig: "codeql_variant_analysis_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/code-scanning/codeql/variant-analyses/{codeql_variant_analysis_id}"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "codeql"
            }
            {
              lit: "variant-analyses"
            }
            {
              var: "codeql_variant_analysis_id"
            }
          ]
          select: {
            exist: [
              "codeql_variant_analysis_id"
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
      [
        "repo"
        "variant_analysis"
      ]
    ]
  }



}