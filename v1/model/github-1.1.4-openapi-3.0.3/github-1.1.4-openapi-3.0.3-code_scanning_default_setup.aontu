# Entity: code_scanning_default_setup

main: kit: entity: code_scanning_default_setup: {

  alias: field: {}

  fields: {
    languages: {
      h: "Languages"
      n: "languages"
      r: false
      sh: "Languages to be analyzed."
      t: "`$ARRAY`"
    }
    query_suite: {
      h: "Query Suite"
      n: "query_suite"
      r: false
      sh: "CodeQL query suite to be used."
      t: "`$STRING`"
    }
    runner_label: {
      h: "Runner Label"
      n: "runner_label"
      r: false
      sh: "Runner label to be used if the runner type is labeled."
      t: "`$STRING`"
    }
    runner_type: {
      h: "Runner Type"
      n: "runner_type"
      r: false
      sh: "Runner type to be used."
      t: "`$STRING`"
    }
    schedule: {
      h: "Schedule"
      n: "schedule"
      r: false
      sh: "The frequency of the periodic analysis."
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
      sh: "Code scanning default setup has been configured or not."
      t: "`$STRING`"
    }
    threat_model: {
      h: "Threat Model"
      n: "threat_model"
      r: false
      sh: "Threat model to be used for code scanning analysis."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "Timestamp of latest configuration update."
      t: "`$STRING`"
    }
  }

  name: "code_scanning_default_setup"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}/code-scanning/default-setup"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}/code-scanning/default-setup"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "default-setup"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.languages`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}