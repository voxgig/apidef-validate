                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /repos/{owner}/{repo}/code-scanning/default-setup"
            json: "{\"operationId\":\"code-scanning/get-default-setup\",\"parameters\":[{\"description\":\"The account owner of the repository. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"owner\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"The name of the repository without the `.git` extension. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"repo\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"languages\":[\"ruby\",\"python\"],\"query_suite\":\"default\",\"schedule\":\"weekly\",\"state\":\"configured\",\"threat_model\":\"remote\",\"updated_at\":\"2023-01-19T11:21:34Z\"}}},\"schema\":{\"description\":\"Configuration for code scanning default setup.\",\"properties\":{\"languages\":{\"description\":\"Languages to be analyzed.\",\"items\":{\"enum\":[\"actions\",\"c-cpp\",\"csharp\",\"go\",\"java-kotlin\",\"javascript-typescript\",\"javascript\",\"python\",\"ruby\",\"typescript\",\"swift\"],\"type\":\"string\"},\"type\":\"array\"},\"query_suite\":{\"description\":\"CodeQL query suite to be used.\",\"enum\":[\"default\",\"extended\"],\"type\":\"string\"},\"runner_label\":{\"description\":\"Runner label to be used if the runner type is labeled.\",\"example\":\"code-scanning\",\"nullable\":true,\"type\":\"string\"},\"runner_type\":{\"description\":\"Runner type to be used.\",\"enum\":[\"standard\",\"labeled\"],\"nullable\":true,\"type\":\"string\"},\"schedule\":{\"description\":\"The frequency of the periodic analysis.\",\"enum\":[\"weekly\"],\"nullable\":true,\"type\":\"string\"},\"state\":{\"description\":\"Code scanning default setup has been configured or not.\",\"enum\":[\"configured\",\"not-configured\"],\"type\":\"string\"},\"threat_model\":{\"description\":\"Threat model to be used for code scanning analysis. Use `remote` to analyze only network sources and `remote_and_local` to include local sources like filesystem access, command-line arguments, database reads, environment variable and standard input.\",\"enum\":[\"remote\",\"remote_and_local\"],\"type\":\"string\"},\"updated_at\":{\"description\":\"Timestamp of latest configuration update.\",\"example\":\"2023-12-06T14:20:20.000Z\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Response\"},\"403\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Response if GitHub Advanced Security is not enabled for this repository\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Basic Error\",\"properties\":{\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"}},\"title\":\"Basic Error\",\"type\":\"object\"}}},\"description\":\"Resource not found\"},\"503\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"type\":\"string\"},\"documentation_url\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Service unavailable\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/code-scanning/default-setup"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "code-scanning"
            }
            {
              lit: "default-setup"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.languages`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}