# Entity: copilot

main: kit: entity: copilot: {

  alias: field: {}

  fields: [
    {
      name: "assignee"
      req: true
      short: "A GitHub user."
      type: "`$OBJECT`"
    }
    {
      name: "assigning_team"
      req: false
      short: "The team through which the assignee is granted access to GitHub Copilot, if applicable."
      type: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    {
      format: "date-time"
      name: "created_at"
      req: true
      short: "Timestamp of when the assignee was last granted access to GitHub Copilot, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "last_activity_at"
      req: false
      short: "Timestamp of user's last GitHub Copilot activity, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "last_activity_editor"
      req: false
      short: "Last editor that was used by the user for a GitHub Copilot completion."
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "last_authenticated_at"
      req: false
      short: "Timestamp of the last time the user authenticated with GitHub Copilot, in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "organization"
      req: true
      short: "A GitHub organization."
      type: "`$OBJECT`"
    }
    {
      format: "date"
      name: "pending_cancellation_date"
      req: false
      short: "The pending cancellation date for the seat, in `YYYY-MM-DD` format."
      type: "`$STRING`"
    }
    {
      name: "plan_type"
      req: false
      short: "The Copilot plan of the organization, or the parent enterprise, when applicable."
      type: "`$STRING`"
    }
    {
      name: "selected_teams"
      req: true
      short: "List of team names within the organization to which to grant access to GitHub Copilot."
      type: "`$ARRAY`"
    }
    {
      name: "selected_usernames"
      req: true
      short: "The usernames of the organization members to be granted access to GitHub Copilot."
      type: "`$ARRAY`"
    }
    {
      deprecated: true
      format: "date-time"
      name: "updated_at"
      req: false
      short: "**Closing down notice:** This field is no longer relevant and is closing down."
      type: "`$STRING`"
    }
  ]

  name: "copilot"
  op: {
