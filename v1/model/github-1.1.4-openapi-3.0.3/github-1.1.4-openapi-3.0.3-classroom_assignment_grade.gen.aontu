# Entity: classroom_assignment_grade

main: kit: entity: classroom_assignment_grade: {

  alias: field: {}

  fields: [
    {
      name: "assignment_name"
      req: true
      short: "Name of the assignment"
      type: "`$STRING`"
    }
    {
      name: "assignment_url"
      req: true
      short: "URL of the assignment"
      type: "`$STRING`"
    }
    {
      name: "github_username"
      req: true
      short: "GitHub username of the student"
      type: "`$STRING`"
    }
    {
      name: "group_name"
      req: false
      short: "If a group assignment, name of the group the student is in"
      type: "`$STRING`"
    }
    {
      name: "points_available"
      req: true
      short: "Number of points available for the assignment"
      type: "`$INTEGER`"
    }
    {
      name: "points_awarded"
      req: true
      short: "Number of points awarded to the student"
      type: "`$INTEGER`"
    }
    {
      name: "roster_identifier"
      req: true
      short: "Roster identifier of the student"
      type: "`$STRING`"
    }
    {
      name: "starter_code_url"
      req: true
      short: "URL of the starter code for the assignment"
      type: "`$STRING`"
    }
    {
      name: "student_repository_name"
      req: true
      short: "Name of the student's assignment repository"
      type: "`$STRING`"
    }
    {
      name: "student_repository_url"
      req: true
      short: "URL of the student's assignment repository"
      type: "`$STRING`"
    }
    {
      name: "submission_timestamp"
      req: true
      short: "Timestamp of the student's assignment submission"
      type: "`$STRING`"
    }
  ]

  name: "classroom_assignment_grade"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "assignment_id"
                orig: "assignment_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/assignments/{assignment_id}/grades"
          segments: [
            {
              lit: "assignments"
            }
            {
              var: "assignment_id"
            }
            {
              lit: "grades"
            }
          ]
          select: {
            exist: [
              "assignment_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "assignment"
      ]
    ]
  }



}