              "owner"
              "release_id"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "issue"
      ]
      [
        "repo"
        "comment"
      ]
      [
        "repo"
        "release"
      ]
      [
        "org"
        "team"
        "discussion"
      ]
      [
        "org"
        "team"
        "discussion"
        "comment"
      ]
    ]
  }



}