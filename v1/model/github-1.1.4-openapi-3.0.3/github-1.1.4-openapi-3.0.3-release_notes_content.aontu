  }

  name: "release_notes_content"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /repos/{owner}/{repo}/releases/generate-notes"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
