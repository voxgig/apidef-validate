                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/repos/{owner}/{repo}/releases/generate-notes"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "releases"
            }
            {
              lit: "generate-notes"
            }
          ]
          t: {
