    }
    configuration_file_path: {
      h: "Configuration File Path"
      n: "configuration_file_path"
      r: false
      sh: "Specifies a path to a file in the repository containing configuration settings used for generating the release notes."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The generated name of the release"
      t: "`$STRING`"
    }
    previous_tag_name: {
      h: "Previous Tag Name"
      n: "previous_tag_name"
      r: false
      sh: "The name of the previous tag to use as the starting point for the release notes."
      t: "`$STRING`"
    }
    tag_name: {
      h: "Tag Name"
      n: "tag_name"
      r: true
      sh: "The tag name for the release."
      t: "`$STRING`"
    }
    target_commitish: {
      h: "Target Commitish"
      n: "target_commitish"
      r: false
      sh: "Specifies the commitish value that will be the target for the release's tag."
      t: "`$STRING`"
