# Entity: file_commit

main: kit: entity: file_commit: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: true
      short: "The author of the file."
      type: "`$OBJECT`"
    }
    {
      name: "branch"
      req: false
      short: "The branch name."
      type: "`$STRING`"
    }
    {
      name: "commit"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "committer"
      req: true
      short: "The person that committed the file."
      type: "`$OBJECT`"
    }
    {
      name: "content"
      req: true
      short: "The new file content, using Base64 encoding."
      type: "`$OBJECT`"
    }
    {
      name: "message"
      req: true
      short: "The commit message."
      type: "`$STRING`"
    }
    {
      name: "sha"
      req: false
      short: "**Required if you are updating a file**."
      type: "`$STRING`"
    }
  ]

  name: "file_commit"
  op: {
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "path"
                orig: "path"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/repos/{owner}/{repo}/contents/{path}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "contents"
            "{path}"
          ]
          select: {
            exist: [
              "owner"
              "path"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "path"
                orig: "path"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PUT"
          orig: "/repos/{owner}/{repo}/contents/{path}"
          parts: [
            "repos"
            "{owner}"
            "{repo}"
            "contents"
            "{path}"
          ]
          select: {
            exist: [
              "owner"
              "path"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
        "content"
      ]
    ]
  }



}