# Entity: actions_workflow_access_to_repository

main: kit: entity: actions_workflow_access_to_repository: {

  alias: field: {}

  fields: [
    {
      name: "access_level"
      req: true
      short: "Defines the level of access that workflows outside of the repository have to actions and reusable workflows within the repository."
      type: "`$STRING`"
    }
  ]

  name: "actions_workflow_access_to_repository"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "repo"
                orig: "repo"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{repo}/actions/permissions/access"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "actions"
            }
            {
              lit: "permissions"
            }
            {
              lit: "access"
            }
          ]
          select: {
            exist: [
              "owner"
              "repo"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}