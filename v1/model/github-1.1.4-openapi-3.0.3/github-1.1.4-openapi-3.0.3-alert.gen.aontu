        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    dismissed_comment: {
      h: "Dismissed Comment"
      n: "dismissed_comment"
      op: {
        list: {
          req: true
          type: [
            "`$ONE`"
            [
              "`$STRING`"
              "`$NULL`"
            ]
          ]
        }
      }
      r: false
      sh: "The dismissal comment associated with the dismissal of the alert."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    dismissed_reason: {
      h: "Dismissed Reason"
      n: "dismissed_reason"
      r: true
      sh: "**Required when the state is dismissed.** The reason for dismissing or closing the alert."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    fixed_at: {
      fo: "date-time"
      h: "Fixed At"
      n: "fixed_at"
      op: {
        list: {
          req: true
          type: [
            "`$ONE`"
            [
              "`$STRING`"
              "`$NULL`"
            ]
          ]
        }
      }
      r: false
      ro: true
      sh: "The time that the alert was no longer detected and was considered fixed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: true
      ro: true
      sh: "The GitHub URL of the alert resource."
      t: "`$STRING`"
    }
