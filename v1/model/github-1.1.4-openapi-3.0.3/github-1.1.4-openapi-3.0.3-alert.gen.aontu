# Entity: alert

main: kit: entity: alert: {

  alias: field: {}

  fields: {
    auto_dismissed_at: {
      fo: "date-time"
      h: "Auto Dismissed At"
      n: "auto_dismissed_at"
      r: false
      ro: true
      sh: "The time that the alert was auto-dismissed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
