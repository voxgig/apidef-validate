            json: "{\"operationId\":\"dependabot/get-org-public-key\",\"parameters\":[{\"description\":\"The organization name. The name is not case sensitive.\",\"in\":\"path\",\"name\":\"org\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"default\":{\"value\":{\"key\":\"2Sg8iYjAxxmI2LvUXpJjkYrMxURPc8r+dB7TJyvv1234\",\"key_id\":\"012345678912345678\"}}},\"schema\":{\"description\":\"The public key used for setting Dependabot Secrets.\",\"properties\":{\"key\":{\"description\":\"The Base64 encoded public key.\",\"example\":\"hBT5WZEj8ZoOv6TYJsfWq7MxTEQopZO5/IT3ZCVQPzs=\",\"type\":\"string\"},\"key_id\":{\"description\":\"The identifier for the key.\",\"example\":\"1234567\",\"type\":\"string\"}},\"required\":[\"key_id\",\"key\"],\"title\":\"DependabotPublicKey\",\"type\":\"object\"}}},\"description\":\"Response\"}},\"securitySource\":\"unspecified\"}"
