# Entity: resources_rate_check

main: kit: entity: resources_rate_check: {

  alias: field: {}

  fields: [
    {
      name: "interval"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "limit"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "remaining"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "reset"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "reset_iso_8601"
      req: false
      type: "`$STRING`"
    }
    {
      name: "throttled"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "resources_rate_check"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/rates/limits/"
          parts: [
            "rates"
            "limits"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.resources`"
          }
        }
      ]
    }
  }



}