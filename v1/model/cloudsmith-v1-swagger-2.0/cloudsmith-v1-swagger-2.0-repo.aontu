            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /repos/{owner}/{repo}/transfer-region/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$ANY`"
