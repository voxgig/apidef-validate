              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$ANY`"
              }
            ]
            query: [
              {
                k: "query"
                n: "data"
                or: "data"
                r: false
                t: "`$OBJECT`"
              }
            ]
          }
          m: "POST"
          o: "/repos/{owner}/{repo}/transfer-region/"
          q: {
            "$action": "transfer_region"
            exist: [
              "data"
