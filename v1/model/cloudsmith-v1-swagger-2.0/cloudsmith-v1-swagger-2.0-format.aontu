# Entity: format

main: kit: entity: format: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: true
      short: "Description of the package format"
      type: "`$STRING`"
    }
    {
      name: "distributions"
      req: false
      short: "The distributions supported by this package format"
      type: "`$ARRAY`"
    }
    {
      name: "extensions"
      req: true
      short: "A non-exhaustive list of extensions supported"
      type: "`$ARRAY`"
    }
    {
      name: "name"
      req: true
      short: "Name for the package format"
      type: "`$STRING`"
    }
    {
      name: "premium"
      req: true
      short: "If true the package format is a premium-only feature"
      type: "`$BOOLEAN`"
    }
    {
      name: "premium_plan_id"
      req: false
      short: "The minimum plan id required for this package format"
      type: "`$STRING`"
    }
    {
      name: "premium_plan_name"
      req: false
      short: "The minimum plan name required for this package format"
      type: "`$STRING`"
    }
    {
      name: "slug"
      req: true
      short: "Slug for the package format"
      type: "`$STRING`"
    }
    {
      name: "supports"
      req: true
      short: "A set of what the package format supports"
      type: "`$OBJECT`"
    }
  ]

  name: "format"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/formats/"
          parts: [
            "formats"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "slug"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/formats/{slug}/"
          parts: [
            "formats"
            "{id}"
          ]
          rename: {
            param: {
              slug: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}