                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{identifier}/privileges"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
