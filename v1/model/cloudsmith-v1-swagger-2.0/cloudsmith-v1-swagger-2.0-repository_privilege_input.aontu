      req: false
      short: "The team identifier (slug)."
      type: "`$STRING`"
    }
    {
      name: "user"
      req: false
      short: "The user identifier (slug)."
      type: "`$STRING`"
    }
  ]

  name: "repository_privilege_input"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "identifier"
                orig: "identifier"
                reqd: true
                type: "`$ANY`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$ANY`"
              }
            ]
            query: [
