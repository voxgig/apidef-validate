# Entity: conan_package_upload

main: kit: entity: conan_package_upload: {

  alias: field: {}

  fields: {
    conan_channel: {
      h: "Conan Channel"
      n: "conan_channel"
      r: false
      sh: "Conan channel."
      t: "`$STRING`"
    }
    conan_prefix: {
      h: "Conan Prefix"
      n: "conan_prefix"
      r: false
      sh: "Conan prefix (User)."
      t: "`$STRING`"
    }
    info_file: {
      h: "Info File"
      n: "info_file"
      r: true
      sh: "The info file is an python file containing the package metadata."
      t: "`$STRING`"
    }
    manifest_file: {
      h: "Manifest File"
      n: "manifest_file"
      r: true
      sh: "The info file is an python file containing the package metadata."
      t: "`$STRING`"
    }
    metadata_file: {
      h: "Metadata File"
      n: "metadata_file"
      r: true
      sh: "The conan file is an python file containing the package metadata."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of this package."
      t: "`$STRING`"
    }
    package_file: {
      h: "Package File"
      n: "package_file"
      r: true
      sh: "The primary file for the package."
      t: "`$STRING`"
    }
    republish: {
      h: "Republish"
      n: "republish"
      r: false
      sh: "If true, the uploaded package will overwrite any others with the same attributes (e.g."
      t: "`$BOOLEAN`"
    }
    tags: {
      h: "Tags"
      n: "tags"
      r: false
      sh: "A comma-separated values list of tags to add to the package."
      t: "`$STRING`"
    }
    version: {
      h: "Version"
      n: "version"
      r: false
      sh: "The raw version for this package."
      t: "`$STRING`"
    }
  }

  name: "conan_package_upload"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "conan_channel"
            "conan_prefix"
            "info_file"
            "manifest_file"
            "metadata_file"
            "name"
            "package_file"
            "republish"
            "tags"
            "version"
          ]
          co: {
            id: "POST /packages/{owner}/{repo}/upload/conan/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/packages/{owner}/{repo}/upload/conan/"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "packages"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "upload"
            }
            {
              lit: "conan"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "conan_channel"
            "conan_prefix"
            "info_file"
            "manifest_file"
            "metadata_file"
            "name"
            "package_file"
            "republish"
            "tags"
            "version"
          ]
          co: {
            id: "POST /packages/{owner}/{repo}/validate-upload/conan/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/packages/{owner}/{repo}/validate-upload/conan/"
          q: {
            "$action": "validate_upload"
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "packages"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "validate-upload"
            }
            {
              lit: "conan"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.package")]
  ]

}