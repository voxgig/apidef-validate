# Entity: provider_setting

main: kit: entity: provider_setting: {

  alias: field: {}

  fields: {
    claims: {
      h: "Claims"
      n: "claims"
      r: true
      sh: "The set of claims that any received tokens from the provider must contain to authenticate as the configured service account."
      t: "`$OBJECT`"
    }
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: true
      sh: "Whether the provider settings should be used for incoming OIDC requests."
      t: "`$BOOLEAN`"
    }
    mapping_claim: {
      h: "Mapping Claim"
      n: "mapping_claim"
      r: false
      sh: "The OIDC claim to use for mapping to service accounts in dynamic_mappings."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the provider settings are being configured for"
      t: "`$STRING`"
    }
    provider_url: {
      fo: "uri"
      h: "Provider Url"
      n: "provider_url"
      r: true
      sh: "The URL from the provider that serves as the base for the OpenID configuration."
      t: "`$STRING`"
    }
    service_accounts: {
      h: "Service Accounts"
      n: "service_accounts"
      r: false
      sh: "The service accounts associated with these provider settings."
      t: "`$ARRAY`"
    }
    slug: {
      fo: "slug"
      h: "Slug"
      n: "slug"
      r: false
      ro: true
      sh: "The slug of the provider settings"
      t: "`$STRING`"
    }
    slug_perm: {
      fo: "slug"
      h: "Slug Perm"
      n: "slug_perm"
      r: false
      ro: true
      sh: "The unique, immutable identifier of the provider settings."
      t: "`$STRING`"
    }
  }

  name: "provider_setting"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /orgs/{org}/openid-connect/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "page_size"
                or: "page_size"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "query"
                or: "query"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/openid-connect/"
          q: {
            exist: [
              "org_id"
              "page"
              "page_size"
              "query"
              "sort"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "openid-connect"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /orgs/{org}/openid-connect/{slug_perm}/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "slug_perm"
                or: "slug_perm"
                r: true
                t: "`$ANY`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/openid-connect/{slug_perm}/"
          q: {
            exist: [
              "org_id"
              "slug_perm"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "openid-connect"
            }
            {
              var: "slug_perm"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
      [
        "org"
        "openid_connect"
      ]
    ]
  }



}