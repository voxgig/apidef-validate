# Entity: provider_setting

main: kit: entity: provider_setting: {

  alias: field: {}

  fields: [
    {
      name: "claims"
      req: true
      short: "The set of claims that any received tokens from the provider must contain to authenticate as the configured service account."
      type: "`$OBJECT`"
    }
    {
      name: "enabled"
      req: true
      short: "Whether the provider settings should be used for incoming OIDC requests."
      type: "`$BOOLEAN`"
    }
    {
      name: "mapping_claim"
      req: false
      short: "The OIDC claim to use for mapping to service accounts in dynamic_mappings."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The name of the provider settings are being configured for"
      type: "`$STRING`"
    }
    {
      name: "provider_url"
      req: true
      short: "The URL from the provider that serves as the base for the OpenID configuration."
      type: "`$STRING`"
    }
    {
      name: "service_accounts"
      req: false
      short: "The service accounts associated with these provider settings."
      type: "`$ARRAY`"
    }
    {
      name: "slug"
      req: false
      short: "The slug of the provider settings"
      type: "`$STRING`"
    }
    {
      name: "slug_perm"
      req: false
      short: "The unique, immutable identifier of the provider settings."
      type: "`$STRING`"
    }
  ]

  name: "provider_setting"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "query"
                orig: "query"
                reqd: false
                type: "`$ANY`"
              }
              {
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$ANY`"
              }
            ]
          }
          method: "GET"
          orig: "/orgs/{org}/openid-connect/"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "openid-connect"
            }
          ]
          select: {
            exist: [
              "org_id"
              "page"
              "page_size"
              "query"
              "sort"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "org_id"
                orig: "org"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "slug_perm"
                orig: "slug_perm"
                reqd: true
                type: "`$ANY`"
              }
            ]
          }
          method: "GET"
          orig: "/orgs/{org}/openid-connect/{slug_perm}/"
          rename: {
            param: {
              org: "org_id"
            }
          }
          segments: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "openid-connect"
            }
            {
              var: "slug_perm"
            }
          ]
          select: {
            exist: [
              "org_id"
              "slug_perm"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "org"
      ]
      [
        "org"
        "openid_connect"
      ]
    ]
  }



}