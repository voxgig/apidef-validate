    }
    {
      name: "limit_bandwidth_unit"
      req: false
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "limit_date_range_from"
      req: false
      short: "The starting date/time the token is allowed to be used from."
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "limit_date_range_to"
      req: false
      short: "The ending date/time the token is allowed to be used until."
      type: "`$STRING`"
    }
    {
      name: "limit_num_clients"
      req: false
      short: "The maximum number of unique clients allowed for the token."
      type: "`$INTEGER`"
    }
    {
      name: "limit_num_downloads"
      req: false
      short: "The maximum number of downloads allowed for the token."
      type: "`$INTEGER`"
    }
    {
      name: "limit_package_query"
      req: false
      short: "The package-based search query to apply to restrict downloads to."
