# Entity: repository_x509_ecdsa_certificate

main: kit: entity: repository_x509_ecdsa_certificate: {

  alias: field: {}

  fields: [
    {
      name: "active"
      req: false
      short: "If selected this is the active key for this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "certificate"
      req: false
      short: "The issued certificate."
      type: "`$STRING`"
    }
    {
      name: "certificate_chain"
      req: false
      short: "Base64 encoded CA certificate chain."
      type: "`$STRING`"
    }
    {
      name: "certificate_chain_fingerprint"
      req: false
      type: "`$STRING`"
    }
    {
      name: "certificate_chain_fingerprint_short"
      req: false
      type: "`$STRING`"
    }
    {
      name: "certificate_fingerprint"
      req: false
      short: "The SHA-256 long identifier used"
      type: "`$STRING`"
    }
    {
      name: "certificate_fingerprint_short"
      req: false
      type: "`$STRING`"
    }
    {
      name: "created_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "default"
      req: false
      short: "If selected this is the default key for this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "issuing_status"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "repository_x509_ecdsa_certificate"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "identifier"
                orig: "identifier"
                reqd: true
                type: "`$ANY`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$ANY`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{identifier}/x509-ecdsa/"
          parts: [
            "repos"
            "{owner}"
            "{identifier}"
            "x509-ecdsa"
          ]
          select: {
            exist: [
              "identifier"
              "owner"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}