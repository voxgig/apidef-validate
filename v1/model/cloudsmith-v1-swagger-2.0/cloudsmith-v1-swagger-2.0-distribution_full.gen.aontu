# Entity: distribution_full

main: kit: entity: distribution_full: {

  alias: field: {}

  fields: [
    {
      name: "format"
      readOnly: true
      req: false
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "format_url"
      readOnly: true
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "self_url"
      readOnly: true
      req: false
      type: "`$STRING`"
    }
    {
      name: "slug"
      readOnly: true
      req: false
      short: "The slug identifier for this distribution"
      type: "`$STRING`"
    }
    {
      name: "variants"
      req: false
      type: "`$STRING`"
    }
    {
      name: "versions"
      readOnly: true
      req: false
      short: "A list of the versions for this distribution"
      type: "`$ARRAY`"
    }
  ]

  name: "distribution_full"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/distros/"
          segments: [
            {
              lit: "distros"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "slug"
                orig: "slug"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/distros/{slug}/"
          segments: [
            {
              lit: "distros"
            }
            {
              var: "slug"
            }
          ]
          select: {
            exist: [
              "slug"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "distro"
      ]
    ]
  }



}