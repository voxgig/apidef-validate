# Entity: user_brief

main: kit: entity: user_brief: {

  alias: field: {}

  fields: [
    {
      name: "authenticated"
      req: false
      short: "If true then you're logged in as a user."
      type: "`$BOOLEAN`"
    }
    {
      name: "email"
      req: false
      short: "Your email address that we use to contact you."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "The full name of the user (if any)."
      type: "`$STRING`"
    }
    {
      name: "profile_url"
      req: false
      short: "The URL for the full profile of the user."
      type: "`$STRING`"
    }
    {
      name: "self_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "slug"
      req: false
      type: "`$STRING`"
    }
    {
      name: "slug_perm"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "user_brief"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/user/self/"
          segments: [
            {
              lit: "user"
            }
            {
              lit: "self"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}