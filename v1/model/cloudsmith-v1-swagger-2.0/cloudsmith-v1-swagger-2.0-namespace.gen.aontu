# Entity: namespace

main: kit: entity: namespace: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      ro: true
      t: "`$STRING`"
    }
    slug: {
      fo: "slug"
      h: "Slug"
      n: "slug"
      r: false
      ro: true
      t: "`$STRING`"
    }
    slug_perm: {
      fo: "slug"
      h: "Slug Perm"
      n: "slug_perm"
      r: false
      ro: true
      t: "`$STRING`"
    }
    type_name: {
      h: "Type Name"
      n: "type_name"
      r: false
      ro: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "namespace"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /namespaces/"
            source: "swagger2"
            version: 2
          }
          method: "GET"
          orig: "/namespaces/"
          segments: [
            {
              lit: "namespaces"
            }
          ]
          select: {
            exist: [
              "page"
              "page_size"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "slug"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /namespaces/{slug}/"
            source: "swagger2"
            version: 2
          }
          method: "GET"
          orig: "/namespaces/{slug}/"
          rename: {
            param: {
              slug: "id"
            }
          }
          segments: [
            {
              lit: "namespaces"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}