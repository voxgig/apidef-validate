# Entity: repository_geo_ip_status

main: kit: entity: repository_geo_ip_status: {

  alias: field: {}

  fields: [
    {
      name: "geoip_enabled"
      req: false
      short: "If checked, any access to the website or downloads for this repository is allowed/denied according to the configured Geo/IP restriction rules."
      type: "`$BOOLEAN`"
    }
  ]

  name: "repository_geo_ip_status"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "identifier"
                orig: "identifier"
                reqd: true
                type: "`$ANY`"
              }
              {
                kind: "param"
                name: "owner"
                orig: "owner"
                reqd: true
                type: "`$ANY`"
              }
            ]
          }
          method: "GET"
          orig: "/repos/{owner}/{identifier}/geoip/status/"
          segments: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "identifier"
            }
            {
              lit: "geoip"
            }
            {
              lit: "status"
            }
          ]
          select: {
            exist: [
              "identifier"
              "owner"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "repo"
      ]
    ]
  }



}