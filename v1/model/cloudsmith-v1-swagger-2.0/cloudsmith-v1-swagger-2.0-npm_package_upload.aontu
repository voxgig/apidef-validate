# Entity: npm_package_upload

main: kit: entity: npm_package_upload: {

  alias: field: {}

  fields: {
    npm_dist_tag: {
      h: "Npm Dist Tag"
      n: "npm_dist_tag"
      r: false
      sh: "The default npm dist-tag for this package/version - This will replace any other package/version if they are using the same tag."
      t: "`$STRING`"
    }
    package_file: {
      h: "Package File"
      n: "package_file"
      r: true
      sh: "The primary file for the package."
      t: "`$STRING`"
    }
    republish: {
      h: "Republish"
      n: "republish"
      r: false
      sh: "If true, the uploaded package will overwrite any others with the same attributes (e.g."
      t: "`$BOOLEAN`"
    }
    tags: {
      h: "Tags"
      n: "tags"
      r: false
      sh: "A comma-separated values list of tags to add to the package."
      t: "`$STRING`"
    }
  }

  name: "npm_package_upload"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "npm_dist_tag"
            "package_file"
            "republish"
            "tags"
          ]
          co: {
            id: "POST /packages/{owner}/{repo}/upload/npm/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/packages/{owner}/{repo}/upload/npm/"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "packages"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "upload"
            }
            {
              lit: "npm"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "npm_dist_tag"
            "package_file"
            "republish"
            "tags"
          ]
          co: {
            id: "POST /packages/{owner}/{repo}/validate-upload/npm/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/packages/{owner}/{repo}/validate-upload/npm/"
          q: {
            "$action": "validate_upload"
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "packages"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "validate-upload"
            }
            {
              lit: "npm"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.package")]
  ]

}