            "md5_checksum"
            "method"
            "sha256_checksum"
          ]
          co: {
            id: "POST /files/{owner}/{repo}/{identifier}/complete/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "identifier"
                or: "identifier"
