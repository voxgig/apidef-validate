                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/files/{owner}/{repo}/{identifier}/complete/"
          q: {
            exist: [
              "identifier"
              "owner"
              "repo"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "files"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              var: "identifier"
            }
            {
              lit: "complete"
            }
          ]
          t: {
