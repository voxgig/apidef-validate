# Entity: repo

main: kit: entity: repo: {

  alias: field: {}

  fields: [
    {
      name: "cdn_url"
      readOnly: true
      req: false
      short: "Base URL from which packages and other artifacts are downloaded."
      type: "`$STRING`"
    }
    {
      name: "content_kind"
      req: false
      short: "The repository content kind determines whether this repository contains packages, or provides a distribution of packages from other repositories."
      type: "`$STRING`"
    }
    {
      name: "contextual_auth_realm"
      req: false
      short: "If checked, missing credentials for this repository where basic authentication is required shall present an enriched value in the 'WWW-Authenticate' header containing the namespace and repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "copy_own"
      req: false
      short: "If checked, users can copy any of their own packages that they have uploaded, assuming that they still have write privilege for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "copy_packages"
      req: false
      short: "This defines the minimum level of privilege required for a user to copy packages."
      type: "`$STRING`"
    }
    {
      name: "cosign_signing_enabled"
      req: false
      short: "When enabled, all pushed (or pulled from upstream) OCI packages and artifacts will be signed using cosign with the repository's ECDSA key."
      type: "`$BOOLEAN`"
    }
    {
      format: "date-time"
      name: "created_at"
      readOnly: true
      req: false
      type: "`$STRING`"
    }
    {
      name: "default_privilege"
      req: false
      short: "This defines the default level of privilege that all of your organization members have for this repository."
      type: "`$STRING`"
    }
    {
      name: "delete_own"
      req: false
      short: "If checked, users can delete any of their own packages that they have uploaded, assuming that they still have write privilege for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "delete_packages"
      req: false
      short: "This defines the minimum level of privilege required for a user to delete packages."
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "deleted_at"
      readOnly: true
      req: false
      short: "The datetime the repository was manually deleted at."
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "A description of the repository's purpose/contents."
      type: "`$STRING`"
    }
    {
      name: "distributes"
      req: false
      short: "The repositories distributed through this repo."
      type: "`$ARRAY`"
    }
    {
      name: "docker_refresh_tokens_enabled"
      req: false
      short: "If checked, refresh tokens will be issued in addition to access tokens for Docker authentication."
      type: "`$BOOLEAN`"
    }
    {
      name: "ecdsa_keys"
      readOnly: true
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "enforce_eula"
      req: false
      short: "If checked, downloads will explicitly require acceptance of an EULA."
      type: "`$BOOLEAN`"
    }
    {
      name: "gpg_keys"
      readOnly: true
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "index_files"
      req: false
      short: "If checked, files contained in packages will be indexed, which increase the synchronisation time required for packages."
      type: "`$BOOLEAN`"
    }
    {
      name: "is_open_source"
      readOnly: true
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "is_private"
      readOnly: true
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "is_public"
      readOnly: true
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "manage_entitlements_privilege"
      req: false
      short: "This defines the minimum level of privilege required for a user to manage entitlement tokens with private repositories."
      type: "`$STRING`"
    }
    {
      name: "move_own"
      req: false
      short: "If checked, users can move any of their own packages that they have uploaded, assuming that they still have write privilege for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "move_packages"
      req: false
      short: "This defines the minimum level of privilege required for a user to move packages."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "A descriptive name for the repository."
      type: "`$STRING`"
    }
    {
      format: "slug"
      name: "namespace"
      readOnly: true
      req: false
      short: "Namespace to which this repository belongs."
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "namespace_url"
      readOnly: true
      req: false
      short: "API endpoint where data about this namespace can be retrieved."
      type: "`$STRING`"
    }
    {
      name: "nuget_native_signing_enabled"
      req: false
      short: "When enabled, all pushed (or pulled from upstream) nuget packages and artifacts will be signed using the repository's X.509 RSA certificate."
      type: "`$BOOLEAN`"
    }
    {
      name: "num_downloads"
      readOnly: true
      req: false
      short: "The number of downloads for packages in the repository."
      type: "`$INTEGER`"
    }
    {
      name: "num_policy_violated_packages"
      readOnly: true
      req: false
      short: "Number of packages with policy violations in a repository."
      type: "`$INTEGER`"
    }
    {
      name: "num_quarantined_packages"
      readOnly: true
      req: false
      short: "Number of quarantined packages in a repository."
      type: "`$INTEGER`"
    }
    {
      name: "open_source_license"
      req: false
      short: "The SPDX identifier of the open source license."
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "open_source_project_url"
      req: false
      short: "The URL to the Open-Source project, used for validating that the project meets the requirements for Open-Source."
      type: "`$STRING`"
    }
    {
      name: "package_count"
      readOnly: true
      req: false
      short: "The number of packages in the repository."
      type: "`$INTEGER`"
    }
    {
      name: "package_group_count"
      readOnly: true
      req: false
      short: "The number of groups in the repository."
      type: "`$INTEGER`"
    }
    {
      name: "proxy_npmjs"
      req: false
      short: "If checked, Npm packages that are not in the repository when requested by clients will automatically be proxied from the public npmjs.org registry."
      type: "`$BOOLEAN`"
    }
    {
      name: "proxy_pypi"
      req: false
      short: "If checked, Python packages that are not in the repository when requested by clients will automatically be proxied from the public pypi.python.org registry."
      type: "`$BOOLEAN`"
    }
    {
      name: "raw_package_index_enabled"
      req: false
      short: "If checked, HTML and JSON indexes will be generated that list all available raw packages in the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "raw_package_index_signatures_enabled"
      req: false
      short: "If checked, the HTML and JSON indexes will display raw package GPG signatures alongside the index packages."
      type: "`$BOOLEAN`"
    }
    {
      name: "replace_packages"
      req: false
      short: "This defines the minimum level of privilege required for a user to republish packages."
      type: "`$STRING`"
    }
    {
      name: "replace_packages_by_default"
      req: false
      short: "If checked, uploaded packages will overwrite/replace any others with the same attributes (e.g."
      type: "`$BOOLEAN`"
    }
    {
      name: "repository_type"
      readOnly: true
      req: false
      short: "The repository type changes how it is accessed and billed."
      type: "`$INTEGER`"
    }
    {
      name: "repository_type_str"
      req: false
      short: "The repository type changes how it is accessed and billed."
      type: "`$STRING`"
    }
    {
      name: "resync_own"
      req: false
      short: "If checked, users can resync any of their own packages that they have uploaded, assuming that they still have write privilege for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "resync_packages"
      req: false
      short: "This defines the minimum level of privilege required for a user to resync packages."
      type: "`$STRING`"
    }
    {
      name: "scan_own"
      req: false
      short: "If checked, users can scan any of their own packages that they have uploaded, assuming that they still have write privilege for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "scan_packages"
      req: false
      short: "This defines the minimum level of privilege required for a user to scan packages."
      type: "`$STRING`"
    }
    {
      name: "self_html_url"
      readOnly: true
      req: false
      short: "Website URL for this repository."
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "self_url"
      readOnly: true
      req: false
      short: "API endpoint where data about this repository can be retrieved."
      type: "`$STRING`"
    }
    {
      name: "show_setup_all"
      req: false
      short: "If checked, the Set Me Up help for all formats will always be shown, even if you don't have packages of that type uploaded."
      type: "`$BOOLEAN`"
    }
    {
      name: "size"
      readOnly: true
      req: false
      short: "The calculated size of the repository."
      type: "`$INTEGER`"
    }
    {
      name: "size_str"
      readOnly: true
      req: false
      short: "The calculated size of the repository (human readable)."
      type: "`$STRING`"
    }
    {
      name: "slug"
      req: false
      short: "The slug identifies the repository in URIs."
      type: "`$STRING`"
    }
    {
      format: "slug"
      name: "slug_perm"
      readOnly: true
      req: false
      short: "The slug_perm immutably identifies the repository."
      type: "`$STRING`"
    }
    {
      name: "storage_region"
      readOnly: true
      req: false
      short: "The Cloudsmith region in which package files are stored."
      type: "`$STRING`"
    }
    {
      name: "strict_npm_validation"
      req: false
      short: "If checked, npm packages will be validated strictly to ensure the package matches specifcation."
      type: "`$BOOLEAN`"
    }
    {
      name: "tag_pre_releases_as_latest"
      req: false
      short: "If checked, packages pushed with a pre-release component on that version will be marked with the 'latest' tag."
      type: "`$BOOLEAN`"
    }
    {
      name: "use_debian_labels"
      req: false
      short: "If checked, a 'Label' field will be present in Debian-based repositories."
      type: "`$BOOLEAN`"
    }
    {
      name: "use_default_cargo_upstream"
      req: false
      short: "If checked, dependencies of uploaded Cargo crates which do not set an explicit value for \"registry\" will be assumed to be available from crates.io."
      type: "`$BOOLEAN`"
    }
    {
      name: "use_entitlements_privilege"
      req: false
      short: "This defines the minimum level of privilege required for a user to see/use entitlement tokens with private repositories."
      type: "`$STRING`"
    }
    {
      name: "use_noarch_packages"
      req: false
      short: "If checked, noarch packages (if supported) are enabled in installations/configurations."
      type: "`$BOOLEAN`"
    }
    {
      name: "use_source_packages"
      req: false
      short: "If checked, source packages (if supported) are enabled in installations/configurations."
      type: "`$BOOLEAN`"
    }
    {
      name: "use_vulnerability_scanning"
      req: false
      short: "If checked, vulnerability scanning will be enabled for all supported packages within this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "user_entitlements_enabled"
      req: false
      short: "If checked, users can use and manage their own user-specific entitlement token for the repository (if private)."
      type: "`$BOOLEAN`"
    }
    {
      name: "view_statistics"
      req: false
      short: "This defines the minimum level of privilege required for a user to view repository statistics, to include entitlement-based usage, if applicable."
      type: "`$STRING`"
    }
  ]

