# Entity: namespace

main: kit: entity: namespace: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      ro: true
      t: "`$STRING`"
    }
    slug: {
      fo: "slug"
      h: "Slug"
      n: "slug"
      r: false
      ro: true
      t: "`$STRING`"
    }
    slug_perm: {
      fo: "slug"
      h: "Slug Perm"
      n: "slug_perm"
      r: false
      ro: true
      t: "`$STRING`"
    }
    type_name: {
      h: "Type Name"
      n: "type_name"
      r: false
      ro: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "namespace"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /namespaces/"
            source: "swagger2"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "page_size"
                or: "page_size"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/namespaces/"
          q: {
            exist: [
              "page"
              "page_size"
            ]
          }
          s: [
            {
              lit: "namespaces"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /namespaces/{slug}/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/namespaces/{slug}/"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              slug: "id"
            }
          }
          s: [
            {
              lit: "namespaces"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}