# Entity: dart_package_upload

main: kit: entity: dart_package_upload: {

  alias: field: {}

  fields: {
    package_file: {
      h: "Package File"
      n: "package_file"
      r: true
      sh: "The primary file for the package."
      t: "`$STRING`"
    }
    republish: {
      h: "Republish"
      n: "republish"
      r: false
      sh: "If true, the uploaded package will overwrite any others with the same attributes (e.g."
