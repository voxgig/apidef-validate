                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/packages/{owner}/{repo}/upload/dart/"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "packages"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "upload"
            }
            {
              lit: "dart"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "package_file"
            "republish"
            "tags"
          ]
          co: {
            id: "POST /packages/{owner}/{repo}/validate-upload/dart/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/packages/{owner}/{repo}/validate-upload/dart/"
          q: {
