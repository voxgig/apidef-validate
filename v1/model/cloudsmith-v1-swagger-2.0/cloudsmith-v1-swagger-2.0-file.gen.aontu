# Entity: file

main: kit: entity: file: {

  alias: field: {}

  fields: {
    filename: {
      h: "Filename"
      n: "filename"
      r: true
      sh: "Filename for the package file upload."
      t: "`$STRING`"
    }
    identifier: {
      fo: "uri"
      h: "Identifier"
      n: "identifier"
      r: false
      ro: true
      sh: "The identifier for the file to use when creating packages"
      t: "`$STRING`"
    }
    md5_checksum: {
      h: "Md5 Checksum"
      n: "md5_checksum"
      r: false
      sh: "MD5 checksum for a POST-based package file upload."
      t: "`$STRING`"
    }
    method: {
      h: "Method"
      n: "method"
      r: false
      sh: "The method to use for package file upload."
      t: "`$STRING`"
    }
    sha256_checksum: {
      h: "Sha256 Checksum"
      n: "sha256_checksum"
      r: false
      sh: "SHA256 checksum for a PUT-based package file upload."
      t: "`$STRING`"
    }
    upload_fields: {
      h: "Upload Fields"
      n: "upload_fields"
      r: false
      ro: true
      sh: "The dictionary of fields that must be sent with POST uploads"
      t: "`$OBJECT`"
    }
    upload_headers: {
      h: "Upload Headers"
      n: "upload_headers"
      r: false
      ro: true
      sh: "The dictionary of headers that must be sent with uploads"
      t: "`$OBJECT`"
    }
    upload_querystring: {
      h: "Upload Querystring"
      n: "upload_querystring"
      r: false
      ro: true
      sh: "The querystring to use for the next-step POST or PUT upload"
      t: "`$STRING`"
    }
    upload_url: {
      fo: "uri"
      h: "Upload Url"
      n: "upload_url"
      r: false
      ro: true
      sh: "The URL to use for the next-step POST or PUT upload"
      t: "`$STRING`"
    }
  }

  name: "file"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /files/{owner}/{repo}/{identifier}/abort/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "identifier"
                or: "identifier"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/files/{owner}/{repo}/{identifier}/abort/"
          q: {
            exist: [
              "identifier"
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "files"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              var: "identifier"
            }
            {
              lit: "abort"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /files/{owner}/{repo}/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/files/{owner}/{repo}/"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "files"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /files/{owner}/{repo}/validate/"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/files/{owner}/{repo}/validate/"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "files"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
            {
              lit: "validate"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}