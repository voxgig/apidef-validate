# Entity: user_auth_token

main: kit: entity: user_auth_token: {

  alias: field: {}

  fields: {
    email: {
      fo: "email"
      h: "Email"
      n: "email"
      r: false
      sh: "Email address to authenticate with"
      t: "`$STRING`"
    }
    password: {
      h: "Password"
      n: "password"
      r: false
      sh: "Password to authenticate with"
      t: "`$STRING`"
    }
    totp_token: {
      h: "Totp Token"
      n: "totp_token"
      r: false
      sh: "Two-factor authentication code"
      t: "`$STRING`"
    }
  }

  name: "user_auth_token"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "email"
            "password"
            "totp_token"
          ]
          co: {
            id: "POST /user/token/"
            source: "swagger2"
            version: 2
          }
          m: "POST"
          o: "/user/token/"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "user"
            }
            {
              lit: "token"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}