# Entity: app_access_token

main: kit: entity: app_access_token: {

  alias: field: {}

  name: "app_access_token"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "app_installation_id"
                orig: "app_definition_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "environment_id"
                orig: "environment_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "space_id"
                orig: "space_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/spaces/{space_id}/environments/{environment_id}/app_installations/{app_definition_id}/access_tokens"
          rename: {
            param: {
              app_definition_id: "app_installation_id"
            }
          }
          segments: [
            {
              lit: "spaces"
            }
            {
              var: "space_id"
            }
            {
              lit: "environments"
            }
            {
              var: "environment_id"
            }
            {
              lit: "app_installations"
            }
            {
              var: "app_installation_id"
            }
            {
              lit: "access_tokens"
            }
          ]
          select: {
            exist: [
              "app_installation_id"
              "environment_id"
              "space_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "space"
        "environment"
        "app_installation"
      ]
    ]
  }



}