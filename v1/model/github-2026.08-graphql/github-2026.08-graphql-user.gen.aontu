# Entity: user

main: kit: entity: user: {

  alias: field: {}

  fields: {
    anyPinnableItems: {
      h: "Any Pinnable Items"
      n: "anyPinnableItems"
      r: true
      sh: "Determine if this repository owner has any items that can be pinned to their profile."
      t: "`$BOOLEAN`"
    }
    avatarUrl: {
      h: "Avatar Url"
      n: "avatarUrl"
      r: true
      sh: "A URL pointing to the user's public avatar."
      t: "`$ANY`"
    }
    bio: {
      h: "Bio"
      n: "bio"
      r: false
      sh: "The user's public profile bio."
      t: "`$STRING`"
    }
    bioHTML: {
      h: "Bio Html"
      n: "bioHTML"
      r: true
      sh: "The user's public profile bio as HTML."
      t: "`$ANY`"
    }
    company: {
      h: "Company"
      n: "company"
      r: false
      sh: "The user's public profile company."
      t: "`$STRING`"
    }
    companyHTML: {
      h: "Company Html"
      n: "companyHTML"
      r: true
      sh: "The user's public profile company as HTML."
      t: "`$ANY`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    email: {
      h: "Email"
      n: "email"
      r: true
      sh: "The user's publicly visible profile email."
      t: "`$STRING`"
    }
    estimatedNextSponsorsPayoutInCents: {
      h: "Estimated Next Sponsors Payout In Cents"
      n: "estimatedNextSponsorsPayoutInCents"
      r: true
      sh: "The estimated next GitHub Sponsors payout for this user/organization in cents (USD)."
      t: "`$INTEGER`"
    }
    hasSponsorsListing: {
      h: "Has Sponsors Listing"
      n: "hasSponsorsListing"
      r: true
      sh: "True if this user/organization has a GitHub Sponsors listing."
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the User object"
      t: "`$STRING`"
    }
    isBountyHunter: {
      h: "Is Bounty Hunter"
      n: "isBountyHunter"
      r: true
      sh: "Whether or not this user is a participant in the GitHub Security Bug Bounty."
      t: "`$BOOLEAN`"
    }
    isCampusExpert: {
      h: "Is Campus Expert"
      n: "isCampusExpert"
      r: true
      sh: "Whether or not this user is a participant in the GitHub Campus Experts Program."
      t: "`$BOOLEAN`"
    }
    isDeveloperProgramMember: {
      h: "Is Developer Program Member"
      n: "isDeveloperProgramMember"
      r: true
      sh: "Whether or not this user is a GitHub Developer Program member."
      t: "`$BOOLEAN`"
    }
    isEmployee: {
      h: "Is Employee"
      n: "isEmployee"
      r: true
      sh: "Whether or not this user is a GitHub employee."
      t: "`$BOOLEAN`"
    }
    isFollowingViewer: {
      h: "Is Following Viewer"
      n: "isFollowingViewer"
      r: true
      sh: "Whether or not this user is following the viewer."
      t: "`$BOOLEAN`"
    }
    isGitHubStar: {
      h: "Is Git Hub Star"
      n: "isGitHubStar"
      r: true
      sh: "Whether or not this user is a member of the GitHub Stars Program."
      t: "`$BOOLEAN`"
    }
    isHireable: {
      h: "Is Hireable"
      n: "isHireable"
      r: true
      sh: "Whether or not the user has marked themselves as for hire."
      t: "`$BOOLEAN`"
    }
    isSiteAdmin: {
      h: "Is Site Admin"
      n: "isSiteAdmin"
      r: true
      sh: "Whether or not this user is a site administrator."
      t: "`$BOOLEAN`"
    }
    isSponsoringViewer: {
      h: "Is Sponsoring Viewer"
      n: "isSponsoringViewer"
      r: true
      sh: "True if the viewer is sponsored by this user/organization."
      t: "`$BOOLEAN`"
    }
    isViewer: {
      h: "Is Viewer"
      n: "isViewer"
      r: true
      sh: "Whether or not this user is the viewing user."
      t: "`$BOOLEAN`"
    }
    location: {
      h: "Location"
      n: "location"
      r: false
      sh: "The user's public profile location."
      t: "`$STRING`"
    }
    login: {
      h: "Login"
      n: "login"
      r: true
      sh: "The username used to login."
      t: "`$STRING`"
    }
    monthlyEstimatedSponsorsIncomeInCents: {
      h: "Monthly Estimated Sponsors Income In Cents"
      n: "monthlyEstimatedSponsorsIncomeInCents"
      r: true
      sh: "The estimated monthly GitHub Sponsors income for this user/organization in cents (USD)."
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The user's public profile name."
      t: "`$STRING`"
    }
    pinnedItemsRemaining: {
      h: "Pinned Items Remaining"
      n: "pinnedItemsRemaining"
      r: true
      sh: "Returns how many more items this profile owner can pin to their profile."
      t: "`$INTEGER`"
    }
    projectsResourcePath: {
      h: "Projects Resource Path"
      n: "projectsResourcePath"
      r: true
      sh: "The HTTP path listing user's projects"
      t: "`$ANY`"
    }
    projectsUrl: {
      h: "Projects Url"
      n: "projectsUrl"
      r: true
      sh: "The HTTP URL listing user's projects"
      t: "`$ANY`"
    }
    pronouns: {
      h: "Pronouns"
      n: "pronouns"
      r: false
      sh: "The user's profile pronouns"
      t: "`$STRING`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this user"
      t: "`$ANY`"
    }
    sponsorsListing: {
      h: "Sponsors Listing"
      n: "sponsorsListing"
      r: false
      sh: "The GitHub Sponsors listing for this user or organization."
      t: "`$OBJECT`"
    }
    sponsorshipForViewerAsSponsor: {
      h: "Sponsorship For Viewer As Sponsor"
      n: "sponsorshipForViewerAsSponsor"
      r: false
      sh: "The sponsorship from the viewer to this user/organization; that is, the sponsorship where you're the sponsor."
      t: "`$OBJECT`"
    }
    sponsorshipForViewerAsSponsorable: {
      h: "Sponsorship For Viewer As Sponsorable"
      n: "sponsorshipForViewerAsSponsorable"
      r: false
      sh: "The sponsorship from this user/organization to the viewer; that is, the sponsorship you're receiving."
      t: "`$OBJECT`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "The user's description of what they're currently doing."
      t: "`$OBJECT`"
    }
    totalSponsorshipAmountAsSponsorInCents: {
      h: "Total Sponsorship Amount As Sponsor In Cents"
      n: "totalSponsorshipAmountAsSponsorInCents"
      r: false
      sh: "The amount in United States cents (e.g., 500 = $5.00 USD) that this entity has spent on GitHub to fund sponsorships."
      t: "`$INTEGER`"
    }
    twitterUsername: {
      h: "Twitter Username"
      n: "twitterUsername"
      r: false
      sh: "The user's Twitter username."
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this user"
      t: "`$STRING`"
    }
    userViewType: {
      h: "User View Type"
      n: "userViewType"
      r: true
      sh: "Whether the request returns publicly visible information or privately visible information about the user"
      t: "`$STRING`"
    }
    viewerCanChangePinnedItems: {
      h: "Viewer Can Change Pinned Items"
      n: "viewerCanChangePinnedItems"
      r: true
      sh: "Can the viewer pin repositories and gists to the profile?"
      t: "`$BOOLEAN`"
    }
    viewerCanFollow: {
      h: "Viewer Can Follow"
      n: "viewerCanFollow"
      r: true
      sh: "Whether or not the viewer is able to follow the user."
      t: "`$BOOLEAN`"
    }
    viewerCanSponsor: {
      h: "Viewer Can Sponsor"
      n: "viewerCanSponsor"
      r: true
      sh: "Whether or not the viewer is able to sponsor this user/organization."
      t: "`$BOOLEAN`"
    }
    viewerCopilotAgentCreatesChannel: {
      h: "Viewer Copilot Agent Creates Channel"
      n: "viewerCopilotAgentCreatesChannel"
      r: false
      sh: "Channel value for subscribing to live updates for session creations."
      t: "`$STRING`"
    }
    viewerCopilotAgentLogUpdatesChannel: {
      h: "Viewer Copilot Agent Log Updates Channel"
      n: "viewerCopilotAgentLogUpdatesChannel"
      r: false
      sh: "Channel value for subscribing to live updates for session log updates."
      t: "`$STRING`"
    }
    viewerCopilotAgentTaskUpdatesChannel: {
      h: "Viewer Copilot Agent Task Updates Channel"
      n: "viewerCopilotAgentTaskUpdatesChannel"
      r: false
      sh: "Channel value for subscribing to live updates for task updates."
      t: "`$STRING`"
    }
    viewerCopilotAgentUpdatesChannel: {
      h: "Viewer Copilot Agent Updates Channel"
      n: "viewerCopilotAgentUpdatesChannel"
      r: false
      sh: "Channel value for subscribing to live updates for session updates."
      t: "`$STRING`"
    }
    viewerIsFollowing: {
      h: "Viewer Is Following"
      n: "viewerIsFollowing"
      r: true
      sh: "Whether or not this user is followed by the viewer."
      t: "`$BOOLEAN`"
    }
    viewerIsSponsoring: {
      h: "Viewer Is Sponsoring"
      n: "viewerIsSponsoring"
      r: true
      sh: "True if the viewer is sponsoring this user/organization."
      t: "`$BOOLEAN`"
    }
    websiteUrl: {
      h: "Website Url"
      n: "websiteUrl"
      r: false
      sh: "A URL pointing to the user's public website/blog."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "user"
  op: {
    create: {
      name: "create"
      points: [
