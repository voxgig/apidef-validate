# Entity: discussion

main: kit: entity: discussion: {

  alias: field: {}

  fields: {
    activeLockReason: {
      h: "Active Lock Reason"
      n: "activeLockReason"
      r: false
      sh: "Reason that the conversation was locked."
      t: "`$STRING`"
    }
    answer: {
      h: "Answer"
      n: "answer"
      r: false
      sh: "The comment chosen as this discussion's answer, if any."
      t: "`$OBJECT`"
    }
    answerChosenAt: {
      h: "Answer Chosen At"
      n: "answerChosenAt"
      r: false
      sh: "The time when a user chose this discussion's answer, if answered."
      t: "`$ANY`"
    }
    authorAssociation: {
      h: "Author Association"
      n: "authorAssociation"
      r: true
      sh: "Author's association with the subject of the comment."
      t: "`$STRING`"
    }
    body: {
      h: "Body"
      n: "body"
      r: true
      sh: "The main text of the discussion post."
      t: "`$STRING`"
    }
    bodyHTML: {
      h: "Body Html"
      n: "bodyHTML"
      r: true
      sh: "The body rendered to HTML."
      t: "`$ANY`"
    }
    bodyText: {
      h: "Body Text"
      n: "bodyText"
      r: true
      sh: "The body rendered to text."
      t: "`$STRING`"
    }
    category: {
      h: "Category"
      n: "category"
      r: false
      sh: "The category for this discussion."
      t: "`$OBJECT`"
    }
    closed: {
      h: "Closed"
      n: "closed"
      r: true
      sh: "Indicates if the object is closed (definition of closed may depend on type)"
      t: "`$BOOLEAN`"
    }
    closedAt: {
      h: "Closed At"
      n: "closedAt"
      r: false
      sh: "Identifies the date and time when the object was closed."
      t: "`$ANY`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    createdViaEmail: {
      h: "Created Via Email"
      n: "createdViaEmail"
      r: true
      sh: "Check if this comment was created via an email reply."
      t: "`$BOOLEAN`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Discussion object"
      t: "`$STRING`"
    }
    includesCreatedEdit: {
      h: "Includes Created Edit"
      n: "includesCreatedEdit"
      r: true
      sh: "Check if this comment was edited and includes an edit with the creation data"
      t: "`$BOOLEAN`"
    }
    isAnswered: {
      h: "Is Answered"
      n: "isAnswered"
      r: false
      sh: "Only return answered/unanswered discussions"
      t: "`$BOOLEAN`"
    }
    lastEditedAt: {
      h: "Last Edited At"
      n: "lastEditedAt"
      r: false
      sh: "The moment the editor made the last edit"
      t: "`$ANY`"
    }
    locked: {
      h: "Locked"
      n: "locked"
      r: true
      sh: "`true` if the object is locked"
      t: "`$BOOLEAN`"
    }
    number: {
      h: "Number"
      n: "number"
      r: true
      sh: "The number identifying this discussion within the repository."
      t: "`$INTEGER`"
    }
    poll: {
      h: "Poll"
      n: "poll"
      r: false
      sh: "The poll associated with this discussion, if one exists."
      t: "`$OBJECT`"
    }
    publishedAt: {
      h: "Published At"
      n: "publishedAt"
      r: false
      sh: "Identifies when the comment was published at."
      t: "`$ANY`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The repository associated with this node."
      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The path for this discussion."
      t: "`$ANY`"
    }
    stateReason: {
      h: "State Reason"
      n: "stateReason"
      r: false
      sh: "Identifies the reason for the discussion's state."
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "The title of this discussion."
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    upvoteCount: {
      h: "Upvote Count"
      n: "upvoteCount"
      r: true
      sh: "Number of upvotes that this subject has received."
      t: "`$INTEGER`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The URL for this discussion."
      t: "`$STRING`"
    }
    viewerCanClose: {
      h: "Viewer Can Close"
      n: "viewerCanClose"
      r: true
      sh: "Indicates if the object can be closed by the viewer."
      t: "`$BOOLEAN`"
    }
    viewerCanDelete: {
      h: "Viewer Can Delete"
      n: "viewerCanDelete"
      r: true
      sh: "Check if the current viewer can delete this object."
      t: "`$BOOLEAN`"
    }
    viewerCanLabel: {
      h: "Viewer Can Label"
      n: "viewerCanLabel"
      r: true
      sh: "Indicates if the viewer can edit labels for this object."
      t: "`$BOOLEAN`"
    }
    viewerCanReact: {
      h: "Viewer Can React"
      n: "viewerCanReact"
      r: true
      sh: "Can user react to this subject"
      t: "`$BOOLEAN`"
    }
    viewerCanReopen: {
      h: "Viewer Can Reopen"
      n: "viewerCanReopen"
      r: true
      sh: "Indicates if the object can be reopened by the viewer."
      t: "`$BOOLEAN`"
    }
    viewerCanSubscribe: {
      h: "Viewer Can Subscribe"
      n: "viewerCanSubscribe"
      r: true
      sh: "Check if the viewer is able to change their subscription status for the repository."
      t: "`$BOOLEAN`"
    }
    viewerCanUpdate: {
      h: "Viewer Can Update"
      n: "viewerCanUpdate"
      r: true
      sh: "Check if the current viewer can update this object."
      t: "`$BOOLEAN`"
    }
    viewerCanUpvote: {
      h: "Viewer Can Upvote"
      n: "viewerCanUpvote"
      r: true
      sh: "Whether or not the current user can add or remove an upvote on this subject."
      t: "`$BOOLEAN`"
    }
    viewerDidAuthor: {
      h: "Viewer Did Author"
      n: "viewerDidAuthor"
      r: true
      sh: "Did the viewer author this comment."
      t: "`$BOOLEAN`"
    }
    viewerHasUpvoted: {
      h: "Viewer Has Upvoted"
      n: "viewerHasUpvoted"
      r: true
      sh: "Whether or not the current user has already upvoted this subject."
      t: "`$BOOLEAN`"
    }
    viewerSubscription: {
      h: "Viewer Subscription"
      n: "viewerSubscription"
      r: false
      sh: "Identifies if the viewer is watching, not watching, or ignoring the subscribable entity."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "discussion"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST closeDiscussion"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation DiscussionCreateClose($input: CloseDiscussionInput!) { closeDiscussion(input: $input) { discussion { ...DiscussionFields } } } fragment DiscussionFields on Discussion { activeLockReason answer { id } answerChosenAt authorAssociation body bodyHTML bodyText category { id } closed closedAt createdAt createdViaEmail databaseId id includesCreatedEdit isAnswered lastEditedAt locked number poll { id } publishedAt repository { id } resourcePath stateReason title updatedAt upvoteCount url viewerCanClose viewerCanDelete viewerCanLabel viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpvote viewerDidAuthor viewerHasUpvoted viewerSubscription }"
            field: "closeDiscussion"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CloseDiscussionInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "closeDiscussion"
          select: {
            "$action": "close"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.closeDiscussion.discussion`"
          }
        }
        {
          contract: {
            id: "POST createDiscussion"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation DiscussionCreate($input: CreateDiscussionInput!) { createDiscussion(input: $input) { discussion { ...DiscussionFields } } } fragment DiscussionFields on Discussion { activeLockReason answer { id } answerChosenAt authorAssociation body bodyHTML bodyText category { id } closed closedAt createdAt createdViaEmail databaseId id includesCreatedEdit isAnswered lastEditedAt locked number poll { id } publishedAt repository { id } resourcePath stateReason title updatedAt upvoteCount url viewerCanClose viewerCanDelete viewerCanLabel viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpvote viewerDidAuthor viewerHasUpvoted viewerSubscription }"
            field: "createDiscussion"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateDiscussionInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createDiscussion"
          transform: {
            req: "`reqdata`"
            res: "`body.data.createDiscussion.discussion`"
          }
        }
        {
          contract: {
            id: "POST markDiscussionCommentAsAnswer"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation DiscussionCreateMarkDiscussionCommentAsAnswer($input: MarkDiscussionCommentAsAnswerInput!) { markDiscussionCommentAsAnswer(input: $input) { discussion { ...DiscussionFields } } } fragment DiscussionFields on Discussion { activeLockReason answer { id } answerChosenAt authorAssociation body bodyHTML bodyText category { id } closed closedAt createdAt createdViaEmail databaseId id includesCreatedEdit isAnswered lastEditedAt locked number poll { id } publishedAt repository { id } resourcePath stateReason title updatedAt upvoteCount url viewerCanClose viewerCanDelete viewerCanLabel viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpvote viewerDidAuthor viewerHasUpvoted viewerSubscription }"
            field: "markDiscussionCommentAsAnswer"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "MarkDiscussionCommentAsAnswerInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "markDiscussionCommentAsAnswer"
          select: {
            "$action": "mark_discussion_comment_as_answer"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.markDiscussionCommentAsAnswer.discussion`"
          }
        }
        {
          contract: {
            id: "POST reopenDiscussion"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation DiscussionCreateReopen($input: ReopenDiscussionInput!) { reopenDiscussion(input: $input) { discussion { ...DiscussionFields } } } fragment DiscussionFields on Discussion { activeLockReason answer { id } answerChosenAt authorAssociation body bodyHTML bodyText category { id } closed closedAt createdAt createdViaEmail databaseId id includesCreatedEdit isAnswered lastEditedAt locked number poll { id } publishedAt repository { id } resourcePath stateReason title updatedAt upvoteCount url viewerCanClose viewerCanDelete viewerCanLabel viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpvote viewerDidAuthor viewerHasUpvoted viewerSubscription }"
            field: "reopenDiscussion"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ReopenDiscussionInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "reopenDiscussion"
          select: {
            "$action": "reopen"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.reopenDiscussion.discussion`"
          }
        }
        {
          contract: {
            id: "POST unmarkDiscussionCommentAsAnswer"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation DiscussionCreateUnmarkDiscussionCommentAsAnswer($input: UnmarkDiscussionCommentAsAnswerInput!) { unmarkDiscussionCommentAsAnswer(input: $input) { discussion { ...DiscussionFields } } } fragment DiscussionFields on Discussion { activeLockReason answer { id } answerChosenAt authorAssociation body bodyHTML bodyText category { id } closed closedAt createdAt createdViaEmail databaseId id includesCreatedEdit isAnswered lastEditedAt locked number poll { id } publishedAt repository { id } resourcePath stateReason title updatedAt upvoteCount url viewerCanClose viewerCanDelete viewerCanLabel viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpvote viewerDidAuthor viewerHasUpvoted viewerSubscription }"
            field: "unmarkDiscussionCommentAsAnswer"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UnmarkDiscussionCommentAsAnswerInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "unmarkDiscussionCommentAsAnswer"
          select: {
            "$action": "unmark_discussion_comment_as_answer"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.unmarkDiscussionCommentAsAnswer.discussion`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          contract: {
            id: "POST deleteDiscussion"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation DiscussionRemove($input: DeleteDiscussionInput!) { deleteDiscussion(input: $input) { discussion { ...DiscussionFields } } } fragment DiscussionFields on Discussion { activeLockReason answer { id } answerChosenAt authorAssociation body bodyHTML bodyText category { id } closed closedAt createdAt createdViaEmail databaseId id includesCreatedEdit isAnswered lastEditedAt locked number poll { id } publishedAt repository { id } resourcePath stateReason title updatedAt upvoteCount url viewerCanClose viewerCanDelete viewerCanLabel viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpvote viewerDidAuthor viewerHasUpvoted viewerSubscription }"
            field: "deleteDiscussion"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "DeleteDiscussionInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "deleteDiscussion"
          transform: {
            req: "`reqdata`"
            res: "`body.data.deleteDiscussion.discussion`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          contract: {
            id: "POST updateDiscussion"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation DiscussionUpdate($input: UpdateDiscussionInput!) { updateDiscussion(input: $input) { discussion { ...DiscussionFields } } } fragment DiscussionFields on Discussion { activeLockReason answer { id } answerChosenAt authorAssociation body bodyHTML bodyText category { id } closed closedAt createdAt createdViaEmail databaseId id includesCreatedEdit isAnswered lastEditedAt locked number poll { id } publishedAt repository { id } resourcePath stateReason title updatedAt upvoteCount url viewerCanClose viewerCanDelete viewerCanLabel viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpvote viewerDidAuthor viewerHasUpvoted viewerSubscription }"
            field: "updateDiscussion"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateDiscussionInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updateDiscussion"
          transform: {
            req: "`reqdata`"
            res: "`body.data.updateDiscussion.discussion`"
          }
        }
      ]
    }
  }



}