# Entity: organization

main: kit: entity: organization: {

  alias: field: {}

  fields: {
    anyPinnableItems: {
      h: "Any Pinnable Items"
      n: "anyPinnableItems"
      r: true
      sh: "Determine if this repository owner has any items that can be pinned to their profile."
      t: "`$BOOLEAN`"
    }
    archivedAt: {
      h: "Archived At"
      n: "archivedAt"
      r: false
      sh: "Identifies the date and time when the organization was archived."
      t: "`$ANY`"
    }
    avatarUrl: {
      h: "Avatar Url"
      n: "avatarUrl"
      r: true
      sh: "A URL pointing to the organization's public avatar."
      t: "`$ANY`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "The organization's public profile description."
      t: "`$STRING`"
    }
    descriptionHTML: {
      h: "Description Html"
      n: "descriptionHTML"
      r: false
      sh: "The organization's public profile description rendered to HTML."
      t: "`$STRING`"
    }
    email: {
      h: "Email"
      n: "email"
      r: false
      sh: "The organization's public email."
      t: "`$STRING`"
    }
    estimatedNextSponsorsPayoutInCents: {
      h: "Estimated Next Sponsors Payout In Cents"
      n: "estimatedNextSponsorsPayoutInCents"
      r: true
      sh: "The estimated next GitHub Sponsors payout for this user/organization in cents (USD)."
      t: "`$INTEGER`"
    }
    hasSponsorsListing: {
      h: "Has Sponsors Listing"
      n: "hasSponsorsListing"
      r: true
      sh: "True if this user/organization has a GitHub Sponsors listing."
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Organization object"
      t: "`$STRING`"
    }
    ipAllowListEnabledSetting: {
      h: "Ip Allow List Enabled Setting"
      n: "ipAllowListEnabledSetting"
      r: true
      sh: "The setting value for whether the organization has an IP allow list enabled."
      t: "`$STRING`"
    }
    ipAllowListForInstalledAppsEnabledSetting: {
      h: "Ip Allow List For Installed Apps Enabled Setting"
      n: "ipAllowListForInstalledAppsEnabledSetting"
      r: true
      sh: "The setting value for whether the organization has IP allow list configuration for installed GitHub Apps enabled."
      t: "`$STRING`"
    }
    isSponsoringViewer: {
      h: "Is Sponsoring Viewer"
      n: "isSponsoringViewer"
      r: true
      sh: "True if the viewer is sponsored by this user/organization."
      t: "`$BOOLEAN`"
    }
    isVerified: {
      h: "Is Verified"
      n: "isVerified"
      r: true
      sh: "Whether the organization has verified its profile email and website."
      t: "`$BOOLEAN`"
    }
    location: {
      h: "Location"
      n: "location"
      r: false
      sh: "The organization's public profile location."
      t: "`$STRING`"
    }
    login: {
      h: "Login"
      n: "login"
      r: true
      sh: "The organization's login name."
      t: "`$STRING`"
    }
    membersCanForkPrivateRepositories: {
      h: "Members Can Fork Private Repositories"
      n: "membersCanForkPrivateRepositories"
      r: true
      sh: "Members can fork private repositories in this organization"
      t: "`$BOOLEAN`"
    }
    monthlyEstimatedSponsorsIncomeInCents: {
      h: "Monthly Estimated Sponsors Income In Cents"
      n: "monthlyEstimatedSponsorsIncomeInCents"
      r: true
      sh: "The estimated monthly GitHub Sponsors income for this user/organization in cents (USD)."
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The organization's public profile name."
      t: "`$STRING`"
    }
    newTeamResourcePath: {
      h: "New Team Resource Path"
      n: "newTeamResourcePath"
      r: true
      sh: "The HTTP path creating a new team"
      t: "`$ANY`"
    }
    newTeamUrl: {
      h: "New Team Url"
      n: "newTeamUrl"
      r: true
      sh: "The HTTP URL creating a new team"
      t: "`$ANY`"
    }
    notificationDeliveryRestrictionEnabledSetting: {
      h: "Notification Delivery Restriction Enabled Setting"
      n: "notificationDeliveryRestrictionEnabledSetting"
      r: true
      sh: "Indicates if email notification delivery for this organization is restricted to verified or approved domains."
      t: "`$STRING`"
    }
    organizationBillingEmail: {
      h: "Organization Billing Email"
      n: "organizationBillingEmail"
      r: false
      sh: "The billing email for the organization."
      t: "`$STRING`"
    }
    pinnedItemsRemaining: {
      h: "Pinned Items Remaining"
      n: "pinnedItemsRemaining"
      r: true
      sh: "Returns how many more items this profile owner can pin to their profile."
      t: "`$INTEGER`"
    }
    projectsResourcePath: {
      h: "Projects Resource Path"
      n: "projectsResourcePath"
      r: true
      sh: "The HTTP path listing organization's projects"
      t: "`$ANY`"
    }
    projectsUrl: {
      h: "Projects Url"
      n: "projectsUrl"
      r: true
      sh: "The HTTP URL listing organization's projects"
      t: "`$ANY`"
    }
    requiresTwoFactorAuthentication: {
      h: "Requires Two Factor Authentication"
      n: "requiresTwoFactorAuthentication"
      r: false
      sh: "When true the organization requires all members, billing managers, and outside collaborators to enable two-factor authentication."
      t: "`$BOOLEAN`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this organization."
      t: "`$ANY`"
    }
    samlIdentityProvider: {
      h: "Saml Identity Provider"
      n: "samlIdentityProvider"
      r: false
      sh: "The Organization's SAML identity provider."
      t: "`$OBJECT`"
    }
    sponsorsListing: {
      h: "Sponsors Listing"
      n: "sponsorsListing"
      r: false
      sh: "The GitHub Sponsors listing for this user or organization."
      t: "`$OBJECT`"
    }
    sponsorshipForViewerAsSponsor: {
      h: "Sponsorship For Viewer As Sponsor"
      n: "sponsorshipForViewerAsSponsor"
      r: false
      sh: "The sponsorship from the viewer to this user/organization; that is, the sponsorship where you're the sponsor."
      t: "`$OBJECT`"
    }
    sponsorshipForViewerAsSponsorable: {
      h: "Sponsorship For Viewer As Sponsorable"
      n: "sponsorshipForViewerAsSponsorable"
      r: false
      sh: "The sponsorship from this user/organization to the viewer; that is, the sponsorship you're receiving."
      t: "`$OBJECT`"
    }
    teamsResourcePath: {
      h: "Teams Resource Path"
      n: "teamsResourcePath"
      r: true
      sh: "The HTTP path listing organization's teams"
      t: "`$ANY`"
    }
    teamsUrl: {
      h: "Teams Url"
      n: "teamsUrl"
      r: true
      sh: "The HTTP URL listing organization's teams"
      t: "`$ANY`"
    }
    totalSponsorshipAmountAsSponsorInCents: {
      h: "Total Sponsorship Amount As Sponsor In Cents"
      n: "totalSponsorshipAmountAsSponsorInCents"
      r: false
      sh: "The amount in United States cents (e.g., 500 = $5.00 USD) that this entity has spent on GitHub to fund sponsorships."
      t: "`$INTEGER`"
    }
    twitterUsername: {
      h: "Twitter Username"
      n: "twitterUsername"
      r: false
      sh: "The organization's Twitter username."
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this organization."
      t: "`$STRING`"
    }
    viewerCanAdminister: {
      h: "Viewer Can Administer"
      n: "viewerCanAdminister"
      r: true
      sh: "Organization is adminable by the viewer."
      t: "`$BOOLEAN`"
    }
    viewerCanChangePinnedItems: {
      h: "Viewer Can Change Pinned Items"
      n: "viewerCanChangePinnedItems"
      r: true
      sh: "Can the viewer pin repositories and gists to the profile?"
      t: "`$BOOLEAN`"
    }
    viewerCanCreateRepositories: {
      h: "Viewer Can Create Repositories"
      n: "viewerCanCreateRepositories"
      r: true
      sh: "Viewer can create repositories on this organization"
      t: "`$BOOLEAN`"
    }
    viewerCanCreateTeams: {
      h: "Viewer Can Create Teams"
      n: "viewerCanCreateTeams"
      r: true
      sh: "Viewer can create teams on this organization."
      t: "`$BOOLEAN`"
    }
    viewerCanSponsor: {
      h: "Viewer Can Sponsor"
      n: "viewerCanSponsor"
      r: true
      sh: "Whether or not the viewer is able to sponsor this user/organization."
      t: "`$BOOLEAN`"
    }
    viewerIsAMember: {
      h: "Viewer Is A Member"
      n: "viewerIsAMember"
      r: true
      sh: "Viewer is an active member of this organization."
      t: "`$BOOLEAN`"
    }
    viewerIsFollowing: {
      h: "Viewer Is Following"
      n: "viewerIsFollowing"
      r: true
      sh: "Whether or not this Organization is followed by the viewer."
      t: "`$BOOLEAN`"
    }
    viewerIsSponsoring: {
      h: "Viewer Is Sponsoring"
      n: "viewerIsSponsoring"
      r: true
      sh: "True if the viewer is sponsoring this user/organization."
      t: "`$BOOLEAN`"
    }
    webCommitSignoffRequired: {
      h: "Web Commit Signoff Required"
      n: "webCommitSignoffRequired"
      r: true
      sh: "Whether contributors are required to sign off on web-based commits for repositories in this organization."
      t: "`$BOOLEAN`"
    }
    websiteUrl: {
      h: "Website Url"
      n: "websiteUrl"
      r: false
      sh: "The organization's public profile URL."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "organization"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST createAttributionInvitation"
