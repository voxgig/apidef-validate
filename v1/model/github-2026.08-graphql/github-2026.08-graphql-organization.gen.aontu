          kind: "graphql"
          method: "POST"
          orig: "createAttributionInvitation"
          select: {
            "$action": "create_attribution_invitation"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.createAttributionInvitation.owner`"
          }
        }
        {
          graphql: {
            doc: "mutation OrganizationCreateFollow($input: FollowOrganizationInput!) { followOrganization(input: $input) { organization { ...OrganizationFields } } } fragment OrganizationFields on Organization { anyPinnableItems archivedAt avatarUrl createdAt databaseId description descriptionHTML email estimatedNextSponsorsPayoutInCents hasSponsorsListing id ipAllowListEnabledSetting ipAllowListForInstalledAppsEnabledSetting isSponsoringViewer isVerified location login membersCanForkPrivateRepositories monthlyEstimatedSponsorsIncomeInCents name newTeamResourcePath newTeamUrl notificationDeliveryRestrictionEnabledSetting organizationBillingEmail pinnedItemsRemaining projectsResourcePath projectsUrl requiresTwoFactorAuthentication resourcePath samlIdentityProvider { id } sponsorsListing { id } sponsorshipForViewerAsSponsor { id } sponsorshipForViewerAsSponsorable { id } teamsResourcePath teamsUrl totalSponsorshipAmountAsSponsorInCents twitterUsername updatedAt url viewerCanAdminister viewerCanChangePinnedItems viewerCanCreateRepositories viewerCanCreateTeams viewerCanSponsor viewerIsAMember viewerIsFollowing viewerIsSponsoring webCommitSignoffRequired websiteUrl }"
