# Entity: organization

main: kit: entity: organization: {

  alias: field: {}

  fields: [
    {
      name: "anyPinnableItems"
      req: true
      short: "Determine if this repository owner has any items that can be pinned to their profile."
      type: "`$BOOLEAN`"
    }
    {
      name: "archivedAt"
      req: false
      short: "Identifies the date and time when the organization was archived."
      type: "`$ANY`"
    }
    {
      name: "avatarUrl"
      req: true
      short: "A URL pointing to the organization's public avatar."
      type: "`$ANY`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$INTEGER`"
    }
    {
      name: "description"
      req: false
      short: "The organization's public profile description."
      type: "`$STRING`"
    }
    {
      name: "descriptionHTML"
      req: false
      short: "The organization's public profile description rendered to HTML."
      type: "`$STRING`"
    }
    {
      name: "email"
      req: false
      short: "The organization's public email."
      type: "`$STRING`"
    }
    {
      name: "estimatedNextSponsorsPayoutInCents"
      req: true
      short: "The estimated next GitHub Sponsors payout for this user/organization in cents (USD)."
      type: "`$INTEGER`"
    }
    {
      name: "hasSponsorsListing"
      req: true
      short: "True if this user/organization has a GitHub Sponsors listing."
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the Organization object"
      type: "`$STRING`"
    }
    {
      name: "ipAllowListEnabledSetting"
      req: true
      short: "The setting value for whether the organization has an IP allow list enabled."
      type: "`$STRING`"
    }
    {
      name: "ipAllowListForInstalledAppsEnabledSetting"
      req: true
      short: "The setting value for whether the organization has IP allow list configuration for installed GitHub Apps enabled."
      type: "`$STRING`"
    }
    {
      name: "isSponsoringViewer"
      req: true
      short: "True if the viewer is sponsored by this user/organization."
      type: "`$BOOLEAN`"
    }
    {
      name: "isVerified"
      req: true
      short: "Whether the organization has verified its profile email and website."
      type: "`$BOOLEAN`"
    }
    {
      name: "location"
      req: false
      short: "The organization's public profile location."
      type: "`$STRING`"
    }
    {
      name: "login"
      req: true
      short: "The organization's login name."
      type: "`$STRING`"
    }
    {
      name: "membersCanForkPrivateRepositories"
      req: true
      short: "Members can fork private repositories in this organization"
      type: "`$BOOLEAN`"
    }
    {
      name: "monthlyEstimatedSponsorsIncomeInCents"
      req: true
      short: "The estimated monthly GitHub Sponsors income for this user/organization in cents (USD)."
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "The organization's public profile name."
      type: "`$STRING`"
    }
    {
      name: "newTeamResourcePath"
      req: true
      short: "The HTTP path creating a new team"
      type: "`$ANY`"
    }
    {
      name: "newTeamUrl"
      req: true
      short: "The HTTP URL creating a new team"
      type: "`$ANY`"
    }
    {
      name: "notificationDeliveryRestrictionEnabledSetting"
      req: true
      short: "Indicates if email notification delivery for this organization is restricted to verified or approved domains."
      type: "`$STRING`"
    }
    {
      name: "organizationBillingEmail"
      req: false
      short: "The billing email for the organization."
      type: "`$STRING`"
    }
    {
      name: "pinnedItemsRemaining"
      req: true
      short: "Returns how many more items this profile owner can pin to their profile."
      type: "`$INTEGER`"
    }
    {
      name: "projectsResourcePath"
      req: true
      short: "The HTTP path listing organization's projects"
      type: "`$ANY`"
    }
    {
      name: "projectsUrl"
      req: true
      short: "The HTTP URL listing organization's projects"
      type: "`$ANY`"
    }
    {
      name: "requiresTwoFactorAuthentication"
      req: false
      short: "When true the organization requires all members, billing managers, and outside collaborators to enable two-factor authentication."
      type: "`$BOOLEAN`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this organization."
      type: "`$ANY`"
    }
    {
      name: "samlIdentityProvider"
      req: false
      short: "The Organization's SAML identity provider."
      type: "`$OBJECT`"
    }
    {
      name: "sponsorsListing"
      req: false
      short: "The GitHub Sponsors listing for this user or organization."
      type: "`$OBJECT`"
    }
    {
      name: "sponsorshipForViewerAsSponsor"
      req: false
      short: "The sponsorship from the viewer to this user/organization; that is, the sponsorship where you're the sponsor."
      type: "`$OBJECT`"
    }
    {
      name: "sponsorshipForViewerAsSponsorable"
      req: false
      short: "The sponsorship from this user/organization to the viewer; that is, the sponsorship you're receiving."
      type: "`$OBJECT`"
    }
    {
      name: "teamsResourcePath"
      req: true
      short: "The HTTP path listing organization's teams"
      type: "`$ANY`"
    }
    {
      name: "teamsUrl"
      req: true
      short: "The HTTP URL listing organization's teams"
      type: "`$ANY`"
    }
    {
      name: "totalSponsorshipAmountAsSponsorInCents"
      req: false
      short: "The amount in United States cents (e.g., 500 = $5.00 USD) that this entity has spent on GitHub to fund sponsorships."
      type: "`$INTEGER`"
    }
    {
      name: "twitterUsername"
      req: false
      short: "The organization's Twitter username."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this organization."
      type: "`$STRING`"
    }
    {
      name: "viewerCanAdminister"
      req: true
      short: "Organization is adminable by the viewer."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanChangePinnedItems"
      req: true
      short: "Can the viewer pin repositories and gists to the profile?"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanCreateRepositories"
      req: true
      short: "Viewer can create repositories on this organization"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanCreateTeams"
      req: true
      short: "Viewer can create teams on this organization."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanSponsor"
      req: true
      short: "Whether or not the viewer is able to sponsor this user/organization."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerIsAMember"
      req: true
      short: "Viewer is an active member of this organization."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerIsFollowing"
      req: true
      short: "Whether or not this Organization is followed by the viewer."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerIsSponsoring"
      req: true
      short: "True if the viewer is sponsoring this user/organization."
      type: "`$BOOLEAN`"
    }
    {
      name: "webCommitSignoffRequired"
      req: true
      short: "Whether contributors are required to sign off on web-based commits for repositories in this organization."
      type: "`$BOOLEAN`"
    }
    {
      name: "websiteUrl"
      req: false
      short: "The organization's public profile URL."
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

