# Entity: sponsors_tier

main: kit: entity: sponsors_tier: {

  alias: field: {}

  fields: {
    closestLesserValueTier: {
      h: "Closest Lesser Value Tier"
      n: "closestLesserValueTier"
      r: false
      sh: "Get a different tier for this tier's maintainer that is at the same frequency as this tier but with an equal or lesser cost."
      t: "`$OBJECT`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    description: {
      h: "Description"
      n: "description"
      r: true
      sh: "The description of the tier."
      t: "`$STRING`"
    }
    descriptionHTML: {
      h: "Description Html"
      n: "descriptionHTML"
      r: true
      sh: "The tier description rendered to HTML"
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the SponsorsTier object"
      t: "`$STRING`"
    }
    isCustomAmount: {
      h: "Is Custom Amount"
      n: "isCustomAmount"
      r: true
      sh: "Whether this tier was chosen at checkout time by the sponsor rather than defined ahead of time by the maintainer who manages the Sponsors listing."
      t: "`$BOOLEAN`"
    }
    isOneTime: {
      h: "Is One Time"
      n: "isOneTime"
      r: true
      sh: "Whether this tier is only for use with one-time sponsorships."
      t: "`$BOOLEAN`"
    }
    monthlyPriceInCents: {
      h: "Monthly Price In Cents"
      n: "monthlyPriceInCents"
      r: true
      sh: "How much this tier costs per month in cents."
      t: "`$INTEGER`"
    }
    monthlyPriceInDollars: {
      h: "Monthly Price In Dollars"
      n: "monthlyPriceInDollars"
      r: true
      sh: "How much this tier costs per month in USD."
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the tier."
      t: "`$STRING`"
    }
    sponsorsListing: {
      h: "Sponsors Listing"
      n: "sponsorsListing"
      r: false
      sh: "The sponsors listing that this tier belongs to."
      t: "`$OBJECT`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "sponsors_tier"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST cancelSponsorship"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation SponsorsTierCreateCancelSponsorship($input: CancelSponsorshipInput!) { cancelSponsorship(input: $input) { sponsorsTier { ...SponsorsTierFields } } } fragment SponsorsTierFields on SponsorsTier { closestLesserValueTier { id } createdAt description descriptionHTML id isCustomAmount isOneTime monthlyPriceInCents monthlyPriceInDollars name sponsorsListing { id } updatedAt }"
            field: "cancelSponsorship"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CancelSponsorshipInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "cancelSponsorship"
          q: {
            "$action": "cancel_sponsorship"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.cancelSponsorship.sponsorsTier`"
          }
        }
        {
          co: {
            id: "POST createSponsorsTier"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation SponsorsTierCreate($input: CreateSponsorsTierInput!) { createSponsorsTier(input: $input) { sponsorsTier { ...SponsorsTierFields } } } fragment SponsorsTierFields on SponsorsTier { closestLesserValueTier { id } createdAt description descriptionHTML id isCustomAmount isOneTime monthlyPriceInCents monthlyPriceInDollars name sponsorsListing { id } updatedAt }"
            field: "createSponsorsTier"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateSponsorsTierInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createSponsorsTier"
          t: {
            req: "`reqdata`"
            res: "`body.data.createSponsorsTier.sponsorsTier`"
          }
        }
        {
          co: {
            id: "POST publishSponsorsTier"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation SponsorsTierCreatePublish($input: PublishSponsorsTierInput!) { publishSponsorsTier(input: $input) { sponsorsTier { ...SponsorsTierFields } } } fragment SponsorsTierFields on SponsorsTier { closestLesserValueTier { id } createdAt description descriptionHTML id isCustomAmount isOneTime monthlyPriceInCents monthlyPriceInDollars name sponsorsListing { id } updatedAt }"
            field: "publishSponsorsTier"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "PublishSponsorsTierInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "publishSponsorsTier"
          q: {
            "$action": "publish"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.publishSponsorsTier.sponsorsTier`"
          }
        }
        {
          co: {
            id: "POST retireSponsorsTier"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation SponsorsTierCreateRetire($input: RetireSponsorsTierInput!) { retireSponsorsTier(input: $input) { sponsorsTier { ...SponsorsTierFields } } } fragment SponsorsTierFields on SponsorsTier { closestLesserValueTier { id } createdAt description descriptionHTML id isCustomAmount isOneTime monthlyPriceInCents monthlyPriceInDollars name sponsorsListing { id } updatedAt }"
            field: "retireSponsorsTier"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "RetireSponsorsTierInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "retireSponsorsTier"
          q: {
            "$action": "retire"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.retireSponsorsTier.sponsorsTier`"
          }
        }
      ]
    }
  }



}