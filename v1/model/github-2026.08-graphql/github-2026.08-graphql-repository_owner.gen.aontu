          }
          graphql: {
            doc: "query RepositoryOwnerLoad($login: String!) { repositoryOwner(login: $login) { ...RepositoryOwnerFields } } fragment RepositoryOwnerFields on RepositoryOwner { avatarUrl id login resourcePath url }"
            field: "repositoryOwner"
            optype: "query"
            vars: [
              {
                from: "login"
                gqltype: "String!"
