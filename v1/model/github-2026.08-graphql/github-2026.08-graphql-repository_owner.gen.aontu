              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "repositoryOwner"
          select: {
            exist: [
              "login"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.repositoryOwner`"
          }
