    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "login"
      req: true
      type: "`$STRING`"
    }
    {
      name: "resourcePath"
      req: true
      type: "`$ANY`"
    }
    {
