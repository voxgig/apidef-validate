# Entity: merge_queue_entry

main: kit: entity: merge_queue_entry: {

  alias: field: {}

  fields: {
    baseCommit: {
      h: "Base Commit"
      n: "baseCommit"
      r: false
      sh: "The base commit for this entry"
      t: "`$OBJECT`"
    }
    enqueuedAt: {
      h: "Enqueued At"
      n: "enqueuedAt"
      r: true
      sh: "The date and time this entry was added to the merge queue"
      t: "`$ANY`"
    }
    estimatedTimeToMerge: {
      h: "Estimated Time To Merge"
      n: "estimatedTimeToMerge"
      r: false
      sh: "The estimated time in seconds until this entry will be merged"
      t: "`$INTEGER`"
    }
    headCommit: {
      h: "Head Commit"
      n: "headCommit"
      r: false
      sh: "The head commit for this entry"
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the MergeQueueEntry object"
      t: "`$STRING`"
    }
    jump: {
      h: "Jump"
      n: "jump"
      r: true
      sh: "Whether this pull request should jump the queue"
      t: "`$BOOLEAN`"
    }
    mergeQueue: {
      h: "Merge Queue"
      n: "mergeQueue"
      r: false
      sh: "The merge queue that this entry belongs to"
      t: "`$OBJECT`"
    }
    position: {
      h: "Position"
      n: "position"
      r: true
      sh: "The position of this entry in the queue"
      t: "`$INTEGER`"
    }
    pullRequest: {
      h: "Pull Request"
      n: "pullRequest"
      r: false
      sh: "The pull request that will be added to a merge group"
      t: "`$OBJECT`"
    }
    solo: {
      h: "Solo"
      n: "solo"
      r: true
      sh: "Does this pull request need to be deployed on its own"
      t: "`$BOOLEAN`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "The state of this entry in the queue"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "merge_queue_entry"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST dequeuePullRequest"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation MergeQueueEntryCreateDequeuePullRequest($input: DequeuePullRequestInput!) { dequeuePullRequest(input: $input) { mergeQueueEntry { ...MergeQueueEntryFields } } } fragment MergeQueueEntryFields on MergeQueueEntry { baseCommit { id } enqueuedAt estimatedTimeToMerge headCommit { id } id jump mergeQueue { id } position pullRequest { id } solo state }"
            field: "dequeuePullRequest"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "DequeuePullRequestInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "dequeuePullRequest"
          select: {
            "$action": "dequeue_pull_request"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.dequeuePullRequest.mergeQueueEntry`"
          }
        }
        {
          contract: {
            id: "POST enqueuePullRequest"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation MergeQueueEntryCreateEnqueuePullRequest($input: EnqueuePullRequestInput!) { enqueuePullRequest(input: $input) { mergeQueueEntry { ...MergeQueueEntryFields } } } fragment MergeQueueEntryFields on MergeQueueEntry { baseCommit { id } enqueuedAt estimatedTimeToMerge headCommit { id } id jump mergeQueue { id } position pullRequest { id } solo state }"
            field: "enqueuePullRequest"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "EnqueuePullRequestInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "enqueuePullRequest"
          select: {
            "$action": "enqueue_pull_request"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.enqueuePullRequest.mergeQueueEntry`"
          }
        }
      ]
    }
  }



}