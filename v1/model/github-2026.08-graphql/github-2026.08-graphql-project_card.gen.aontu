# Entity: project_card

main: kit: entity: project_card: {

  alias: field: {}

  name: "project_card"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation ProjectCardCreateConvertProjectCardNoteToIssue($input: ConvertProjectCardNoteToIssueInput!) { convertProjectCardNoteToIssue(input: $input) { projectCard { id } } }"
            field: "convertProjectCardNoteToIssue"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ConvertProjectCardNoteToIssueInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "convertProjectCardNoteToIssue"
          select: {
            "$action": "convert_project_card_note_to_issue"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.convertProjectCardNoteToIssue.projectCard`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          graphql: {
            doc: "mutation ProjectCardUpdate($input: UpdateProjectCardInput!) { updateProjectCard(input: $input) { projectCard { id } } }"
            field: "updateProjectCard"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateProjectCardInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updateProjectCard"
          transform: {
            req: "`reqdata`"
            res: "`body.data.updateProjectCard.projectCard`"
          }
        }
      ]
    }
  }



}