      t: "`$STRING`"
    }
    publishedAt: {
      h: "Published At"
      n: "publishedAt"
      r: false
      sh: "Identifies when the comment was published at."
      t: "`$ANY`"
    }
    pullRequest: {
      h: "Pull Request"
      n: "pullRequest"
      r: false
      sh: "Identifies the pull request associated with this pull request review."
      t: "`$OBJECT`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The repository associated with this node."
      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path permalink for this PullRequestReview."
      t: "`$ANY`"
    }
    state: {
