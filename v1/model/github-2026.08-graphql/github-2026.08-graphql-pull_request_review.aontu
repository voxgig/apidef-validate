# Entity: pull_request_review

main: kit: entity: pull_request_review: {

  alias: field: {}

  fields: {
    authorAssociation: {
      h: "Author Association"
      n: "authorAssociation"
      r: true
      sh: "Author's association with the subject of the comment."
      t: "`$STRING`"
    }
    authorCanPushToRepository: {
      h: "Author Can Push To Repository"
      n: "authorCanPushToRepository"
      r: true
      sh: "Indicates whether the author of this review has push access to the repository."
      t: "`$BOOLEAN`"
    }
    body: {
      h: "Body"
      n: "body"
      r: true
      sh: "Identifies the pull request review body."
