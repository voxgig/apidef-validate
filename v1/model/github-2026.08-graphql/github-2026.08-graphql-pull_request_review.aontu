      t: "`$STRING`"
    }
    submittedAt: {
      h: "Submitted At"
      n: "submittedAt"
      r: false
      sh: "Identifies when the Pull Request Review was submitted"
      t: "`$ANY`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL permalink for this PullRequestReview."
      t: "`$STRING`"
    }
    viewerCanDelete: {
      h: "Viewer Can Delete"
      n: "viewerCanDelete"
      r: true
      sh: "Check if the current viewer can delete this object."
