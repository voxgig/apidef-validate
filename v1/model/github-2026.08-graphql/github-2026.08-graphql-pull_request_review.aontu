      h: "Created Via Email"
      n: "createdViaEmail"
      r: true
      sh: "Check if this comment was created via an email reply."
      t: "`$BOOLEAN`"
    }
    fullDatabaseId: {
      h: "Full Database Id"
      n: "fullDatabaseId"
      r: false
      sh: "Identifies the primary key from the database as a BigInt."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the PullRequestReview object"
      t: "`$STRING`"
    }
    includesCreatedEdit: {
      h: "Includes Created Edit"
      n: "includesCreatedEdit"
      r: true
      sh: "Check if this comment was edited and includes an edit with the creation data"
      t: "`$BOOLEAN`"
    }
    isMinimized: {
      h: "Is Minimized"
      n: "isMinimized"
      r: true
      sh: "Returns whether or not a comment has been minimized."
      t: "`$BOOLEAN`"
    }
    lastEditedAt: {
      h: "Last Edited At"
      n: "lastEditedAt"
      r: false
      sh: "The moment the editor made the last edit"
      t: "`$ANY`"
    }
    minimizedReason: {
      h: "Minimized Reason"
      n: "minimizedReason"
      r: false
