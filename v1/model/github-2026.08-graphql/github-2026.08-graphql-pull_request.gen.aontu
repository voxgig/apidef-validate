# Entity: pull_request

main: kit: entity: pull_request: {

  alias: field: {}

  fields: {
    activeLockReason: {
      h: "Active Lock Reason"
      n: "activeLockReason"
      r: false
      sh: "Reason that the conversation was locked."
      t: "`$STRING`"
    }
    additions: {
      h: "Additions"
      n: "additions"
      r: true
      sh: "The number of additions in this pull request."
      t: "`$INTEGER`"
    }
    authorAssociation: {
      h: "Author Association"
      n: "authorAssociation"
      r: true
      sh: "Author's association with the subject of the comment."
      t: "`$STRING`"
    }
    baseRef: {
      h: "Base Ref"
      n: "baseRef"
      r: false
      sh: "Identifies the base Ref associated with the pull request."
      t: "`$OBJECT`"
    }
    baseRefName: {
      h: "Base Ref Name"
      n: "baseRefName"
      r: true
      sh: "Identifies the name of the base Ref associated with the pull request, even if the ref has been deleted."
      t: "`$STRING`"
    }
    baseRefOid: {
      h: "Base Ref Oid"
      n: "baseRefOid"
      r: true
      sh: "Identifies the oid of the base ref associated with the pull request, even if the ref has been deleted."
      t: "`$ANY`"
    }
    baseRepository: {
      h: "Base Repository"
      n: "baseRepository"
      r: false
      sh: "The repository associated with this pull request's base Ref."
      t: "`$OBJECT`"
    }
    body: {
      h: "Body"
      n: "body"
      r: true
      sh: "The body as Markdown."
      t: "`$STRING`"
    }
    bodyHTML: {
      h: "Body Html"
      n: "bodyHTML"
      r: true
      sh: "The body rendered to HTML."
      t: "`$ANY`"
    }
    bodyText: {
      h: "Body Text"
      n: "bodyText"
      r: true
      sh: "The body rendered to text."
      t: "`$STRING`"
    }
    canBeRebased: {
      h: "Can Be Rebased"
      n: "canBeRebased"
      r: true
      sh: "Whether or not the pull request is rebaseable."
      t: "`$BOOLEAN`"
    }
    changedFiles: {
      h: "Changed Files"
      n: "changedFiles"
      r: true
      sh: "The number of changed files in this pull request."
      t: "`$INTEGER`"
    }
    checksResourcePath: {
      h: "Checks Resource Path"
      n: "checksResourcePath"
      r: true
      sh: "The HTTP path for the checks of this pull request."
      t: "`$ANY`"
    }
    checksUrl: {
      h: "Checks Url"
      n: "checksUrl"
      r: true
      sh: "The HTTP URL for the checks of this pull request."
      t: "`$ANY`"
    }
    closed: {
      h: "Closed"
      n: "closed"
      r: true
      sh: "`true` if the pull request is closed"
      t: "`$BOOLEAN`"
    }
    closedAt: {
      h: "Closed At"
      n: "closedAt"
      r: false
      sh: "Identifies the date and time when the object was closed."
      t: "`$ANY`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    createdViaEmail: {
      h: "Created Via Email"
      n: "createdViaEmail"
      r: true
      sh: "Check if this comment was created via an email reply."
      t: "`$BOOLEAN`"
    }
    deletions: {
      h: "Deletions"
      n: "deletions"
      r: true
      sh: "The number of deletions in this pull request."
      t: "`$INTEGER`"
    }
    fullDatabaseId: {
      h: "Full Database Id"
      n: "fullDatabaseId"
      r: false
      sh: "Identifies the primary key from the database as a BigInt."
      t: "`$ANY`"
    }
    headRef: {
      h: "Head Ref"
      n: "headRef"
      r: false
      sh: "Identifies the head Ref associated with the pull request."
      t: "`$OBJECT`"
    }
    headRefName: {
      h: "Head Ref Name"
      n: "headRefName"
      r: true
      sh: "Identifies the name of the head Ref associated with the pull request, even if the ref has been deleted."
      t: "`$STRING`"
    }
    headRefOid: {
      h: "Head Ref Oid"
      n: "headRefOid"
      r: true
      sh: "Identifies the oid of the head ref associated with the pull request, even if the ref has been deleted."
      t: "`$ANY`"
    }
    headRepository: {
      h: "Head Repository"
      n: "headRepository"
      r: false
      sh: "The repository associated with this pull request's head Ref."
      t: "`$OBJECT`"
    }
    headRepositoryOwner: {
      h: "Head Repository Owner"
      n: "headRepositoryOwner"
      r: false
      sh: "The owner of the repository associated with this pull request's head Ref."
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the PullRequest object"
      t: "`$STRING`"
    }
    includesCreatedEdit: {
      h: "Includes Created Edit"
      n: "includesCreatedEdit"
      r: true
      sh: "Check if this comment was edited and includes an edit with the creation data"
      t: "`$BOOLEAN`"
    }
    isCrossRepository: {
      h: "Is Cross Repository"
      n: "isCrossRepository"
      r: true
      sh: "The head and base repositories are different."
      t: "`$BOOLEAN`"
    }
    isDraft: {
      h: "Is Draft"
      n: "isDraft"
      r: true
      sh: "Identifies if the pull request is a draft."
      t: "`$BOOLEAN`"
    }
    isInMergeQueue: {
      h: "Is In Merge Queue"
      n: "isInMergeQueue"
      r: true
      sh: "Indicates whether the pull request is in a merge queue"
      t: "`$BOOLEAN`"
    }
    isMergeQueueEnabled: {
      h: "Is Merge Queue Enabled"
      n: "isMergeQueueEnabled"
      r: true
      sh: "Indicates whether the pull request's base ref has a merge queue enabled."
      t: "`$BOOLEAN`"
    }
    isReadByViewer: {
      h: "Is Read By Viewer"
      n: "isReadByViewer"
      r: false
      sh: "Is this pull request read by the viewer"
      t: "`$BOOLEAN`"
    }
    lastEditedAt: {
      h: "Last Edited At"
      n: "lastEditedAt"
      r: false
      sh: "The moment the editor made the last edit"
      t: "`$ANY`"
    }
    locked: {
      h: "Locked"
      n: "locked"
      r: true
      sh: "`true` if the pull request is locked"
      t: "`$BOOLEAN`"
    }
    maintainerCanModify: {
      h: "Maintainer Can Modify"
      n: "maintainerCanModify"
      r: true
      sh: "Indicates whether maintainers can modify the pull request."
      t: "`$BOOLEAN`"
    }
    mergeCommit: {
      h: "Merge Commit"
      n: "mergeCommit"
      r: false
      sh: "The commit that was created when this pull request was merged."
      t: "`$OBJECT`"
    }
    mergeQueue: {
      h: "Merge Queue"
      n: "mergeQueue"
      r: false
      sh: "The merge queue for the pull request's base branch"
      t: "`$OBJECT`"
    }
    mergeQueueEntry: {
      h: "Merge Queue Entry"
      n: "mergeQueueEntry"
      r: false
      sh: "The merge queue entry of the pull request in the base branch's merge queue"
      t: "`$OBJECT`"
    }
    mergeStateStatus: {
      h: "Merge State Status"
      n: "mergeStateStatus"
      r: true
      sh: "Detailed information about the current pull request merge state status."
      t: "`$STRING`"
    }
    mergeable: {
      h: "Mergeable"
      n: "mergeable"
      r: true
      sh: "Whether or not the pull request can be merged based on the existence of merge conflicts."
      t: "`$STRING`"
    }
    merged: {
      h: "Merged"
      n: "merged"
      r: true
      sh: "Whether or not the pull request was merged."
      t: "`$BOOLEAN`"
    }
    mergedAt: {
      h: "Merged At"
      n: "mergedAt"
      r: false
      sh: "The date and time that the pull request was merged."
      t: "`$ANY`"
    }
    milestone: {
      h: "Milestone"
      n: "milestone"
      r: false
      sh: "Identifies the milestone associated with the pull request."
      t: "`$OBJECT`"
    }
    number: {
      h: "Number"
      n: "number"
      r: true
      sh: "Identifies the pull request number."
      t: "`$INTEGER`"
    }
    permalink: {
      h: "Permalink"
      n: "permalink"
      r: true
      sh: "The permalink to the pull request."
      t: "`$ANY`"
    }
    potentialMergeCommit: {
      h: "Potential Merge Commit"
      n: "potentialMergeCommit"
      r: false
      sh: "The commit that GitHub automatically generated to test if this pull request could be merged."
      t: "`$OBJECT`"
    }
    publishedAt: {
      h: "Published At"
      n: "publishedAt"
      r: false
      sh: "Identifies when the comment was published at."
      t: "`$ANY`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The repository associated with this node."
      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this pull request."
      t: "`$ANY`"
    }
    revertResourcePath: {
      h: "Revert Resource Path"
      n: "revertResourcePath"
      r: true
      sh: "The HTTP path for reverting this pull request."
      t: "`$ANY`"
    }
    revertUrl: {
      h: "Revert Url"
      n: "revertUrl"
      r: true
      sh: "The HTTP URL for reverting this pull request."
      t: "`$ANY`"
    }
    reviewDecision: {
      h: "Review Decision"
      n: "reviewDecision"
      r: false
      sh: "The current status of this pull request with respect to code review."
      t: "`$STRING`"
    }
    stack: {
      h: "Stack"
      n: "stack"
      r: false
      sh: "The stack this Pull Request belongs to, or null if it is not part of a stack"
      t: "`$OBJECT`"
    }
    stackEntry: {
      h: "Stack Entry"
      n: "stackEntry"
      r: false
      sh: "The stack entry for this Pull Request, or null if it is not part of a stack"
      t: "`$OBJECT`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "Identifies the state of the pull request."
      t: "`$STRING`"
    }
    statusCheckRollup: {
      h: "Status Check Rollup"
      n: "statusCheckRollup"
      r: false
      sh: "Check and Status rollup information for the PR's head ref."
      t: "`$OBJECT`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "Identifies the pull request title."
      t: "`$STRING`"
    }
    titleHTML: {
      h: "Title Html"
      n: "titleHTML"
      r: true
      sh: "Identifies the pull request title rendered to HTML."
      t: "`$ANY`"
    }
    totalCommentsCount: {
      h: "Total Comments Count"
      n: "totalCommentsCount"
      r: false
      sh: "Returns a count of how many comments this pull request has received."
      t: "`$INTEGER`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this pull request."
      t: "`$STRING`"
    }
    viewerCanApplySuggestion: {
      h: "Viewer Can Apply Suggestion"
      n: "viewerCanApplySuggestion"
      r: true
      sh: "Whether or not the viewer can apply suggestion."
      t: "`$BOOLEAN`"
    }
    viewerCanAssign: {
      h: "Viewer Can Assign"
      n: "viewerCanAssign"
      r: true
      sh: "Indicates if the viewer can edit assignees for this object."
      t: "`$BOOLEAN`"
    }
    viewerCanClose: {
      h: "Viewer Can Close"
      n: "viewerCanClose"
      r: true
      sh: "Indicates if the object can be closed by the viewer."
      t: "`$BOOLEAN`"
    }
    viewerCanDeleteHeadRef: {
      h: "Viewer Can Delete Head Ref"
      n: "viewerCanDeleteHeadRef"
      r: true
      sh: "Check if the viewer can restore the deleted head ref."
      t: "`$BOOLEAN`"
    }
    viewerCanDisableAutoMerge: {
      h: "Viewer Can Disable Auto Merge"
      n: "viewerCanDisableAutoMerge"
      r: true
      sh: "Whether or not the viewer can disable auto-merge"
      t: "`$BOOLEAN`"
    }
    viewerCanEditFiles: {
      h: "Viewer Can Edit Files"
      n: "viewerCanEditFiles"
      r: true
      sh: "Can the viewer edit files within this pull request."
      t: "`$BOOLEAN`"
    }
    viewerCanEnableAutoMerge: {
      h: "Viewer Can Enable Auto Merge"
      n: "viewerCanEnableAutoMerge"
      r: true
      sh: "Whether or not the viewer can enable auto-merge"
      t: "`$BOOLEAN`"
    }
    viewerCanLabel: {
      h: "Viewer Can Label"
      n: "viewerCanLabel"
      r: true
      sh: "Indicates if the viewer can edit labels for this object."
      t: "`$BOOLEAN`"
    }
    viewerCanMergeAsAdmin: {
      h: "Viewer Can Merge As Admin"
      n: "viewerCanMergeAsAdmin"
      r: true
      sh: "Indicates whether the viewer can bypass branch protections and merge the pull request immediately"
      t: "`$BOOLEAN`"
    }
    viewerCanReact: {
      h: "Viewer Can React"
      n: "viewerCanReact"
      r: true
      sh: "Can user react to this subject"
      t: "`$BOOLEAN`"
    }
    viewerCanReopen: {
      h: "Viewer Can Reopen"
      n: "viewerCanReopen"
      r: true
      sh: "Indicates if the object can be reopened by the viewer."
      t: "`$BOOLEAN`"
    }
    viewerCanSubscribe: {
      h: "Viewer Can Subscribe"
      n: "viewerCanSubscribe"
      r: true
      sh: "Check if the viewer is able to change their subscription status for the repository."
      t: "`$BOOLEAN`"
    }
    viewerCanUpdate: {
      h: "Viewer Can Update"
      n: "viewerCanUpdate"
      r: true
      sh: "Check if the current viewer can update this object."
      t: "`$BOOLEAN`"
    }
    viewerCanUpdateBranch: {
      h: "Viewer Can Update Branch"
      n: "viewerCanUpdateBranch"
      r: true
      sh: "Whether or not the viewer can update the head ref of this PR, by merging or rebasing the base ref."
      t: "`$BOOLEAN`"
    }
    viewerCannotUpdateReasons: {
      h: "Viewer Cannot Update Reasons"
      n: "viewerCannotUpdateReasons"
      r: true
      sh: "Reasons why the current viewer can not update this comment."
      t: "`$STRING`"
    }
    viewerDidAuthor: {
      h: "Viewer Did Author"
      n: "viewerDidAuthor"
      r: true
      sh: "Did the viewer author this comment."
      t: "`$BOOLEAN`"
    }
    viewerLatestReview: {
      h: "Viewer Latest Review"
      n: "viewerLatestReview"
      r: false
      sh: "The latest review given from the viewer."
      t: "`$OBJECT`"
    }
    viewerLatestReviewRequest: {
      h: "Viewer Latest Review Request"
      n: "viewerLatestReviewRequest"
      r: false
      sh: "The person who has requested the viewer for review on this pull request."
      t: "`$OBJECT`"
    }
    viewerMergeBodyText: {
      h: "Viewer Merge Body Text"
      n: "viewerMergeBodyText"
      r: true
      sh: "The merge body text for the viewer and method."
      t: "`$STRING`"
    }
    viewerMergeHeadlineText: {
      h: "Viewer Merge Headline Text"
      n: "viewerMergeHeadlineText"
      r: true
      sh: "The merge headline text for the viewer and method."
      t: "`$STRING`"
    }
    viewerSubscription: {
      h: "Viewer Subscription"
      n: "viewerSubscription"
      r: false
      sh: "Identifies if the viewer is watching, not watching, or ignoring the subscribable entity."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "pull_request"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST archivePullRequest"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation PullRequestCreateArchive($input: ArchivePullRequestInput!) { archivePullRequest(input: $input) { pullRequest { ...PullRequestFields } } } fragment PullRequestFields on PullRequest { activeLockReason additions authorAssociation baseRef { id } baseRefName baseRefOid baseRepository { id } body bodyHTML bodyText canBeRebased changedFiles checksResourcePath checksUrl closed closedAt createdAt createdViaEmail deletions fullDatabaseId headRef { id } headRefName headRefOid headRepository { id } headRepositoryOwner { id } id includesCreatedEdit isCrossRepository isDraft isInMergeQueue isMergeQueueEnabled isReadByViewer lastEditedAt locked maintainerCanModify mergeCommit { id } mergeQueue { id } mergeQueueEntry { id } mergeStateStatus mergeable merged mergedAt milestone { id } number permalink potentialMergeCommit { id } publishedAt repository { id } resourcePath revertResourcePath revertUrl reviewDecision stack { id } stackEntry { id } state statusCheckRollup { id } title titleHTML totalCommentsCount updatedAt url viewerCanApplySuggestion viewerCanAssign viewerCanClose viewerCanDeleteHeadRef viewerCanDisableAutoMerge viewerCanEditFiles viewerCanEnableAutoMerge viewerCanLabel viewerCanMergeAsAdmin viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpdateBranch viewerCannotUpdateReasons viewerDidAuthor viewerLatestReview { id } viewerLatestReviewRequest { id } viewerMergeBodyText viewerMergeHeadlineText viewerSubscription }"
            field: "archivePullRequest"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ArchivePullRequestInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "archivePullRequest"
          q: {
            "$action": "archive"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.archivePullRequest.pullRequest`"
          }
        }
        {
          co: {
            id: "POST closePullRequest"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation PullRequestCreateClose($input: ClosePullRequestInput!) { closePullRequest(input: $input) { pullRequest { ...PullRequestFields } } } fragment PullRequestFields on PullRequest { activeLockReason additions authorAssociation baseRef { id } baseRefName baseRefOid baseRepository { id } body bodyHTML bodyText canBeRebased changedFiles checksResourcePath checksUrl closed closedAt createdAt createdViaEmail deletions fullDatabaseId headRef { id } headRefName headRefOid headRepository { id } headRepositoryOwner { id } id includesCreatedEdit isCrossRepository isDraft isInMergeQueue isMergeQueueEnabled isReadByViewer lastEditedAt locked maintainerCanModify mergeCommit { id } mergeQueue { id } mergeQueueEntry { id } mergeStateStatus mergeable merged mergedAt milestone { id } number permalink potentialMergeCommit { id } publishedAt repository { id } resourcePath revertResourcePath revertUrl reviewDecision stack { id } stackEntry { id } state statusCheckRollup { id } title titleHTML totalCommentsCount updatedAt url viewerCanApplySuggestion viewerCanAssign viewerCanClose viewerCanDeleteHeadRef viewerCanDisableAutoMerge viewerCanEditFiles viewerCanEnableAutoMerge viewerCanLabel viewerCanMergeAsAdmin viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpdateBranch viewerCannotUpdateReasons viewerDidAuthor viewerLatestReview { id } viewerLatestReviewRequest { id } viewerMergeBodyText viewerMergeHeadlineText viewerSubscription }"
            field: "closePullRequest"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ClosePullRequestInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "closePullRequest"
          q: {
            "$action": "close"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.closePullRequest.pullRequest`"
          }
        }
        {
          co: {
            id: "POST convertPullRequestToDraft"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation PullRequestCreateConvertPullRequestToDraft($input: ConvertPullRequestToDraftInput!) { convertPullRequestToDraft(input: $input) { pullRequest { ...PullRequestFields } } } fragment PullRequestFields on PullRequest { activeLockReason additions authorAssociation baseRef { id } baseRefName baseRefOid baseRepository { id } body bodyHTML bodyText canBeRebased changedFiles checksResourcePath checksUrl closed closedAt createdAt createdViaEmail deletions fullDatabaseId headRef { id } headRefName headRefOid headRepository { id } headRepositoryOwner { id } id includesCreatedEdit isCrossRepository isDraft isInMergeQueue isMergeQueueEnabled isReadByViewer lastEditedAt locked maintainerCanModify mergeCommit { id } mergeQueue { id } mergeQueueEntry { id } mergeStateStatus mergeable merged mergedAt milestone { id } number permalink potentialMergeCommit { id } publishedAt repository { id } resourcePath revertResourcePath revertUrl reviewDecision stack { id } stackEntry { id } state statusCheckRollup { id } title titleHTML totalCommentsCount updatedAt url viewerCanApplySuggestion viewerCanAssign viewerCanClose viewerCanDeleteHeadRef viewerCanDisableAutoMerge viewerCanEditFiles viewerCanEnableAutoMerge viewerCanLabel viewerCanMergeAsAdmin viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpdateBranch viewerCannotUpdateReasons viewerDidAuthor viewerLatestReview { id } viewerLatestReviewRequest { id } viewerMergeBodyText viewerMergeHeadlineText viewerSubscription }"
            field: "convertPullRequestToDraft"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ConvertPullRequestToDraftInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "convertPullRequestToDraft"
          q: {
            "$action": "convert_pull_request_to_draft"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.convertPullRequestToDraft.pullRequest`"
          }
        }
        {
          co: {
            id: "POST createPullRequest"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation PullRequestCreate($input: CreatePullRequestInput!) { createPullRequest(input: $input) { pullRequest { ...PullRequestFields } } } fragment PullRequestFields on PullRequest { activeLockReason additions authorAssociation baseRef { id } baseRefName baseRefOid baseRepository { id } body bodyHTML bodyText canBeRebased changedFiles checksResourcePath checksUrl closed closedAt createdAt createdViaEmail deletions fullDatabaseId headRef { id } headRefName headRefOid headRepository { id } headRepositoryOwner { id } id includesCreatedEdit isCrossRepository isDraft isInMergeQueue isMergeQueueEnabled isReadByViewer lastEditedAt locked maintainerCanModify mergeCommit { id } mergeQueue { id } mergeQueueEntry { id } mergeStateStatus mergeable merged mergedAt milestone { id } number permalink potentialMergeCommit { id } publishedAt repository { id } resourcePath revertResourcePath revertUrl reviewDecision stack { id } stackEntry { id } state statusCheckRollup { id } title titleHTML totalCommentsCount updatedAt url viewerCanApplySuggestion viewerCanAssign viewerCanClose viewerCanDeleteHeadRef viewerCanDisableAutoMerge viewerCanEditFiles viewerCanEnableAutoMerge viewerCanLabel viewerCanMergeAsAdmin viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpdateBranch viewerCannotUpdateReasons viewerDidAuthor viewerLatestReview { id } viewerLatestReviewRequest { id } viewerMergeBodyText viewerMergeHeadlineText viewerSubscription }"
            field: "createPullRequest"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreatePullRequestInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createPullRequest"
          t: {
            req: "`reqdata`"
            res: "`body.data.createPullRequest.pullRequest`"
          }
        }
        {
          co: {
            id: "POST disablePullRequestAutoMerge"
            source: "graphql"
            version: 2
