# Entity: discussion_poll_option

main: kit: entity: discussion_poll_option: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: true
      short: "The Node ID of the DiscussionPollOption object"
      type: "`$STRING`"
    }
    {
      name: "option"
      req: true
      short: "The text for this option."
      type: "`$STRING`"
    }
    {
      name: "poll"
      req: false
      short: "The discussion poll that this option belongs to."
      type: "`$OBJECT`"
    }
    {
      name: "totalVoteCount"
      req: true
      short: "The total number of votes that have been cast for this option."
      type: "`$INTEGER`"
    }
    {
      name: "viewerHasVoted"
      req: true
      short: "Indicates if the viewer has voted for this option in the poll."
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "discussion_poll_option"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation DiscussionPollOptionCreateAddDiscussionPollVote($input: AddDiscussionPollVoteInput!) { addDiscussionPollVote(input: $input) { pollOption { ...DiscussionPollOptionFields } } } fragment DiscussionPollOptionFields on DiscussionPollOption { id option poll { id } totalVoteCount viewerHasVoted }"
            field: "addDiscussionPollVote"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddDiscussionPollVoteInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "addDiscussionPollVote"
          select: {
            "$action": "add_discussion_poll_vote"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.addDiscussionPollVote.pollOption`"
          }
        }
      ]
    }
  }



}