# Entity: verifiable_domain

main: kit: entity: verifiable_domain: {

  alias: field: {}

  fields: {
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    dnsHostName: {
      h: "Dns Host Name"
      n: "dnsHostName"
      r: false
      sh: "The DNS host name that should be used for verification."
      t: "`$ANY`"
    }
    domain: {
      h: "Domain"
      n: "domain"
      r: true
      sh: "The unicode encoded domain."
      t: "`$ANY`"
    }
    hasFoundHostName: {
      h: "Has Found Host Name"
      n: "hasFoundHostName"
      r: true
      sh: "Whether a TXT record for verification with the expected host name was found."
      t: "`$BOOLEAN`"
    }
    hasFoundVerificationToken: {
      h: "Has Found Verification Token"
      n: "hasFoundVerificationToken"
      r: true
      sh: "Whether a TXT record for verification with the expected verification token was found."
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the VerifiableDomain object"
      t: "`$STRING`"
    }
    isApproved: {
      h: "Is Approved"
      n: "isApproved"
      r: true
      sh: "Whether or not the domain is approved."
      t: "`$BOOLEAN`"
    }
    isRequiredForPolicyEnforcement: {
      h: "Is Required For Policy Enforcement"
      n: "isRequiredForPolicyEnforcement"
      r: true
      sh: "Whether this domain is required to exist for an organization or enterprise policy to be enforced."
      t: "`$BOOLEAN`"
    }
    isVerified: {
      h: "Is Verified"
      n: "isVerified"
      r: true
      sh: "Whether or not the domain is verified."
      t: "`$BOOLEAN`"
    }
    punycodeEncodedDomain: {
      h: "Punycode Encoded Domain"
      n: "punycodeEncodedDomain"
      r: true
      sh: "The punycode encoded domain."
      t: "`$ANY`"
    }
    tokenExpirationTime: {
      h: "Token Expiration Time"
      n: "tokenExpirationTime"
      r: false
      sh: "The time that the current verification token will expire."
      t: "`$ANY`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    verificationToken: {
      h: "Verification Token"
      n: "verificationToken"
      r: false
      sh: "The current verification token for the domain."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "verifiable_domain"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST addVerifiableDomain"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation VerifiableDomainCreate($input: AddVerifiableDomainInput!) { addVerifiableDomain(input: $input) { domain { ...VerifiableDomainFields } } } fragment VerifiableDomainFields on VerifiableDomain { createdAt databaseId dnsHostName domain hasFoundHostName hasFoundVerificationToken id isApproved isRequiredForPolicyEnforcement isVerified punycodeEncodedDomain tokenExpirationTime updatedAt verificationToken }"
            field: "addVerifiableDomain"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddVerifiableDomainInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "addVerifiableDomain"
          t: {
            req: "`reqdata`"
            res: "`body.data.addVerifiableDomain.domain`"
          }
        }
        {
          co: {
            id: "POST approveVerifiableDomain"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation VerifiableDomainCreateApprove($input: ApproveVerifiableDomainInput!) { approveVerifiableDomain(input: $input) { domain { ...VerifiableDomainFields } } } fragment VerifiableDomainFields on VerifiableDomain { createdAt databaseId dnsHostName domain hasFoundHostName hasFoundVerificationToken id isApproved isRequiredForPolicyEnforcement isVerified punycodeEncodedDomain tokenExpirationTime updatedAt verificationToken }"
            field: "approveVerifiableDomain"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ApproveVerifiableDomainInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "approveVerifiableDomain"
          q: {
            "$action": "approve"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.approveVerifiableDomain.domain`"
          }
        }
        {
          co: {
            id: "POST verifyVerifiableDomain"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation VerifiableDomainCreateVerify($input: VerifyVerifiableDomainInput!) { verifyVerifiableDomain(input: $input) { domain { ...VerifiableDomainFields } } } fragment VerifiableDomainFields on VerifiableDomain { createdAt databaseId dnsHostName domain hasFoundHostName hasFoundVerificationToken id isApproved isRequiredForPolicyEnforcement isVerified punycodeEncodedDomain tokenExpirationTime updatedAt verificationToken }"
            field: "verifyVerifiableDomain"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "VerifyVerifiableDomainInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "verifyVerifiableDomain"
          q: {
            "$action": "verify"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.verifyVerifiableDomain.domain`"
