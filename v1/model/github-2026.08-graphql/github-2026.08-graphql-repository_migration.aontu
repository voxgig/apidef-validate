# Entity: repository_migration

main: kit: entity: repository_migration: {

  alias: field: {}

  fields: {
    continueOnError: {
      h: "Continue On Error"
      n: "continueOnError"
      r: true
      sh: "The migration flag to continue on error."
      t: "`$BOOLEAN`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$STRING`"
    }
    failureReason: {
      h: "Failure Reason"
      n: "failureReason"
      r: false
      sh: "The reason the migration failed."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the RepositoryMigration object"
      t: "`$STRING`"
    }
    migrationLogUrl: {
      h: "Migration Log Url"
      n: "migrationLogUrl"
      r: false
      sh: "The URL for the migration log (expires 1 day after migration completes)."
      t: "`$ANY`"
    }
    migrationSource: {
      h: "Migration Source"
      n: "migrationSource"
      r: false
      sh: "The migration source."
      t: "`$OBJECT`"
    }
    repositoryName: {
      h: "Repository Name"
      n: "repositoryName"
      r: true
      sh: "The target repository name."
      t: "`$STRING`"
    }
    sourceUrl: {
      h: "Source Url"
      n: "sourceUrl"
      r: true
      sh: "The migration source URL, for example `https://github.com` or `https://monalisa.ghe.com`."
      t: "`$ANY`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "The migration state."
      t: "`$STRING`"
    }
    warningsCount: {
      h: "Warnings Count"
      n: "warningsCount"
      r: true
      sh: "The number of warnings encountered for this migration."
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "repository_migration"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST startRepositoryMigration"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation RepositoryMigrationCreateStart($input: StartRepositoryMigrationInput!) { startRepositoryMigration(input: $input) { repositoryMigration { ...RepositoryMigrationFields } } } fragment RepositoryMigrationFields on RepositoryMigration { continueOnError createdAt databaseId failureReason id migrationLogUrl migrationSource { id } repositoryName sourceUrl state warningsCount }"
            field: "startRepositoryMigration"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "StartRepositoryMigrationInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "startRepositoryMigration"
          q: {
            "$action": "start"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.startRepositoryMigration.repositoryMigration`"
          }
        }
      ]
    }
  }



}