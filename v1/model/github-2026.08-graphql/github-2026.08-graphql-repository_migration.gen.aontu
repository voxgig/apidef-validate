# Entity: repository_migration

main: kit: entity: repository_migration: {

  alias: field: {}

  fields: [
    {
      name: "continueOnError"
      req: true
      short: "The migration flag to continue on error."
      type: "`$BOOLEAN`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$STRING`"
    }
    {
      name: "failureReason"
      req: false
      short: "The reason the migration failed."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the RepositoryMigration object"
      type: "`$STRING`"
    }
    {
      name: "migrationLogUrl"
      req: false
      short: "The URL for the migration log (expires 1 day after migration completes)."
      type: "`$ANY`"
    }
    {
      name: "migrationSource"
      req: false
      short: "The migration source."
      type: "`$OBJECT`"
    }
    {
      name: "repositoryName"
      req: true
      short: "The target repository name."
      type: "`$STRING`"
    }
    {
      name: "sourceUrl"
      req: true
      short: "The migration source URL, for example `https://github.com` or `https://monalisa.ghe.com`."
      type: "`$ANY`"
    }
    {
      name: "state"
      req: true
      short: "The migration state."
      type: "`$STRING`"
    }
    {
      name: "warningsCount"
      req: true
      short: "The number of warnings encountered for this migration."
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "repository_migration"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation RepositoryMigrationCreateStart($input: StartRepositoryMigrationInput!) { startRepositoryMigration(input: $input) { repositoryMigration { ...RepositoryMigrationFields } } } fragment RepositoryMigrationFields on RepositoryMigration { continueOnError createdAt databaseId failureReason id migrationLogUrl migrationSource { id } repositoryName sourceUrl state warningsCount }"
            field: "startRepositoryMigration"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "StartRepositoryMigrationInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "startRepositoryMigration"
          select: {
            "$action": "start"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.startRepositoryMigration.repositoryMigration`"
          }
        }
      ]
    }
  }



}