# Entity: issue_comment

main: kit: entity: issue_comment: {

  alias: field: {}

  fields: [
    {
      name: "authorAssociation"
      req: true
      short: "Author's association with the subject of the comment."
      type: "`$STRING`"
    }
    {
      name: "body"
      req: true
      short: "The body as Markdown."
      type: "`$STRING`"
    }
    {
      name: "bodyHTML"
      req: true
      short: "The body rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "bodyText"
      req: true
      short: "The body rendered to text."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "createdViaEmail"
      req: true
      short: "Check if this comment was created via an email reply."
      type: "`$BOOLEAN`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$INTEGER`"
    }
    {
      name: "fullDatabaseId"
      req: false
      short: "Identifies the primary key from the database as a BigInt."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the IssueComment object"
      type: "`$STRING`"
    }
    {
      name: "includesCreatedEdit"
      req: true
      short: "Check if this comment was edited and includes an edit with the creation data"
      type: "`$BOOLEAN`"
    }
    {
      name: "isMinimized"
      req: true
      short: "Returns whether or not a comment has been minimized."
      type: "`$BOOLEAN`"
    }
    {
      name: "isPinned"
      req: false
      short: "Indicates whether or not this entity is currently pinned."
      type: "`$BOOLEAN`"
    }
    {
      name: "issue"
      req: false
      short: "Identifies the issue associated with the comment."
      type: "`$OBJECT`"
    }
    {
      name: "lastEditedAt"
      req: false
      short: "The moment the editor made the last edit"
      type: "`$ANY`"
    }
    {
      name: "minimizedReason"
      req: false
      short: "Returns why the comment was minimized."
      type: "`$STRING`"
    }
    {
      name: "pinnedAt"
      req: false
      short: "Identifies the date and time when this entity was pinned."
      type: "`$ANY`"
    }
    {
      name: "pinnedBy"
      req: false
      short: "The user who pinned this entity."
      type: "`$OBJECT`"
    }
    {
      name: "publishedAt"
      req: false
      short: "Identifies when the comment was published at."
      type: "`$ANY`"
    }
    {
      name: "pullRequest"
      req: false
      short: "Returns the pull request associated with the comment, if this comment was made on a pull request."
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
      short: "The repository associated with this node."
      type: "`$OBJECT`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this issue comment"
      type: "`$ANY`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this issue comment"
      type: "`$STRING`"
    }
    {
      name: "viewerCanDelete"
      req: true
      short: "Check if the current viewer can delete this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanMinimize"
      req: true
      short: "Check if the current viewer can minimize this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanPin"
      req: true
      short: "Check if the current viewer can pin this entity."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanReact"
      req: true
      short: "Can user react to this subject"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUnminimize"
      req: true
      short: "Check if the current viewer can unminimize this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUnpin"
      req: true
      short: "Check if the current viewer can unpin this entity."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUpdate"
      req: true
      short: "Check if the current viewer can update this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCannotUpdateReasons"
      req: true
      short: "Reasons why the current viewer can not update this comment."
      type: "`$STRING`"
    }
    {
      name: "viewerDidAuthor"
      req: true
      short: "Did the viewer author this comment."
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "issue_comment"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation IssueCommentCreatePin($input: PinIssueCommentInput!) { pinIssueComment(input: $input) { issueComment { ...IssueCommentFields } } } fragment IssueCommentFields on IssueComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId fullDatabaseId id includesCreatedEdit isMinimized isPinned issue { id } lastEditedAt minimizedReason pinnedAt pinnedBy { id } publishedAt pullRequest { id } repository { id } resourcePath updatedAt url viewerCanDelete viewerCanMinimize viewerCanPin viewerCanReact viewerCanUnminimize viewerCanUnpin viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "pinIssueComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "PinIssueCommentInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "pinIssueComment"
          select: {
            "$action": "pin"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.pinIssueComment.issueComment`"
          }
        }
        {
          graphql: {
            doc: "mutation IssueCommentCreateUnpin($input: UnpinIssueCommentInput!) { unpinIssueComment(input: $input) { issueComment { ...IssueCommentFields } } } fragment IssueCommentFields on IssueComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId fullDatabaseId id includesCreatedEdit isMinimized isPinned issue { id } lastEditedAt minimizedReason pinnedAt pinnedBy { id } publishedAt pullRequest { id } repository { id } resourcePath updatedAt url viewerCanDelete viewerCanMinimize viewerCanPin viewerCanReact viewerCanUnminimize viewerCanUnpin viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "unpinIssueComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UnpinIssueCommentInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "unpinIssueComment"
          select: {
            "$action": "unpin"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.unpinIssueComment.issueComment`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          graphql: {
            doc: "mutation IssueCommentUpdate($input: UpdateIssueCommentInput!) { updateIssueComment(input: $input) { issueComment { ...IssueCommentFields } } } fragment IssueCommentFields on IssueComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId fullDatabaseId id includesCreatedEdit isMinimized isPinned issue { id } lastEditedAt minimizedReason pinnedAt pinnedBy { id } publishedAt pullRequest { id } repository { id } resourcePath updatedAt url viewerCanDelete viewerCanMinimize viewerCanPin viewerCanReact viewerCanUnminimize viewerCanUnpin viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "updateIssueComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateIssueCommentInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updateIssueComment"
          transform: {
            req: "`reqdata`"
            res: "`body.data.updateIssueComment.issueComment`"
          }
        }
      ]
    }
  }



}