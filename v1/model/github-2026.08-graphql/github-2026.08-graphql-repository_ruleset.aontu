      points: [
        {
          contract: {
            id: "POST createRepositoryRuleset"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"CreateRepositoryRulesetInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"CreateRepositoryRulesetInput\"}],\"deprecated\":false,\"desc\":\"Create a repository ruleset\",\"gqltype\":\"CreateRepositoryRulesetPayload\",\"list\":false,\"name\":\"createRepositoryRuleset\",\"reqd\":false,\"type\":\"CreateRepositoryRulesetPayload\"},\"invocation\":{\"doc\":\"mutation RepositoryRulesetCreate($input: CreateRepositoryRulesetInput!) { createRepositoryRuleset(input: $input) { ruleset { ...RepositoryRulesetFields } } } fragment RepositoryRulesetFields on RepositoryRuleset { createdAt databaseId enforcement id name target updatedAt }\",\"field\":\"createRepositoryRuleset\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"CreateRepositoryRulesetInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"BranchNamePatternParametersInput\":{\"desc\":\"Parameters to be used for the branch_name_pattern rule\",\"fields\":{\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"How this rule appears when configuring it.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"name\",\"reqd\":false,\"type\":\"String\"},\"negate\":{\"args\":[],\"deprecated\":false,\"desc\":\"If true, the rule will fail if the pattern matches.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"negate\",\"reqd\":false,\"type\":\"Boolean\"},\"operator\":{\"args\":[],\"deprecated\":false,\"desc\":\"The operator to use for matching.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"operator\",\"reqd\":true,\"type\":\"String\"},\"pattern\":{\"args\":[],\"deprecated\":false,\"desc\":\"The pattern to match with.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"pattern\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"BranchNamePatternParametersInput\"},\"CodeScanningParametersInput\":{\"desc\":\"Choose which tools must provide code scanning results before the reference is\\nupdated. When configured, code scanning must be enabled and have results for\\nboth the commit and the reference being updated.\",\"fields\":{\"codeScanningTools\":{\"args\":[],\"deprecated\":false,\"desc\":\"Tools that must provide code scanning results for this rule to pass.\",\"gqltype\":\"[CodeScanningToolInput!]!\",\"list\":true,\"name\":\"codeScanningTools\",\"reqd\":true,\"type\":\"CodeScanningToolInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CodeScanningParametersInput\"},\"CodeScanningToolInput\":{\"desc\":\"A tool that must provide code scanning results for this rule to pass.\",\"fields\":{\"alertsThreshold\":{\"args\":[],\"deprecated\":false,\"desc\":\"The severity level at which code scanning results that raise alerts block a\\nreference update. For more information on alert severity levels, see \\\"[About code scanning alerts](${externalDocsUrl}/code-security/code-scanning/managing-code-scanning-alerts/about-code-scanning-alerts#about-alert-severity-and-security-severity-levels).\\\"\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"alertsThreshold\",\"reqd\":true,\"type\":\"String\"},\"securityAlertsThreshold\":{\"args\":[],\"deprecated\":false,\"desc\":\"The severity level at which code scanning results that raise security alerts\\nblock a reference update. For more information on security severity levels,\\nsee \\\"[About code scanning alerts](${externalDocsUrl}/code-security/code-scanning/managing-code-scanning-alerts/about-code-scanning-alerts#about-alert-severity-and-security-severity-levels).\\\"\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"securityAlertsThreshold\",\"reqd\":true,\"type\":\"String\"},\"tool\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of a code scanning tool\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"tool\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CodeScanningToolInput\"},\"CommitAuthorEmailPatternParametersInput\":{\"desc\":\"Parameters to be used for the commit_author_email_pattern rule\",\"fields\":{\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"How this rule appears when configuring it.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"name\",\"reqd\":false,\"type\":\"String\"},\"negate\":{\"args\":[],\"deprecated\":false,\"desc\":\"If true, the rule will fail if the pattern matches.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"negate\",\"reqd\":false,\"type\":\"Boolean\"},\"operator\":{\"args\":[],\"deprecated\":false,\"desc\":\"The operator to use for matching.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"operator\",\"reqd\":true,\"type\":\"String\"},\"pattern\":{\"args\":[],\"deprecated\":false,\"desc\":\"The pattern to match with.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"pattern\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CommitAuthorEmailPatternParametersInput\"},\"CommitMessagePatternParametersInput\":{\"desc\":\"Parameters to be used for the commit_message_pattern rule\",\"fields\":{\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"How this rule appears when configuring it.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"name\",\"reqd\":false,\"type\":\"String\"},\"negate\":{\"args\":[],\"deprecated\":false,\"desc\":\"If true, the rule will fail if the pattern matches.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"negate\",\"reqd\":false,\"type\":\"Boolean\"},\"operator\":{\"args\":[],\"deprecated\":false,\"desc\":\"The operator to use for matching.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"operator\",\"reqd\":true,\"type\":\"String\"},\"pattern\":{\"args\":[],\"deprecated\":false,\"desc\":\"The pattern to match with.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"pattern\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CommitMessagePatternParametersInput\"},\"CommitterEmailPatternParametersInput\":{\"desc\":\"Parameters to be used for the committer_email_pattern rule\",\"fields\":{\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"How this rule appears when configuring it.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"name\",\"reqd\":false,\"type\":\"String\"},\"negate\":{\"args\":[],\"deprecated\":false,\"desc\":\"If true, the rule will fail if the pattern matches.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"negate\",\"reqd\":false,\"type\":\"Boolean\"},\"operator\":{\"args\":[],\"deprecated\":false,\"desc\":\"The operator to use for matching.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"operator\",\"reqd\":true,\"type\":\"String\"},\"pattern\":{\"args\":[],\"deprecated\":false,\"desc\":\"The pattern to match with.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"pattern\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CommitterEmailPatternParametersInput\"},\"CopilotCodeReviewParametersInput\":{\"desc\":\"Request Copilot code review for new pull requests automatically if the author\\nhas access to Copilot code review and their premium requests quota has not\\nreached the limit.\",\"fields\":{\"reviewDraftPullRequests\":{\"args\":[],\"deprecated\":false,\"desc\":\"Copilot automatically reviews draft pull requests before they are marked as ready for review.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"reviewDraftPullRequests\",\"reqd\":false,\"type\":\"Boolean\"},\"reviewOnPush\":{\"args\":[],\"deprecated\":false,\"desc\":\"Copilot automatically reviews each new push to the pull request.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"reviewOnPush\",\"reqd\":false,\"type\":\"Boolean\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CopilotCodeReviewParametersInput\"},\"CreateRepositoryRulesetInput\":{\"desc\":\"Autogenerated input type of CreateRepositoryRuleset\",\"fields\":{\"bypassActors\":{\"args\":[],\"deprecated\":false,\"desc\":\"A list of actors that are allowed to bypass rules in this ruleset.\",\"gqltype\":\"[RepositoryRulesetBypassActorInput!]\",\"list\":true,\"name\":\"bypassActors\",\"reqd\":false,\"type\":\"RepositoryRulesetBypassActorInput\"},\"clientMutationId\":{\"args\":[],\"deprecated\":false,\"desc\":\"A unique identifier for the client performing the mutation.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"clientMutationId\",\"reqd\":false,\"type\":\"String\"},\"conditions\":{\"args\":[],\"deprecated\":false,\"desc\":\"The set of conditions for this ruleset\",\"gqltype\":\"RepositoryRuleConditionsInput!\",\"list\":false,\"name\":\"conditions\",\"reqd\":true,\"type\":\"RepositoryRuleConditionsInput\"},\"enforcement\":{\"args\":[],\"deprecated\":false,\"desc\":\"The enforcement level for this ruleset\",\"gqltype\":\"RuleEnforcement!\",\"list\":false,\"name\":\"enforcement\",\"reqd\":true,\"type\":\"RuleEnforcement\"},\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the ruleset.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"name\",\"reqd\":true,\"type\":\"String\"},\"rules\":{\"args\":[],\"deprecated\":false,\"desc\":\"The list of rules for this ruleset\",\"gqltype\":\"[RepositoryRuleInput!]\",\"list\":true,\"name\":\"rules\",\"reqd\":false,\"type\":\"RepositoryRuleInput\"},\"sourceId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The global relay id of the source in which a new ruleset should be created in.\",\"gqltype\":\"ID!\",\"list\":false,\"name\":\"sourceId\",\"reqd\":true,\"type\":\"ID\"},\"target\":{\"args\":[],\"deprecated\":false,\"desc\":\"The target of the ruleset.\",\"gqltype\":\"RepositoryRulesetTarget\",\"list\":false,\"name\":\"target\",\"reqd\":false,\"type\":\"RepositoryRulesetTarget\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CreateRepositoryRulesetInput\"},\"DismissalRestrictionInput\":{\"desc\":\"Specify people, teams, or apps allowed to dismiss pull request reviews.\",\"fields\":{\"allowedActors\":{\"args\":[],\"deprecated\":false,\"desc\":\"Specify people, teams, or apps allowed to dismiss pull request reviews.\",\"gqltype\":\"[ID!]\",\"list\":true,\"name\":\"allowedActors\",\"reqd\":false,\"type\":\"ID\"},\"enabled\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether to restrict review dismissal to specific actors.\",\"gqltype\":\"Boolean!\",\"list\":false,\"name\":\"enabled\",\"reqd\":true,\"type\":\"Boolean\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"DismissalRestrictionInput\"},\"FileExtensionRestrictionParametersInput\":{\"desc\":\"Prevent commits that include files with specified file extensions from being pushed to the commit graph.\",\"fields\":{\"restrictedFileExtensions\":{\"args\":[],\"deprecated\":false,\"desc\":\"The file extensions that are restricted from being pushed to the commit graph.\",\"gqltype\":\"[String!]!\",\"list\":true,\"name\":\"restrictedFileExtensions\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"FileExtensionRestrictionParametersInput\"},\"FilePathRestrictionParametersInput\":{\"desc\":\"Prevent commits that include changes in specified file and folder paths from\\nbeing pushed to the commit graph. This includes absolute paths that contain file names.\",\"fields\":{\"restrictedFilePaths\":{\"args\":[],\"deprecated\":false,\"desc\":\"The file paths that are restricted from being pushed to the commit graph.\",\"gqltype\":\"[String!]!\",\"list\":true,\"name\":\"restrictedFilePaths\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"FilePathRestrictionParametersInput\"},\"ID\":{\"desc\":\"The `ID` scalar type represents a unique identifier, often used to refetch an object or as key for a cache. The ID type appears in a JSON response as a String; however, it is not intended to be human-readable. When expected as an input type, any string (such as `\\\"4\\\"`) or integer (such as `4`) input value will be accepted as an ID.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"ID\"},\"Int\":{\"desc\":\"The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Int\"},\"MaxFilePathLengthParametersInput\":{\"desc\":\"Prevent commits that include file paths that exceed the specified character limit from being pushed to the commit graph.\",\"fields\":{\"maxFilePathLength\":{\"args\":[],\"deprecated\":false,\"desc\":\"The maximum amount of characters allowed in file paths.\",\"gqltype\":\"Int!\",\"list\":false,\"name\":\"maxFilePathLength\",\"reqd\":true,\"type\":\"Int\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"MaxFilePathLengthParametersInput\"},\"MaxFileSizeParametersInput\":{\"desc\":\"Prevent commits with individual files that exceed the specified limit from being pushed to the commit graph.\",\"fields\":{\"maxFileSize\":{\"args\":[],\"deprecated\":false,\"desc\":\"The maximum file size allowed in megabytes. This limit does not apply to Git Large File Storage (Git LFS).\",\"gqltype\":\"Int!\",\"list\":false,\"name\":\"maxFileSize\",\"reqd\":true,\"type\":\"Int\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"MaxFileSizeParametersInput\"},\"MergeQueueGroupingStrategy\":{\"desc\":\"When set to ALLGREEN, the merge commit created by merge queue for each PR in the\\ngroup must pass all required checks to merge. When set to HEADGREEN, only the\\ncommit at the head of the merge group, i.e. the commit containing changes from\\nall of the PRs in the group, must pass its required checks to merge.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"MergeQueueGroupingStrategy\",\"values\":[\"ALLGREEN\",\"HEADGREEN\"]},\"MergeQueueMergeMethod\":{\"desc\":\"Method to use when merging changes from queued pull requests.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"MergeQueueMergeMethod\",\"values\":[\"MERGE\",\"REBASE\",\"SQUASH\"]},\"MergeQueueParametersInput\":{\"desc\":\"Merges must be performed via a merge queue.\",\"fields\":{\"checkResponseTimeoutMinutes\":{\"args\":[],\"deprecated\":false,\"desc\":\"Maximum time for a required status check to report a conclusion. After this\\nmuch time has elapsed, checks that have not reported a conclusion will be\\nassumed to have failed\",\"gqltype\":\"Int!\",\"list\":false,\"name\":\"checkResponseTimeoutMinutes\",\"reqd\":true,\"type\":\"Int\"},\"groupingStrategy\":{\"args\":[],\"deprecated\":false,\"desc\":\"When set to ALLGREEN, the merge commit created by merge queue for each PR in\\nthe group must pass all required checks to merge. When set to HEADGREEN, only\\nthe commit at the head of the merge group, i.e. the commit containing changes\\nfrom all of the PRs in the group, must pass its required checks to merge.\",\"gqltype\":\"MergeQueueGroupingStrategy!\",\"list\":false,\"name\":\"groupingStrategy\",\"reqd\":true,\"type\":\"MergeQueueGroupingStrategy\"},\"maxEntriesToBuild\":{\"args\":[],\"deprecated\":false,\"desc\":\"Limit the number of queued pull requests requesting checks and workflow runs at the same time.\",\"gqltype\":\"Int!\",\"list\":false,\"name\":\"maxEntriesToBuild\",\"reqd\":true,\"type\":\"Int\"},\"maxEntriesToMerge\":{\"args\":[],\"deprecated\":false,\"desc\":\"The maximum number of PRs that will be merged together in a group.\",\"gqltype\":\"Int!\",\"list\":false,\"name\":\"maxEntriesToMerge\",\"reqd\":true,\"type\":\"Int\"},\"mergeMethod\":{\"args\":[],\"deprecated\":false,\"desc\":\"Method to use when merging changes from queued pull requests.\",\"gqltype\":\"MergeQueueMergeMethod!\",\"list\":false,\"name\":\"mergeMethod\",\"reqd\":true,\"type\":\"MergeQueueMergeMethod\"},\"minEntriesToMerge\":{\"args\":[],\"deprecated\":false,\"desc\":\"The minimum number of PRs that will be merged together in a group.\",\"gqltype\":\"Int!\",\"list\":false,\"name\":\"minEntriesToMerge\",\"reqd\":true,\"type\":\"Int\"},\"minEntriesToMergeWaitMinutes\":{\"args\":[],\"deprecated\":false,\"desc\":\"The time merge queue should wait after the first PR is added to the queue for\\nthe minimum group size to be met. After this time has elapsed, the minimum\\ngroup size will be ignored and a smaller group will be merged.\",\"gqltype\":\"Int!\",\"list\":false,\"name\":\"minEntriesToMergeWaitMinutes\",\"reqd\":true,\"type\":\"Int\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"MergeQueueParametersInput\"},\"OrganizationPropertyConditionTargetInput\":{\"desc\":\"Parameters to be used for the organization_property condition\",\"fields\":{\"exclude\":{\"args\":[],\"deprecated\":false,\"desc\":\"Array of organization properties that must not match.\",\"gqltype\":\"[OrganizationPropertyTargetDefinitionInput!]!\",\"list\":true,\"name\":\"exclude\",\"reqd\":true,\"type\":\"OrganizationPropertyTargetDefinitionInput\"},\"include\":{\"args\":[],\"deprecated\":false,\"desc\":\"Array of organization properties that must match\",\"gqltype\":\"[OrganizationPropertyTargetDefinitionInput!]!\",\"list\":true,\"name\":\"include\",\"reqd\":true,\"type\":\"OrganizationPropertyTargetDefinitionInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"OrganizationPropertyConditionTargetInput\"},\"OrganizationPropertyTargetDefinitionInput\":{\"desc\":\"A property that must match\",\"fields\":{\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the property\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"name\",\"reqd\":true,\"type\":\"String\"},\"propertyValues\":{\"args\":[],\"deprecated\":false,\"desc\":\"The values to match for\",\"gqltype\":\"[String!]!\",\"list\":true,\"name\":\"propertyValues\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"OrganizationPropertyTargetDefinitionInput\"},\"PropertyTargetDefinitionInput\":{\"desc\":\"A property that must match\",\"fields\":{\"name\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the property\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"name\",\"reqd\":true,\"type\":\"String\"},\"propertyValues\":{\"args\":[],\"deprecated\":false,\"desc\":\"The values to match for\",\"gqltype\":\"[String!]!\",\"list\":true,\"name\":\"propertyValues\",\"reqd\":true,\"type\":\"String\"},\"source\":{\"args\":[],\"deprecated\":false,\"desc\":\"The source of the property. Choose 'custom' or 'system'. Defaults to 'custom' if not specified\",\"gqltype\":\"String\",\"list\":false,\"name\":\"source\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"PropertyTargetDefinitionInput\"},\"PullRequestAllowedMergeMethods\":{\"desc\":\"Array of allowed merge methods. Allowed values include `merge`, `squash`, and `rebase`. At least one option must be enabled.\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"PullRequestAllowedMergeMethods\",\"values\":[\"MERGE\",\"REBASE\",\"SQUASH\"]},\"PullRequestParametersInput\":{\"desc\":\"Require all commits be made to a non-target branch and submitted via a pull request before they can be merged.\",\"fields\":{\"allowedMergeMethods\":{\"args\":[],\"deprecated\":false,\"desc\":\"Array of allowed merge methods. Allowed values include `merge`, `squash`, and\\n`rebase`. At least one option must be enabled.\",\"gqltype\":\"[PullRequestAllowedMergeMethods!]\",\"list\":true,\"name\":\"allowedMergeMethods\",\"reqd\":false,\"type\":\"PullRequestAllowedMergeMethods\"},\"dismissStaleReviewsOnPush\":{\"args\":[],\"deprecated\":false,\"desc\":\"New, reviewable commits pushed will dismiss previous pull request review approvals.\",\"gqltype\":\"Boolean!\",\"list\":false,\"name\":\"dismissStaleReviewsOnPush\",\"reqd\":true,\"type\":\"Boolean\"},\"dismissalRestriction\":{\"args\":[],\"deprecated\":false,\"desc\":\"Specify people, teams, or apps allowed to dismiss pull request reviews.\",\"gqltype\":\"DismissalRestrictionInput\",\"list\":false,\"name\":\"dismissalRestriction\",\"reqd\":false,\"type\":\"DismissalRestrictionInput\"},\"requireCodeOwnerReview\":{\"args\":[],\"deprecated\":false,\"desc\":\"Require an approving review in pull requests that modify files that have a designated code owner.\",\"gqltype\":\"Boolean!\",\"list\":false,\"name\":\"requireCodeOwnerReview\",\"reqd\":true,\"type\":\"Boolean\"},\"requireLastPushApproval\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether the most recent reviewable push must be approved by someone other than the person who pushed it.\",\"gqltype\":\"Boolean!\",\"list\":false,\"name\":\"requireLastPushApproval\",\"reqd\":true,\"type\":\"Boolean\"},\"requiredApprovingReviewCount\":{\"args\":[],\"deprecated\":false,\"desc\":\"The number of approving reviews that are required before a pull request can be merged.\",\"gqltype\":\"Int!\",\"list\":false,\"name\":\"requiredApprovingReviewCount\",\"reqd\":true,\"type\":\"Int\"},\"requiredReviewThreadResolution\":{\"args\":[],\"deprecated\":false,\"desc\":\"All conversations on code must be resolved before a pull request can be merged.\",\"gqltype\":\"Boolean!\",\"list\":false,\"name\":\"requiredReviewThreadResolution\",\"reqd\":true,\"type\":\"Boolean\"},\"requiredReviewers\":{\"args\":[],\"deprecated\":false,\"desc\":\"This argument is in beta and subject to change. A collection of reviewers and\\nassociated file patterns. Each reviewer has a list of file patterns which\\ndetermine the files that reviewer is required to review.\",\"gqltype\":\"[RequiredReviewerConfigurationInput!]\",\"list\":true,\"name\":\"requiredReviewers\",\"reqd\":false,\"type\":\"RequiredReviewerConfigurationInput\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"PullRequestParametersInput\"},\"RefNameConditionTargetInput\":{\"desc\":\"Parameters to be used for the ref_name condition\",\"fields\":{\"exclude\":{\"args\":[],\"deprecated\":false,\"desc\":\"Array of ref names or patterns to exclude. The condition will not pass if any of these patterns match.\",\"gqltype\":\"[String!]!\",\"list\":true,\"name\":\"exclude\",\"reqd\":true,\"type\":\"String\"},\"include\":{\"args\":[],\"deprecated\":false,\"desc\":\"Array of ref names or patterns to include. One of these patterns must match\\nfor the condition to pass. Also accepts `~DEFAULT_BRANCH` to include the\\ndefault branch or `~ALL` to include all branches.\",\"gqltype\":\"[String!]!\",\"list\":true,\