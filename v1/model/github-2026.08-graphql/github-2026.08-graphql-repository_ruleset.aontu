atches this rule.\",\"fields\":{\"requiredDeploymentEnvironments\":{\"args\":[],\"deprecated\":false,\"desc\":\"The environments that must be successfully deployed to before branches can be merged.\",\"gqltype\":\"[String!]!\",\"list\":true,\"name\":\"requiredDeploymentEnvironments\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"RequiredDeploymentsParametersInput\"},\"RequiredReviewerConfigurationInput\":{\"desc\":\"A reviewing team, and file patterns describing which files they must approve changes to.\",\"fields\":{\"filePatterns\":{\"args\":[],\"deprecated\":false,\"desc\":\"Array of file patterns. Pull requests which change matching files must be\\napproved by the specified team. File patterns use fnmatch syntax.\",\"gqltype\":\"[String!]!\",\"list\":true,\"name\":\"filePatterns\",\"reqd\":true,\"type\":\"String\"},\"minimumApprovals\":{\"args\":[],\"deprecated\":false,\"desc\":\"Minimum number of approvals required from the specified team. If set to zero,\\nthe team will be added to the pull request but approval is optional.\",\"gqltype\":\"Int!\",\"list\":false,\"name\":\"minimumApprovals\",\"reqd\":true,\"type\":\"Int\"},\"reviewerId\":{\"args\":[],\"deprecated\":false,\"desc\":\"Node ID of the team which must review changes to matching files.\",\"gqltype\":\"ID!\",\"list\":false,\"name\":\"reviewerId\",\"reqd\":true,\"type\":\"ID\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"RequiredReviewerConfigurationInput\"},\"RequiredStatusChecksParametersInput\":{\"desc\":\"Choose which status checks must pass before the ref is updated. When enabled,\\ncommits must first be pushed to another ref where the checks pass.\",\"fields\":{\"doNotEnforceOnCreate\":{\"args\":[],\"deprecated\":false,\"desc\":\"Allow repositories and branches to be created if a check would otherwise prohibit it.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"doNotEnforceOnCreate\",\"reqd\":false,\"type\":\"Boolean\"},\"requiredStatusChecks\":{\"args\":[],\"deprecated\":