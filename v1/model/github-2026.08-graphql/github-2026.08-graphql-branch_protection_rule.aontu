# Entity: branch_protection_rule

main: kit: entity: branch_protection_rule: {

  alias: field: {}

  fields: {
    allowsDeletions: {
      h: "Allows Deletions"
      n: "allowsDeletions"
      r: true
      sh: "Can this branch be deleted."
      t: "`$BOOLEAN`"
    }
    allowsForcePushes: {
      h: "Allows Force Pushes"
      n: "allowsForcePushes"
      r: true
      sh: "Are force pushes allowed on this branch."
      t: "`$BOOLEAN`"
    }
    blocksCreations: {
      h: "Blocks Creations"
      n: "blocksCreations"
      r: true
      sh: "Is branch creation a protected operation."
      t: "`$BOOLEAN`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    dismissesStaleReviews: {
      h: "Dismisses Stale Reviews"
      n: "dismissesStaleReviews"
      r: true
      sh: "Will new commits pushed to matching branches dismiss pull request review approvals."
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the BranchProtectionRule object"
      t: "`$STRING`"
    }
    isAdminEnforced: {
      h: "Is Admin Enforced"
      n: "isAdminEnforced"
      r: true
      sh: "Can admins override branch protection."
      t: "`$BOOLEAN`"
    }
    lockAllowsFetchAndMerge: {
      h: "Lock Allows Fetch And Merge"
      n: "lockAllowsFetchAndMerge"
      r: true
      sh: "Whether users can pull changes from upstream when the branch is locked."
      t: "`$BOOLEAN`"
    }
    lockBranch: {
      h: "Lock Branch"
      n: "lockBranch"
      r: true
      sh: "Whether to set the branch as read-only."
      t: "`$BOOLEAN`"
    }
    pattern: {
      h: "Pattern"
      n: "pattern"
      r: true
      sh: "Identifies the protection rule pattern."
      t: "`$STRING`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The repository associated with this branch protection rule."
      t: "`$OBJECT`"
    }
    requireLastPushApproval: {
      h: "Require Last Push Approval"
      n: "requireLastPushApproval"
      r: true
      sh: "Whether the most recent push must be approved by someone other than the person who pushed it"
      t: "`$BOOLEAN`"
    }
    requiredApprovingReviewCount: {
      h: "Required Approving Review Count"
      n: "requiredApprovingReviewCount"
      r: false
      sh: "Number of approving reviews required to update matching branches."
      t: "`$INTEGER`"
    }
    requiredDeploymentEnvironments: {
      h: "Required Deployment Environments"
      n: "requiredDeploymentEnvironments"
      r: false
      sh: "List of required deployment environments that must be deployed successfully to update matching branches"
      t: "`$STRING`"
    }
    requiredStatusCheckContexts: {
      h: "Required Status Check Contexts"
      n: "requiredStatusCheckContexts"
      r: false
      sh: "List of required status check contexts that must pass for commits to be accepted to matching branches."
      t: "`$STRING`"
    }
    requiresApprovingReviews: {
      h: "Requires Approving Reviews"
      n: "requiresApprovingReviews"
      r: true
      sh: "Are approving reviews required to update matching branches."
      t: "`$BOOLEAN`"
    }
    requiresCodeOwnerReviews: {
      h: "Requires Code Owner Reviews"
      n: "requiresCodeOwnerReviews"
      r: true
      sh: "Are reviews from code owners required to update matching branches."
      t: "`$BOOLEAN`"
    }
    requiresCommitSignatures: {
      h: "Requires Commit Signatures"
      n: "requiresCommitSignatures"
      r: true
      sh: "Are commits required to be signed."
      t: "`$BOOLEAN`"
    }
    requiresConversationResolution: {
      h: "Requires Conversation Resolution"
      n: "requiresConversationResolution"
      r: true
      sh: "Are conversations required to be resolved before merging."
      t: "`$BOOLEAN`"
    }
    requiresDeployments: {
      h: "Requires Deployments"
      n: "requiresDeployments"
      r: true
      sh: "Does this branch require deployment to specific environments before merging"
      t: "`$BOOLEAN`"
    }
    requiresLinearHistory: {
      h: "Requires Linear History"
      n: "requiresLinearHistory"
      r: true
      sh: "Are merge commits prohibited from being pushed to this branch."
      t: "`$BOOLEAN`"
    }
    requiresStatusChecks: {
      h: "Requires Status Checks"
      n: "requiresStatusChecks"
      r: true
      sh: "Are status checks required to update matching branches."
      t: "`$BOOLEAN`"
    }
    requiresStrictStatusChecks: {
      h: "Requires Strict Status Checks"
      n: "requiresStrictStatusChecks"
      r: true
      sh: "Are branches required to be up to date before merging."
      t: "`$BOOLEAN`"
    }
    restrictsPushes: {
      h: "Restricts Pushes"
      n: "restrictsPushes"
      r: true
      sh: "Is pushing to matching branches restricted."
      t: "`$BOOLEAN`"
    }
    restrictsReviewDismissals: {
      h: "Restricts Review Dismissals"
      n: "restrictsReviewDismissals"
      r: true
      sh: "Is dismissal of pull request reviews restricted."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "branch_protection_rule"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST createBranchProtectionRule"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation BranchProtectionRuleCreate($input: CreateBranchProtectionRuleInput!) { createBranchProtectionRule(input: $input) { branchProtectionRule { ...BranchProtectionRuleFields } } } fragment BranchProtectionRuleFields on BranchProtectionRule { allowsDeletions allowsForcePushes blocksCreations databaseId dismissesStaleReviews id isAdminEnforced lockAllowsFetchAndMerge lockBranch pattern repository { id } requireLastPushApproval requiredApprovingReviewCount requiredDeploymentEnvironments requiredStatusCheckContexts requiresApprovingReviews requiresCodeOwnerReviews requiresCommitSignatures requiresConversationResolution requiresDeployments requiresLinearHistory requiresStatusChecks requiresStrictStatusChecks restrictsPushes restrictsReviewDismissals }"
            field: "createBranchProtectionRule"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateBranchProtectionRuleInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createBranchProtectionRule"
          t: {
            req: "`reqdata`"
            res: "`body.data.createBranchProtectionRule.branchProtectionRule`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST updateBranchProtectionRule"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation BranchProtectionRuleUpdate($input: UpdateBranchProtectionRuleInput!) { updateBranchProtectionRule(input: $input) { branchProtectionRule { ...BranchProtectionRuleFields } } } fragment BranchProtectionRuleFields on BranchProtectionRule { allowsDeletions allowsForcePushes blocksCreations databaseId dismissesStaleReviews id isAdminEnforced lockAllowsFetchAndMerge lockBranch pattern repository { id } requireLastPushApproval requiredApprovingReviewCount requiredDeploymentEnvironments requiredStatusCheckContexts requiresApprovingReviews requiresCodeOwnerReviews requiresCommitSignatures requiresConversationResolution requiresDeployments requiresLinearHistory requiresStatusChecks requiresStrictStatusChecks restrictsPushes restrictsReviewDismissals }"
            field: "updateBranchProtectionRule"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateBranchProtectionRuleInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "updateBranchProtectionRule"
          t: {
            req: "`reqdata`"
            res: "`body.data.updateBranchProtectionRule.branchProtectionRule`"
          }
        }
      ]
    }
  }



}