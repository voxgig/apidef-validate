      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this issue"
      t: "`$ANY`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "Identifies the state of the issue."
      t: "`$STRING`"
    }
    stateReason: {
      h: "State Reason"
      n: "stateReason"
      r: false
      sh: "Identifies the reason for the issue state."
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "Identifies the issue title."
      t: "`$STRING`"
    }
    titleHTML: {
      h: "Title Html"
      n: "titleHTML"
      r: true
