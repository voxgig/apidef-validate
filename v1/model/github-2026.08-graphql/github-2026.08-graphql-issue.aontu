    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this issue"
      t: "`$STRING`"
    }
    viewerCanAssign: {
      h: "Viewer Can Assign"
      n: "viewerCanAssign"
      r: true
      sh: "Indicates if the viewer can edit assignees for this object."
      t: "`$BOOLEAN`"
    }
    viewerCanClose: {
      h: "Viewer Can Close"
      n: "viewerCanClose"
      r: true
