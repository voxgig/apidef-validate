# Entity: issue

main: kit: entity: issue: {

  alias: field: {}

  fields: {
    activeLockReason: {
      h: "Active Lock Reason"
      n: "activeLockReason"
      r: false
      sh: "Reason that the conversation was locked."
      t: "`$STRING`"
    }
    authorAssociation: {
      h: "Author Association"
      n: "authorAssociation"
      r: true
      sh: "Author's association with the subject of the comment."
      t: "`$STRING`"
    }
    body: {
      h: "Body"
      n: "body"
      r: true
      sh: "Identifies the body of the issue."
      t: "`$STRING`"
    }
    bodyHTML: {
      h: "Body Html"
      n: "bodyHTML"
      r: true
      sh: "The body rendered to HTML."
      t: "`$ANY`"
    }
    bodyResourcePath: {
      h: "Body Resource Path"
      n: "bodyResourcePath"
      r: true
      sh: "The http path for this issue body"
      t: "`$ANY`"
    }
    bodyText: {
      h: "Body Text"
      n: "bodyText"
      r: true
      sh: "Identifies the body of the issue rendered to text."
      t: "`$STRING`"
    }
    bodyUrl: {
      h: "Body Url"
      n: "bodyUrl"
      r: true
      sh: "The http URL for this issue body"
      t: "`$ANY`"
    }
    closed: {
      h: "Closed"
      n: "closed"
      r: true
      sh: "Indicates if the object is closed (definition of closed may depend on type)"
      t: "`$BOOLEAN`"
    }
    closedAt: {
      h: "Closed At"
      n: "closedAt"
      r: false
      sh: "Identifies the date and time when the object was closed."
      t: "`$ANY`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    createdViaEmail: {
      h: "Created Via Email"
      n: "createdViaEmail"
      r: true
      sh: "Check if this comment was created via an email reply."
      t: "`$BOOLEAN`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    duplicateOf: {
      h: "Duplicate Of"
      n: "duplicateOf"
      r: false
      sh: "A reference to the original issue that this issue has been marked as a duplicate of."
      t: "`$OBJECT`"
    }
    fullDatabaseId: {
      h: "Full Database Id"
      n: "fullDatabaseId"
      r: false
      sh: "Identifies the primary key from the database as a BigInt."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Issue object"
      t: "`$STRING`"
    }
    includesCreatedEdit: {
      h: "Includes Created Edit"
      n: "includesCreatedEdit"
      r: true
      sh: "Check if this comment was edited and includes an edit with the creation data"
      t: "`$BOOLEAN`"
    }
    isPinned: {
      h: "Is Pinned"
      n: "isPinned"
      r: false
      sh: "Indicates whether or not this issue is currently pinned to the repository issues list"
      t: "`$BOOLEAN`"
    }
    isReadByViewer: {
      h: "Is Read By Viewer"
      n: "isReadByViewer"
      r: false
      sh: "Is this issue read by the viewer"
      t: "`$BOOLEAN`"
    }
    issueType: {
      h: "Issue Type"
      n: "issueType"
      r: false
      sh: "The issue type for this Issue"
      t: "`$OBJECT`"
    }
    lastEditedAt: {
      h: "Last Edited At"
      n: "lastEditedAt"
      r: false
      sh: "The moment the editor made the last edit"
      t: "`$ANY`"
    }
    locked: {
      h: "Locked"
      n: "locked"
      r: true
      sh: "`true` if the object is locked"
      t: "`$BOOLEAN`"
    }
    milestone: {
      h: "Milestone"
      n: "milestone"
      r: false
      sh: "Identifies the milestone associated with the issue."
      t: "`$OBJECT`"
    }
    number: {
      h: "Number"
      n: "number"
      r: true
      sh: "Identifies the issue number."
      t: "`$INTEGER`"
    }
    parent: {
      h: "Parent"
      n: "parent"
      r: false
      sh: "The parent entity of the issue."
      t: "`$OBJECT`"
    }
    pinnedIssueComment: {
      h: "Pinned Issue Comment"
      n: "pinnedIssueComment"
      r: false
      sh: "The pinned comment for this issue."
      t: "`$OBJECT`"
    }
    publishedAt: {
      h: "Published At"
      n: "publishedAt"
