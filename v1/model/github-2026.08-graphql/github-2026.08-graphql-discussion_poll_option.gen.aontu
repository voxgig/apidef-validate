# Entity: discussion_poll_option

main: kit: entity: discussion_poll_option: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the DiscussionPollOption object"
      t: "`$STRING`"
    }
    option: {
      h: "Option"
      n: "option"
      r: true
      sh: "The text for this option."
      t: "`$STRING`"
    }
    poll: {
      h: "Poll"
      n: "poll"
      r: false
      sh: "The discussion poll that this option belongs to."
      t: "`$OBJECT`"
    }
    totalVoteCount: {
      h: "Total Vote Count"
      n: "totalVoteCount"
      r: true
      sh: "The total number of votes that have been cast for this option."
      t: "`$INTEGER`"
    }
    viewerHasVoted: {
      h: "Viewer Has Voted"
      n: "viewerHasVoted"
      r: true
      sh: "Indicates if the viewer has voted for this option in the poll."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "discussion_poll_option"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST addDiscussionPollVote"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation DiscussionPollOptionCreateAddDiscussionPollVote($input: AddDiscussionPollVoteInput!) { addDiscussionPollVote(input: $input) { pollOption { ...DiscussionPollOptionFields } } } fragment DiscussionPollOptionFields on DiscussionPollOption { id option poll { id } totalVoteCount viewerHasVoted }"
            field: "addDiscussionPollVote"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddDiscussionPollVoteInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "addDiscussionPollVote"
          q: {
            "$action": "add_discussion_poll_vote"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.addDiscussionPollVote.pollOption`"
          }
        }
      ]
    }
  }



}