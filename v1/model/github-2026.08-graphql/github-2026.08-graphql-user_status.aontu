# Entity: user_status

main: kit: entity: user_status: {

  alias: field: {}

  fields: {
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    emoji: {
      h: "Emoji"
      n: "emoji"
      r: false
      sh: "An emoji summarizing the user's status."
      t: "`$STRING`"
    }
    emojiHTML: {
      h: "Emoji Html"
      n: "emojiHTML"
      r: false
      sh: "The status emoji as HTML."
      t: "`$ANY`"
    }
    expiresAt: {
      h: "Expires At"
      n: "expiresAt"
      r: false
      sh: "If set, the status will not be shown after this date."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the UserStatus object"
      t: "`$STRING`"
    }
    indicatesLimitedAvailability: {
      h: "Indicates Limited Availability"
      n: "indicatesLimitedAvailability"
      r: true
      sh: "Whether this status indicates the user is not fully available on GitHub."
      t: "`$BOOLEAN`"
    }
    message: {
      h: "Message"
      n: "message"
      r: false
      sh: "A brief message describing what the user is doing."
      t: "`$STRING`"
    }
    organization: {
      h: "Organization"
      n: "organization"
      r: false
      sh: "The organization whose members can see this status."
      t: "`$OBJECT`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      sh: "The user who has this status."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "user_status"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST changeUserStatus"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation UserStatusCreateChange($input: ChangeUserStatusInput!) { changeUserStatus(input: $input) { status { ...UserStatusFields } } } fragment UserStatusFields on UserStatus { createdAt emoji emojiHTML expiresAt id indicatesLimitedAvailability message organization { id } updatedAt user { id } }"
            field: "changeUserStatus"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ChangeUserStatusInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "changeUserStatus"
          q: {
            "$action": "change"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.changeUserStatus.status`"
          }
        }
      ]
    }
  }



}