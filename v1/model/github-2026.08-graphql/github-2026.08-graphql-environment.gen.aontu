# Entity: environment

main: kit: entity: environment: {

  alias: field: {}

  fields: {
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Environment object"
      t: "`$STRING`"
    }
    isPinned: {
      h: "Is Pinned"
      n: "isPinned"
      r: false
      sh: "Indicates whether or not this environment is currently pinned to the repository"
      t: "`$BOOLEAN`"
    }
    latestCompletedDeployment: {
      h: "Latest Completed Deployment"
      n: "latestCompletedDeployment"
      r: false
      sh: "The latest completed deployment with status success, failure, or error if it exists"
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the environment"
      t: "`$STRING`"
    }
    pinnedPosition: {
      h: "Pinned Position"
      n: "pinnedPosition"
      r: false
      sh: "The position of the environment if it is pinned, null if it is not pinned"
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "environment"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST createEnvironment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation EnvironmentCreate($input: CreateEnvironmentInput!) { createEnvironment(input: $input) { environment { ...EnvironmentFields } } } fragment EnvironmentFields on Environment { databaseId id isPinned latestCompletedDeployment { id } name pinnedPosition }"
            field: "createEnvironment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateEnvironmentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createEnvironment"
          t: {
            req: "`reqdata`"
            res: "`body.data.createEnvironment.environment`"
          }
        }
        {
          co: {
            id: "POST pinEnvironment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation EnvironmentCreatePin($input: PinEnvironmentInput!) { pinEnvironment(input: $input) { environment { ...EnvironmentFields } } } fragment EnvironmentFields on Environment { databaseId id isPinned latestCompletedDeployment { id } name pinnedPosition }"
            field: "pinEnvironment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "PinEnvironmentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "pinEnvironment"
          q: {
            "$action": "pin"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.pinEnvironment.environment`"
          }
        }
        {
          co: {
            id: "POST reorderEnvironment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation EnvironmentCreateReorder($input: ReorderEnvironmentInput!) { reorderEnvironment(input: $input) { environment { ...EnvironmentFields } } } fragment EnvironmentFields on Environment { databaseId id isPinned latestCompletedDeployment { id } name pinnedPosition }"
            field: "reorderEnvironment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ReorderEnvironmentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "reorderEnvironment"
          q: {
            "$action": "reorder"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.reorderEnvironment.environment`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST updateEnvironment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation EnvironmentUpdate($input: UpdateEnvironmentInput!) { updateEnvironment(input: $input) { environment { ...EnvironmentFields } } } fragment EnvironmentFields on Environment { databaseId id isPinned latestCompletedDeployment { id } name pinnedPosition }"
            field: "updateEnvironment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateEnvironmentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "updateEnvironment"
          t: {
            req: "`reqdata`"
            res: "`body.data.updateEnvironment.environment`"
          }
        }
      ]
    }
  }



}