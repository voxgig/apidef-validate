# Entity: query

main: kit: entity: query: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "ID of the object."
      t: "`$STRING`"
    }
    relay: {
      h: "Relay"
      n: "relay"
      r: false
      sh: "Workaround for re-exposing the root query object."
      t: "`$OBJECT`"
    }
    viewer: {
      h: "Viewer"
      n: "viewer"
      r: false
      sh: "The currently authenticated user."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "query"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST relay"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "query QueryLoad { relay { ...QueryFields } } fragment QueryFields on Query { id relay { id } viewer { id } }"
            field: "relay"
            optype: "query"
          }
          k: "graphql"
          m: "POST"
          o: "relay"
          t: {
            req: "`reqdata`"
            res: "`body.data.relay`"
          }
        }
      ]
    }
  }



}