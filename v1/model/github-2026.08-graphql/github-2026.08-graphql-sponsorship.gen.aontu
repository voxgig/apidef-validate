          contract: {
            id: "POST updateSponsorshipPreferences"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"UpdateSponsorshipPreferencesInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"UpdateSponsorshipPreferencesInput\"}],\"deprecated\":false,\"desc\":\"Change visibility of your sponsorship and opt in or out of email updates from the maintainer.\",\"gqltype\":\"UpdateSponsorshipPreferencesPayload\",\"list\":false,\"name\":\"updateSponsorshipPreferences\",\"reqd\":false,\"type\":\"UpdateSponsorshipPreferencesPayload\"},\"invocation\":{\"doc\":\"mutation SponsorshipCreateUpdateSponsorshipPreference($input: UpdateSponsorshipPreferencesInput!) { updateSponsorshipPreferences(input: $input) { sponsorship { ...SponsorshipFields } } } fragment SponsorshipFields on Sponsorship { createdAt id isActive isOneTimePayment isSponsorOptedIntoEmail paymentSource privacyLevel tier { id } tierSelectedAt }\",\"field\":\"updateSponsorshipPreferences\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"UpdateSponsorshipPreferencesInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"ID\":{\"desc\":\"The `ID` scalar type represents a unique identifier, often used to refetch an object or as key for a cache. The ID type appears in a JSON response as a String; however, it is not intended to be human-readable. When expected as an input type, any string (such as `\\\"4\\\"`) or integer (such as `4`) input value will be accepted as an ID.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"ID\"},\"SponsorshipPrivacy\":{\"desc\":\"The privacy of a sponsorship\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"SponsorshipPrivacy\",\"values\":[\"PRIVATE\",\"PUBLIC\"]},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\