# Entity: sponsorship

main: kit: entity: sponsorship: {

  alias: field: {}

  fields: [
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the Sponsorship object"
      type: "`$STRING`"
    }
    {
      name: "isActive"
      req: true
      short: "Whether the sponsorship is active."
      type: "`$BOOLEAN`"
    }
    {
      name: "isOneTimePayment"
      req: true
      short: "Whether this sponsorship represents a one-time payment versus a recurring sponsorship."
      type: "`$BOOLEAN`"
    }
    {
      name: "isSponsorOptedIntoEmail"
      req: false
      short: "Whether the sponsor has chosen to receive sponsorship update emails sent from the sponsorable."
      type: "`$BOOLEAN`"
    }
    {
      name: "paymentSource"
      req: false
      short: "The platform that was most recently used to pay for the sponsorship."
      type: "`$STRING`"
    }
    {
      name: "privacyLevel"
      req: true
      short: "The privacy level for this sponsorship."
      type: "`$STRING`"
    }
    {
      name: "tier"
      req: false
      short: "The associated sponsorship tier"
      type: "`$OBJECT`"
    }
    {
      name: "tierSelectedAt"
      req: false
      short: "Identifies the date and time when the current tier was chosen for this sponsorship."
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "sponsorship"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST createSponsorship"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"CreateSponsorshipInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"CreateSponsorshipInput\"}],\"deprecated\":false,\"desc\":\"Start a new sponsorship of a maintainer in GitHub Sponsors, or reactivate a past sponsorship.\",\"gqltype\":\"CreateSponsorshipPayload\",\"list\":false,\"name\":\"createSponsorship\",\"reqd\":false,\"type\":\"CreateSponsorshipPayload\"},\"invocation\":{\"doc\":\"mutation SponsorshipCreate($input: CreateSponsorshipInput!) { createSponsorship(input: $input) { sponsorship { ...SponsorshipFields } } } fragment SponsorshipFields on Sponsorship { createdAt id isActive isOneTimePayment isSponsorOptedIntoEmail paymentSource privacyLevel tier { id } tierSelectedAt }\",\"field\":\"createSponsorship\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"CreateSponsorshipInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"CreateSponsorshipInput\":{\"desc\":\"Autogenerated input type of CreateSponsorship\",\"fields\":{\"amount\":{\"args\":[],\"deprecated\":false,\"desc\":\"The amount to pay to the sponsorable in US dollars. Required if a tierId is not specified. Valid values: 1-12000.\",\"gqltype\":\"Int\",\"list\":false,\"name\":\"amount\",\"reqd\":false,\"type\":\"Int\"},\"clientMutationId\":{\"args\":[],\"deprecated\":false,\"desc\":\"A unique identifier for the client performing the mutation.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"clientMutationId\",\"reqd\":false,\"type\":\"String\"},\"isRecurring\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether the sponsorship should happen monthly/yearly or just this one time. Required if a tierId is not specified.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"isRecurring\",\"reqd\":false,\"type\":\"Boolean\"},\"privacyLevel\":{\"args\":[],\"deprecated\":false,\"desc\":\"Specify whether others should be able to see that the sponsor is sponsoring\\nthe sponsorable. Public visibility still does not reveal which tier is used.\",\"gqltype\":\"SponsorshipPrivacy\",\"list\":false,\"name\":\"privacyLevel\",\"reqd\":false,\"type\":\"SponsorshipPrivacy\"},\"receiveEmails\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether the sponsor should receive email updates from the sponsorable.\",\"gqltype\":\"Boolean\",\"list\":false,\"name\":\"receiveEmails\",\"reqd\":false,\"type\":\"Boolean\"},\"sponsorId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the user or organization who is acting as the sponsor, paying for\\nthe sponsorship. Required if sponsorLogin is not given.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"sponsorId\",\"reqd\":false,\"type\":\"ID\"},\"sponsorLogin\":{\"args\":[],\"deprecated\":false,\"desc\":\"The username of the user or organization who is acting as the sponsor, paying\\nfor the sponsorship. Required if sponsorId is not given.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"sponsorLogin\",\"reqd\":false,\"type\":\"String\"},\"sponsorableId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of the user or organization who is receiving the sponsorship. Required if sponsorableLogin is not given.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"sponsorableId\",\"reqd\":false,\"type\":\"ID\"},\"sponsorableLogin\":{\"args\":[],\"deprecated\":false,\"desc\":\"The username of the user or organization who is receiving the sponsorship. Required if sponsorableId is not given.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"sponsorableLogin\",\"reqd\":false,\"type\":\"String\"},\"tierId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The ID of one of sponsorable's existing tiers to sponsor at. Required if amount is not specified.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"tierId\",\"reqd\":false,\"type\":\"ID\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CreateSponsorshipInput\"},\"ID\":{\"desc\":\"The `ID` scalar type represents a unique identifier, often used to refetch an object or as key for a cache. The ID type appears in a JSON response as a String; however, it is not intended to be human-readable. When expected as an input type, any string (such as `\\\"4\\\"`) or integer (such as `4`) input value will be accepted as an ID.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"ID\"},\"Int\":{\"desc\":\"The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Int\"},\"SponsorshipPrivacy\":{\"desc\":\"The privacy of a sponsorship\",\"fields\":{},\"kind\":\"ENUM\",\"name\":\"SponsorshipPrivacy\",\"values\":[\"PRIVATE\",\"PUBLIC\"]},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
            doc: "mutation SponsorshipCreate($input: CreateSponsorshipInput!) { createSponsorship(input: $input) { sponsorship { ...SponsorshipFields } } } fragment SponsorshipFields on Sponsorship { createdAt id isActive isOneTimePayment isSponsorOptedIntoEmail paymentSource privacyLevel tier { id } tierSelectedAt }"
            field: "createSponsorship"
