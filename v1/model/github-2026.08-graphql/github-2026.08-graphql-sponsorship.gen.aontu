ven.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"sponsorableLogin\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"UpdateSponsorshipPreferencesInput\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
