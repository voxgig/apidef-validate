      short: "The name of the tier."
      type: "`$STRING`"
    }
    {
      name: "sponsorsListing"
      req: false
      short: "The sponsors listing that this tier belongs to."
      type: "`$OBJECT`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
  ]

