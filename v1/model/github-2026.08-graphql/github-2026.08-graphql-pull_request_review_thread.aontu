# Entity: pull_request_review_thread

main: kit: entity: pull_request_review_thread: {

  alias: field: {}

  fields: {
    diffSide: {
      h: "Diff Side"
      n: "diffSide"
      r: true
      sh: "The side of the diff on which this thread was placed."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the PullRequestReviewThread object"
      t: "`$STRING`"
    }
    isCollapsed: {
      h: "Is Collapsed"
      n: "isCollapsed"
      r: true
      sh: "Whether or not the thread has been collapsed (resolved)"
      t: "`$BOOLEAN`"
    }
    isOutdated: {
      h: "Is Outdated"
      n: "isOutdated"
      r: true
      sh: "Indicates whether this thread was outdated by newer changes."
      t: "`$BOOLEAN`"
    }
    isResolved: {
      h: "Is Resolved"
      n: "isResolved"
      r: true
      sh: "Whether this thread has been resolved"
      t: "`$BOOLEAN`"
    }
    line: {
      h: "Line"
      n: "line"
      r: false
      sh: "The line in the file to which this thread refers"
      t: "`$INTEGER`"
    }
    originalLine: {
      h: "Original Line"
      n: "originalLine"
      r: false
      sh: "The original line in the file to which this thread refers."
      t: "`$INTEGER`"
    }
    originalStartLine: {
      h: "Original Start Line"
      n: "originalStartLine"
      r: false
      sh: "The original start line in the file to which this thread refers (multi-line only)."
      t: "`$INTEGER`"
    }
    path: {
      h: "Path"
      n: "path"
      r: true
      sh: "Identifies the file path of this thread."
      t: "`$STRING`"
    }
    pullRequest: {
      h: "Pull Request"
      n: "pullRequest"
      r: false
      sh: "Identifies the pull request associated with this thread."
      t: "`$OBJECT`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "Identifies the repository associated with this thread."
      t: "`$OBJECT`"
    }
    resolvedBy: {
      h: "Resolved By"
      n: "resolvedBy"
      r: false
      sh: "The user who resolved this thread"
      t: "`$OBJECT`"
    }
    startDiffSide: {
      h: "Start Diff Side"
      n: "startDiffSide"
      r: false
      sh: "The side of the diff that the first line of the thread starts on (multi-line only)"
      t: "`$STRING`"
    }
    startLine: {
      h: "Start Line"
      n: "startLine"
      r: false
      sh: "The start line in the file to which this thread refers (multi-line only)"
      t: "`$INTEGER`"
    }
    subjectType: {
      h: "Subject Type"
      n: "subjectType"
      r: true
      sh: "The level at which the comments in the corresponding thread are targeted, can be a diff line or a file"
      t: "`$STRING`"
    }
    viewerCanReply: {
      h: "Viewer Can Reply"
      n: "viewerCanReply"
      r: true
      sh: "Indicates whether the current viewer can reply to this thread."
      t: "`$BOOLEAN`"
    }
    viewerCanResolve: {
      h: "Viewer Can Resolve"
      n: "viewerCanResolve"
      r: true
      sh: "Whether or not the viewer can resolve this thread"
      t: "`$BOOLEAN`"
    }
    viewerCanUnresolve: {
      h: "Viewer Can Unresolve"
      n: "viewerCanUnresolve"
      r: true
      sh: "Whether or not the viewer can unresolve this thread"
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "pull_request_review_thread"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST addPullRequestReviewThread"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation PullRequestReviewThreadCreate($input: AddPullRequestReviewThreadInput!) { addPullRequestReviewThread(input: $input) { thread { ...PullRequestReviewThreadFields } } } fragment PullRequestReviewThreadFields on PullRequestReviewThread { diffSide id isCollapsed isOutdated isResolved line originalLine originalStartLine path pullRequest { id } repository { id } resolvedBy { id } startDiffSide startLine subjectType viewerCanReply viewerCanResolve viewerCanUnresolve }"
            field: "addPullRequestReviewThread"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddPullRequestReviewThreadInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "addPullRequestReviewThread"
          t: {
            req: "`reqdata`"
            res: "`body.data.addPullRequestReviewThread.thread`"
          }
        }
        {
          co: {
            id: "POST resolveReviewThread"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation PullRequestReviewThreadCreateResolveReviewThread($input: ResolveReviewThreadInput!) { resolveReviewThread(input: $input) { thread { ...PullRequestReviewThreadFields } } } fragment PullRequestReviewThreadFields on PullRequestReviewThread { diffSide id isCollapsed isOutdated isResolved line originalLine originalStartLine path pullRequest { id } repository { id } resolvedBy { id } startDiffSide startLine subjectType viewerCanReply viewerCanResolve viewerCanUnresolve }"
            field: "resolveReviewThread"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ResolveReviewThreadInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "resolveReviewThread"
          q: {
            "$action": "resolve_review_thread"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.resolveReviewThread.thread`"
          }
        }
        {
          co: {
            id: "POST unresolveReviewThread"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation PullRequestReviewThreadCreateUnresolveReviewThread($input: UnresolveReviewThreadInput!) { unresolveReviewThread(input: $input) { thread { ...PullRequestReviewThreadFields } } } fragment PullRequestReviewThreadFields on PullRequestReviewThread { diffSide id isCollapsed isOutdated isResolved line originalLine originalStartLine path pullRequest { id } repository { id } resolvedBy { id } startDiffSide startLine subjectType viewerCanReply viewerCanResolve viewerCanUnresolve }"
            field: "unresolveReviewThread"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UnresolveReviewThreadInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "unresolveReviewThread"
          q: {
            "$action": "unresolve_review_thread"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.unresolveReviewThread.thread`"
          }
        }
      ]
    }
  }



}