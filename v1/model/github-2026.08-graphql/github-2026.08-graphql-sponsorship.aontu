# Entity: sponsorship

main: kit: entity: sponsorship: {

  alias: field: {}

  fields: {
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Sponsorship object"
      t: "`$STRING`"
    }
    isActive: {
      h: "Is Active"
      n: "isActive"
      r: true
      sh: "Whether the sponsorship is active."
      t: "`$BOOLEAN`"
    }
    isOneTimePayment: {
      h: "Is One Time Payment"
      n: "isOneTimePayment"
      r: true
      sh: "Whether this sponsorship represents a one-time payment versus a recurring sponsorship."
      t: "`$BOOLEAN`"
    }
    isSponsorOptedIntoEmail: {
      h: "Is Sponsor Opted Into Email"
      n: "isSponsorOptedIntoEmail"
      r: false
      sh: "Whether the sponsor has chosen to receive sponsorship update emails sent from the sponsorable."
      t: "`$BOOLEAN`"
    }
    paymentSource: {
      h: "Payment Source"
      n: "paymentSource"
      r: false
      sh: "The platform that was most recently used to pay for the sponsorship."
      t: "`$STRING`"
    }
    privacyLevel: {
      h: "Privacy Level"
      n: "privacyLevel"
      r: true
      sh: "The privacy level for this sponsorship."
      t: "`$STRING`"
    }
    tier: {
      h: "Tier"
      n: "tier"
      r: false
      sh: "The associated sponsorship tier"
      t: "`$OBJECT`"
    }
    tierSelectedAt: {
      h: "Tier Selected At"
      n: "tierSelectedAt"
      r: false
      sh: "Identifies the date and time when the current tier was chosen for this sponsorship."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "sponsorship"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST createSponsorship"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation SponsorshipCreate($input: CreateSponsorshipInput!) { createSponsorship(input: $input) { sponsorship { ...SponsorshipFields } } } fragment SponsorshipFields on Sponsorship { createdAt id isActive isOneTimePayment isSponsorOptedIntoEmail paymentSource privacyLevel tier { id } tierSelectedAt }"
            field: "createSponsorship"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateSponsorshipInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createSponsorship"
          t: {
            req: "`reqdata`"
            res: "`body.data.createSponsorship.sponsorship`"
          }
        }
        {
          co: {
            id: "POST updateSponsorshipPreferences"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation SponsorshipCreateUpdateSponsorshipPreference($input: UpdateSponsorshipPreferencesInput!) { updateSponsorshipPreferences(input: $input) { sponsorship { ...SponsorshipFields } } } fragment SponsorshipFields on Sponsorship { createdAt id isActive isOneTimePayment isSponsorOptedIntoEmail paymentSource privacyLevel tier { id } tierSelectedAt }"
            field: "updateSponsorshipPreferences"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateSponsorshipPreferencesInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "updateSponsorshipPreferences"
          q: {
            "$action": "update_sponsorship_preference"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.updateSponsorshipPreferences.sponsorship`"
          }
        }
      ]
    }
  }



}