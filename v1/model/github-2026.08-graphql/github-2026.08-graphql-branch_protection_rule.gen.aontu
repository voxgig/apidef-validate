# Entity: branch_protection_rule

main: kit: entity: branch_protection_rule: {

  alias: field: {}

  fields: [
    {
      name: "allowsDeletions"
      req: true
      short: "Can this branch be deleted."
      type: "`$BOOLEAN`"
    }
    {
      name: "allowsForcePushes"
      req: true
      short: "Are force pushes allowed on this branch."
      type: "`$BOOLEAN`"
    }
    {
      name: "blocksCreations"
      req: true
      short: "Is branch creation a protected operation."
      type: "`$BOOLEAN`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$INTEGER`"
    }
    {
      name: "dismissesStaleReviews"
      req: true
      short: "Will new commits pushed to matching branches dismiss pull request review approvals."
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the BranchProtectionRule object"
      type: "`$STRING`"
    }
    {
      name: "isAdminEnforced"
      req: true
      short: "Can admins override branch protection."
      type: "`$BOOLEAN`"
    }
    {
      name: "lockAllowsFetchAndMerge"
      req: true
      short: "Whether users can pull changes from upstream when the branch is locked."
      type: "`$BOOLEAN`"
    }
    {
      name: "lockBranch"
      req: true
      short: "Whether to set the branch as read-only."
      type: "`$BOOLEAN`"
    }
    {
      name: "pattern"
      req: true
      short: "Identifies the protection rule pattern."
      type: "`$STRING`"
    }
    {
      name: "repository"
      req: false
      short: "The repository associated with this branch protection rule."
      type: "`$OBJECT`"
    }
    {
      name: "requireLastPushApproval"
      req: true
      short: "Whether the most recent push must be approved by someone other than the person who pushed it"
      type: "`$BOOLEAN`"
    }
    {
      name: "requiredApprovingReviewCount"
      req: false
      short: "Number of approving reviews required to update matching branches."
      type: "`$INTEGER`"
    }
    {
      name: "requiredDeploymentEnvironments"
      req: false
      short: "List of required deployment environments that must be deployed successfully to update matching branches"
      type: "`$STRING`"
    }
    {
      name: "requiredStatusCheckContexts"
      req: false
      short: "List of required status check contexts that must pass for commits to be accepted to matching branches."
      type: "`$STRING`"
    }
    {
      name: "requiresApprovingReviews"
      req: true
      short: "Are approving reviews required to update matching branches."
      type: "`$BOOLEAN`"
    }
    {
      name: "requiresCodeOwnerReviews"
      req: true
      short: "Are reviews from code owners required to update matching branches."
      type: "`$BOOLEAN`"
    }
    {
      name: "requiresCommitSignatures"
      req: true
      short: "Are commits required to be signed."
      type: "`$BOOLEAN`"
    }
    {
      name: "requiresConversationResolution"
      req: true
      short: "Are conversations required to be resolved before merging."
      type: "`$BOOLEAN`"
    }
    {
      name: "requiresDeployments"
      req: true
      short: "Does this branch require deployment to specific environments before merging"
      type: "`$BOOLEAN`"
    }
    {
      name: "requiresLinearHistory"
      req: true
      short: "Are merge commits prohibited from being pushed to this branch."
      type: "`$BOOLEAN`"
    }
    {
      name: "requiresStatusChecks"
      req: true
      short: "Are status checks required to update matching branches."
      type: "`$BOOLEAN`"
    }
    {
      name: "requiresStrictStatusChecks"
      req: true
      short: "Are branches required to be up to date before merging."
      type: "`$BOOLEAN`"
    }
    {
      name: "restrictsPushes"
      req: true
      short: "Is pushing to matching branches restricted."
      type: "`$BOOLEAN`"
    }
    {
      name: "restrictsReviewDismissals"
      req: true
      short: "Is dismissal of pull request reviews restricted."
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "branch_protection_rule"
