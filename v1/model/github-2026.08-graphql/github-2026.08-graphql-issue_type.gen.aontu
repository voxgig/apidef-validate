          }
          gq: {
            doc: "mutation IssueTypeCreate($input: CreateIssueTypeInput!) { createIssueType(input: $input) { issueType { ...IssueTypeFields } } } fragment IssueTypeFields on IssueType { color description id isEnabled name }"
            field: "createIssueType"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateIssueTypeInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createIssueType"
          t: {
            req: "`reqdata`"
            res: "`body.data.createIssueType.issueType`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST updateIssueType"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation IssueTypeUpdate($input: UpdateIssueTypeInput!) { updateIssueType(input: $input) { issueType { ...IssueTypeFields } } } fragment IssueTypeFields on IssueType { color description id isEnabled name }"
            field: "updateIssueType"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateIssueTypeInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
