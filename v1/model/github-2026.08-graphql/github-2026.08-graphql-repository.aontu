# Entity: repository

main: kit: entity: repository: {

  alias: field: {}

  fields: {
    allowUpdateBranch: {
      h: "Allow Update Branch"
      n: "allowUpdateBranch"
      r: true
      sh: "Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging."
      t: "`$BOOLEAN`"
    }
    archivedAt: {
      h: "Archived At"
      n: "archivedAt"
      r: false
      sh: "Identifies the date and time when the repository was archived."
      t: "`$ANY`"
    }
    autoMergeAllowed: {
      h: "Auto Merge Allowed"
      n: "autoMergeAllowed"
      r: true
      sh: "Whether or not Auto-merge can be enabled on pull requests in this repository."
      t: "`$BOOLEAN`"
    }
    codeOfConduct: {
      h: "Code Of Conduct"
      n: "codeOfConduct"
      r: false
      sh: "Returns the code of conduct for this repository"
      t: "`$OBJECT`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    defaultBranchRef: {
      h: "Default Branch Ref"
      n: "defaultBranchRef"
      r: false
      sh: "The Ref associated with the repository's default branch."
      t: "`$OBJECT`"
    }
    deleteBranchOnMerge: {
      h: "Delete Branch On Merge"
      n: "deleteBranchOnMerge"
      r: true
      sh: "Whether or not branches are automatically deleted when merged in this repository."
      t: "`$BOOLEAN`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "The description of the repository."
      t: "`$STRING`"
    }
    descriptionHTML: {
      h: "Description Html"
      n: "descriptionHTML"
      r: true
      sh: "The description of the repository rendered to HTML."
      t: "`$ANY`"
    }
    diskUsage: {
      h: "Disk Usage"
      n: "diskUsage"
      r: false
      sh: "The number of kilobytes this repository occupies on disk."
      t: "`$INTEGER`"
    }
    forkCount: {
      h: "Fork Count"
      n: "forkCount"
      r: true
      sh: "Returns how many forks there are of this repository in the whole network."
      t: "`$INTEGER`"
    }
    forkingAllowed: {
      h: "Forking Allowed"
      n: "forkingAllowed"
      r: true
      sh: "Whether this repository allows forks."
      t: "`$BOOLEAN`"
    }
    hasDiscussionsEnabled: {
      h: "Has Discussions Enabled"
      n: "hasDiscussionsEnabled"
      r: true
      sh: "Indicates if the repository has the Discussions feature enabled."
      t: "`$BOOLEAN`"
    }
    hasIssuesEnabled: {
      h: "Has Issues Enabled"
      n: "hasIssuesEnabled"
      r: true
      sh: "Indicates if the repository has issues feature enabled."
      t: "`$BOOLEAN`"
    }
    hasProjectsEnabled: {
      h: "Has Projects Enabled"
      n: "hasProjectsEnabled"
      r: true
      sh: "Indicates if the repository has the Projects feature enabled."
      t: "`$BOOLEAN`"
    }
    hasPullRequestsEnabled: {
      h: "Has Pull Requests Enabled"
      n: "hasPullRequestsEnabled"
      r: true
      sh: "Indicates if the repository has the pull requests feature enabled."
      t: "`$BOOLEAN`"
    }
    hasSponsorshipsEnabled: {
      h: "Has Sponsorships Enabled"
      n: "hasSponsorshipsEnabled"
      r: true
      sh: "Indicates if the repository displays a Sponsor button for financial contributions."
      t: "`$BOOLEAN`"
    }
    hasVulnerabilityAlertsEnabled: {
      h: "Has Vulnerability Alerts Enabled"
      n: "hasVulnerabilityAlertsEnabled"
      r: true
      sh: "Whether vulnerability alerts are enabled for the repository."
      t: "`$BOOLEAN`"
    }
    hasWikiEnabled: {
      h: "Has Wiki Enabled"
      n: "hasWikiEnabled"
      r: true
      sh: "Indicates if the repository has wiki feature enabled."
      t: "`$BOOLEAN`"
    }
    homepageUrl: {
      h: "Homepage Url"
      n: "homepageUrl"
      r: false
      sh: "The repository's URL."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Repository object"
      t: "`$STRING`"
    }
    isArchived: {
      h: "Is Archived"
      n: "isArchived"
      r: true
      sh: "Indicates if the repository is unmaintained."
      t: "`$BOOLEAN`"
    }
    isBlankIssuesEnabled: {
      h: "Is Blank Issues Enabled"
      n: "isBlankIssuesEnabled"
      r: true
      sh: "Returns true if the viewer can create a blank issue in this repository"
      t: "`$BOOLEAN`"
    }
    isDisabled: {
      h: "Is Disabled"
      n: "isDisabled"
      r: true
      sh: "Returns whether or not this repository disabled."
      t: "`$BOOLEAN`"
    }
    isEmpty: {
      h: "Is Empty"
      n: "isEmpty"
      r: true
      sh: "Returns whether or not this repository is empty."
      t: "`$BOOLEAN`"
    }
    isFork: {
      h: "Is Fork"
      n: "isFork"
      r: true
      sh: "Identifies if the repository is a fork."
      t: "`$BOOLEAN`"
    }
    isInOrganization: {
      h: "Is In Organization"
      n: "isInOrganization"
      r: true
      sh: "Indicates if a repository is either owned by an organization, or is a private fork of an organization repository."
      t: "`$BOOLEAN`"
    }
    isLocked: {
      h: "Is Locked"
      n: "isLocked"
      r: true
      sh: "Indicates if the repository has been locked or not."
      t: "`$BOOLEAN`"
    }
    isMirror: {
      h: "Is Mirror"
      n: "isMirror"
      r: true
      sh: "Identifies if the repository is a mirror."
      t: "`$BOOLEAN`"
    }
    isPrivate: {
      h: "Is Private"
      n: "isPrivate"
      r: true
      sh: "Identifies if the repository is private or internal."
      t: "`$BOOLEAN`"
    }
    isSecurityPolicyEnabled: {
      h: "Is Security Policy Enabled"
      n: "isSecurityPolicyEnabled"
      r: false
      sh: "Returns true if this repository has a security policy"
      t: "`$BOOLEAN`"
    }
    isTemplate: {
      h: "Is Template"
      n: "isTemplate"
      r: true
      sh: "Identifies if the repository is a template that can be used to generate new repositories."
      t: "`$BOOLEAN`"
    }
    isUserConfigurationRepository: {
      h: "Is User Configuration Repository"
      n: "isUserConfigurationRepository"
      r: true
      sh: "Is this repository a user configuration repository?"
      t: "`$BOOLEAN`"
    }
    issueCreationPolicy: {
      h: "Issue Creation Policy"
      n: "issueCreationPolicy"
      r: false
      sh: "The policy controlling who can create issues in this repository."
      t: "`$STRING`"
    }
    latestRelease: {
      h: "Latest Release"
      n: "latestRelease"
      r: false
      sh: "Get the latest release for the repository if one exists."
      t: "`$OBJECT`"
    }
    licenseInfo: {
      h: "License Info"
      n: "licenseInfo"
      r: false
      sh: "The license associated with the repository"
      t: "`$OBJECT`"
    }
    lockReason: {
      h: "Lock Reason"
      n: "lockReason"
      r: false
      sh: "The reason the repository has been locked."
      t: "`$STRING`"
    }
    mergeCommitAllowed: {
      h: "Merge Commit Allowed"
      n: "mergeCommitAllowed"
      r: true
      sh: "Whether or not PRs are merged with a merge commit on this repository."
      t: "`$BOOLEAN`"
    }
    mergeCommitMessage: {
      h: "Merge Commit Message"
      n: "mergeCommitMessage"
      r: true
      sh: "How the default commit message will be generated when merging a pull request."
      t: "`$STRING`"
    }
    mergeCommitTitle: {
      h: "Merge Commit Title"
      n: "mergeCommitTitle"
      r: true
      sh: "How the default commit title will be generated when merging a pull request."
      t: "`$STRING`"
    }
    mergeQueue: {
      h: "Merge Queue"
      n: "mergeQueue"
      r: false
      sh: "The merge queue for a specified branch, otherwise the default branch if not provided."
      t: "`$OBJECT`"
    }
    mirrorUrl: {
      h: "Mirror Url"
      n: "mirrorUrl"
      r: false
      sh: "The repository's original mirror URL."
      t: "`$ANY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the repository."
      t: "`$STRING`"
    }
    nameWithOwner: {
      h: "Name With Owner"
      n: "nameWithOwner"
      r: true
      sh: "The repository's name with owner."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: false
      sh: "A Git object in the repository"
      t: "`$OBJECT`"
    }
    openGraphImageUrl: {
      h: "Open Graph Image Url"
      n: "openGraphImageUrl"
      r: true
      sh: "The image used to represent this repository in Open Graph data."
      t: "`$ANY`"
    }
    owner: {
      h: "Owner"
      n: "owner"
      r: false
      sh: "The User owner of the repository."
      t: "`$OBJECT`"
    }
    parent: {
      h: "Parent"
      n: "parent"
      r: false
      sh: "The repository parent, if this is a fork."
      t: "`$OBJECT`"
    }
    primaryLanguage: {
      h: "Primary Language"
      n: "primaryLanguage"
      r: false
      sh: "The primary language of the repository's code."
      t: "`$OBJECT`"
    }
    projectsResourcePath: {
      h: "Projects Resource Path"
      n: "projectsResourcePath"
      r: true
      sh: "The HTTP path listing the repository's projects"
      t: "`$ANY`"
    }
    projectsUrl: {
      h: "Projects Url"
      n: "projectsUrl"
      r: true
      sh: "The HTTP URL listing the repository's projects"
      t: "`$ANY`"
    }
    pullRequestCreationPolicy: {
      h: "Pull Request Creation Policy"
      n: "pullRequestCreationPolicy"
      r: false
      sh: "The policy controlling who can create pull requests in this repository."
      t: "`$STRING`"
    }
    pushedAt: {
      h: "Pushed At"
      n: "pushedAt"
      r: false
      sh: "Identifies the date and time when the repository was last pushed to."
      t: "`$ANY`"
    }
    rebaseMergeAllowed: {
      h: "Rebase Merge Allowed"
      n: "rebaseMergeAllowed"
      r: true
      sh: "Whether or not rebase-merging is enabled on this repository."
      t: "`$BOOLEAN`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this repository"
      t: "`$ANY`"
    }
    securityPolicyUrl: {
      h: "Security Policy Url"
      n: "securityPolicyUrl"
      r: false
      sh: "The security policy URL."
      t: "`$ANY`"
    }
    shortDescriptionHTML: {
      h: "Short Description Html"
      n: "shortDescriptionHTML"
      r: true
      sh: "A description of the repository, rendered to HTML without any links in it."
      t: "`$ANY`"
    }
    squashMergeAllowed: {
      h: "Squash Merge Allowed"
      n: "squashMergeAllowed"
      r: true
      sh: "Whether or not squash-merging is enabled on this repository."
      t: "`$BOOLEAN`"
    }
    squashMergeCommitMessage: {
      h: "Squash Merge Commit Message"
      n: "squashMergeCommitMessage"
      r: true
      sh: "How the default commit message will be generated when squash merging a pull request."
      t: "`$STRING`"
    }
    squashMergeCommitTitle: {
      h: "Squash Merge Commit Title"
      n: "squashMergeCommitTitle"
      r: true
      sh: "How the default commit title will be generated when squash merging a pull request."
      t: "`$STRING`"
    }
    sshUrl: {
      h: "Ssh Url"
      n: "sshUrl"
      r: true
      sh: "The SSH URL to clone this repository"
      t: "`$ANY`"
    }
    stargazerCount: {
      h: "Stargazer Count"
      n: "stargazerCount"
      r: true
      sh: "Returns a count of how many stargazers there are on this object"
      t: "`$INTEGER`"
    }
    tempCloneToken: {
      h: "Temp Clone Token"
      n: "tempCloneToken"
      r: false
      sh: "Temporary authentication token for cloning this repository."
      t: "`$STRING`"
    }
    templateRepository: {
      h: "Template Repository"
      n: "templateRepository"
      r: false
      sh: "The repository from which this repository was generated, if any."
      t: "`$OBJECT`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this repository"
      t: "`$STRING`"
    }
    usesCustomOpenGraphImage: {
      h: "Uses Custom Open Graph Image"
      n: "usesCustomOpenGraphImage"
      r: true
      sh: "Whether this repository has a custom image to use with Open Graph as opposed to being represented by the owner's avatar."
      t: "`$BOOLEAN`"
    }
    viewerCanAdminister: {
      h: "Viewer Can Administer"
      n: "viewerCanAdminister"
      r: true
      sh: "Indicates whether the viewer has admin permissions on this repository."
      t: "`$BOOLEAN`"
    }
    viewerCanCreateIssues: {
      h: "Viewer Can Create Issues"
      n: "viewerCanCreateIssues"
      r: true
      sh: "Indicates whether the current user can create issues in this repository."
      t: "`$BOOLEAN`"
    }
    viewerCanSeeIssueFields: {
      h: "Viewer Can See Issue Fields"
      n: "viewerCanSeeIssueFields"
      r: true
      sh: "Indicates whether the current user can see issue fields in this repository"
      t: "`$BOOLEAN`"
    }
    viewerCanSubscribe: {
      h: "Viewer Can Subscribe"
      n: "viewerCanSubscribe"
      r: true
      sh: "Check if the viewer is able to change their subscription status for the repository."
      t: "`$BOOLEAN`"
    }
    viewerCanUpdateTopics: {
      h: "Viewer Can Update Topics"
      n: "viewerCanUpdateTopics"
      r: true
      sh: "Indicates whether the viewer can update the topics of this repository."
      t: "`$BOOLEAN`"
    }
    viewerDefaultCommitEmail: {
      h: "Viewer Default Commit Email"
      n: "viewerDefaultCommitEmail"
      r: false
      sh: "The last commit email for the viewer."
      t: "`$STRING`"
    }
    viewerDefaultMergeMethod: {
      h: "Viewer Default Merge Method"
      n: "viewerDefaultMergeMethod"
      r: true
      sh: "The last used merge method by the viewer or the default for the repository."
      t: "`$STRING`"
    }
    viewerHasStarred: {
      h: "Viewer Has Starred"
      n: "viewerHasStarred"
      r: true
      sh: "Returns a boolean indicating whether the viewing user has starred this starrable."
      t: "`$BOOLEAN`"
    }
    viewerPermission: {
      h: "Viewer Permission"
      n: "viewerPermission"
      r: false
      sh: "The users permission level on the repository."
      t: "`$STRING`"
    }
    viewerPossibleCommitEmails: {
      h: "Viewer Possible Commit Emails"
      n: "viewerPossibleCommitEmails"
      r: false
      sh: "A list of emails this viewer can commit with."
      t: "`$STRING`"
    }
    viewerSubscription: {
      h: "Viewer Subscription"
      n: "viewerSubscription"
      r: false
      sh: "Identifies if the viewer is watching, not watching, or ignoring the subscribable entity."
      t: "`$STRING`"
    }
    visibility: {
      h: "Visibility"
      n: "visibility"
      r: true
      sh: "Indicates the repository's visibility level."
      t: "`$STRING`"
    }
    webCommitSignoffRequired: {
      h: "Web Commit Signoff Required"
      n: "webCommitSignoffRequired"
      r: true
      sh: "Whether contributors are required to sign off on web-based commits in this repository."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "repository"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST accessUserNamespaceRepository"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation RepositoryCreateAccessUserNamespace($input: AccessUserNamespaceRepositoryInput!) { accessUserNamespaceRepository(input: $input) { repository { ...RepositoryFields } } } fragment RepositoryFields on Repository { allowUpdateBranch archivedAt autoMergeAllowed codeOfConduct { id } createdAt databaseId defaultBranchRef { id } deleteBranchOnMerge description descriptionHTML diskUsage forkCount forkingAllowed hasDiscussionsEnabled hasIssuesEnabled hasProjectsEnabled hasPullRequestsEnabled hasSponsorshipsEnabled hasVulnerabilityAlertsEnabled hasWikiEnabled homepageUrl id isArchived isBlankIssuesEnabled isDisabled isEmpty isFork isInOrganization isLocked isMirror isPrivate isSecurityPolicyEnabled isTemplate isUserConfigurationRepository issueCreationPolicy latestRelease { id } licenseInfo { id } lockReason mergeCommitAllowed mergeCommitMessage mergeCommitTitle mergeQueue { id } mirrorUrl name nameWithOwner object { id } openGraphImageUrl owner { id } parent { id } primaryLanguage { id } projectsResourcePath projectsUrl pullRequestCreationPolicy pushedAt rebaseMergeAllowed resourcePath securityPolicyUrl shortDescriptionHTML squashMergeAllowed squashMergeCommitMessage squashMergeCommitTitle sshUrl stargazerCount tempCloneToken templateRepository { id } updatedAt url usesCustomOpenGraphImage viewerCanAdminister viewerCanCreateIssues viewerCanSeeIssueFields viewerCanSubscribe viewerCanUpdateTopics viewerDefaultCommitEmail viewerDefaultMergeMethod viewerHasStarred viewerPermission viewerPossibleCommitEmails viewerSubscription visibility webCommitSignoffRequired }"
            field: "accessUserNamespaceRepository"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AccessUserNamespaceRepositoryInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "accessUserNamespaceRepository"
          q: {
            "$action": "access_user_namespace"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.accessUserNamespaceRepository.repository`"
          }
        }
        {
          co: {
            id: "POST addPullRequestCreationCapBypassUsers"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation RepositoryCreateAddPullRequestCreationCapBypassUser($input: AddPullRequestCreationCapBypassUsersInput!) { addPullRequestCreationCapBypassUsers(input: $input) { repository { ...RepositoryFields } } } fragment RepositoryFields on Repository { allowUpdateBranch archivedAt autoMergeAllowed codeOfConduct { id } createdAt databaseId defaultBranchRef { id } deleteBranchOnMerge description descriptionHTML diskUsage forkCount forkingAllowed hasDiscussionsEnabled hasIssuesEnabled hasProjectsEnabled hasPullRequestsEnabled hasSponsorshipsEnabled hasVulnerabilityAlertsEnabled hasWikiEnabled homepageUrl id isArchived isBlankIssuesEnabled isDisabled isEmpty isFork isInOrganization isLocked isMirror isPrivate isSecurityPolicyEnabled isTemplate isUserConfigurationRepository issueCreationPolicy latestRelease { id } licenseInfo { id } lockReason mergeCommitAllowed mergeCommitMessage mergeCommitTitle mergeQueue { id } mirrorUrl name nameWithOwner object { id } openGraphImageUrl owner { id } parent { id } primaryLanguage { id } projectsResourcePath projectsUrl pullRequestCreationPolicy pushedAt rebaseMergeAllowed resourcePath securityPolicyUrl shortDescriptionHTML squashMergeAllowed squashMergeCommitMessage squashMergeCommitTitle sshUrl stargazerCount tempCloneToken templateRepository { id } updatedAt url usesCustomOpenGraphImage viewerCanAdminister viewerCanCreateIssues viewerCanSeeIssueFields viewerCanSubscribe viewerCanUpdateTopics viewerDefaultCommitEmail viewerDefaultMergeMethod viewerHasStarred viewerPermission viewerPossibleCommitEmails viewerSubscription visibility webCommitSignoffRequired }"
            field: "addPullRequestCreationCapBypassUsers"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddPullRequestCreationCapBypassUsersInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "addPullRequestCreationCapBypassUsers"
          q: {
            "$action": "add_pull_request_creation_cap_bypass_user"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.addPullRequestCreationCapBypassUsers.repository`"
          }
        }
        {
          co: {
            id: "POST archiveRepository"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation RepositoryCreateArchive($input: ArchiveRepositoryInput!) { archiveRepository(input: $input) { repository { ...RepositoryFields } } } fragment RepositoryFields on Repository { allowUpdateBranch archivedAt autoMergeAllowed codeOfConduct { id } createdAt databaseId defaultBranchRef { id } deleteBranchOnMerge description descriptionHTML diskUsage forkCount forkingAllowed hasDiscussionsEnabled hasIssuesEnabled hasProjectsEnabled hasPullRequestsEnabled hasSponsorshipsEnabled hasVulnerabilityAlertsEnabled hasWikiEnabled homepageUrl id isArchived isBlankIssuesEnabled isDisabled isEmpty isFork isInOrganization isLocked isMirror isPrivate isSecurityPolicyEnabled isTemplate isUserConfigurationRepository issueCreationPolicy latestRelease { id } licenseInfo { id } lockReason mergeCommitAllowed mergeCommitMessage mergeCommitTitle mergeQueue { id } mirrorUrl name nameWithOwner object { id } openGraphImageUrl owner { id } parent { id } primaryLanguage { id } projectsResourcePath projectsUrl pullRequestCreationPolicy pushedAt rebaseMergeAllowed resourcePath securityPolicyUrl shortDescriptionHTML squashMergeAllowed squashMergeCommitMessage squashMergeCommitTitle sshUrl stargazerCount tempCloneToken templateRepository { id } updatedAt url usesCustomOpenGraphImage viewerCanAdminister viewerCanCreateIssues viewerCanSeeIssueFields viewerCanSubscribe viewerCanUpdateTopics viewerDefaultCommitEmail viewerDefaultMergeMethod viewerHasStarred viewerPermission viewerPossibleCommitEmails viewerSubscription visibility webCommitSignoffRequired }"
            field: "archiveRepository"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ArchiveRepositoryInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "archiveRepository"
          q: {
            "$action": "archive"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.archiveRepository.repository`"
          }
        }
        {
          co: {
            id: "POST cloneTemplateRepository"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation RepositoryCreateCloneTemplate($input: CloneTemplateRepositoryInput!) { cloneTemplateRepository(input: $input) { repository { ...RepositoryFields } } } fragment RepositoryFields on Repository { allowUpdateBranch archivedAt autoMergeAllowed codeOfConduct { id } createdAt databaseId defaultBranchRef { id } deleteBranchOnMerge description descriptionHTML diskUsage forkCount forkingAllowed hasDiscussionsEnabled hasIssuesEnabled hasProjectsEnabled hasPullRequestsEnabled hasSponsorshipsEnabled hasVulnerabilityAlertsEnabled hasWikiEnabled homepageUrl id isArchived isBlankIssuesEnabled isDisabled isEmpty isFork isInOrganization isLocked isMirror isPrivate isSecurityPolicyEnabled isTemplate isUserConfigurationRepository issueCreationPolicy latestRelease { id } licenseInfo { id } lockReason mergeCommitAllowed mergeCommitMessage mergeCommitTitle mergeQueue { id } mirrorUrl name nameWithOwner object { id } openGraphImageUrl owner { id } parent { id } primaryLanguage { id } projectsResourcePath projectsUrl pullRequestCreationPolicy pushedAt rebaseMergeAllowed resourcePath securityPolicyUrl shortDescriptionHTML squashMergeAllowed squashMergeCommitMessage squashMergeCommitTitle sshUrl stargazerCount tempCloneToken templateRepository { id } updatedAt url usesCustomOpenGraphImage viewerCanAdminister viewerCanCreateIssues viewerCanSeeIssueFields viewerCanSubscribe viewerCanUpdateTopics viewerDefaultCommitEmail viewerDefaultMergeMethod viewerHasStarred viewerPermission viewerPossibleCommitEmails viewerSubscription visibility webCommitSignoffRequired }"
            field: "cloneTemplateRepository"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CloneTemplateRepositoryInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "cloneTemplateRepository"
          q: {
            "$action": "clone_template"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.cloneTemplateRepository.repository`"
          }
        }
        {
          co: {
            id: "POST createRepository"
            source: "graphql"
            version: 2
