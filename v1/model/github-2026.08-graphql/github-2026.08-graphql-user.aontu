# Entity: user

main: kit: entity: user: {

  alias: field: {}

  fields: [
    {
      name: "anyPinnableItems"
      req: true
      short: "Determine if this repository owner has any items that can be pinned to their profile."
      type: "`$BOOLEAN`"
    }
    {
      name: "avatarUrl"
      req: true
      short: "A URL pointing to the user's public avatar."
      type: "`$ANY`"
    }
    {
      name: "bio"
      req: false
      short: "The user's public profile bio."
      type: "`$STRING`"
    }
    {
      name: "bioHTML"
      req: true
      short: "The user's public profile bio as HTML."
      type: "`$ANY`"
    }
    {
      name: "company"
      req: false
      short: "The user's public profile company."
      type: "`$STRING`"
    }
    {
      name: "companyHTML"
      req: true
      short: "The user's public profile company as HTML."
      type: "`$ANY`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$INTEGER`"
    }
    {
      name: "email"
      req: true
      short: "The user's publicly visible profile email."
      type: "`$STRING`"
    }
    {
      name: "estimatedNextSponsorsPayoutInCents"
      req: true
      short: "The estimated next GitHub Sponsors payout for this user/organization in cents (USD)."
      type: "`$INTEGER`"
    }
    {
      name: "hasSponsorsListing"
      req: true
      short: "True if this user/organization has a GitHub Sponsors listing."
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the User object"
      type: "`$STRING`"
    }
    {
      name: "isBountyHunter"
      req: true
      short: "Whether or not this user is a participant in the GitHub Security Bug Bounty."
      type: "`$BOOLEAN`"
    }
    {
      name: "isCampusExpert"
      req: true
      short: "Whether or not this user is a participant in the GitHub Campus Experts Program."
      type: "`$BOOLEAN`"
    }
    {
      name: "isDeveloperProgramMember"
      req: true
      short: "Whether or not this user is a GitHub Developer Program member."
      type: "`$BOOLEAN`"
    }
    {
      name: "isEmployee"
      req: true
      short: "Whether or not this user is a GitHub employee."
      type: "`$BOOLEAN`"
    }
    {
      name: "isFollowingViewer"
      req: true
      short: "Whether or not this user is following the viewer."
      type: "`$BOOLEAN`"
    }
    {
      name: "isGitHubStar"
      req: true
      short: "Whether or not this user is a member of the GitHub Stars Program."
      type: "`$BOOLEAN`"
    }
    {
      name: "isHireable"
      req: true
      short: "Whether or not the user has marked themselves as for hire."
      type: "`$BOOLEAN`"
    }
    {
      name: "isSiteAdmin"
      req: true
      short: "Whether or not this user is a site administrator."
      type: "`$BOOLEAN`"
    }
    {
      name: "isSponsoringViewer"
      req: true
      short: "True if the viewer is sponsored by this user/organization."
      type: "`$BOOLEAN`"
    }
    {
      name: "isViewer"
      req: true
      short: "Whether or not this user is the viewing user."
      type: "`$BOOLEAN`"
    }
    {
      name: "location"
      req: false
      short: "The user's public profile location."
      type: "`$STRING`"
    }
    {
      name: "login"
      req: true
      short: "The username used to login."
      type: "`$STRING`"
    }
    {
      name: "monthlyEstimatedSponsorsIncomeInCents"
      req: true
      short: "The estimated monthly GitHub Sponsors income for this user/organization in cents (USD)."
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "The user's public profile name."
      type: "`$STRING`"
    }
    {
      name: "pinnedItemsRemaining"
      req: true
      short: "Returns how many more items this profile owner can pin to their profile."
      type: "`$INTEGER`"
    }
    {
      name: "projectsResourcePath"
      req: true
      short: "The HTTP path listing user's projects"
      type: "`$ANY`"
    }
    {
      name: "projectsUrl"
      req: true
      short: "The HTTP URL listing user's projects"
      type: "`$ANY`"
    }
    {
      name: "pronouns"
      req: false
      short: "The user's profile pronouns"
      type: "`$STRING`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this user"
      type: "`$ANY`"
    }
    {
      name: "sponsorsListing"
      req: false
      short: "The GitHub Sponsors listing for this user or organization."
      type: "`$OBJECT`"
    }
    {
      name: "sponsorshipForViewerAsSponsor"
      req: false
      short: "The sponsorship from the viewer to this user/organization; that is, the sponsorship where you're the sponsor."
      type: "`$OBJECT`"
    }
    {
      name: "sponsorshipForViewerAsSponsorable"
      req: false
      short: "The sponsorship from this user/organization to the viewer; that is, the sponsorship you're receiving."
      type: "`$OBJECT`"
    }
    {
      name: "status"
      req: false
      short: "The user's description of what they're currently doing."
      type: "`$OBJECT`"
    }
    {
      name: "totalSponsorshipAmountAsSponsorInCents"
      req: false
      short: "The amount in United States cents (e.g., 500 = $5.00 USD) that this entity has spent on GitHub to fund sponsorships."
      type: "`$INTEGER`"
    }
    {
      name: "twitterUsername"
      req: false
      short: "The user's Twitter username."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this user"
      type: "`$STRING`"
    }
    {
      name: "userViewType"
      req: true
      short: "Whether the request returns publicly visible information or privately visible information about the user"
      type: "`$STRING`"
    }
    {
      name: "viewerCanChangePinnedItems"
      req: true
      short: "Can the viewer pin repositories and gists to the profile?"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanFollow"
      req: true
      short: "Whether or not the viewer is able to follow the user."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanSponsor"
      req: true
      short: "Whether or not the viewer is able to sponsor this user/organization."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCopilotAgentCreatesChannel"
      req: false
      short: "Channel value for subscribing to live updates for session creations."
      type: "`$STRING`"
    }
    {
      name: "viewerCopilotAgentLogUpdatesChannel"
      req: false
      short: "Channel value for subscribing to live updates for session log updates."
      type: "`$STRING`"
    }
    {
      name: "viewerCopilotAgentTaskUpdatesChannel"
      req: false
      short: "Channel value for subscribing to live updates for task updates."
      type: "`$STRING`"
    }
    {
      name: "viewerCopilotAgentUpdatesChannel"
      req: false
      short: "Channel value for subscribing to live updates for session updates."
      type: "`$STRING`"
    }
    {
      name: "viewerIsFollowing"
      req: true
      short: "Whether or not this user is followed by the viewer."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerIsSponsoring"
      req: true
      short: "True if the viewer is sponsoring this user/organization."
      type: "`$BOOLEAN`"
    }
    {
      name: "websiteUrl"
      req: false
      short: "A URL pointing to the user's public website/blog."
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "user"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation UserCreateDeleteUserList($input: DeleteUserListInput!) { deleteUserList(input: $input) { user { ...UserFields } } } fragment UserFields on User { anyPinnableItems avatarUrl bio bioHTML company companyHTML createdAt databaseId email estimatedNextSponsorsPayoutInCents hasSponsorsListing id isBountyHunter isCampusExpert isDeveloperProgramMember isEmployee isFollowingViewer isGitHubStar isHireable isSiteAdmin isSponsoringViewer isViewer location login monthlyEstimatedSponsorsIncomeInCents name pinnedItemsRemaining projectsResourcePath projectsUrl pronouns resourcePath sponsorsListing { id } sponsorshipForViewerAsSponsor { id } sponsorshipForViewerAsSponsorable { id } status { id } totalSponsorshipAmountAsSponsorInCents twitterUsername updatedAt url userViewType viewerCanChangePinnedItems viewerCanFollow viewerCanSponsor viewerCopilotAgentCreatesChannel viewerCopilotAgentLogUpdatesChannel viewerCopilotAgentTaskUpdatesChannel viewerCopilotAgentUpdatesChannel viewerIsFollowing viewerIsSponsoring websiteUrl }"
            field: "deleteUserList"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "DeleteUserListInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "deleteUserList"
          select: {
            "$action": "delete_user_list"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.deleteUserList.user`"
          }
        }
        {
          graphql: {
            doc: "mutation UserCreateFollow($input: FollowUserInput!) { followUser(input: $input) { user { ...UserFields } } } fragment UserFields on User { anyPinnableItems avatarUrl bio bioHTML company companyHTML createdAt databaseId email estimatedNextSponsorsPayoutInCents hasSponsorsListing id isBountyHunter isCampusExpert isDeveloperProgramMember isEmployee isFollowingViewer isGitHubStar isHireable isSiteAdmin isSponsoringViewer isViewer location login monthlyEstimatedSponsorsIncomeInCents name pinnedItemsRemaining projectsResourcePath projectsUrl pronouns resourcePath sponsorsListing { id } sponsorshipForViewerAsSponsor { id } sponsorshipForViewerAsSponsorable { id } status { id } totalSponsorshipAmountAsSponsorInCents twitterUsername updatedAt url userViewType viewerCanChangePinnedItems viewerCanFollow viewerCanSponsor viewerCopilotAgentCreatesChannel viewerCopilotAgentLogUpdatesChannel viewerCopilotAgentTaskUpdatesChannel viewerCopilotAgentUpdatesChannel viewerIsFollowing viewerIsSponsoring websiteUrl }"
            field: "followUser"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "FollowUserInput!"
                name: "input"
              }
