# Entity: organization_migration

main: kit: entity: organization_migration: {

  alias: field: {}

  fields: [
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$STRING`"
    }
    {
      name: "failureReason"
      req: false
      short: "The reason the organization migration failed."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the OrganizationMigration object"
      type: "`$STRING`"
    }
    {
      name: "remainingRepositoriesCount"
      req: false
      short: "The remaining amount of repos to be migrated."
      type: "`$INTEGER`"
    }
    {
      name: "sourceOrgName"
      req: true
      short: "The name of the source organization to be migrated."
      type: "`$STRING`"
    }
    {
      name: "sourceOrgUrl"
      req: true
      short: "The URL of the source organization to migrate."
      type: "`$ANY`"
    }
    {
      name: "state"
      req: true
      short: "The migration state."
      type: "`$STRING`"
    }
    {
      name: "targetOrgName"
      req: true
      short: "The name of the target organization."
      type: "`$STRING`"
    }
    {
      name: "totalRepositoriesCount"
      req: false
      short: "The total amount of repositories to be migrated."
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "organization_migration"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation OrganizationMigrationCreateStart($input: StartOrganizationMigrationInput!) { startOrganizationMigration(input: $input) { orgMigration { ...OrganizationMigrationFields } } } fragment OrganizationMigrationFields on OrganizationMigration { createdAt databaseId failureReason id remainingRepositoriesCount sourceOrgName sourceOrgUrl state targetOrgName totalRepositoriesCount }"
            field: "startOrganizationMigration"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "StartOrganizationMigrationInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "startOrganizationMigration"
          select: {
            "$action": "start"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.startOrganizationMigration.orgMigration`"
          }
        }
      ]
    }
  }



}