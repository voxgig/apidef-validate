# Entity: check_suite

main: kit: entity: check_suite: {

  alias: field: {}

  fields: {
    app: {
      h: "App"
      n: "app"
      r: false
      sh: "The GitHub App which created this check suite."
      t: "`$OBJECT`"
    }
    branch: {
      h: "Branch"
      n: "branch"
      r: false
      sh: "The name of the branch for this check suite."
      t: "`$OBJECT`"
    }
    commit: {
      h: "Commit"
      n: "commit"
      r: false
      sh: "The commit for this check suite"
      t: "`$OBJECT`"
    }
    conclusion: {
      h: "Conclusion"
      n: "conclusion"
      r: false
      sh: "The conclusion of this check suite."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    creator: {
      h: "Creator"
      n: "creator"
      r: false
      sh: "The user who triggered the check suite."
      t: "`$OBJECT`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the CheckSuite object"
      t: "`$STRING`"
    }
    push: {
      h: "Push"
      n: "push"
      r: false
      sh: "The push that triggered this check suite."
      t: "`$OBJECT`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The repository associated with this check suite."
      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this check suite"
      t: "`$ANY`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      sh: "The status of this check suite."
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this check suite"
      t: "`$STRING`"
    }
    workflowRun: {
      h: "Workflow Run"
      n: "workflowRun"
      r: false
      sh: "The workflow run associated with this check suite."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "check_suite"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST createCheckSuite"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation CheckSuiteCreate($input: CreateCheckSuiteInput!) { createCheckSuite(input: $input) { checkSuite { ...CheckSuiteFields } } } fragment CheckSuiteFields on CheckSuite { app { id } branch { id } commit { id } conclusion createdAt creator { id } databaseId id push { id } repository { id } resourcePath status updatedAt url workflowRun { id } }"
            field: "createCheckSuite"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateCheckSuiteInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createCheckSuite"
          transform: {
            req: "`reqdata`"
            res: "`body.data.createCheckSuite.checkSuite`"
          }
        }
        {
          contract: {
            id: "POST rerequestCheckSuite"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation CheckSuiteCreateRerequest($input: RerequestCheckSuiteInput!) { rerequestCheckSuite(input: $input) { checkSuite { ...CheckSuiteFields } } } fragment CheckSuiteFields on CheckSuite { app { id } branch { id } commit { id } conclusion createdAt creator { id } databaseId id push { id } repository { id } resourcePath status updatedAt url workflowRun { id } }"
            field: "rerequestCheckSuite"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "RerequestCheckSuiteInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "rerequestCheckSuite"
          select: {
            "$action": "rerequest"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.rerequestCheckSuite.checkSuite`"
          }
        }
      ]
    }
  }



}