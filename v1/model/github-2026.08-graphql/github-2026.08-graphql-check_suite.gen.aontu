# Entity: check_suite

main: kit: entity: check_suite: {

  alias: field: {}

  fields: [
    {
      name: "app"
      req: false
      short: "The GitHub App which created this check suite."
      type: "`$OBJECT`"
    }
    {
      name: "branch"
      req: false
      short: "The name of the branch for this check suite."
      type: "`$OBJECT`"
    }
    {
      name: "commit"
      req: false
      short: "The commit for this check suite"
      type: "`$OBJECT`"
    }
    {
      name: "conclusion"
      req: false
      short: "The conclusion of this check suite."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "creator"
      req: false
      short: "The user who triggered the check suite."
      type: "`$OBJECT`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the CheckSuite object"
      type: "`$STRING`"
    }
    {
      name: "push"
      req: false
      short: "The push that triggered this check suite."
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
      short: "The repository associated with this check suite."
      type: "`$OBJECT`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this check suite"
      type: "`$ANY`"
    }
    {
      name: "status"
      req: true
      short: "The status of this check suite."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this check suite"
      type: "`$STRING`"
    }
    {
      name: "workflowRun"
      req: false
      short: "The workflow run associated with this check suite."
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "check_suite"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation CheckSuiteCreate($input: CreateCheckSuiteInput!) { createCheckSuite(input: $input) { checkSuite { ...CheckSuiteFields } } } fragment CheckSuiteFields on CheckSuite { app { id } branch { id } commit { id } conclusion createdAt creator { id } databaseId id push { id } repository { id } resourcePath status updatedAt url workflowRun { id } }"
            field: "createCheckSuite"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateCheckSuiteInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createCheckSuite"
          transform: {
            req: "`reqdata`"
            res: "`body.data.createCheckSuite.checkSuite`"
          }
        }
        {
          graphql: {
            doc: "mutation CheckSuiteCreateRerequest($input: RerequestCheckSuiteInput!) { rerequestCheckSuite(input: $input) { checkSuite { ...CheckSuiteFields } } } fragment CheckSuiteFields on CheckSuite { app { id } branch { id } commit { id } conclusion createdAt creator { id } databaseId id push { id } repository { id } resourcePath status updatedAt url workflowRun { id } }"
            field: "rerequestCheckSuite"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "RerequestCheckSuiteInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "rerequestCheckSuite"
          select: {
            "$action": "rerequest"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.rerequestCheckSuite.checkSuite`"
          }
        }
      ]
    }
  }



}