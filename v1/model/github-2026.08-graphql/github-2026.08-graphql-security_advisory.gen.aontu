# Entity: security_advisory

main: kit: entity: security_advisory: {

  alias: field: {}

  fields: {
    classification: {
      h: "Classification"
      n: "classification"
      r: true
      sh: "The classification of the advisory"
      t: "`$STRING`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    description: {
      h: "Description"
      n: "description"
      r: true
      sh: "This is a long plaintext description of the advisory"
      t: "`$STRING`"
    }
    ghsaId: {
      h: "Ghsa Id"
      n: "ghsaId"
      r: true
      sh: "The GitHub Security Advisory ID"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the SecurityAdvisory object"
      t: "`$STRING`"
    }
    notificationsPermalink: {
      h: "Notifications Permalink"
      n: "notificationsPermalink"
      r: false
      sh: "The permalink for the advisory's dependabot alerts page"
      t: "`$ANY`"
    }
    origin: {
      h: "Origin"
      n: "origin"
      r: true
      sh: "The organization that originated the advisory"
      t: "`$STRING`"
    }
    permalink: {
      h: "Permalink"
      n: "permalink"
      r: false
      sh: "The permalink for the advisory"
      t: "`$ANY`"
    }
    publishedAt: {
      h: "Published At"
      n: "publishedAt"
      r: true
      sh: "When the advisory was published"
      t: "`$ANY`"
    }
    severity: {
      h: "Severity"
      n: "severity"
      r: true
      sh: "The severity of the advisory"
      t: "`$STRING`"
    }
    summary: {
      h: "Summary"
      n: "summary"
      r: true
      sh: "A short plaintext summary of the advisory"
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "When the advisory was last updated"
      t: "`$ANY`"
    }
    withdrawnAt: {
      h: "Withdrawn At"
      n: "withdrawnAt"
      r: false
      sh: "When the advisory was withdrawn, if it has been withdrawn"
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "security_advisory"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "POST securityAdvisories"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "before"
                or: "before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "classification"
                or: "classification"
                r: false
                t: "`$ANY`"
              }
              {
                k: "param"
                n: "epss_percentage"
                or: "epss_percentage"
                r: false
                t: "`$NUMBER`"
              }
              {
                k: "param"
                n: "epss_percentile"
                or: "epss_percentile"
                r: false
                t: "`$NUMBER`"
              }
              {
                k: "param"
                n: "first"
                or: "first"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "last"
                or: "last"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "param"
                n: "published_since"
                or: "published_since"
                r: false
                t: "`$ANY`"
              }
              {
                k: "param"
                n: "updated_since"
                or: "updated_since"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          gq: {
            doc: "query SecurityAdvisoryList($after: String, $before: String, $classifications: [SecurityAdvisoryClassification!], $epssPercentage: Float, $epssPercentile: Float, $first: Int, $identifier: SecurityAdvisoryIdentifierFilter, $last: Int, $orderBy: SecurityAdvisoryOrder, $publishedSince: DateTime, $updatedSince: DateTime) { securityAdvisories(after: $after, before: $before, classifications: $classifications, epssPercentage: $epssPercentage, epssPercentile: $epssPercentile, first: $first, identifier: $identifier, last: $last, orderBy: $orderBy, publishedSince: $publishedSince, updatedSince: $updatedSince) { nodes { ...SecurityAdvisoryFields } pageInfo { endCursor hasNextPage } } } fragment SecurityAdvisoryFields on SecurityAdvisory { classification databaseId description ghsaId id notificationsPermalink origin permalink publishedAt severity summary updatedAt withdrawnAt }"
            field: "securityAdvisories"
            optype: "query"
            page: {
              cursor: "pageInfo.endCursor"
              more: "pageInfo.hasNextPage"
              nodes: "nodes"
              style: "relay"
            }
            vars: [
              {
                from: "after"
                gqltype: "String"
                name: "after"
              }
              {
                from: "before"
                gqltype: "String"
                name: "before"
              }
              {
                from: "classifications"
                gqltype: "[SecurityAdvisoryClassification!]"
                name: "classifications"
              }
              {
                from: "epssPercentage"
                gqltype: "Float"
                name: "epssPercentage"
              }
              {
                from: "epssPercentile"
                gqltype: "Float"
                name: "epssPercentile"
              }
              {
                from: "first"
                gqltype: "Int"
                name: "first"
              }
              {
                from: "identifier"
                gqltype: "SecurityAdvisoryIdentifierFilter"
                name: "identifier"
              }
              {
                from: "last"
                gqltype: "Int"
                name: "last"
              }
              {
                from: "orderBy"
                gqltype: "SecurityAdvisoryOrder"
                name: "orderBy"
              }
              {
                from: "publishedSince"
                gqltype: "DateTime"
                name: "publishedSince"
              }
              {
                from: "updatedSince"
                gqltype: "DateTime"
                name: "updatedSince"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "securityAdvisories"
          t: {
            req: "`reqdata`"
            res: "`body.data.securityAdvisories.nodes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST securityAdvisory"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "ghsa_id"
                or: "ghsa_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query SecurityAdvisoryLoad($ghsaId: String!) { securityAdvisory(ghsaId: $ghsaId) { ...SecurityAdvisoryFields } } fragment SecurityAdvisoryFields on SecurityAdvisory { classification databaseId description ghsaId id notificationsPermalink origin permalink publishedAt severity summary updatedAt withdrawnAt }"
            field: "securityAdvisory"
            optype: "query"
            vars: [
              {
                from: "ghsaId"
                gqltype: "String!"
                name: "ghsaId"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "securityAdvisory"
          q: {
            exist: [
              "ghsa_id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.securityAdvisory`"
          }
        }
      ]
    }
  }



}