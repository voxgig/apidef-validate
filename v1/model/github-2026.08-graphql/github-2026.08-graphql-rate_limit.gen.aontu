                type: "`$BOOLEAN`"
              }
            ]
          }
          contract: {
            id: "POST rateLimit"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"Boolean\",\"name\":\"dryRun\",\"reqd\":false,\"type\":\"Boolean\"}],\"deprecated\":false,\"desc\":\"The client's rate limit information.\",\"gqltype\":\"RateLimit\",\"list\":false,\"name\":\"rateLimit\",\"reqd\":false,\"type\":\"RateLimit\"},\"invocation\":{\"doc\":\"query RateLimitLoad($dryRun: Boolean) { rateLimit(dryRun: $dryRun) { ...RateLimitFields } } fragment RateLimitFields on RateLimit { cost limit nodeCount remaining resetAt used }\",\"field\":\"rateLimit\",\"optype\":\"query\",\"vars\":[{\"from\":\"dryRun\",\"gqltype\":\"Boolean\",\"name\":\"dryRun\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
