# Entity: rate_limit

main: kit: entity: rate_limit: {

  alias: field: {}

  fields: [
    {
      name: "cost"
      req: true
      short: "The point cost for the current query counting against the rate limit."
      type: "`$INTEGER`"
    }
    {
      name: "limit"
      req: true
      short: "The maximum number of points the client is permitted to consume in a 60 minute window."
      type: "`$INTEGER`"
    }
    {
      name: "nodeCount"
      req: true
      short: "The maximum number of nodes this query may return"
      type: "`$INTEGER`"
    }
    {
      name: "remaining"
      req: true
      short: "The number of points remaining in the current rate limit window."
      type: "`$INTEGER`"
    }
    {
      name: "resetAt"
      req: true
      short: "The time at which the current rate limit window resets in UTC epoch seconds."
      type: "`$ANY`"
    }
    {
      name: "used"
      req: true
      short: "The number of points used in the current rate limit window."
      type: "`$INTEGER`"
    }
  ]

  name: "rate_limit"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
