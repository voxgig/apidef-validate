# Entity: reaction

main: kit: entity: reaction: {

  alias: field: {}

  fields: [
    {
      name: "content"
      req: true
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      type: "`$ANY`"
    }
    {
      name: "databaseId"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "reactable"
      req: false
      type: "`$OBJECT`"
    }
    {
