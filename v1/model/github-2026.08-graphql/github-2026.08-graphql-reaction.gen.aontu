# Entity: reaction

main: kit: entity: reaction: {

  alias: field: {}

  fields: {
    content: {
      h: "Content"
      n: "content"
      r: true
      sh: "Identifies the emoji reaction."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Reaction object"
      t: "`$STRING`"
    }
    reactable: {
      h: "Reactable"
      n: "reactable"
      r: false
      sh: "The reactable piece of content"
      t: "`$OBJECT`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      sh: "Identifies the user who created this reaction."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "reaction"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST addReaction"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation ReactionCreate($input: AddReactionInput!) { addReaction(input: $input) { reaction { ...ReactionFields } } } fragment ReactionFields on Reaction { content createdAt databaseId id reactable { id } user { id } }"
            field: "addReaction"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddReactionInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "addReaction"
          t: {
            req: "`reqdata`"
            res: "`body.data.addReaction.reaction`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "POST removeReaction"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation ReactionRemove($input: RemoveReactionInput!) { removeReaction(input: $input) { reaction { ...ReactionFields } } } fragment ReactionFields on Reaction { content createdAt databaseId id reactable { id } user { id } }"
            field: "removeReaction"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "RemoveReactionInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "removeReaction"
          t: {
            req: "`reqdata`"
            res: "`body.data.removeReaction.reaction`"
          }
        }
      ]
    }
  }



}