# Entity: draft_issue

main: kit: entity: draft_issue: {

  alias: field: {}

  fields: {
    body: {
      h: "Body"
      n: "body"
      r: true
      sh: "The body of the draft issue."
      t: "`$STRING`"
    }
    bodyHTML: {
      h: "Body Html"
      n: "bodyHTML"
      r: true
      sh: "The body of the draft issue rendered to HTML."
      t: "`$ANY`"
    }
    bodyText: {
      h: "Body Text"
      n: "bodyText"
      r: true
      sh: "The body of the draft issue rendered to text."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the DraftIssue object"
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "The title of the draft issue"
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "draft_issue"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST updateProjectV2DraftIssue"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation DraftIssueCreateUpdateProjectV2($input: UpdateProjectV2DraftIssueInput!) { updateProjectV2DraftIssue(input: $input) { draftIssue { ...DraftIssueFields } } } fragment DraftIssueFields on DraftIssue { body bodyHTML bodyText createdAt id title updatedAt }"
            field: "updateProjectV2DraftIssue"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateProjectV2DraftIssueInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "updateProjectV2DraftIssue"
          q: {
            "$action": "update_project_v2"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.updateProjectV2DraftIssue.draftIssue`"
          }
        }
      ]
    }
  }



}