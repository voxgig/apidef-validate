# Entity: draft_issue

main: kit: entity: draft_issue: {

  alias: field: {}

  fields: [
    {
      name: "body"
      req: true
      short: "The body of the draft issue."
      type: "`$STRING`"
    }
    {
      name: "bodyHTML"
      req: true
      short: "The body of the draft issue rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "bodyText"
      req: true
      short: "The body of the draft issue rendered to text."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the DraftIssue object"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: true
      short: "The title of the draft issue"
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "draft_issue"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation DraftIssueCreateUpdateProjectV2($input: UpdateProjectV2DraftIssueInput!) { updateProjectV2DraftIssue(input: $input) { draftIssue { ...DraftIssueFields } } } fragment DraftIssueFields on DraftIssue { body bodyHTML bodyText createdAt id title updatedAt }"
            field: "updateProjectV2DraftIssue"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateProjectV2DraftIssueInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updateProjectV2DraftIssue"
          select: {
            "$action": "update_project_v2"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.updateProjectV2DraftIssue.draftIssue`"
          }
        }
      ]
    }
  }



}