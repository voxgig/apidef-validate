# Entity: pull_request_review_thread

main: kit: entity: pull_request_review_thread: {

  alias: field: {}

  fields: [
    {
      name: "diffSide"
      req: true
      short: "The side of the diff on which this thread was placed."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the PullRequestReviewThread object"
      type: "`$STRING`"
    }
    {
      name: "isCollapsed"
      req: true
      short: "Whether or not the thread has been collapsed (resolved)"
      type: "`$BOOLEAN`"
    }
    {
      name: "isOutdated"
      req: true
      short: "Indicates whether this thread was outdated by newer changes."
      type: "`$BOOLEAN`"
    }
    {
      name: "isResolved"
      req: true
      short: "Whether this thread has been resolved"
      type: "`$BOOLEAN`"
    }
    {
