    }
    {
      name: "startLine"
      req: false
      short: "The start line in the file to which this thread refers (multi-line only)"
      type: "`$INTEGER`"
    }
    {
      name: "subjectType"
      req: true
      short: "The level at which the comments in the corresponding thread are targeted, can be a diff line or a file"
      type: "`$STRING`"
    }
    {
      name: "viewerCanReply"
      req: true
      short: "Indicates whether the current viewer can reply to this thread."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanResolve"
      req: true
      short: "Whether or not the viewer can resolve this thread"
