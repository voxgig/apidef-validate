# Entity: pull_request_review_thread

main: kit: entity: pull_request_review_thread: {

  alias: field: {}

  fields: [
    {
      name: "diffSide"
      req: true
      short: "The side of the diff on which this thread was placed."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the PullRequestReviewThread object"
      type: "`$STRING`"
    }
    {
      name: "isCollapsed"
      req: true
      short: "Whether or not the thread has been collapsed (resolved)"
      type: "`$BOOLEAN`"
    }
    {
      name: "isOutdated"
      req: true
      short: "Indicates whether this thread was outdated by newer changes."
      type: "`$BOOLEAN`"
    }
    {
      name: "isResolved"
      req: true
      short: "Whether this thread has been resolved"
      type: "`$BOOLEAN`"
    }
    {
      name: "line"
      req: false
      short: "The line in the file to which this thread refers"
      type: "`$INTEGER`"
    }
    {
      name: "originalLine"
      req: false
      short: "The original line in the file to which this thread refers."
      type: "`$INTEGER`"
    }
    {
      name: "originalStartLine"
      req: false
      short: "The original start line in the file to which this thread refers (multi-line only)."
      type: "`$INTEGER`"
    }
    {
      name: "path"
      req: true
      short: "Identifies the file path of this thread."
      type: "`$STRING`"
    }
    {
      name: "pullRequest"
      req: false
      short: "Identifies the pull request associated with this thread."
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
      short: "Identifies the repository associated with this thread."
      type: "`$OBJECT`"
    }
    {
      name: "resolvedBy"
      req: false
      short: "The user who resolved this thread"
      type: "`$OBJECT`"
    }
    {
      name: "startDiffSide"
      req: false
      short: "The side of the diff that the first line of the thread starts on (multi-line only)"
      type: "`$STRING`"
    }
    {
      name: "startLine"
      req: false
      short: "The start line in the file to which this thread refers (multi-line only)"
      type: "`$INTEGER`"
    }
    {
      name: "subjectType"
      req: true
      short: "The level at which the comments in the corresponding thread are targeted, can be a diff line or a file"
      type: "`$STRING`"
    }
    {
      name: "viewerCanReply"
      req: true
      short: "Indicates whether the current viewer can reply to this thread."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanResolve"
      req: true
      short: "Whether or not the viewer can resolve this thread"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUnresolve"
      req: true
      short: "Whether or not the viewer can unresolve this thread"
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "pull_request_review_thread"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation PullRequestReviewThreadCreate($input: AddPullRequestReviewThreadInput!) { addPullRequestReviewThread(input: $input) { thread { ...PullRequestReviewThreadFields } } } fragment PullRequestReviewThreadFields on PullRequestReviewThread { diffSide id isCollapsed isOutdated isResolved line originalLine originalStartLine path pullRequest { id } repository { id } resolvedBy { id } startDiffSide startLine subjectType viewerCanReply viewerCanResolve viewerCanUnresolve }"
            field: "addPullRequestReviewThread"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddPullRequestReviewThreadInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "addPullRequestReviewThread"
          transform: {
            req: "`reqdata`"
            res: "`body.data.addPullRequestReviewThread.thread`"
          }
        }
        {
          graphql: {
            doc: "mutation PullRequestReviewThreadCreateResolveReviewThread($input: ResolveReviewThreadInput!) { resolveReviewThread(input: $input) { thread { ...PullRequestReviewThreadFields } } } fragment PullRequestReviewThreadFields on PullRequestReviewThread { diffSide id isCollapsed isOutdated isResolved line originalLine originalStartLine path pullRequest { id } repository { id } resolvedBy { id } startDiffSide startLine subjectType viewerCanReply viewerCanResolve viewerCanUnresolve }"
            field: "resolveReviewThread"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ResolveReviewThreadInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "resolveReviewThread"
          select: {
            "$action": "resolve_review_thread"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.resolveReviewThread.thread`"
          }
        }
        {
          graphql: {
            doc: "mutation PullRequestReviewThreadCreateUnresolveReviewThread($input: UnresolveReviewThreadInput!) { unresolveReviewThread(input: $input) { thread { ...PullRequestReviewThreadFields } } } fragment PullRequestReviewThreadFields on PullRequestReviewThread { diffSide id isCollapsed isOutdated isResolved line originalLine originalStartLine path pullRequest { id } repository { id } resolvedBy { id } startDiffSide startLine subjectType viewerCanReply viewerCanResolve viewerCanUnresolve }"
            field: "unresolveReviewThread"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UnresolveReviewThreadInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "unresolveReviewThread"
          select: {
            "$action": "unresolve_review_thread"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.unresolveReviewThread.thread`"
          }
        }
      ]
    }
  }



}