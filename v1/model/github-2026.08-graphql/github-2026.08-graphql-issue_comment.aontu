# Entity: issue_comment

main: kit: entity: issue_comment: {

  alias: field: {}

  fields: {
    authorAssociation: {
      h: "Author Association"
      n: "authorAssociation"
      r: true
      sh: "Author's association with the subject of the comment."
      t: "`$STRING`"
    }
    body: {
      h: "Body"
      n: "body"
      r: true
      sh: "The body as Markdown."
      t: "`$STRING`"
    }
    bodyHTML: {
      h: "Body Html"
      n: "bodyHTML"
      r: true
      sh: "The body rendered to HTML."
      t: "`$ANY`"
    }
    bodyText: {
      h: "Body Text"
      n: "bodyText"
      r: true
      sh: "The body rendered to text."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    createdViaEmail: {
      h: "Created Via Email"
      n: "createdViaEmail"
      r: true
      sh: "Check if this comment was created via an email reply."
      t: "`$BOOLEAN`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    fullDatabaseId: {
      h: "Full Database Id"
      n: "fullDatabaseId"
      r: false
      sh: "Identifies the primary key from the database as a BigInt."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the IssueComment object"
      t: "`$STRING`"
    }
    includesCreatedEdit: {
      h: "Includes Created Edit"
      n: "includesCreatedEdit"
      r: true
      sh: "Check if this comment was edited and includes an edit with the creation data"
      t: "`$BOOLEAN`"
    }
    isMinimized: {
      h: "Is Minimized"
      n: "isMinimized"
      r: true
      sh: "Returns whether or not a comment has been minimized."
      t: "`$BOOLEAN`"
    }
    isPinned: {
      h: "Is Pinned"
      n: "isPinned"
      r: false
      sh: "Indicates whether or not this entity is currently pinned."
      t: "`$BOOLEAN`"
    }
    issue: {
      h: "Issue"
      n: "issue"
      r: false
      sh: "Identifies the issue associated with the comment."
      t: "`$OBJECT`"
    }
    lastEditedAt: {
      h: "Last Edited At"
      n: "lastEditedAt"
      r: false
      sh: "The moment the editor made the last edit"
      t: "`$ANY`"
    }
    minimizedReason: {
      h: "Minimized Reason"
      n: "minimizedReason"
      r: false
      sh: "Returns why the comment was minimized."
      t: "`$STRING`"
    }
    pinnedAt: {
      h: "Pinned At"
      n: "pinnedAt"
      r: false
      sh: "Identifies the date and time when this entity was pinned."
      t: "`$ANY`"
    }
    pinnedBy: {
      h: "Pinned By"
      n: "pinnedBy"
      r: false
      sh: "The user who pinned this entity."
      t: "`$OBJECT`"
    }
    publishedAt: {
      h: "Published At"
      n: "publishedAt"
      r: false
      sh: "Identifies when the comment was published at."
      t: "`$ANY`"
    }
    pullRequest: {
      h: "Pull Request"
      n: "pullRequest"
      r: false
      sh: "Returns the pull request associated with the comment, if this comment was made on a pull request."
      t: "`$OBJECT`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The repository associated with this node."
      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this issue comment"
      t: "`$ANY`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this issue comment"
      t: "`$STRING`"
    }
    viewerCanDelete: {
      h: "Viewer Can Delete"
      n: "viewerCanDelete"
      r: true
      sh: "Check if the current viewer can delete this object."
      t: "`$BOOLEAN`"
    }
    viewerCanMinimize: {
      h: "Viewer Can Minimize"
      n: "viewerCanMinimize"
      r: true
      sh: "Check if the current viewer can minimize this object."
      t: "`$BOOLEAN`"
    }
    viewerCanPin: {
      h: "Viewer Can Pin"
      n: "viewerCanPin"
      r: true
      sh: "Check if the current viewer can pin this entity."
      t: "`$BOOLEAN`"
    }
    viewerCanReact: {
      h: "Viewer Can React"
      n: "viewerCanReact"
      r: true
      sh: "Can user react to this subject"
      t: "`$BOOLEAN`"
    }
    viewerCanUnminimize: {
      h: "Viewer Can Unminimize"
      n: "viewerCanUnminimize"
      r: true
      sh: "Check if the current viewer can unminimize this object."
      t: "`$BOOLEAN`"
    }
    viewerCanUnpin: {
      h: "Viewer Can Unpin"
      n: "viewerCanUnpin"
      r: true
      sh: "Check if the current viewer can unpin this entity."
      t: "`$BOOLEAN`"
    }
    viewerCanUpdate: {
      h: "Viewer Can Update"
      n: "viewerCanUpdate"
      r: true
      sh: "Check if the current viewer can update this object."
      t: "`$BOOLEAN`"
    }
    viewerCannotUpdateReasons: {
      h: "Viewer Cannot Update Reasons"
      n: "viewerCannotUpdateReasons"
      r: true
      sh: "Reasons why the current viewer can not update this comment."
      t: "`$STRING`"
    }
    viewerDidAuthor: {
      h: "Viewer Did Author"
      n: "viewerDidAuthor"
      r: true
      sh: "Did the viewer author this comment."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "issue_comment"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST pinIssueComment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation IssueCommentCreatePin($input: PinIssueCommentInput!) { pinIssueComment(input: $input) { issueComment { ...IssueCommentFields } } } fragment IssueCommentFields on IssueComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId fullDatabaseId id includesCreatedEdit isMinimized isPinned issue { id } lastEditedAt minimizedReason pinnedAt pinnedBy { id } publishedAt pullRequest { id } repository { id } resourcePath updatedAt url viewerCanDelete viewerCanMinimize viewerCanPin viewerCanReact viewerCanUnminimize viewerCanUnpin viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "pinIssueComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "PinIssueCommentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "pinIssueComment"
          q: {
            "$action": "pin"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.pinIssueComment.issueComment`"
          }
        }
        {
          co: {
            id: "POST unpinIssueComment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation IssueCommentCreateUnpin($input: UnpinIssueCommentInput!) { unpinIssueComment(input: $input) { issueComment { ...IssueCommentFields } } } fragment IssueCommentFields on IssueComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId fullDatabaseId id includesCreatedEdit isMinimized isPinned issue { id } lastEditedAt minimizedReason pinnedAt pinnedBy { id } publishedAt pullRequest { id } repository { id } resourcePath updatedAt url viewerCanDelete viewerCanMinimize viewerCanPin viewerCanReact viewerCanUnminimize viewerCanUnpin viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "unpinIssueComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UnpinIssueCommentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "unpinIssueComment"
          q: {
            "$action": "unpin"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.unpinIssueComment.issueComment`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST updateIssueComment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation IssueCommentUpdate($input: UpdateIssueCommentInput!) { updateIssueComment(input: $input) { issueComment { ...IssueCommentFields } } } fragment IssueCommentFields on IssueComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId fullDatabaseId id includesCreatedEdit isMinimized isPinned issue { id } lastEditedAt minimizedReason pinnedAt pinnedBy { id } publishedAt pullRequest { id } repository { id } resourcePath updatedAt url viewerCanDelete viewerCanMinimize viewerCanPin viewerCanReact viewerCanUnminimize viewerCanUnpin viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "updateIssueComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateIssueCommentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "updateIssueComment"
          t: {
            req: "`reqdata`"
            res: "`body.data.updateIssueComment.issueComment`"
          }
        }
      ]
    }
  }



}