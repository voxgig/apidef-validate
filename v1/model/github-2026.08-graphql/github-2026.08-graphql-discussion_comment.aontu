# Entity: discussion_comment

main: kit: entity: discussion_comment: {

  alias: field: {}

  fields: [
    {
      name: "authorAssociation"
      req: true
      short: "Author's association with the subject of the comment."
      type: "`$STRING`"
    }
    {
      name: "body"
      req: true
      short: "The body as Markdown."
      type: "`$STRING`"
    }
    {
      name: "bodyHTML"
      req: true
      short: "The body rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "bodyText"
      req: true
      short: "The body rendered to text."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "createdViaEmail"
      req: true
      short: "Check if this comment was created via an email reply."
      type: "`$BOOLEAN`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$INTEGER`"
    }
    {
      name: "deletedAt"
      req: false
      short: "The time when this replied-to comment was deleted"
      type: "`$ANY`"
    }
    {
      name: "discussion"
      req: false
      short: "The discussion this comment was created in"
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the DiscussionComment object"
      type: "`$STRING`"
    }
    {
      name: "includesCreatedEdit"
      req: true
      short: "Check if this comment was edited and includes an edit with the creation data"
      type: "`$BOOLEAN`"
    }
    {
      name: "isAnswer"
      req: true
      short: "Has this comment been chosen as the answer of its discussion?"
      type: "`$BOOLEAN`"
    }
    {
      name: "isMinimized"
      req: true
      short: "Returns whether or not a comment has been minimized."
      type: "`$BOOLEAN`"
    }
    {
      name: "lastEditedAt"
      req: false
      short: "The moment the editor made the last edit"
      type: "`$ANY`"
    }
    {
      name: "minimizedReason"
      req: false
      short: "Returns why the comment was minimized."
      type: "`$STRING`"
    }
    {
      name: "publishedAt"
      req: false
      short: "Identifies when the comment was published at."
      type: "`$ANY`"
    }
    {
      name: "replyTo"
      req: false
      short: "The discussion comment this comment is a reply to"
      type: "`$OBJECT`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The path for this discussion comment."
      type: "`$ANY`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
    {
      name: "upvoteCount"
      req: true
      short: "Number of upvotes that this subject has received."
      type: "`$INTEGER`"
    }
    {
      name: "url"
      req: true
      short: "The URL for this discussion comment."
      type: "`$STRING`"
    }
    {
      name: "viewerCanDelete"
      req: true
      short: "Check if the current viewer can delete this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanMarkAsAnswer"
      req: true
      short: "Can the current user mark this comment as an answer?"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanMinimize"
      req: true
      short: "Check if the current viewer can minimize this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanReact"
      req: true
      short: "Can user react to this subject"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUnmarkAsAnswer"
      req: true
      short: "Can the current user unmark this comment as an answer?"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUnminimize"
      req: true
      short: "Check if the current viewer can unminimize this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUpdate"
      req: true
      short: "Check if the current viewer can update this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUpvote"
      req: true
      short: "Whether or not the current user can add or remove an upvote on this subject."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCannotUpdateReasons"
      req: true
      short: "Reasons why the current viewer can not update this comment."
      type: "`$STRING`"
    }
    {
      name: "viewerDidAuthor"
      req: true
      short: "Did the viewer author this comment."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerHasUpvoted"
      req: true
      short: "Whether or not the current user has already upvoted this subject."
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "discussion_comment"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation DiscussionCommentCreate($input: AddDiscussionCommentInput!) { addDiscussionComment(input: $input) { comment { ...DiscussionCommentFields } } } fragment DiscussionCommentFields on DiscussionComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId deletedAt discussion { id } id includesCreatedEdit isAnswer isMinimized lastEditedAt minimizedReason publishedAt replyTo { id } resourcePath updatedAt upvoteCount url viewerCanDelete viewerCanMarkAsAnswer viewerCanMinimize viewerCanReact viewerCanUnmarkAsAnswer viewerCanUnminimize viewerCanUpdate viewerCanUpvote viewerCannotUpdateReasons viewerDidAuthor viewerHasUpvoted }"
            field: "addDiscussionComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddDiscussionCommentInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "addDiscussionComment"
          transform: {
            req: "`reqdata`"
            res: "`body.data.addDiscussionComment.comment`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          graphql: {
            doc: "mutation DiscussionCommentRemove($input: DeleteDiscussionCommentInput!) { deleteDiscussionComment(input: $input) { comment { ...DiscussionCommentFields } } } fragment DiscussionCommentFields on DiscussionComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId deletedAt discussion { id } id includesCreatedEdit isAnswer isMinimized lastEditedAt minimizedReason publishedAt replyTo { id } resourcePath updatedAt upvoteCount url viewerCanDelete viewerCanMarkAsAnswer viewerCanMinimize viewerCanReact viewerCanUnmarkAsAnswer viewerCanUnminimize viewerCanUpdate viewerCanUpvote viewerCannotUpdateReasons viewerDidAuthor viewerHasUpvoted }"
            field: "deleteDiscussionComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "DeleteDiscussionCommentInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "deleteDiscussionComment"
          transform: {
            req: "`reqdata`"
            res: "`body.data.deleteDiscussionComment.comment`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          graphql: {
            doc: "mutation DiscussionCommentUpdate($input: UpdateDiscussionCommentInput!) { updateDiscussionComment(input: $input) { comment { ...DiscussionCommentFields } } } fragment DiscussionCommentFields on DiscussionComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId deletedAt discussion { id } id includesCreatedEdit isAnswer isMinimized lastEditedAt minimizedReason publishedAt replyTo { id } resourcePath updatedAt upvoteCount url viewerCanDelete viewerCanMarkAsAnswer viewerCanMinimize viewerCanReact viewerCanUnmarkAsAnswer viewerCanUnminimize viewerCanUpdate viewerCanUpvote viewerCannotUpdateReasons viewerDidAuthor viewerHasUpvoted }"
            field: "updateDiscussionComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateDiscussionCommentInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updateDiscussionComment"
          transform: {
            req: "`reqdata`"
            res: "`body.data.updateDiscussionComment.comment`"
          }
        }
      ]
    }
  }



}