# Entity: check_run

main: kit: entity: check_run: {

  alias: field: {}

  fields: [
    {
      name: "checkSuite"
      req: false
      short: "The check suite that this run is a part of."
      type: "`$OBJECT`"
    }
    {
      name: "completedAt"
      req: false
      short: "Identifies the date and time when the check run was completed."
      type: "`$ANY`"
    }
    {
      name: "conclusion"
      req: false
      short: "The conclusion of the check run."
      type: "`$STRING`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$INTEGER`"
    }
    {
      name: "deployment"
      req: false
      short: "The corresponding deployment for this job, if any"
      type: "`$OBJECT`"
    }
    {
      name: "detailsUrl"
      req: false
      short: "The URL from which to find full details of the check run on the integrator's site."
      type: "`$ANY`"
    }
    {
      name: "externalId"
      req: false
      short: "A reference for the check run on the integrator's system."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the CheckRun object"
      type: "`$STRING`"
    }
    {
      name: "isRequired"
      req: true
      short: "Whether this is required to pass before merging for a specific pull request."
      type: "`$BOOLEAN`"
    }
    {
      name: "name"
      req: true
      short: "The name of the check for this check run."
      type: "`$STRING`"
    }
    {
      name: "permalink"
      req: true
      short: "The permalink to the check run summary."
      type: "`$ANY`"
    }
    {
      name: "repository"
      req: false
      short: "The repository associated with this check run."
      type: "`$OBJECT`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this check run."
      type: "`$ANY`"
    }
    {
      name: "startedAt"
      req: false
      short: "Identifies the date and time when the check run was started."
      type: "`$ANY`"
    }
    {
      name: "status"
      req: true
      short: "The current status of the check run."
      type: "`$STRING`"
    }
    {
      name: "summary"
      req: false
      short: "A string representing the check run's summary"
      type: "`$STRING`"
    }
    {
      name: "text"
      req: false
      short: "A string representing the check run's text"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "A string representing the check run"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this check run."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "check_run"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation CheckRunCreate($input: CreateCheckRunInput!) { createCheckRun(input: $input) { checkRun { ...CheckRunFields } } } fragment CheckRunFields on CheckRun { checkSuite { id } completedAt conclusion databaseId deployment { id } detailsUrl externalId id isRequired name permalink repository { id } resourcePath startedAt status summary text title url }"
            field: "createCheckRun"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateCheckRunInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createCheckRun"
          transform: {
            req: "`reqdata`"
            res: "`body.data.createCheckRun.checkRun`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          graphql: {
            doc: "mutation CheckRunUpdate($input: UpdateCheckRunInput!) { updateCheckRun(input: $input) { checkRun { ...CheckRunFields } } } fragment CheckRunFields on CheckRun { checkSuite { id } completedAt conclusion databaseId deployment { id } detailsUrl externalId id isRequired name permalink repository { id } resourcePath startedAt status summary text title url }"
            field: "updateCheckRun"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateCheckRunInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updateCheckRun"
          transform: {
            req: "`reqdata`"
            res: "`body.data.updateCheckRun.checkRun`"
          }
        }
      ]
    }
  }



}