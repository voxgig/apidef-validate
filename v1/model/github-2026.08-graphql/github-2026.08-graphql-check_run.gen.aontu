# Entity: check_run

main: kit: entity: check_run: {

  alias: field: {}

  fields: {
    checkSuite: {
      h: "Check Suite"
      n: "checkSuite"
      r: false
      sh: "The check suite that this run is a part of."
      t: "`$OBJECT`"
    }
    completedAt: {
      h: "Completed At"
      n: "completedAt"
      r: false
      sh: "Identifies the date and time when the check run was completed."
      t: "`$ANY`"
    }
    conclusion: {
      h: "Conclusion"
      n: "conclusion"
      r: false
      sh: "The conclusion of the check run."
      t: "`$STRING`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    deployment: {
      h: "Deployment"
      n: "deployment"
      r: false
      sh: "The corresponding deployment for this job, if any"
      t: "`$OBJECT`"
    }
    detailsUrl: {
      h: "Details Url"
      n: "detailsUrl"
      r: false
      sh: "The URL from which to find full details of the check run on the integrator's site."
      t: "`$ANY`"
    }
    externalId: {
      h: "External Id"
      n: "externalId"
      r: false
      sh: "A reference for the check run on the integrator's system."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the CheckRun object"
      t: "`$STRING`"
    }
    isRequired: {
      h: "Is Required"
      n: "isRequired"
      r: true
      sh: "Whether this is required to pass before merging for a specific pull request."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the check for this check run."
      t: "`$STRING`"
    }
    permalink: {
      h: "Permalink"
      n: "permalink"
      r: true
      sh: "The permalink to the check run summary."
      t: "`$ANY`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The repository associated with this check run."
      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this check run."
      t: "`$ANY`"
    }
    startedAt: {
      h: "Started At"
      n: "startedAt"
      r: false
      sh: "Identifies the date and time when the check run was started."
      t: "`$ANY`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      sh: "The current status of the check run."
      t: "`$STRING`"
    }
    summary: {
      h: "Summary"
      n: "summary"
      r: false
      sh: "A string representing the check run's summary"
      t: "`$STRING`"
    }
    text: {
      h: "Text"
      n: "text"
      r: false
      sh: "A string representing the check run's text"
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "A string representing the check run"
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this check run."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "check_run"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST createCheckRun"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation CheckRunCreate($input: CreateCheckRunInput!) { createCheckRun(input: $input) { checkRun { ...CheckRunFields } } } fragment CheckRunFields on CheckRun { checkSuite { id } completedAt conclusion databaseId deployment { id } detailsUrl externalId id isRequired name permalink repository { id } resourcePath startedAt status summary text title url }"
            field: "createCheckRun"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateCheckRunInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createCheckRun"
          t: {
            req: "`reqdata`"
            res: "`body.data.createCheckRun.checkRun`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST updateCheckRun"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation CheckRunUpdate($input: UpdateCheckRunInput!) { updateCheckRun(input: $input) { checkRun { ...CheckRunFields } } } fragment CheckRunFields on CheckRun { checkSuite { id } completedAt conclusion databaseId deployment { id } detailsUrl externalId id isRequired name permalink repository { id } resourcePath startedAt status summary text title url }"
            field: "updateCheckRun"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateCheckRunInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "updateCheckRun"
          t: {
            req: "`reqdata`"
            res: "`body.data.updateCheckRun.checkRun`"
          }
        }
      ]
    }
  }



}