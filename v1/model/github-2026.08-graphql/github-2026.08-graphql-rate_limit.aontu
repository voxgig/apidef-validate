# Entity: rate_limit

main: kit: entity: rate_limit: {

  alias: field: {}

  fields: {
    cost: {
      h: "Cost"
      n: "cost"
      r: true
      sh: "The point cost for the current query counting against the rate limit."
      t: "`$INTEGER`"
    }
    limit: {
      h: "Limit"
      n: "limit"
      r: true
      sh: "The maximum number of points the client is permitted to consume in a 60 minute window."
      t: "`$INTEGER`"
    }
    nodeCount: {
      h: "Node Count"
      n: "nodeCount"
      r: true
      sh: "The maximum number of nodes this query may return"
      t: "`$INTEGER`"
    }
    remaining: {
      h: "Remaining"
      n: "remaining"
      r: true
      sh: "The number of points remaining in the current rate limit window."
      t: "`$INTEGER`"
    }
    resetAt: {
      h: "Reset At"
      n: "resetAt"
      r: true
      sh: "The time at which the current rate limit window resets in UTC epoch seconds."
      t: "`$ANY`"
    }
    used: {
      h: "Used"
      n: "used"
      r: true
      sh: "The number of points used in the current rate limit window."
      t: "`$INTEGER`"
    }
  }

  name: "rate_limit"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "dry_run"
                orig: "dry_run"
                reqd: false
                type: "`$BOOLEAN`"
              }
            ]
          }
          contract: {
            id: "POST rateLimit"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "query RateLimitLoad($dryRun: Boolean) { rateLimit(dryRun: $dryRun) { ...RateLimitFields } } fragment RateLimitFields on RateLimit { cost limit nodeCount remaining resetAt used }"
            field: "rateLimit"
            optype: "query"
            vars: [
              {
                from: "dryRun"
                gqltype: "Boolean"
                name: "dryRun"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "rateLimit"
          transform: {
            req: "`reqdata`"
            res: "`body.data.rateLimit`"
          }
        }
      ]
    }
  }



}