# Entity: pull_request

main: kit: entity: pull_request: {

  alias: field: {}

  fields: [
    {
      name: "activeLockReason"
      req: false
      short: "Reason that the conversation was locked."
      type: "`$STRING`"
    }
    {
      name: "additions"
      req: true
      short: "The number of additions in this pull request."
      type: "`$INTEGER`"
    }
    {
      name: "authorAssociation"
      req: true
      short: "Author's association with the subject of the comment."
      type: "`$STRING`"
    }
    {
      name: "baseRef"
      req: false
      short: "Identifies the base Ref associated with the pull request."
      type: "`$OBJECT`"
    }
    {
      name: "baseRefName"
      req: true
      short: "Identifies the name of the base Ref associated with the pull request, even if the ref has been deleted."
      type: "`$STRING`"
    }
    {
      name: "baseRefOid"
      req: true
      short: "Identifies the oid of the base ref associated with the pull request, even if the ref has been deleted."
      type: "`$ANY`"
    }
    {
      name: "baseRepository"
      req: false
      short: "The repository associated with this pull request's base Ref."
      type: "`$OBJECT`"
    }
    {
      name: "body"
      req: true
      short: "The body as Markdown."
      type: "`$STRING`"
    }
    {
      name: "bodyHTML"
      req: true
      short: "The body rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "bodyText"
      req: true
      short: "The body rendered to text."
      type: "`$STRING`"
    }
    {
      name: "canBeRebased"
      req: true
      short: "Whether or not the pull request is rebaseable."
      type: "`$BOOLEAN`"
    }
    {
      name: "changedFiles"
      req: true
      short: "The number of changed files in this pull request."
      type: "`$INTEGER`"
    }
    {
      name: "checksResourcePath"
      req: true
      short: "The HTTP path for the checks of this pull request."
      type: "`$ANY`"
    }
    {
      name: "checksUrl"
      req: true
      short: "The HTTP URL for the checks of this pull request."
      type: "`$ANY`"
    }
    {
      name: "closed"
      req: true
      short: "`true` if the pull request is closed"
      type: "`$BOOLEAN`"
    }
    {
      name: "closedAt"
      req: false
      short: "Identifies the date and time when the object was closed."
      type: "`$ANY`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "createdViaEmail"
      req: true
      short: "Check if this comment was created via an email reply."
      type: "`$BOOLEAN`"
    }
    {
      name: "deletions"
      req: true
      short: "The number of deletions in this pull request."
      type: "`$INTEGER`"
    }
    {
      name: "fullDatabaseId"
      req: false
      short: "Identifies the primary key from the database as a BigInt."
      type: "`$ANY`"
    }
    {
      name: "headRef"
      req: false
      short: "Identifies the head Ref associated with the pull request."
      type: "`$OBJECT`"
    }
    {
      name: "headRefName"
      req: true
      short: "Identifies the name of the head Ref associated with the pull request, even if the ref has been deleted."
      type: "`$STRING`"
    }
    {
      name: "headRefOid"
      req: true
      short: "Identifies the oid of the head ref associated with the pull request, even if the ref has been deleted."
      type: "`$ANY`"
    }
    {
      name: "headRepository"
      req: false
      short: "The repository associated with this pull request's head Ref."
      type: "`$OBJECT`"
    }
    {
      name: "headRepositoryOwner"
      req: false
      short: "The owner of the repository associated with this pull request's head Ref."
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the PullRequest object"
      type: "`$STRING`"
    }
    {
      name: "includesCreatedEdit"
      req: true
      short: "Check if this comment was edited and includes an edit with the creation data"
      type: "`$BOOLEAN`"
    }
    {
      name: "isCrossRepository"
      req: true
      short: "The head and base repositories are different."
      type: "`$BOOLEAN`"
    }
    {
      name: "isDraft"
      req: true
      short: "Identifies if the pull request is a draft."
      type: "`$BOOLEAN`"
    }
    {
      name: "isInMergeQueue"
      req: true
      short: "Indicates whether the pull request is in a merge queue"
      type: "`$BOOLEAN`"
    }
    {
      name: "isMergeQueueEnabled"
      req: true
      short: "Indicates whether the pull request's base ref has a merge queue enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "isReadByViewer"
      req: false
      short: "Is this pull request read by the viewer"
      type: "`$BOOLEAN`"
    }
    {
      name: "lastEditedAt"
      req: false
      short: "The moment the editor made the last edit"
      type: "`$ANY`"
    }
    {
      name: "locked"
      req: true
      short: "`true` if the pull request is locked"
      type: "`$BOOLEAN`"
    }
    {
      name: "maintainerCanModify"
      req: true
      short: "Indicates whether maintainers can modify the pull request."
      type: "`$BOOLEAN`"
    }
    {
      name: "mergeCommit"
      req: false
      short: "The commit that was created when this pull request was merged."
      type: "`$OBJECT`"
    }
    {
      name: "mergeQueue"
      req: false
      short: "The merge queue for the pull request's base branch"
      type: "`$OBJECT`"
    }
    {
      name: "mergeQueueEntry"
      req: false
      short: "The merge queue entry of the pull request in the base branch's merge queue"
      type: "`$OBJECT`"
    }
    {
      name: "mergeStateStatus"
      req: true
      short: "Detailed information about the current pull request merge state status."
      type: "`$STRING`"
    }
    {
      name: "mergeable"
      req: true
      short: "Whether or not the pull request can be merged based on the existence of merge conflicts."
      type: "`$STRING`"
    }
    {
      name: "merged"
      req: true
      short: "Whether or not the pull request was merged."
      type: "`$BOOLEAN`"
    }
    {
      name: "mergedAt"
      req: false
      short: "The date and time that the pull request was merged."
      type: "`$ANY`"
    }
    {
      name: "milestone"
      req: false
      short: "Identifies the milestone associated with the pull request."
      type: "`$OBJECT`"
    }
    {
      name: "number"
      req: true
      short: "Identifies the pull request number."
      type: "`$INTEGER`"
    }
    {
      name: "permalink"
      req: true
      short: "The permalink to the pull request."
      type: "`$ANY`"
    }
    {
      name: "potentialMergeCommit"
      req: false
      short: "The commit that GitHub automatically generated to test if this pull request could be merged."
      type: "`$OBJECT`"
    }
    {
      name: "publishedAt"
      req: false
      short: "Identifies when the comment was published at."
      type: "`$ANY`"
    }
    {
      name: "repository"
      req: false
      short: "The repository associated with this node."
      type: "`$OBJECT`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this pull request."
      type: "`$ANY`"
    }
    {
      name: "revertResourcePath"
      req: true
      short: "The HTTP path for reverting this pull request."
      type: "`$ANY`"
    }
    {
      name: "revertUrl"
      req: true
      short: "The HTTP URL for reverting this pull request."
      type: "`$ANY`"
    }
    {
      name: "reviewDecision"
      req: false
      short: "The current status of this pull request with respect to code review."
      type: "`$STRING`"
    }
    {
      name: "stack"
      req: false
      short: "The stack this Pull Request belongs to, or null if it is not part of a stack"
      type: "`$OBJECT`"
    }
    {
      name: "stackEntry"
      req: false
      short: "The stack entry for this Pull Request, or null if it is not part of a stack"
      type: "`$OBJECT`"
    }
    {
      name: "state"
      req: true
      short: "Identifies the state of the pull request."
      type: "`$STRING`"
    }
    {
      name: "statusCheckRollup"
      req: false
      short: "Check and Status rollup information for the PR's head ref."
      type: "`$OBJECT`"
    }
    {
      name: "title"
      req: true
      short: "Identifies the pull request title."
      type: "`$STRING`"
    }
    {
      name: "titleHTML"
      req: true
      short: "Identifies the pull request title rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "totalCommentsCount"
      req: false
      short: "Returns a count of how many comments this pull request has received."
      type: "`$INTEGER`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this pull request."
      type: "`$STRING`"
    }
    {
      name: "viewerCanApplySuggestion"
      req: true
      short: "Whether or not the viewer can apply suggestion."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanAssign"
      req: true
      short: "Indicates if the viewer can edit assignees for this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanClose"
      req: true
      short: "Indicates if the object can be closed by the viewer."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanDeleteHeadRef"
      req: true
      short: "Check if the viewer can restore the deleted head ref."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanDisableAutoMerge"
      req: true
      short: "Whether or not the viewer can disable auto-merge"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanEditFiles"
      req: true
      short: "Can the viewer edit files within this pull request."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanEnableAutoMerge"
      req: true
      short: "Whether or not the viewer can enable auto-merge"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanLabel"
      req: true
      short: "Indicates if the viewer can edit labels for this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanMergeAsAdmin"
      req: true
      short: "Indicates whether the viewer can bypass branch protections and merge the pull request immediately"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanReact"
      req: true
      short: "Can user react to this subject"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanReopen"
      req: true
      short: "Indicates if the object can be reopened by the viewer."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanSubscribe"
      req: true
      short: "Check if the viewer is able to change their subscription status for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUpdate"
      req: true
      short: "Check if the current viewer can update this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUpdateBranch"
      req: true
      short: "Whether or not the viewer can update the head ref of this PR, by merging or rebasing the base ref."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCannotUpdateReasons"
      req: true
      short: "Reasons why the current viewer can not update this comment."
      type: "`$STRING`"
    }
    {
      name: "viewerDidAuthor"
      req: true
      short: "Did the viewer author this comment."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerLatestReview"
      req: false
      short: "The latest review given from the viewer."
      type: "`$OBJECT`"
    }
    {
      name: "viewerLatestReviewRequest"
      req: false
      short: "The person who has requested the viewer for review on this pull request."
      type: "`$OBJECT`"
    }
    {
      name: "viewerMergeBodyText"
      req: true
      short: "The merge body text for the viewer and method."
      type: "`$STRING`"
    }
    {
      name: "viewerMergeHeadlineText"
      req: true
      short: "The merge headline text for the viewer and method."
      type: "`$STRING`"
    }
    {
      name: "viewerSubscription"
      req: false
      short: "Identifies if the viewer is watching, not watching, or ignoring the subscribable entity."
      type: "`$STRING`"
    }
  ]

