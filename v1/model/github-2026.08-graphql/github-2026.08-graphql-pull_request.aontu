          kind: "graphql"
          method: "POST"
          orig: "disablePullRequestAutoMerge"
          select: {
            "$action": "disable_pull_request_auto_merge"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.disablePullRequestAutoMerge.pullRequest`"
          }
        }
        {
          graphql: {
            doc: "mutation PullRequestCreateEnablePullRequestAutoMerge($input: EnablePullRequestAutoMergeInput!) { enablePullRequestAutoMerge(input: $input) { pullRequest { ...PullRequestFields } } } fragment PullRequestFields on PullRequest { activeLockReason additions authorAssociation baseRef { id } baseRefName baseRefOid baseRepository { id } body bodyHTML bodyText canBeRebased changedFiles checksResourcePath checksUrl closed closedAt createdAt createdViaEmail deletions fullDatabaseId headRef { id } headRefName headRefOid headRepository { id } headRepositoryOwner { id } id includesCreatedEdit isCrossRepository isDraft isInMergeQueue isMergeQueueEnabled isReadByViewer lastEditedAt locked maintainerCanModify mergeCommit { id } mergeQueue { id } mergeQueueEntry { id } mergeStateStatus mergeable merged mergedAt milestone { id } number permalink potentialMergeCommit { id } publishedAt repository { id } resourcePath revertResourcePath revertUrl reviewDecision stack { id } stackEntry { id } state statusCheckRollup { id } title titleHTML totalCommentsCount updatedAt url viewerCanApplySuggestion viewerCanAssign viewerCanClose viewerCanDeleteHeadRef viewerCanDisableAutoMerge viewerCanEditFiles viewerCanEnableAutoMerge viewerCanLabel viewerCanMergeAsAdmin viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpdateBranch viewerCannotUpdateReasons viewerDidAuthor viewerLatestReview { id } viewerLatestReviewRequest { id } viewerMergeBodyText viewerMergeHeadlineText viewerSubscription }"
            field: "enablePullRequestAutoMerge"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "EnablePullRequestAutoMergeInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "enablePullRequestAutoMerge"
          select: {
            "$action": "enable_pull_request_auto_merge"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.enablePullRequestAutoMerge.pullRequest`"
          }
        }
        {
          graphql: {
            doc: "mutation PullRequestCreateMarkFileAsViewed($input: MarkFileAsViewedInput!) { markFileAsViewed(input: $input) { pullRequest { ...PullRequestFields } } } fragment PullRequestFields on PullRequest { activeLockReason additions authorAssociation baseRef { id } baseRefName baseRefOid baseRepository { id } body bodyHTML bodyText canBeRebased changedFiles checksResourcePath checksUrl closed closedAt createdAt createdViaEmail deletions fullDatabaseId headRef { id } headRefName headRefOid headRepository { id } headRepositoryOwner { id } id includesCreatedEdit isCrossRepository isDraft isInMergeQueue isMergeQueueEnabled isReadByViewer lastEditedAt locked maintainerCanModify mergeCommit { id } mergeQueue { id } mergeQueueEntry { id } mergeStateStatus mergeable merged mergedAt milestone { id } number permalink potentialMergeCommit { id } publishedAt repository { id } resourcePath revertResourcePath revertUrl reviewDecision stack { id } stackEntry { id } state statusCheckRollup { id } title titleHTML totalCommentsCount updatedAt url viewerCanApplySuggestion viewerCanAssign viewerCanClose viewerCanDeleteHeadRef viewerCanDisableAutoMerge viewerCanEditFiles viewerCanEnableAutoMerge viewerCanLabel viewerCanMergeAsAdmin viewerCanReact viewerCanReopen viewerCanSubscribe viewerCanUpdate viewerCanUpdateBranch viewerCannotUpdateReasons viewerDidAuthor viewerLatestReview { id } viewerLatestReviewRequest { id } viewerMergeBodyText viewerMergeHeadlineText viewerSubscription }"
            field: "markFileAsViewed"
