# Entity: commit

main: kit: entity: commit: {

  alias: field: {}

  fields: [
    {
      name: "abbreviatedOid"
      req: true
      short: "An abbreviated version of the Git object ID"
      type: "`$STRING`"
    }
    {
      name: "additions"
      req: true
      short: "The number of additions in this commit."
      type: "`$INTEGER`"
    }
    {
      name: "authoredByCommitter"
      req: true
      short: "Check if the committer and the author match."
      type: "`$BOOLEAN`"
    }
    {
      name: "authoredDate"
      req: true
      short: "The datetime when this commit was authored."
      type: "`$ANY`"
    }
    {
      name: "changedFilesIfAvailable"
      req: false
      short: "The number of changed files in this commit."
      type: "`$INTEGER`"
    }
    {
      name: "commitResourcePath"
      req: true
      short: "The HTTP path for this Git object"
      type: "`$ANY`"
    }
    {
      name: "commitUrl"
      req: true
      short: "The HTTP URL for this Git object"
      type: "`$ANY`"
    }
    {
      name: "committedDate"
      req: true
      short: "The datetime when this commit was committed."
      type: "`$ANY`"
    }
    {
      name: "committedViaWeb"
      req: true
      short: "Check if committed via GitHub web UI."
      type: "`$BOOLEAN`"
    }
    {
      name: "deletions"
      req: true
      short: "The number of deletions in this commit."
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the Commit object"
      type: "`$STRING`"
    }
    {
      name: "message"
      req: true
      short: "The Git commit message"
      type: "`$STRING`"
    }
    {
      name: "messageBody"
      req: true
      short: "The Git commit message body"
      type: "`$STRING`"
    }
    {
      name: "messageBodyHTML"
      req: true
      short: "The commit message body rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "messageHeadline"
      req: true
      short: "The Git commit message headline"
      type: "`$STRING`"
    }
    {
      name: "messageHeadlineHTML"
      req: true
      short: "The commit message headline rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "oid"
      req: true
      short: "The Git object ID"
      type: "`$ANY`"
    }
    {
      name: "onBehalfOf"
      req: false
      short: "The organization this commit was made on behalf of."
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
      short: "The Repository this commit belongs to"
      type: "`$OBJECT`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this commit"
      type: "`$ANY`"
    }
    {
      name: "status"
      req: false
      short: "Status information for this commit"
      type: "`$OBJECT`"
    }
    {
      name: "statusCheckRollup"
      req: false
      short: "Check and Status rollup information for this commit."
      type: "`$OBJECT`"
    }
    {
      name: "tarballUrl"
      req: true
      short: "Returns a URL to download a tarball archive for a repository."
      type: "`$ANY`"
    }
    {
      name: "tree"
      req: false
      short: "Commit's root Tree"
      type: "`$OBJECT`"
    }
    {
      name: "treeResourcePath"
      req: true
      short: "The HTTP path for the tree of this commit"
      type: "`$ANY`"
    }
    {
      name: "treeUrl"
      req: true
      short: "The HTTP URL for the tree of this commit"
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this commit"
      type: "`$STRING`"
    }
    {
      name: "viewerCanSubscribe"
      req: true
      short: "Check if the viewer is able to change their subscription status for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerSubscription"
      req: false
      short: "Identifies if the viewer is watching, not watching, or ignoring the subscribable entity."
      type: "`$STRING`"
    }
    {
      name: "zipballUrl"
      req: true
      short: "Returns a URL to download a zipball archive for a repository."
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation CommitCreateCreateCommitOnBranch($input: CreateCommitOnBranchInput!) { createCommitOnBranch(input: $input) { commit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }"
            field: "createCommitOnBranch"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateCommitOnBranchInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createCommitOnBranch"
          select: {
            "$action": "create_commit_on_branch"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.createCommitOnBranch.commit`"
          }
        }
        {
          graphql: {
            doc: "mutation CommitCreateMergeBranch($input: MergeBranchInput!) { mergeBranch(input: $input) { mergeCommit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }"
            field: "mergeBranch"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "MergeBranchInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "mergeBranch"
          select: {
            "$action": "merge_branch"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.mergeBranch.mergeCommit`"
          }
        }
      ]
    }
  }



}