# Entity: commit

main: kit: entity: commit: {

  alias: field: {}

  fields: {
    abbreviatedOid: {
      h: "Abbreviated Oid"
      n: "abbreviatedOid"
      r: true
      sh: "An abbreviated version of the Git object ID"
      t: "`$STRING`"
    }
    additions: {
      h: "Additions"
      n: "additions"
      r: true
      sh: "The number of additions in this commit."
      t: "`$INTEGER`"
    }
    authoredByCommitter: {
      h: "Authored By Committer"
      n: "authoredByCommitter"
      r: true
      sh: "Check if the committer and the author match."
      t: "`$BOOLEAN`"
    }
    authoredDate: {
      h: "Authored Date"
      n: "authoredDate"
      r: true
      sh: "The datetime when this commit was authored."
      t: "`$ANY`"
    }
    changedFilesIfAvailable: {
      h: "Changed Files If Available"
      n: "changedFilesIfAvailable"
      r: false
      sh: "The number of changed files in this commit."
      t: "`$INTEGER`"
    }
    commitResourcePath: {
      h: "Commit Resource Path"
      n: "commitResourcePath"
      r: true
      sh: "The HTTP path for this Git object"
      t: "`$ANY`"
    }
    commitUrl: {
      h: "Commit Url"
      n: "commitUrl"
      r: true
      sh: "The HTTP URL for this Git object"
      t: "`$ANY`"
    }
    committedDate: {
      h: "Committed Date"
      n: "committedDate"
      r: true
      sh: "The datetime when this commit was committed."
      t: "`$ANY`"
    }
    committedViaWeb: {
      h: "Committed Via Web"
      n: "committedViaWeb"
      r: true
      sh: "Check if committed via GitHub web UI."
      t: "`$BOOLEAN`"
    }
    deletions: {
      h: "Deletions"
      n: "deletions"
      r: true
      sh: "The number of deletions in this commit."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Commit object"
      t: "`$STRING`"
    }
    message: {
      h: "Message"
      n: "message"
      r: true
      sh: "The Git commit message"
      t: "`$STRING`"
    }
    messageBody: {
      h: "Message Body"
      n: "messageBody"
      r: true
      sh: "The Git commit message body"
      t: "`$STRING`"
    }
    messageBodyHTML: {
      h: "Message Body Html"
      n: "messageBodyHTML"
      r: true
      sh: "The commit message body rendered to HTML."
      t: "`$ANY`"
    }
    messageHeadline: {
      h: "Message Headline"
      n: "messageHeadline"
      r: true
      sh: "The Git commit message headline"
      t: "`$STRING`"
    }
    messageHeadlineHTML: {
      h: "Message Headline Html"
      n: "messageHeadlineHTML"
      r: true
      sh: "The commit message headline rendered to HTML."
      t: "`$ANY`"
    }
    oid: {
      h: "Oid"
      n: "oid"
      r: true
      sh: "The Git object ID"
      t: "`$ANY`"
    }
    onBehalfOf: {
      h: "On Behalf Of"
      n: "onBehalfOf"
      r: false
      sh: "The organization this commit was made on behalf of."
      t: "`$OBJECT`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The Repository this commit belongs to"
      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this commit"
      t: "`$ANY`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "Status information for this commit"
      t: "`$OBJECT`"
    }
    statusCheckRollup: {
      h: "Status Check Rollup"
      n: "statusCheckRollup"
      r: false
      sh: "Check and Status rollup information for this commit."
      t: "`$OBJECT`"
    }
    tarballUrl: {
      h: "Tarball Url"
      n: "tarballUrl"
      r: true
      sh: "Returns a URL to download a tarball archive for a repository."
      t: "`$ANY`"
    }
    tree: {
      h: "Tree"
      n: "tree"
      r: false
      sh: "Commit's root Tree"
      t: "`$OBJECT`"
    }
    treeResourcePath: {
      h: "Tree Resource Path"
      n: "treeResourcePath"
      r: true
      sh: "The HTTP path for the tree of this commit"
      t: "`$ANY`"
    }
    treeUrl: {
      h: "Tree Url"
      n: "treeUrl"
      r: true
      sh: "The HTTP URL for the tree of this commit"
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this commit"
      t: "`$STRING`"
    }
    viewerCanSubscribe: {
      h: "Viewer Can Subscribe"
      n: "viewerCanSubscribe"
      r: true
      sh: "Check if the viewer is able to change their subscription status for the repository."
      t: "`$BOOLEAN`"
    }
    viewerSubscription: {
      h: "Viewer Subscription"
      n: "viewerSubscription"
      r: false
      sh: "Identifies if the viewer is watching, not watching, or ignoring the subscribable entity."
      t: "`$STRING`"
    }
    zipballUrl: {
      h: "Zipball Url"
      n: "zipballUrl"
      r: true
      sh: "Returns a URL to download a zipball archive for a repository."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST createCommitOnBranch"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation CommitCreateCreateCommitOnBranch($input: CreateCommitOnBranchInput!) { createCommitOnBranch(input: $input) { commit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }"
            field: "createCommitOnBranch"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateCommitOnBranchInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createCommitOnBranch"
          q: {
            "$action": "create_commit_on_branch"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.createCommitOnBranch.commit`"
          }
        }
        {
          co: {
            id: "POST mergeBranch"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation CommitCreateMergeBranch($input: MergeBranchInput!) { mergeBranch(input: $input) { mergeCommit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }"
            field: "mergeBranch"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "MergeBranchInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "mergeBranch"
          q: {
            "$action": "merge_branch"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.mergeBranch.mergeCommit`"
          }
        }
      ]
    }
  }



}