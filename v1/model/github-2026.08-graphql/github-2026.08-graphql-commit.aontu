# Entity: commit

main: kit: entity: commit: {

  alias: field: {}

  fields: [
    {
      name: "abbreviated_oid"
      req: true
      type: "`$STRING`"
    }
    {
      name: "addition"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "authored_by_committer"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "authored_date"
      req: true
      type: "`$ANY`"
    }
    {
      name: "changed_files_if_available"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "commit_resource_path"
      req: true
      type: "`$ANY`"
    }
    {
      name: "commit_url"
      req: true
      type: "`$ANY`"
    }
    {
      name: "committed_date"
      req: true
      type: "`$ANY`"
    }
    {
      name: "committed_via_web"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "deletion"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "message"
      req: true
      type: "`$STRING`"
    }
    {
      name: "message_body"
      req: true
      type: "`$STRING`"
    }
    {
      name: "message_body_html"
      req: true
      type: "`$ANY`"
    }
    {
      name: "message_headline"
      req: true
      type: "`$STRING`"
    }
    {
      name: "message_headline_html"
      req: true
      type: "`$ANY`"
    }
    {
      name: "oid"
      req: true
      type: "`$ANY`"
    }
    {
      name: "on_behalf_of"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "resource_path"
      req: true
      type: "`$ANY`"
    }
    {
      name: "status"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "status_check_rollup"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "tarball_url"
      req: true
      type: "`$ANY`"
    }
    {
      name: "tree"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "tree_resource_path"
      req: true
      type: "`$ANY`"
    }
    {
      name: "tree_url"
      req: true
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "viewer_can_subscribe"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "viewer_subscription"
      req: false
      type: "`$STRING`"
    }
    {
      name: "zipball_url"
      req: true
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation CommitCreateCreateCommitOnBranch($input: CreateCommitOnBranchInput!) { createCommitOnBranch(input: $input) { commit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }"
            field: "createCommitOnBranch"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateCommitOnBranchInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createCommitOnBranch"
          select: {
            "$action": "create_commit_on_branch"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.createCommitOnBranch.commit`"
          }
        }
        {
          graphql: {
            doc: "mutation CommitCreateMergeBranch($input: MergeBranchInput!) { mergeBranch(input: $input) { mergeCommit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }"
            field: "mergeBranch"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "MergeBranchInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "mergeBranch"
          select: {
            "$action": "merge_branch"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.mergeBranch.mergeCommit`"
          }
        }
      ]
    }
  }



}
