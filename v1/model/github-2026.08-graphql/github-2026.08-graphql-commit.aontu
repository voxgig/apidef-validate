# Entity: commit

main: kit: entity: commit: {

  alias: field: {}

  fields: [
    {
      name: "abbreviatedOid"
      req: true
      short: "An abbreviated version of the Git object ID"
      type: "`$STRING`"
    }
    {
      name: "additions"
      req: true
      short: "The number of additions in this commit."
      type: "`$INTEGER`"
    }
    {
      name: "authoredByCommitter"
      req: true
      short: "Check if the committer and the author match."
      type: "`$BOOLEAN`"
    }
    {
      name: "authoredDate"
      req: true
      short: "The datetime when this commit was authored."
      type: "`$ANY`"
    }
    {
      name: "changedFilesIfAvailable"
      req: false
      short: "The number of changed files in this commit."
      type: "`$INTEGER`"
    }
    {
      name: "commitResourcePath"
      req: true
      short: "The HTTP path for this Git object"
      type: "`$ANY`"
    }
    {
      name: "commitUrl"
      req: true
      short: "The HTTP URL for this Git object"
      type: "`$ANY`"
    }
    {
      name: "committedDate"
      req: true
      short: "The datetime when this commit was committed."
      type: "`$ANY`"
    }
    {
      name: "committedViaWeb"
      req: true
      short: "Check if committed via GitHub web UI."
      type: "`$BOOLEAN`"
    }
    {
      name: "deletions"
      req: true
      short: "The number of deletions in this commit."
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the Commit object"
      type: "`$STRING`"
    }
    {
      name: "message"
      req: true
      short: "The Git commit message"
      type: "`$STRING`"
    }
    {
      name: "messageBody"
      req: true
      short: "The Git commit message body"
      type: "`$STRING`"
    }
    {
      name: "messageBodyHTML"
      req: true
      short: "The commit message body rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "messageHeadline"
      req: true
      short: "The Git commit message headline"
      type: "`$STRING`"
    }
    {
      name: "messageHeadlineHTML"
      req: true
      short: "The commit message headline rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "oid"
      req: true
      short: "The Git object ID"
      type: "`$ANY`"
    }
    {
      name: "onBehalfOf"
      req: false
      short: "The organization this commit was made on behalf of."
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
      short: "The Repository this commit belongs to"
      type: "`$OBJECT`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this commit"
      type: "`$ANY`"
    }
    {
      name: "status"
      req: false
      short: "Status information for this commit"
      type: "`$OBJECT`"
    }
    {
      name: "statusCheckRollup"
      req: false
      short: "Check and Status rollup information for this commit."
      type: "`$OBJECT`"
    }
    {
      name: "tarballUrl"
      req: true
      short: "Returns a URL to download a tarball archive for a repository."
      type: "`$ANY`"
    }
    {
      name: "tree"
      req: false
      short: "Commit's root Tree"
      type: "`$OBJECT`"
    }
    {
      name: "treeResourcePath"
      req: true
      short: "The HTTP path for the tree of this commit"
      type: "`$ANY`"
    }
    {
      name: "treeUrl"
      req: true
      short: "The HTTP URL for the tree of this commit"
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this commit"
      type: "`$STRING`"
    }
    {
      name: "viewerCanSubscribe"
      req: true
      short: "Check if the viewer is able to change their subscription status for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerSubscription"
      req: false
      short: "Identifies if the viewer is watching, not watching, or ignoring the subscribable entity."
      type: "`$STRING`"
    }
    {
      name: "zipballUrl"
      req: true
      short: "Returns a URL to download a zipball archive for a repository."
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST createCommitOnBranch"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"CreateCommitOnBranchInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"CreateCommitOnBranchInput\"}],\"deprecated\":false,\"desc\":\"Appends a commit to the given branch as the authenticated user.\\n\\nThis mutation creates a commit whose parent is the HEAD of the provided\\nbranch and also updates that branch to point to the new commit.\\nIt can be thought of as similar to `git commit`.\\n\\n### Locating a Branch\\n\\nCommits are appended to a `branch` of type `Ref`.\\nThis must refer to a git branch (i.e.  the fully qualified path must\\nbegin with `refs/heads/`, although including this prefix is optional.\\n\\nCallers may specify the `branch` to commit to either by its global node\\nID or by passing both of `repositoryNameWithOwner` and `refName`.  For\\nmore details see the documentation for `CommittableBranch`.\\n\\n### Describing Changes\\n\\n`fileChanges` are specified as a `FilesChanges` object describing\\n`FileAdditions` and `FileDeletions`.\\n\\nPlease see the documentation for `FileChanges` for more information on\\nhow to use this argument to describe any set of file changes.\\n\\n### Authorship\\n\\nSimilar to the web commit interface, this mutation does not support\\nspecifying the author or committer of the commit and will not add\\nsupport for this in the future.\\n\\nA commit created by a successful execution of this mutation will be\\nauthored by the owner of the credential which authenticates the API\\nrequest.  The committer will be identical to that of commits authored\\nusing the web interface.\\n\\nIf you need full control over author and committer information, please\\nuse the Git Database REST API instead.\\n\\n### Commit Signing\\n\\nCommits made using this mutation are automatically signed by GitHub if\\nsupported and will be marked as verified in the user interface.\",\"gqltype\":\"CreateCommitOnBranchPayload\",\"list\":false,\"name\":\"createCommitOnBranch\",\"reqd\":false,\"type\":\"CreateCommitOnBranchPayload\"},\"invocation\":{\"doc\":\"mutation CommitCreateCreateCommitOnBranch($input: CreateCommitOnBranchInput!) { createCommitOnBranch(input: $input) { commit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }\",\"field\":\"createCommitOnBranch\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"CreateCommitOnBranchInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"Base64String\":{\"desc\":\"A (potentially binary) string encoded using base64.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Base64String\"},\"CommitMessage\":{\"desc\":\"A message to include with a new commit\",\"fields\":{\"body\":{\"args\":[],\"deprecated\":false,\"desc\":\"The body of the message.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"body\",\"reqd\":false,\"type\":\"String\"},\"headline\":{\"args\":[],\"deprecated\":false,\"desc\":\"The headline of the message.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"headline\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CommitMessage\"},\"CommittableBranch\":{\"desc\":\"A git ref for a commit to be appended to.\\n\\nThe ref must be a branch, i.e. its fully qualified name must start\\nwith `refs/heads/` (although the input is not required to be fully\\nqualified).\\n\\nThe Ref may be specified by its global node ID or by the\\n`repositoryNameWithOwner` and `branchName`.\\n\\n### Examples\\n\\nSpecify a branch using a global node ID:\\n\\n    { \\\"id\\\": \\\"MDM6UmVmMTpyZWZzL2hlYWRzL21haW4=\\\" }\\n\\nSpecify a branch using `repositoryNameWithOwner` and `branchName`:\\n\\n    {\\n      \\\"repositoryNameWithOwner\\\": \\\"github/graphql-client\\\",\\n      \\\"branchName\\\": \\\"main\\\"\\n    }\",\"fields\":{\"branchName\":{\"args\":[],\"deprecated\":false,\"desc\":\"The unqualified name of the branch to append the commit to.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"branchName\",\"reqd\":false,\"type\":\"String\"},\"id\":{\"args\":[],\"deprecated\":false,\"desc\":\"The Node ID of the Ref to be updated.\",\"gqltype\":\"ID\",\"list\":false,\"name\":\"id\",\"reqd\":false,\"type\":\"ID\"},\"repositoryNameWithOwner\":{\"args\":[],\"deprecated\":false,\"desc\":\"The nameWithOwner of the repository to commit to.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"repositoryNameWithOwner\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CommittableBranch\"},\"CreateCommitOnBranchInput\":{\"desc\":\"Autogenerated input type of CreateCommitOnBranch\",\"fields\":{\"branch\":{\"args\":[],\"deprecated\":false,\"desc\":\"The Ref to be updated.  Must be a branch.\",\"gqltype\":\"CommittableBranch!\",\"list\":false,\"name\":\"branch\",\"reqd\":true,\"type\":\"CommittableBranch\"},\"clientMutationId\":{\"args\":[],\"deprecated\":false,\"desc\":\"A unique identifier for the client performing the mutation.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"clientMutationId\",\"reqd\":false,\"type\":\"String\"},\"expectedHeadOid\":{\"args\":[],\"deprecated\":false,\"desc\":\"The git commit oid expected at the head of the branch prior to the commit\",\"gqltype\":\"GitObjectID!\",\"list\":false,\"name\":\"expectedHeadOid\",\"reqd\":true,\"type\":\"GitObjectID\"},\"fileChanges\":{\"args\":[],\"deprecated\":false,\"desc\":\"A description of changes to files in this commit.\",\"gqltype\":\"FileChanges\",\"list\":false,\"name\":\"fileChanges\",\"reqd\":false,\"type\":\"FileChanges\"},\"message\":{\"args\":[],\"deprecated\":false,\"desc\":\"The commit message the be included with the commit.\",\"gqltype\":\"CommitMessage!\",\"list\":false,\"name\":\"message\",\"reqd\":true,\"type\":\"CommitMessage\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"CreateCommitOnBranchInput\"},\"FileAddition\":{\"desc\":\"A command to add a file at the given path with the given contents as part of a\\ncommit.  Any existing file at that that path will be replaced.\",\"fields\":{\"contents\":{\"args\":[],\"deprecated\":false,\"desc\":\"The base64 encoded contents of the file\",\"gqltype\":\"Base64String!\",\"list\":false,\"name\":\"contents\",\"reqd\":true,\"type\":\"Base64String\"},\"path\":{\"args\":[],\"deprecated\":false,\"desc\":\"The path in the repository where the file will be located\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"path\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"FileAddition\"},\"FileChanges\":{\"desc\":\"A description of a set of changes to a file tree to be made as part of\\na git commit, modeled as zero or more file `additions` and zero or more\\nfile `deletions`.\\n\\nBoth fields are optional; omitting both will produce a commit with no\\nfile changes.\\n\\n`deletions` and `additions` describe changes to files identified\\nby their path in the git tree using unix-style path separators, i.e.\\n`/`.  The root of a git tree is an empty string, so paths are not\\nslash-prefixed.\\n\\n`path` values must be unique across all `additions` and `deletions`\\nprovided.  Any duplication will result in a validation error.\\n\\n### Encoding\\n\\nFile contents must be provided in full for each `FileAddition`.\\n\\nThe `contents` of a `FileAddition` must be encoded using RFC 4648\\ncompliant base64, i.e. correct padding is required and no characters\\noutside the standard alphabet may be used.  Invalid base64\\nencoding will be rejected with a validation error.\\n\\nThe encoded contents may be binary.\\n\\nFor text files, no assumptions are made about the character encoding of\\nthe file contents (after base64 decoding).  No charset transcoding or\\nline-ending normalization will be performed; it is the client's\\nresponsibility to manage the character encoding of files they provide.\\nHowever, for maximum compatibility we recommend using UTF-8 encoding\\nand ensuring that all files in a repository use a consistent\\nline-ending convention (`\\\\n` or `\\\\r\\\\n`), and that all files end\\nwith a newline.\\n\\n### Modeling file changes\\n\\nEach of the the five types of conceptual changes that can be made in a\\ngit commit can be described using the `FileChanges` type as follows:\\n\\n1. New file addition: create file `hello world\\\\n` at path `docs/README.txt`:\\n\\n       {\\n         \\\"additions\\\" [\\n           {\\n             \\\"path\\\": \\\"docs/README.txt\\\",\\n             \\\"contents\\\": base64encode(\\\"hello world\\\\n\\\")\\n           }\\n         ]\\n       }\\n\\n2. Existing file modification: change existing `docs/README.txt` to have new\\n   content `new content here\\\\n`:\\n\\n       {\\n         \\\"additions\\\" [\\n           {\\n             \\\"path\\\": \\\"docs/README.txt\\\",\\n             \\\"contents\\\": base64encode(\\\"new content here\\\\n\\\")\\n           }\\n         ]\\n       }\\n\\n3. Existing file deletion: remove existing file `docs/README.txt`.\\n   Note that the path is required to exist -- specifying a\\n   path that does not exist on the given branch will abort the\\n   commit and return an error.\\n\\n       {\\n         \\\"deletions\\\" [\\n           {\\n             \\\"path\\\": \\\"docs/README.txt\\\"\\n           }\\n         ]\\n       }\\n\\n\\n4. File rename with no changes: rename `docs/README.txt` with\\n   previous content `hello world\\\\n` to the same content at\\n   `newdocs/README.txt`:\\n\\n       {\\n         \\\"deletions\\\" [\\n           {\\n             \\\"path\\\": \\\"docs/README.txt\\\",\\n           }\\n         ],\\n         \\\"additions\\\" [\\n           {\\n             \\\"path\\\": \\\"newdocs/README.txt\\\",\\n             \\\"contents\\\": base64encode(\\\"hello world\\\\n\\\")\\n           }\\n         ]\\n       }\\n\\n\\n5. File rename with changes: rename `docs/README.txt` with\\n   previous content `hello world\\\\n` to a file at path\\n   `newdocs/README.txt` with content `new contents\\\\n`:\\n\\n       {\\n         \\\"deletions\\\" [\\n           {\\n             \\\"path\\\": \\\"docs/README.txt\\\",\\n           }\\n         ],\\n         \\\"additions\\\" [\\n           {\\n             \\\"path\\\": \\\"newdocs/README.txt\\\",\\n             \\\"contents\\\": base64encode(\\\"new contents\\\\n\\\")\\n           }\\n         ]\\n       }\",\"fields\":{\"additions\":{\"args\":[],\"deprecated\":false,\"desc\":\"File to add or change.\",\"gqltype\":\"[FileAddition!]\",\"list\":true,\"name\":\"additions\",\"reqd\":false,\"type\":\"FileAddition\"},\"deletions\":{\"args\":[],\"deprecated\":false,\"desc\":\"Files to delete.\",\"gqltype\":\"[FileDeletion!]\",\"list\":true,\"name\":\"deletions\",\"reqd\":false,\"type\":\"FileDeletion\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"FileChanges\"},\"FileDeletion\":{\"desc\":\"A command to delete the file at the given path as part of a commit.\",\"fields\":{\"path\":{\"args\":[],\"deprecated\":false,\"desc\":\"The path to delete\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"path\",\"reqd\":true,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"FileDeletion\"},\"GitObjectID\":{\"desc\":\"A Git object ID.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"GitObjectID\"},\"ID\":{\"desc\":\"The `ID` scalar type represents a unique identifier, often used to refetch an object or as key for a cache. The ID type appears in a JSON response as a String; however, it is not intended to be human-readable. When expected as an input type, any string (such as `\\\"4\\\"`) or integer (such as `4`) input value will be accepted as an ID.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"ID\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
            doc: "mutation CommitCreateCreateCommitOnBranch($input: CreateCommitOnBranchInput!) { createCommitOnBranch(input: $input) { commit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }"
            field: "createCommitOnBranch"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateCommitOnBranchInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createCommitOnBranch"
          select: {
            "$action": "create_commit_on_branch"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.createCommitOnBranch.commit`"
          }
        }
        {
          contract: {
            id: "POST mergeBranch"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"MergeBranchInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"MergeBranchInput\"}],\"deprecated\":false,\"desc\":\"Merge a head into a branch.\",\"gqltype\":\"MergeBranchPayload\",\"list\":false,\"name\":\"mergeBranch\",\"reqd\":false,\"type\":\"MergeBranchPayload\"},\"invocation\":{\"doc\":\"mutation CommitCreateMergeBranch($input: MergeBranchInput!) { mergeBranch(input: $input) { mergeCommit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }\",\"field\":\"mergeBranch\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"MergeBranchInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"ID\":{\"desc\":\"The `ID` scalar type represents a unique identifier, often used to refetch an object or as key for a cache. The ID type appears in a JSON response as a String; however, it is not intended to be human-readable. When expected as an input type, any string (such as `\\\"4\\\"`) or integer (such as `4`) input value will be accepted as an ID.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"ID\"},\"MergeBranchInput\":{\"desc\":\"Autogenerated input type of MergeBranch\",\"fields\":{\"authorEmail\":{\"args\":[],\"deprecated\":false,\"desc\":\"The email address to associate with this commit.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"authorEmail\",\"reqd\":false,\"type\":\"String\"},\"base\":{\"args\":[],\"deprecated\":false,\"desc\":\"The name of the base branch that the provided head will be merged into.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"base\",\"reqd\":true,\"type\":\"String\"},\"clientMutationId\":{\"args\":[],\"deprecated\":false,\"desc\":\"A unique identifier for the client performing the mutation.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"clientMutationId\",\"reqd\":false,\"type\":\"String\"},\"commitMessage\":{\"args\":[],\"deprecated\":false,\"desc\":\"Message to use for the merge commit. If omitted, a default will be used.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"commitMessage\",\"reqd\":false,\"type\":\"String\"},\"head\":{\"args\":[],\"deprecated\":false,\"desc\":\"The head to merge into the base branch. This can be a branch name or a commit GitObjectID.\",\"gqltype\":\"String!\",\"list\":false,\"name\":\"head\",\"reqd\":true,\"type\":\"String\"},\"repositoryId\":{\"args\":[],\"deprecated\":false,\"desc\":\"The Node ID of the Repository containing the base branch that will be modified.\",\"gqltype\":\"ID!\",\"list\":false,\"name\":\"repositoryId\",\"reqd\":true,\"type\":\"ID\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"MergeBranchInput\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
            doc: "mutation CommitCreateMergeBranch($input: MergeBranchInput!) { mergeBranch(input: $input) { mergeCommit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }"
            field: "mergeBranch"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "MergeBranchInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "mergeBranch"
          select: {
            "$action": "merge_branch"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.mergeBranch.mergeCommit`"
          }
        }
      ]
    }
  }



}