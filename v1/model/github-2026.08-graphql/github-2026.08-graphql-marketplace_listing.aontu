# Entity: marketplace_listing

main: kit: entity: marketplace_listing: {

  alias: field: {}

  fields: [
    {
      name: "app"
      req: false
      short: "The GitHub App this listing represents."
      type: "`$OBJECT`"
    }
    {
      name: "companyUrl"
      req: false
      short: "URL to the listing owner's company site."
      type: "`$ANY`"
    }
    {
      name: "configurationResourcePath"
      req: true
      short: "The HTTP path for configuring access to the listing's integration or OAuth app"
      type: "`$ANY`"
    }
    {
      name: "configurationUrl"
      req: true
      short: "The HTTP URL for configuring access to the listing's integration or OAuth app"
      type: "`$ANY`"
    }
    {
      name: "documentationUrl"
      req: false
      short: "URL to the listing's documentation."
      type: "`$ANY`"
    }
    {
      name: "extendedDescription"
      req: false
      short: "The listing's detailed description."
      type: "`$STRING`"
    }
    {
      name: "extendedDescriptionHTML"
      req: true
      short: "The listing's detailed description rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "fullDescription"
      req: true
      short: "The listing's introductory description."
      type: "`$STRING`"
    }
    {
      name: "fullDescriptionHTML"
      req: true
      short: "The listing's introductory description rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "hasPublishedFreeTrialPlans"
      req: true
      short: "Does this listing have any plans with a free trial?"
      type: "`$BOOLEAN`"
    }
    {
      name: "hasTermsOfService"
      req: true
      short: "Does this listing have a terms of service link?"
      type: "`$BOOLEAN`"
    }
    {
      name: "hasVerifiedOwner"
      req: true
      short: "Whether the creator of the app is a verified org"
      type: "`$BOOLEAN`"
    }
    {
      name: "howItWorks"
      req: false
      short: "A technical description of how this app works with GitHub."
      type: "`$STRING`"
    }
    {
      name: "howItWorksHTML"
      req: true
      short: "The listing's technical description rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the MarketplaceListing object"
      type: "`$STRING`"
    }
    {
      name: "installationUrl"
      req: false
      short: "URL to install the product to the viewer's account or organization."
      type: "`$ANY`"
    }
    {
      name: "installedForViewer"
      req: true
      short: "Whether this listing's app has been installed for the current viewer"
      type: "`$BOOLEAN`"
    }
    {
      name: "isArchived"
      req: true
      short: "Whether this listing has been removed from the Marketplace."
      type: "`$BOOLEAN`"
    }
    {
      name: "isDraft"
      req: true
      short: "Whether this listing is still an editable draft that has not been submitted for review and is not publicly visible in the Marketplace."
      type: "`$BOOLEAN`"
    }
    {
      name: "isPaid"
      req: true
      short: "Whether the product this listing represents is available as part of a paid plan."
      type: "`$BOOLEAN`"
    }
    {
      name: "isPublic"
      req: true
      short: "Whether this listing has been approved for display in the Marketplace."
      type: "`$BOOLEAN`"
    }
    {
      name: "isRejected"
      req: true
      short: "Whether this listing has been rejected by GitHub for display in the Marketplace."
      type: "`$BOOLEAN`"
    }
    {
      name: "isUnverified"
      req: true
      short: "Whether this listing has been approved for unverified display in the Marketplace."
      type: "`$BOOLEAN`"
    }
    {
      name: "isUnverifiedPending"
      req: true
      short: "Whether this draft listing has been submitted for review for approval to be unverified in the Marketplace."
      type: "`$BOOLEAN`"
    }
    {
      name: "isVerificationPendingFromDraft"
      req: true
      short: "Whether this draft listing has been submitted for review from GitHub for approval to be verified in the Marketplace."
      type: "`$BOOLEAN`"
    }
    {
      name: "isVerificationPendingFromUnverified"
      req: true
      short: "Whether this unverified listing has been submitted for review from GitHub for approval to be verified in the Marketplace."
      type: "`$BOOLEAN`"
    }
    {
      name: "isVerified"
      req: true
      short: "Whether this listing has been approved for verified display in the Marketplace."
      type: "`$BOOLEAN`"
    }
    {
      name: "logoBackgroundColor"
      req: true
      short: "The hex color code, without the leading '#', for the logo background."
      type: "`$STRING`"
    }
    {
      name: "logoUrl"
      req: false
      short: "URL for the listing's logo image."
      type: "`$ANY`"
    }
    {
      name: "name"
      req: true
      short: "The listing's full name."
      type: "`$STRING`"
    }
    {
      name: "normalizedShortDescription"
      req: true
      short: "The listing's very short description without a trailing period or ampersands."
      type: "`$STRING`"
    }
    {
      name: "pricingUrl"
      req: false
      short: "URL to the listing's detailed pricing."
      type: "`$ANY`"
    }
    {
      name: "primaryCategory"
      req: false
      short: "The category that best describes the listing."
      type: "`$OBJECT`"
    }
    {
      name: "privacyPolicyUrl"
      req: true
      short: "URL to the listing's privacy policy, may return an empty string for listings that do not require a privacy policy URL."
      type: "`$ANY`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for the Marketplace listing."
      type: "`$ANY`"
    }
    {
      name: "screenshotUrls"
      req: true
      short: "The URLs for the listing's screenshots."
      type: "`$STRING`"
    }
    {
      name: "secondaryCategory"
      req: false
      short: "An alternate category that describes the listing."
      type: "`$OBJECT`"
    }
    {
      name: "shortDescription"
      req: true
      short: "The listing's very short description."
      type: "`$STRING`"
    }
    {
      name: "slug"
      req: true
      short: "The short name of the listing used in its URL."
      type: "`$STRING`"
    }
    {
      name: "statusUrl"
      req: false
      short: "URL to the listing's status page."
      type: "`$ANY`"
    }
    {
      name: "supportEmail"
      req: false
      short: "An email address for support for this listing's app."
      type: "`$STRING`"
    }
    {
      name: "supportUrl"
      req: true
      short: "Either a URL or an email address for support for this listing's app, may return an empty string for listings that do not require a support URL."
      type: "`$ANY`"
    }
    {
      name: "termsOfServiceUrl"
      req: false
      short: "URL to the listing's terms of service."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for the Marketplace listing."
      type: "`$STRING`"
    }
    {
      name: "viewerCanAddPlans"
      req: true
      short: "Can the current viewer add plans for this Marketplace listing."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanApprove"
      req: true
      short: "Can the current viewer approve this Marketplace listing."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanDelist"
      req: true
      short: "Can the current viewer delist this Marketplace listing."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanEdit"
      req: true
      short: "Can the current viewer edit this Marketplace listing."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanEditCategories"
      req: true
      short: "Can the current viewer edit the primary and secondary category of this Marketplace listing."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanEditPlans"
      req: true
      short: "Can the current viewer edit the plans for this Marketplace listing."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanRedraft"
      req: true
      short: "Can the current viewer return this Marketplace listing to draft state so it becomes editable again."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanReject"
      req: true
      short: "Can the current viewer reject this Marketplace listing by returning it to an editable draft state or rejecting it entirely."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanRequestApproval"
      req: true
      short: "Can the current viewer request this listing be reviewed for display in the Marketplace as verified."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerHasPurchased"
      req: true
      short: "Indicates whether the current user has an active subscription to this Marketplace listing."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerHasPurchasedForAllOrganizations"
      req: true
      short: "Indicates if the current user has purchased a subscription to this Marketplace listing for all of the organizations the user owns."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerIsListingAdmin"
      req: true
      short: "Does the current viewer role allow them to administer this Marketplace listing."
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "marketplace_listing"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "admin_id"
                orig: "admin_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "after"
                orig: "after"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "all_state"
                orig: "all_state"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                kind: "param"
                name: "before"
                orig: "before"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "category_slug"
                orig: "category_slug"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "first"
                orig: "first"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "last"
                orig: "last"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "param"
