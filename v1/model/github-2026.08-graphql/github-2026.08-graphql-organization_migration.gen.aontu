# Entity: organization_migration

main: kit: entity: organization_migration: {

  alias: field: {}

  fields: {
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$STRING`"
    }
    failureReason: {
      h: "Failure Reason"
      n: "failureReason"
      r: false
      sh: "The reason the organization migration failed."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the OrganizationMigration object"
      t: "`$STRING`"
    }
    remainingRepositoriesCount: {
      h: "Remaining Repositories Count"
      n: "remainingRepositoriesCount"
      r: false
      sh: "The remaining amount of repos to be migrated."
      t: "`$INTEGER`"
    }
    sourceOrgName: {
      h: "Source Org Name"
      n: "sourceOrgName"
      r: true
      sh: "The name of the source organization to be migrated."
      t: "`$STRING`"
    }
    sourceOrgUrl: {
      h: "Source Org Url"
      n: "sourceOrgUrl"
      r: true
      sh: "The URL of the source organization to migrate."
      t: "`$ANY`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "The migration state."
      t: "`$STRING`"
    }
    targetOrgName: {
      h: "Target Org Name"
      n: "targetOrgName"
      r: true
      sh: "The name of the target organization."
      t: "`$STRING`"
    }
    totalRepositoriesCount: {
      h: "Total Repositories Count"
      n: "totalRepositoriesCount"
      r: false
      sh: "The total amount of repositories to be migrated."
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "organization_migration"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST startOrganizationMigration"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation OrganizationMigrationCreateStart($input: StartOrganizationMigrationInput!) { startOrganizationMigration(input: $input) { orgMigration { ...OrganizationMigrationFields } } } fragment OrganizationMigrationFields on OrganizationMigration { createdAt databaseId failureReason id remainingRepositoriesCount sourceOrgName sourceOrgUrl state targetOrgName totalRepositoriesCount }"
            field: "startOrganizationMigration"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "StartOrganizationMigrationInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "startOrganizationMigration"
          select: {
            "$action": "start"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.startOrganizationMigration.orgMigration`"
          }
        }
      ]
    }
  }



}