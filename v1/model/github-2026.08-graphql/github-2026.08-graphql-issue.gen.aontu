# Entity: issue

main: kit: entity: issue: {

  alias: field: {}

  fields: [
    {
      name: "activeLockReason"
      req: false
      short: "Reason that the conversation was locked."
      type: "`$STRING`"
    }
    {
      name: "authorAssociation"
      req: true
      short: "Author's association with the subject of the comment."
      type: "`$STRING`"
    }
    {
      name: "body"
      req: true
      short: "Identifies the body of the issue."
      type: "`$STRING`"
    }
    {
      name: "bodyHTML"
      req: true
      short: "The body rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "bodyResourcePath"
      req: true
      short: "The http path for this issue body"
      type: "`$ANY`"
    }
    {
      name: "bodyText"
      req: true
      short: "Identifies the body of the issue rendered to text."
      type: "`$STRING`"
    }
    {
      name: "bodyUrl"
      req: true
      short: "The http URL for this issue body"
      type: "`$ANY`"
    }
    {
      name: "closed"
      req: true
      short: "Indicates if the object is closed (definition of closed may depend on type)"
      type: "`$BOOLEAN`"
    }
    {
      name: "closedAt"
      req: false
      short: "Identifies the date and time when the object was closed."
      type: "`$ANY`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "createdViaEmail"
      req: true
      short: "Check if this comment was created via an email reply."
      type: "`$BOOLEAN`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$INTEGER`"
    }
    {
      name: "duplicateOf"
      req: false
      short: "A reference to the original issue that this issue has been marked as a duplicate of."
      type: "`$OBJECT`"
    }
    {
      name: "fullDatabaseId"
      req: false
      short: "Identifies the primary key from the database as a BigInt."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the Issue object"
      type: "`$STRING`"
    }
    {
      name: "includesCreatedEdit"
      req: true
      short: "Check if this comment was edited and includes an edit with the creation data"
      type: "`$BOOLEAN`"
    }
    {
      name: "isPinned"
      req: false
      short: "Indicates whether or not this issue is currently pinned to the repository issues list"
      type: "`$BOOLEAN`"
    }
    {
      name: "isReadByViewer"
      req: false
      short: "Is this issue read by the viewer"
      type: "`$BOOLEAN`"
    }
    {
      name: "issueType"
      req: false
      short: "The issue type for this Issue"
      type: "`$OBJECT`"
    }
    {
      name: "lastEditedAt"
      req: false
      short: "The moment the editor made the last edit"
      type: "`$ANY`"
    }
    {
      name: "locked"
      req: true
      short: "`true` if the object is locked"
      type: "`$BOOLEAN`"
    }
    {
      name: "milestone"
      req: false
      short: "Identifies the milestone associated with the issue."
      type: "`$OBJECT`"
    }
    {
      name: "number"
      req: true
      short: "Identifies the issue number."
      type: "`$INTEGER`"
    }
    {
      name: "parent"
      req: false
      short: "The parent entity of the issue."
      type: "`$OBJECT`"
    }
    {
      name: "pinnedIssueComment"
      req: false
      short: "The pinned comment for this issue."
      type: "`$OBJECT`"
    }
    {
      name: "publishedAt"
      req: false
      short: "Identifies when the comment was published at."
      type: "`$ANY`"
    }
    {
      name: "repository"
      req: false
      short: "The repository associated with this node."
      type: "`$OBJECT`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this issue"
      type: "`$ANY`"
    }
    {
      name: "state"
      req: true
      short: "Identifies the state of the issue."
      type: "`$STRING`"
    }
    {
      name: "stateReason"
      req: false
      short: "Identifies the reason for the issue state."
      type: "`$STRING`"
    }
    {
      name: "title"
      req: true
      short: "Identifies the issue title."
      type: "`$STRING`"
    }
    {
      name: "titleHTML"
      req: true
      short: "Identifies the issue title rendered to HTML."
      type: "`$STRING`"
    }
    {
      name: "trackedIssuesCount"
      req: true
      short: "The number of tracked issues for this issue"
      type: "`$INTEGER`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this issue"
      type: "`$STRING`"
    }
    {
      name: "viewerCanAssign"
      req: true
      short: "Indicates if the viewer can edit assignees for this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanClose"
      req: true
      short: "Indicates if the object can be closed by the viewer."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanDelete"
      req: true
      short: "Check if the current viewer can delete this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanLabel"
      req: true
      short: "Indicates if the viewer can edit labels for this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanReact"
      req: true
      short: "Can user react to this subject"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanReopen"
      req: true
      short: "Indicates if the object can be reopened by the viewer."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanSetFields"
      req: false
      short: "Check if the current viewer can set fields on the issue."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanSetMilestone"
      req: true
      short: "Indicates if the viewer can edit the milestone of the issue."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanSubscribe"
      req: true
      short: "Check if the viewer is able to change their subscription status for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanType"
      req: false
      short: "Check if the current viewer can set the issue type of this issue."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUpdate"
      req: true
      short: "Check if the current viewer can update this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUpdateMetadata"
      req: false
      short: "Check if the viewer has triage-level (or higher) access to update this issue's metadata."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCannotUpdateReasons"
      req: true
      short: "Reasons why the current viewer can not update this comment."
      type: "`$STRING`"
    }
    {
      name: "viewerDidAuthor"
      req: true
      short: "Did the viewer author this comment."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerSubscription"
      req: false
      short: "Identifies if the viewer is watching, not watching, or ignoring the subscribable entity."
      type: "`$STRING`"
    }
    {
      name: "viewerThreadSubscriptionFormAction"
      req: false
      short: "Identifies the viewer's thread subscription form action."
      type: "`$STRING`"
    }
    {
      name: "viewerThreadSubscriptionStatus"
      req: false
      short: "Identifies the viewer's thread subscription status."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "issue"
