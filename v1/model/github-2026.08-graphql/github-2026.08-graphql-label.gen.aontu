# Entity: label

main: kit: entity: label: {

  alias: field: {}

  fields: {
    color: {
      h: "Color"
      n: "color"
      r: true
      sh: "Identifies the label color."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: false
      sh: "Identifies the date and time when the label was created."
      t: "`$ANY`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "A brief description of this label."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Label object"
      t: "`$STRING`"
    }
    isDefault: {
      h: "Is Default"
      n: "isDefault"
      r: true
      sh: "Indicates whether or not this is a default label."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Identifies the label name."
      t: "`$STRING`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The repository associated with this label."
      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this label."
      t: "`$ANY`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: false
      sh: "Identifies the date and time when the label was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this label."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "label"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST createLabel"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation LabelCreate($input: CreateLabelInput!) { createLabel(input: $input) { label { ...LabelFields } } } fragment LabelFields on Label { color createdAt description id isDefault name repository { id } resourcePath updatedAt url }"
            field: "createLabel"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateLabelInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createLabel"
          t: {
            req: "`reqdata`"
            res: "`body.data.createLabel.label`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST updateLabel"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation LabelUpdate($input: UpdateLabelInput!) { updateLabel(input: $input) { label { ...LabelFields } } } fragment LabelFields on Label { color createdAt description id isDefault name repository { id } resourcePath updatedAt url }"
            field: "updateLabel"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateLabelInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "updateLabel"
          t: {
            req: "`reqdata`"
            res: "`body.data.updateLabel.label`"
          }
        }
      ]
    }
  }



}