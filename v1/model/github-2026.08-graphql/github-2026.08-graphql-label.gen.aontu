  name: "label"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation LabelCreate($input: CreateLabelInput!) { createLabel(input: $input) { label { ...LabelFields } } } fragment LabelFields on Label { color createdAt description id isDefault name repository { id } resourcePath updatedAt url }"
            field: "createLabel"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateLabelInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createLabel"
          transform: {
            req: "`reqdata`"
            res: "`body.data.createLabel.label`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          graphql: {
            doc: "mutation LabelUpdate($input: UpdateLabelInput!) { updateLabel(input: $input) { label { ...LabelFields } } } fragment LabelFields on Label { color createdAt description id isDefault name repository { id } resourcePath updatedAt url }"
            field: "updateLabel"
            optype: "mutation"
            vars: [
              {
                from: ""
