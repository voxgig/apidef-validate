# Entity: topic

main: kit: entity: topic: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Topic object"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The topic's name."
      t: "`$STRING`"
    }
    stargazerCount: {
      h: "Stargazer Count"
      n: "stargazerCount"
      r: true
      sh: "Returns a count of how many stargazers there are on this object"
      t: "`$INTEGER`"
    }
    viewerHasStarred: {
      h: "Viewer Has Starred"
      n: "viewerHasStarred"
      r: true
      sh: "Returns a boolean indicating whether the viewing user has starred this starrable."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "topic"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST acceptTopicSuggestion"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation TopicCreateAcceptTopicSuggestion($input: AcceptTopicSuggestionInput!) { acceptTopicSuggestion(input: $input) { topic { ...TopicFields } } } fragment TopicFields on Topic { id name stargazerCount viewerHasStarred }"
            field: "acceptTopicSuggestion"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AcceptTopicSuggestionInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "acceptTopicSuggestion"
          q: {
            "$action": "accept_topic_suggestion"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.acceptTopicSuggestion.topic`"
          }
        }
        {
          co: {
            id: "POST declineTopicSuggestion"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation TopicCreateDeclineTopicSuggestion($input: DeclineTopicSuggestionInput!) { declineTopicSuggestion(input: $input) { topic { ...TopicFields } } } fragment TopicFields on Topic { id name stargazerCount viewerHasStarred }"
            field: "declineTopicSuggestion"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "DeclineTopicSuggestionInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "declineTopicSuggestion"
          q: {
            "$action": "decline_topic_suggestion"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.declineTopicSuggestion.topic`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST topic"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "name"
                or: "name"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query TopicLoad($name: String!) { topic(name: $name) { ...TopicFields } } fragment TopicFields on Topic { id name stargazerCount viewerHasStarred }"
            field: "topic"
            optype: "query"
            vars: [
              {
                from: "name"
                gqltype: "String!"
                name: "name"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "topic"
          q: {
            exist: [
              "name"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.topic`"
          }
        }
      ]
    }
  }



}