# Entity: sponsors_listing

main: kit: entity: sponsors_listing: {

  alias: field: {}

  fields: {
    billingCountryOrRegion: {
      h: "Billing Country Or Region"
      n: "billingCountryOrRegion"
      r: false
      sh: "The name of the country or region with the maintainer's bank account or fiscal host."
      t: "`$STRING`"
    }
    contactEmailAddress: {
      h: "Contact Email Address"
      n: "contactEmailAddress"
      r: false
      sh: "The email address used by GitHub to contact the sponsorable about their GitHub Sponsors profile."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    dashboardResourcePath: {
      h: "Dashboard Resource Path"
      n: "dashboardResourcePath"
      r: true
      sh: "The HTTP path for the Sponsors dashboard for this Sponsors listing."
      t: "`$ANY`"
    }
    dashboardUrl: {
      h: "Dashboard Url"
      n: "dashboardUrl"
      r: true
      sh: "The HTTP URL for the Sponsors dashboard for this Sponsors listing."
      t: "`$ANY`"
    }
    fiscalHost: {
      h: "Fiscal Host"
      n: "fiscalHost"
      r: false
      sh: "The fiscal host used for payments, if any."
      t: "`$OBJECT`"
    }
    fullDescription: {
      h: "Full Description"
      n: "fullDescription"
      r: true
      sh: "The full description of the listing."
      t: "`$STRING`"
    }
    fullDescriptionHTML: {
      h: "Full Description Html"
      n: "fullDescriptionHTML"
      r: true
      sh: "The full description of the listing rendered to HTML."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the SponsorsListing object"
      t: "`$STRING`"
    }
    isPublic: {
      h: "Is Public"
      n: "isPublic"
      r: true
      sh: "Whether this listing is publicly visible."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The listing's full name."
      t: "`$STRING`"
    }
    nextPayoutDate: {
      h: "Next Payout Date"
      n: "nextPayoutDate"
      r: false
      sh: "A future date on which this listing is eligible to receive a payout."
      t: "`$ANY`"
    }
    residenceCountryOrRegion: {
      h: "Residence Country Or Region"
      n: "residenceCountryOrRegion"
      r: false
      sh: "The name of the country or region where the maintainer resides."
      t: "`$STRING`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this Sponsors listing."
      t: "`$ANY`"
    }
    shortDescription: {
      h: "Short Description"
      n: "shortDescription"
      r: true
      sh: "The short description of the listing."
      t: "`$STRING`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: true
      sh: "The short name of the listing."
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this Sponsors listing."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "sponsors_listing"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST createSponsorsListing"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation SponsorsListingCreate($input: CreateSponsorsListingInput!) { createSponsorsListing(input: $input) { sponsorsListing { ...SponsorsListingFields } } } fragment SponsorsListingFields on SponsorsListing { billingCountryOrRegion contactEmailAddress createdAt dashboardResourcePath dashboardUrl fiscalHost { id } fullDescription fullDescriptionHTML id isPublic name nextPayoutDate residenceCountryOrRegion resourcePath shortDescription slug url }"
            field: "createSponsorsListing"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateSponsorsListingInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createSponsorsListing"
          t: {
            req: "`reqdata`"
            res: "`body.data.createSponsorsListing.sponsorsListing`"
          }
        }
        {
          co: {
            id: "POST updatePatreonSponsorability"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation SponsorsListingCreateUpdatePatreonSponsorability($input: UpdatePatreonSponsorabilityInput!) { updatePatreonSponsorability(input: $input) { sponsorsListing { ...SponsorsListingFields } } } fragment SponsorsListingFields on SponsorsListing { billingCountryOrRegion contactEmailAddress createdAt dashboardResourcePath dashboardUrl fiscalHost { id } fullDescription fullDescriptionHTML id isPublic name nextPayoutDate residenceCountryOrRegion resourcePath shortDescription slug url }"
            field: "updatePatreonSponsorability"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdatePatreonSponsorabilityInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "updatePatreonSponsorability"
          q: {
            "$action": "update_patreon_sponsorability"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.updatePatreonSponsorability.sponsorsListing`"
          }
        }
      ]
    }
  }



}