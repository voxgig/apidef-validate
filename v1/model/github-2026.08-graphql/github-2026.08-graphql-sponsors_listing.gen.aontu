# Entity: sponsors_listing

main: kit: entity: sponsors_listing: {

  alias: field: {}

  fields: [
    {
      name: "billingCountryOrRegion"
      req: false
      short: "The name of the country or region with the maintainer's bank account or fiscal host."
      type: "`$STRING`"
    }
    {
      name: "contactEmailAddress"
      req: false
      short: "The email address used by GitHub to contact the sponsorable about their GitHub Sponsors profile."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "dashboardResourcePath"
      req: true
      short: "The HTTP path for the Sponsors dashboard for this Sponsors listing."
      type: "`$ANY`"
    }
    {
      name: "dashboardUrl"
      req: true
      short: "The HTTP URL for the Sponsors dashboard for this Sponsors listing."
      type: "`$ANY`"
    }
    {
      name: "fiscalHost"
      req: false
      short: "The fiscal host used for payments, if any."
      type: "`$OBJECT`"
    }
    {
      name: "fullDescription"
      req: true
      short: "The full description of the listing."
      type: "`$STRING`"
    }
    {
      name: "fullDescriptionHTML"
      req: true
      short: "The full description of the listing rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the SponsorsListing object"
      type: "`$STRING`"
    }
    {
      name: "isPublic"
      req: true
      short: "Whether this listing is publicly visible."
      type: "`$BOOLEAN`"
    }
    {
      name: "name"
      req: true
      short: "The listing's full name."
      type: "`$STRING`"
    }
    {
      name: "nextPayoutDate"
      req: false
      short: "A future date on which this listing is eligible to receive a payout."
      type: "`$ANY`"
    }
    {
      name: "residenceCountryOrRegion"
      req: false
      short: "The name of the country or region where the maintainer resides."
      type: "`$STRING`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this Sponsors listing."
      type: "`$ANY`"
    }
    {
      name: "shortDescription"
      req: true
      short: "The short description of the listing."
      type: "`$STRING`"
    }
    {
      name: "slug"
      req: true
      short: "The short name of the listing."
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this Sponsors listing."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "sponsors_listing"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation SponsorsListingCreate($input: CreateSponsorsListingInput!) { createSponsorsListing(input: $input) { sponsorsListing { ...SponsorsListingFields } } } fragment SponsorsListingFields on SponsorsListing { billingCountryOrRegion contactEmailAddress createdAt dashboardResourcePath dashboardUrl fiscalHost { id } fullDescription fullDescriptionHTML id isPublic name nextPayoutDate residenceCountryOrRegion resourcePath shortDescription slug url }"
            field: "createSponsorsListing"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateSponsorsListingInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createSponsorsListing"
          transform: {
            req: "`reqdata`"
            res: "`body.data.createSponsorsListing.sponsorsListing`"
          }
        }
        {
          graphql: {
            doc: "mutation SponsorsListingCreateUpdatePatreonSponsorability($input: UpdatePatreonSponsorabilityInput!) { updatePatreonSponsorability(input: $input) { sponsorsListing { ...SponsorsListingFields } } } fragment SponsorsListingFields on SponsorsListing { billingCountryOrRegion contactEmailAddress createdAt dashboardResourcePath dashboardUrl fiscalHost { id } fullDescription fullDescriptionHTML id isPublic name nextPayoutDate residenceCountryOrRegion resourcePath shortDescription slug url }"
            field: "updatePatreonSponsorability"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdatePatreonSponsorabilityInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updatePatreonSponsorability"
          select: {
            "$action": "update_patreon_sponsorability"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.updatePatreonSponsorability.sponsorsListing`"
          }
        }
      ]
    }
  }



}