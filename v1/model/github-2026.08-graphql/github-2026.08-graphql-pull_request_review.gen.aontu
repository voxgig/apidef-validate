      short: "The Node ID of the PullRequestReview object"
      type: "`$STRING`"
    }
    {
      name: "includesCreatedEdit"
      req: true
      short: "Check if this comment was edited and includes an edit with the creation data"
      type: "`$BOOLEAN`"
    }
    {
      name: "isMinimized"
      req: true
      short: "Returns whether or not a comment has been minimized."
      type: "`$BOOLEAN`"
    }
    {
      name: "lastEditedAt"
      req: false
      short: "The moment the editor made the last edit"
      type: "`$ANY`"
    }
    {
      name: "minimizedReason"
      req: false
      short: "Returns why the comment was minimized."
      type: "`$STRING`"
    }
    {
      name: "publishedAt"
      req: false
      short: "Identifies when the comment was published at."
      type: "`$ANY`"
    }
    {
      name: "pullRequest"
      req: false
      short: "Identifies the pull request associated with this pull request review."
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
