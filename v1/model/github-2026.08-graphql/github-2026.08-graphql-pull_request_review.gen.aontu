    }
    {
      name: "bodyHTML"
      req: true
      short: "The body rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "bodyText"
      req: true
      short: "The body of this review rendered as plain text."
      type: "`$STRING`"
    }
    {
      name: "commit"
      req: false
      short: "Identifies the commit associated with this pull request review."
      type: "`$OBJECT`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
