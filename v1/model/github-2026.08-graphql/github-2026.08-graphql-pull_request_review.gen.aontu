# Entity: pull_request_review

main: kit: entity: pull_request_review: {

  alias: field: {}

  fields: [
    {
      name: "authorAssociation"
      req: true
      short: "Author's association with the subject of the comment."
      type: "`$STRING`"
    }
    {
      name: "authorCanPushToRepository"
      req: true
      short: "Indicates whether the author of this review has push access to the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "body"
      req: true
