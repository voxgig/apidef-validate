      req: true
      short: "Check if this comment was created via an email reply."
      type: "`$BOOLEAN`"
    }
    {
      name: "fullDatabaseId"
      req: false
      short: "Identifies the primary key from the database as a BigInt."
      type: "`$ANY`"
    }
    {
