# Entity: ref

main: kit: entity: ref: {

  alias: field: {}

  fields: {
    branchProtectionRule: {
      h: "Branch Protection Rule"
      n: "branchProtectionRule"
      r: false
      sh: "Branch protection rules for this ref"
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Ref object"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The ref name."
      t: "`$STRING`"
    }
    prefix: {
      h: "Prefix"
      n: "prefix"
      r: true
      sh: "The ref's prefix, such as `refs/heads/` or `refs/tags/`."
      t: "`$STRING`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The repository the ref belongs to."
      t: "`$OBJECT`"
    }
    target: {
      h: "Target"
      n: "target"
      r: false
      sh: "The object the ref points to."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "ref"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST createRef"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation RefCreate($input: CreateRefInput!) { createRef(input: $input) { ref { ...RefFields } } } fragment RefFields on Ref { branchProtectionRule { id } id name prefix repository { id } target { id } }"
            field: "createRef"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateRefInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createRef"
          transform: {
            req: "`reqdata`"
            res: "`body.data.createRef.ref`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          contract: {
            id: "POST updateRef"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation RefUpdate($input: UpdateRefInput!) { updateRef(input: $input) { ref { ...RefFields } } } fragment RefFields on Ref { branchProtectionRule { id } id name prefix repository { id } target { id } }"
            field: "updateRef"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateRefInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updateRef"
          transform: {
            req: "`reqdata`"
            res: "`body.data.updateRef.ref`"
          }
        }
      ]
    }
  }



}