# Entity: pull_request_review_comment

main: kit: entity: pull_request_review_comment: {

  alias: field: {}

  fields: {
    authorAssociation: {
      h: "Author Association"
      n: "authorAssociation"
      r: true
      sh: "Author's association with the subject of the comment."
      t: "`$STRING`"
    }
    body: {
      h: "Body"
      n: "body"
      r: true
      sh: "The comment body of this review comment."
      t: "`$STRING`"
    }
    bodyHTML: {
      h: "Body Html"
      n: "bodyHTML"
      r: true
      sh: "The body rendered to HTML."
      t: "`$ANY`"
    }
    bodyText: {
      h: "Body Text"
      n: "bodyText"
      r: true
      sh: "The comment body of this review comment rendered as plain text."
      t: "`$STRING`"
    }
    commit: {
      h: "Commit"
      n: "commit"
      r: false
      sh: "Identifies the commit associated with the comment."
      t: "`$OBJECT`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies when the comment was created."
      t: "`$ANY`"
    }
    createdViaEmail: {
      h: "Created Via Email"
      n: "createdViaEmail"
      r: true
      sh: "Check if this comment was created via an email reply."
      t: "`$BOOLEAN`"
    }
    diffHunk: {
      h: "Diff Hunk"
      n: "diffHunk"
      r: true
      sh: "The diff hunk to which the comment applies."
      t: "`$STRING`"
    }
    draftedAt: {
      h: "Drafted At"
      n: "draftedAt"
      r: true
      sh: "Identifies when the comment was created in a draft state."
      t: "`$ANY`"
    }
    fullDatabaseId: {
      h: "Full Database Id"
      n: "fullDatabaseId"
      r: false
      sh: "Identifies the primary key from the database as a BigInt."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the PullRequestReviewComment object"
      t: "`$STRING`"
    }
    includesCreatedEdit: {
      h: "Includes Created Edit"
      n: "includesCreatedEdit"
      r: true
      sh: "Check if this comment was edited and includes an edit with the creation data"
      t: "`$BOOLEAN`"
    }
    isMinimized: {
      h: "Is Minimized"
      n: "isMinimized"
      r: true
      sh: "Returns whether or not a comment has been minimized."
      t: "`$BOOLEAN`"
    }
    lastEditedAt: {
      h: "Last Edited At"
      n: "lastEditedAt"
      r: false
      sh: "The moment the editor made the last edit"
      t: "`$ANY`"
    }
    line: {
      h: "Line"
      n: "line"
      r: false
      sh: "The end line number on the file to which the comment applies"
      t: "`$INTEGER`"
    }
    minimizedReason: {
      h: "Minimized Reason"
      n: "minimizedReason"
      r: false
      sh: "Returns why the comment was minimized."
      t: "`$STRING`"
    }
    originalCommit: {
      h: "Original Commit"
      n: "originalCommit"
      r: false
      sh: "Identifies the original commit associated with the comment."
      t: "`$OBJECT`"
    }
    originalLine: {
      h: "Original Line"
      n: "originalLine"
      r: false
      sh: "The end line number on the file to which the comment applied when it was first created"
      t: "`$INTEGER`"
    }
    originalStartLine: {
      h: "Original Start Line"
      n: "originalStartLine"
      r: false
      sh: "The start line number on the file to which the comment applied when it was first created"
      t: "`$INTEGER`"
    }
    outdated: {
      h: "Outdated"
      n: "outdated"
      r: true
      sh: "Identifies when the comment body is outdated"
      t: "`$BOOLEAN`"
    }
    path: {
      h: "Path"
      n: "path"
      r: true
      sh: "The path to which the comment applies."
      t: "`$STRING`"
    }
    publishedAt: {
      h: "Published At"
      n: "publishedAt"
      r: false
      sh: "Identifies when the comment was published at."
      t: "`$ANY`"
    }
    pullRequest: {
      h: "Pull Request"
      n: "pullRequest"
      r: false
      sh: "The pull request associated with this review comment."
      t: "`$OBJECT`"
    }
    pullRequestReview: {
      h: "Pull Request Review"
      n: "pullRequestReview"
      r: false
      sh: "The pull request review associated with this review comment."
      t: "`$OBJECT`"
    }
    replyTo: {
      h: "Reply To"
      n: "replyTo"
      r: false
      sh: "The comment this is a reply to."
      t: "`$OBJECT`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "The repository associated with this node."
      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path permalink for this review comment."
      t: "`$ANY`"
    }
    startLine: {
      h: "Start Line"
      n: "startLine"
      r: false
      sh: "The start line number on the file to which the comment applies"
      t: "`$INTEGER`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "Identifies the state of the comment."
      t: "`$STRING`"
    }
    subjectType: {
      h: "Subject Type"
      n: "subjectType"
      r: true
      sh: "The level at which the comments in the corresponding thread are targeted, can be a diff line or a file"
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies when the comment was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL permalink for this review comment."
      t: "`$STRING`"
    }
    viewerCanDelete: {
      h: "Viewer Can Delete"
      n: "viewerCanDelete"
      r: true
      sh: "Check if the current viewer can delete this object."
      t: "`$BOOLEAN`"
    }
    viewerCanMinimize: {
      h: "Viewer Can Minimize"
      n: "viewerCanMinimize"
      r: true
      sh: "Check if the current viewer can minimize this object."
      t: "`$BOOLEAN`"
    }
    viewerCanReact: {
      h: "Viewer Can React"
      n: "viewerCanReact"
      r: true
      sh: "Can user react to this subject"
      t: "`$BOOLEAN`"
    }
    viewerCanUnminimize: {
      h: "Viewer Can Unminimize"
      n: "viewerCanUnminimize"
      r: true
      sh: "Check if the current viewer can unminimize this object."
      t: "`$BOOLEAN`"
    }
    viewerCanUpdate: {
      h: "Viewer Can Update"
      n: "viewerCanUpdate"
      r: true
      sh: "Check if the current viewer can update this object."
      t: "`$BOOLEAN`"
    }
    viewerCannotUpdateReasons: {
      h: "Viewer Cannot Update Reasons"
      n: "viewerCannotUpdateReasons"
      r: true
      sh: "Reasons why the current viewer can not update this comment."
      t: "`$STRING`"
    }
    viewerDidAuthor: {
      h: "Viewer Did Author"
      n: "viewerDidAuthor"
      r: true
      sh: "Did the viewer author this comment."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "pull_request_review_comment"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST addPullRequestReviewComment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation PullRequestReviewCommentCreate($input: AddPullRequestReviewCommentInput!) { addPullRequestReviewComment(input: $input) { comment { ...PullRequestReviewCommentFields } } } fragment PullRequestReviewCommentFields on PullRequestReviewComment { authorAssociation body bodyHTML bodyText commit { id } createdAt createdViaEmail diffHunk draftedAt fullDatabaseId id includesCreatedEdit isMinimized lastEditedAt line minimizedReason originalCommit { id } originalLine originalStartLine outdated path publishedAt pullRequest { id } pullRequestReview { id } replyTo { id } repository { id } resourcePath startLine state subjectType updatedAt url viewerCanDelete viewerCanMinimize viewerCanReact viewerCanUnminimize viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "addPullRequestReviewComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddPullRequestReviewCommentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "addPullRequestReviewComment"
          t: {
            req: "`reqdata`"
            res: "`body.data.addPullRequestReviewComment.comment`"
          }
        }
        {
          co: {
            id: "POST addPullRequestReviewThreadReply"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation PullRequestReviewCommentCreateAddPullRequestReviewThreadReply($input: AddPullRequestReviewThreadReplyInput!) { addPullRequestReviewThreadReply(input: $input) { comment { ...PullRequestReviewCommentFields } } } fragment PullRequestReviewCommentFields on PullRequestReviewComment { authorAssociation body bodyHTML bodyText commit { id } createdAt createdViaEmail diffHunk draftedAt fullDatabaseId id includesCreatedEdit isMinimized lastEditedAt line minimizedReason originalCommit { id } originalLine originalStartLine outdated path publishedAt pullRequest { id } pullRequestReview { id } replyTo { id } repository { id } resourcePath startLine state subjectType updatedAt url viewerCanDelete viewerCanMinimize viewerCanReact viewerCanUnminimize viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "addPullRequestReviewThreadReply"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddPullRequestReviewThreadReplyInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "addPullRequestReviewThreadReply"
          q: {
            "$action": "add_pull_request_review_thread_reply"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.addPullRequestReviewThreadReply.comment`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST updatePullRequestReviewComment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation PullRequestReviewCommentUpdate($input: UpdatePullRequestReviewCommentInput!) { updatePullRequestReviewComment(input: $input) { pullRequestReviewComment { ...PullRequestReviewCommentFields } } } fragment PullRequestReviewCommentFields on PullRequestReviewComment { authorAssociation body bodyHTML bodyText commit { id } createdAt createdViaEmail diffHunk draftedAt fullDatabaseId id includesCreatedEdit isMinimized lastEditedAt line minimizedReason originalCommit { id } originalLine originalStartLine outdated path publishedAt pullRequest { id } pullRequestReview { id } replyTo { id } repository { id } resourcePath startLine state subjectType updatedAt url viewerCanDelete viewerCanMinimize viewerCanReact viewerCanUnminimize viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "updatePullRequestReviewComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdatePullRequestReviewCommentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "updatePullRequestReviewComment"
          t: {
            req: "`reqdata`"
            res: "`body.data.updatePullRequestReviewComment.pullRequestReviewComment`"
          }
        }
      ]
    }
  }



}