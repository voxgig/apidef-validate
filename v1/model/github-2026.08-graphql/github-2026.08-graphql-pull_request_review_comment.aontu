# Entity: pull_request_review_comment

main: kit: entity: pull_request_review_comment: {

  alias: field: {}

  fields: [
    {
      name: "authorAssociation"
      req: true
      short: "Author's association with the subject of the comment."
      type: "`$STRING`"
    }
    {
      name: "body"
      req: true
      short: "The comment body of this review comment."
      type: "`$STRING`"
    }
    {
      name: "bodyHTML"
      req: true
      short: "The body rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "bodyText"
      req: true
      short: "The comment body of this review comment rendered as plain text."
      type: "`$STRING`"
    }
    {
      name: "commit"
      req: false
      short: "Identifies the commit associated with the comment."
      type: "`$OBJECT`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies when the comment was created."
      type: "`$ANY`"
    }
    {
      name: "createdViaEmail"
      req: true
      short: "Check if this comment was created via an email reply."
      type: "`$BOOLEAN`"
    }
    {
      name: "diffHunk"
      req: true
      short: "The diff hunk to which the comment applies."
      type: "`$STRING`"
    }
    {
      name: "draftedAt"
      req: true
      short: "Identifies when the comment was created in a draft state."
      type: "`$ANY`"
    }
    {
      name: "fullDatabaseId"
      req: false
      short: "Identifies the primary key from the database as a BigInt."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the PullRequestReviewComment object"
      type: "`$STRING`"
    }
    {
      name: "includesCreatedEdit"
      req: true
      short: "Check if this comment was edited and includes an edit with the creation data"
      type: "`$BOOLEAN`"
    }
    {
      name: "isMinimized"
      req: true
      short: "Returns whether or not a comment has been minimized."
      type: "`$BOOLEAN`"
    }
    {
      name: "lastEditedAt"
      req: false
      short: "The moment the editor made the last edit"
      type: "`$ANY`"
    }
    {
      name: "line"
      req: false
      short: "The end line number on the file to which the comment applies"
      type: "`$INTEGER`"
    }
    {
      name: "minimizedReason"
      req: false
      short: "Returns why the comment was minimized."
      type: "`$STRING`"
    }
    {
      name: "originalCommit"
      req: false
      short: "Identifies the original commit associated with the comment."
      type: "`$OBJECT`"
    }
    {
      name: "originalLine"
      req: false
      short: "The end line number on the file to which the comment applied when it was first created"
      type: "`$INTEGER`"
    }
    {
      name: "originalStartLine"
      req: false
      short: "The start line number on the file to which the comment applied when it was first created"
      type: "`$INTEGER`"
    }
    {
      name: "outdated"
      req: true
      short: "Identifies when the comment body is outdated"
      type: "`$BOOLEAN`"
    }
    {
      name: "path"
      req: true
      short: "The path to which the comment applies."
      type: "`$STRING`"
    }
    {
      name: "publishedAt"
      req: false
      short: "Identifies when the comment was published at."
      type: "`$ANY`"
    }
    {
      name: "pullRequest"
      req: false
      short: "The pull request associated with this review comment."
      type: "`$OBJECT`"
    }
    {
      name: "pullRequestReview"
      req: false
      short: "The pull request review associated with this review comment."
      type: "`$OBJECT`"
    }
    {
      name: "replyTo"
      req: false
      short: "The comment this is a reply to."
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
      short: "The repository associated with this node."
      type: "`$OBJECT`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path permalink for this review comment."
      type: "`$ANY`"
    }
    {
      name: "startLine"
      req: false
      short: "The start line number on the file to which the comment applies"
      type: "`$INTEGER`"
    }
    {
      name: "state"
      req: true
      short: "Identifies the state of the comment."
      type: "`$STRING`"
    }
    {
      name: "subjectType"
      req: true
      short: "The level at which the comments in the corresponding thread are targeted, can be a diff line or a file"
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies when the comment was last updated."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL permalink for this review comment."
      type: "`$STRING`"
    }
    {
      name: "viewerCanDelete"
      req: true
      short: "Check if the current viewer can delete this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanMinimize"
      req: true
      short: "Check if the current viewer can minimize this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanReact"
      req: true
      short: "Can user react to this subject"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUnminimize"
      req: true
      short: "Check if the current viewer can unminimize this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUpdate"
      req: true
      short: "Check if the current viewer can update this object."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCannotUpdateReasons"
      req: true
      short: "Reasons why the current viewer can not update this comment."
      type: "`$STRING`"
    }
    {
      name: "viewerDidAuthor"
      req: true
      short: "Did the viewer author this comment."
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "pull_request_review_comment"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation PullRequestReviewCommentCreate($input: AddPullRequestReviewCommentInput!) { addPullRequestReviewComment(input: $input) { comment { ...PullRequestReviewCommentFields } } } fragment PullRequestReviewCommentFields on PullRequestReviewComment { authorAssociation body bodyHTML bodyText commit { id } createdAt createdViaEmail diffHunk draftedAt fullDatabaseId id includesCreatedEdit isMinimized lastEditedAt line minimizedReason originalCommit { id } originalLine originalStartLine outdated path publishedAt pullRequest { id } pullRequestReview { id } replyTo { id } repository { id } resourcePath startLine state subjectType updatedAt url viewerCanDelete viewerCanMinimize viewerCanReact viewerCanUnminimize viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "addPullRequestReviewComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddPullRequestReviewCommentInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "addPullRequestReviewComment"
          transform: {
            req: "`reqdata`"
            res: "`body.data.addPullRequestReviewComment.comment`"
          }
        }
        {
          graphql: {
            doc: "mutation PullRequestReviewCommentCreateAddPullRequestReviewThreadReply($input: AddPullRequestReviewThreadReplyInput!) { addPullRequestReviewThreadReply(input: $input) { comment { ...PullRequestReviewCommentFields } } } fragment PullRequestReviewCommentFields on PullRequestReviewComment { authorAssociation body bodyHTML bodyText commit { id } createdAt createdViaEmail diffHunk draftedAt fullDatabaseId id includesCreatedEdit isMinimized lastEditedAt line minimizedReason originalCommit { id } originalLine originalStartLine outdated path publishedAt pullRequest { id } pullRequestReview { id } replyTo { id } repository { id } resourcePath startLine state subjectType updatedAt url viewerCanDelete viewerCanMinimize viewerCanReact viewerCanUnminimize viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "addPullRequestReviewThreadReply"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddPullRequestReviewThreadReplyInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "addPullRequestReviewThreadReply"
          select: {
            "$action": "add_pull_request_review_thread_reply"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.addPullRequestReviewThreadReply.comment`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          graphql: {
            doc: "mutation PullRequestReviewCommentUpdate($input: UpdatePullRequestReviewCommentInput!) { updatePullRequestReviewComment(input: $input) { pullRequestReviewComment { ...PullRequestReviewCommentFields } } } fragment PullRequestReviewCommentFields on PullRequestReviewComment { authorAssociation body bodyHTML bodyText commit { id } createdAt createdViaEmail diffHunk draftedAt fullDatabaseId id includesCreatedEdit isMinimized lastEditedAt line minimizedReason originalCommit { id } originalLine originalStartLine outdated path publishedAt pullRequest { id } pullRequestReview { id } replyTo { id } repository { id } resourcePath startLine state subjectType updatedAt url viewerCanDelete viewerCanMinimize viewerCanReact viewerCanUnminimize viewerCanUpdate viewerCannotUpdateReasons viewerDidAuthor }"
            field: "updatePullRequestReviewComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdatePullRequestReviewCommentInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updatePullRequestReviewComment"
          transform: {
            req: "`reqdata`"
            res: "`body.data.updatePullRequestReviewComment.pullRequestReviewComment`"
          }
        }
      ]
    }
  }



}