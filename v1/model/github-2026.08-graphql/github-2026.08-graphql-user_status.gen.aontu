# Entity: user_status

main: kit: entity: user_status: {

  alias: field: {}

  fields: [
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "emoji"
      req: false
      short: "An emoji summarizing the user's status."
      type: "`$STRING`"
    }
    {
      name: "emojiHTML"
      req: false
      short: "The status emoji as HTML."
      type: "`$ANY`"
    }
    {
      name: "expiresAt"
      req: false
      short: "If set, the status will not be shown after this date."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the UserStatus object"
      type: "`$STRING`"
    }
    {
      name: "indicatesLimitedAvailability"
      req: true
      short: "Whether this status indicates the user is not fully available on GitHub."
      type: "`$BOOLEAN`"
    }
    {
      name: "message"
      req: false
      short: "A brief message describing what the user is doing."
      type: "`$STRING`"
    }
    {
      name: "organization"
      req: false
      short: "The organization whose members can see this status."
      type: "`$OBJECT`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
    {
      name: "user"
      req: false
      short: "The user who has this status."
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "user_status"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation UserStatusCreateChange($input: ChangeUserStatusInput!) { changeUserStatus(input: $input) { status { ...UserStatusFields } } } fragment UserStatusFields on UserStatus { createdAt emoji emojiHTML expiresAt id indicatesLimitedAvailability message organization { id } updatedAt user { id } }"
            field: "changeUserStatus"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "ChangeUserStatusInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "changeUserStatus"
          select: {
            "$action": "change"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.changeUserStatus.status`"
          }
        }
      ]
    }
  }



}