# Entity: ref

main: kit: entity: ref: {

  alias: field: {}

  fields: [
    {
      name: "branchProtectionRule"
      req: false
      short: "Branch protection rules for this ref"
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the Ref object"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The ref name."
      type: "`$STRING`"
    }
    {
      name: "prefix"
      req: true
      short: "The ref's prefix, such as `refs/heads/` or `refs/tags/`."
      type: "`$STRING`"
    }
    {
      name: "repository"
      req: false
      short: "The repository the ref belongs to."
      type: "`$OBJECT`"
    }
    {
      name: "target"
      req: false
      short: "The object the ref points to."
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "ref"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation RefCreate($input: CreateRefInput!) { createRef(input: $input) { ref { ...RefFields } } } fragment RefFields on Ref { branchProtectionRule { id } id name prefix repository { id } target { id } }"
            field: "createRef"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateRefInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createRef"
          transform: {
            req: "`reqdata`"
            res: "`body.data.createRef.ref`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          graphql: {
            doc: "mutation RefUpdate($input: UpdateRefInput!) { updateRef(input: $input) { ref { ...RefFields } } } fragment RefFields on Ref { branchProtectionRule { id } id name prefix repository { id } target { id } }"
            field: "updateRef"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateRefInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updateRef"
          transform: {
            req: "`reqdata`"
            res: "`body.data.updateRef.ref`"
          }
        }
      ]
    }
  }



}