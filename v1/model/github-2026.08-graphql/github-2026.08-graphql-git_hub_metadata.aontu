# Entity: git_hub_metadata

main: kit: entity: git_hub_metadata: {

  alias: field: {}

  fields: {
    gitHubServicesSha: {
      h: "Git Hub Services Sha"
      n: "gitHubServicesSha"
      r: true
      sh: "Returns a String that's a SHA of `github-services`"
      t: "`$ANY`"
    }
    gitIpAddresses: {
      h: "Git Ip Addresses"
      n: "gitIpAddresses"
      r: false
      sh: "IP addresses that users connect to for git operations"
      t: "`$STRING`"
    }
    githubEnterpriseImporterIpAddresses: {
      h: "Github Enterprise Importer Ip Addresses"
      n: "githubEnterpriseImporterIpAddresses"
      r: false
      sh: "IP addresses that GitHub Enterprise Importer uses for outbound connections"
      t: "`$STRING`"
    }
    hookIpAddresses: {
      h: "Hook Ip Addresses"
      n: "hookIpAddresses"
      r: false
      sh: "IP addresses that service hooks are sent from"
      t: "`$STRING`"
    }
    importerIpAddresses: {
      h: "Importer Ip Addresses"
      n: "importerIpAddresses"
      r: false
      sh: "IP addresses that the importer connects from"
      t: "`$STRING`"
    }
    isPasswordAuthenticationVerifiable: {
      h: "Is Password Authentication Verifiable"
      n: "isPasswordAuthenticationVerifiable"
      r: true
      sh: "Whether or not users are verified"
      t: "`$BOOLEAN`"
    }
    pagesIpAddresses: {
      h: "Pages Ip Addresses"
      n: "pagesIpAddresses"
      r: false
      sh: "IP addresses for GitHub Pages' A records"
      t: "`$STRING`"
    }
  }

  name: "git_hub_metadata"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST meta"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "query GitHubMetadataLoad { meta { ...GitHubMetadataFields } } fragment GitHubMetadataFields on GitHubMetadata { gitHubServicesSha gitIpAddresses githubEnterpriseImporterIpAddresses hookIpAddresses importerIpAddresses isPasswordAuthenticationVerifiable pagesIpAddresses }"
            field: "meta"
            optype: "query"
          }
          k: "graphql"
          m: "POST"
          o: "meta"
          t: {
            req: "`reqdata`"
            res: "`body.data.meta`"
          }
        }
      ]
    }
  }



}