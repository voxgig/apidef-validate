# Entity: enterprise_identity_provider

main: kit: entity: enterprise_identity_provider: {

  alias: field: {}

  fields: [
    {
      name: "digestMethod"
      req: false
      short: "The digest algorithm used to sign SAML requests for the identity provider."
      type: "`$STRING`"
    }
    {
      name: "enterprise"
      req: false
      short: "The enterprise this identity provider belongs to."
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the EnterpriseIdentityProvider object"
      type: "`$STRING`"
    }
    {
