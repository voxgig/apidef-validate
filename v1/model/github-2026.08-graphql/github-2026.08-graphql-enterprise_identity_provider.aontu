            doc: "mutation EnterpriseIdentityProviderUpdate($input: SetEnterpriseIdentityProviderInput!) { setEnterpriseIdentityProvider(input: $input) { identityProvider { ...EnterpriseIdentityProviderFields } } } fragment EnterpriseIdentityProviderFields on EnterpriseIdentityProvider { digestMethod enterprise { id } id idpCertificate issuer recoveryCodes signatureMethod ssoUrl }"
            field: "setEnterpriseIdentityProvider"
