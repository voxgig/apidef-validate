# Entity: enterprise_identity_provider

main: kit: entity: enterprise_identity_provider: {

  alias: field: {}

  fields: {
    digestMethod: {
      h: "Digest Method"
      n: "digestMethod"
      r: false
      sh: "The digest algorithm used to sign SAML requests for the identity provider."
      t: "`$STRING`"
    }
    enterprise: {
      h: "Enterprise"
      n: "enterprise"
      r: false
      sh: "The enterprise this identity provider belongs to."
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the EnterpriseIdentityProvider object"
      t: "`$STRING`"
    }
    idpCertificate: {
      h: "Idp Certificate"
      n: "idpCertificate"
      r: false
      sh: "The x509 certificate used by the identity provider to sign assertions and responses."
      t: "`$ANY`"
    }
    issuer: {
      h: "Issuer"
      n: "issuer"
      r: false
      sh: "The Issuer Entity ID for the SAML identity provider."
      t: "`$STRING`"
    }
    recoveryCodes: {
      h: "Recovery Codes"
      n: "recoveryCodes"
      r: false
      sh: "Recovery codes that can be used by admins to access the enterprise if the identity provider is unavailable."
      t: "`$STRING`"
    }
    signatureMethod: {
      h: "Signature Method"
      n: "signatureMethod"
      r: false
      sh: "The signature algorithm used to sign SAML requests for the identity provider."
      t: "`$STRING`"
    }
    ssoUrl: {
      h: "Sso Url"
      n: "ssoUrl"
      r: false
      sh: "The URL endpoint for the identity provider's SAML SSO."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "enterprise_identity_provider"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST regenerateEnterpriseIdentityProviderRecoveryCodes"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation EnterpriseIdentityProviderCreateRegenerateEnterpriseIdentityProviderRecoveryCode($input: RegenerateEnterpriseIdentityProviderRecoveryCodesInput!) { regenerateEnterpriseIdentityProviderRecoveryCodes(input: $input) { identityProvider { ...EnterpriseIdentityProviderFields } } } fragment EnterpriseIdentityProviderFields on EnterpriseIdentityProvider { digestMethod enterprise { id } id idpCertificate issuer recoveryCodes signatureMethod ssoUrl }"
            field: "regenerateEnterpriseIdentityProviderRecoveryCodes"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "RegenerateEnterpriseIdentityProviderRecoveryCodesInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "regenerateEnterpriseIdentityProviderRecoveryCodes"
          q: {
            "$action": "regenerate_enterprise_identity_provider_recovery_code"
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.regenerateEnterpriseIdentityProviderRecoveryCodes.identityProvider`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "POST removeEnterpriseIdentityProvider"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation EnterpriseIdentityProviderRemove($input: RemoveEnterpriseIdentityProviderInput!) { removeEnterpriseIdentityProvider(input: $input) { identityProvider { ...EnterpriseIdentityProviderFields } } } fragment EnterpriseIdentityProviderFields on EnterpriseIdentityProvider { digestMethod enterprise { id } id idpCertificate issuer recoveryCodes signatureMethod ssoUrl }"
            field: "removeEnterpriseIdentityProvider"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "RemoveEnterpriseIdentityProviderInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "removeEnterpriseIdentityProvider"
          t: {
            req: "`reqdata`"
            res: "`body.data.removeEnterpriseIdentityProvider.identityProvider`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST setEnterpriseIdentityProvider"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation EnterpriseIdentityProviderUpdate($input: SetEnterpriseIdentityProviderInput!) { setEnterpriseIdentityProvider(input: $input) { identityProvider { ...EnterpriseIdentityProviderFields } } } fragment EnterpriseIdentityProviderFields on EnterpriseIdentityProvider { digestMethod enterprise { id } id idpCertificate issuer recoveryCodes signatureMethod ssoUrl }"
            field: "setEnterpriseIdentityProvider"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "SetEnterpriseIdentityProviderInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "setEnterpriseIdentityProvider"
          t: {
            req: "`reqdata`"
            res: "`body.data.setEnterpriseIdentityProvider.identityProvider`"
          }
        }
      ]
    }
  }



}