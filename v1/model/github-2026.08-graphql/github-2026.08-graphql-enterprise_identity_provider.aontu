          method: "POST"
          orig: "regenerateEnterpriseIdentityProviderRecoveryCodes"
          select: {
            "$action": "regenerate_enterprise_identity_provider_recovery_code"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.regenerateEnterpriseIdentityProviderRecoveryCodes.identityProvider`"
          }
        }
