# Entity: deployment

main: kit: entity: deployment: {

  alias: field: {}

  fields: [
    {
      name: "commit"
      req: false
      short: "Identifies the commit sha of the deployment."
      type: "`$OBJECT`"
    }
    {
      name: "commitOid"
      req: true
      short: "Identifies the oid of the deployment commit, even if the commit has been deleted."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$INTEGER`"
    }
    {
      name: "description"
      req: false
      short: "The deployment description."
      type: "`$STRING`"
    }
    {
      name: "environment"
      req: false
      short: "The latest environment to which this deployment was made."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the Deployment object"
      type: "`$STRING`"
    }
    {
      name: "latestEnvironment"
      req: false
      short: "The latest environment to which this deployment was made."
      type: "`$STRING`"
    }
    {
      name: "latestStatus"
      req: false
      short: "The latest status of this deployment."
      type: "`$OBJECT`"
    }
    {
      name: "originalEnvironment"
      req: false
      short: "The original environment to which this deployment was made."
      type: "`$STRING`"
    }
    {
      name: "payload"
      req: false
      short: "Extra information that a deployment system might need."
      type: "`$STRING`"
    }
    {
      name: "ref"
      req: false
      short: "Identifies the Ref of the deployment, if the deployment was created by ref."
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
      short: "Identifies the repository associated with the deployment."
      type: "`$OBJECT`"
    }
    {
      name: "state"
      req: false
      short: "The current state of the deployment."
      type: "`$STRING`"
    }
    {
      name: "task"
      req: false
      short: "The deployment task."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "deployment"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation DeploymentCreate($input: CreateDeploymentInput!) { createDeployment(input: $input) { deployment { ...DeploymentFields } } } fragment DeploymentFields on Deployment { commit { id } commitOid createdAt databaseId description environment id latestEnvironment latestStatus { id } originalEnvironment payload ref { id } repository { id } state task updatedAt }"
            field: "createDeployment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateDeploymentInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createDeployment"
          transform: {
            req: "`reqdata`"
            res: "`body.data.createDeployment.deployment`"
          }
        }
      ]
    }
  }



}