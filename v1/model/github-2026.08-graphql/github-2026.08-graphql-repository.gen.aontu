# Entity: repository

main: kit: entity: repository: {

  alias: field: {}

  fields: [
    {
      name: "allowUpdateBranch"
      req: true
      short: "Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging."
      type: "`$BOOLEAN`"
    }
    {
      name: "archivedAt"
      req: false
      short: "Identifies the date and time when the repository was archived."
      type: "`$ANY`"
    }
    {
      name: "autoMergeAllowed"
      req: true
      short: "Whether or not Auto-merge can be enabled on pull requests in this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "codeOfConduct"
      req: false
      short: "Returns the code of conduct for this repository"
      type: "`$OBJECT`"
    }
    {
      name: "createdAt"
      req: true
      short: "Identifies the date and time when the object was created."
      type: "`$ANY`"
    }
    {
      name: "databaseId"
      req: false
      short: "Identifies the primary key from the database."
      type: "`$INTEGER`"
    }
    {
      name: "defaultBranchRef"
      req: false
      short: "The Ref associated with the repository's default branch."
      type: "`$OBJECT`"
    }
    {
      name: "deleteBranchOnMerge"
      req: true
      short: "Whether or not branches are automatically deleted when merged in this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "description"
      req: false
      short: "The description of the repository."
      type: "`$STRING`"
    }
    {
      name: "descriptionHTML"
      req: true
      short: "The description of the repository rendered to HTML."
      type: "`$ANY`"
    }
    {
      name: "diskUsage"
      req: false
      short: "The number of kilobytes this repository occupies on disk."
      type: "`$INTEGER`"
    }
    {
      name: "forkCount"
      req: true
      short: "Returns how many forks there are of this repository in the whole network."
      type: "`$INTEGER`"
    }
    {
      name: "forkingAllowed"
      req: true
      short: "Whether this repository allows forks."
      type: "`$BOOLEAN`"
    }
    {
      name: "hasDiscussionsEnabled"
      req: true
      short: "Indicates if the repository has the Discussions feature enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "hasIssuesEnabled"
      req: true
      short: "Indicates if the repository has issues feature enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "hasProjectsEnabled"
      req: true
      short: "Indicates if the repository has the Projects feature enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "hasPullRequestsEnabled"
      req: true
      short: "Indicates if the repository has the pull requests feature enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "hasSponsorshipsEnabled"
      req: true
      short: "Indicates if the repository displays a Sponsor button for financial contributions."
      type: "`$BOOLEAN`"
    }
    {
      name: "hasVulnerabilityAlertsEnabled"
      req: true
      short: "Whether vulnerability alerts are enabled for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "hasWikiEnabled"
      req: true
      short: "Indicates if the repository has wiki feature enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "homepageUrl"
      req: false
      short: "The repository's URL."
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      short: "The Node ID of the Repository object"
      type: "`$STRING`"
    }
    {
      name: "isArchived"
      req: true
      short: "Indicates if the repository is unmaintained."
      type: "`$BOOLEAN`"
    }
    {
      name: "isBlankIssuesEnabled"
      req: true
      short: "Returns true if the viewer can create a blank issue in this repository"
      type: "`$BOOLEAN`"
    }
    {
      name: "isDisabled"
      req: true
      short: "Returns whether or not this repository disabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "isEmpty"
      req: true
      short: "Returns whether or not this repository is empty."
      type: "`$BOOLEAN`"
    }
    {
      name: "isFork"
      req: true
      short: "Identifies if the repository is a fork."
      type: "`$BOOLEAN`"
    }
    {
      name: "isInOrganization"
      req: true
      short: "Indicates if a repository is either owned by an organization, or is a private fork of an organization repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "isLocked"
      req: true
      short: "Indicates if the repository has been locked or not."
      type: "`$BOOLEAN`"
    }
    {
      name: "isMirror"
      req: true
      short: "Identifies if the repository is a mirror."
      type: "`$BOOLEAN`"
    }
    {
      name: "isPrivate"
      req: true
      short: "Identifies if the repository is private or internal."
      type: "`$BOOLEAN`"
    }
    {
      name: "isSecurityPolicyEnabled"
      req: false
      short: "Returns true if this repository has a security policy"
      type: "`$BOOLEAN`"
    }
    {
      name: "isTemplate"
      req: true
      short: "Identifies if the repository is a template that can be used to generate new repositories."
      type: "`$BOOLEAN`"
    }
    {
      name: "isUserConfigurationRepository"
      req: true
      short: "Is this repository a user configuration repository?"
      type: "`$BOOLEAN`"
    }
    {
      name: "issueCreationPolicy"
      req: false
      short: "The policy controlling who can create issues in this repository."
      type: "`$STRING`"
    }
    {
      name: "latestRelease"
      req: false
      short: "Get the latest release for the repository if one exists."
      type: "`$OBJECT`"
    }
    {
      name: "licenseInfo"
      req: false
      short: "The license associated with the repository"
      type: "`$OBJECT`"
    }
    {
      name: "lockReason"
      req: false
      short: "The reason the repository has been locked."
      type: "`$STRING`"
    }
    {
      name: "mergeCommitAllowed"
      req: true
      short: "Whether or not PRs are merged with a merge commit on this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "mergeCommitMessage"
      req: true
      short: "How the default commit message will be generated when merging a pull request."
      type: "`$STRING`"
    }
    {
      name: "mergeCommitTitle"
      req: true
      short: "How the default commit title will be generated when merging a pull request."
      type: "`$STRING`"
    }
    {
      name: "mergeQueue"
      req: false
      short: "The merge queue for a specified branch, otherwise the default branch if not provided."
      type: "`$OBJECT`"
    }
    {
      name: "mirrorUrl"
      req: false
      short: "The repository's original mirror URL."
      type: "`$ANY`"
    }
    {
      name: "name"
      req: true
      short: "The name of the repository."
      type: "`$STRING`"
    }
    {
      name: "nameWithOwner"
      req: true
      short: "The repository's name with owner."
      type: "`$STRING`"
    }
    {
      name: "object"
      req: false
      short: "A Git object in the repository"
      type: "`$OBJECT`"
    }
    {
      name: "openGraphImageUrl"
      req: true
      short: "The image used to represent this repository in Open Graph data."
      type: "`$ANY`"
    }
    {
      name: "owner"
      req: false
      short: "The User owner of the repository."
      type: "`$OBJECT`"
    }
    {
      name: "parent"
      req: false
      short: "The repository parent, if this is a fork."
      type: "`$OBJECT`"
    }
    {
      name: "primaryLanguage"
      req: false
      short: "The primary language of the repository's code."
      type: "`$OBJECT`"
    }
    {
      name: "projectsResourcePath"
      req: true
      short: "The HTTP path listing the repository's projects"
      type: "`$ANY`"
    }
    {
      name: "projectsUrl"
      req: true
      short: "The HTTP URL listing the repository's projects"
      type: "`$ANY`"
    }
    {
      name: "pullRequestCreationPolicy"
      req: false
      short: "The policy controlling who can create pull requests in this repository."
      type: "`$STRING`"
    }
    {
      name: "pushedAt"
      req: false
      short: "Identifies the date and time when the repository was last pushed to."
      type: "`$ANY`"
    }
    {
      name: "rebaseMergeAllowed"
      req: true
      short: "Whether or not rebase-merging is enabled on this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "resourcePath"
      req: true
      short: "The HTTP path for this repository"
      type: "`$ANY`"
    }
    {
      name: "securityPolicyUrl"
      req: false
      short: "The security policy URL."
      type: "`$ANY`"
    }
    {
      name: "shortDescriptionHTML"
      req: true
      short: "A description of the repository, rendered to HTML without any links in it."
      type: "`$ANY`"
    }
    {
      name: "squashMergeAllowed"
      req: true
      short: "Whether or not squash-merging is enabled on this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "squashMergeCommitMessage"
      req: true
      short: "How the default commit message will be generated when squash merging a pull request."
      type: "`$STRING`"
    }
    {
      name: "squashMergeCommitTitle"
      req: true
      short: "How the default commit title will be generated when squash merging a pull request."
      type: "`$STRING`"
    }
    {
      name: "sshUrl"
      req: true
      short: "The SSH URL to clone this repository"
      type: "`$ANY`"
    }
    {
      name: "stargazerCount"
      req: true
      short: "Returns a count of how many stargazers there are on this object"
      type: "`$INTEGER`"
    }
    {
      name: "tempCloneToken"
      req: false
      short: "Temporary authentication token for cloning this repository."
      type: "`$STRING`"
    }
    {
      name: "templateRepository"
      req: false
      short: "The repository from which this repository was generated, if any."
      type: "`$OBJECT`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Identifies the date and time when the object was last updated."
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      short: "The HTTP URL for this repository"
      type: "`$STRING`"
    }
    {
      name: "usesCustomOpenGraphImage"
      req: true
      short: "Whether this repository has a custom image to use with Open Graph as opposed to being represented by the owner's avatar."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanAdminister"
      req: true
      short: "Indicates whether the viewer has admin permissions on this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanCreateIssues"
      req: true
      short: "Indicates whether the current user can create issues in this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanSeeIssueFields"
      req: true
      short: "Indicates whether the current user can see issue fields in this repository"
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanSubscribe"
      req: true
      short: "Check if the viewer is able to change their subscription status for the repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerCanUpdateTopics"
      req: true
      short: "Indicates whether the viewer can update the topics of this repository."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerDefaultCommitEmail"
      req: false
      short: "The last commit email for the viewer."
      type: "`$STRING`"
    }
    {
      name: "viewerDefaultMergeMethod"
      req: true
      short: "The last used merge method by the viewer or the default for the repository."
      type: "`$STRING`"
    }
    {
      name: "viewerHasStarred"
      req: true
      short: "Returns a boolean indicating whether the viewing user has starred this starrable."
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerPermission"
      req: false
      short: "The users permission level on the repository."
      type: "`$STRING`"
    }
    {
      name: "viewerPossibleCommitEmails"
      req: false
      short: "A list of emails this viewer can commit with."
      type: "`$STRING`"
    }
    {
      name: "viewerSubscription"
      req: false
      short: "Identifies if the viewer is watching, not watching, or ignoring the subscribable entity."
      type: "`$STRING`"
    }
    {
      name: "visibility"
      req: true
      short: "Indicates the repository's visibility level."
      type: "`$STRING`"
    }
    {
      name: "webCommitSignoffRequired"
      req: true
      short: "Whether contributors are required to sign off on web-based commits in this repository."
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

