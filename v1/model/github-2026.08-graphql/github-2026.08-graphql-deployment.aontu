# Entity: deployment

main: kit: entity: deployment: {

  alias: field: {}

  fields: {
    commit: {
      h: "Commit"
      n: "commit"
      r: false
      sh: "Identifies the commit sha of the deployment."
      t: "`$OBJECT`"
    }
    commitOid: {
      h: "Commit Oid"
      n: "commitOid"
      r: true
      sh: "Identifies the oid of the deployment commit, even if the commit has been deleted."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "The deployment description."
      t: "`$STRING`"
    }
    environment: {
      h: "Environment"
      n: "environment"
      r: false
      sh: "The latest environment to which this deployment was made."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Deployment object"
      t: "`$STRING`"
    }
    latestEnvironment: {
      h: "Latest Environment"
      n: "latestEnvironment"
      r: false
      sh: "The latest environment to which this deployment was made."
      t: "`$STRING`"
    }
    latestStatus: {
      h: "Latest Status"
      n: "latestStatus"
      r: false
      sh: "The latest status of this deployment."
      t: "`$OBJECT`"
    }
    originalEnvironment: {
      h: "Original Environment"
      n: "originalEnvironment"
      r: false
      sh: "The original environment to which this deployment was made."
      t: "`$STRING`"
    }
    payload: {
      h: "Payload"
      n: "payload"
      r: false
      sh: "Extra information that a deployment system might need."
      t: "`$STRING`"
    }
    ref: {
      h: "Ref"
      n: "ref"
      r: false
      sh: "Identifies the Ref of the deployment, if the deployment was created by ref."
      t: "`$OBJECT`"
    }
    repository: {
      h: "Repository"
      n: "repository"
      r: false
      sh: "Identifies the repository associated with the deployment."
      t: "`$OBJECT`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
      sh: "The current state of the deployment."
      t: "`$STRING`"
    }
    task: {
      h: "Task"
      n: "task"
      r: false
      sh: "The deployment task."
      t: "`$STRING`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "deployment"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST createDeployment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation DeploymentCreate($input: CreateDeploymentInput!) { createDeployment(input: $input) { deployment { ...DeploymentFields } } } fragment DeploymentFields on Deployment { commit { id } commitOid createdAt databaseId description environment id latestEnvironment latestStatus { id } originalEnvironment payload ref { id } repository { id } state task updatedAt }"
            field: "createDeployment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateDeploymentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "createDeployment"
          t: {
            req: "`reqdata`"
            res: "`body.data.createDeployment.deployment`"
          }
        }
      ]
    }
  }



}