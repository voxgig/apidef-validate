# Entity: deployment

main: kit: entity: deployment: {

  alias: field: {}

  fields: [
    {
      name: "commit"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "commit_oid"
      req: true
      type: "`$STRING`"
    }
    {
      name: "created_at"
      req: true
      type: "`$ANY`"
    }
    {
      name: "database_id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "environment"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "latest_environment"
      req: false
      type: "`$STRING`"
    }
    {
      name: "latest_status"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "original_environment"
      req: false
      type: "`$STRING`"
    }
    {
      name: "payload"
      req: false
      type: "`$STRING`"
    }
    {
      name: "ref"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
      type: "`$OBJECT`"
    }
    {
