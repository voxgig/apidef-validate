# Entity: license

main: kit: entity: license: {

  alias: field: {}

  fields: {
    body: {
      h: "Body"
      n: "body"
      r: true
      sh: "The full text of the license"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "A human-readable description of the license"
      t: "`$STRING`"
    }
    featured: {
      h: "Featured"
      n: "featured"
      r: true
      sh: "Whether the license should be featured"
      t: "`$BOOLEAN`"
    }
    hidden: {
      h: "Hidden"
      n: "hidden"
      r: true
      sh: "Whether the license should be displayed in license pickers"
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the License object"
      t: "`$STRING`"
    }
    implementation: {
      h: "Implementation"
      n: "implementation"
      r: false
      sh: "Instructions on how to implement the license"
      t: "`$STRING`"
    }
    key: {
      h: "Key"
      n: "key"
      r: true
      sh: "The lowercased SPDX ID of the license"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The license full name specified by <https://spdx.org/licenses>"
      t: "`$STRING`"
    }
    nickname: {
      h: "Nickname"
      n: "nickname"
      r: false
      sh: "Customary short name if applicable (e.g, GPLv3)"
      t: "`$STRING`"
    }
    pseudoLicense: {
      h: "Pseudo License"
      n: "pseudoLicense"
      r: true
      sh: "Whether the license is a pseudo-license placeholder (e.g., other, no-license)"
      t: "`$BOOLEAN`"
    }
    spdxId: {
      h: "Spdx Id"
      n: "spdxId"
      r: false
      sh: "Short identifier specified by <https://spdx.org/licenses>"
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      sh: "URL to the license on <https://choosealicense.com>"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "license"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "POST licenses"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "query LicenseList { licenses { ...LicenseFields } } fragment LicenseFields on License { body description featured hidden id implementation key name nickname pseudoLicense spdxId url }"
            field: "licenses"
            optype: "query"
          }
          kind: "graphql"
          method: "POST"
          orig: "licenses"
          transform: {
            req: "`reqdata`"
            res: "`body.data.licenses`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "key"
                orig: "key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST license"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "query LicenseLoad($key: String!) { license(key: $key) { ...LicenseFields } } fragment LicenseFields on License { body description featured hidden id implementation key name nickname pseudoLicense spdxId url }"
            field: "license"
            optype: "query"
            vars: [
              {
                from: "key"
                gqltype: "String!"
                name: "key"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "license"
          select: {
            exist: [
              "key"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.license`"
          }
        }
      ]
    }
  }



}