# Entity: discussion_comment

main: kit: entity: discussion_comment: {

  alias: field: {}

  fields: {
    authorAssociation: {
      h: "Author Association"
      n: "authorAssociation"
      r: true
      sh: "Author's association with the subject of the comment."
      t: "`$STRING`"
    }
    body: {
      h: "Body"
      n: "body"
      r: true
      sh: "The body as Markdown."
      t: "`$STRING`"
    }
    bodyHTML: {
      h: "Body Html"
      n: "bodyHTML"
      r: true
      sh: "The body rendered to HTML."
      t: "`$ANY`"
    }
    bodyText: {
      h: "Body Text"
      n: "bodyText"
      r: true
      sh: "The body rendered to text."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    createdViaEmail: {
      h: "Created Via Email"
      n: "createdViaEmail"
      r: true
      sh: "Check if this comment was created via an email reply."
      t: "`$BOOLEAN`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    deletedAt: {
      h: "Deleted At"
      n: "deletedAt"
      r: false
      sh: "The time when this replied-to comment was deleted"
      t: "`$ANY`"
    }
    discussion: {
      h: "Discussion"
      n: "discussion"
      r: false
      sh: "The discussion this comment was created in"
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the DiscussionComment object"
      t: "`$STRING`"
    }
    includesCreatedEdit: {
      h: "Includes Created Edit"
      n: "includesCreatedEdit"
      r: true
      sh: "Check if this comment was edited and includes an edit with the creation data"
      t: "`$BOOLEAN`"
    }
    isAnswer: {
      h: "Is Answer"
      n: "isAnswer"
      r: true
      sh: "Has this comment been chosen as the answer of its discussion?"
      t: "`$BOOLEAN`"
    }
    isMinimized: {
      h: "Is Minimized"
      n: "isMinimized"
      r: true
      sh: "Returns whether or not a comment has been minimized."
      t: "`$BOOLEAN`"
    }
    lastEditedAt: {
      h: "Last Edited At"
      n: "lastEditedAt"
      r: false
      sh: "The moment the editor made the last edit"
      t: "`$ANY`"
    }
    minimizedReason: {
      h: "Minimized Reason"
      n: "minimizedReason"
      r: false
      sh: "Returns why the comment was minimized."
      t: "`$STRING`"
    }
    publishedAt: {
      h: "Published At"
      n: "publishedAt"
      r: false
      sh: "Identifies when the comment was published at."
      t: "`$ANY`"
    }
    replyTo: {
      h: "Reply To"
      n: "replyTo"
      r: false
      sh: "The discussion comment this comment is a reply to"
      t: "`$OBJECT`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The path for this discussion comment."
      t: "`$ANY`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    upvoteCount: {
      h: "Upvote Count"
      n: "upvoteCount"
      r: true
      sh: "Number of upvotes that this subject has received."
      t: "`$INTEGER`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The URL for this discussion comment."
      t: "`$STRING`"
    }
    viewerCanDelete: {
      h: "Viewer Can Delete"
      n: "viewerCanDelete"
      r: true
      sh: "Check if the current viewer can delete this object."
      t: "`$BOOLEAN`"
    }
    viewerCanMarkAsAnswer: {
      h: "Viewer Can Mark As Answer"
      n: "viewerCanMarkAsAnswer"
      r: true
      sh: "Can the current user mark this comment as an answer?"
      t: "`$BOOLEAN`"
    }
    viewerCanMinimize: {
      h: "Viewer Can Minimize"
      n: "viewerCanMinimize"
      r: true
      sh: "Check if the current viewer can minimize this object."
      t: "`$BOOLEAN`"
    }
    viewerCanReact: {
      h: "Viewer Can React"
      n: "viewerCanReact"
      r: true
      sh: "Can user react to this subject"
      t: "`$BOOLEAN`"
    }
    viewerCanUnmarkAsAnswer: {
      h: "Viewer Can Unmark As Answer"
      n: "viewerCanUnmarkAsAnswer"
      r: true
      sh: "Can the current user unmark this comment as an answer?"
      t: "`$BOOLEAN`"
    }
    viewerCanUnminimize: {
      h: "Viewer Can Unminimize"
      n: "viewerCanUnminimize"
      r: true
      sh: "Check if the current viewer can unminimize this object."
      t: "`$BOOLEAN`"
    }
    viewerCanUpdate: {
      h: "Viewer Can Update"
      n: "viewerCanUpdate"
      r: true
      sh: "Check if the current viewer can update this object."
      t: "`$BOOLEAN`"
    }
    viewerCanUpvote: {
      h: "Viewer Can Upvote"
      n: "viewerCanUpvote"
      r: true
      sh: "Whether or not the current user can add or remove an upvote on this subject."
      t: "`$BOOLEAN`"
    }
    viewerCannotUpdateReasons: {
      h: "Viewer Cannot Update Reasons"
      n: "viewerCannotUpdateReasons"
      r: true
      sh: "Reasons why the current viewer can not update this comment."
      t: "`$STRING`"
    }
    viewerDidAuthor: {
      h: "Viewer Did Author"
      n: "viewerDidAuthor"
      r: true
      sh: "Did the viewer author this comment."
      t: "`$BOOLEAN`"
    }
    viewerHasUpvoted: {
      h: "Viewer Has Upvoted"
      n: "viewerHasUpvoted"
      r: true
      sh: "Whether or not the current user has already upvoted this subject."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "discussion_comment"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST addDiscussionComment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation DiscussionCommentCreate($input: AddDiscussionCommentInput!) { addDiscussionComment(input: $input) { comment { ...DiscussionCommentFields } } } fragment DiscussionCommentFields on DiscussionComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId deletedAt discussion { id } id includesCreatedEdit isAnswer isMinimized lastEditedAt minimizedReason publishedAt replyTo { id } resourcePath updatedAt upvoteCount url viewerCanDelete viewerCanMarkAsAnswer viewerCanMinimize viewerCanReact viewerCanUnmarkAsAnswer viewerCanUnminimize viewerCanUpdate viewerCanUpvote viewerCannotUpdateReasons viewerDidAuthor viewerHasUpvoted }"
            field: "addDiscussionComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "AddDiscussionCommentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "addDiscussionComment"
          t: {
            req: "`reqdata`"
            res: "`body.data.addDiscussionComment.comment`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "POST deleteDiscussionComment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation DiscussionCommentRemove($input: DeleteDiscussionCommentInput!) { deleteDiscussionComment(input: $input) { comment { ...DiscussionCommentFields } } } fragment DiscussionCommentFields on DiscussionComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId deletedAt discussion { id } id includesCreatedEdit isAnswer isMinimized lastEditedAt minimizedReason publishedAt replyTo { id } resourcePath updatedAt upvoteCount url viewerCanDelete viewerCanMarkAsAnswer viewerCanMinimize viewerCanReact viewerCanUnmarkAsAnswer viewerCanUnminimize viewerCanUpdate viewerCanUpvote viewerCannotUpdateReasons viewerDidAuthor viewerHasUpvoted }"
            field: "deleteDiscussionComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "DeleteDiscussionCommentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "deleteDiscussionComment"
          t: {
            req: "`reqdata`"
            res: "`body.data.deleteDiscussionComment.comment`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "POST updateDiscussionComment"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation DiscussionCommentUpdate($input: UpdateDiscussionCommentInput!) { updateDiscussionComment(input: $input) { comment { ...DiscussionCommentFields } } } fragment DiscussionCommentFields on DiscussionComment { authorAssociation body bodyHTML bodyText createdAt createdViaEmail databaseId deletedAt discussion { id } id includesCreatedEdit isAnswer isMinimized lastEditedAt minimizedReason publishedAt replyTo { id } resourcePath updatedAt upvoteCount url viewerCanDelete viewerCanMarkAsAnswer viewerCanMinimize viewerCanReact viewerCanUnmarkAsAnswer viewerCanUnminimize viewerCanUpdate viewerCanUpvote viewerCannotUpdateReasons viewerDidAuthor viewerHasUpvoted }"
            field: "updateDiscussionComment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateDiscussionCommentInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "updateDiscussionComment"
          t: {
            req: "`reqdata`"
            res: "`body.data.updateDiscussionComment.comment`"
          }
        }
      ]
    }
  }



}