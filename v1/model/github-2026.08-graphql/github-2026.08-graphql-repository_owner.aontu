# Entity: repository_owner

main: kit: entity: repository_owner: {

  alias: field: {}

  fields: {
    avatarUrl: {
      h: "Avatar Url"
      n: "avatarUrl"
      r: true
      sh: "A URL pointing to the owner's public avatar."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the RepositoryOwner object"
      t: "`$STRING`"
    }
    login: {
      h: "Login"
      n: "login"
      r: true
      sh: "The username used to login."
      t: "`$STRING`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP URL for the owner."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for the owner."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "repository_owner"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST repositoryOwner"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "login"
                or: "login"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query RepositoryOwnerLoad($login: String!) { repositoryOwner(login: $login) { ...RepositoryOwnerFields } } fragment RepositoryOwnerFields on RepositoryOwner { avatarUrl id login resourcePath url }"
            field: "repositoryOwner"
            optype: "query"
            vars: [
              {
                from: "login"
                gqltype: "String!"
                name: "login"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "repositoryOwner"
          q: {
            exist: [
              "login"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.repositoryOwner`"
          }
        }
      ]
    }
  }



}