            res: "`body.data.createSponsorsListing.sponsorsListing`"
          }
        }
        {
          contract: {
            id: "POST updatePatreonSponsorability"
            json: "{\"field\":{\"args\":[{\"gqltype\":\"UpdatePatreonSponsorabilityInput!\",\"name\":\"input\",\"reqd\":true,\"type\":\"UpdatePatreonSponsorabilityInput\"}],\"deprecated\":false,\"desc\":\"Toggle the setting for your GitHub Sponsors profile that allows other GitHub\\naccounts to sponsor you on GitHub while paying for the sponsorship on Patreon.\\nOnly applicable when you have a GitHub Sponsors profile and have connected\\nyour GitHub account with Patreon.\",\"gqltype\":\"UpdatePatreonSponsorabilityPayload\",\"list\":false,\"name\":\"updatePatreonSponsorability\",\"reqd\":false,\"type\":\"UpdatePatreonSponsorabilityPayload\"},\"invocation\":{\"doc\":\"mutation SponsorsListingCreateUpdatePatreonSponsorability($input: UpdatePatreonSponsorabilityInput!) { updatePatreonSponsorability(input: $input) { sponsorsListing { ...SponsorsListingFields } } } fragment SponsorsListingFields on SponsorsListing { billingCountryOrRegion contactEmailAddress createdAt dashboardResourcePath dashboardUrl fiscalHost { id } fullDescription fullDescriptionHTML id isPublic name nextPayoutDate residenceCountryOrRegion resourcePath shortDescription slug url }\",\"field\":\"updatePatreonSponsorability\",\"optype\":\"mutation\",\"vars\":[{\"from\":\"\",\"gqltype\":\"UpdatePatreonSponsorabilityInput!\",\"name\":\"input\"}]},\"protocol\":\"graphql\",\"types\":{\"Boolean\":{\"desc\":\"The `Boolean` scalar type represents `true` or `false`.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"Boolean\"},\"String\":{\"desc\":\"The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.\",\"fields\":{},\"kind\":\"SCALAR\",\"name\":\"String\"},\"UpdatePatreonSponsorabilityInput\":{\"desc\":\"Autogenerated input type of UpdatePatreonSponsorability\",\"fields\":{\"clientMutationId\":{\"args\":[],\"deprecated\":false,\"desc\":\"A unique identifier for the client performing the mutation.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"clientMutationId\",\"reqd\":false,\"type\":\"String\"},\"enablePatreonSponsorships\":{\"args\":[],\"deprecated\":false,\"desc\":\"Whether Patreon tiers should be shown on the GitHub Sponsors profile page,\\nallowing potential sponsors to make their payment through Patreon instead of GitHub.\",\"gqltype\":\"Boolean!\",\"list\":false,\"name\":\"enablePatreonSponsorships\",\"reqd\":true,\"type\":\"Boolean\"},\"sponsorableLogin\":{\"args\":[],\"deprecated\":false,\"desc\":\"The username of the organization with the GitHub Sponsors profile, if any.\\nDefaults to the GitHub Sponsors profile for the authenticated user if omitted.\",\"gqltype\":\"String\",\"list\":false,\"name\":\"sponsorableLogin\",\"reqd\":false,\"type\":\"String\"}},\"kind\":\"INPUT_OBJECT\",\"name\":\"UpdatePatreonSponsorabilityInput\"}},\"typesScope\":\"inputs\"}"
            source: "graphql"
            version: 1
          }
          graphql: {
            doc: "mutation SponsorsListingCreateUpdatePatreonSponsorability($input: UpdatePatreonSponsorabilityInput!) { updatePatreonSponsorability(input: $input) { sponsorsListing { ...SponsorsListingFields } } } fragment SponsorsListingFields on SponsorsListing { billingCountryOrRegion contactEmailAddress createdAt dashboardResourcePath dashboardUrl fiscalHost { id } fullDescription fullDescriptionHTML id isPublic name nextPayoutDate residenceCountryOrRegion resourcePath shortDescription slug url }"
            field: "updatePatreonSponsorability"
            optype: "mutation"
            vars: [
