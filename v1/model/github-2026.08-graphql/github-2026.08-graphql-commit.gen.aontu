# Entity: commit

main: kit: entity: commit: {

  alias: field: {}

  fields: [
    {
      name: "abbreviatedOid"
      req: true
      type: "`$STRING`"
    }
    {
      name: "additions"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "authoredByCommitter"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "authoredDate"
      req: true
      type: "`$ANY`"
    }
    {
      name: "changedFilesIfAvailable"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "commitResourcePath"
      req: true
      type: "`$ANY`"
    }
    {
      name: "commitUrl"
      req: true
      type: "`$ANY`"
    }
    {
      name: "committedDate"
      req: true
      type: "`$ANY`"
    }
    {
      name: "committedViaWeb"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "deletions"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "message"
      req: true
      type: "`$STRING`"
    }
    {
      name: "messageBody"
      req: true
      type: "`$STRING`"
    }
    {
      name: "messageBodyHTML"
      req: true
      type: "`$ANY`"
    }
    {
      name: "messageHeadline"
      req: true
      type: "`$STRING`"
    }
    {
      name: "messageHeadlineHTML"
      req: true
      type: "`$ANY`"
    }
    {
      name: "oid"
      req: true
      type: "`$ANY`"
    }
    {
      name: "onBehalfOf"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "repository"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "resourcePath"
      req: true
      type: "`$ANY`"
    }
    {
      name: "status"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "statusCheckRollup"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "tarballUrl"
      req: true
      type: "`$ANY`"
    }
    {
      name: "tree"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "treeResourcePath"
      req: true
      type: "`$ANY`"
    }
    {
      name: "treeUrl"
      req: true
      type: "`$ANY`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "viewerCanSubscribe"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "viewerSubscription"
      req: false
      type: "`$STRING`"
    }
    {
      name: "zipballUrl"
      req: true
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "commit"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation CommitCreateCreateCommitOnBranch($input: CreateCommitOnBranchInput!) { createCommitOnBranch(input: $input) { commit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }"
            field: "createCommitOnBranch"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateCommitOnBranchInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createCommitOnBranch"
          select: {
            "$action": "create_commit_on_branch"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.createCommitOnBranch.commit`"
          }
        }
        {
          graphql: {
            doc: "mutation CommitCreateMergeBranch($input: MergeBranchInput!) { mergeBranch(input: $input) { mergeCommit { ...CommitFields } } } fragment CommitFields on Commit { abbreviatedOid additions authoredByCommitter authoredDate changedFilesIfAvailable commitResourcePath commitUrl committedDate committedViaWeb deletions id message messageBody messageBodyHTML messageHeadline messageHeadlineHTML oid onBehalfOf { id } repository { id } resourcePath status { id } statusCheckRollup { id } tarballUrl tree { id } treeResourcePath treeUrl url viewerCanSubscribe viewerSubscription zipballUrl }"
            field: "mergeBranch"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "MergeBranchInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "mergeBranch"
          select: {
            "$action": "merge_branch"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.mergeBranch.mergeCommit`"
          }
        }
      ]
    }
  }



}