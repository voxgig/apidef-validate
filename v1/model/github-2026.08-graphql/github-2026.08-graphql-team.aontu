# Entity: team

main: kit: entity: team: {

  alias: field: {}

  fields: {
    avatarUrl: {
      h: "Avatar Url"
      n: "avatarUrl"
      r: false
      sh: "A URL pointing to the team's avatar."
      t: "`$ANY`"
    }
    combinedSlug: {
      h: "Combined Slug"
      n: "combinedSlug"
      r: true
      sh: "The slug corresponding to the organization and team."
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "Identifies the date and time when the object was created."
      t: "`$ANY`"
    }
    databaseId: {
      h: "Database Id"
      n: "databaseId"
      r: false
      sh: "Identifies the primary key from the database."
      t: "`$INTEGER`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "The description of the team."
      t: "`$STRING`"
    }
    editTeamResourcePath: {
      h: "Edit Team Resource Path"
      n: "editTeamResourcePath"
      r: true
      sh: "The HTTP path for editing this team"
      t: "`$ANY`"
    }
    editTeamUrl: {
      h: "Edit Team Url"
      n: "editTeamUrl"
      r: true
      sh: "The HTTP URL for editing this team"
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the Team object"
      t: "`$STRING`"
    }
    membersResourcePath: {
      h: "Members Resource Path"
      n: "membersResourcePath"
      r: true
      sh: "The HTTP path for the team' members"
      t: "`$ANY`"
    }
    membersUrl: {
      h: "Members Url"
      n: "membersUrl"
      r: true
      sh: "The HTTP URL for the team' members"
      t: "`$ANY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the team."
      t: "`$STRING`"
    }
    newTeamResourcePath: {
      h: "New Team Resource Path"
      n: "newTeamResourcePath"
      r: true
      sh: "The HTTP path creating a new team"
      t: "`$ANY`"
    }
    newTeamUrl: {
      h: "New Team Url"
      n: "newTeamUrl"
      r: true
      sh: "The HTTP URL creating a new team"
      t: "`$ANY`"
    }
    notificationSetting: {
      h: "Notification Setting"
      n: "notificationSetting"
      r: true
      sh: "The notification setting that the team has set."
      t: "`$STRING`"
    }
    organization: {
      h: "Organization"
      n: "organization"
      r: false
      sh: "The organization that owns this team."
      t: "`$OBJECT`"
    }
    parentTeam: {
      h: "Parent Team"
      n: "parentTeam"
      r: false
      sh: "The parent team of the team."
      t: "`$OBJECT`"
    }
    privacy: {
      h: "Privacy"
      n: "privacy"
      r: true
      sh: "The level of privacy the team has."
      t: "`$STRING`"
    }
    repositoriesResourcePath: {
      h: "Repositories Resource Path"
      n: "repositoriesResourcePath"
      r: true
      sh: "The HTTP path for this team's repositories"
      t: "`$ANY`"
    }
    repositoriesUrl: {
      h: "Repositories Url"
      n: "repositoriesUrl"
      r: true
      sh: "The HTTP URL for this team's repositories"
      t: "`$ANY`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this team"
      t: "`$ANY`"
    }
    reviewRequestDelegationAlgorithm: {
      h: "Review Request Delegation Algorithm"
      n: "reviewRequestDelegationAlgorithm"
      r: false
      sh: "What algorithm is used for review assignment for this team"
      t: "`$STRING`"
    }
    reviewRequestDelegationEnabled: {
      h: "Review Request Delegation Enabled"
      n: "reviewRequestDelegationEnabled"
      r: true
      sh: "True if review assignment is enabled for this team"
      t: "`$BOOLEAN`"
    }
    reviewRequestDelegationMemberCount: {
      h: "Review Request Delegation Member Count"
      n: "reviewRequestDelegationMemberCount"
      r: false
      sh: "How many team members are required for review assignment for this team"
      t: "`$INTEGER`"
    }
    reviewRequestDelegationNotifyTeam: {
      h: "Review Request Delegation Notify Team"
      n: "reviewRequestDelegationNotifyTeam"
      r: true
      sh: "When assigning team members via delegation, whether the entire team should be notified as well."
      t: "`$BOOLEAN`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: true
      sh: "The slug corresponding to the team."
      t: "`$STRING`"
    }
    teamsResourcePath: {
      h: "Teams Resource Path"
      n: "teamsResourcePath"
      r: true
      sh: "The HTTP path for this team's teams"
      t: "`$ANY`"
    }
    teamsUrl: {
      h: "Teams Url"
      n: "teamsUrl"
      r: true
      sh: "The HTTP URL for this team's teams"
      t: "`$ANY`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "Identifies the date and time when the object was last updated."
      t: "`$ANY`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this team"
      t: "`$STRING`"
    }
    viewerCanAdminister: {
      h: "Viewer Can Administer"
      n: "viewerCanAdminister"
      r: true
      sh: "Team is adminable by the viewer."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "team"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST linkProjectV2ToTeam"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation TeamCreateLinkProjectV2To($input: LinkProjectV2ToTeamInput!) { linkProjectV2ToTeam(input: $input) { team { ...TeamFields } } } fragment TeamFields on Team { avatarUrl combinedSlug createdAt databaseId description editTeamResourcePath editTeamUrl id membersResourcePath membersUrl name newTeamResourcePath newTeamUrl notificationSetting organization { id } parentTeam { id } privacy repositoriesResourcePath repositoriesUrl resourcePath reviewRequestDelegationAlgorithm reviewRequestDelegationEnabled reviewRequestDelegationMemberCount reviewRequestDelegationNotifyTeam slug teamsResourcePath teamsUrl updatedAt url viewerCanAdminister }"
            field: "linkProjectV2ToTeam"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "LinkProjectV2ToTeamInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "linkProjectV2ToTeam"
          select: {
            "$action": "link_project_v2_to"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.linkProjectV2ToTeam.team`"
          }
        }
        {
          contract: {
            id: "POST unlinkProjectV2FromTeam"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation TeamCreateUnlinkProjectV2From($input: UnlinkProjectV2FromTeamInput!) { unlinkProjectV2FromTeam(input: $input) { team { ...TeamFields } } } fragment TeamFields on Team { avatarUrl combinedSlug createdAt databaseId description editTeamResourcePath editTeamUrl id membersResourcePath membersUrl name newTeamResourcePath newTeamUrl notificationSetting organization { id } parentTeam { id } privacy repositoriesResourcePath repositoriesUrl resourcePath reviewRequestDelegationAlgorithm reviewRequestDelegationEnabled reviewRequestDelegationMemberCount reviewRequestDelegationNotifyTeam slug teamsResourcePath teamsUrl updatedAt url viewerCanAdminister }"
            field: "unlinkProjectV2FromTeam"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UnlinkProjectV2FromTeamInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "unlinkProjectV2FromTeam"
          select: {
            "$action": "unlink_project_v2_from"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.unlinkProjectV2FromTeam.team`"
          }
        }
        {
          contract: {
            id: "POST updateTeamReviewAssignment"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation TeamCreateUpdateTeamReviewAssignment($input: UpdateTeamReviewAssignmentInput!) { updateTeamReviewAssignment(input: $input) { team { ...TeamFields } } } fragment TeamFields on Team { avatarUrl combinedSlug createdAt databaseId description editTeamResourcePath editTeamUrl id membersResourcePath membersUrl name newTeamResourcePath newTeamUrl notificationSetting organization { id } parentTeam { id } privacy repositoriesResourcePath repositoriesUrl resourcePath reviewRequestDelegationAlgorithm reviewRequestDelegationEnabled reviewRequestDelegationMemberCount reviewRequestDelegationNotifyTeam slug teamsResourcePath teamsUrl updatedAt url viewerCanAdminister }"
            field: "updateTeamReviewAssignment"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "UpdateTeamReviewAssignmentInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "updateTeamReviewAssignment"
          select: {
            "$action": "update_team_review_assignment"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.updateTeamReviewAssignment.team`"
          }
        }
      ]
    }
  }



}