# Entity: marketplace_category

main: kit: entity: marketplace_category: {

  alias: field: {}

  fields: {
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "The category's description."
      t: "`$STRING`"
    }
    howItWorks: {
      h: "How It Works"
      n: "howItWorks"
      r: false
      sh: "The technical description of how apps listed in this category work with GitHub."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the MarketplaceCategory object"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The category's name."
      t: "`$STRING`"
    }
    primaryListingCount: {
      h: "Primary Listing Count"
      n: "primaryListingCount"
      r: true
      sh: "How many Marketplace listings have this as their primary category."
      t: "`$INTEGER`"
    }
    resourcePath: {
      h: "Resource Path"
      n: "resourcePath"
      r: true
      sh: "The HTTP path for this Marketplace category."
      t: "`$ANY`"
    }
    secondaryListingCount: {
      h: "Secondary Listing Count"
      n: "secondaryListingCount"
      r: true
      sh: "How many Marketplace listings have this as their secondary category."
      t: "`$INTEGER`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: true
      sh: "The short name of the category used in its URL."
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The HTTP URL for this Marketplace category."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "marketplace_category"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "POST marketplaceCategories"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "exclude_empty"
                or: "exclude_empty"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "param"
                n: "exclude_subcategory"
                or: "exclude_subcategory"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "param"
                n: "include_category"
                or: "include_category"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "query MarketplaceCategoryList($excludeEmpty: Boolean, $excludeSubcategories: Boolean, $includeCategories: [String!]) { marketplaceCategories(excludeEmpty: $excludeEmpty, excludeSubcategories: $excludeSubcategories, includeCategories: $includeCategories) { ...MarketplaceCategoryFields } } fragment MarketplaceCategoryFields on MarketplaceCategory { description howItWorks id name primaryListingCount resourcePath secondaryListingCount slug url }"
            field: "marketplaceCategories"
            optype: "query"
            vars: [
              {
                from: "excludeEmpty"
                gqltype: "Boolean"
                name: "excludeEmpty"
              }
              {
                from: "excludeSubcategories"
                gqltype: "Boolean"
                name: "excludeSubcategories"
              }
              {
                from: "includeCategories"
                gqltype: "[String!]"
                name: "includeCategories"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "marketplaceCategories"
          t: {
            req: "`reqdata`"
            res: "`body.data.marketplaceCategories`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "POST marketplaceCategory"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "slug"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "use_topic_alias"
                or: "use_topic_alias"
                r: false
                t: "`$BOOLEAN`"
              }
            ]
          }
          gq: {
            doc: "query MarketplaceCategoryLoad($slug: String!, $useTopicAliases: Boolean) { marketplaceCategory(slug: $slug, useTopicAliases: $useTopicAliases) { ...MarketplaceCategoryFields } } fragment MarketplaceCategoryFields on MarketplaceCategory { description howItWorks id name primaryListingCount resourcePath secondaryListingCount slug url }"
            field: "marketplaceCategory"
            optype: "query"
            vars: [
              {
                from: "slug"
                gqltype: "String!"
                name: "slug"
              }
              {
                from: "useTopicAliases"
                gqltype: "Boolean"
                name: "useTopicAliases"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "marketplaceCategory"
          q: {
            exist: [
              "slug"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.marketplaceCategory`"
          }
        }
      ]
