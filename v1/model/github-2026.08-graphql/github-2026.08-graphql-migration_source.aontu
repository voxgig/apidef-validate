# Entity: migration_source

main: kit: entity: migration_source: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The Node ID of the MigrationSource object"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The migration source name."
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "The migration source type."
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "The migration source URL, for example `https://github.com` or `https://monalisa.ghe.com`."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "migration_source"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST createMigrationSource"
            source: "graphql"
            version: 2
          }
          graphql: {
            doc: "mutation MigrationSourceCreate($input: CreateMigrationSourceInput!) { createMigrationSource(input: $input) { migrationSource { ...MigrationSourceFields } } } fragment MigrationSourceFields on MigrationSource { id name type url }"
            field: "createMigrationSource"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CreateMigrationSourceInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "createMigrationSource"
          transform: {
            req: "`reqdata`"
            res: "`body.data.createMigrationSource.migrationSource`"
          }
        }
      ]
    }
  }



}