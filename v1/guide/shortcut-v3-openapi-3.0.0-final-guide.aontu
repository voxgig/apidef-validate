{
  entity: {
    bulk: {
      name: "bulk"
      path: {
        "/api/v3/stories/bulk": {
          op: {
            remove: {
              method: "DELETE"
              transform: {
                req: {
                  story_ids: "`reqdata.story_id`"
                }
              }
            }
          }
        }
      }
    }
    category: {
      name: "category"
      path: {
        "/api/v3/categories": {
          op: {
            create: {
              method: "POST"
              transform: {
                req: {
                  color: "`reqdata.color`"
                  external_id: "`reqdata.external_id`"
                  name: "`reqdata.name`"
                  type: "`reqdata.type`"
                }
              }
            }
            list: {
              method: "GET"
            }
          }
        }
        "/api/v3/categories/{category-public-id}": {
          op: {
            load: {
              method: "GET"
            }
            remove: {
              method: "DELETE"
            }
            update: {
              method: "PUT"
              transform: {
                req: {
                  archived: "`reqdata.archived`"
                  color: "`reqdata.color`"
                  name: "`reqdata.name`"
                }
              }
            }
          }
          rename: {
            param: {
              "category-public-id": "id"
            }
          }
        }
      }
    }
    comment: {
      name: "comment"
      path: {
        "/api/v3/stories/{story-public-id}/comments/{comment-public-id}": {
          op: {
            remove: {
              method: "DELETE"
            }
          }
          rename: {
            param: {
              "comment-public-id": "id"
              "story-public-id": "story_id"
            }
          }
        }
      }
    }
    custom_field: {
      name: "custom_field"
      path: {
        "/api/v3/custom-fields": {
